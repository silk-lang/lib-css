pub effect fn styleCatalog() -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut result = S.object()
  run S.set(&mut result, "cssom", run S.str("https://drafts.csswg.org/cssom/"))
  run S.set(&mut result, "cssom-view", run S.str("https://drafts.csswg.org/cssom-view/"))
  run S.set(&mut result, "css-typed-om-1", run S.str("https://drafts.css-houdini.org/css-typed-om-1/"))
  return move result
}

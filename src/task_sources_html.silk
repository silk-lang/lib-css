fn entity(name: string) -> string {
  let mut low: usize = 0
  let mut high: usize = 2231
  while low < high {
    let middle = low + (high - low) / 2
    let key = ENTITIES[middle * 2]
    if name == key { return ENTITIES[middle * 2 + 1] }
    let left = String.utf8Bytes(name)
    let right = String.utf8Bytes(key)
    let mut at: usize = 0
    while at < left.length && at < right.length && left[at] == right[at] { at = at + 1 }
    let less = at == left.length || (at < right.length && left[at] < right[at])
    if less { high = middle } else { low = middle + 1 }
  }
  return ""
}

import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.usize
import silk.num.u8
import task_sources_common as S
import silk.uri.uri { Uri, OwnedUri }
import silk.uri.reference { UriReference, ParseError }

fn space(b: u8) -> bool { return b == 9 || b == 10 || b == 12 || b == 13 || b == 32 }
fn lower(b: u8) -> u8 { return if b >= 65 && b <= 90 { b + 32 } else { b } }
effect fn lowercase(value: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = run Bytes.copy(String.utf8Bytes(value))
  let data = Bytes.asMutSlice(&mut bytes)
  let mut i: usize = 0
  while i < data.length { data[i] = lower(data[i])
     i = i + 1 }
  return run String.copy(unsafe String.fromUtf8Unchecked(Bytes.asSlice(&bytes)))
}
effect fn scalar(output: &mut String, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut cp = value
  if cp == 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) { cp = 0xFFFD }
  let mut bytes: [u8; 4] = [0; 4]
  let mut count: usize = 1
  if cp < 128 { bytes[0] = usize.toU8(cp) }
  else if cp < 2048 { bytes[0] = usize.toU8(cp / 64) + 192
     bytes[1] = usize.toU8(cp % 64) + 128
     count = 2 }
  else if cp < 65536 { bytes[0] = usize.toU8(cp / 4096) + 224
     bytes[1] = usize.toU8(cp / 64 % 64) + 128
     bytes[2] = usize.toU8(cp % 64) + 128
     count = 3 }
  else { bytes[0] = usize.toU8(cp / 262144) + 240
     bytes[1] = usize.toU8(cp / 4096 % 64) + 128
     bytes[2] = usize.toU8(cp / 64 % 64) + 128
     bytes[3] = usize.toU8(cp % 64) + 128
     count = 4 }
  run String.append(&mut output, unsafe String.fromUtf8Unchecked(Slice.view<u8>(&bytes, 0, count)))
}
fn numericReplacement(cp: usize) -> usize {
  return match cp {
    128 => 0x20AC
    130 => 0x201A
    131 => 0x0192
    132 => 0x201E
    133 => 0x2026
    134 => 0x2020
    135 => 0x2021
    136 => 0x02C6
    137 => 0x2030
    138 => 0x0160
    139 => 0x2039
    140 => 0x0152
    142 => 0x017D
    145 => 0x2018
    146 => 0x2019
    147 => 0x201C
    148 => 0x201D
    149 => 0x2022
    150 => 0x2013
    151 => 0x2014
    152 => 0x02DC
    153 => 0x2122
    154 => 0x0161
    155 => 0x203A
    156 => 0x0153
    158 => 0x017E
    159 => 0x0178
    _ => cp
  }
}
effect fn unescape(value: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(value)
  let mut result = String.make()
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    if bytes[i] != 38 { i = i + 1
       continue }
    run String.append(&mut result, String.slice(value, start, i - start))
    let mut end = i + 1
    if end < bytes.length && bytes[end] == 35 {
      end = end + 1
      let mut radix: usize = 10
      if end < bytes.length && (bytes[end] == 120 || bytes[end] == 88) { radix = 16
         end = end + 1 }
      let first = end
      let mut cp: usize = 0
      while end < bytes.length {
        let b = lower(bytes[end])
        let digit = if b >= 48 && b <= 57 { u8.toUsize(b - 48) } else if b >= 97 && b <= 102 { u8.toUsize(b - 87) } else { 100 }
        if digit >= radix { break }
        if cp < 0x110000 { cp = cp * radix + digit }
        end = end + 1
      }
      if end > first {
        if end < bytes.length && bytes[end] == 59 { end = end + 1 }
        // HTML's invalid numeric character references are omitted by HTMLParser.
        if !(cp >= 1 && cp <= 8) && cp != 11 && !(cp >= 14 && cp <= 31) && cp != 127 && !(cp >= 0xFDD0 && cp <= 0xFDEF) && cp % 65536 != 65534 && cp % 65536 != 65535 {
          run scalar(&mut result, numericReplacement(cp))
        }
        i = end
           start = i
           continue
      }
    } else {
      let mut matched = false
      while end < bytes.length && end - i <= 33 && !space(bytes[end]) && bytes[end] != 38 && bytes[end] != 60 && bytes[end] != 35 {
        end = end + 1
        if bytes[end - 1] == 59 { break }
      }
      while end > i + 1 {
        let replacement = entity(String.slice(value, i + 1, end - i - 1))
        if String.byteLength(replacement) > 0 {
          run String.append(&mut result, replacement)
          matched = true
          i = end
             start = i
             break
        }
        end = end - 1
      }
      if matched { continue }
    }
    run String.append(&mut result, "&")
    i = i + 1
       start = i
  }
  run String.append(&mut result, String.slice(value, start, bytes.length - start))
  return move result
}
effect fn resolve(baseText: string, href: string) -> String ! TaskError | OutOfMemoryError ? &mut Allocator {
  let base = match Uri.parse(baseText) {
    Result<Uri, ParseError>.Success { value } => value
    Result<Uri, ParseError>.Failure { .. } => run Task.abort("invalid resolved bibliography base URL")
  }
  let reference = match UriReference.parse(href) {
    Result<UriReference, ParseError>.Success { value } => value
    Result<UriReference, ParseError>.Failure { .. } => run Task.abort("invalid normative reference URL")
  }
  let resolved = match move run Uri.resolveOwned(&base, &reference) {
    Result<OwnedUri, ParseError>.Success { value } => move value
    Result<OwnedUri, ParseError>.Failure { .. } => run Task.abort("cannot resolve normative reference URL")
  }
  let view = OwnedUri.view(&resolved)
  let formatted = Uri.format(&view)
  let end = String.find(formatted, "#") |> Option<usize>.unwrapOr(String.byteLength(formatted))
  return run String.copy(String.slice(formatted, 0, end))
}
pub effect fn references(html: string, base: string) -> Value ! TaskError | OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(html)
  let mut urls = S.object()
  let mut active = false
  let mut name = String.make()
  let mut raw = String.make()
  let mut i: usize = 0
  while i < bytes.length {
    if bytes[i] != 60 { i = i + 1
       continue }
    if String.startsWith(String.slice(html, i, bytes.length - i), "<!--") {
      let rest = String.slice(html, i + 4, bytes.length - i - 4)
      i = match String.find(rest, "-->") { Option<usize>.Some { value } => i + 4 + value + 3
        Option<usize>.None => bytes.length }
      continue
    }
    i = i + 1
    let closing = i < bytes.length && bytes[i] == 47
    if closing { i = i + 1 }
    let start = i
    while i < bytes.length && !space(bytes[i]) && bytes[i] != 62 && bytes[i] != 47 { i = i + 1 }
    let tag = run lowercase(String.slice(html, start, i - start))
    if String.byteLength(raw.view()) > 0 {
      if closing && tag.view() == raw.view() { String.clear(&mut raw) }
      continue
    }
    let mut attributes = S.object()
    while i < bytes.length && bytes[i] != 62 {
      if space(bytes[i]) || bytes[i] == 47 { i = i + 1
         continue }
      let keyStart = i
      while i < bytes.length && !space(bytes[i]) && bytes[i] != 61 && bytes[i] != 62 && bytes[i] != 47 { i = i + 1 }
      let key = run lowercase(String.slice(html, keyStart, i - keyStart))
      while i < bytes.length && space(bytes[i]) { i = i + 1 }
      let mut value = String.make()
      if i < bytes.length && bytes[i] == 61 {
        i = i + 1
        while i < bytes.length && space(bytes[i]) { i = i + 1 }
        let quote = if i < bytes.length && (bytes[i] == 34 || bytes[i] == 39) { bytes[i] } else { 0 }
        if quote != 0 { i = i + 1 }
        let valueStart = i
        while i < bytes.length && (if quote != 0 { bytes[i] != quote } else { !space(bytes[i]) && bytes[i] != 62 }) { i = i + 1 }
        value = run unescape(String.slice(html, valueStart, i - valueStart))
        if quote != 0 && i < bytes.length { i = i + 1 }
      }
      run S.set(&mut attributes, key.view(), run S.str(value.view()))
      if i == keyStart { i = i + 1 }
    }
    if i < bytes.length { i = i + 1 }
    if closing { continue }
    if tag.view() == "script" || tag.view() == "style" { raw = run String.copy(tag.view()) }
    let id = Json.field(&attributes, "id") |> Json.asString |> Option<string>.unwrapOr("")
    if id == "normative" { active = true }
    else if id == "informative" || id == "index" || id == "idl-index" { active = false }
    if !active { continue }
    if tag.view() == "dt" && String.startsWith(id, "biblio-") { name = run lowercase(String.slice(id, 7, String.byteLength(id) - 7)) }
    if tag.view() == "a" && String.byteLength(name.view()) > 0 {
      if let Option<string>.Some { value: href } = Json.field(&attributes, "href") |> Json.asString {
        let url = run resolve(base, href)
        if String.startsWith(url.view(), "https://") && !S.has(&urls, name.view()) { run S.set(&mut urls, name.view(), run S.str(url.view())) }
      }
    }
  }
  return move urls
}


import task_json { J }
import task_bench_workloads { literal, document, add, label }
import silk.cli.task { TaskError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.json.value { Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.i32
import silk.num.i64
import silk.num.usize

pub struct Scene { pub document: Value, pub scenarios: Value }
const WORDS: [string; 31] = ["layout", "boxes", "flow", "into", "lines", "and", "every", "line", "of", "text", "breaks", "where", "the", "engine", "finds", "room", "for", "the", "next", "word", "while", "floats", "and", "flex", "items", "share", "the", "space", "they", "are", "given"]

effect fn sentence(seed: i64, count: i64) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut result = String.make()
  let mut i: i64 = 0
  while i < count {
    if i > 0 { run String.append(&mut result, " ") }
    run String.append(&mut result, WORDS[i64.toUsize((seed * 7 + i) % 31)])
    i = i + 1
  }
  return Value.String { text: move result }
}
effect fn element(nodes: &mut Value, parent: i64, style: string) -> i64 ! TaskError | OutOfMemoryError ? &mut Allocator {
  return run add(&mut nodes, parent, run literal(style), Value.Null)
}
effect fn textNode(nodes: &mut Value, parent: i64, text: Value) -> i64 ! OutOfMemoryError ? &mut Allocator {
  let index = usize.toI64(J.length(&nodes))
  let mut node = J.object()
  run J.set(&mut node, "parent", J.int(parent))
  run J.set(&mut node, "text", move text)
  run J.push(&mut nodes, move node)
  return index
}
effect fn fonts() -> Value ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut result = J.array()
  let sizes: [f64; 4] = [15.0,13.0,26.0,40.0]
  let mut i: usize = 0
  while i < sizes.length {
    let size = sizes[i]
    let mut font = run literal("{\"lineGap\":0,\"subscriptOffset\":2,\"superscriptOffset\":4}")
    run J.set(&mut font, "fontSize", J.float(size))
    run J.set(&mut font, "ascent", J.float(size * 0.9))
    run J.set(&mut font, "descent", J.float(size * 0.25))
    run J.set(&mut font, "xHeight", J.float(size / 2.0))
    run J.set(&mut font, "capHeight", J.float(size * 0.7))
    let mut baselines = J.object()
    run J.set(&mut baselines, "alphabetic", J.float(size * 0.9))
    run J.set(&mut baselines, "ideographic", J.float(size * 1.15))
    run J.set(&mut baselines, "central", J.float(size * 0.57))
    run J.set(&mut baselines, "mathematical", J.float(size * 0.6))
    run J.set(&mut font, "baselines", move baselines)
    run J.push(&mut result, move font)
    i = i + 1
  }
  return move result
}
pub effect fn resize(width: i64, height: i64, first: i64) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut result = J.array()
  let mut i: i64 = first
  while i < first + 40 {
    let mut viewport = J.object()
    run J.set(&mut viewport, "width", J.int(width - i))
    run J.set(&mut viewport, "height", J.int(height))
    let mut step = J.object()
    run J.set(&mut step, "viewport", move viewport)
    run J.push(&mut result, move step)
    i = i + 1
  }
  return move result
}
effect fn step(change: Value) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut changes = J.array()
  run J.push(&mut changes, move change)
  let mut result = J.object()
  run J.set(&mut result, "set", move changes)
  return move result
}
effect fn pair(first: Value, second: Value) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut cycle = J.array()
  run J.push(&mut cycle, run step(move first))
  run J.push(&mut cycle, run step(move second))
  return move cycle
}
effect fn styleChange(nodes: &Value, node: i64, patch: string) -> Value ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut change = J.object()
  run J.set(&mut change, "node", J.int(node))
  run J.set(&mut change, "style", run J.overlay(J.get(J.at(nodes, i64.toUsize(node)), "style"), patch))
  return move change
}
pub effect fn styleCycle(nodes: &Value, node: i64, first: string, second: string) -> Value ! TaskError | OutOfMemoryError ? &mut Allocator {
  return run pair(run styleChange(nodes, node, first), run styleChange(nodes, node, second))
}
effect fn textCycle(nodes: &Value, node: i64, replacement: Value) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut first = J.object()
  run J.set(&mut first, "node", J.int(node))
  run J.set(&mut first, "text", move replacement)
  let mut second = J.object()
  run J.set(&mut second, "node", J.int(node))
  run J.set(&mut second, "text", run J.copy(J.get(J.at(nodes, i64.toUsize(node)), "text")))
  return run pair(move first, move second)
}
effect fn appendText(nodes: &Value, node: i64, suffix: string) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut result = run String.copy(J.str(J.get(J.at(nodes, i64.toUsize(node)), "text")))
  run String.append(&mut result, suffix)
  return Value.String { text: move result }
}
effect fn finish(nodes: Value, width: i64, scenarios: Value) -> Scene ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut result = run document(move nodes, width, 4000)
  run J.set(&mut result, "fonts", run fonts())
  return Scene { document: move result, scenarios: move scenarios }
}
effect fn baseScenarios(width: i64) -> Value ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut result = J.object()
  run J.set(&mut result, "unchanged", run literal("[{\"set\":[]}]"))
  return move result
}

effect fn cards(count: i64) -> Scene ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut nodes = J.array()
  let _root = run element(&mut nodes, -1, "{\"display\":\"flex\",\"flexWrap\":\"wrap\",\"columnGap\":16,\"rowGap\":16,\"padding\":20,\"lineHeight\":1.5,\"fontKey\":1,\"boxSizing\":\"border-box\"}")
  let mut markedCard: i64 = 0
  let mut markedButton: i64 = 0
  let mut markedText: i64 = 0
  let mut card: i64 = 0
  while card < count {
    let box = run element(&mut nodes, 0, "{\"boxSizing\":\"border-box\",\"display\":\"flex\",\"flexDirection\":\"column\",\"flexGrow\":1,\"flexShrink\":1,\"flexBasis\":200,\"padding\":18,\"border\":1,\"rowGap\":10,\"lineHeight\":1.5,\"fontKey\":1}")
    let title = run element(&mut nodes, box, "{\"lineHeight\":1.5,\"fontKey\":2}")
    let _title = run textNode(&mut nodes, title, run label("Plan ", card))
    let price = run element(&mut nodes, box, "{\"display\":\"flex\",\"alignItems\":\"baseline\",\"columnGap\":6,\"lineHeight\":1.5,\"fontKey\":1}")
    let amount = run element(&mut nodes, price, "{\"lineHeight\":1.1,\"fontKey\":4}")
    let _amount = run textNode(&mut nodes, amount, run label("", card * 9))
    let per = run element(&mut nodes, price, "{\"lineHeight\":1.5,\"fontKey\":2}")
    let _per = run textNode(&mut nodes, per, run J.text("per month"))
    let body = run element(&mut nodes, box, "{\"lineHeight\":1.5,\"fontKey\":1}")
    let paragraph = run textNode(&mut nodes, body, run sentence(card, 18))
    let button = run element(&mut nodes, box, "{\"marginTop\":\"auto\",\"padding\":10,\"textAlign\":\"center\",\"lineHeight\":1.5,\"fontKey\":2}")
    let _button = run textNode(&mut nodes, button, run J.text("Choose plan"))
    if card == 5 { markedCard = box
    markedButton = button
    markedText = paragraph }
    card = card + 1
  }
  let mut scenarios = run baseScenarios(760)
  run J.set(&mut scenarios, "leaf-style", run styleCycle(&nodes, markedButton, "{\"padding\":12}", "{\"padding\":10}"))
  run J.set(&mut scenarios, "card-style", run styleCycle(&nodes, markedCard, "{\"flexBasis\":260}", "{\"flexBasis\":200}"))
  run J.set(&mut scenarios, "text-edit", run textCycle(&nodes, markedText, run appendText(&nodes, markedText, " more")))
  run J.set(&mut scenarios, "resize", run resize(760,4000,0))
  return run finish(move nodes,760,move scenarios)
}
effect fn article(count: i64) -> Scene ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut nodes = J.array()
  let _root = run element(&mut nodes, -1, "{\"padding\":24,\"lineHeight\":1.6,\"fontKey\":1}")
  let mut markedBlock: i64 = 0
  let mut markedText: i64 = 0
  let mut section: i64 = 0
  while section < count {
    let heading = run element(&mut nodes,0,"{\"lineHeight\":1.15,\"marginBottom\":12,\"fontKey\":3}")
    let _heading = run textNode(&mut nodes,heading,run label("Section ",section))
    if section == 0 { let _float = run element(&mut nodes,0,"{\"float\":\"left\",\"width\":140,\"height\":110,\"marginRight\":16,\"border\":1}") }
    let mut i: i64 = 0
    while i < 4 {
      let block = run element(&mut nodes,0,"{\"marginBottom\":12,\"lineHeight\":1.6,\"fontKey\":1}")
      let text = run textNode(&mut nodes,block,run sentence(section * 4 + i,60))
      if section * 4 + i == 13 { markedBlock = block
      markedText = text }
      i = i + 1
    }
    section = section + 1
  }
  let mut scenarios = run baseScenarios(680)
  run J.set(&mut scenarios,"leaf-style",run styleCycle(&nodes,markedBlock,"{\"marginBottom\":20}","{\"marginBottom\":12}"))
  run J.set(&mut scenarios,"text-edit",run textCycle(&nodes,markedText,run appendText(&nodes,markedText," more")))
  run J.set(&mut scenarios,"font",run styleCycle(&nodes,markedBlock,"{\"fontKey\":2,\"lineHeight\":1.3}","{\"fontKey\":1,\"lineHeight\":1.6}"))
  run J.set(&mut scenarios,"hide",run styleCycle(&nodes,markedBlock,"{\"display\":\"none\"}","{}"))
  run J.set(&mut scenarios,"resize",run resize(680,4000,0))
  return run finish(move nodes,680,move scenarios)
}
effect fn rows(count: i64) -> Scene ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut nodes = J.array()
  let _root = run element(&mut nodes,-1,"{\"padding\":8,\"lineHeight\":1.4,\"fontKey\":1}")
  let mut target: i64 = 0
  let mut row: i64 = 0
  while row < count {
    let line = run element(&mut nodes,0,"{\"display\":\"flex\",\"alignItems\":\"center\",\"columnGap\":8,\"padding\":4,\"lineHeight\":1.4,\"fontKey\":1}")
    let labelNode = run element(&mut nodes,line,"{\"flexGrow\":1,\"lineHeight\":1.4,\"fontKey\":1}")
    let _label = run textNode(&mut nodes,labelNode,run sentence(row,4))
    let value = run element(&mut nodes,line,"{\"lineHeight\":1.4,\"fontKey\":2}")
    let text = run textNode(&mut nodes,value,run label("",row * 13))
    if row == count / 2 { target = text }
    row = row + 1
  }
  let mut scenarios = run baseScenarios(600)
  run J.set(&mut scenarios,"text-edit",run textCycle(&nodes,target,run J.text("99999")))
  run J.set(&mut scenarios,"resize",run resize(600,4000,0))
  return run finish(move nodes,600,move scenarios)
}
effect fn grid(count: i64) -> Scene ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut nodes = J.array()
  let _root = run element(&mut nodes,-1,"{\"display\":\"grid\",\"gridTemplateColumns\":[{\"repeat\":{\"count\":\"auto-fit\",\"tracks\":[{\"minmax\":[160,{\"fr\":1}]}]}}],\"gridAutoFlow\":\"row dense\",\"columnGap\":12,\"rowGap\":12,\"padding\":20,\"boxSizing\":\"border-box\",\"lineHeight\":1.4,\"fontKey\":1}")
  let mut target: i64 = 0
  let mut targetText: i64 = 0
  let mut i: i64 = 0
  while i < count {
    let cell = run element(&mut nodes,0,"{\"display\":\"grid\",\"gridTemplateColumns\":[{\"fr\":1}],\"rowGap\":4,\"padding\":8,\"border\":1,\"boxSizing\":\"border-box\",\"lineHeight\":1.4,\"fontKey\":1}")
    let heading = run element(&mut nodes,cell,"{\"lineHeight\":1.4,\"fontKey\":2}")
    let _heading = run textNode(&mut nodes,heading,run label("Cell ",i))
    let body = run element(&mut nodes,cell,"{\"lineHeight\":1.4,\"fontKey\":1}")
    let text = run textNode(&mut nodes,body,run sentence(i,8))
    if i == count / 2 { target = cell
    targetText = text }
    i = i + 1
  }
  let mut scenarios = run baseScenarios(720)
  let original = String.utf8Bytes(J.str(J.get(J.at(&nodes,i64.toUsize(targetText)),"text")))
  let mut fitting = run String.copy("x")
  run String.append(&mut fitting,unsafe String.fromUtf8Unchecked(Slice.view<u8>(original,1,original.length - 1)))
  run J.set(&mut scenarios,"text-edit",run textCycle(&nodes,targetText,Value.String { text: move fitting }))
  let suffix = run sentence(count,40)
  let mut growing = run appendText(&nodes,targetText," ")
  match &mut growing { Value.String { text } => run String.append(&mut text,J.str(&suffix))
  _ => {} }
  run J.set(&mut scenarios,"text-grow",run textCycle(&nodes,targetText,move growing))
  run J.set(&mut scenarios,"item-order",run styleCycle(&nodes,target,"{\"order\":-1}","{}"))
  run J.set(&mut scenarios,"placement",run styleCycle(&nodes,target,"{\"gridColumnStart\":2,\"gridColumnEnd\":{\"span\":2},\"gridRowStart\":1,\"gridRowEnd\":{\"span\":1}}","{}"))
  run J.set(&mut scenarios,"flow",run styleCycle(&nodes,0,"{\"gridAutoFlow\":\"column dense\"}","{}"))
  run J.set(&mut scenarios,"template",run styleCycle(&nodes,0,"{\"gridTemplateColumns\":[{\"repeat\":{\"count\":\"auto-fit\",\"tracks\":[{\"minmax\":[120,{\"fr\":1}]}]}}]}","{}"))
  run J.set(&mut scenarios,"hide",run styleCycle(&nodes,target,"{\"display\":\"none\"}","{}"))
  run J.set(&mut scenarios,"resize",run resize(720,4000,0))
  return run finish(move nodes,720,move scenarios)
}
pub effect fn scene(name: string, small: bool) -> Scene ! TaskError | OutOfMemoryError ? &mut Allocator {
  if name == "cards" { return run cards(if small { 6 } else { 12 }) }
  if name == "article" { return run article(if small { 4 } else { 8 }) }
  if name == "rows" { return run rows(if small { 20 } else { 200 }) }
  return run grid(if small { 12 } else { 200 })
}
pub effect fn comparisonScenarios(document: &Value) -> Value ! TaskError | OutOfMemoryError ? &mut Allocator {
  let nodes = J.get(document,"nodes")
  let mut parents = List<bool>.make()
  run List<bool>.appendRepeated(&mut parents,false,J.length(nodes))
  let mut i: usize = 1
  while i < J.length(nodes) {
    let parent = i64.toUsize(J.integer(J.get(J.at(nodes,i),"parent")))
    let parentSlots = List<bool>.asMutSlice(&mut parents)
    parentSlots[parent] = true
    i = i + 1
  }
  let mut leaves = List<i64>.make()
  let mut containers = List<i64>.make()
  i = 1
  while i < J.length(nodes) {
    if List<bool>.get(&parents,i) { run List<i64>.append(&mut containers,usize.toI64(i)) }
    else { run List<i64>.append(&mut leaves,usize.toI64(i)) }
    i = i + 1
  }
  let mut result = J.object()
  if List<i64>.length(&leaves) > 0 { run J.set(&mut result,"leaf",run styleCycle(nodes,List<i64>.get(&leaves,List<i64>.length(&leaves) / 2),"{\"padding\":3}","{\"padding\":1}")) }
  if List<i64>.length(&containers) > 0 { run J.set(&mut result,"container",run styleCycle(nodes,List<i64>.get(&containers,List<i64>.length(&containers) / 2),"{\"padding\":3}","{\"padding\":1}")) }
  let viewport = J.get(document,"viewport")
  run J.set(&mut result,"resize",run resize(J.integer(J.get(viewport,"width")),J.integer(J.get(viewport,"height")),1))
  return move result
}
pub effect fn finalDocument(document: &Value, cycle: &Value, iterations: i32) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut result = run J.copy(document)
  let steps = J.items(cycle)
  let mut iteration: i32 = 0
  while iteration < iterations {
    let step = &steps[i32.toUsize(iteration) % steps.length]
    if J.has(step,"viewport") { run J.set(&mut result,"viewport",run J.copy(J.get(step,"viewport"))) }
    let changes = J.items(J.get(step,"set"))
    let mut i: usize = 0
    while i < changes.length {
      let index = i64.toUsize(J.integer(J.get(&changes[i],"node")))
      let node = J.atMut(J.getMut(&mut result,"nodes"),index)
      if J.has(&changes[i],"style") { run J.set(&mut node,"style",run J.copy(J.get(&changes[i],"style"))) }
      if J.has(&changes[i],"text") { run J.set(&mut node,"text",run J.copy(J.get(&changes[i],"text"))) }
      i = i + 1
    }
    iteration = iteration + 1
  }
  return move result
}

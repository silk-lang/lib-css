import silk.collections.slice { Slice }
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize

// CPython random.Random's integer seeding, MT19937, 53-bit random(), and
// rejection-sampled _randbelow. Draw ordering is part of the fuzz corpus.
pub struct Random { state: [u32; 624], position: usize }
impl Random {
  pub fn make(seed: i64) -> Random {
    let magnitude = if seed >= 0 { i64.toU64(seed) } else { i64.toU64(-(seed + 1)) + 1 }
    let words = [u64.wrappingToU32(magnitude), u64.toU32(u64.shiftRight(magnitude, 32))]
    return Random.seed(Slice.view<u32>(&words, 0, if words[1] == 0 { 1 } else { 2 }))
  }
  pub fn structure(seed: i64) -> Random {
    let magnitude = if seed >= 0 { i64.toU64(seed) } else { i64.toU64(-(seed + 1)) + 1 }
    let low = u64.bitAnd(magnitude, 4294967295) * 7919
    let high = u64.shiftRight(magnitude, 32) * 7919 + u64.shiftRight(low, 32)
    let mut words = [u64.wrappingToU32(low), u64.wrappingToU32(high), u64.toU32(u64.shiftRight(high, 32))]
    if seed < 0 {
      if words[0] == 0 { words[0] = 4294967295
      if words[1] == 0 { words[1] = 4294967295
      words[2] = words[2] - 1 } else { words[1] = words[1] - 1 } }
      else { words[0] = words[0] - 1 }
    } else {
      if words[0] == 4294967295 { words[0] = 0
      if words[1] == 4294967295 { words[1] = 0
      words[2] = words[2] + 1 } else { words[1] = words[1] + 1 } }
      else { words[0] = words[0] + 1 }
    }
    let count: usize = if words[2] != 0 { 3 } else if words[1] != 0 { 2 } else { 1 }
    return Random.seed(Slice.view<u32>(&words, 0, count))
  }
  fn seed(words: &[u32]) -> Random {
    let mut result = Random { state: [0; 624], position: 624 }
    result.state[0] = 19650218
    let mut i: usize = 1
    while i < 624 {
      let old = result.state[i - 1]
      result.state[i] = u64.wrappingToU32(u32.toU64(u32.bitXor(old, u32.shiftRight(old, 30))) * 1812433253 + usize.toU64(i))
      i = i + 1
    }
    i = 1
    let mut j: usize = 0
    let mut k: usize = 0
    while k < 624 {
      let old = result.state[i - 1]
      let mixed = u64.wrappingToU32(u32.toU64(u32.bitXor(old, u32.shiftRight(old, 30))) * 1664525)
      result.state[i] = u64.wrappingToU32(u32.toU64(u32.bitXor(result.state[i], mixed)) + u32.toU64(words[j]) + usize.toU64(j))
      i = i + 1
      j = j + 1
      if i >= 624 { result.state[0] = result.state[623]
      i = 1 }
      if j >= words.length { j = 0 }
      k = k + 1
    }
    k = 0
    while k < 623 {
      let old = result.state[i - 1]
      let mixed = u64.wrappingToU32(u32.toU64(u32.bitXor(old, u32.shiftRight(old, 30))) * 1566083941)
      result.state[i] = u64.wrappingToU32(u32.toU64(u32.bitXor(result.state[i], mixed)) + 4294967296 - usize.toU64(i))
      i = i + 1
      if i >= 624 { result.state[0] = result.state[623]
      i = 1 }
      k = k + 1
    }
    result.state[0] = 2147483648
    return move result
  }
  fn word(self: &mut Self) -> u32 {
    if self.position >= 624 {
      let mut i: usize = 0
      while i < 624 {
        let y = u32.bitOr(u32.bitAnd(self.state[i], 2147483648), u32.bitAnd(self.state[(i + 1) % 624], 2147483647))
        self.state[i] = u32.bitXor(u32.bitXor(self.state[(i + 397) % 624], u32.shiftRight(y, 1)), if u32.bitAnd(y, 1) == 0 { 0 } else { 2567483615 })
        i = i + 1
      }
      self.position = 0
    }
    let mut y = self.state[self.position]
    self.position = self.position + 1
    y = u32.bitXor(y, u32.shiftRight(y, 11))
    y = u32.bitXor(y, u32.bitAnd(u32.shiftLeft(y, 7), 2636928640))
    y = u32.bitXor(y, u32.bitAnd(u32.shiftLeft(y, 15), 4022730752))
    return u32.bitXor(y, u32.shiftRight(y, 18))
  }
  pub fn random(self: &mut Self) -> f64 {
    let a = u32.shiftRight(self.word(), 5)
    let b = u32.shiftRight(self.word(), 6)
    return (u32.toF64(a) * 67108864.0 + u32.toF64(b)) / 9007199254740992.0
  }
  pub fn below(self: &mut Self, upper: usize) -> usize {
    if upper == 0 { return Intrinsic.trap("random choice requires a nonempty sequence") }
    let mut bits: u32 = 0
    let mut n = upper
    while n != 0 { bits = bits + 1
    n = n / 2 }
    while true { let value = u32.toUsize(u32.shiftRight(self.word(), 32 - bits))
    if value < upper { return value } }
  }
  pub fn integer(self: &mut Self, low: i64, high: i64) -> i64 { return low + usize.toI64(self.below(i64.toUsize(high - low + 1))) }
  pub fn pick<'a>(self: &mut Self, choices: &[string<'a>]) -> string<'a> { return choices[self.below(choices.length)] }
}

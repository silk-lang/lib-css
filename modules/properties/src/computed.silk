//! Computed CSS values: what layout and paint read after the cascade and unit resolution.
//! Lengths are pixels and percentages are fractions (0.5 is 50%).
import silk.color.rgba { Rgba }
import silk.num.f32
import silk.num.u32
import silk.num.u8
import silk.core.option { Option }
import silk.core.equal { Equal }
import silk.core.ownership { Copy }
import silk.geometry.corners { Corners }
import silk.geometry.insets { Insets }

// Values have already passed CSS parsing and cascade. Percentages are fractions.
// Keeping a percentage coefficient distinguishes 0% from 0px in indefinite axes.
/// `Least`, `Most` and `Clamp` need a third number and only a `SizeValue` has them. `Bounded`
/// is `clamp(lower, value + percent * basis, upper)` with the bounds in the style's `Bounds`,
/// at `slot`.
pub enum DimensionKind { Auto, Length, Percent, Calc, Least, Most, Clamp, Bounded, MinContent, MaxContent, FitContent, Content, None, Normal }
pub struct Dimension { pub kind: DimensionKind, pub slot: u8, pub value: f32, pub percent: f32 }
impl Copy for Dimension {}
impl Equal for Dimension {
  fn equals(left: &Dimension, right: &Dimension) -> bool {
    return left.kind == right.kind && left.slot == right.slot && left.value == right.value && left.percent == right.percent
  }
}
impl Dimension {
  pub fn auto() -> Dimension { return Dimension { kind: DimensionKind.Auto, slot: 0, value: 0.0, percent: 0.0 } }
  pub fn px(value: f32) -> Dimension { return Dimension { kind: DimensionKind.Length, slot: 0, value: value, percent: 0.0 } }
  pub fn pct(value: f32) -> Dimension { return Dimension { kind: DimensionKind.Percent, slot: 0, value: 0.0, percent: value } }
  pub fn calc(length: f32, percent: f32) -> Dimension { return Dimension { kind: DimensionKind.Calc, slot: 0, value: length, percent: percent } }
  pub fn keyword(kind: DimensionKind) -> Dimension { return Dimension { kind: kind, slot: 0, value: 0.0, percent: 0.0 } }
  pub fn bounded(length: f32, percent: f32, slot: u8) -> Dimension { return Dimension { kind: DimensionKind.Bounded, slot: slot, value: length, percent: percent } }
  /// The value with its lengths multiplied by `ratio`, for a change of `zoom`. Percentages and
  /// keywords stay.
  pub fn zoomed(self: Dimension, ratio: f32) -> Dimension {
    return Dimension { kind: self.kind, slot: self.slot, value: self.value * ratio, percent: self.percent }
  }
  /// Whether the value depends on a percentage basis.
  pub fn relative(self: Dimension) -> bool {
    return self.kind == DimensionKind.Percent || self.kind == DimensionKind.Calc || self.kind == DimensionKind.Bounded
  }
}
/// A length plus a percentage held between two lengths: `clamp(lower, value + percent * basis,
/// upper)`, where `min()` has no lower bound and `max()` no upper one (infinite).
pub struct Bound { pub lower: f32, pub value: f32, pub percent: f32, pub upper: f32 }
impl Copy for Bound {}
impl Bound {
  pub fn line(value: f32, percent: f32) -> Bound { return Bound { lower: 0.0 - f32.INFINITY, value: value, percent: percent, upper: f32.INFINITY } }
  pub fn bounded(self: Bound) -> bool { return self.lower > 0.0 - f32.INFINITY || self.upper < f32.INFINITY }
}
/// How many distinct pairs of bounds one style holds.
pub const BOUND_SLOTS: u8 = 3
/// The bounds of a style's `Bounded` values. Values with the same bounds share a slot, as the
/// four sides of `padding: clamp(1rem, 5%, 3rem)` do; few elements hold any.
pub struct Bounds { pub lower: [f32; 3], pub upper: [f32; 3], pub count: u8 }
impl Copy for Bounds {}
impl Equal for Bounds {
  fn equals(left: &Bounds, right: &Bounds) -> bool {
    if left.count != right.count { return false }
    let mut i: usize = 0
    while i < u8.toUsize(left.count) {
      if left.lower[i] != right.lower[i] || left.upper[i] != right.upper[i] { return false }
      i = i + 1
    }
    return true
  }
}
impl Bounds {
  pub fn none() -> Bounds { return Bounds { lower: [0.0, 0.0, 0.0], upper: [0.0, 0.0, 0.0], count: 0 } }
  /// The slot holding `lower` and `upper`, taken when no slot has them; none when all are taken.
  pub fn slotOf(self: &mut Self, lower: f32, upper: f32) -> Option<u8> {
    let mut i: u8 = 0
    while i < self.count {
      if self.lower[u8.toUsize(i)] == lower && self.upper[u8.toUsize(i)] == upper { return Option<u8>.some(i) }
      i = i + 1
    }
    if self.count == BOUND_SLOTS { return Option<u8>.None }
    self.lower[u8.toUsize(i)] = lower
    self.upper[u8.toUsize(i)] = upper
    self.count = i + 1
    return Option<u8>.some(i)
  }
  /// `line`, the value's length plus its percentage of the basis, held between the value's
  /// bounds when it is `Bounded`.
  @inlineAlways
  pub fn hold(self: &Self, kind: DimensionKind, slot: u8, line: f32) -> f32 {
    if kind != DimensionKind.Bounded { return line }
    let at = u8.toUsize(slot)
    return f32.max(self.lower[at], f32.min(line, self.upper[at]))
  }
  /// The bound held at `slot`, with the value's length and percentage.
  pub fn bound(self: &Self, slot: u8, value: f32, percent: f32) -> Bound {
    let at = u8.toUsize(slot)
    return Bound { lower: self.lower[at], value: value, percent: percent, upper: self.upper[at] }
  }
}
/// A width, height, minimum, maximum or flex basis. Besides every `Dimension` it holds a length
/// against a length plus a percentage: `Least` is `min(bound, value + percent)` and `Most` is
/// `max(bound, value + percent)`. `Clamp` is `clamp(value, percent, bound)`. Only these seven
/// fields pay for the third number; edges and gaps stay a `Dimension`.
pub struct SizeValue { pub kind: DimensionKind, pub slot: u8, pub value: f32, pub percent: f32, pub bound: f32 }
impl Copy for SizeValue {}
impl Equal for SizeValue {
  fn equals(left: &SizeValue, right: &SizeValue) -> bool {
    return left.kind == right.kind && left.slot == right.slot && left.value == right.value && left.percent == right.percent && left.bound == right.bound
  }
}
impl SizeValue {
  pub fn of(value: Dimension) -> SizeValue { return SizeValue { kind: value.kind, slot: value.slot, value: value.value, percent: value.percent, bound: 0.0 } }
  pub fn auto() -> SizeValue { return SizeValue { kind: DimensionKind.Auto, slot: 0, value: 0.0, percent: 0.0, bound: 0.0 } }
  pub fn px(value: f32) -> SizeValue { return SizeValue { kind: DimensionKind.Length, slot: 0, value: value, percent: 0.0, bound: 0.0 } }
  pub fn pct(value: f32) -> SizeValue { return SizeValue { kind: DimensionKind.Percent, slot: 0, value: 0.0, percent: value, bound: 0.0 } }
  pub fn calc(length: f32, percent: f32) -> SizeValue { return SizeValue { kind: DimensionKind.Calc, slot: 0, value: length, percent: percent, bound: 0.0 } }
  pub fn keyword(kind: DimensionKind) -> SizeValue { return SizeValue { kind: kind, slot: 0, value: 0.0, percent: 0.0, bound: 0.0 } }
  pub fn least(bound: f32, length: f32, percent: f32) -> SizeValue { return SizeValue { kind: DimensionKind.Least, slot: 0, value: length, percent: percent, bound: bound } }
  pub fn most(bound: f32, length: f32, percent: f32) -> SizeValue { return SizeValue { kind: DimensionKind.Most, slot: 0, value: length, percent: percent, bound: bound } }
  pub fn clamp(lower: f32, percent: f32, upper: f32) -> SizeValue { return SizeValue { kind: DimensionKind.Clamp, slot: 0, value: lower, percent: percent, bound: upper } }
  pub fn bounded(length: f32, percent: f32, slot: u8) -> SizeValue { return SizeValue { kind: DimensionKind.Bounded, slot: slot, value: length, percent: percent, bound: 0.0 } }
  /// The value with its lengths multiplied by `ratio`, for a change of `zoom`.
  pub fn zoomed(self: SizeValue, ratio: f32) -> SizeValue {
    return SizeValue { kind: self.kind, slot: self.slot, value: self.value * ratio, percent: self.percent, bound: self.bound * ratio }
  }
  /// Whether the value depends on a percentage basis.
  pub fn relative(self: SizeValue) -> bool {
    return self.kind == DimensionKind.Percent || self.kind == DimensionKind.Calc || self.kind == DimensionKind.Least
      || self.kind == DimensionKind.Most || self.kind == DimensionKind.Clamp || self.kind == DimensionKind.Bounded
  }
}
pub struct Edges { pub top: Dimension, pub right: Dimension, pub bottom: Dimension, pub left: Dimension }
impl Copy for Edges {}
impl Equal for Edges {
  fn equals(left: &Edges, right: &Edges) -> bool {
    return &left.top == &right.top && &left.right == &right.right && &left.bottom == &right.bottom && &left.left == &right.left
  }
}
impl Edges {
  pub fn all(value: Dimension) -> Edges { return Edges { top: value, right: value, bottom: value, left: value } }
}
// CSS Display 3 §2: participation in the parent and layout of descendants
// are independent. Box-suppression values have neither outside nor inside.
pub enum DisplayOutside { Block, Inline }
// CSS Display 3 §2.4: the layout-internal table values are kept as inner display types of
// block-level boxes, so `outsideIs(Block)` holds for them.
pub enum DisplayInside { Flow, FlowRoot, Flex, Grid, Table, TableRowGroup, TableHeaderGroup, TableFooterGroup, TableRow, TableColumnGroup, TableColumn, TableCell, TableCaption, GridLanes }
pub union Display {
  Box { pub outside: DisplayOutside, pub inside: DisplayInside },
  None,
  Contents
}
impl Copy for Display {}
impl Equal for Display {
  fn equals(left: &Display, right: &Display) -> bool {
    return match left.* {
      Display.Box { outside, inside } => right.outsideIs(outside) && right.insideIs(inside)
      Display.None => right.isNone()
      Display.Contents => right.isContents()
    }
  }
}
impl Display {
  pub fn isNone(self: &Self) -> bool {
    return match self.* {
      Display.None => true
      _ => false
    }
  }
  pub fn isContents(self: &Self) -> bool {
    return match self.* {
      Display.Contents => true
      _ => false
    }
  }
  pub fn outsideIs(self: &Self, expected: DisplayOutside) -> bool {
    return match self.* {
      Display.Box { outside, inside: _ } => outside == expected
      _ => false
    }
  }
  pub fn insideIs(self: &Self, expected: DisplayInside) -> bool {
    return match self.* {
      Display.Box { outside: _, inside } => inside == expected
      _ => false
    }
  }
  // A grid container, including a grid lanes (masonry) one.
  pub fn isGrid(self: &Self) -> bool {
    return match self.* {
      Display.Box { outside: _, inside } => inside == DisplayInside.Grid || inside == DisplayInside.GridLanes
      _ => false
    }
  }
  // A layout-internal table box: a row group, row, column (group), cell or caption.
  pub fn isTablePart(self: &Self) -> bool {
    return match self.* {
      Display.Box { outside: _, inside } => inside != DisplayInside.Flow && inside != DisplayInside.FlowRoot && inside != DisplayInside.Flex && inside != DisplayInside.Grid && inside != DisplayInside.Table && inside != DisplayInside.GridLanes
      _ => false
    }
  }
  pub fn blockified(self: &Self) -> Display {
    return match self.* {
      Display.Box { outside, inside } => {
        let mut inner = inside
        // §2.7 preserves CSS2's inline-block -> block computed-value rule.
        if outside == DisplayOutside.Inline && inside == DisplayInside.FlowRoot { inner = DisplayInside.Flow }
        // Layout-internal table boxes blockify to block.
        if self.isTablePart() { inner = DisplayInside.Flow }
        return Display.Box { outside: DisplayOutside.Block, inside: inner }
      }
      Display.None => Display.None
      Display.Contents => Display.Contents
    }
  }
}
pub enum BoxSizing { ContentBox, BorderBox }
pub enum Direction { Ltr, Rtl }
pub enum UnicodeBidi { Normal, Embed, Isolate, BidiOverride, IsolateOverride, Plaintext }
pub enum WritingMode { HorizontalTb, VerticalRl, VerticalLr, SidewaysRl, SidewaysLr }
pub enum TextOrientation { Mixed, Upright, Sideways }
pub enum FlexDirection { Row, RowReverse, Column, ColumnReverse }
pub enum FlexWrap { NoWrap, Wrap, WrapReverse }
pub enum Align { Auto, Normal, Start, End, FlexStart, FlexEnd, Center, Stretch, SpaceBetween, SpaceAround, SpaceEvenly, Baseline, LastBaseline, SelfStart, SelfEnd, Left, Right }
pub enum OverflowAlignment { Default, Safe, Unsafe }
pub enum Overflow { Visible, Clip, Hidden, Scroll, Auto }
pub enum ScrollbarWidth { Auto, Thin, None }
pub enum ScrollbarGutter { Auto, Stable, StableBothEdges }
pub enum Position { Static, Relative, Absolute, Fixed, Sticky }
pub enum Float { None, Left, Right }
pub enum Clear { None, Left, Right, Both }
pub enum Visibility { Visible, Hidden, Collapse }
// CSS 2 §17: the table properties a table reads from itself.
pub enum TableLayout { Auto, Fixed }
pub enum BorderCollapse { Separate, Collapse }
pub enum CaptionSide { Top, Bottom }
pub union LineHeight { Normal, Number { pub value: f32 }, Length { pub value: f32 } }
impl Copy for LineHeight {}
impl Equal for LineHeight {
  fn equals(left: &LineHeight, right: &LineHeight) -> bool {
    return match left.* {
      LineHeight.Normal => match right.* {
        LineHeight.Normal => true
        _ => false
      }
      LineHeight.Number { value } => match right.* {
        LineHeight.Number { value: other } => value == other
        _ => false
      }
      LineHeight.Length { value } => match right.* {
        LineHeight.Length { value: other } => value == other
        _ => false
      }
    }
  }
}
pub enum VerticalAlignKind { Baseline, Middle, TextTop, TextBottom, Top, Bottom, Sub, Super, Shift }
pub struct VerticalAlign { pub kind: VerticalAlignKind, pub shift: Dimension }
impl Copy for VerticalAlign {}
impl Equal for VerticalAlign {
  fn equals(left: &VerticalAlign, right: &VerticalAlign) -> bool {
    return left.kind == right.kind && &left.shift == &right.shift
  }
}
pub enum BaselineSource { Auto, First, Last }
pub enum TextAlign { Auto, Start, End, Left, Right, Center, Justify }
pub enum TextJustify { Auto, None, InterWord, InterCharacter }
pub enum TextWrap { Wrap, NoWrap }
/// CSS `text-wrap-style`.
pub enum TextWrapStyle { Auto, Balance, Stable, Pretty }
/// CSS `word-break`. `BreakWord` is the legacy value: `normal` with `overflow-wrap: anywhere`.
pub enum WordBreak { Normal, BreakAll, KeepAll, BreakWord }
/// CSS `overflow-wrap` (and its alias `word-wrap`).
pub enum OverflowWrap { Normal, BreakWord, Anywhere }
/// CSS `text-transform`. The host applies it where it shapes text, so source offsets stay the
/// text as written.
pub enum TextTransform { None, Uppercase, Lowercase, Capitalize, FullWidth }
/// CSS `line-break`: how strictly CJK punctuation and small kana keep to their neighbours, or
/// `anywhere`, a break between any two characters.
pub enum LineBreak { Auto, Loose, Normal, Strict, Anywhere }
/// CSS `hyphens`. `auto` hyphenates no further than `manual` where the host has no dictionary.
pub enum Hyphens { None, Manual, Auto }

/// The OpenType features `font-variant-*` and `font-kerning` turn on or off, as `FEATURE_*`
/// bits, and the ones `font-feature-settings` names. The host hands them to its shaper.
pub struct FontFeatures {
  /// `FEATURE_*` bits; 0 is every `font-variant-*` at `normal` and `font-kerning: auto`.
  pub variant: u32,
  /// `font-feature-settings`: its first `MAX_FEATURE_SETTINGS` tags and their values.
  pub tags: [u32; 8],
  pub values: [u32; 8],
  pub count: usize,
  /// `font-variation-settings` as a handle the host defines; 0 is `normal`.
  pub variations: u32,
}

impl Copy for FontFeatures {}

/// How many `font-feature-settings` entries `FontFeatures` keeps.
pub const MAX_FEATURE_SETTINGS: usize = 8

// font-variant-ligatures.
pub const FEATURE_NO_COMMON_LIGATURES: u32 = 0x1
pub const FEATURE_DISCRETIONARY_LIGATURES: u32 = 0x2
pub const FEATURE_HISTORICAL_LIGATURES: u32 = 0x4
pub const FEATURE_NO_CONTEXTUAL: u32 = 0x8
pub const FEATURE_LIGATURES: u32 = 0xF
// font-variant-caps.
pub const FEATURE_SMALL_CAPS: u32 = 0x10
pub const FEATURE_CAPS_TO_SMALL_CAPS: u32 = 0x20
pub const FEATURE_PETITE_CAPS: u32 = 0x40
pub const FEATURE_CAPS_TO_PETITE_CAPS: u32 = 0x80
pub const FEATURE_UNICASE: u32 = 0x100
pub const FEATURE_TITLING_CAPS: u32 = 0x200
pub const FEATURE_CAPS: u32 = 0x3F0
// font-variant-numeric.
pub const FEATURE_LINING_NUMS: u32 = 0x400
pub const FEATURE_OLDSTYLE_NUMS: u32 = 0x800
pub const FEATURE_PROPORTIONAL_NUMS: u32 = 0x1000
pub const FEATURE_TABULAR_NUMS: u32 = 0x2000
pub const FEATURE_DIAGONAL_FRACTIONS: u32 = 0x4000
pub const FEATURE_STACKED_FRACTIONS: u32 = 0x8000
pub const FEATURE_ORDINAL: u32 = 0x10000
pub const FEATURE_SLASHED_ZERO: u32 = 0x20000
pub const FEATURE_NUMERIC: u32 = 0x3FC00
// font-variant-position.
pub const FEATURE_SUB: u32 = 0x40000
pub const FEATURE_SUPER: u32 = 0x80000
pub const FEATURE_POSITION: u32 = 0xC0000
// font-kerning: none (normal and auto both kern).
pub const FEATURE_NO_KERNING: u32 = 0x100000
pub const FEATURE_KERNING: u32 = 0x100000

impl FontFeatures {
  /// The initial values: no variant and no settings.
  pub fn normal() -> FontFeatures {
    return FontFeatures {
      variant: 0,
      tags: [0, 0, 0, 0, 0, 0, 0, 0],
      values: [0, 0, 0, 0, 0, 0, 0, 0],
      count: 0,
      variations: 0,
    }
  }

  /// Whether `self` and `other` ask the shaper for the same features and axis values.
  pub fn same(self: &Self, other: &FontFeatures) -> bool {
    if self.variant != other.variant || self.count != other.count || self.variations != other.variations {
      return false
    }
    let mut i: usize = 0
    while i < self.count {
      if self.tags[i] != other.tags[i] || self.values[i] != other.values[i] {
        return false
      }
      i = i + 1
    }
    return true
  }
}
pub enum WhiteSpaceCollapse { Collapse, Discard, Preserve, PreserveBreaks, PreserveSpaces, BreakSpaces }
pub union TabSize { Number { pub value: f32 }, Length { pub value: f32 } }
impl Copy for TabSize {}
impl Equal for TabSize {
  fn equals(left: &TabSize, right: &TabSize) -> bool {
    return match left.* {
      TabSize.Number { value } => match right.* {
        TabSize.Number { value: other } => value == other
        _ => false
      }
      TabSize.Length { value } => match right.* {
        TabSize.Length { value: other } => value == other
        _ => false
      }
    }
  }
}
pub struct TextIndent { pub value: Dimension, pub hanging: bool, pub eachLine: bool }
impl Copy for TextIndent {}
impl Equal for TextIndent {
  fn equals(left: &TextIndent, right: &TextIndent) -> bool {
    return &left.value == &right.value && left.hanging == right.hanging && left.eachLine == right.eachLine
  }
}
pub enum BoxDecorationBreak { Slice, Clone }
pub enum MarginBreak { Auto, Keep, Discard }
pub enum BreakBetween { Auto, Avoid, Always, All, AvoidPage, Page, Left, Right, Recto, Verso, AvoidColumn, Column, AvoidRegion, Region }
pub enum BreakInside { Auto, Avoid, AvoidPage, AvoidColumn, AvoidRegion }
// Multi-column layout (CSS Multicol 1).
pub enum ColumnFill { Balance, Auto, BalanceAll }
pub enum ColumnSpan { None, All }

// Paint and text. These are the computed values a painter reads; layout ignores them.

/// How replaced content fits its content box.
pub enum ObjectFit { Fill, Contain, Cover, None, ScaleDown }
pub enum BorderStyle { None, Solid, Dashed }
pub enum FontStyle { Normal, Italic }
/// The `white-space` shorthand's named values.
pub enum WhiteSpace { Normal, NoWrap, Pre, PreWrap, PreLine }

// SVG painting and compositing keywords, shared with renderers outside the box model.

/// `fill-rule` and `clip-rule`: which regions of a path are inside it.
pub enum FillRule { Nonzero, EvenOdd }
/// `stroke-linecap`: the shape at the ends of open subpaths.
pub enum LineCap { Butt, Round, Square }
/// `stroke-linejoin`: the shape at the corners of a stroke.
pub enum LineJoin { Miter, Round, Bevel, MiterClip, Arcs }
/// `mix-blend-mode`: how an element blends with what is behind it (Compositing 1).
pub enum BlendMode {
  Normal,
  Multiply,
  Screen,
  Overlay,
  Darken,
  Lighten,
  ColorDodge,
  ColorBurn,
  HardLight,
  SoftLight,
  Difference,
  Exclusion,
  Hue,
  Saturation,
  Color,
  Luminosity,
}

/// `text-decoration-line` as flags.
pub struct DecorationLine { pub underline: bool, pub overline: bool, pub lineThrough: bool }
impl Copy for DecorationLine {}
impl DecorationLine {
  pub fn none() -> DecorationLine {
    return DecorationLine { underline: false, overline: false, lineThrough: false }
  }
  pub fn underlined() -> DecorationLine {
    return DecorationLine { underline: true, overline: false, lineThrough: false }
  }
}

/// One `box-shadow`. Offsets, blur and spread are CSS pixels.
pub struct BoxShadow {
  pub offsetX: f32,
  pub offsetY: f32,
  pub blur: f32,
  pub spread: f32,
  pub color: Rgba<f32>,
  pub inset: bool,
}
impl Copy for BoxShadow {}

/// What fills a box: nothing, one color, or a two-stop linear gradient at `angle` degrees.
pub union Fill {
  None,
  Solid { pub color: Rgba<f32> },
  Gradient { pub angle: f32, pub from: Rgba<f32>, pub to: Rgba<f32> },
}
impl Copy for Fill {}

/// The computed paint properties of a box.
pub struct Paint {
  pub objectFit: ObjectFit,
  /// `object-position`; percentages are fractions of the free space.
  pub objectX: Dimension,
  pub objectY: Dimension,
  /// The border widths as set. A painter and layout treat `border-style: none` as zero.
  pub border: Insets<f32>,
  pub background: Fill,
  pub borderColor: Rgba<f32>,
  pub borderStyle: BorderStyle,
  /// Corner radii in CSS pixels.
  pub radii: Corners<f32>,
  pub shadow: BoxShadow,
  pub hasShadow: bool,
  pub opacity: f32,
  /// Gaussian backdrop blur in CSS pixels. Zero is none.
  pub backdropBlur: f32,
  /// False for `pointer-events: none`.
  pub pointerEvents: bool,
}
impl Copy for Paint {}
impl Paint {
  /// The initial values: no background, a black solid border of zero width, opaque.
  pub fn initial() -> Paint {
    let black = Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
    return Paint {
      objectFit: ObjectFit.Fill,
      objectX: Dimension.pct(0.5),
      objectY: Dimension.pct(0.5),
      border: Insets<f32>.zero(),
      background: Fill.None,
      borderColor: black,
      borderStyle: BorderStyle.Solid,
      radii: Corners<f32>.zero(),
      shadow: BoxShadow { offsetX: 0.0, offsetY: 0.0, blur: 0.0, spread: 0.0, color: black, inset: false },
      hasShadow: false,
      opacity: 1.0,
      backdropBlur: 0.0,
      pointerEvents: true,
    }
  }
}

/// The computed inherited text properties.
pub struct Text {
  pub writingMode: WritingMode,
  pub textOrientation: TextOrientation,
  pub textAlignLast: TextAlign,
  pub textWrap: TextWrap,
  pub textWrapStyle: TextWrapStyle,
  pub whiteSpaceCollapse: WhiteSpaceCollapse,
  pub textJustify: TextJustify,
  pub textIndent: TextIndent,
  pub tabSize: TabSize,
  /// `letter-spacing` and `word-spacing` in CSS pixels; `normal` is 0.
  pub letterSpacing: f32,
  pub wordSpacing: f32,
  pub wordBreak: WordBreak,
  pub overflowWrap: OverflowWrap,
  pub textTransform: TextTransform,
  pub lineBreak: LineBreak,
  pub hyphens: Hyphens,
  /// `font-variant-*`, `font-kerning` and `font-feature-settings`.
  pub features: FontFeatures,
  /// `font-width` as a percentage; `normal` is 100.
  pub width: f32,
  /// `-webkit-text-fill-color` as RGBA8 (red in the low byte), 0 for `currentcolor`. One
  /// word, so `Text` keeps its size: `packFill` never returns 0.
  pub fillColor: u32,
  /// The effective `zoom`: the product of the element's and its ancestors' `zoom`. Lengths in
  /// computed values, `size` included, are already multiplied by it.
  pub zoom: f32,
  pub orphans: u32,
  pub widows: u32,
  pub visibility: Visibility,
  /// The font family list, as a handle the host defines.
  pub family: u32,
  /// The font size in CSS pixels.
  pub size: f32,
  pub weight: f32,
  pub style: FontStyle,
  pub lineHeight: LineHeight,
  pub color: Rgba<f32>,
  pub align: TextAlign,
  pub whiteSpace: WhiteSpace,
  pub direction: Direction,
  pub decoration: DecorationLine,
  pub decorationColor: Rgba<f32>,
  pub hasDecorationColor: bool,
  pub wavy: bool,
  pub visible: bool,
  /// Input colors: the caret (when `hasCaretColor`), the selection background and the
  /// placeholder text (when `hasPlaceholderColor`).
  pub caretColor: Rgba<f32>,
  pub hasCaretColor: bool,
  pub selectionColor: Rgba<f32>,
  pub placeholderColor: Rgba<f32>,
  pub hasPlaceholderColor: bool,
}
impl Copy for Text {}
impl Text {
  /// The initial values: family 0, 16 px, weight 400, black, `line-height: normal`.
  pub fn initial() -> Text {
    return Text {
      writingMode: WritingMode.HorizontalTb,
      textOrientation: TextOrientation.Mixed,
      textAlignLast: TextAlign.Auto,
      textWrap: TextWrap.Wrap,
      textWrapStyle: TextWrapStyle.Auto,
      whiteSpaceCollapse: WhiteSpaceCollapse.Collapse,
      textJustify: TextJustify.Auto,
      textIndent: TextIndent { value: Dimension.px(0.0), hanging: false, eachLine: false },
      tabSize: TabSize.Number { value: 8.0 },
      letterSpacing: 0.0,
      wordSpacing: 0.0,
      wordBreak: WordBreak.Normal,
      overflowWrap: OverflowWrap.Normal,
      textTransform: TextTransform.None,
      lineBreak: LineBreak.Auto,
      hyphens: Hyphens.Manual,
      features: FontFeatures.normal(),
      width: 100.0,
      orphans: 2,
      widows: 2,
      visibility: Visibility.Visible,
      family: 0,
      size: 16.0,
      weight: 400.0,
      zoom: 1.0,
      style: FontStyle.Normal,
      lineHeight: LineHeight.Normal,
      color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      align: TextAlign.Start,
      whiteSpace: WhiteSpace.Normal,
      direction: Direction.Ltr,
      decoration: DecorationLine.none(),
      decorationColor: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      hasDecorationColor: false,
      wavy: false,
      visible: true,
      caretColor: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      hasCaretColor: false,
      selectionColor: Rgba<f32> { r: 0.706, g: 0.835, b: 0.996, a: 1.0 },
      placeholderColor: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.5 },
      hasPlaceholderColor: false,
      fillColor: 0,
    }
  }

  /// Moves the inherited text to an effective zoom of `zoom`: its lengths are multiplied by
  /// `zoom` over the zoom they were computed at.
  pub fn rezoom(self: &mut Self, zoom: f32) -> () {
    if zoom == self.zoom || self.zoom <= 0.0 { return () }
    let ratio = zoom / self.zoom
    self.zoom = zoom
    self.size = self.size * ratio
    self.letterSpacing = self.letterSpacing * ratio
    self.wordSpacing = self.wordSpacing * ratio
    self.textIndent.value = self.textIndent.value.zoomed(ratio)
    self.lineHeight = match self.lineHeight {
      LineHeight.Length { value } => LineHeight.Length { value: value * ratio }
      _ => self.lineHeight
    }
    self.tabSize = match self.tabSize {
      TabSize.Length { value } => TabSize.Length { value: value * ratio }
      _ => self.tabSize
    }
  }

  /// The color glyphs are filled with: `-webkit-text-fill-color`, else `color`.
  pub fn fill(self: &Self) -> Rgba<f32> {
    if self.fillColor == 0 {
      return self.color
    }
    let word = self.fillColor
    return Rgba<f32> {
      r: u32.toF32(word & 255) / 255.0,
      g: u32.toF32((word / 256) & 255) / 255.0,
      b: u32.toF32((word / 65536) & 255) / 255.0,
      a: u32.toF32(word / 16777216) / 255.0,
    }
  }

  /// Packs `color` for `fillColor`; fully transparent black keeps a red bit, still invisible.
  pub fn packFill(color: Rgba<f32>) -> u32 {
    let word = channel(color.r) + channel(color.g) * 256 + channel(color.b) * 65536 + channel(color.a) * 16777216
    return if word == 0 { 1 } else { word }
  }

  /// The color decorations are drawn in.
  pub fn lineColor(self: &Self) -> Rgba<f32> {
    if self.hasDecorationColor {
      return self.decorationColor
    }
    return self.color
  }

  /// The color the caret is drawn in.
  pub fn caret(self: &Self) -> Rgba<f32> {
    if self.hasCaretColor {
      return self.caretColor
    }
    return self.color
  }

  /// The color of placeholder text.
  pub fn placeholder(self: &Self) -> Rgba<f32> {
    if self.hasPlaceholderColor {
      return self.placeholderColor
    }
    return Rgba<f32> { r: self.color.r, g: self.color.g, b: self.color.b, a: self.color.a * 0.5 }
  }
}

fn channel(value: f32) -> u32 {
  return f32.toU32(f32.floor(f32.min(f32.max(value, 0.0), 1.0) * 255.0 + 0.5))
}


//! Computed CSS values: what layout and paint read after the cascade and unit resolution.
//! Lengths are pixels and percentages are fractions (0.5 is 50%).
import silk.color.rgba { Rgba }
import silk.core.equal { Equal }
import silk.core.ownership { Copy }
import silk.geometry.corners { Corners }
import silk.geometry.insets { Insets }

// Values have already passed CSS parsing and cascade. Percentages are fractions.
// Keeping a percentage coefficient distinguishes 0% from 0px in indefinite axes.
pub enum DimensionKind { Auto, Length, Percent, Calc, MinContent, MaxContent, FitContent, Content, None, Normal }
pub struct Dimension { pub kind: DimensionKind, pub value: f32, pub percent: f32 }
impl Copy for Dimension {}
impl Equal for Dimension {
  fn equals(left: &Dimension, right: &Dimension) -> bool {
    return left.kind == right.kind && left.value == right.value && left.percent == right.percent
  }
}
impl Dimension {
  pub fn auto() -> Dimension { return Dimension { kind: DimensionKind.Auto, value: 0.0, percent: 0.0 } }
  pub fn px(value: f32) -> Dimension { return Dimension { kind: DimensionKind.Length, value: value, percent: 0.0 } }
  pub fn pct(value: f32) -> Dimension { return Dimension { kind: DimensionKind.Percent, value: 0.0, percent: value } }
  pub fn calc(length: f32, percent: f32) -> Dimension { return Dimension { kind: DimensionKind.Calc, value: length, percent: percent } }
  pub fn keyword(kind: DimensionKind) -> Dimension { return Dimension { kind: kind, value: 0.0, percent: 0.0 } }
}
pub struct Edges { pub top: Dimension, pub right: Dimension, pub bottom: Dimension, pub left: Dimension }
impl Copy for Edges {}
impl Equal for Edges {
  fn equals(left: &Edges, right: &Edges) -> bool {
    return &left.top == &right.top && &left.right == &right.right && &left.bottom == &right.bottom && &left.left == &right.left
  }
}
impl Edges {
  pub fn all(value: Dimension) -> Edges { return Edges { top: value, right: value, bottom: value, left: value } }
}
// CSS Display 3 §2: participation in the parent and layout of descendants
// are independent. Box-suppression values have neither outside nor inside.
pub enum DisplayOutside { Block, Inline }
pub enum DisplayInside { Flow, FlowRoot, Flex, Grid }
pub union Display {
  Box { pub outside: DisplayOutside, pub inside: DisplayInside },
  None,
  Contents
}
impl Copy for Display {}
impl Equal for Display {
  fn equals(left: &Display, right: &Display) -> bool {
    return match left.* {
      Display.Box { outside, inside } => right.outsideIs(outside) && right.insideIs(inside)
      Display.None => right.isNone()
      Display.Contents => right.isContents()
    }
  }
}
impl Display {
  pub fn isNone(self: &Self) -> bool {
    return match self.* {
      Display.None => true
      _ => false
    }
  }
  pub fn isContents(self: &Self) -> bool {
    return match self.* {
      Display.Contents => true
      _ => false
    }
  }
  pub fn outsideIs(self: &Self, expected: DisplayOutside) -> bool {
    return match self.* {
      Display.Box { outside, inside: _ } => outside == expected
      _ => false
    }
  }
  pub fn insideIs(self: &Self, expected: DisplayInside) -> bool {
    return match self.* {
      Display.Box { outside: _, inside } => inside == expected
      _ => false
    }
  }
  pub fn blockified(self: &Self) -> Display {
    return match self.* {
      Display.Box { outside, inside } => {
        let mut inner = inside
        // §2.7 preserves CSS2's inline-block -> block computed-value rule.
        if outside == DisplayOutside.Inline && inside == DisplayInside.FlowRoot { inner = DisplayInside.Flow }
        return Display.Box { outside: DisplayOutside.Block, inside: inner }
      }
      Display.None => Display.None
      Display.Contents => Display.Contents
    }
  }
}
pub enum BoxSizing { ContentBox, BorderBox }
pub enum Direction { Ltr, Rtl }
pub enum UnicodeBidi { Normal, Embed, Isolate, BidiOverride, IsolateOverride, Plaintext }
pub enum WritingMode { HorizontalTb, VerticalRl, VerticalLr, SidewaysRl, SidewaysLr }
pub enum TextOrientation { Mixed, Upright, Sideways }
pub enum FlexDirection { Row, RowReverse, Column, ColumnReverse }
pub enum FlexWrap { NoWrap, Wrap, WrapReverse }
pub enum Align { Auto, Normal, Start, End, FlexStart, FlexEnd, Center, Stretch, SpaceBetween, SpaceAround, SpaceEvenly, Baseline, LastBaseline, SelfStart, SelfEnd, Left, Right }
pub enum OverflowAlignment { Default, Safe, Unsafe }
pub enum Overflow { Visible, Clip, Hidden, Scroll, Auto }
pub enum ScrollbarWidth { Auto, Thin, None }
pub enum ScrollbarGutter { Auto, Stable, StableBothEdges }
pub enum Position { Static, Relative, Absolute, Fixed, Sticky }
pub enum Float { None, Left, Right }
pub enum Clear { None, Left, Right, Both }
pub enum Visibility { Visible, Hidden, Collapse }
pub union LineHeight { Normal, Number { pub value: f32 }, Length { pub value: f32 } }
impl Copy for LineHeight {}
impl Equal for LineHeight {
  fn equals(left: &LineHeight, right: &LineHeight) -> bool {
    return match left.* {
      LineHeight.Normal => match right.* {
        LineHeight.Normal => true
        _ => false
      }
      LineHeight.Number { value } => match right.* {
        LineHeight.Number { value: other } => value == other
        _ => false
      }
      LineHeight.Length { value } => match right.* {
        LineHeight.Length { value: other } => value == other
        _ => false
      }
    }
  }
}
pub enum VerticalAlignKind { Baseline, Middle, TextTop, TextBottom, Top, Bottom, Sub, Super, Shift }
pub struct VerticalAlign { pub kind: VerticalAlignKind, pub shift: Dimension }
impl Copy for VerticalAlign {}
impl Equal for VerticalAlign {
  fn equals(left: &VerticalAlign, right: &VerticalAlign) -> bool {
    return left.kind == right.kind && &left.shift == &right.shift
  }
}
pub enum BaselineSource { Auto, First, Last }
pub enum TextAlign { Auto, Start, End, Left, Right, Center, Justify }
pub enum TextJustify { Auto, None, InterWord, InterCharacter }
pub enum TextWrap { Wrap, NoWrap }
pub enum WhiteSpaceCollapse { Collapse, Discard, Preserve, PreserveBreaks, PreserveSpaces, BreakSpaces }
pub union TabSize { Number { pub value: f32 }, Length { pub value: f32 } }
impl Copy for TabSize {}
impl Equal for TabSize {
  fn equals(left: &TabSize, right: &TabSize) -> bool {
    return match left.* {
      TabSize.Number { value } => match right.* {
        TabSize.Number { value: other } => value == other
        _ => false
      }
      TabSize.Length { value } => match right.* {
        TabSize.Length { value: other } => value == other
        _ => false
      }
    }
  }
}
pub struct TextIndent { pub value: Dimension, pub hanging: bool, pub eachLine: bool }
impl Copy for TextIndent {}
impl Equal for TextIndent {
  fn equals(left: &TextIndent, right: &TextIndent) -> bool {
    return &left.value == &right.value && left.hanging == right.hanging && left.eachLine == right.eachLine
  }
}
pub enum BoxDecorationBreak { Slice, Clone }
pub enum MarginBreak { Auto, Keep, Discard }
pub enum BreakBetween { Auto, Avoid, Always, All, AvoidPage, Page, Left, Right, Recto, Verso, AvoidColumn, Column, AvoidRegion, Region }
pub enum BreakInside { Auto, Avoid, AvoidPage, AvoidColumn, AvoidRegion }

// Paint and text. These are the computed values a painter reads; layout ignores them.

/// How replaced content fits its content box.
pub enum ObjectFit { Fill, Contain, Cover, None, ScaleDown }
pub enum BorderStyle { None, Solid, Dashed }
pub enum FontStyle { Normal, Italic }
/// The `white-space` shorthand's named values.
pub enum WhiteSpace { Normal, NoWrap, Pre, PreWrap, PreLine }

// SVG painting and compositing keywords, shared with renderers outside the box model.

/// `fill-rule` and `clip-rule`: which regions of a path are inside it.
pub enum FillRule { Nonzero, EvenOdd }
/// `stroke-linecap`: the shape at the ends of open subpaths.
pub enum LineCap { Butt, Round, Square }
/// `stroke-linejoin`: the shape at the corners of a stroke.
pub enum LineJoin { Miter, Round, Bevel, MiterClip, Arcs }
/// `mix-blend-mode`: how an element blends with what is behind it (Compositing 1).
pub enum BlendMode {
  Normal,
  Multiply,
  Screen,
  Overlay,
  Darken,
  Lighten,
  ColorDodge,
  ColorBurn,
  HardLight,
  SoftLight,
  Difference,
  Exclusion,
  Hue,
  Saturation,
  Color,
  Luminosity,
}

/// `text-decoration-line` as flags.
pub struct DecorationLine { pub underline: bool, pub overline: bool, pub lineThrough: bool }
impl Copy for DecorationLine {}
impl DecorationLine {
  pub fn none() -> DecorationLine {
    return DecorationLine { underline: false, overline: false, lineThrough: false }
  }
  pub fn underlined() -> DecorationLine {
    return DecorationLine { underline: true, overline: false, lineThrough: false }
  }
}

/// One `box-shadow`. Offsets, blur and spread are CSS pixels.
pub struct BoxShadow {
  pub offsetX: f32,
  pub offsetY: f32,
  pub blur: f32,
  pub spread: f32,
  pub color: Rgba<f32>,
  pub inset: bool,
}
impl Copy for BoxShadow {}

/// What fills a box: nothing, one color, or a two-stop linear gradient at `angle` degrees.
pub union Fill {
  None,
  Solid { pub color: Rgba<f32> },
  Gradient { pub angle: f32, pub from: Rgba<f32>, pub to: Rgba<f32> },
}
impl Copy for Fill {}

/// The computed paint properties of a box.
pub struct Paint {
  pub objectFit: ObjectFit,
  /// `object-position`; percentages are fractions of the free space.
  pub objectX: Dimension,
  pub objectY: Dimension,
  /// The border widths as set. A painter and layout treat `border-style: none` as zero.
  pub border: Insets<f32>,
  pub background: Fill,
  pub borderColor: Rgba<f32>,
  pub borderStyle: BorderStyle,
  /// Corner radii in CSS pixels.
  pub radii: Corners<f32>,
  pub shadow: BoxShadow,
  pub hasShadow: bool,
  pub opacity: f32,
  /// Gaussian backdrop blur in CSS pixels. Zero is none.
  pub backdropBlur: f32,
  /// False for `pointer-events: none`.
  pub pointerEvents: bool,
}
impl Copy for Paint {}
impl Paint {
  /// The initial values: no background, a black solid border of zero width, opaque.
  pub fn initial() -> Paint {
    let black = Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
    return Paint {
      objectFit: ObjectFit.Fill,
      objectX: Dimension.pct(0.5),
      objectY: Dimension.pct(0.5),
      border: Insets<f32>.zero(),
      background: Fill.None,
      borderColor: black,
      borderStyle: BorderStyle.Solid,
      radii: Corners<f32>.zero(),
      shadow: BoxShadow { offsetX: 0.0, offsetY: 0.0, blur: 0.0, spread: 0.0, color: black, inset: false },
      hasShadow: false,
      opacity: 1.0,
      backdropBlur: 0.0,
      pointerEvents: true,
    }
  }
}

/// The computed inherited text properties.
pub struct Text {
  pub writingMode: WritingMode,
  pub textOrientation: TextOrientation,
  pub textAlignLast: TextAlign,
  pub textWrap: TextWrap,
  pub whiteSpaceCollapse: WhiteSpaceCollapse,
  pub textJustify: TextJustify,
  pub textIndent: TextIndent,
  pub tabSize: TabSize,
  pub orphans: usize,
  pub widows: usize,
  pub visibility: Visibility,
  /// The font family list, as a handle the host defines.
  pub family: u32,
  /// The font size in CSS pixels.
  pub size: f32,
  pub weight: f32,
  pub style: FontStyle,
  pub lineHeight: LineHeight,
  pub color: Rgba<f32>,
  pub align: TextAlign,
  pub whiteSpace: WhiteSpace,
  pub direction: Direction,
  pub decoration: DecorationLine,
  pub decorationColor: Rgba<f32>,
  pub hasDecorationColor: bool,
  pub wavy: bool,
  pub visible: bool,
  /// Input colors: the caret (when `hasCaretColor`), the selection background and the
  /// placeholder text (when `hasPlaceholderColor`).
  pub caretColor: Rgba<f32>,
  pub hasCaretColor: bool,
  pub selectionColor: Rgba<f32>,
  pub placeholderColor: Rgba<f32>,
  pub hasPlaceholderColor: bool,
}
impl Copy for Text {}
impl Text {
  /// The initial values: family 0, 16 px, weight 400, black, `line-height: normal`.
  pub fn initial() -> Text {
    return Text {
      writingMode: WritingMode.HorizontalTb,
      textOrientation: TextOrientation.Mixed,
      textAlignLast: TextAlign.Auto,
      textWrap: TextWrap.Wrap,
      whiteSpaceCollapse: WhiteSpaceCollapse.Collapse,
      textJustify: TextJustify.Auto,
      textIndent: TextIndent { value: Dimension.px(0.0), hanging: false, eachLine: false },
      tabSize: TabSize.Number { value: 8.0 },
      orphans: 2,
      widows: 2,
      visibility: Visibility.Visible,
      family: 0,
      size: 16.0,
      weight: 400.0,
      style: FontStyle.Normal,
      lineHeight: LineHeight.Normal,
      color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      align: TextAlign.Start,
      whiteSpace: WhiteSpace.Normal,
      direction: Direction.Ltr,
      decoration: DecorationLine.none(),
      decorationColor: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      hasDecorationColor: false,
      wavy: false,
      visible: true,
      caretColor: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      hasCaretColor: false,
      selectionColor: Rgba<f32> { r: 0.706, g: 0.835, b: 0.996, a: 1.0 },
      placeholderColor: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.5 },
      hasPlaceholderColor: false,
    }
  }

  /// The color decorations are drawn in.
  pub fn lineColor(self: &Self) -> Rgba<f32> {
    if self.hasDecorationColor {
      return self.decorationColor
    }
    return self.color
  }

  /// The color the caret is drawn in.
  pub fn caret(self: &Self) -> Rgba<f32> {
    if self.hasCaretColor {
      return self.caretColor
    }
    return self.color
  }

  /// The color of placeholder text.
  pub fn placeholder(self: &Self) -> Rgba<f32> {
    if self.hasPlaceholderColor {
      return self.placeholderColor
    }
    return Rgba<f32> { r: self.color.r, g: self.color.g, b: self.color.b, a: self.color.a * 0.5 }
  }
}

// Plain keyword enums compare by variant.
impl Equal for DimensionKind {
  fn equals(left: &DimensionKind, right: &DimensionKind) -> bool { return left.* == right.* }
}
impl Equal for DisplayOutside {
  fn equals(left: &DisplayOutside, right: &DisplayOutside) -> bool { return left.* == right.* }
}
impl Equal for DisplayInside {
  fn equals(left: &DisplayInside, right: &DisplayInside) -> bool { return left.* == right.* }
}
impl Equal for BoxSizing {
  fn equals(left: &BoxSizing, right: &BoxSizing) -> bool { return left.* == right.* }
}
impl Equal for Direction {
  fn equals(left: &Direction, right: &Direction) -> bool { return left.* == right.* }
}
impl Equal for UnicodeBidi {
  fn equals(left: &UnicodeBidi, right: &UnicodeBidi) -> bool { return left.* == right.* }
}
impl Equal for WritingMode {
  fn equals(left: &WritingMode, right: &WritingMode) -> bool { return left.* == right.* }
}
impl Equal for TextOrientation {
  fn equals(left: &TextOrientation, right: &TextOrientation) -> bool { return left.* == right.* }
}
impl Equal for FlexDirection {
  fn equals(left: &FlexDirection, right: &FlexDirection) -> bool { return left.* == right.* }
}
impl Equal for FlexWrap {
  fn equals(left: &FlexWrap, right: &FlexWrap) -> bool { return left.* == right.* }
}
impl Equal for Align {
  fn equals(left: &Align, right: &Align) -> bool { return left.* == right.* }
}
impl Equal for OverflowAlignment {
  fn equals(left: &OverflowAlignment, right: &OverflowAlignment) -> bool { return left.* == right.* }
}
impl Equal for Overflow {
  fn equals(left: &Overflow, right: &Overflow) -> bool { return left.* == right.* }
}
impl Equal for ScrollbarWidth {
  fn equals(left: &ScrollbarWidth, right: &ScrollbarWidth) -> bool { return left.* == right.* }
}
impl Equal for ScrollbarGutter {
  fn equals(left: &ScrollbarGutter, right: &ScrollbarGutter) -> bool { return left.* == right.* }
}
impl Equal for Position {
  fn equals(left: &Position, right: &Position) -> bool { return left.* == right.* }
}
impl Equal for Float {
  fn equals(left: &Float, right: &Float) -> bool { return left.* == right.* }
}
impl Equal for Clear {
  fn equals(left: &Clear, right: &Clear) -> bool { return left.* == right.* }
}
impl Equal for Visibility {
  fn equals(left: &Visibility, right: &Visibility) -> bool { return left.* == right.* }
}
impl Equal for VerticalAlignKind {
  fn equals(left: &VerticalAlignKind, right: &VerticalAlignKind) -> bool { return left.* == right.* }
}
impl Equal for BaselineSource {
  fn equals(left: &BaselineSource, right: &BaselineSource) -> bool { return left.* == right.* }
}
impl Equal for TextAlign {
  fn equals(left: &TextAlign, right: &TextAlign) -> bool { return left.* == right.* }
}
impl Equal for TextJustify {
  fn equals(left: &TextJustify, right: &TextJustify) -> bool { return left.* == right.* }
}
impl Equal for TextWrap {
  fn equals(left: &TextWrap, right: &TextWrap) -> bool { return left.* == right.* }
}
impl Equal for WhiteSpaceCollapse {
  fn equals(left: &WhiteSpaceCollapse, right: &WhiteSpaceCollapse) -> bool { return left.* == right.* }
}
impl Equal for BoxDecorationBreak {
  fn equals(left: &BoxDecorationBreak, right: &BoxDecorationBreak) -> bool { return left.* == right.* }
}
impl Equal for MarginBreak {
  fn equals(left: &MarginBreak, right: &MarginBreak) -> bool { return left.* == right.* }
}
impl Equal for BreakBetween {
  fn equals(left: &BreakBetween, right: &BreakBetween) -> bool { return left.* == right.* }
}
impl Equal for BreakInside {
  fn equals(left: &BreakInside, right: &BreakInside) -> bool { return left.* == right.* }
}

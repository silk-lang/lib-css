/// `pointer-events`: `auto` when enabled, `none` otherwise.
pub fn pointerEvents(enabled: bool) -> Declaration {
  return word(Property.PointerEvents, if enabled { Keyword.Auto } else { Keyword.None })
}

/// `visibility`: `visible` or `hidden`.
pub fn visible(shown: bool) -> Declaration {
  return word(Property.Visibility, if shown { Keyword.Visible } else { Keyword.Hidden })
}

/// `text-decoration-line` with one line: `Keyword.Underline`, `Keyword.None` and so on.
pub fn textDecorationLine(value: Keyword) -> Declaration {
  return word(Property.TextDecorationLine, value)
}

/// `text-decoration-style`: `wavy` or `solid`.
pub fn textDecorationWavy(wavy: bool) -> Declaration {
  return word(Property.TextDecorationStyle, if wavy { Keyword.Wavy } else { Keyword.Solid })
}

/// `box-shadow: none`.
pub fn noBoxShadow() -> Declaration {
  return word(Property.BoxShadow, Keyword.None)
}

/// `background-image: none`.
pub fn noBackground() -> Declaration {
  return word(Property.BackgroundImage, Keyword.None)
}

/// `text-decoration-line` from flags; several lines are written as a sequence.
pub effect fn textDecorationLines(value: DecorationLine) -> Declaration
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut parts = List<Value>.make()
  if value.underline {
    run parts.append(Value.Keyword { value: Keyword.Underline })
  }
  if value.overline {
    run parts.append(Value.Keyword { value: Keyword.Overline })
  }
  if value.lineThrough {
    run parts.append(Value.Keyword { value: Keyword.LineThrough })
  }
  if parts.length() == 0 {
    return word(Property.TextDecorationLine, Keyword.None)
  }
  return make(Property.TextDecorationLine, Value.Sequence { separator: Separator.Space, values: move parts })
}

/// `scrollbar-gutter`.
pub effect fn scrollbarGutter(value: ScrollbarGutter) -> Declaration ! OutOfMemoryError ? &mut Allocator {
  match value {
    ScrollbarGutter.Auto => {
      return word(Property.ScrollbarGutter, Keyword.Auto)
    }
    ScrollbarGutter.Stable => {
      return word(Property.ScrollbarGutter, Keyword.Stable)
    }
    ScrollbarGutter.StableBothEdges => {
      let mut parts = List<Value>.make()
      run parts.append(Value.Keyword { value: Keyword.Stable })
      run parts.append(Value.Keyword { value: Keyword.BothEdges })
      return make(Property.ScrollbarGutter, Value.Sequence { separator: Separator.Space, values: move parts })
    }
  }
}

/// `aspect-ratio: auto <ratio>`: the ratio applies unless the content has its own.
pub effect fn aspectRatioAuto(ratio: f32) -> Declaration ! OutOfMemoryError ? &mut Allocator {
  let mut parts = List<Value>.make()
  run parts.append(Value.Keyword { value: Keyword.Auto })
  run parts.append(Value.Unit { value: ratio, unit: Unit.Number })
  return make(Property.AspectRatio, Value.Sequence { separator: Separator.Space, values: move parts })
}

/// `border-radius` with one radius per corner, in CSS pixels.
pub effect fn borderRadii(topLeft: f32, topRight: f32, bottomRight: f32, bottomLeft: f32) -> Declaration
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut parts = List<Value>.make()
  run parts.append(Value.Unit { value: topLeft, unit: Unit.Px })
  run parts.append(Value.Unit { value: topRight, unit: Unit.Px })
  run parts.append(Value.Unit { value: bottomRight, unit: Unit.Px })
  run parts.append(Value.Unit { value: bottomLeft, unit: Unit.Px })
  return make(Property.BorderRadius, Value.Sequence { separator: Separator.Space, values: move parts })
}

/// `box-shadow` with one shadow.
pub effect fn boxShadow(shadow: BoxShadow) -> Declaration ! OutOfMemoryError ? &mut Allocator {
  let mut parts = List<Value>.make()
  run parts.append(Value.Unit { value: shadow.offsetX, unit: Unit.Px })
  run parts.append(Value.Unit { value: shadow.offsetY, unit: Unit.Px })
  run parts.append(Value.Unit { value: shadow.blur, unit: Unit.Px })
  run parts.append(Value.Unit { value: shadow.spread, unit: Unit.Px })
  run parts.append(Value.Color { value: shadow.color })
  if shadow.inset {
    run parts.append(Value.Keyword { value: Keyword.Inset })
  }
  return make(Property.BoxShadow, Value.Sequence { separator: Separator.Space, values: move parts })
}

/// `background-image: linear-gradient(<angle>deg, from, to)`.
pub effect fn backgroundGradient(angle: f32, from: Rgba<f32>, to: Rgba<f32>) -> Declaration
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut parts = List<Value>.make()
  run parts.append(Value.Unit { value: angle, unit: Unit.Deg })
  run parts.append(Value.Color { value: from })
  run parts.append(Value.Color { value: to })
  return make(Property.BackgroundImage, Value.Function { name: Keyword.LinearGradient, values: move parts })
}

/// `backdrop-filter: blur(<radius>px)`, or `none` for zero.
pub effect fn backdropBlur(radius: f32) -> Declaration ! OutOfMemoryError ? &mut Allocator {
  if radius <= 0.0 {
    return word(Property.BackdropFilter, Keyword.None)
  }
  let mut parts = List<Value>.make()
  run parts.append(Value.Unit { value: radius, unit: Unit.Px })
  return make(Property.BackdropFilter, Value.Function { name: Keyword.Blur, values: move parts })
}

/// `object-position: x y`.
pub effect fn objectPosition(x: Value, y: Value) -> Declaration ! OutOfMemoryError ? &mut Allocator {
  let mut parts = List<Value>.make()
  run parts.append(move x)
  run parts.append(move y)
  return make(Property.ObjectPosition, Value.Sequence { separator: Separator.Space, values: move parts })
}

/// `text-indent` with its `hanging` and `each-line` flags.
pub effect fn textIndentWith(amount: Value, hanging: bool, eachLine: bool) -> Declaration
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut parts = List<Value>.make()
  run parts.append(move amount)
  if hanging {
    run parts.append(Value.Keyword { value: Keyword.Hanging })
  }
  if eachLine {
    run parts.append(Value.Keyword { value: Keyword.EachLine })
  }
  return make(Property.TextIndent, Value.Sequence { separator: Separator.Space, values: move parts })
}

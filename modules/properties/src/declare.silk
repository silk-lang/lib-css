/// `justify-content`.
pub fn justifyContent(value: Align) -> Declaration {
  return word(Property.JustifyContent, convert.alignKeyword(value))
}

/// `justify-content` with `safe` or `unsafe` before the alignment.
pub effect fn justifyContentWith(value: Align, safety: OverflowAlignment) -> Declaration
  ! OutOfMemoryError
  ? &mut Allocator {
  let written = run aligned(value, safety)
  return make(Property.JustifyContent, move written)
}


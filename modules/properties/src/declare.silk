//! Typed constructors for declarations: one function per property, named after it in
//! camelCase. `declare.width(px(120.0))` is the declaration `width: 120px`. Keyword properties
//! take the computed enum, so a wrong keyword does not compile. Generated from a table.
import catalog { Property }
import computed {
  Align,
  OverflowAlignment,
  BoxSizing,
  Direction,
  UnicodeBidi,
  WritingMode,
  TextOrientation,
  FlexDirection,
  FlexWrap,
  Overflow,
  ScrollbarWidth,
  ScrollbarGutter,
  Position,
  Float,
  Clear,
  Visibility,
  BaselineSource,
  TextAlign,
  TextJustify,
  TextWrap,
  WhiteSpaceCollapse,
  BoxDecorationBreak,
  MarginBreak,
  BreakBetween,
  BreakInside,
  ObjectFit,
  BorderStyle,
  FontStyle,
  WhiteSpace,
  DecorationLine,
  BoxShadow,
}
import convert
import keyword_enums
import keywords { Keyword }
import values { Value, Declaration, Unit, Separator }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u32
import silk.num.usize

fn make(property: Property, value: Value) -> Declaration {
  return Declaration { property: property, value: move value, important: false }
}

fn word(property: Property, value: Keyword) -> Declaration {
  return Declaration { property: property, value: Value.Keyword { value: value }, important: false }
}

/// `width`.
pub fn width(value: Value) -> Declaration {
  return make(Property.Width, move value)
}


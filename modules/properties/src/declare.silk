effect fn aligned(value: Align, safety: OverflowAlignment) -> Value ! OutOfMemoryError ? &mut Allocator {
  let align = Value.Keyword { value: convert.alignKeyword(value) }
  let first = match safety {
    OverflowAlignment.Default => {
      return move align
    }
    OverflowAlignment.Safe => Keyword.Safe
    OverflowAlignment.Unsafe => Keyword.Unsafe
  }
  let mut parts = List<Value>.make()
  run parts.append(Value.Keyword { value: first })
  run parts.append(move align)
  return Value.Sequence { separator: Separator.Space, values: move parts }
}

/// `display`, from a keyword such as `Keyword.Flex` or `Keyword.InlineBlock`.
pub fn display(value: Keyword) -> Declaration {
  return word(Property.Display, value)
}


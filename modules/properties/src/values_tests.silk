//! Written values serialize as CSS text and convert to computed values and back.
import catalog { Property }
import computed {
  Dimension,
  SizeValue,
  Bounds,
  DimensionKind,
  Display,
  DisplayOutside,
  DisplayInside,
  Align,
  OverflowAlignment,
  Position,
  LineHeight,
  Fill,
  ScrollbarGutter,
  TextBoxTrim,
  TextEdge,
}
import convert { Context, FontMetrics }
import convert
import computed
import declare
import keywords { Keyword }
import keywords
import values { Value, Declaration, Unit, MathOperator }
import values
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

fn sameText(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn expectText(declaration: &Declaration, expected: &[u8], message: string<'static>) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  run values.writeDeclaration(&mut out, declaration)
  run Testing.expect(sameText(out.asSlice(), expected), message)
}

effect fn serialization() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  run expectText(&declare.width(values.px(120.0)), b"width: 120px", "a pixel length")
  run expectText(&declare.width(values.percent(33.5)), b"width: 33.5%", "a percentage keeps its written number")
  run expectText(&declare.height(values.auto()), b"height: auto", "a keyword")
  run expectText(&declare.flexGrow(1.0), b"flex-grow: 1", "a number drops trailing zeros")
  run expectText(&declare.position(Position.Absolute), b"position: absolute", "an enum keyword")
  run expectText(&declare.display(Keyword.InlineFlex), b"display: inline-flex", "a display keyword")
  run expectText(&declare.alignItems(Align.LastBaseline), b"align-items: last baseline", "last baseline")
  let opaque = Rgba<f32> { r: 1.0, g: 0.5, b: 0.0, a: 1.0 }
  run expectText(&declare.color(opaque), b"color: rgb(255, 128, 0)", "an opaque color")
  let faded = Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.25 }
  run expectText(&declare.backgroundColor(faded), b"background-color: rgba(0, 0, 0, 0.25)", "a translucent color")
  run expectText(&declare.selectionColor(opaque), b"-silk-selection-color: rgb(255, 128, 0)", "a prefixed property")
  let sum = run values.calc(10.0, 50.0)
  run expectText(&declare.width(move sum), b"width: calc(10px + 50%)", "a calc sum")
  let difference = run values.calc(100.0, -25.0)
  run expectText(&declare.width(move difference), b"width: calc(100px - 25%)", "a negative term subtracts")
  let gradient = run declare.backgroundGradient(45.0, opaque, faded)
  run expectText(
    &gradient,
    b"background-image: linear-gradient(45deg, rgb(255, 128, 0), rgba(0, 0, 0, 0.25))",
    "a gradient function",
  )
  let safe = run declare.justifyContentWith(Align.Center, OverflowAlignment.Safe)
  run expectText(&safe, b"justify-content: safe center", "a safe alignment")
  let mut important = declare.opacity(0.5)
  important.important = true
  run expectText(&important, b"opacity: 0.5 !important", "the important flag")
  let raw = run values.text(b"repeat(2, 1fr)")
  run expectText(&values.declare(Property.GridTemplateColumns, move raw), b"grid-template-columns: repeat(2, 1fr)", "CSS text passes through")
}

test effect fn valuesSerializeAsCssText() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run serialization() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn isDimension(found: Option<Dimension>, expected: Dimension) -> bool {
  return match found {
    Option.Some { value } => &value == &expected
    Option.None => false
  }
}

fn isSize(found: Option<SizeValue>, expected: SizeValue) -> bool {
  return match found {
    Option.Some { value } => &value == &expected
    Option.None => false
  }
}

effect fn conversion() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut context = Context.make()
  context.fontSize = 20.0
  context.viewportWidth = 800.0
  context.viewportHeight = 600.0
  run Testing.expect(isDimension(convert.dimension(&values.px(12.0), &context), Dimension.px(12.0)), "px stays px")
  run Testing.expect(isDimension(convert.dimension(&values.percent(50.0), &context), Dimension.pct(0.5)), "a percentage becomes a fraction")
  run Testing.expect(isDimension(convert.dimension(&values.unit(2.0, Unit.Em), &context), Dimension.px(40.0)), "em uses the font size")
  run Testing.expect(isDimension(convert.dimension(&values.unit(10.0, Unit.Vw), &context), Dimension.px(80.0)), "vw uses the viewport")
  run Testing.expect(isDimension(convert.dimension(&values.unit(1.0, Unit.In), &context), Dimension.px(96.0)), "an inch is 96px")
  run Testing.expect(isDimension(convert.dimension(&values.auto(), &context), Dimension.auto()), "auto")
  run Testing.expect(isDimension(convert.dimension(&values.keyword(Keyword.MinContent), &context), Dimension.keyword(DimensionKind.MinContent)), "min-content")
  run Testing.expect(convert.dimension(&values.number(3.0), &context).isNone(), "a bare number is not a length")
  run Testing.expect(isDimension(convert.dimension(&values.number(0.0), &context), Dimension.px(0.0)), "zero needs no unit")
  run Testing.expect(convert.dimension(&values.keyword(Keyword.Flex), &context).isNone(), "an unrelated keyword is not a size")
  let sum = run values.calc(10.0, 50.0)
  run Testing.expect(isDimension(convert.dimension(&sum, &context), Dimension.calc(10.0, 0.5)), "calc keeps both parts")
  let mut factors = List<Value>.make()
  run factors.append(values.number(2.0))
  run factors.append(values.unit(1.5, Unit.Em))
  let product = values.math(MathOperator.Product, move factors)
  run Testing.expect(isDimension(convert.dimension(&product, &context), Dimension.px(60.0)), "calc multiplies by a number")
  let back = run convert.fromDimension(Dimension.calc(10.0, 0.5))
  run Testing.expect(values.same(&back, &sum), "a computed calc is written back with 0 to 100 percentages")
  let half = run convert.fromDimension(Dimension.pct(0.5))
  run Testing.expect(values.same(&half, &values.percent(50.0)), "a computed fraction is written back as a percentage")

  let flex = match convert.display(&values.keyword(Keyword.InlineFlex)) {
    Option.Some { value } => value.outsideIs(DisplayOutside.Inline) && value.insideIs(DisplayInside.Flex)
    Option.None => false
  }
  run Testing.expect(flex, "inline-flex is inline outside and flex inside")
  run Testing.expect(
    convert.displayKeyword(Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.FlowRoot }) == Keyword.InlineBlock,
    "inline flow-root is written inline-block",
  )
  let safe = run declare.alignSelfWith(Align.End, OverflowAlignment.Safe)
  let aligned = match convert.alignment(&safe.value) {
    Option.Some { value } => value.align == Align.End && value.safety == OverflowAlignment.Safe
    Option.None => false
  }
  run Testing.expect(aligned, "safe end converts to its alignment and safety")
  let gutter = run declare.scrollbarGutter(ScrollbarGutter.StableBothEdges)
  let both = match convert.scrollbarGutter(&gutter.value) {
    Option.Some { value } => value == ScrollbarGutter.StableBothEdges
    Option.None => false
  }
  run Testing.expect(both, "stable both-edges round-trips")
  let multiple = match convert.lineHeight(&values.number(1.5), &context) {
    Option.Some { value } => &value == &LineHeight.Number { value: 1.5 }
    Option.None => false
  }
  run Testing.expect(multiple, "a unitless line-height stays a multiple")
  let red = Rgba<f32> { r: 1.0, g: 0.0, b: 0.0, a: 1.0 }
  let blue = Rgba<f32> { r: 0.0, g: 0.0, b: 1.0, a: 1.0 }
  let gradient = run declare.backgroundGradient(90.0, red, blue)
  let filled = match convert.fill(&gradient.value) {
    Option.Some { value } => match value {
      Fill.Gradient { angle, from, to } => angle == 90.0 && from.r == 1.0 && to.b == 1.0
      _ => false
    }
    Option.None => false
  }
  run Testing.expect(filled, "a linear-gradient function converts to a gradient fill")
  let blurred = run declare.backdropBlur(4.0)
  let radius = match convert.blur(&blurred.value, &context) {
    Option.Some { value } => value == 4.0
    Option.None => false
  }
  run Testing.expect(radius, "blur(4px) converts to its radius")
  let copy = run values.cloneDeclaration(&gradient)
  run Testing.expect(values.sameDeclaration(&copy, &gradient), "a clone is written the same")
  run Testing.expect(!values.same(&values.px(1.0), &values.percent(1.0)), "units distinguish values")
}

test effect fn writtenValuesConvertToComputed() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run conversion() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn numbers() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  // The short way writes what the formatter writes: ordinary values, values that round up
  // into the next digit, halves, tiny and huge ones, and a walk over many others.
  let picked: [f32; 22] = [
    0.0, -0.0, 1.0, -1.0, 0.15, 0.5, 360.0, 0.0078125, -0.0078125, 0.9999995, 0.9999994,
    1234567.9, 0.000001, 0.0000004, -0.0000004, 16777216.0, 3999999999.0, 4000000000.0,
    1.0e20, -2.5, 99.999999, 0.1,
  ]
  let mut i: usize = 0
  while i < picked.length {
    let mut short = Bytes.make()
    let mut long = Bytes.make()
    run values.writeNumber(&mut short, picked[i])
    run values.writeFormatted(&mut long, picked[i])
    run Testing.expect(sameText(short.asSlice(), long.asSlice()), "a picked number is written as the formatter writes it")
    i = i + 1
  }
  let mut walked: f32 = -37.5
  let mut step: f32 = 0.000137
  let mut k: usize = 0
  while k < 20000 {
    let mut short = Bytes.make()
    let mut long = Bytes.make()
    run values.writeNumber(&mut short, walked)
    run values.writeFormatted(&mut long, walked)
    run Testing.expect(sameText(short.asSlice(), long.asSlice()), "a walked number is written as the formatter writes it")
    walked = walked + step
    step = step * 1.0007
    k = k + 1
  }
}

test effect fn numbersTakeTheShortWayUnchanged() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run numbers() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn everyKeywordFindsItselfByName() -> () ! AssertionError<'static> {
  run Testing.expect(keywords.name(Keyword.FlexStart).length == 10, "flex-start is spelled in kebab case")
  let found = match keywords.lookup(b"Space-Between") {
    Option.Some { value } => value == Keyword.SpaceBetween
    Option.None => false
  }
  run Testing.expect(found, "keywords match ASCII case-insensitively")
  run Testing.expect(keywords.lookup(b"not-a-keyword").isNone(), "unknown words find nothing")
}

test effect fn containerUnitsUseIndependentAxesAndSmallViewportFallback() ! AssertionError<'static> {
  let units = [Unit.Cqw, Unit.Cqh, Unit.Cqi, Unit.Cqb, Unit.Cqmin, Unit.Cqmax]
  let names = [b"cqw", b"cqh", b"cqi", b"cqb", b"cqmin", b"cqmax"]
  let mut context = Context.make()
  context.viewportWidth = 1000.0
  context.viewportHeight = 800.0
  context.smallViewportWidth = Option<f32>.some(600.0)
  context.smallViewportHeight = Option<f32>.some(400.0)
  let fallback: [f32; 6] = [6.0, 4.0, 6.0, 4.0, 4.0, 6.0]
  let mut i: usize = 0
  while i < units.length {
    run Testing.expect(sameText(values.unitName(units[i]), names[i]), "container units serialize with their CSS spelling")
    let parsed = values.unitLookup(names[i])
    run Testing.expect(match parsed { Option<Unit>.Some { value } => value == units[i] _ => false }, "container unit names parse")
    let factor = convert.pixelsPer(units[i], &context)
    run Testing.expect(match factor { Option<f32>.Some { value } => value == fallback[i] _ => false }, "missing containers use small viewport dimensions")
    i = i + 1
  }
  context.containerWidth = Option<f32>.some(300.0)
  context.containerHeight = Option<f32>.some(200.0)
  context.containerInlineSize = Option<f32>.some(150.0)
  context.containerBlockSize = Option<f32>.some(700.0)
  let selected: [f32; 6] = [3.0, 2.0, 1.5, 7.0, 1.5, 7.0]
  i = 0
  while i < units.length {
    let factor = convert.pixelsPer(units[i], &context)
    run Testing.expect(match factor { Option<f32>.Some { value } => value == selected[i] _ => false }, "physical and logical units use independently selected ancestors")
    i = i + 1
  }
  context.containerWidth = Option<f32>.some(0.0)
  context.containerBlockSize = Option<f32>.None
  context.vertical = true
  run Testing.expect(match convert.pixelsPer(Unit.Cqw, &context) { Option<f32>.Some { value } => value == 0.0 _ => false }, "a zero-size container is not a missing container")
  run Testing.expect(match convert.pixelsPer(Unit.Cqmax, &context) { Option<f32>.Some { value } => value == 6.0 _ => false }, "only the missing logical axis falls back, using vertical small viewport axes")
}


effect fn fontUnits() ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut context = Context.make()
  context.fontSize = 20.0
  context.rootFontSize = 30.0
  run Testing.expect(isDimension(convert.dimension(&values.unit(2.0, Unit.Ch), &context), Dimension.px(20.0))
    && isDimension(convert.dimension(&values.unit(2.0, Unit.Rlh), &context), Dimension.px(60.0)), "unmeasured fonts use the current element and root fallback sizes")
  context.fontMetrics = Option<FontMetrics>.some(FontMetrics {
    xHeight: 9.0, capHeight: 14.0, zeroAdvance: 12.0, ideographAdvance: 19.0, lineHeight: 28.0,
  })
  context.rootFontMetrics = Option<FontMetrics>.some(FontMetrics {
    xHeight: 13.0, capHeight: 21.0, zeroAdvance: 17.0, ideographAdvance: 29.0, lineHeight: 42.0,
  })
  let units = [Unit.Em, Unit.Rem, Unit.Ex, Unit.Rex, Unit.Ch, Unit.Rch, Unit.Cap, Unit.Rcap, Unit.Ic, Unit.Ric, Unit.Lh, Unit.Rlh]
  let bases: [f32; 12] = [20.0, 30.0, 9.0, 13.0, 12.0, 17.0, 14.0, 21.0, 19.0, 29.0, 28.0, 42.0]
  let mut i: usize = 0
  while i < units.length {
    run Testing.expect(isDimension(convert.dimension(&values.unit(2.0, units[i]), &context), Dimension.px(bases[i] * 2.0)), "each font unit uses its independently supplied element or root metric")
    i = i + 1
  }
  let mut parts = List<Value>.make()
  run parts.append(values.unit(2.0, Unit.Ch))
  run parts.append(values.unit(1.0, Unit.Rlh))
  run parts.append(values.percent(25.0))
  let sum = values.math(MathOperator.Sum, move parts)
  run Testing.expect(isDimension(convert.dimension(&sum, &context), Dimension.calc(66.0, 0.25)), "font units reduce inside math without consuming deferred percentages")
  context.fontMetrics = Option<FontMetrics>.some(FontMetrics { xHeight: 0.0, capHeight: 0.0, zeroAdvance: 0.0, ideographAdvance: 0.0, lineHeight: 0.0 })
  run Testing.expect(isDimension(convert.dimension(&values.unit(1.0, Unit.Lh), &context), Dimension.px(0.0)), "a measured zero line height is not replaced by a fallback")
}

test effect fn fontRelativeUnitsUseHostMetrics() ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fontUnits() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn clamped(low: Value, preferred: Value, high: Value) -> Option<Dimension> ! OutOfMemoryError ? &mut Allocator {
  let mut parts = List<Value>.make()
  run parts.append(move low)
  run parts.append(move preferred)
  run parts.append(move high)
  let mut context = Context.make()
  context.fontSize = 10.0
  context.viewportWidth = 1000.0
  return convert.dimension(&values.math(MathOperator.Clamp, move parts), &context)
}

effect fn clampCases() ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  run Testing.expect(isDimension(run clamped(values.unit(1.0, Unit.Em), values.unit(2.0, Unit.Vw), values.unit(30.0, Unit.Px)), Dimension.px(20.0)), "clamp() keeps a preferred value between its bounds")
  run Testing.expect(isDimension(run clamped(values.unit(1.0, Unit.Em), values.unit(5.0, Unit.Vw), values.unit(30.0, Unit.Px)), Dimension.px(30.0)), "clamp() caps at its maximum")
  run Testing.expect(isDimension(run clamped(values.unit(1.0, Unit.Em), values.unit(0.5, Unit.Vw), values.unit(30.0, Unit.Px)), Dimension.px(10.0)), "clamp() floors at its minimum")
  run Testing.expect(isDimension(run clamped(values.unit(40.0, Unit.Px), values.unit(2.0, Unit.Vw), values.unit(30.0, Unit.Px)), Dimension.px(40.0)), "clamp()'s minimum wins over a smaller maximum")
}

effect fn sized(operator: MathOperator, first: Value, second: Value, third: Value) -> Option<SizeValue> ! OutOfMemoryError ? &mut Allocator {
  let mut parts = List<Value>.make()
  run parts.append(move first)
  run parts.append(move second)
  run parts.append(move third)
  let mut context = Context.make()
  context.fontSize = 10.0
  return convert.size(&values.math(operator, move parts), &context)
}

effect fn sizeCases() ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let least = run sized(MathOperator.Min, values.percent(100.0), values.unit(60.0, Unit.Em), values.unit(700.0, Unit.Px))
  run Testing.expect(isSize(least, SizeValue.least(600.0, 0.0, 1.0)), "min() of lengths and a percentage keeps the smallest length")
  let most = run sized(MathOperator.Max, values.percent(20.0), values.percent(50.0), values.unit(4.0, Unit.Em))
  run Testing.expect(isSize(most, SizeValue.most(40.0, 0.0, 0.5)), "max() keeps the largest percentage")
  let lengths = run sized(MathOperator.Min, values.unit(3.0, Unit.Px), values.unit(2.0, Unit.Px), values.unit(5.0, Unit.Px))
  run Testing.expect(isSize(lengths, SizeValue.px(2.0)), "min() of lengths alone is a length")
  let mut context = Context.make()
  context.fontSize = 10.0
  let inset = values.math(MathOperator.Min, run pair(run values.calc(-20.0, 100.0), values.unit(600.0, Unit.Px)))
  run Testing.expect(isSize(convert.size(&inset, &context), SizeValue.least(600.0, -20.0, 1.0)), "min() takes a percentage with a length")
  let mut bounds = run pair(values.unit(5.0, Unit.Em), values.percent(50.0))
  run bounds.append(values.unit(90.0, Unit.Px))
  run Testing.expect(isSize(convert.size(&values.math(MathOperator.Clamp, move bounds), &context), SizeValue.clamp(50.0, 0.5, 90.0)), "clamp() keeps a percentage between two lengths")
  let nested = values.math(MathOperator.Max, run pair(values.unit(50.0, Unit.Px), values.math(MathOperator.Min, run pair(values.percent(50.0), values.unit(90.0, Unit.Px)))))
  run Testing.expect(isSize(convert.size(&nested, &context), SizeValue.clamp(50.0, 0.5, 90.0)), "max() of a length and min() is a clamp")
  let mut crossed = run pair(values.unit(90.0, Unit.Px), values.percent(50.0))
  run crossed.append(values.unit(50.0, Unit.Px))
  run Testing.expect(isSize(convert.size(&values.math(MathOperator.Clamp, move crossed), &context), SizeValue.px(90.0)), "a clamp() minimum above its maximum wins")
  run Testing.expect(convert.dimension(&values.math(MathOperator.Min, run pair(values.percent(100.0), values.unit(600.0, Unit.Px))), &context).isNone(), "only a size takes a length against a percentage")
}

effect fn pair(first: Value, second: Value) -> List<Value> ! OutOfMemoryError ? &mut Allocator {
  let mut parts = List<Value>.make()
  run parts.append(move first)
  run parts.append(move second)
  return move parts
}

effect fn triple(first: Value, second: Value, third: Value) -> List<Value> ! OutOfMemoryError ? &mut Allocator {
  let mut parts = run pair(move first, move second)
  run parts.append(move third)
  return move parts
}

effect fn boundCases() ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut context = Context.make()
  context.fontSize = 10.0
  let mut bounds = Bounds.none()
  let padding = values.math(MathOperator.Clamp, run triple(values.unit(1.0, Unit.Em), values.percent(5.0), values.unit(30.0, Unit.Px)))
  run Testing.expect(isDimension(convert.edge(&padding, &context, &mut bounds), Dimension.bounded(0.0, 0.05, 0)), "an edge holds a percentage between two lengths")
  run Testing.expect(bounds.count == 1 && bounds.lower[0] == 10.0 && bounds.upper[0] == 30.0, "the bounds take a slot")
  run Testing.expect(isDimension(convert.edge(&padding, &context, &mut bounds), Dimension.bounded(0.0, 0.05, 0)) && bounds.count == 1, "the same bounds share their slot")
  // max(1em, (100% - 600px) / 2), as a centred column's padding is written.
  let mut half = List<Value>.make()
  run half.append(run values.calc(-600.0, 100.0))
  run half.append(values.math(MathOperator.Invert, run single(values.number(2.0))))
  let gutter = values.math(MathOperator.Max, run pair(values.unit(1.0, Unit.Em), values.math(MathOperator.Product, move half)))
  run Testing.expect(isDimension(convert.edge(&gutter, &context, &mut bounds), Dimension.bounded(-300.0, 0.5, 1)), "max() of a length and a length plus a percentage")
  run Testing.expect(bounds.lower[1] == 10.0 && bounds.upper[1] > 1.0e30 && bounds.hold(DimensionKind.Bounded, 1, -300.0 + 0.5 * 500.0) == 10.0, "a max() bound has no upper end")
  let mixed = values.math(MathOperator.Clamp, run triple(values.unit(200.0, Unit.Px), run values.calc(20.0, 50.0), values.unit(800.0, Unit.Px)))
  run Testing.expect(convert.size(&mixed, &context).isNone(), "a size kind has no length beside a percentage in clamp()")
  run Testing.expect(isSize(convert.sizeIn(&mixed, &context, &mut bounds), SizeValue.bounded(20.0, 0.5, 2)), "clamp() of a length plus a percentage")
  // calc(min(100%, 600px) - 2em) moves the bound with the length.
  let lessened = values.math(MathOperator.Sum, run pair(values.math(MathOperator.Min, run pair(values.percent(100.0), values.unit(600.0, Unit.Px))), values.unit(-2.0, Unit.Em)))
  let mut other = Bounds.none()
  run Testing.expect(isDimension(convert.edge(&lessened, &context, &mut other), Dimension.bounded(-20.0, 1.0, 0)) && other.upper[0] == 580.0, "a sum moves a bound")
  let wider = values.math(MathOperator.Clamp, run triple(values.unit(1.0, Unit.Px), values.percent(10.0), values.unit(2.0, Unit.Px)))
  run Testing.expect(convert.edge(&wider, &context, &mut bounds).isNone(), "a fourth pair of bounds finds no slot")
  let twoValues = values.math(MathOperator.Min, run pair(values.percent(10.0), run values.calc(5.0, 20.0)))
  run Testing.expect(convert.edge(&twoValues, &context, &mut other).isNone(), "two different values that need the basis do not compare")
}

effect fn single(value: Value) -> List<Value> ! OutOfMemoryError ? &mut Allocator {
  let mut parts = List<Value>.make()
  run parts.append(move value)
  return move parts
}

effect fn steppedCases() ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut context = Context.make()
  context.fontSize = 10.0
  let up = values.math(MathOperator.RoundUp, run pair(values.unit(2.3, Unit.Em), values.unit(1.0, Unit.Em)))
  run Testing.expect(isDimension(convert.dimension(&up, &context), Dimension.px(30.0)), "round(up) over em")
  let nearest = values.math(MathOperator.RoundNearest, run pair(values.unit(2.3, Unit.Em), values.unit(4.0, Unit.Px)))
  run Testing.expect(isDimension(convert.dimension(&nearest, &context), Dimension.px(24.0)), "round() to a pixel step")
  let modulo = values.math(MathOperator.Mod, run pair(values.unit(-1.7, Unit.Em), values.unit(5.0, Unit.Px)))
  run Testing.expect(isDimension(convert.dimension(&modulo, &context), Dimension.px(3.0)), "mod() takes the divisor's sign")
  let remainder = values.math(MathOperator.Rem, run pair(values.unit(-1.7, Unit.Em), values.unit(5.0, Unit.Px)))
  run Testing.expect(isDimension(convert.dimension(&remainder, &context), Dimension.px(-2.0)), "rem() takes the dividend's sign")
  run Testing.expect(isDimension(convert.dimension(&values.math(MathOperator.Abs, run single(values.unit(-1.0, Unit.Em))), &context), Dimension.px(10.0)), "abs() over em")
  run Testing.expect(isDimension(convert.dimension(&values.math(MathOperator.Hypot, run pair(values.unit(3.0, Unit.Em), values.unit(4.0, Unit.Em))), &context), Dimension.px(50.0)), "hypot() over em")
  let signed = values.math(MathOperator.Product, run pair(values.math(MathOperator.Sign, run single(values.unit(-1.0, Unit.Em))), values.unit(8.0, Unit.Px)))
  run Testing.expect(isDimension(convert.dimension(&signed, &context), Dimension.px(-8.0)), "sign() is a number")
  run Testing.expect(convert.dimension(&values.math(MathOperator.RoundUp, run pair(values.percent(33.0), values.unit(10.0, Unit.Px))), &context).isNone(), "round() of a percentage needs the basis")
}


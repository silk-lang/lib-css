//! Between values as written and computed values. Written to computed resolves units against
//! a `Context` and turns percentages into fractions; computed to written goes the other way
//! for an inspector. A conversion returns `None` when the written value has no computed form
//! for that type, which is how a caller ignores an invalid declaration.
import computed {
  Dimension,
  SizeValue,
  Bound,
  Bounds,
  DimensionKind,
  Display,
  DisplayOutside,
  DisplayInside,
  Align,
  OverflowAlignment,
  ScrollbarGutter,
  LineHeight,
  VerticalAlign,
  VerticalAlignKind,
  TabSize,
  TextIndent,
  TextEdge,
  TextBoxEdge,
  TextBoxTrim,
  DecorationLine,
  BoxShadow,
  Fill,
}
import keywords { Keyword }
import keywords
import values { Value, Unit, MathOperator }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.num.f32
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Font-relative unit bases in CSS pixels, supplied by the text host. The caller
/// chooses parent metrics for font-size and the inherited line height for lh in
/// font-size/line-height; other properties use the element's computed metrics.
pub struct FontMetrics {
  pub xHeight: f32,
  pub capHeight: f32,
  pub zeroAdvance: f32,
  pub ideographAdvance: f32,
  pub lineHeight: f32,
}

impl Copy for FontMetrics {}

impl FontMetrics {
  /// CSS fallback metrics when the host cannot measure a font.
  pub fn fallback(fontSize: f32) -> FontMetrics {
    return FontMetrics { xHeight: fontSize * 0.5, capHeight: fontSize,
      zeroAdvance: fontSize * 0.5, ideographAdvance: fontSize, lineHeight: fontSize }
  }
}

/// What relative units resolve against. Sizes are CSS pixels.
pub struct Context {
  /// The element's font size, for `em`.
  pub fontSize: f32,
  /// The root font size, for `rem`.
  pub rootFontSize: f32,
  pub fontMetrics: Option<FontMetrics>,
  pub rootFontMetrics: Option<FontMetrics>,
  pub viewportWidth: f32,
  pub viewportHeight: f32,
  pub smallViewportWidth: Option<f32>,
  pub smallViewportHeight: Option<f32>,
  pub vertical: bool,
  /// Independently selected ancestor content sizes; None uses the small viewport.
  pub containerWidth: Option<f32>,
  pub containerHeight: Option<f32>,
  pub containerInlineSize: Option<f32>,
  pub containerBlockSize: Option<f32>,
  /// The element's effective `zoom`. Absolute and viewport units are multiplied by it; the
  /// font sizes and metrics above are already zoomed, and container units read zoomed boxes.
  pub zoom: f32,
}

impl Copy for Context {}

impl Context {
  /// A 16 px font and an empty viewport.
  pub fn make() -> Context {
    return Context {
      fontSize: 16.0, rootFontSize: 16.0, viewportWidth: 0.0, viewportHeight: 0.0,
      fontMetrics: Option<FontMetrics>.None, rootFontMetrics: Option<FontMetrics>.None,
      smallViewportWidth: Option<f32>.None, smallViewportHeight: Option<f32>.None, vertical: false,
      containerWidth: Option<f32>.None, containerHeight: Option<f32>.None,
      containerInlineSize: Option<f32>.None, containerBlockSize: Option<f32>.None,
      zoom: 1.0,
    }
  }

  pub fn metrics(self: &Self) -> FontMetrics {
    return match self.fontMetrics { Option.Some { value } => value _ => FontMetrics.fallback(self.fontSize) }
  }

  pub fn rootMetrics(self: &Self) -> FontMetrics {
    return match self.rootFontMetrics { Option.Some { value } => value _ => FontMetrics.fallback(self.rootFontSize) }
  }

}

fn basis(size: Option<f32>, fallback: f32) -> f32 {
  if let Option<f32>.Some { value } = size { return value }
  return fallback
}

/// CSS pixels per one `unit`, or `None` when `unit` is not a length this context resolves.
pub fn pixelsPer(unit: Unit, context: &Context) -> Option<f32> {
  let found = unzoomedPixelsPer(unit, context)
  if context.zoom == 1.0 || !zoomScales(unit) { return found }
  return match found {
    Option.Some { value } => Option<f32>.some(value * context.zoom)
    Option.None => Option<f32>.None
  }
}

// Font-relative units read sizes that are zoomed already; container units read zoomed boxes.
fn zoomScales(unit: Unit) -> bool {
  return match unit {
    Unit.Em | Unit.Rem | Unit.Ex | Unit.Ch | Unit.Ic | Unit.Cap | Unit.Lh
      | Unit.Rex | Unit.Rch | Unit.Ric | Unit.Rcap | Unit.Rlh
      | Unit.Cqw | Unit.Cqh | Unit.Cqi | Unit.Cqb | Unit.Cqmin | Unit.Cqmax => false
    _ => true
  }
}

fn unzoomedPixelsPer(unit: Unit, context: &Context) -> Option<f32> {
  let smaller = if context.viewportWidth < context.viewportHeight {
    context.viewportWidth
  } else {
    context.viewportHeight
  }
  let larger = if context.viewportWidth < context.viewportHeight {
    context.viewportHeight
  } else {
    context.viewportWidth
  }
  let smallWidth = basis(context.smallViewportWidth, context.viewportWidth)
  let smallHeight = basis(context.smallViewportHeight, context.viewportHeight)
  let inlineSize = if context.vertical { context.viewportHeight } else { context.viewportWidth }
  let blockSize = if context.vertical { context.viewportWidth } else { context.viewportHeight }
  let smallInline = if context.vertical { smallHeight } else { smallWidth }
  let smallBlock = if context.vertical { smallWidth } else { smallHeight }
  let containerInline = basis(context.containerInlineSize, smallInline)
  let containerBlock = basis(context.containerBlockSize, smallBlock)
  let containerMin = if containerInline < containerBlock { containerInline } else { containerBlock }
  let containerMax = if containerInline > containerBlock { containerInline } else { containerBlock }
  return match unit {
    Unit.Cqw => Option<f32>.some(basis(context.containerWidth, smallWidth) / 100.0)
    Unit.Cqh => Option<f32>.some(basis(context.containerHeight, smallHeight) / 100.0)
    Unit.Cqi => Option<f32>.some(containerInline / 100.0)
    Unit.Cqb => Option<f32>.some(containerBlock / 100.0)
    Unit.Cqmin => Option<f32>.some(containerMin / 100.0)
    Unit.Cqmax => Option<f32>.some(containerMax / 100.0)
    Unit.Px => Option<f32>.some(1.0)
    Unit.Cm => Option<f32>.some(96.0 / 2.54)
    Unit.Mm => Option<f32>.some(96.0 / 25.4)
    Unit.Q => Option<f32>.some(96.0 / 101.6)
    Unit.In => Option<f32>.some(96.0)
    Unit.Pt => Option<f32>.some(96.0 / 72.0)
    Unit.Pc => Option<f32>.some(16.0)
    Unit.Em => Option<f32>.some(context.fontSize)
    Unit.Rem => Option<f32>.some(context.rootFontSize)
    Unit.Ex => Option<f32>.some(context.metrics().xHeight)
    Unit.Ch => Option<f32>.some(context.metrics().zeroAdvance)
    Unit.Ic => Option<f32>.some(context.metrics().ideographAdvance)
    Unit.Cap => Option<f32>.some(context.metrics().capHeight)
    Unit.Lh => Option<f32>.some(context.metrics().lineHeight)
    Unit.Rex => Option<f32>.some(context.rootMetrics().xHeight)
    Unit.Rch => Option<f32>.some(context.rootMetrics().zeroAdvance)
    Unit.Ric => Option<f32>.some(context.rootMetrics().ideographAdvance)
    Unit.Rcap => Option<f32>.some(context.rootMetrics().capHeight)
    Unit.Rlh => Option<f32>.some(context.rootMetrics().lineHeight)
    Unit.Vw => Option<f32>.some(context.viewportWidth / 100.0)
    Unit.Svw => Option<f32>.some(smallWidth / 100.0)
    Unit.Lvw => Option<f32>.some(context.viewportWidth / 100.0)
    Unit.Dvw => Option<f32>.some(context.viewportWidth / 100.0)
    Unit.Vi => Option<f32>.some(inlineSize / 100.0)
    Unit.Svi => Option<f32>.some(smallInline / 100.0)
    Unit.Lvi => Option<f32>.some(inlineSize / 100.0)
    Unit.Dvi => Option<f32>.some(inlineSize / 100.0)
    Unit.Vh => Option<f32>.some(context.viewportHeight / 100.0)
    Unit.Svh => Option<f32>.some(smallHeight / 100.0)
    Unit.Lvh => Option<f32>.some(context.viewportHeight / 100.0)
    Unit.Dvh => Option<f32>.some(context.viewportHeight / 100.0)
    Unit.Vb => Option<f32>.some(blockSize / 100.0)
    Unit.Svb => Option<f32>.some(smallBlock / 100.0)
    Unit.Lvb => Option<f32>.some(blockSize / 100.0)
    Unit.Dvb => Option<f32>.some(blockSize / 100.0)
    Unit.Vmin => Option<f32>.some(smaller / 100.0)
    Unit.Svmin => Option<f32>.some((if smallWidth < smallHeight { smallWidth } else { smallHeight }) / 100.0)
    Unit.Lvmin => Option<f32>.some(smaller / 100.0)
    Unit.Dvmin => Option<f32>.some(smaller / 100.0)
    Unit.Vmax => Option<f32>.some(larger / 100.0)
    Unit.Svmax => Option<f32>.some((if smallWidth > smallHeight { smallWidth } else { smallHeight }) / 100.0)
    Unit.Lvmax => Option<f32>.some(larger / 100.0)
    Unit.Dvmax => Option<f32>.some(larger / 100.0)
    _ => Option<f32>.None
  }
}

/// A length plus a percentage: what a `calc()` over lengths and percentages reduces to.
/// `percent` is a fraction. `scalar` is true when the value was a plain number.
struct Linear {
  pixels: f32,
  percent: f32,
  scalar: bool,
  valid: bool,
}

impl Copy for Linear {}

fn invalid() -> Linear {
  return Linear { pixels: 0.0, percent: 0.0, scalar: false, valid: false }
}

/// `part * factor`, where a part that is not there stays zero under an infinite factor.
fn scaled(part: f32, factor: f32) -> f32 {
  if part == 0.0 {
    return 0.0
  }
  return part * factor
}

/// The length an infinite one is clamped to, in CSS pixels: 2^25, as browsers do.
const LARGEST_LENGTH: f32 = 33554432.0

/// `pixels` as a length geometry can use: an infinite one is the largest there is, a NaN zero.
fn finite(pixels: f32) -> f32 {
  if pixels != pixels {
    return 0.0
  }
  if pixels > LARGEST_LENGTH {
    return LARGEST_LENGTH
  }
  if pixels < 0.0 - LARGEST_LENGTH {
    return 0.0 - LARGEST_LENGTH
  }
  return pixels
}

fn linear(value: &Value, context: &Context) -> Linear {
  match &value.* {
    Value.Unit { value: amount, unit } => {
      if unit == Unit.Number {
        return Linear { pixels: amount, percent: 0.0, scalar: true, valid: true }
      }
      if unit == Unit.Percent {
        return Linear { pixels: 0.0, percent: amount / 100.0, scalar: false, valid: true }
      }
      return match pixelsPer(unit, context) {
        Option.Some { value: scale } => Linear { pixels: amount * scale, percent: 0.0, scalar: false, valid: true }
        Option.None => invalid()
      }
    }
    Value.Math { operator, values } => {
      let items = values.asSlice()
      if items.length == 0 {
        return invalid()
      }
      let mut total = linear(&items[0], context)
      if !total.valid {
        return invalid()
      }
      match operator {
        MathOperator.Negate => {
          total.pixels = 0.0 - total.pixels
          total.percent = 0.0 - total.percent
          return total
        }
        MathOperator.Invert => {
          if !total.scalar || total.pixels == 0.0 {
            return invalid()
          }
          total.pixels = 1.0 / total.pixels
          return total
        }
        MathOperator.RoundNearest => { return stepFunction(items, context, 0) }
        MathOperator.RoundUp => { return stepFunction(items, context, 1) }
        MathOperator.RoundDown => { return stepFunction(items, context, 2) }
        MathOperator.RoundToZero => { return stepFunction(items, context, 3) }
        MathOperator.Mod => { return stepFunction(items, context, 4) }
        MathOperator.Rem => { return stepFunction(items, context, 5) }
        MathOperator.Abs => {
          if items.length != 1 || total.percent != 0.0 { return invalid() }
          total.pixels = f32.abs(total.pixels)
          return total
        }
        MathOperator.Sign => {
          if items.length != 1 || total.percent != 0.0 { return invalid() }
          let sign: f32 = if total.pixels > 0.0 { 1.0 } else if total.pixels < 0.0 { 0.0 - 1.0 } else { 0.0 }
          return Linear { pixels: sign, percent: 0.0, scalar: true, valid: true }
        }
        MathOperator.Hypot => {
          let mut squares: f32 = 0.0
          let mut i: usize = 0
          while i < items.length {
            let next = linear(&items[i], context)
            if !next.valid || next.percent != 0.0 || next.scalar != total.scalar { return invalid() }
            squares = squares + next.pixels * next.pixels
            i = i + 1
          }
          total.pixels = f32.sqrt(squares)
          return total
        }
        MathOperator.Clamp => {
          // clamp(MIN, VAL, MAX) is max(MIN, min(VAL, MAX)): MIN wins when it exceeds MAX.
          if items.length != 3 {
            return invalid()
          }
          let preferred = linear(&items[1], context)
          let upper = linear(&items[2], context)
          if !preferred.valid || !upper.valid || total.percent != 0.0 || preferred.percent != 0.0
            || upper.percent != 0.0 || preferred.scalar != total.scalar || upper.scalar != total.scalar {
            return invalid()
          }
          let mut value = preferred.pixels
          if upper.pixels < value {
            value = upper.pixels
          }
          if total.pixels > value {
            value = total.pixels
          }
          total.pixels = value
          return total
        }
        _ => {}
      }
      let mut i: usize = 1
      while i < items.length {
        let next = linear(&items[i], context)
        if !next.valid {
          return invalid()
        }
        match operator {
          MathOperator.Sum => {
            if next.scalar != total.scalar {
              return invalid()
            }
            total.pixels = total.pixels + next.pixels
            total.percent = total.percent + next.percent
          }
          MathOperator.Product => {
            if next.scalar {
              total.pixels = total.pixels * next.pixels
              total.percent = scaled(total.percent, next.pixels)
            } else if total.scalar {
              let factor = total.pixels
              total = Linear { pixels: next.pixels * factor, percent: scaled(next.percent, factor), scalar: false, valid: true }
            } else {
              return invalid()
            }
          }
          MathOperator.Min => {
            // Comparing needs the percentage basis, which only layout knows.
            if next.percent != 0.0 || total.percent != 0.0 || next.scalar != total.scalar {
              return invalid()
            }
            if next.pixels < total.pixels {
              total.pixels = next.pixels
            }
          }
          MathOperator.Max => {
            if next.percent != 0.0 || total.percent != 0.0 || next.scalar != total.scalar {
              return invalid()
            }
            if next.pixels > total.pixels {
              total.pixels = next.pixels
            }
          }
          _ => {
            return invalid()
          }
        }
        i = i + 1
      }
      return total
    }
    _ => {
      return invalid()
    }
  }
}

// round() (strategies 0 nearest, 1 up, 2 down, 3 toward zero), mod() (4) and rem() (5) over
// lengths or numbers. A percentage would need the basis; those are dropped.
fn stepFunction(items: &[Value], context: &Context, strategy: u8) -> Linear {
  if items.length == 0 || items.length > 2 { return invalid() }
  let value = linear(&items[0], context)
  if !value.valid || value.percent != 0.0 { return invalid() }
  if items.length == 1 {
    // round(VALUE) steps by 1 only for a number.
    if strategy > 3 || !value.scalar { return invalid() }
    return Linear { pixels: f32.floor(value.pixels + 0.5), percent: 0.0, scalar: true, valid: true }
  }
  let step = linear(&items[1], context)
  if !step.valid || step.percent != 0.0 || step.scalar != value.scalar || step.pixels == 0.0 { return invalid() }
  let ratio = value.pixels / step.pixels
  let whole = if strategy == 1 {
    f32.ceil(ratio)
  } else if strategy == 2 || strategy == 4 {
    f32.floor(ratio)
  } else if strategy == 3 || strategy == 5 {
    f32.trunc(ratio)
  } else {
    f32.floor(ratio + 0.5)
  }
  let pixels = if strategy > 3 { value.pixels - whole * step.pixels } else { whole * step.pixels }
  return Linear { pixels: pixels, percent: 0.0, scalar: value.scalar, valid: true }
}

/// The keyword `value` is, if it is one.
pub fn keywordOf(value: &Value) -> Option<Keyword> {
  return match &value.* {
    Value.Keyword { value: inner } => Option<Keyword>.some(inner)
    _ => Option<Keyword>.None
  }
}

/// Whether `value` is the keyword `expected`.
pub fn isKeyword(value: &Value, expected: Keyword) -> bool {
  return match &value.* {
    Value.Keyword { value: inner } => inner == expected
    _ => false
  }
}

/// A plain number, also from a `calc()` over numbers.
pub fn number(value: &Value) -> Option<f32> {
  let reduced = linear(value, &Context.make())
  if reduced.valid && reduced.scalar {
    return Option<f32>.some(reduced.pixels)
  }
  return Option<f32>.None
}

/// A length in CSS pixels. A percentage is not a length.
pub fn length(value: &Value, context: &Context) -> Option<f32> {
  let reduced = linear(value, context)
  if reduced.valid && reduced.percent == 0.0 && (!reduced.scalar || reduced.pixels == 0.0) {
    return Option<f32>.some(finite(reduced.pixels))
  }
  return Option<f32>.None
}

/// A size-like value: a sizing keyword, a length, a percentage or a `calc()` of both.
pub fn dimension(value: &Value, context: &Context) -> Option<Dimension> {
  match &value.* {
    Value.Keyword { value: inner } => {
      return match inner {
        Keyword.Auto => Option<Dimension>.some(Dimension.auto())
        Keyword.None => Option<Dimension>.some(Dimension.keyword(DimensionKind.None))
        Keyword.Normal => Option<Dimension>.some(Dimension.keyword(DimensionKind.Normal))
        Keyword.MinContent => Option<Dimension>.some(Dimension.keyword(DimensionKind.MinContent))
        Keyword.MaxContent => Option<Dimension>.some(Dimension.keyword(DimensionKind.MaxContent))
        Keyword.FitContent => Option<Dimension>.some(Dimension.keyword(DimensionKind.FitContent))
        Keyword.Content => Option<Dimension>.some(Dimension.keyword(DimensionKind.Content))
        _ => Option<Dimension>.None
      }
    }
    Value.Unit { value: amount, unit } => {
      if unit == Unit.Percent {
        return Option<Dimension>.some(Dimension.pct(amount / 100.0))
      }
    }
    _ => {}
  }
  let reduced = linear(value, context)
  if !reduced.valid || (reduced.scalar && reduced.pixels != 0.0) {
    return Option<Dimension>.None
  }
  if reduced.percent != 0.0 {
    return Option<Dimension>.some(Dimension.calc(finite(reduced.pixels), reduced.percent))
  }
  return Option<Dimension>.some(Dimension.px(finite(reduced.pixels)))
}

/// A width, height, minimum, maximum or flex basis: a `dimension`, or a comparison that needs
/// the percentage basis: `min()` or `max()` of lengths against a length plus a percentage, such
/// as `min(100% - 20px, 600px)`, and `clamp()` of a percentage between two lengths.
pub fn size(value: &Value, context: &Context) -> Option<SizeValue> {
  if let Option<Dimension>.Some { value: found } = dimension(value, context) {
    return Option<SizeValue>.some(SizeValue.of(found))
  }
  if let Value.Math { operator, values } = &value.* {
    let items = values.asSlice()
    if operator == MathOperator.Clamp && items.length == 3 {
      let lower = linear(&items[0], context)
      let middle = linear(&items[1], context)
      let upper = linear(&items[2], context)
      if lower.valid && middle.valid && upper.valid && !lower.scalar && !middle.scalar && !upper.scalar
        && lower.percent == 0.0 && upper.percent == 0.0 && middle.pixels == 0.0 {
        return Option<SizeValue>.some(clamped(finite(lower.pixels), middle.percent, finite(upper.pixels)))
      }
      return Option<SizeValue>.None
    }
    let least = operator == MathOperator.Min
    if !least && operator != MathOperator.Max {
      return Option<SizeValue>.None
    }
    let mut bound: f32 = 0.0
    let mut bounded = false
    let mut mixed = SizeValue.auto()
    let mut i: usize = 0
    while i < items.length {
      let term = linear(&items[i], context)
      if term.valid && !term.scalar && term.percent == 0.0 {
        let pixels = finite(term.pixels)
        if !bounded || (pixels < bound) == least { bound = pixels }
        bounded = true
      } else {
        // One argument may need the basis: a length plus a percentage, or the other comparison.
        let found = if term.valid { Option<SizeValue>.some(SizeValue.calc(finite(term.pixels), term.percent)) } else { size(&items[i], context) }
        match found {
          Option.Some { value: next } => {
            if term.scalar || !next.relative() {
              return Option<SizeValue>.None
            }
            if mixed.kind == DimensionKind.Auto {
              mixed = next
            } else if mixed.kind == DimensionKind.Calc && next.kind == DimensionKind.Calc && mixed.value == next.value {
              // The basis of a size is never negative, so percentages compare as numbers.
              if (next.percent < mixed.percent) == least { mixed.percent = next.percent }
            } else {
              return Option<SizeValue>.None
            }
          }
          Option.None => {
            return Option<SizeValue>.None
          }
        }
      }
      i = i + 1
    }
    if !bounded {
      return if mixed.kind == DimensionKind.Auto { Option<SizeValue>.None } else { Option<SizeValue>.some(mixed) }
    }
    if mixed.kind == DimensionKind.Calc {
      return Option<SizeValue>.some(if least { SizeValue.least(bound, mixed.value, mixed.percent) } else { SizeValue.most(bound, mixed.value, mixed.percent) })
    }
    // max(MIN, min(VAL, MAX)) is clamp(MIN, VAL, MAX); min(MAX, max(VAL, MIN)) differs only
    // where MIN exceeds MAX, and there it is MAX.
    if !least && mixed.kind == DimensionKind.Least && mixed.value == 0.0 {
      return Option<SizeValue>.some(clamped(bound, mixed.percent, mixed.bound))
    }
    if least && mixed.kind == DimensionKind.Most && mixed.value == 0.0 {
      return Option<SizeValue>.some(if mixed.bound > bound { SizeValue.px(bound) } else { SizeValue.clamp(mixed.bound, mixed.percent, bound) })
    }
  }
  return Option<SizeValue>.None
}

/// A margin, padding, inset or gap: a `dimension`, or `min()`, `max()` and `clamp()` that
/// compare a length plus a percentage with lengths, such as `clamp(1rem, 5% + 4px, 3rem)` or
/// `max(1rem, (100% - 60rem) / 2)`. Their bounds go in a slot of `bounds`; none when no slot
/// is left.
pub fn edge(value: &Value, context: &Context, bounds: &mut Bounds) -> Option<Dimension> {
  if let Option<Dimension>.Some { value: found } = dimension(value, context) {
    return Option<Dimension>.some(found)
  }
  if let Option<Bound>.Some { value: found } = bound(value, context) {
    if !found.bounded() { return Option<Dimension>.some(if found.percent == 0.0 { Dimension.px(found.value) } else { Dimension.calc(found.value, found.percent) }) }
    if let Option<u8>.Some { value: slot } = bounds.slotOf(found.lower, found.upper) {
      return Option<Dimension>.some(Dimension.bounded(found.value, found.percent, slot))
    }
  }
  return Option<Dimension>.None
}

/// A `size`, or a comparison `size` has no kind for, as `edge` takes it: `clamp(200px, 50% +
/// 2rem, 800px)` or `calc(min(100%, 60rem) - 2rem)`.
pub fn sizeIn(value: &Value, context: &Context, bounds: &mut Bounds) -> Option<SizeValue> {
  if let Option<SizeValue>.Some { value: found } = size(value, context) {
    return Option<SizeValue>.some(found)
  }
  if let Option<Bound>.Some { value: found } = bound(value, context) {
    if found.bounded() && found.percent != 0.0 {
      if let Option<u8>.Some { value: slot } = bounds.slotOf(found.lower, found.upper) {
        return Option<SizeValue>.some(SizeValue.bounded(found.value, found.percent, slot))
      }
    }
  }
  return Option<SizeValue>.None
}

/// `value` as a length plus a percentage held between two lengths, when it is one: sums,
/// products with numbers, `min()`, `max()` and `clamp()` over lengths and percentages.
/// Comparing a length plus a percentage with a length moves a bound; comparing two of them
/// needs both to have the same length and percentage, as in `clamp(1rem, 5%, 3rem)`. Since
/// a percentage basis is never negative, `min(10%, 20%)` is `10%`.
pub fn bound(value: &Value, context: &Context) -> Option<Bound> {
  let reduced = linear(value, context)
  if reduced.valid {
    if reduced.scalar { return Option<Bound>.None }
    return Option<Bound>.some(Bound.line(finite(reduced.pixels), reduced.percent))
  }
  if let Value.Math { operator, values } = &value.* {
    return mathBound(operator, values.asSlice(), context)
  }
  return Option<Bound>.None
}

fn mathBound(operator: MathOperator, items: &[Value], context: &Context) -> Option<Bound> {
  if items.length == 0 { return Option<Bound>.None }
  if operator == MathOperator.Negate {
    return match bound(&items[0], context) {
      Option.Some { value: inner } => Option<Bound>.some(scaledBound(inner, 0.0 - 1.0))
      Option.None => Option<Bound>.None
    }
  }
  if operator == MathOperator.Product {
    let mut factor: f32 = 1.0
    let mut found = Option<Bound>.None
    let mut i: usize = 0
    while i < items.length {
      let term = linear(&items[i], context)
      if term.valid && term.scalar {
        factor = factor * term.pixels
      } else {
        if found.isSome() { return Option<Bound>.None }
        found = bound(&items[i], context)
        if found.isNone() { return Option<Bound>.None }
      }
      i = i + 1
    }
    return match found {
      Option.Some { value: inner } => Option<Bound>.some(scaledBound(inner, factor))
      Option.None => Option<Bound>.None
    }
  }
  if operator == MathOperator.Clamp {
    if items.length != 3 { return Option<Bound>.None }
    // clamp(MIN, VAL, MAX) is max(MIN, min(VAL, MAX)): MIN wins when it exceeds MAX.
    if let Option<Bound>.Some { value: lower } = bound(&items[0], context) {
      if let Option<Bound>.Some { value: middle } = bound(&items[1], context) {
        if let Option<Bound>.Some { value: upper } = bound(&items[2], context) {
          if let Option<Bound>.Some { value: inner } = compared(middle, upper, true) {
            return compared(inner, lower, false)
          }
        }
      }
    }
    return Option<Bound>.None
  }
  if operator != MathOperator.Sum && operator != MathOperator.Min && operator != MathOperator.Max {
    return Option<Bound>.None
  }
  let mut total = match bound(&items[0], context) {
    Option.Some { value: first } => first
    Option.None => { return Option<Bound>.None }
  }
  let mut i: usize = 1
  while i < items.length {
    let next = match bound(&items[i], context) {
      Option.Some { value: found } => found
      Option.None => { return Option<Bound>.None }
    }
    let combined = if operator == MathOperator.Sum { added(total, next) } else { compared(total, next, operator == MathOperator.Min) }
    total = match combined {
      Option.Some { value: found } => found
      Option.None => { return Option<Bound>.None }
    }
    i = i + 1
  }
  return Option<Bound>.some(total)
}

// A bound whose percentage is zero is the length it holds.
fn settled(value: Bound) -> Bound {
  if value.percent != 0.0 { return value }
  return Bound.line(f32.max(value.lower, f32.min(value.value, value.upper)), 0.0)
}

fn scaledBound(value: Bound, factor: f32) -> Bound {
  if factor == 0.0 { return Bound.line(0.0, 0.0) }
  let lower = value.lower * factor
  let upper = value.upper * factor
  return Bound {
    lower: if factor > 0.0 { lower } else { upper },
    value: value.value * factor,
    percent: value.percent * factor,
    upper: if factor > 0.0 { upper } else { lower },
  }
}

// A sum moves the bounds by a length; two values that both need the basis add only unbounded.
fn added(left: Bound, right: Bound) -> Option<Bound> {
  if right.percent == 0.0 {
    return Option<Bound>.some(Bound { lower: left.lower + right.value, value: left.value + right.value, percent: left.percent, upper: left.upper + right.value })
  }
  if left.percent == 0.0 { return added(right, left) }
  if left.bounded() || right.bounded() { return Option<Bound>.None }
  return Option<Bound>.some(Bound.line(left.value + right.value, left.percent + right.percent))
}

// min() when `least`, else max(), of two bounds.
fn compared(left: Bound, right: Bound, least: bool) -> Option<Bound> {
  if left.percent == 0.0 && right.percent == 0.0 {
    return Option<Bound>.some(Bound.line(if least { f32.min(left.value, right.value) } else { f32.max(left.value, right.value) }, 0.0))
  }
  if left.percent == 0.0 { return compared(right, left, least) }
  if right.percent == 0.0 {
    let length = right.value
    // min(clamp(L, x, U), c) is c where c <= L, else clamp(L, x, min(U, c)); max() mirrors it.
    if least {
      if length <= left.lower { return Option<Bound>.some(Bound.line(length, 0.0)) }
      return Option<Bound>.some(settled(Bound { lower: left.lower, value: left.value, percent: left.percent, upper: f32.min(left.upper, length) }))
    }
    if length >= left.upper { return Option<Bound>.some(Bound.line(length, 0.0)) }
    return Option<Bound>.some(settled(Bound { lower: f32.max(left.lower, length), value: left.value, percent: left.percent, upper: left.upper }))
  }
  if left.value == right.value && left.percent == right.percent {
    // Clamps of one value: the bounds compare pairwise.
    return Option<Bound>.some(if least {
      Bound { lower: f32.min(left.lower, right.lower), value: left.value, percent: left.percent, upper: f32.min(left.upper, right.upper) }
    } else {
      Bound { lower: f32.max(left.lower, right.lower), value: left.value, percent: left.percent, upper: f32.max(left.upper, right.upper) }
    })
  }
  if left.value == right.value && !left.bounded() && !right.bounded() {
    // The basis is never negative, so percentages compare as numbers.
    return Option<Bound>.some(Bound.line(left.value, if (left.percent < right.percent) == least { left.percent } else { right.percent }))
  }
  return Option<Bound>.None
}

// clamp(MIN, VAL, MAX) is max(MIN, min(VAL, MAX)): MIN wins when it exceeds MAX.
fn clamped(lower: f32, percent: f32, upper: f32) -> SizeValue {
  if lower >= upper { return SizeValue.px(lower) }
  return SizeValue.clamp(lower, percent, upper)
}

// The argument of min() or max() that needs the basis: a percentage, with its length if any.
effect fn basisTerm(value: SizeValue) -> Value ! OutOfMemoryError ? &mut Allocator {
  if value.value == 0.0 { return Value.Unit { value: value.percent * 100.0, unit: Unit.Percent } }
  let mut terms = List<Value>.make()
  run terms.append(Value.Unit { value: value.value, unit: Unit.Px })
  run terms.append(Value.Unit { value: value.percent * 100.0, unit: Unit.Percent })
  return Value.Math { operator: MathOperator.Sum, values: move terms }
}

/// A computed size as written: lengths in `px`, percentages 0 to 100.
pub effect fn fromDimension(value: Dimension) -> Value ! OutOfMemoryError ? &mut Allocator {
  return run fromSize(SizeValue.of(value))
}

/// A computed size as written, with the bounds of a `Bounded` one from `bounds`.
pub effect fn fromSizeIn(value: SizeValue, bounds: &Bounds) -> Value ! OutOfMemoryError ? &mut Allocator {
  if value.kind != DimensionKind.Bounded { return run fromSize(value) }
  return run fromBound(bounds.bound(value.slot, value.value, value.percent))
}

/// A computed edge or gap as written, with the bounds of a `Bounded` one from `bounds`.
pub effect fn fromDimensionIn(value: Dimension, bounds: &Bounds) -> Value ! OutOfMemoryError ? &mut Allocator {
  return run fromSizeIn(SizeValue.of(value), bounds)
}

/// `clamp()`, or `min()` or `max()` when a bound is infinite, of a length plus a percentage.
pub effect fn fromBound(value: Bound) -> Value ! OutOfMemoryError ? &mut Allocator {
  let middle = run basisTerm(SizeValue.calc(value.value, value.percent))
  let mut terms = List<Value>.make()
  if value.lower == 0.0 - f32.INFINITY || value.upper == f32.INFINITY {
    let least = value.lower == 0.0 - f32.INFINITY
    run terms.append(Value.Unit { value: if least { value.upper } else { value.lower }, unit: Unit.Px })
    run terms.append(move middle)
    return Value.Math { operator: if least { MathOperator.Min } else { MathOperator.Max }, values: move terms }
  }
  run terms.append(Value.Unit { value: value.lower, unit: Unit.Px })
  run terms.append(move middle)
  run terms.append(Value.Unit { value: value.upper, unit: Unit.Px })
  return Value.Math { operator: MathOperator.Clamp, values: move terms }
}

/// A computed size as written, with the comparisons only a size holds.
pub effect fn fromSize(value: SizeValue) -> Value ! OutOfMemoryError ? &mut Allocator {
  match value.kind {
    DimensionKind.Auto => {
      return Value.Keyword { value: Keyword.Auto }
    }
    DimensionKind.Length => {
      return Value.Unit { value: value.value, unit: Unit.Px }
    }
    DimensionKind.Percent => {
      return Value.Unit { value: value.percent * 100.0, unit: Unit.Percent }
    }
    DimensionKind.Calc => {
      let mut terms = List<Value>.make()
      run terms.append(Value.Unit { value: value.value, unit: Unit.Px })
      run terms.append(Value.Unit { value: value.percent * 100.0, unit: Unit.Percent })
      return Value.Math { operator: MathOperator.Sum, values: move terms }
    }
    DimensionKind.Least => {
      let mut terms = List<Value>.make()
      run terms.append(Value.Unit { value: value.bound, unit: Unit.Px })
      run terms.append(run basisTerm(value))
      return Value.Math { operator: MathOperator.Min, values: move terms }
    }
    DimensionKind.Most => {
      let mut terms = List<Value>.make()
      run terms.append(Value.Unit { value: value.bound, unit: Unit.Px })
      run terms.append(run basisTerm(value))
      return Value.Math { operator: MathOperator.Max, values: move terms }
    }
    DimensionKind.Clamp => {
      let mut terms = List<Value>.make()
      run terms.append(Value.Unit { value: value.value, unit: Unit.Px })
      run terms.append(Value.Unit { value: value.percent * 100.0, unit: Unit.Percent })
      run terms.append(Value.Unit { value: value.bound, unit: Unit.Px })
      return Value.Math { operator: MathOperator.Clamp, values: move terms }
    }
    DimensionKind.Bounded => {
      // Its bounds are in the style; `fromSizeIn` writes them.
      return run basisTerm(value)
    }
    DimensionKind.MinContent => {
      return Value.Keyword { value: Keyword.MinContent }
    }
    DimensionKind.MaxContent => {
      return Value.Keyword { value: Keyword.MaxContent }
    }
    DimensionKind.FitContent => {
      return Value.Keyword { value: Keyword.FitContent }
    }
    DimensionKind.Content => {
      return Value.Keyword { value: Keyword.Content }
    }
    DimensionKind.None => {
      return Value.Keyword { value: Keyword.None }
    }
    DimensionKind.Normal => {
      return Value.Keyword { value: Keyword.Normal }
    }
  }
}

/// A color. `transparent` is transparent black.
pub fn color(value: &Value) -> Option<Rgba<f32>> {
  return match &value.* {
    Value.Color { value: inner } => Option<Rgba<f32>>.some(inner)
    Value.Keyword { value: inner } => if inner == Keyword.Transparent {
      Option<Rgba<f32>>.some(Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 })
    } else {
      Option<Rgba<f32>>.None
    }
    _ => Option<Rgba<f32>>.None
  }
}

fn box(outside: DisplayOutside, inside: DisplayInside) -> Option<Display> {
  return Option<Display>.some(Display.Box { outside: outside, inside: inside })
}

/// `display` from its single-keyword forms.
pub fn display(value: &Value) -> Option<Display> {
  return match &value.* {
    Value.Keyword { value: inner } => match inner {
      Keyword.None => Option<Display>.some(Display.None)
      Keyword.Contents => Option<Display>.some(Display.Contents)
      Keyword.Block => box(DisplayOutside.Block, DisplayInside.Flow)
      Keyword.Inline => box(DisplayOutside.Inline, DisplayInside.Flow)
      Keyword.InlineBlock => box(DisplayOutside.Inline, DisplayInside.FlowRoot)
      Keyword.FlowRoot => box(DisplayOutside.Block, DisplayInside.FlowRoot)
      Keyword.Flex => box(DisplayOutside.Block, DisplayInside.Flex)
      Keyword.InlineFlex => box(DisplayOutside.Inline, DisplayInside.Flex)
      Keyword.Grid => box(DisplayOutside.Block, DisplayInside.Grid)
      Keyword.InlineGrid => box(DisplayOutside.Inline, DisplayInside.Grid)
      Keyword.GridLanes => box(DisplayOutside.Block, DisplayInside.GridLanes)
      Keyword.InlineGridLanes => box(DisplayOutside.Inline, DisplayInside.GridLanes)
      Keyword.Table => box(DisplayOutside.Block, DisplayInside.Table)
      Keyword.InlineTable => box(DisplayOutside.Inline, DisplayInside.Table)
      Keyword.TableRowGroup => box(DisplayOutside.Block, DisplayInside.TableRowGroup)
      Keyword.TableHeaderGroup => box(DisplayOutside.Block, DisplayInside.TableHeaderGroup)
      Keyword.TableFooterGroup => box(DisplayOutside.Block, DisplayInside.TableFooterGroup)
      Keyword.TableRow => box(DisplayOutside.Block, DisplayInside.TableRow)
      Keyword.TableColumnGroup => box(DisplayOutside.Block, DisplayInside.TableColumnGroup)
      Keyword.TableColumn => box(DisplayOutside.Block, DisplayInside.TableColumn)
      Keyword.TableCell => box(DisplayOutside.Block, DisplayInside.TableCell)
      Keyword.TableCaption => box(DisplayOutside.Block, DisplayInside.TableCaption)
      _ => Option<Display>.None
    }
    _ => Option<Display>.None
  }
}

/// The short keyword form of a computed `display`.
pub fn displayKeyword(value: Display) -> Keyword {
  return match value {
    Display.None => Keyword.None
    Display.Contents => Keyword.Contents
    Display.Box { outside, inside } => match inside {
      DisplayInside.Flow => if outside == DisplayOutside.Block { Keyword.Block } else { Keyword.Inline }
      DisplayInside.FlowRoot => if outside == DisplayOutside.Block { Keyword.FlowRoot } else { Keyword.InlineBlock }
      DisplayInside.Flex => if outside == DisplayOutside.Block { Keyword.Flex } else { Keyword.InlineFlex }
      DisplayInside.Grid => if outside == DisplayOutside.Block { Keyword.Grid } else { Keyword.InlineGrid }
      DisplayInside.GridLanes => if outside == DisplayOutside.Block { Keyword.GridLanes } else { Keyword.InlineGridLanes }
      DisplayInside.Table => if outside == DisplayOutside.Block { Keyword.Table } else { Keyword.InlineTable }
      DisplayInside.TableRowGroup => Keyword.TableRowGroup
      DisplayInside.TableHeaderGroup => Keyword.TableHeaderGroup
      DisplayInside.TableFooterGroup => Keyword.TableFooterGroup
      DisplayInside.TableRow => Keyword.TableRow
      DisplayInside.TableColumnGroup => Keyword.TableColumnGroup
      DisplayInside.TableColumn => Keyword.TableColumn
      DisplayInside.TableCell => Keyword.TableCell
      DisplayInside.TableCaption => Keyword.TableCaption
    }
  }
}

/// The keyword of a computed alignment. `last baseline` is one keyword here.
pub fn alignKeyword(value: Align) -> Keyword {
  return match value {
    Align.Auto => Keyword.Auto
    Align.Normal => Keyword.Normal
    Align.Start => Keyword.Start
    Align.End => Keyword.End
    Align.FlexStart => Keyword.FlexStart
    Align.FlexEnd => Keyword.FlexEnd
    Align.Center => Keyword.Center
    Align.Stretch => Keyword.Stretch
    Align.SpaceBetween => Keyword.SpaceBetween
    Align.SpaceAround => Keyword.SpaceAround
    Align.SpaceEvenly => Keyword.SpaceEvenly
    Align.Baseline => Keyword.Baseline
    Align.LastBaseline => Keyword.LastBaseline
    Align.SelfStart => Keyword.SelfStart
    Align.SelfEnd => Keyword.SelfEnd
    Align.Left => Keyword.Left
    Align.Right => Keyword.Right
  }
}

fn alignOf(value: Keyword) -> Option<Align> {
  return match value {
    Keyword.Auto => Option<Align>.some(Align.Auto)
    Keyword.Normal => Option<Align>.some(Align.Normal)
    Keyword.Start => Option<Align>.some(Align.Start)
    Keyword.End => Option<Align>.some(Align.End)
    Keyword.FlexStart => Option<Align>.some(Align.FlexStart)
    Keyword.FlexEnd => Option<Align>.some(Align.FlexEnd)
    Keyword.Center => Option<Align>.some(Align.Center)
    Keyword.Stretch => Option<Align>.some(Align.Stretch)
    Keyword.SpaceBetween => Option<Align>.some(Align.SpaceBetween)
    Keyword.SpaceAround => Option<Align>.some(Align.SpaceAround)
    Keyword.SpaceEvenly => Option<Align>.some(Align.SpaceEvenly)
    Keyword.Baseline => Option<Align>.some(Align.Baseline)
    Keyword.LastBaseline => Option<Align>.some(Align.LastBaseline)
    Keyword.SelfStart => Option<Align>.some(Align.SelfStart)
    Keyword.SelfEnd => Option<Align>.some(Align.SelfEnd)
    Keyword.Left => Option<Align>.some(Align.Left)
    Keyword.Right => Option<Align>.some(Align.Right)
    _ => Option<Align>.None
  }
}

/// A computed alignment with its overflow safety.
pub struct Alignment {
  pub align: Align,
  pub safety: OverflowAlignment,
}

impl Copy for Alignment {}

/// An alignment value: a keyword, or `safe`/`unsafe` or `first`/`last` before one.
pub fn alignment(value: &Value) -> Option<Alignment> {
  match &value.* {
    Value.Keyword { value: inner } => {
      return match alignOf(inner) {
        Option.Some { value: align } => Option<Alignment>.some(Alignment { align: align, safety: OverflowAlignment.Default })
        Option.None => Option<Alignment>.None
      }
    }
    Value.Sequence { separator: _, values } => {
      let items = values.asSlice()
      if items.length != 2 {
        return Option<Alignment>.None
      }
      let first = match keywordOf(&items[0]) {
        Option.Some { value: found } => found
        Option.None => {
          return Option<Alignment>.None
        }
      }
      let second = match keywordOf(&items[1]) {
        Option.Some { value: found } => found
        Option.None => {
          return Option<Alignment>.None
        }
      }
      if second == Keyword.Baseline && (first == Keyword.First || first == Keyword.Last) {
        let align = if first == Keyword.Last { Align.LastBaseline } else { Align.Baseline }
        return Option<Alignment>.some(Alignment { align: align, safety: OverflowAlignment.Default })
      }
      let safety = if first == Keyword.Safe {
        OverflowAlignment.Safe
      } else if first == Keyword.Unsafe {
        OverflowAlignment.Unsafe
      } else {
        return Option<Alignment>.None
      }
      return match alignOf(second) {
        Option.Some { value: align } => Option<Alignment>.some(Alignment { align: align, safety: safety })
        Option.None => Option<Alignment>.None
      }
    }
    _ => {
      return Option<Alignment>.None
    }
  }
}

/// `scrollbar-gutter`: `auto`, `stable`, or `stable both-edges`.
pub fn scrollbarGutter(value: &Value) -> Option<ScrollbarGutter> {
  match &value.* {
    Value.Keyword { value: inner } => {
      if inner == Keyword.Auto {
        return Option<ScrollbarGutter>.some(ScrollbarGutter.Auto)
      }
      if inner == Keyword.Stable {
        return Option<ScrollbarGutter>.some(ScrollbarGutter.Stable)
      }
    }
    Value.Sequence { separator: _, values } => {
      let items = values.asSlice()
      if items.length == 2 && isKeyword(&items[0], Keyword.Stable) && isKeyword(&items[1], Keyword.BothEdges) {
        return Option<ScrollbarGutter>.some(ScrollbarGutter.StableBothEdges)
      }
    }
    _ => {}
  }
  return Option<ScrollbarGutter>.None
}

/// `line-height`: `normal`, a number, or a length. A percentage is that fraction of the
/// font size.
pub fn lineHeight(value: &Value, context: &Context) -> Option<LineHeight> {
  match &value.* {
    Value.Keyword { value: inner } => {
      if inner == Keyword.Normal {
        return Option<LineHeight>.some(LineHeight.Normal)
      }
      return Option<LineHeight>.None
    }
    Value.Unit { value: amount, unit } => {
      if unit == Unit.Percent {
        return Option<LineHeight>.some(LineHeight.Length { value: context.fontSize * amount / 100.0 })
      }
    }
    _ => {}
  }
  let reduced = linear(value, context)
  if !reduced.valid || reduced.percent != 0.0 {
    return Option<LineHeight>.None
  }
  if reduced.scalar {
    return Option<LineHeight>.some(LineHeight.Number { value: reduced.pixels })
  }
  return Option<LineHeight>.some(LineHeight.Length { value: reduced.pixels })
}

/// `tab-size`: a number of spaces or a length.
pub fn tabSize(value: &Value, context: &Context) -> Option<TabSize> {
  let reduced = linear(value, context)
  if !reduced.valid || reduced.percent != 0.0 {
    return Option<TabSize>.None
  }
  if reduced.scalar {
    return Option<TabSize>.some(TabSize.Number { value: reduced.pixels })
  }
  return Option<TabSize>.some(TabSize.Length { value: reduced.pixels })
}

/// `vertical-align`: a keyword, or a length or percentage shift.
pub fn verticalAlign(value: &Value, context: &Context) -> Option<VerticalAlign> {
  let zero = Dimension.px(0.0)
  match &value.* {
    Value.Keyword { value: inner } => {
      let kind = match inner {
        Keyword.Baseline => VerticalAlignKind.Baseline
        Keyword.Middle => VerticalAlignKind.Middle
        Keyword.TextTop => VerticalAlignKind.TextTop
        Keyword.TextBottom => VerticalAlignKind.TextBottom
        Keyword.Top => VerticalAlignKind.Top
        Keyword.Bottom => VerticalAlignKind.Bottom
        Keyword.Sub => VerticalAlignKind.Sub
        Keyword.Super => VerticalAlignKind.Super
        _ => {
          return Option<VerticalAlign>.None
        }
      }
      return Option<VerticalAlign>.some(VerticalAlign { kind: kind, shift: zero })
    }
    _ => {}
  }
  return match dimension(value, context) {
    Option.Some { value: shift } => Option<VerticalAlign>.some(VerticalAlign { kind: VerticalAlignKind.Shift, shift: shift })
    Option.None => Option<VerticalAlign>.None
  }
}

/// `text-indent`: a length or percentage, optionally followed by `hanging` and `each-line`.
pub fn textIndent(value: &Value, context: &Context) -> Option<TextIndent> {
  match &value.* {
    Value.Sequence { separator: _, values } => {
      let items = values.asSlice()
      if items.length == 0 {
        return Option<TextIndent>.None
      }
      let amount = match dimension(&items[0], context) {
        Option.Some { value: found } => found
        Option.None => {
          return Option<TextIndent>.None
        }
      }
      let mut out = TextIndent { value: amount, hanging: false, eachLine: false }
      let mut i: usize = 1
      while i < items.length {
        if isKeyword(&items[i], Keyword.Hanging) {
          out.hanging = true
        } else if isKeyword(&items[i], Keyword.EachLine) {
          out.eachLine = true
        } else {
          return Option<TextIndent>.None
        }
        i = i + 1
      }
      return Option<TextIndent>.some(out)
    }
    _ => {}
  }
  return match dimension(value, context) {
    Option.Some { value: amount } => Option<TextIndent>.some(TextIndent { value: amount, hanging: false, eachLine: false })
    Option.None => Option<TextIndent>.None
  }
}

fn addLine(line: &mut DecorationLine, word: Keyword) -> bool {
  if word == Keyword.Underline {
    line.underline = true
    return true
  }
  if word == Keyword.Overline {
    line.overline = true
    return true
  }
  if word == Keyword.LineThrough {
    line.lineThrough = true
    return true
  }
  return false
}

/// `text-decoration-line`: `none` or any of `underline`, `overline`, `line-through`.
pub fn decorationLine(value: &Value) -> Option<DecorationLine> {
  let mut line = DecorationLine.none()
  match &value.* {
    Value.Keyword { value: inner } => {
      if inner == Keyword.None || addLine(&mut line, inner) {
        return Option<DecorationLine>.some(line)
      }
    }
    Value.Sequence { separator: _, values } => {
      let items = values.asSlice()
      let mut i: usize = 0
      while i < items.length {
        let word = match keywordOf(&items[i]) {
          Option.Some { value: found } => found
          Option.None => {
            return Option<DecorationLine>.None
          }
        }
        if !addLine(&mut line, word) {
          return Option<DecorationLine>.None
        }
        i = i + 1
      }
      if items.length > 0 {
        return Option<DecorationLine>.some(line)
      }
    }
    _ => {}
  }
  return Option<DecorationLine>.None
}

/// One `box-shadow`: two to four lengths (offset x, offset y, blur, spread), a color and
/// `inset`, in any order. `none` is not a shadow and gives `None`.
pub fn boxShadow(value: &Value, context: &Context) -> Option<BoxShadow> {
  match &value.* {
    Value.Sequence { separator: _, values } => {
      let items = values.asSlice()
      let mut lengths: [f32; 4] = [0.0; 4]
      let mut count: usize = 0
      let mut shadow = BoxShadow {
        offsetX: 0.0,
        offsetY: 0.0,
        blur: 0.0,
        spread: 0.0,
        color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
        inset: false,
      }
      let mut i: usize = 0
      while i < items.length {
        if isKeyword(&items[i], Keyword.Inset) {
          shadow.inset = true
        } else {
          match color(&items[i]) {
            Option.Some { value: found } => {
              shadow.color = found
            }
            Option.None => {
              match length(&items[i], context) {
                Option.Some { value: found } => {
                  if count == 4 {
                    return Option<BoxShadow>.None
                  }
                  lengths[count] = found
                  count = count + 1
                }
                Option.None => {
                  return Option<BoxShadow>.None
                }
              }
            }
          }
        }
        i = i + 1
      }
      if count < 2 {
        return Option<BoxShadow>.None
      }
      shadow.offsetX = lengths[0]
      shadow.offsetY = lengths[1]
      shadow.blur = lengths[2]
      shadow.spread = lengths[3]
      return Option<BoxShadow>.some(shadow)
    }
    _ => {
      return Option<BoxShadow>.None
    }
  }
}

/// A background: a color, `none`, or `linear-gradient(<angle>, <color>, <color>)`.
pub fn fill(value: &Value) -> Option<Fill> {
  match &value.* {
    Value.Keyword { value: inner } => {
      if inner == Keyword.None {
        return Option<Fill>.some(Fill.None)
      }
    }
    Value.Function { name, values } => {
      let items = values.asSlice()
      if name == Keyword.LinearGradient && items.length == 3 {
        let angle = match &items[0] {
          Value.Unit { value: amount, unit } => match unit {
            Unit.Deg => amount
            Unit.Grad => amount * 0.9
            Unit.Rad => amount * 57.29578
            Unit.Turn => amount * 360.0
            _ => {
              return Option<Fill>.None
            }
          }
          _ => {
            return Option<Fill>.None
          }
        }
        let from = match color(&items[1]) {
          Option.Some { value: found } => found
          Option.None => {
            return Option<Fill>.None
          }
        }
        let to = match color(&items[2]) {
          Option.Some { value: found } => found
          Option.None => {
            return Option<Fill>.None
          }
        }
        return Option<Fill>.some(Fill.Gradient { angle: angle, from: from, to: to })
      }
      return Option<Fill>.None
    }
    _ => {}
  }
  return match color(value) {
    Option.Some { value: found } => Option<Fill>.some(Fill.Solid { color: found })
    Option.None => Option<Fill>.None
  }
}

/// `backdrop-filter` as a blur radius: `none` is zero and `blur(<length>)` its length.
pub fn blur(value: &Value, context: &Context) -> Option<f32> {
  match &value.* {
    Value.Keyword { value: inner } => {
      if inner == Keyword.None {
        return Option<f32>.some(0.0)
      }
    }
    Value.Function { name, values } => {
      let items = values.asSlice()
      if name == Keyword.Blur && items.length == 1 {
        return length(&items[0], context)
      }
    }
    _ => {}
  }
  return Option<f32>.None
}

/// The two components of a pair such as `object-position`. A single value gives it twice.
pub struct Pair {
  pub first: Dimension,
  pub second: Dimension,
}

impl Copy for Pair {}

pub fn pair(value: &Value, context: &Context) -> Option<Pair> {
  match &value.* {
    Value.Sequence { separator: _, values } => {
      let items = values.asSlice()
      if items.length != 2 {
        return Option<Pair>.None
      }
      let first = match dimension(&items[0], context) {
        Option.Some { value: found } => found
        Option.None => {
          return Option<Pair>.None
        }
      }
      return match dimension(&items[1], context) {
        Option.Some { value: second } => Option<Pair>.some(Pair { first: first, second: second })
        Option.None => Option<Pair>.None
      }
    }
    _ => {}
  }
  return match dimension(value, context) {
    Option.Some { value: found } => Option<Pair>.some(Pair { first: found, second: found })
    Option.None => Option<Pair>.None
  }
}

/// The words of a `text-box*` value, as codes: 1 text, 2 cap, 3 ex, 4 alphabetic, 5 auto,
/// 6 none, 7 normal, 8 trim-start, 9 trim-end, 10 trim-both; 0 for any other word.
struct BoxWords { codes: [u8; 4], count: usize }
impl Copy for BoxWords {}

fn boxWord(word: &[u8]) -> u8 {
  if equalsIgnoringCase(word, b"text") { return 1 }
  if equalsIgnoringCase(word, b"cap") { return 2 }
  if equalsIgnoringCase(word, b"ex") { return 3 }
  if equalsIgnoringCase(word, b"alphabetic") { return 4 }
  if equalsIgnoringCase(word, b"auto") { return 5 }
  if equalsIgnoringCase(word, b"none") { return 6 }
  if equalsIgnoringCase(word, b"normal") { return 7 }
  if equalsIgnoringCase(word, b"trim-start") { return 8 }
  if equalsIgnoringCase(word, b"trim-end") { return 9 }
  if equalsIgnoringCase(word, b"trim-both") { return 10 }
  return 0
}

fn equalsIgnoringCase(word: &[u8], name: &[u8]) -> bool {
  if word.length != name.length { return false }
  let mut i: usize = 0
  while i < word.length {
    let c = word[i]
    let lower = if c >= 65 && c <= 90 { c + 32 } else { c }
    if lower != name[i] { return false }
    i = i + 1
  }
  return true
}

fn pushWord(words: &mut BoxWords, code: u8) {
  if words.count < 4 { words.codes[words.count] = code }
  words.count = words.count + 1
}

fn collectWords(value: &Value, words: &mut BoxWords) {
  match &value.* {
    Value.Keyword { value: word } => pushWord(&mut words.*, boxWord(keywords.name(word)))
    Value.Sequence { separator: _, values } => {
      let items = values.asSlice()
      let mut i: usize = 0
      while i < items.length {
        collectWords(&items[i], &mut words.*)
        i = i + 1
      }
    }
    Value.Text { css } => {
      let text = css.asSlice()
      let mut at: usize = 0
      while at < text.length {
        while at < text.length && (text[at] == 32 || text[at] == 9 || text[at] == 10 || text[at] == 13 || text[at] == 12) { at = at + 1 }
        if at == text.length { break }
        let start = at
        while at < text.length && text[at] != 32 && text[at] != 9 && text[at] != 10 && text[at] != 13 && text[at] != 12 { at = at + 1 }
        pushWord(&mut words.*, boxWord(Slice.view(text, start, at - start)))
      }
    }
    _ => pushWord(&mut words.*, 0)
  }
}

fn wordsOf(value: &Value) -> BoxWords {
  let mut words = BoxWords { codes: [0; 4], count: 0 }
  collectWords(value, &mut words)
  return words
}

fn trimOf(code: u8) -> Option<TextBoxTrim> {
  return match code {
    6 => Option<TextBoxTrim>.some(TextBoxTrim.None)
    8 => Option<TextBoxTrim>.some(TextBoxTrim.Start)
    9 => Option<TextBoxTrim>.some(TextBoxTrim.End)
    10 => Option<TextBoxTrim>.some(TextBoxTrim.Both)
    _ => Option<TextBoxTrim>.None
  }
}

fn overOf(code: u8) -> Option<TextEdge> {
  return match code {
    1 => Option<TextEdge>.some(TextEdge.Text)
    2 => Option<TextEdge>.some(TextEdge.Cap)
    3 => Option<TextEdge>.some(TextEdge.Ex)
    _ => Option<TextEdge>.None
  }
}

/// `auto | [ text | cap | ex ] [ text | alphabetic ]?` from `codes[start..end)`; one value
/// gives the under edge `text`.
fn edgeOf(codes: &[u8]) -> Option<TextBoxEdge> {
  if codes.length == 1 && codes[0] == 5 { return Option<TextBoxEdge>.some(TextBoxEdge.auto()) }
  if codes.length == 0 || codes.length > 2 { return Option<TextBoxEdge>.None }
  let over = match overOf(codes[0]) {
    Option.Some { value } => value
    Option.None => { return Option<TextBoxEdge>.None }
  }
  if codes.length == 1 { return Option<TextBoxEdge>.some(TextBoxEdge { over: over, under: TextEdge.Text }) }
  let under = match codes[1] {
    1 => TextEdge.Text
    4 => TextEdge.Alphabetic
    _ => { return Option<TextBoxEdge>.None }
  }
  return Option<TextBoxEdge>.some(TextBoxEdge { over: over, under: under })
}

/// `text-box-trim: none | trim-start | trim-end | trim-both`.
pub fn textBoxTrim(value: &Value) -> Option<TextBoxTrim> {
  let words = wordsOf(value)
  if words.count != 1 { return Option<TextBoxTrim>.None }
  return trimOf(words.codes[0])
}

/// `text-box-edge: auto | [ text | cap | ex ] [ text | alphabetic ]?`.
pub fn textBoxEdge(value: &Value) -> Option<TextBoxEdge> {
  let words = wordsOf(value)
  if words.count > 2 { return Option<TextBoxEdge>.None }
  return edgeOf(Slice.view(&words.codes, 0, words.count))
}

/// `text-box`, the shorthand: `normal | <'text-box-trim'> || <'text-box-edge'>`. An omitted
/// trim is `trim-both`, an omitted edge `auto`.
pub struct TextBox { pub trim: TextBoxTrim, pub edge: TextBoxEdge }
impl Copy for TextBox {}

pub fn textBox(value: &Value) -> Option<TextBox> {
  let words = wordsOf(value)
  if words.count == 0 || words.count > 3 { return Option<TextBox>.None }
  let codes = Slice.view(&words.codes, 0, words.count)
  if codes.length == 1 && codes[0] == 7 { return Option<TextBox>.some(TextBox { trim: TextBoxTrim.None, edge: TextBoxEdge.auto() }) }
  // The trim comes first or last; whatever is left is the edge.
  let mut trim = TextBoxTrim.Both
  let mut start: usize = 0
  let mut end = codes.length
  match trimOf(codes[0]) {
    Option.Some { value: found } => {
      trim = found
      start = 1
    }
    Option.None => match trimOf(codes[end - 1]) {
      Option.Some { value: found } => {
        trim = found
        end = end - 1
      }
      Option.None => {}
    }
  }
  if start == end { return Option<TextBox>.some(TextBox { trim: trim, edge: TextBoxEdge.auto() }) }
  return match edgeOf(Slice.view(codes, start, end - start)) {
    Option.Some { value: edge } => Option<TextBox>.some(TextBox { trim: trim, edge: edge })
    Option.None => Option<TextBox>.None
  }
}

//! Keyword forms of the computed keyword enums. Generated tables: one pair per enum.
import computed {
  BoxSizing,
  Direction,
  UnicodeBidi,
  WritingMode,
  TextOrientation,
  FlexDirection,
  FlexWrap,
  Overflow,
  ScrollbarWidth,
  Position,
  Float,
  Clear,
  Visibility,
  BaselineSource,
  TextAlign,
  TextJustify,
  TextWrap,
  WhiteSpaceCollapse,
  BoxDecorationBreak,
  MarginBreak,
  BreakBetween,
  BreakInside,
  ObjectFit,
  BorderStyle,
  FontStyle,
  WhiteSpace,
  FillRule,
  LineCap,
  LineJoin,
  BlendMode,
}
import keywords { Keyword }
import silk.core.option { Option }

/// The keyword of a computed `BoxSizing`.
pub fn boxSizingKeyword(value: BoxSizing) -> Keyword {
  return match value {
    BoxSizing.ContentBox => Keyword.ContentBox
    BoxSizing.BorderBox => Keyword.BorderBox
  }
}

/// The computed `BoxSizing` a keyword names, if it names one.
pub fn boxSizingOf(value: Keyword) -> Option<BoxSizing> {
  return match value {
    Keyword.ContentBox => Option<BoxSizing>.some(BoxSizing.ContentBox)
    Keyword.BorderBox => Option<BoxSizing>.some(BoxSizing.BorderBox)
    _ => Option<BoxSizing>.None
  }
}


    Keyword.Difference => Option<BlendMode>.some(BlendMode.Difference)
    Keyword.Exclusion => Option<BlendMode>.some(BlendMode.Exclusion)
    Keyword.Hue => Option<BlendMode>.some(BlendMode.Hue)
    Keyword.Saturation => Option<BlendMode>.some(BlendMode.Saturation)
    Keyword.Color => Option<BlendMode>.some(BlendMode.Color)
    Keyword.Luminosity => Option<BlendMode>.some(BlendMode.Luminosity)
    _ => Option<BlendMode>.None
  }
}

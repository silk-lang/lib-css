        return Option<Keyword>.some(Keyword.Dashed)
      }
      if first == 105 && insensitive(name, b"italic") {
        return Option<Keyword>.some(Keyword.Italic)
      }
      if first == 105 && insensitive(name, b"inline") {
        return Option<Keyword>.some(Keyword.Inline)
      }

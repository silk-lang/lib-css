        return Option<Keyword>.some(Keyword.Double)
      }
      if first == 103 && insensitive(name, b"groove") {
        return Option<Keyword>.some(Keyword.Groove)
      }
      if first == 111 && insensitive(name, b"outset") {
        return Option<Keyword>.some(Keyword.Outset)
      }
      if first == 98 && insensitive(name, b"bolder") {
        return Option<Keyword>.some(Keyword.Bolder)
      }
      if first == 109 && insensitive(name, b"medium") {
        return Option<Keyword>.some(Keyword.Medium)
      }

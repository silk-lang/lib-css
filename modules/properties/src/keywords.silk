    Keyword.Fixed => b"fixed"
    Keyword.Sticky => b"sticky"
    Keyword.Left => b"left"
    Keyword.Right => b"right"
    Keyword.Both => b"both"
    Keyword.Collapse => b"collapse"
    Keyword.First => b"first"
    Keyword.Last => b"last"
    Keyword.Start => b"start"
    Keyword.End => b"end"
    Keyword.Center => b"center"
    Keyword.Justify => b"justify"
    Keyword.InterWord => b"inter-word"
    Keyword.InterCharacter => b"inter-character"
    Keyword.Discard => b"discard"
    Keyword.Preserve => b"preserve"
    Keyword.PreserveBreaks => b"preserve-breaks"
    Keyword.PreserveSpaces => b"preserve-spaces"
    Keyword.BreakSpaces => b"break-spaces"
    Keyword.Slice => b"slice"

        return Option<Keyword>.some(Keyword.SpaceAround)
      }
      if first == 115 && insensitive(name, b"space-evenly") {
        return Option<Keyword>.some(Keyword.SpaceEvenly)
      }
      if first == 108 && insensitive(name, b"line-through") {
        return Option<Keyword>.some(Keyword.LineThrough)
      }
      if first == 99 && insensitive(name, b"currentcolor") {
        return Option<Keyword>.some(Keyword.Currentcolor)
      }
    }
    13 => {
      if first == 98 && insensitive(name, b"bidi-override") {
        return Option<Keyword>.some(Keyword.BidiOverride)
      }
      if first == 104 && insensitive(name, b"horizontal-tb") {
        return Option<Keyword>.some(Keyword.HorizontalTb)
      }
      if first == 115 && insensitive(name, b"space-between") {
        return Option<Keyword>.some(Keyword.SpaceBetween)
      }
      if first == 108 && insensitive(name, b"last baseline") {
        return Option<Keyword>.some(Keyword.LastBaseline)
      }
    }
    14 => {
      if first == 99 && insensitive(name, b"column-reverse") {
        return Option<Keyword>.some(Keyword.ColumnReverse)
      }
    }
    15 => {
      if first == 105 && insensitive(name, b"inter-character") {
        return Option<Keyword>.some(Keyword.InterCharacter)
      }
      if first == 112 && insensitive(name, b"preserve-breaks") {
        return Option<Keyword>.some(Keyword.PreserveBreaks)
      }
      if first == 112 && insensitive(name, b"preserve-spaces") {
        return Option<Keyword>.some(Keyword.PreserveSpaces)
      }
      if first == 108 && insensitive(name, b"linear-gradient") {
        return Option<Keyword>.some(Keyword.LinearGradient)
      }
    }
    16 => {
      if first == 105 && insensitive(name, b"isolate-override") {
        return Option<Keyword>.some(Keyword.IsolateOverride)
      }
    }
    _ => {}
  }
  return Option<Keyword>.None
}

fn insensitive(a: &[u8], b: &[u8]) -> bool {
  let mut i: usize = 0
  while i < a.length {
    let x = if a[i] >= 65 && a[i] <= 90 {
      a[i] + 32
    } else {
      a[i]
    }
    if x != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

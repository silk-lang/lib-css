fn insensitive(a: &[u8], b: &[u8]) -> bool {
  let mut i: usize = 0
  while i < a.length {
    let x = if a[i] >= 65 && a[i] <= 90 {
      a[i] + 32
    } else {
      a[i]
    }
    if x != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

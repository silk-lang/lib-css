//! CSS keywords as plain data: the identifiers the catalog's properties take as values.
import silk.core.option { Option }

/// A CSS keyword. `name` gives its CSS spelling and `lookup` finds one by it.
pub enum(u16) Keyword {
  Initial,
  Inherit,
  Unset,
  Revert,
  RevertLayer,
  Auto,
  None,
  Normal,
  ContentBox,
  BorderBox,
  Ltr,
  Rtl,
  Embed,
  Isolate,
  BidiOverride,
  IsolateOverride,
  Plaintext,
  HorizontalTb,
  VerticalRl,
  VerticalLr,
  SidewaysRl,
  SidewaysLr,
  Mixed,
  Upright,
  Sideways,
  Row,
  RowReverse,
  Column,
  ColumnReverse,
  Nowrap,
  Wrap,
  WrapReverse,
  Visible,
  Clip,
  Hidden,
  Scroll,
  Thin,
  Static,
  Relative,
  Absolute,
  Fixed,
  Sticky,
  Left,
  Right,
  Both,
  Collapse,
  First,
  Last,
  Start,
  End,
  Center,
  Justify,
  InterWord,
  InterCharacter,
  Discard,
  Preserve,
  PreserveBreaks,
  PreserveSpaces,
  BreakSpaces,
  Slice,
  Clone,
  Keep,
  Avoid,
  Always,
  All,
  AvoidPage,
  Page,
  Recto,
  Verso,
  AvoidColumn,
  AvoidRegion,
  Region,
  Fill,
  Contain,
  Cover,
  ScaleDown,
  Solid,
  Dashed,
  Italic,
  Pre,
  PreWrap,
  PreLine,
  Block,
  Inline,
  InlineBlock,
  Flex,
  InlineFlex,
  Flow,
  FlowRoot,
  Grid,
  InlineGrid,
  Contents,
  MinContent,
  MaxContent,
  FitContent,
  Content,
  FlexStart,
  FlexEnd,
  Stretch,
  SpaceBetween,
  SpaceAround,
  SpaceEvenly,
  Baseline,
  SelfStart,
  SelfEnd,
  Safe,
  Unsafe,
  Legacy,
  BothEdges,
  Middle,
  TextTop,
  TextBottom,
  Top,
  Bottom,
  Sub,
  Super,
  Hanging,
  EachLine,
  Dotted,
  Double,
  Groove,
  Ridge,
  Inset,
  Outset,
  Oblique,
  Bold,
  Bolder,
  Lighter,
  Underline,
  Overline,
  LineThrough,
  Wavy,
  Transparent,
  Currentcolor,
  Medium,
  Thick,
  Dense,
  Repeat,
  NoRepeat,
  PaddingBox,
  Stable,
  LinearGradient,
  Blur,
  LastBaseline,
}

pub const COUNT: usize = 144

/// The CSS spelling, lowercase.
pub fn name(value: Keyword) -> &'static [u8] {
  return match value {
    Keyword.Initial => b"initial"
    Keyword.Inherit => b"inherit"
    Keyword.Unset => b"unset"
    Keyword.Revert => b"revert"
    Keyword.RevertLayer => b"revert-layer"
    Keyword.Auto => b"auto"
    Keyword.None => b"none"
    Keyword.Normal => b"normal"
    Keyword.ContentBox => b"content-box"
    Keyword.BorderBox => b"border-box"
    Keyword.Ltr => b"ltr"
    Keyword.Rtl => b"rtl"
    Keyword.Embed => b"embed"
    Keyword.Isolate => b"isolate"
    Keyword.BidiOverride => b"bidi-override"
    Keyword.IsolateOverride => b"isolate-override"
    Keyword.Plaintext => b"plaintext"
    Keyword.HorizontalTb => b"horizontal-tb"
    Keyword.VerticalRl => b"vertical-rl"
    Keyword.VerticalLr => b"vertical-lr"
    Keyword.SidewaysRl => b"sideways-rl"
    Keyword.SidewaysLr => b"sideways-lr"
    Keyword.Mixed => b"mixed"
    Keyword.Upright => b"upright"
    Keyword.Sideways => b"sideways"
    Keyword.Row => b"row"
    Keyword.RowReverse => b"row-reverse"
    Keyword.Column => b"column"
    Keyword.ColumnReverse => b"column-reverse"
    Keyword.Nowrap => b"nowrap"
    Keyword.Wrap => b"wrap"

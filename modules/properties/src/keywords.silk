      if first == 105 && insensitive(name, b"initial") {
        return Option<Keyword>.some(Keyword.Initial)
      }
      if first == 105 && insensitive(name, b"inherit") {
        return Option<Keyword>.some(Keyword.Inherit)
      }
      if first == 105 && insensitive(name, b"isolate") {
        return Option<Keyword>.some(Keyword.Isolate)
      }
      if first == 117 && insensitive(name, b"upright") {
        return Option<Keyword>.some(Keyword.Upright)
      }
      if first == 118 && insensitive(name, b"visible") {
        return Option<Keyword>.some(Keyword.Visible)
      }
      if first == 106 && insensitive(name, b"justify") {
        return Option<Keyword>.some(Keyword.Justify)
      }
      if first == 100 && insensitive(name, b"discard") {
        return Option<Keyword>.some(Keyword.Discard)
      }
      if first == 99 && insensitive(name, b"contain") {
        return Option<Keyword>.some(Keyword.Contain)
      }
      if first == 99 && insensitive(name, b"content") {
        return Option<Keyword>.some(Keyword.Content)
      }
      if first == 115 && insensitive(name, b"stretch") {
        return Option<Keyword>.some(Keyword.Stretch)
      }
      if first == 104 && insensitive(name, b"hanging") {
        return Option<Keyword>.some(Keyword.Hanging)

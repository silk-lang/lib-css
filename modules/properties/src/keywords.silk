/// The keyword spelled `name`, compared ASCII case-insensitively.
pub fn lookup(name: &[u8]) -> Option<Keyword> {
  if name.length == 0 {
    return Option<Keyword>.None
  }
  let first = name[0] | 32
  match name.length {
    1 => {
      if first == 120 && insensitive(name, b"x") {
        return Option<Keyword>.some(Keyword.X)
      }
      if first == 121 && insensitive(name, b"y") {
        return Option<Keyword>.some(Keyword.Y)
      }
    }
    2 => {
      if first == 108 && insensitive(name, b"lr") {
        return Option<Keyword>.some(Keyword.Lr)
      }
      if first == 114 && insensitive(name, b"rl") {
        return Option<Keyword>.some(Keyword.Rl)
      }
      if first == 116 && insensitive(name, b"tb") {
        return Option<Keyword>.some(Keyword.Tb)
      }
    }
    3 => {
      if first == 108 && insensitive(name, b"ltr") {
        return Option<Keyword>.some(Keyword.Ltr)
      }
      if first == 114 && insensitive(name, b"rtl") {
        return Option<Keyword>.some(Keyword.Rtl)
      }
      if first == 114 && insensitive(name, b"row") {
        return Option<Keyword>.some(Keyword.Row)
      }
      if first == 101 && insensitive(name, b"end") {
        return Option<Keyword>.some(Keyword.End)
      }
      if first == 97 && insensitive(name, b"all") {
        return Option<Keyword>.some(Keyword.All)
      }
      if first == 112 && insensitive(name, b"pre") {
        return Option<Keyword>.some(Keyword.Pre)
      }
      if first == 116 && insensitive(name, b"top") {
        return Option<Keyword>.some(Keyword.Top)
      }
      if first == 115 && insensitive(name, b"sub") {
        return Option<Keyword>.some(Keyword.Sub)
      }
      if first == 104 && insensitive(name, b"hue") {
        return Option<Keyword>.some(Keyword.Hue)
      }
    }
    4 => {
      if first == 97 && insensitive(name, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if first == 110 && insensitive(name, b"none") {
        return Option<Keyword>.some(Keyword.None)
      }
      if first == 119 && insensitive(name, b"wrap") {
        return Option<Keyword>.some(Keyword.Wrap)
      }
      if first == 99 && insensitive(name, b"clip") {
        return Option<Keyword>.some(Keyword.Clip)
      }
      if first == 116 && insensitive(name, b"thin") {
        return Option<Keyword>.some(Keyword.Thin)
      }
      if first == 108 && insensitive(name, b"left") {
        return Option<Keyword>.some(Keyword.Left)
      }
      if first == 98 && insensitive(name, b"both") {
        return Option<Keyword>.some(Keyword.Both)
      }
      if first == 108 && insensitive(name, b"last") {
        return Option<Keyword>.some(Keyword.Last)
      }
      if first == 107 && insensitive(name, b"keep") {
        return Option<Keyword>.some(Keyword.Keep)
      }
      if first == 112 && insensitive(name, b"page") {
        return Option<Keyword>.some(Keyword.Page)
      }
      if first == 102 && insensitive(name, b"fill") {
        return Option<Keyword>.some(Keyword.Fill)
      }
      if first == 102 && insensitive(name, b"flex") {
        return Option<Keyword>.some(Keyword.Flex)
      }
      if first == 102 && insensitive(name, b"flow") {
        return Option<Keyword>.some(Keyword.Flow)
      }
      if first == 103 && insensitive(name, b"grid") {
        return Option<Keyword>.some(Keyword.Grid)
      }
      if first == 115 && insensitive(name, b"safe") {
        return Option<Keyword>.some(Keyword.Safe)
      }
      if first == 98 && insensitive(name, b"bold") {
        return Option<Keyword>.some(Keyword.Bold)
      }
      if first == 119 && insensitive(name, b"wavy") {
        return Option<Keyword>.some(Keyword.Wavy)
      }
      if first == 98 && insensitive(name, b"blur") {
        return Option<Keyword>.some(Keyword.Blur)
      }
      if first == 115 && insensitive(name, b"srgb") {
        return Option<Keyword>.some(Keyword.SRGB)
      }

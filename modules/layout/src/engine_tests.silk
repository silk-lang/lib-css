test effect fn sourceBoundsUnionsLineExtentsButNotPointsWhenAreaExists()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(40.0)
  style.height = SizeValue.px(10.0)
  let tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let box = output.firstBySource.get(root.index)
  let mut continuation = Fragment.make(box, root.index, FragmentKind.Box)
  continuation.location.x = 50.0
  continuation.location.y = 20.0
  continuation.size.height = 15.0
  drop run output.fragments.append(continuation) |> Effect.provideMut<Allocator>(&mut allocator)
  continuation.location.x = 200.0
  continuation.location.y = 100.0
  continuation.size.height = 0.0
  drop run output.fragments.append(continuation) |> Effect.provideMut<Allocator>(&mut allocator)
  output.fragments.resolveLocations()
  let bounds = run output.sourceBounds(root)
  run Testing.expect(
    bounds.x == 0.0 && bounds.y == 0.0 && bounds.width == 50.0 && bounds.height == 35.0,
    "CSSOM View bounding-box step 4 includes rectangles with nonzero height or width, not zero-by-zero points",
  )
}

test effect fn blockInterruptionKeepsGeometryWithoutClonedPaintOrOverflow()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut rootStyle = Style.make()
  rootStyle.width = SizeValue.px(100.0)
  let mut tree = run Tree.make(move rootStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut inlineStyle = Style.make()
  inlineStyle.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
  inlineStyle.boxDecorationBreak = BoxDecorationBreak.Clone
  inlineStyle.border = Edges.all(Dimension.px(2.0))
  let inline = run tree.append(root, move inlineStyle)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut firstStyle = Style.make()
  firstStyle.width = SizeValue.px(5.0)
  firstStyle.height = SizeValue.px(15.0)
  drop run tree.append(inline, move firstStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lastStyle = Style.make()
  lastStyle.width = SizeValue.px(10.0)
  lastStyle.height = SizeValue.px(20.0)
  drop run tree.append(inline, move lastStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fragments = output.fragments.values.asSlice()
  let mut interruptions: usize = 0
  let mut painted: usize = 0
  let mut index: usize = 0
  while index < fragments.length {
    let fragment = &fragments[index]
    if fragment.source == inline.index && fragment.kind == FragmentKind.Inline {
      if fragment.nonpainting {
        interruptions = interruptions + 1
        run Testing.expect(
          fragment.size.width == 100.0 && fragment.size.height == 35.0,
          "interruption geometry spans consecutive blocks and the containing inline extent",
        )
        run Testing.expect(
          fragment.decorationEdges == 0 && !fragment.first && !fragment.last,
          "clone must not paint interruption edges",
        )
        run Testing.expect(
          fragment.layoutBounds.width == 0.0 && fragment.layoutBounds.height == 0.0
            && fragment.scrollableOverflow.width == 0.0
            && fragment.scrollableOverflow.height == 0.0,
          "nonpainting interruption geometry must not add layout or scrollable overflow",
        )
      } else {
        painted = painted + 1
        run Testing.expect(
          fragment.decorationEdges != 0,
          "real surrounding inline fragments keep their decorations",
        )
      }
    }
    index = index + 1
  }
  run Testing.expect(
    interruptions == 1 && painted == 2,
    "one nonpainting interruption separates the two real inline continuations",
  )
}

test effect fn keptSizesSurviveUntilTheirSourcesChange()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.width = SizeValue.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let first = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let third = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(first, 0)
  run tree.setMeasurement(third, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let probes = output.stats.sizeProbes
  run Testing.expect(
    probes > 0 && output.boxes.get(output.firstBySource.get(third.index)).location.x == 60.0,
    "flex items are sized by probes",
  )
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.stats.sizeProbes == 0 && output.stats.fullLayouts == 0,
    "an unchanged tree reuses every kept result",
  )
  let mut wide = Style.make()
  wide.width = SizeValue.px(100.0)
  run tree.setStyle(second, move wide)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.stats.sizeProbes < probes
      && output.boxes.get(output.firstBySource.get(third.index)).location.x == 160.0,
    "a style change recomputes its box and ancestors and moves later siblings",
  )
  content.maximum = 80.0
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.boxes.get(output.firstBySource.get(third.index)).location.x == 160.0,
    "provider changes are invisible until the caller reports them",
  )
  output.invalidate()
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.boxes.get(output.firstBySource.get(third.index)).location.x == 180.0
      && output.stats.cacheHits == 0,
    "invalidate discards every kept result",
  )
  output.invalidate()
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.boxes.get(output.firstBySource.get(third.index)).location.x == 180.0
      && output.stats.cacheHits == 0,
    "an invalidated unchanged tree lays out its kept boxes afresh",
  )
  output.invalidate()
  let mut narrow = Style.make()
  narrow.width = SizeValue.px(40.0)
  run tree.setStyle(second, move narrow)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.boxes.get(output.firstBySource.get(third.index)).location.x == 120.0
      && output.stats.cacheHits == 0,
    "a change after invalidate rebuilds the boxes",
  )
}

test effect fn settingAnUnchangedStyleKeepsTheNodeClean()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.width = SizeValue.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut wide = Style.make()
  wide.width = SizeValue.px(100.0)
  let first = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.append(root, move wide) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(first, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.stats.fullLayouts > 0, "the first compute lays the tree out")
  let mut same = Style.make()
  same.width = SizeValue.px(100.0)
  run tree.setStyle(second, move same)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.stats.passes == 0 && output.stats.sizeProbes == 0 && output.stats.fullLayouts == 0,
    "setting an equal style does not dirty the node",
  )
  let mut wider = Style.make()
  wider.width = SizeValue.px(120.0)
  run tree.setStyle(second, move wider)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.stats.fullLayouts > 0
      && output.boxes.get(output.firstBySource.get(second.index)).size.width == 120.0,
    "a changed style still lays the node out again",
  )
}

test effect fn cleanSubtreesAreCopiedNotLaidOut()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.width = SizeValue.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut panelStyle = Style.make()
  panelStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  let first = run tree.append(root, move panelStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaf = run tree.append(first, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(leaf, 0)
  run tree.setMeasurement(second, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fragments = output.fragments.values.length()
  let leafBounds = run output.sourceBounds(leaf)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let copied = run output.sourceBounds(leaf)
  run Testing.expect(
    output.stats.passes == 0 && output.fragments.values.length() == fragments
      && copied.x == leafBounds.x
      && copied.width == leafBounds.width,
    "an unchanged tree keeps its previous output",
  )
  run tree.markDirty(second)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.stats.fullLayouts > 0 && output.stats.reusedLayouts == 1
      && output.fragments.values.length() == fragments,
    "a dirty leaf re-lays the root and copies the clean panel",
  )
  let mut wide = Style.make()
  wide.width = SizeValue.px(100.0)
  run tree.setStyle(second, move wide)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let moved = run output.sourceBounds(second)
  run Testing.expect(moved.x == 60.0 && moved.width == 100.0, "a sibling change moves the sibling")
  run Testing.expect(
    output.stats.reusedLayouts == 1,
    "a sibling change re-lays the root and copies the clean panel",
  )
  run Testing.expect(
    output.fragments.values.length() == fragments,
    "copied fragments replace, not add to, the panel",
  )
}

test effect fn changesInsideAFixedSizeBoxStayThere()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.width = SizeValue.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut panelStyle = Style.make()
  panelStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  panelStyle.width = SizeValue.px(100.0)
  panelStyle.height = SizeValue.px(50.0)

  // No automatic minimum size, which would read the panel's content.
  panelStyle.minWidth = SizeValue.px(0.0)
  let panel = run tree.append(root, move panelStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(second, 0)
  let mut leafStyle = Style.make()
  leafStyle.boxSizing = BoxSizing.BorderBox
  leafStyle.height = SizeValue.px(20.0)
  leafStyle.padding = Edges.all(Dimension.px(1.0))
  let leaf = run tree.append(panel, move leafStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)

  // The leaf's width is its parent's to read, but the panel's size stays.
  let mut padded = Style.make()
  padded.boxSizing = BoxSizing.BorderBox
  padded.height = SizeValue.px(20.0)
  padded.padding = Edges.all(Dimension.px(3.0))
  run tree.setStyle(leaf, move padded)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.stats.passes == 0,
    "a change inside a fixed-size box lays out only that box",
  )
  let kept = run output.sourceBounds(leaf)
  let sibling = run output.sourceBounds(second)
  let mut fresh = LayoutTree.make()
  run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run fresh.sourceBounds(leaf)
  let expectedSibling = run fresh.sourceBounds(second)
  run Testing.expect(
    kept.x == expected.x && kept.width == expected.width && kept.width == 6.0
      && kept.height == expected.height,
    "the box laid out alone matches a fresh layout",
  )
  run Testing.expect(
    sibling.x == expectedSibling.x && sibling.x == 100.0,
    "its parent's other children stay put",
  )
}

// Pinned by its right and bottom insets, inside its parent.
fn pinnedStyle(padding: f32) -> Style {
  let mut style = Style.make()
  style.position = Position.Absolute
  style.boxSizing = BoxSizing.BorderBox
  style.width = SizeValue.px(40.0)
  style.inset.right = Dimension.px(10.0)
  style.inset.bottom = Dimension.px(5.0)
  style.padding = Edges.all(Dimension.px(padding))
  return move style
}

// Reaching past its 100px parent's right edge, which the parent's overflow
// takes from it.
fn reachingStyle(padding: f32) -> Style {
  let mut style = Style.make()
  style.position = Position.Absolute
  style.boxSizing = BoxSizing.BorderBox
  style.width = SizeValue.px(60.0)
  style.inset.left = Dimension.px(80.0)
  style.inset.top = Dimension.px(10.0)
  style.padding = Edges.all(Dimension.px(padding))
  return move style
}

// No insets: at its static position, the start of its block parent.
fn staticStyle(padding: f32) -> Style {
  let mut style = Style.make()
  style.position = Position.Absolute
  style.padding = Edges.all(Dimension.px(padding))
  return move style
}

test effect fn aResizedAbsoluteBoxMovesAlone()
  ! OutOfMemoryError
    | TextError
    | FragmentationError
    | InvalidNode
    | InvalidBox
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut panelStyle = Style.make()
  panelStyle.position = Position.Relative
  panelStyle.width = SizeValue.px(100.0)
  panelStyle.height = SizeValue.px(50.0)
  let panel = run tree.append(root, move panelStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let inner = run tree.append(panel, pinnedStyle(1.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let outer = run tree.append(panel, reachingStyle(1.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let still = run tree.append(panel, staticStyle(1.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut step: usize = 0
  while step < 3 {
    if step == 0 {
      run tree.setStyle(inner, pinnedStyle(3.0))
    } else if step == 1 {
      run tree.setStyle(outer, reachingStyle(3.0))
    } else {
      run tree.setStyle(still, staticStyle(3.0))
    }
    run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(output.stats.passes == 0, "a resized absolute box is laid out alone")
    let mut fresh = LayoutTree.make()
    run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(800.0, 600.0))
      |> Effect.provideMut<Allocator>(&mut allocator)
    let kept = run output.sourceBounds(inner)
    let expected = run fresh.sourceBounds(inner)
    run Testing.expect(
      kept.y == expected.y && kept.height == expected.height && kept.height == 6.0,
      "the pinned bottom edge stays",
    )
    let keptOuter = run output.sourceBounds(outer)
    let expectedOuter = run fresh.sourceBounds(outer)
    run Testing.expect(
      keptOuter.x == expectedOuter.x && keptOuter.y == expectedOuter.y
        && keptOuter.height == expectedOuter.height,
      "the other box matches a fresh layout",
    )
    let keptStill = run output.sourceBounds(still)
    let expectedStill = run fresh.sourceBounds(still)
    run Testing.expect(
      keptStill.x == expectedStill.x && keptStill.y == expectedStill.y
        && keptStill.width == expectedStill.width,
      "the box at its static position matches a fresh layout",
    )
    let box = match run output.firstBox(panel) {
      Option<BoxId>.Some { value } => value
      Option<BoxId>.None => BoxId { index: 0 }
    }
    let overflow = (run output.getBox(box)).scrollableOverflow
    let expectedOverflow = (run fresh.getBox(box)).scrollableOverflow
    run Testing.expect(
      overflow.x == expectedOverflow.x && overflow.width == expectedOverflow.width
        && overflow.height == expectedOverflow.height
        && overflow.width == 140.0,
      "the panel's overflow matches a fresh layout",
    )
    step = step + 1
  }
}

test effect fn blockFlowChildrenBelowFloatsAreCopied()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut floatStyle = Style.make()
  floatStyle.float = Float.Left
  floatStyle.width = SizeValue.px(100.0)
  floatStyle.height = SizeValue.px(50.0)
  drop run tree.append(root, move floatStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut besideStyle = Style.make()
  besideStyle.height = SizeValue.px(30.0)
  let beside = run tree.append(root, move besideStyle)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut belowStyle = Style.make()
  belowStyle.height = SizeValue.px(40.0)
  let below = run tree.append(root, move belowStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut liftedStyle = Style.make()
  liftedStyle.height = SizeValue.px(10.0)
  liftedStyle.margin.top = Dimension.px(-30.0)
  let lifted = run tree.append(root, move liftedStyle)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut taller = Style.make()
  taller.height = SizeValue.px(45.0)
  run tree.setStyle(beside, move taller)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let moved = run output.sourceBounds(below)
  let raised = run output.sourceBounds(lifted)
  run Testing.expect(
    moved.y == 45.0 && moved.height == 40.0 && raised.y == 55.0,
    "siblings follow the taller block",
  )

  // The float ends at 50, above the 40px block's new top; the negative
  // margin could lift the last block into it, so that one is laid out.
  run Testing.expect(
    output.stats.reusedLayouts == 1,
    "only the block clear of the float and without negative margins is copied",
  )
}

test effect fn insertedNodesKeepTheirSiblingsLayouts()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut panelStyle = Style.make()
  panelStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  let panel = run tree.append(root, move panelStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaf = run tree.append(panel, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(leaf, 0)
  let list = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run tree.append(list, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(first, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let added = run tree.append(list, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(added, 0)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.stats.reusedLayouts >= 1,
    "the untouched panel is copied after an insertion elsewhere",
  )
  let mut fresh = LayoutTree.make()
  run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    fresh.fragments.values.length() == output.fragments.values.length(),
    "an insertion yields as many fragments as a fresh layout",
  )
  let sources = [leaf, first, added, panel, list]
  let mut index: usize = 0
  while index < sources.length {
    let a = run output.sourceBounds(sources[index])
    let b = run fresh.sourceBounds(sources[index])
    run Testing.expect(
      a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height,
      "an insertion lays out like a fresh tree",
    )
    index = index + 1
  }
}

test effect fn columnItemsShareTheirBlockAxisProbes()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.flexDirection = FlexDirection.Column
  style.width = SizeValue.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let item = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(item, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)

  // Sizing §5.1: the item's min-content and max-content heights are equal, and
  // both are the height of its layout, which the container runs ahead of its
  // lines in place of a probe.
  run Testing.expect(
    output.stats.sizeProbes == 0 && output.stats.cacheHits == 0,
    "a column item's content heights come from its one layout",
  )
  run Testing.expect(
    output.boxes.get(output.firstBySource.get(item.index)).size.height == 18.0,
    "the item keeps its content height",
  )
}

test effect fn unreadComputesResolveLikeFreshOnes()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut panelStyle = Style.make()
  panelStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  let panel = run tree.append(root, move panelStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut changed = root
  let mut at: usize = 0
  while at < 6 {
    let mut nested = Style.make()
    nested.margin.left = Dimension.px(3.0)
    let inner = run tree.append(panel, move nested) |> Effect.provideMut<Allocator>(&mut allocator)
    let leaf = run tree.append(inner, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
    run tree.setMeasurement(leaf, 0)
    if at == 2 {
      changed = leaf
    }
    at = at + 1
  }
  let below = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(below, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  output.fragments.resolveLocations()

  // Several computes nobody reads: a resize, a change inside the panel,
  // then one after it that keeps the panel's fragments where they are.
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(500.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut tall = Style.make()
  tall.height = SizeValue.px(70.0)
  tall.margin.top = Dimension.px(5.0)
  run tree.setStyle(changed, move tall)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(500.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut short = Style.make()
  short.height = SizeValue.px(9.0)
  run tree.setStyle(below, move short)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(500.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounds = run output.sourceBounds(below)
  let mut fresh = LayoutTree.make()
  run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(500.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  fresh.fragments.resolveLocations()
  let expected = run fresh.sourceBounds(below)
  run Testing.expect(
    bounds.x == expected.x && bounds.y == expected.y && bounds.y > 0.0,
    "source bounds before resolving match a fresh compute",
  )
  output.fragments.resolveLocations()
  let values = output.fragments.values.asSlice()
  let freshValues = fresh.fragments.values.asSlice()
  run Testing.expect(values.length == freshValues.length, "the same fragments")
  let mut same = true
  let mut index: usize = 0
  while index < values.length {
    if values[index].worldLocation.x != freshValues[index].worldLocation.x
      || values[index].worldLocation.y != freshValues[index].worldLocation.y {
      same = false
    }
    index = index + 1
  }
  run Testing.expect(same, "world locations resolved after unread computes match a fresh compute")
}

test effect fn deferredContentMinimumsStillStopShrinking()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.width = SizeValue.px(30.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let first = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(first, 0)
  run tree.setMeasurement(second, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)

  // §4.5: the automatic minimum is the min-content width, measured only once
  // the line shrinks.
  let firstBox = output.boxes.get(output.firstBySource.get(first.index))
  let secondBox = output.boxes.get(output.firstBySource.get(second.index))
  run Testing.expect(
    firstBox.size.width == 20.0 && secondBox.size.width == 20.0 && secondBox.location.x == 20.0,
    "shrinking items stop at their min-content width",
  )
  let mut wide = Style.make()
  wide.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  wide.width = SizeValue.px(300.0)
  run tree.setStyle(root, move wide)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let grown = output.boxes.get(output.firstBySource.get(second.index))
  run Testing.expect(
    grown.size.width == 60.0 && grown.location.x == 60.0,
    "a line with room keeps max-content widths",
  )
}

test effect fn repeatedResizesLayOutAfresh()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut last = root
  let mut lastBlock = root
  let mut at: usize = 0
  while at < 8 {
    let mut style = Style.make()
    style.padding.left = Dimension.px(2.0)
    let block = run tree.append(root, move style) |> Effect.provideMut<Allocator>(&mut allocator)
    let leaf = run tree.append(block, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
    run tree.setMeasurement(leaf, 0)
    last = leaf
    lastBlock = block
    at = at + 1
  }
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 300.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(250.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.relaidMost, "a resize that reaches every box is noted")
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(120.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounds = run output.sourceBounds(last)
  let mut fresh = LayoutTree.make()
  run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(120.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run fresh.sourceBounds(last)
  run Testing.expect(
    bounds.x == expected.x && bounds.y == expected.y && bounds.width == expected.width
      && bounds.height == expected.height
      && bounds.width == 118.0,
    "a resize laid out afresh matches a fresh compute",
  )
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(120.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.stats.passes == 0,
    "an unchanged tree after a fresh resize keeps its output",
  )

  // An edit after a compute that laid out most boxes is laid out afresh too.
  let mut wide = Style.make()
  wide.padding.top = Dimension.px(9.0)
  run tree.setStyle(lastBlock, move wide)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(120.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let edited = run output.sourceBounds(last)
  let mut again = LayoutTree.make()
  run compute(&tree, &mut again, &mut content, OptionalSize.definite(120.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let expectedEdit = run again.sourceBounds(last)
  run Testing.expect(
    output.stats.fullLayouts > 1 && edited.x == expectedEdit.x && edited.y == expectedEdit.y
      && edited.width == expectedEdit.width,
    "an edit laid out afresh matches a fresh compute",
  )
}

// Grid containers must not inherit the block-only cache normalization that
// erases available block size. Inspect both construction and restyling paths.
test effect fn gridExcludesBlockProbeHeightNormalization()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let child = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  drop child
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)

  // KEY_BLOCK is the cache's block-height-normalization bit.
  run Testing.expect(
    output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 16 != 0,
    "ordinary block enables block probe normalization",
  )
  let mut grid = Style.make()
  grid.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  run tree.setStyle(root, move grid)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 16 == 0,
    "restyled grid excludes block probe normalization",
  )
  let mut fresh = LayoutTree.make()
  run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    fresh.facts.keyShapes.get(fresh.firstBySource.get(root.index)) & 16 == 0,
    "fresh grid excludes block probe normalization",
  )
}

// KEY_WIDTH_FREE_TREE lets width-only probes ignore height, so a descendant
// whose width can read height clears it on every ancestor, also on restyle.
test effect fn widthFreeTreeClearsAncestors()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let child = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaf = run tree.append(child, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 2048 != 0,
    "plain blocks are width free",
  )
  let mut ratio = Style.make()
  ratio.aspectRatio = 1.0
  run tree.setStyle(leaf, move ratio)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 2048 == 0,
    "restyled aspect ratio clears the root",
  )
  run Testing.expect(
    output.facts.keyShapes.get(output.firstBySource.get(child.index)) & 2048 == 0,
    "restyled aspect ratio clears the parent",
  )
  run Testing.expect(
    output.facts.keyShapes.get(output.firstBySource.get(child.index)) & 1024 != 0,
    "the parent itself stays width free",
  )
}

// KEY_CONTENT_FREE_TREE lets min-content probes share max-content entries, so
// a multi-line flex container clears it on itself and its ancestors.
test effect fn contentFreeTreeExcludesWrapping()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut wrapping = Style.make()
  wrapping.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  wrapping.flexWrap = FlexWrap.Wrap
  let child = run tree.append(root, move wrapping) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaf = run tree.append(child, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.facts.keyShapes.get(output.firstBySource.get(leaf.index)) & 8192 != 0,
    "an empty leaf is content free",
  )
  run Testing.expect(
    output.facts.keyShapes.get(output.firstBySource.get(child.index)) & 4096 == 0,
    "a wrapping flex container is not content free",
  )
  run Testing.expect(
    output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 8192 == 0,
    "its ancestors are not content free",
  )
  let mut single = Style.make()
  single.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  run tree.setStyle(child, move single)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 8192 != 0,
    "a restyled single-line container frees its ancestors",
  )
}

// invalidate() followed by markDirty keeps the boxes: no style, text or
// structure changed. A style change after it still regenerates them.
test effect fn boxesStandAcrossMarkedInvalidation()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.flexDirection = FlexDirection.Column
  style.width = SizeValue.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let item = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(item, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  output.invalidate()
  run tree.markDirty(item)
  content.height = 30.0
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.boxes.get(output.firstBySource.get(item.index)).size.height == 30.0,
    "a marked leaf is measured again on the boxes that stand",
  )
  run Testing.expect(
    output.boxes.get(output.firstBySource.get(root.index)).size.height == 30.0,
    "its container follows",
  )
  output.invalidate()
  run tree.markDirty(item)
  let mut hidden = Style.make()
  hidden.display = Display.None
  run tree.setStyle(item, hidden)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.boxes.get(output.firstBySource.get(root.index)).size.height == 0.0,
    "a style change after the mark regenerates the boxes",
  )
}

// A plain box's content width is read without a size probe (plainWidth), so
// the early cutoff compares it too: a stretched column that holds the widest
// item of its shrink-to-fit parent keeps its own size when it is laid out
// alone after the item narrows, and the parent must still narrow.
test effect fn plainWidthsHoldTheEarlyCutoff()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut column = Style.make()
  column.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  column.flexDirection = FlexDirection.Column
  let mut start = column
  start.alignItems = Align.FlexStart
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let outer = run tree.append(root, start) |> Effect.provideMut<Allocator>(&mut allocator)
  let fitted = run tree.append(outer, column) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wide = Style.make()
  wide.width = SizeValue.px(50.0)
  wide.height = SizeValue.px(10.0)
  drop run tree.append(fitted, wide) |> Effect.provideMut<Allocator>(&mut allocator)
  let stretched = run tree.append(fitted, column) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut narrow = Style.make()
  narrow.width = SizeValue.px(150.0)
  narrow.height = SizeValue.px(10.0)
  let leaf = run tree.append(stretched, narrow) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.boxes.get(output.firstBySource.get(fitted.index)).size.width == 150.0,
    "the column fits its widest item",
  )
  let mut step: usize = 0
  while step < 3 {
    let mut grown = Style.make()
    grown.width = SizeValue.px(120.0 - usize.toF32(step) * 10.0)
    grown.height = SizeValue.px(10.0)
    run tree.setStyle(leaf, grown)
    run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      output.boxes.get(output.firstBySource.get(fitted.index)).size.width
        == 120.0 - usize.toF32(step) * 10.0,
      "the column follows an item of a stretched item",
    )
    run Testing.expect(
      output.boxes.get(output.firstBySource.get(stretched.index)).size.width
        == 120.0 - usize.toF32(step) * 10.0,
      "the stretched item follows",
    )
    step = step + 1
  }
}

// A box whose size changes clears its in-flow subtree, but a flex container
// inside it is cleared alone: its items keep their results where their
// requests stand and are laid out again where they do not.
test effect fn resizedBlocksKeepItemsOfTheirFlexChildren()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut outer = Style.make()
  outer.width = SizeValue.px(400.0)
  outer.padding.left = Dimension.px(3.0)
  let block = run tree.append(root, outer) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut row = Style.make()
  row.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  row.flexWrap = FlexWrap.Wrap
  let flex = run tree.append(block, row) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut fixed = Style.make()
  fixed.width = SizeValue.px(150.0)
  fixed.height = SizeValue.px(10.0)
  let mut half = Style.make()
  half.width = SizeValue.pct(0.5)
  half.height = SizeValue.px(12.0)
  let mut items = List<NodeId>.make()
  let mut at: usize = 0
  while at < 6 {
    let mut style = fixed
    if at % 2 == 1 {
      style = half
    }
    let item = run tree.append(flex, style) |> Effect.provideMut<Allocator>(&mut allocator)
    let inner = run tree.append(item, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
    run tree.setMeasurement(inner, 0)
    run items.append(item) |> Effect.provideMut<Allocator>(&mut allocator)
    run items.append(inner) |> Effect.provideMut<Allocator>(&mut allocator)
    at = at + 1
  }
  let after = run tree.append(block, fixed) |> Effect.provideMut<Allocator>(&mut allocator)
  run items.append(after) |> Effect.provideMut<Allocator>(&mut allocator)
  run items.append(flex) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut step: usize = 0
  while step < 4 {
    let mut resized = Style.make()
    resized.width = SizeValue.px(360.0 - usize.toF32(step) * 70.0)
    resized.padding.left = Dimension.px(3.0)
    run tree.setStyle(block, resized)
    run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0))
      |> Effect.provideMut<Allocator>(&mut allocator)
    let mut fresh = LayoutTree.make()
    run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(800.0, 600.0))
      |> Effect.provideMut<Allocator>(&mut allocator)
    let mut index: usize = 0
    while index < items.length() {
      let bounds = run output.sourceBounds(items.get(index))
      let expected = run fresh.sourceBounds(items.get(index))
      run Testing.expect(
        bounds.x == expected.x && bounds.y == expected.y && bounds.width == expected.width
          && bounds.height == expected.height,
        "a box below a resized block matches a fresh compute",
      )
      index = index + 1
    }
    step = step + 1
  }
}

// A text service that offers a break after every space, with or without the
// plain text guarantee, and counts its analyses.
// `shapedUnits` counts the text units of every shaping request.
struct Words {
  paragraph: Paragraph,
  plain: bool,
  analyses: usize,
  shapedUnits: usize
}

impl Measure for Words {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    return Measure.font(&mut provider.paragraph, request)
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    return ScrollbarMetrics.zero()
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    return Measure.natural(&mut provider.paragraph, key)
  }

  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    return Measure.measure(&mut provider.paragraph, key, request)
  }
}

impl TextMeasure for Words {
  fn beginTextLayout(provider: &mut Self) {}

  fn plainText(provider: &Self) -> bool {
    return provider.plain
  }

  effect fn analyze(
    provider: &mut Self,
    context: TextContext<'_, '_>,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    provider.analyses = provider.analyses + 1
    let mut unit: usize = 0
    while unit < context.tokens.length {
      if context.tokens[unit].kind == TextTokenKind.Space {
        run output.append(
          TextBreak { at: TextCursor { unit: unit + 1, offset: 0 }, kind: TextBreakKind.Soft },
        )
      }
      unit = unit + 1
    }
    run output.append(
      TextBreak {
        at: TextCursor { unit: context.tokens.length, offset: 0 },
        kind: TextBreakKind.Soft,
      },
    )
    return TextAnalysis.uniform(context.tokens.length, 0, 0, true)
  }

  effect fn shape(
    provider: &mut Self,
    request: TextShapeRequest<'_, '_>,
    output: &mut List<TextRun>,
  )
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    provider.shapedUnits = provider.shapedUnits + request.end.unit + 1 - request.start.unit
    run TextMeasure.shape(&mut provider.paragraph, request, &mut output)
  }
}

test effect fn rowUsesFinalItemsForCrossSize() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.alignItems = Align.FlexEnd
  style.width = SizeValue.px(100.0)
  let root = tree.root()
  let row = run tree.append(root, style) |> Effect.provideMut<Allocator>(&mut allocator)
  style.flexDirection = FlexDirection.Column
  style.alignItems = Align.Stretch
  style.width = SizeValue.px(45.0)
  style.minWidth = SizeValue.px(0.0)
  let column = run tree.append(row, style) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index: usize = 0
  while index < 24 {
    let paragraph = run tree.append(column, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
    let value = run String.copy("alpha beta gamma") |> Effect.provideMut<Allocator>(&mut allocator)
    drop run tree.appendText(paragraph, move value) |> Effect.provideMut<Allocator>(&mut allocator)
    index = index + 1
  }
  let mut sibling = Style.make()
  sibling.width = SizeValue.px(10.0)
  sibling.height = SizeValue.px(10.0)
  let marker = run tree.append(row, sibling) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut words = Words { paragraph: Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false }, plain: true, analyses: 0, shapedUnits: 0 }
  run compute(&tree, &mut output, &mut words, OptionalSize.definite(150.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let bounds = run output.sourceBounds(column)
  let aligned = run output.sourceBounds(marker)
  run Testing.expect(bounds.width == 45.0 && bounds.height == 720.0 && aligned.x == 45.0 && aligned.y + aligned.height == bounds.y + bounds.height, "the wrapped column sets the row height and its sibling aligns to its end")
  run Testing.expect(output.stats.sizeProbes == 0, "an independent cross size needs no probe of the column or its paragraphs")
  let last = run tree.append(row, sibling) |> Effect.provideMut<Allocator>(&mut allocator)
  sibling.alignSelf = Align.Stretch
  sibling.height = SizeValue.auto()
  run tree.setStyle(marker, sibling)
  run compute(&tree, &mut output, &mut words, OptionalSize.definite(150.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let stretched = run output.sourceBounds(marker)
  let middle = output.fragments.first(output.firstBySource.get(marker.index))
  let end = output.fragments.first(output.firstBySource.get(last.index))
  run Testing.expect(stretched.height == bounds.height && output.fragments.values.get(middle).nextSibling == end, "an item that needs the line height and its following sibling stay in paint order")
}

test effect fn wrappedPlainParagraphSharesWholeShape() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut row = Style.make()
  row.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  row.width = SizeValue.px(45.0)
  let mut tree = run Tree.make(row) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  row.flexDirection = FlexDirection.Column
  let column = run tree.append(root, row) |> Effect.provideMut<Allocator>(&mut allocator)
  let label = run tree.append(column, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let value = run String.copy("alpha beta gamma delta epsilon zeta eta theta") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run tree.appendText(label, move value) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut fast = LayoutTree.make()
  let mut slow = LayoutTree.make()
  let mut plain = Words { paragraph: Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false }, plain: true, analyses: 0, shapedUnits: 0 }
  let mut analyzed = Words { paragraph: Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false }, plain: false, analyses: 0, shapedUnits: 0 }
  let viewport = OptionalSize.definite(80.0, 100.0)
  run compute(&tree, &mut fast, &mut plain, viewport) |> Effect.provideMut<Allocator>(&mut allocator)
  run compute(&tree, &mut slow, &mut analyzed, viewport) |> Effect.provideMut<Allocator>(&mut allocator)
  let actual = run fast.sourceBounds(text)
  let expected = run slow.sourceBounds(text)
  run Testing.expect(actual.height > 10.0 && actual.height == expected.height && actual.width == expected.width, "the same lines wrap inside the stretched flex column")
  run Testing.expect(plain.shapedUnits <= analyzed.shapedUnits, "trying a plain line must not shape the whole wrapped paragraph twice")
}

test effect fn plainLinesMatchAnalyzedParagraphs()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut column = Style.make()
  column.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  column.flexDirection = FlexDirection.Column
  column.alignItems = Align.FlexStart
  column.width = SizeValue.px(200.0)
  let mut tree = run Tree.make(move column) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut nodes = List<NodeId>.make()
  let mut padded = Style.make()
  padded.padding.left = Dimension.px(3.0)
  padded.padding.top = Dimension.px(2.0)
  let mut narrow = Style.make()
  narrow.width = SizeValue.px(30.0)
  let mut right = Style.make()
  right.width = SizeValue.px(120.0)
  right.textAlign = TextAlign.Right
  let contents: [string<'static>; 6] = [
    "one two",
    "label",
    "alpha beta gamma",
    "right side",
    " spaced  out ",
    "caf\u{e9} au lait",
  ]
  let mut at: usize = 0
  while at < 6 {
    let mut style = Style.make()
    if at == 0 {
      style = padded
    }
    if at == 2 {
      style = narrow
    }
    if at == 3 {
      style = right
    }
    let label = run tree.append(root, style) |> Effect.provideMut<Allocator>(&mut allocator)
    let value = run String.copy(contents[at]) |> Effect.provideMut<Allocator>(&mut allocator)
    let text = run tree.appendText(label, move value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    run nodes.append(label) |> Effect.provideMut<Allocator>(&mut allocator)
    run nodes.append(text) |> Effect.provideMut<Allocator>(&mut allocator)
    at = at + 1
  }
  let mut fast = LayoutTree.make()
  let mut slow = LayoutTree.make()
  let mut plain = Words {
    paragraph: Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false },
    plain: true,
    analyses: 0,
    shapedUnits: 0,
  }
  let mut analyzed = Words {
    paragraph: Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false },
    plain: false,
    analyses: 0,
    shapedUnits: 0,
  }
  let mut step: usize = 0
  while step < 5 {
    if step == 1 {
      let value = run String.copy("changed text") |> Effect.provideMut<Allocator>(&mut allocator)
      run tree.setText(nodes.get(3), move value)
    }
    if step == 2 || step == 3 {
      let mut resized = Style.make()
      resized.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
      resized.flexDirection = FlexDirection.Column
      resized.alignItems = Align.FlexStart
      resized.width = SizeValue.px(40.0)
      if step == 3 {
        resized.width = SizeValue.px(200.0)
      }
      run tree.setStyle(root, resized)
    }
    if step == 4 {
      let value = run String.copy("two\nlines") |> Effect.provideMut<Allocator>(&mut allocator)
      run tree.setText(nodes.get(1), move value)
    }
    run compute(&tree, &mut fast, &mut plain, OptionalSize.definite(800.0, 600.0))
      |> Effect.provideMut<Allocator>(&mut allocator)
    run compute(&tree, &mut slow, &mut analyzed, OptionalSize.definite(800.0, 600.0))
      |> Effect.provideMut<Allocator>(&mut allocator)
    let mut index: usize = 0
    while index < nodes.length() {
      let a = run fast.sourceBounds(nodes.get(index))
      let b = run slow.sourceBounds(nodes.get(index))
      run Testing.expect(
        a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height,
        "a plain line is laid out where the analyzed paragraph is",
      )
      let mut left = run fast.sourceRects(nodes.get(index))
      let mut other = run slow.sourceRects(nodes.get(index))
      while true {
        let first = match move left.next() {
          Option<Rect>.Some { value } => value
          Option<Rect>.None => {
            break
          }
        }
        let second = match move other.next() {
          Option<Rect>.Some { value } => value
          Option<Rect>.None => Rect { x: -1.0, y: -1.0, width: -1.0, height: -1.0 }
        }
        run Testing.expect(
          first.x == second.x && first.y == second.y && first.width == second.width
            && first.height == second.height,
          "a plain line emits the fragments of the analyzed paragraph",
        )
      }
      index = index + 1
    }
    step = step + 1
  }
  run Testing.expect(
    plain.analyses < analyzed.analyses && plain.analyses != 0,
    "plain lines skip analysis; wrapped, spaced and non-ASCII text keeps it",
  )
}

// Breaks after spaces, plus `wrap` breaks inside every word, as a host does for overflow-wrap.
struct WrapWords {
  paragraph: Paragraph,
  wrap: TextBreakKind
}

impl Measure for WrapWords {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    return Measure.font(&mut provider.paragraph, request)
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    return Measure.scrollbars(&mut provider.paragraph, request)
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    return Measure.natural(&mut provider.paragraph, key)
  }

  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    return Measure.measure(&mut provider.paragraph, key, request)
  }
}

impl TextMeasure for WrapWords {
  fn beginTextLayout(provider: &mut Self) {}

  effect fn analyze(
    provider: &mut Self,
    context: TextContext<'_, '_>,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    let mut unit: usize = 0
    while unit < context.tokens.length {
      let token = context.tokens[unit]
      if token.kind == TextTokenKind.Text {
        let mut offset: usize = 1
        while offset < String.byteLength(token.text) {
          run output.append(
            TextBreak { at: TextCursor { unit: unit, offset: offset }, kind: provider.wrap },
          )
          offset = offset + 1
        }
      } else if token.kind == TextTokenKind.Space && unit + 1 < context.tokens.length {
        run output.append(
          TextBreak { at: TextCursor { unit: unit + 1, offset: 0 }, kind: TextBreakKind.Soft },
        )
      }
      unit = unit + 1
    }
    run output.append(
      TextBreak {
        at: TextCursor { unit: context.tokens.length, offset: 0 },
        kind: TextBreakKind.Soft,
      },
    )
    return TextAnalysis.uniform(context.tokens.length, 0, 0, true)
  }

  effect fn shape(
    provider: &mut Self,
    request: TextShapeRequest<'_, '_>,
    output: &mut List<TextRun>,
  )
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    run TextMeasure.shape(&mut provider.paragraph, request, &mut output)
  }
}

effect fn wrapped(kind: TextBreakKind, rootWidth: f32, floated: bool) -> Rect
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode
  ? &mut Allocator {
  let mut style = Style.make()
  style.width = SizeValue.px(rootWidth)
  let mut tree = run Tree.make(move style)
  let mut parent = tree.root()
  if floated {
    let mut floatStyle = Style.make()
    floatStyle.float = Float.Left
    parent = run tree.append(parent, move floatStyle)
  }
  let value = run String.copy("ab abcdefghij c")
  drop run tree.appendText(parent, move value)
  let mut output = LayoutTree.make()
  let mut provider = WrapWords {
    paragraph: Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false },
    wrap: kind,
  }
  run compute(&tree, &mut output, &mut provider, OptionalSize.definite(100.0, 100.0))
  return run output.sourceBounds(parent)
}

test effect fn overflowWrapBreaksOnlyWordsThatOverflow()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let unwrapped = run wrapped(TextBreakKind.Soft, 30.0, false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    unwrapped.height == 30.0,
    "fixture: with breaks inside words taken as soft ones, three lines",
  )
  let normal = run wrapped(TextBreakKind.Emergency, 30.0, false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    normal.height == 30.0 && normal.width == 30.0,
    "the long word breaks where the line fills, and the rest shares a line with c",
  )
  let anywhere = run wrapped(TextBreakKind.Anywhere, 30.0, false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(anywhere.height == 30.0, "anywhere breaks lay out as break-word ones")
  let wide = run wrapped(TextBreakKind.Emergency, 60.0, false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    wide.height == 20.0,
    "a word that fits its own line is not broken: ab, then abcdefghij c",
  )
}

test effect fn overflowWrapAnywhereShrinksMinContent()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let breakWord = run wrapped(TextBreakKind.Emergency, 1.0, true)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(breakWord.width == 50.0, "break-word keeps the longest word as min-content")
  let anywhere = run wrapped(TextBreakKind.Anywhere, 1.0, true)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(anywhere.width == 5.0, "anywhere breaks count toward min-content")
}

effect fn clampedWords(value: string, style: Style) -> Rect
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode
  ? &mut Allocator {
  let mut tree = run Tree.make(move style)
  let root = tree.root()
  let text = run tree.appendText(root, run String.copy(value))
  let mut output = LayoutTree.make()
  let mut provider = Words {
    paragraph: Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false },
    plain: false,
    analyses: 0,
    shapedUnits: 0,
  }
  run compute(&tree, &mut output, &mut provider, OptionalSize.definite(100.0, 100.0))
  return run output.sourceBounds(text)
}

fn balanceStyle(wrapStyle: TextWrapStyle, align: TextAlign) -> Style {
  let mut style = Style.make()
  style.width = SizeValue.px(100.0)
  style.textWrapStyle = wrapStyle
  style.textAlign = align
  return style
}

// Words are 20 wide and spaces 5: greedy lines are 95 and 20 wide, balanced ones 70 and 45.
test effect fn balancedTextFitsTheNarrowestWidthWithTheSameLines()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let words = "aaaa bbbb cccc dddd eeee"
  let greedy = run clampedWords(words, balanceStyle(TextWrapStyle.Auto, TextAlign.Start))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    greedy.width == 95.0 && greedy.height == 20.0,
    "fixture: greedy lines fill the first one",
  )
  let balanced = run clampedWords(words, balanceStyle(TextWrapStyle.Balance, TextAlign.Start))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    balanced.width == 70.0 && balanced.height == 20.0,
    "balanced lines keep the count and even out",
  )
  let centered = run clampedWords(words, balanceStyle(TextWrapStyle.Balance, TextAlign.Center))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    centered.x == 15.0 && centered.width == 70.0,
    "balanced lines align in the full width",
  )
  let single = run clampedWords("aaaa bbbb", balanceStyle(TextWrapStyle.Balance, TextAlign.Start))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(single.width == 45.0 && single.height == 10.0, "one line is left as it is")
}

fn clampStyle(lines: usize, ellipsis: bool) -> Style {
  let mut style = Style.make()
  style.width = SizeValue.px(40.0)
  style.maxLines = lines
  style.blockEllipsis = ellipsis
  return style
}

fn overflowStyle(overflow: Overflow) -> Style {
  let mut style = Style.make()
  style.width = SizeValue.px(40.0)
  style.textWrap = TextWrap.NoWrap
  style.overflowX = overflow
  style.textOverflowEllipsis = true
  return style
}

test effect fn lineClampEndsTheBoxAfterItsLastLine()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let all = run clampedWords("aaa bbb ccc ddd eee", clampStyle(0, true))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    all.height == 30.0 && all.width == 35.0,
    "fixture: three lines of at most 35px",
  )
  let clamped = run clampedWords("aaa bbb ccc ddd eee", clampStyle(2, false))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    clamped.height == 20.0 && clamped.width == 35.0,
    "line-clamp: 2 keeps two lines",
  )
  let ellipsis = run clampedWords("aaa bbb ccc ddd eee", clampStyle(2, true))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    ellipsis.height == 20.0 && ellipsis.width == 40.0,
    "the last line is cut to 'ccc d' so its ellipsis fits",
  )
  let short = run clampedWords("aaa bbb", clampStyle(2, true))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(short.height == 10.0 && short.width == 35.0, "nothing is cut, so no ellipsis")
}

test effect fn textOverflowEllipsisCutsOverflowingLines()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let cut = run clampedWords("aaa bbb ccc", overflowStyle(Overflow.Hidden))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    cut.height == 10.0 && cut.width == 40.0,
    "the line ends in 'aaa b' and an ellipsis",
  )
  let visible = run clampedWords("aaa bbb ccc", overflowStyle(Overflow.Visible))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(visible.width == 55.0, "overflow: visible keeps the whole line")
  let plain = run longEllipsized(true) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    plain.0 .height == 10.0 && plain.0 .width == 40.0 && plain.1 < 1000,
    "a 20,000 word line is cut as a short one, shaping only near what shows",
  )
  let analyzed = run longEllipsized(false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    analyzed.0 .height == 10.0 && analyzed.0 .width == 40.0 && analyzed.1 < 1000,
    "the same without the plain text path",
  )
}

tuple Shaped(Rect, usize)

// A line of 20,000 words cut by an ellipsis, and the text units its layout shaped.
effect fn longEllipsized(plain: bool) -> Shaped
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode
  ? &mut Allocator {
  let mut value = String.make()
  let mut words: usize = 0
  while words < 20000 {
    run value.append("aaa ")
    words = words + 1
  }
  run value.append("aaa")
  let mut tree = run Tree.make(overflowStyle(Overflow.Hidden))
  let root = tree.root()
  let text = run tree.appendText(root, move value)
  let mut output = LayoutTree.make()
  let mut provider = Words {
    paragraph: Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false },
    plain: plain,
    analyses: 0,
    shapedUnits: 0,
  }
  run compute(&tree, &mut output, &mut provider, OptionalSize.definite(100.0, 100.0))
  return Shaped(run output.sourceBounds(text), provider.shapedUnits)
}

// A source that interns its styles gives a restyled node another style index;
// the boxes the next compute keeps must read the new one.
test effect fn keptBoxesTakeANewStyleIndex()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut first = Style.make()
  first.width = SizeValue.px(40.0)
  first.height = SizeValue.px(10.0)
  let a = run tree.append(root, move first) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut second = Style.make()
  second.width = SizeValue.px(40.0)
  second.height = SizeValue.px(10.0)
  let b = run tree.append(root, move second) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  // Node `a` moves to a new slot holding a wider style, as an interning source would.
  let mut wider = Style.make()
  wider.width = SizeValue.px(70.0)
  wider.height = SizeValue.px(10.0)
  let before = tree.nodes.asSlice()[a.index].styleIndex
  let change = Source.classify(&tree.styles.asSlice()[before], &wider, false, false)
  run tree.styles.append(move wider) |> Effect.provideMut<Allocator>(&mut allocator)
  let nodes = tree.nodes.asMutSlice()
  nodes[a.index].styleIndex = tree.styles.length() - 1
  drop nodes
  tree.changes.styleChanged(a.index, root.index, change)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let moved = run output.sourceBounds(a)
  let kept = run output.sourceBounds(b)
  run Testing.expect(
    moved.width == 70.0 && kept.width == 40.0 && kept.y == 10.0,
    "a kept box reads its node's new style index",
  )
}

// Anonymous boxes with equal styles share one slot, and every slot counts the boxes that hold
// it: the counts match the boxes, and the kept output holds as many styles as a fresh compute.
effect fn expectSharedAnonymousStyles(tree: &Tree, output: &LayoutTree) ! OutOfMemoryError | TextError | FragmentationError | AssertionError<'static> ? &mut Allocator {
  let nodes = output.boxNodes.asSlice()
  let styles = &output.anonymousStyles
  let mut slot: usize = 1
  while slot < styles.length() {
    let mut holders: u32 = 0
    let mut id: usize = 0
    while id < nodes.length {
      if nodes[id].anonymousStyle() == slot { holders = holders + 1 }
      id = id + 1
    }
    run Testing.expect(holders == styles.holds(slot), "each anonymous style counts the boxes that hold it")
    slot = slot + 1
  }
  let mut fresh = LayoutTree.make()
  let mut paragraph = Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false }
  run compute(tree, &mut fresh, &mut paragraph, OptionalSize.definite(200.0, 400.0))
  run Testing.expect(fresh.anonymousStyles.held() == styles.held(), "a kept output holds no more anonymous styles than a fresh one")
}

// The font of the text box of `text`.
fn textFont(output: &LayoutTree, text: NodeId) -> usize {
  let nodes = output.boxNodes.asSlice()
  let id = output.firstBySource.get(text.index)
  return output.anonymousStyles.get(nodes[id].anonymousStyle()).fontKey
}

test effect fn equalAnonymousStylesShareOneSlot()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(200.0)
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut paragraphs = List<NodeId>.make()
  let mut texts = List<NodeId>.make()
  let mut index: usize = 0
  while index < 6 {
    let mut block = Style.make()
    block.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
    block.fontKey = if index == 5 { 2 } else { 1 }
    let p = run tree.append(root, move block) |> Effect.provideMut<Allocator>(&mut allocator)
    let value = run String.copy("a b c") |> Effect.provideMut<Allocator>(&mut allocator)
    let t = run tree.appendText(p, move value) |> Effect.provideMut<Allocator>(&mut allocator)
    run paragraphs.append(p) |> Effect.provideMut<Allocator>(&mut allocator)
    run texts.append(t) |> Effect.provideMut<Allocator>(&mut allocator)
    index = index + 1
  }
  let mut output = LayoutTree.make()
  let mut paragraph = Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false }
  run compute(&tree, &mut output, &mut paragraph, OptionalSize.definite(200.0, 400.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  // The viewport's, and a run and a text style for each of the two fonts.
  let held = output.anonymousStyles.held()
  run Testing.expect(held == 5, "six paragraphs in two fonts hold five anonymous styles")
  run expectSharedAnonymousStyles(&tree, &output) |> Effect.provideMut<Allocator>(&mut allocator)

  // A restyled paragraph takes its own styles; the others keep theirs.
  let mut changed = Style.make()
  changed.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
  changed.fontKey = 3
  run tree.setStyle(paragraphs.get(2), move changed)
  run compute(&tree, &mut output, &mut paragraph, OptionalSize.definite(200.0, 400.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(textFont(&output, texts.get(2)) == 3, "the restyled paragraph's text takes its new font")
  run Testing.expect(textFont(&output, texts.get(1)) == 1 && textFont(&output, texts.get(3)) == 1, "its siblings keep theirs")
  run Testing.expect(output.anonymousStyles.held() == held + 2, "the new font adds a run and a text style")
  run expectSharedAnonymousStyles(&tree, &output) |> Effect.provideMut<Allocator>(&mut allocator)

  // Restyled back, it shares again and the styles it held are free.
  let mut back = Style.make()
  back.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
  back.fontKey = 1
  run tree.setStyle(paragraphs.get(2), move back)
  run compute(&tree, &mut output, &mut paragraph, OptionalSize.definite(200.0, 400.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(textFont(&output, texts.get(2)) == 1, "the paragraph takes its first font again")
  run Testing.expect(output.anonymousStyles.held() == held, "the styles of the font no box uses are freed")
  run expectSharedAnonymousStyles(&tree, &output) |> Effect.provideMut<Allocator>(&mut allocator)

  // The only paragraph of the second font goes, and its styles with it.
  run tree.remove(paragraphs.get(5))
  run compute(&tree, &mut output, &mut paragraph, OptionalSize.definite(200.0, 400.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.anonymousStyles.held() == held - 2, "removing the last paragraph of a font frees its styles")
  run expectSharedAnonymousStyles(&tree, &output) |> Effect.provideMut<Allocator>(&mut allocator)

  // New text in a new paragraph of the first font shares what is held.
  let mut again = Style.make()
  again.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
  again.fontKey = 1
  let p = run tree.append(root, move again) |> Effect.provideMut<Allocator>(&mut allocator)
  let value = run String.copy("d e") |> Effect.provideMut<Allocator>(&mut allocator)
  let t = run tree.appendText(p, move value) |> Effect.provideMut<Allocator>(&mut allocator)
  run compute(&tree, &mut output, &mut paragraph, OptionalSize.definite(200.0, 400.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(textFont(&output, t) == 1, "the new text takes the first font")
  run Testing.expect(output.anonymousStyles.held() == held - 2, "a new paragraph of a held font adds no style")
  run expectSharedAnonymousStyles(&tree, &output) |> Effect.provideMut<Allocator>(&mut allocator)
}

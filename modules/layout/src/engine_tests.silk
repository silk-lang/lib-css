test effect fn reusedOutputClearsOverflowAcrossBoxGenerationChanges()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(100.0)
  style.height = SizeValue.px(100.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut childStyle = Style.make()
  childStyle.width = SizeValue.px(300.0)
  childStyle.height = SizeValue.px(200.0)
  let child = run tree.append(root, move childStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    output.viewportOverflow.width == 300.0 && output.viewportOverflow.height == 200.0,
    "visible descendant overflow extends the viewport",
  )
  let rootStyleIndex = tree.nodes.asSlice()[root.index].styleIndex
  let hiddenStyles = tree.styles.asMutSlice()
  hiddenStyles[rootStyleIndex].display = Display.None
  drop hiddenStyles
  run tree.markDirty(root)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(60.0, 40.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let hiddenChild = run output.sourceBounds(child)
  run Testing.expect(
    output.viewportOverflow.width == 60.0 && output.viewportOverflow.height == 40.0
      && output.firstBySource.get(root.index) == NO_NODE
      && output.firstBySource.get(child.index) == NO_NODE
      && hiddenChild.width == 0.0
      && hiddenChild.height == 0.0,
    "suppression clears prior overflow and generated boxes and uses the new viewport",
  )
  let contentsStyles = tree.styles.asMutSlice()
  contentsStyles[rootStyleIndex].display = Display.Contents
  drop contentsStyles
  run tree.markDirty(root)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(60.0, 40.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boxlessRoot = run output.sourceBounds(root)
  run Testing.expect(
    output.viewportOverflow.width == 300.0 && output.viewportOverflow.height == 200.0
      && output.firstBySource.get(root.index) == NO_NODE
      && output.firstBySource.get(child.index) != NO_NODE
      && boxlessRoot.width == 0.0
      && boxlessRoot.height == 0.0,
    "contents restores generated descendants without a root box",
  )
}


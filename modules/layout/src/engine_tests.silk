test effect fn positionedDescendantUsesNearestPositionedAncestorPaddingBox()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut rootStyle = Style.make()
  rootStyle.position = Position.Relative
  rootStyle.width = SizeValue.px(200.0)
  rootStyle.height = SizeValue.px(100.0)
  rootStyle.padding = Edges.all(Dimension.px(10.0))
  rootStyle.border = Edges.all(Dimension.px(2.0))
  let mut tree = run Tree.make(move rootStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut middleStyle = Style.make()
  middleStyle.margin.left = Dimension.px(30.0)
  middleStyle.height = SizeValue.px(20.0)
  let root = tree.root()
  let middle = run tree.append(root, move middleStyle)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut childStyle = Style.make()
  childStyle.position = Position.Absolute
  childStyle.width = SizeValue.pct(0.5)
  childStyle.height = SizeValue.px(5.0)
  childStyle.inset.left = Dimension.px(0.0)
  childStyle.inset.top = Dimension.px(0.0)
  let child = run tree.append(middle, move childStyle)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(500.0, 500.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rootBounds = run output.sourceBounds(root)
  let childBounds = run output.sourceBounds(child)
  run Testing.expect(
    childBounds.width == 110.0,
    "absolute percentage width uses ancestor padding width",
  )
  run Testing.expect(
    abs(childBounds.x - rootBounds.x - 2.0) < 0.000001,
    "absolute left is ancestor's inner border edge, not source parent's content edge",
  )
  run Testing.expect(
    abs(childBounds.y - rootBounds.y - 2.0) < 0.000001,
    "absolute top resolves to containing block",
  )
}


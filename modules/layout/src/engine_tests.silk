struct Content {
  minimum: f32,
  maximum: f32,
  height: f32
}

impl Measure for Content {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    drop provider
    drop request
    return FontMetrics.zero()
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    drop provider
    drop request
    return ScrollbarMetrics.zero()
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    drop key
    let mut ratio: f32 = 0.0
    if provider.height > 0.0 {
      ratio = provider.maximum / provider.height
    }
    return NaturalDimensions {
      size: OptionalSize.definite(provider.maximum, provider.height),
      aspectRatio: ratio,
    }
  }

  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    let mut width = provider.maximum
    if request.width.kind == AvailableKind.MinContent {
      width = provider.minimum
    }
    if request.width.kind == AvailableKind.Definite {
      width = max(provider.minimum, min(provider.maximum, request.width.value))
    }
    if request.known.widthDefinite {
      width = request.known.width
    }
    let mut height = provider.height
    if request.known.heightDefinite {
      height = request.known.height
    }
    return Measured {
      size: Size { width: width, height: height },
      scrollableOverflow: Rect {
        x: 0.0,
        y: 0.0,
        width: max(provider.minimum, width),
        height: provider.height,
      },
      contentBlockSize: height,
      firstBaselines: BaselineSet.uniform(height * 0.75),
      lastBaselines: BaselineSet.uniform(height * 0.75),
      hasBaseline: true,
      hasLineBoxes: true,
    }
  }
}

impl TextMeasure for Content {
  fn beginTextLayout(provider: &mut Self) {
    drop provider
  }

  effect fn analyze(
    provider: &mut Self,
    context: TextContext<'_, '_>,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    drop provider
    drop output
    let mut source = usize.MAX
    if context.tokens.length > 0 {
      source = context.tokens[0].source
    }
    fail TextError { source: source, message: "box-only fixture does not support text" }
  }

  effect fn shape(
    provider: &mut Self,
    request: TextShapeRequest<'_, '_>,
    output: &mut List<TextRun>,
  )
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    drop provider
    drop output
    let mut source = usize.MAX
    if request.start.unit < request.context.tokens.length {
      source = request.context.tokens[request.start.unit].source
    }
    fail TextError { source: source, message: "box-only fixture does not support text" }
  }
}

struct Paragraph {
  forced: bool,
  advance: f32,
  zeroHeight: bool,
  levelBoundary: bool
}

impl Measure for Paragraph {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    let mut font = FontMetrics.zero()
    if provider.zeroHeight {
      return font
    }
    font.fontSize = 10.0
    font.ascent = 8.0
    font.descent = 2.0
    font.baselines = BaselineSet.uniform(8.0)
    return font
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    return ScrollbarMetrics.zero()
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
    return Measure.natural(&mut content, key)
  }

  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
    return Measure.measure(&mut content, key, request)
  }
}

impl TextMeasure for Paragraph {
  fn beginTextLayout(provider: &mut Self) {}

  effect fn analyze(
    provider: &mut Self,
    context: TextContext<'_, '_>,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    if provider.forced {
      run output.append(
        TextBreak { at: TextCursor { unit: 2, offset: 0 }, kind: TextBreakKind.Forced },
      )
    }
    run output.append(
      TextBreak {
        at: TextCursor { unit: context.tokens.length, offset: 0 },
        kind: TextBreakKind.Soft,
      },
    )
    let mut analysis = TextAnalysis.uniform(context.tokens.length, 0, 0, true)
    if provider.levelBoundary {
      run analysis.levels.append(
        TextLevel {
          start: TextCursor { unit: 0, offset: 1 },
          end: TextCursor { unit: 0, offset: 3 },
          level: 1,
          unwrappedLevel: 1,
          removed: false,
        },
      )
    }
    return move analysis
  }

  effect fn shape(
    provider: &mut Self,
    request: TextShapeRequest<'_, '_>,
    output: &mut List<TextRun>,
  )
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    let mut unit = request.start.unit
    while unit < request.end.unit || (unit == request.end.unit && request.end.offset != 0) {
      let token = request.context.tokens[unit]
      if token.kind == TextTokenKind.Text || token.kind == TextTokenKind.Space
        || token.kind == TextTokenKind.Tab {
        let mut start: usize = 0
        let mut end = String.byteLength(token.text)
        if token.kind == TextTokenKind.Space {
          end = 1
        }
        if unit == request.start.unit {
          start = request.start.offset
        }
        if unit == request.end.unit {
          end = request.end.offset
        }
        let mut advance = usize.toF32(end - start) * provider.advance

        // This fixture's non-ASCII input consists of zero-width bidi controls.
        let bytes = String.utf8Bytes(token.text)
        if bytes.length != 0 && bytes[0] >= 0x80 {
          advance = 0.0
        }
        if token.kind == TextTokenKind.Tab {
          advance = 0.0
        }
        run output.append(
          TextRun.Text {
            unit: unit,
            start: start,
            end: end,
            advance: advance,
            fontKey: token.fontKey,
            bidiLevel: request.analysis.level,
            shapeKey: 0,
            unsafeBefore: false,
          },
        )
      }
      unit = unit + 1
    }

    // An ellipsis is "..." at the fixture's advance.
    if request.ellipsis && output.length() != 0 {
      let last = output.length() - 1
      match output.get(last) {
        TextRun.Text { unit: at, start, end, advance, fontKey, bidiLevel, shapeKey, unsafeBefore } => {
          output.set(
            last,
            TextRun.Text {
              unit: at,
              start: start,
              end: end,
              advance: advance + 3.0 * provider.advance,
              fontKey: fontKey,
              bidiLevel: bidiLevel,
              shapeKey: shapeKey,
              unsafeBefore: unsafeBefore,
            },
          )
        }
        _ => {}
      }
    }
  }
}

struct TabFont {
  paragraph: Paragraph,
  spaceAdvance: f32,
  zeroAdvance: f32
}

impl Measure for TabFont {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    let mut metrics = Measure.font(&mut provider.paragraph, request)
    metrics.spaceAdvance = provider.spaceAdvance
    metrics.zeroAdvance = provider.zeroAdvance
    return metrics
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    return Measure.scrollbars(&mut provider.paragraph, request)
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    return Measure.natural(&mut provider.paragraph, key)
  }

  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    return Measure.measure(&mut provider.paragraph, key, request)
  }
}

impl TextMeasure for TabFont {
  fn beginTextLayout(provider: &mut Self) {}

  effect fn analyze(
    provider: &mut Self,
    context: TextContext<'_, '_>,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    return run TextMeasure.analyze(&mut provider.paragraph, context, &mut output)
  }

  effect fn shape(
    provider: &mut Self,
    request: TextShapeRequest<'_, '_>,
    output: &mut List<TextRun>,
  )
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    run TextMeasure.shape(&mut provider.paragraph, request, &mut output)
  }
}

test effect fn tabStopsUseReplaceableSpaceAndZeroGlyphMetrics()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(100.0)
  style.whiteSpaceCollapse = WhiteSpaceCollapse.Preserve
  style.textWrap = TextWrap.NoWrap
  style.tabSize = TabSize.Number { value: 4.0 }
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let value = run String.copy("a\tb") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run tree.appendText(root, move value) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut provider = TabFont {
    paragraph: Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false },
    spaceAdvance: 7.0,
    zeroAdvance: 4.0,
  }
  run compute(&tree, &mut output, &mut provider, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    (run output.sourceBounds(text)).width == 33.0,
    "tab stops use measured space advance, not a fraction of font size",
  )
  provider.spaceAdvance = 3.0
  output.invalidate()
  run compute(&tree, &mut output, &mut provider, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    (run output.sourceBounds(text)).width == 17.0,
    "replacing space metrics recomputes tab stops without changing the source tree",
  )
  provider.zeroAdvance = 20.0
  output.invalidate()
  run compute(&tree, &mut output, &mut provider, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    (run output.sourceBounds(text)).width == 29.0,
    "half-ch clearance uses the replacement zero-glyph metric",
  )
}

// A tiny external Hebrew/Latin fixture shaper. SHY is Unicode BN, outside the
// CLI's bounded repertoire: the layout engine must use analysis metadata.
struct HyphenBidiText {
  metrics: Paragraph
}

impl Measure for HyphenBidiText {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    return Measure.font(&mut provider.metrics, request)
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    return Measure.scrollbars(&mut provider.metrics, request)
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    return Measure.natural(&mut provider.metrics, key)
  }

  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    return Measure.measure(&mut provider.metrics, key, request)
  }
}

impl TextMeasure for HyphenBidiText {
  fn beginTextLayout(provider: &mut Self) {}

  effect fn analyze(
    provider: &mut Self,
    context: TextContext<'_, '_>,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    let mut analysis = TextAnalysis.uniform(context.tokens.length, 1, 1, true)
    let mut unit: usize = 0
    while unit < context.tokens.length {
      let token = context.tokens[unit]
      if token.kind == TextTokenKind.Text {
        let bytes = String.utf8Bytes(token.text)
        if bytes.length == 6 && bytes[0] == 0xd7 && bytes[1] == 0x90 && bytes[2] == 97
          && bytes[3] == 98
          && bytes[4] == 0xc2
          && bytes[5] == 0xad {
          run analysis.levels.append(
            TextLevel {
              start: TextCursor { unit: unit, offset: 2 },
              end: TextCursor { unit: unit, offset: 4 },
              level: 2,
              unwrappedLevel: 2,
              removed: false,
            },
          )
          run analysis.levels.append(
            TextLevel {
              start: TextCursor { unit: unit, offset: 4 },
              end: TextCursor { unit: unit + 1, offset: 0 },
              level: 2,
              unwrappedLevel: 2,
              removed: true,
            },
          )
          run output.append(
            TextBreak {
              at: TextCursor { unit: unit + 1, offset: 0 },
              kind: TextBreakKind.Hyphenated,
            },
          )
        } else if bytes.length == 2 && bytes[0] == 99 && bytes[1] == 100 {
          run analysis.levels.append(
            TextLevel {
              start: TextCursor { unit: unit, offset: 0 },
              end: TextCursor { unit: unit + 1, offset: 0 },
              level: 2,
              unwrappedLevel: 2,
              removed: false,
            },
          )
        } else {
          fail TextError { source: token.source, message: "Unsupported Hebrew/Latin fixture text" }
        }
      }
      unit = unit + 1
    }
    run output.append(
      TextBreak {
        at: TextCursor { unit: context.tokens.length, offset: 0 },
        kind: TextBreakKind.Soft,
      },
    )
    return move analysis
  }

  effect fn shape(
    provider: &mut Self,
    request: TextShapeRequest<'_, '_>,
    output: &mut List<TextRun>,
  )
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    let mut unit = request.start.unit
    while unit < request.end.unit || (unit == request.end.unit && request.end.offset != 0) {
      let token = request.context.tokens[unit]
      if token.kind == TextTokenKind.Text {
        let bytes = String.utf8Bytes(token.text)
        let mut start: usize = 0
        let mut end = bytes.length
        if unit == request.start.unit {
          start = request.start.offset
        }
        if unit == request.end.unit {
          end = request.end.offset
        }
        while start < end {
          let cursor = TextCursor { unit: unit, offset: start }
          let boundary = request.analysis.boundaryAfter(cursor)
          let mut limit = end
          if boundary.unit == unit && boundary.offset < limit {
            limit = boundary.offset
          }
          let mut level = request.analysis.levelAt(cursor)
          let mut advance = usize.toF32(limit - start) * 5.0
          if start == 0 && bytes[0] == 0xd7 {
            advance = 5.0
          }
          if request.analysis.removedAt(cursor) {
            advance = 0.0
            if request.hyphenated {
              advance = 5.0
            }
            if boundary.equal(request.end) {
              level = request.analysis.paragraphAt(cursor).level
            }
          }
          run output.append(
            TextRun.Text {
              unit: unit,
              start: start,
              end: limit,
              advance: advance,
              fontKey: token.fontKey,
              bidiLevel: level,
              shapeKey: 0,
              unsafeBefore: false,
            },
          )
          start = limit
        }
      }
      unit = unit + 1
    }
  }
}

test effect fn removedBidiCharactersRetainDiscretionaryAdvanceAndStableFragments()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(20.0)
  style.direction = Direction.Rtl
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut inlineStyle = Style.make()
  inlineStyle.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
  inlineStyle.direction = Direction.Rtl
  let inline = run tree.append(root, move inlineStyle)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run String.copy("\u{05d0}ab\u{00ad}") |> Effect.provideMut<Allocator>(&mut allocator)
  let ownText = run tree.appendText(inline, move first)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run String.copy("cd") |> Effect.provideMut<Allocator>(&mut allocator)
  let foreign = run tree.appendText(root, move second)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut provider = HyphenBidiText {
    metrics: Paragraph { forced: false, advance: 5.0, zeroHeight: false, levelBoundary: false },
  }
  let mut output = LayoutTree.make()
  run compute(&tree, &mut output, &mut provider, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounds = run output.sourceBounds(ownText)
  run Testing.expect(
    bounds.x == 0.0 && bounds.width == 20.0 && bounds.height == 10.0,
    "the selected discretionary glyph retains five pixels of advance despite X9 removal",
  )
  let following = run output.sourceBounds(foreign)
  run Testing.expect(
    following.x == 10.0 && following.y == 10.0 && following.width == 10.0,
    "the foreign Latin run wraps without changing the paragraph's stable fragment identities",
  )
  let mut rectangles = run output.sourceRects(inline)
  let mut count: usize = 0
  while true {
    let rectangle = match move rectangles.next() {
      Option<Rect>.Some { value } => value
      Option<Rect>.None => {
        break
      }
    }
    if count == 0 {
      run Testing.expect(
        rectangle.x == 0.0 && rectangle.width == 15.0,
        "the Latin fragment includes its restored discretionary glyph",
      )
    } else {
      run Testing.expect(
        count == 1 && rectangle.x == 15.0 && rectangle.width == 5.0,
        "the Hebrew fragment remains separate after the foreign run wraps away",
      )
    }
    count = count + 1
  }
  run Testing.expect(
    count == 2,
    "wrapping must not merge the two paragraph-stable inline fragments",
  )
}

test effect fn textProviderReplacementClearsForcedLinesAndRecomputesAdvances()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(40.0)
  style.textWrap = TextWrap.NoWrap
  style.textAlignLast = TextAlign.Right
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let value = run String.copy("a b c") |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let text = run tree.appendText(root, move value) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut first = Paragraph { forced: true, advance: 5.0, zeroHeight: false, levelBoundary: false }
  run compute(&tree, &mut output, &mut first, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forced = run output.sourceBounds(text)
  run Testing.expect(
    forced.x == 25.0 && forced.width == 15.0 && forced.height == 20.0,
    "a forced break survives nowrap and applies last-line alignment before the paragraph end",
  )
  let mut replacement = Paragraph {
    forced: false,
    advance: 7.0,
    zeroHeight: false,
    levelBoundary: false,
  }
  output.invalidate()
  run compute(&tree, &mut output, &mut replacement, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let joined = run output.sourceBounds(text)
  run Testing.expect(
    joined.x == 5.0 && joined.width == 35.0 && joined.height == 10.0,
    "replacement text measurements discard previous fragments, line breaks, and advances without changing the source tree",
  )
}

test effect fn zeroHeightTextBoundsUseWholeLineNotFirstShapingRun()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(40.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let value = run String.copy("a b c") |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let text = run tree.appendText(root, move value) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut paragraph = Paragraph {
    forced: false,
    advance: 5.0,
    zeroHeight: true,
    levelBoundary: false,
  }
  run compute(&tree, &mut output, &mut paragraph, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounds = run output.sourceBounds(text)
  run Testing.expect(
    bounds.width == 25.0 && bounds.height == 0.0,
    "the first degenerate CSSOM text rectangle includes every shaping run on that line",
  )
}

test effect fn bidiControlsDoNotInterruptSpaceCollapsingButRemainText()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = SizeValue.px(100.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let first = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let value = run String.copy(
    "a \u{61c}\u{200e}\u{200f}\u{202a}\u{202b}\u{202c}\u{202d}\u{202e}\u{2066}\u{2067}\u{2068}\u{2069} b",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let words = run tree.appendText(first, move value) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let control = run String.copy("\u{200e}") |> Effect.provideMut<Allocator>(&mut allocator)
  let mark = run tree.appendText(second, move control)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut paragraph = Paragraph {
    forced: false,
    advance: 5.0,
    zeroHeight: false,
    levelBoundary: false,
  }
  run compute(&tree, &mut output, &mut paragraph, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wordBounds = run output.sourceBounds(words)
  let markBounds = run output.sourceBounds(mark)
  let rootBounds = run output.sourceBounds(root)
  run Testing.expect(
    wordBounds.width == 15.0 && wordBounds.height == 10.0,
    "Phase I ignores all twelve Bidi_Control characters when collapsing adjacent spaces",
  )
  run Testing.expect(
    markBounds.width == 0.0 && markBounds.height == 10.0 && rootBounds.height == 20.0,
    "a zero-advance formatting character still generates text and a non-phantom line",
  )
}

test effect fn shapingCannotEraseParagraphAnalysisBoundaries()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let value = run String.copy("abcd") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run tree.appendText(root, move value) |> Effect.provideMut<Allocator>(&mut allocator)
  let expectedSource = text.index
  let mut output = LayoutTree.make()
  let mut paragraph = Paragraph {
    forced: false,
    advance: 5.0,
    zeroHeight: false,
    levelBoundary: true,
  }
  let rejected = run compute(
    &tree,
    &mut output,
    &mut paragraph,
    OptionalSize.definite(100.0, 100.0),
  )
    |> Effect.map(
      |value: ()| -> bool {
        drop value
        return false
      },
    )
    |> Effect.catch<TextError>(
      effect |error: TextError| -> bool {
        return error.source == expectedSource
      },
    )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejected,
    "a shaping run that merges resolved intervals fails at the affected source",
  )
  paragraph.levelBoundary = false
  run compute(&tree, &mut output, &mut paragraph, OptionalSize.definite(100.0, 100.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounds = run output.sourceBounds(text)
  run Testing.expect(
    bounds.width == 20.0 && bounds.height == 10.0,
    "valid replacement analysis recomputes the same tree after a service error",
  )
}

test effect fn measurementProviderCanBeReplacedWithoutChangingTree()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.FlowRoot }
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  run tree.setMeasurement(root, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 120.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(80.0, 200.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = output.boxes.get(output.firstBySource.get(root.index))
  run Testing.expect(
    first.size.width == 80.0 && first.size.height == 18.0,
    "inline block shrink-to-fit uses provider's intrinsic widths",
  )
  content.maximum = 45.0
  content.height = 30.0

  // New content behind an unchanged measurement key is invisible to the tree.
  run tree.markDirty(root)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(80.0, 200.0))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = output.boxes.get(output.firstBySource.get(root.index))
  run Testing.expect(
    second.size.width == 45.0 && second.size.height == 30.0,
    "recomputation must not retain stale external measurements",
  )
}


import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.num.usize
import silk.num.f32
import silk.testing.testing { Testing, AssertionError }
import fragmentation { FragmentationError }
import style { Style, Edges, Dimension, SizeValue, Display, DisplayOutside, DisplayInside, TableLayout, BorderCollapse, VerticalAlignKind, Visibility }
import geometry { Measure, MeasureRequest, Measured, BaselineSet, NaturalDimensions, ScrollbarRequest, ScrollbarMetrics, FontRequest, FontMetrics, Size, Rect, OptionalSize, AvailableKind, max, abs }
import text { TextMeasure, TextError, TextContext, TextBreak, TextAnalysis, TextShapeRequest, TextRun }
import tree { Tree, LayoutTree, NodeId, InvalidNode }
import engine { compute }

// Measured cells stand in for text: key `min * 1000 + max` is a run whose words are
// `min` wide and whose whole line is `max` wide, wrapping into 20px lines.
struct WordHost {}
impl Measure for WordHost {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    drop provider
    drop request
    return FontMetrics.zero()
  }
  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    drop provider
    drop request
    return ScrollbarMetrics.zero()
  }
  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    drop provider
    drop key
    return NaturalDimensions.none()
  }
  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    drop provider
    let word = usize.toF32(key / 1000)
    let line = usize.toF32(key % 1000)
    let mut width = line
    if request.width.kind == AvailableKind.MinContent { width = word }
    if request.width.kind == AvailableKind.Definite { width = max(word, request.width.value) }
    if request.known.widthDefinite { width = request.known.width }
    let mut lines: f32 = 1.0
    if width > 0.0 && line > width { lines = f32.ceil(line / width) }
    let mut height = 20.0 * lines
    let content = height
    if request.known.heightDefinite { height = request.known.height }
    return Measured { size: Size { width: width, height: height }, scrollableOverflow: Rect { x: 0.0, y: 0.0, width: width, height: content }, contentBlockSize: content, firstBaselines: BaselineSet.uniform(15.0), lastBaselines: BaselineSet.uniform(15.0), hasBaseline: true, hasLineBoxes: true }
  }
}
impl TextMeasure for WordHost {
  fn beginTextLayout(provider: &mut Self) { drop provider }
  effect fn analyze(provider: &mut Self, context: TextContext<'_, '_>, output: &mut List<TextBreak>) -> TextAnalysis ! OutOfMemoryError | TextError ? &mut Allocator {
    drop provider
    drop output
    drop context
    fail TextError { source: usize.MAX, message: "table fixture has no text" }
  }
  effect fn shape(provider: &mut Self, request: TextShapeRequest<'_, '_>, output: &mut List<TextRun>) ! OutOfMemoryError | TextError ? &mut Allocator {
    drop provider
    drop output
    drop request
    fail TextError { source: usize.MAX, message: "table fixture has no text" }
  }
}

fn styled(inside: DisplayInside) -> Style {
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: inside }
  return move style
}
effect fn cell(tree: &mut Tree, parent: NodeId, word: usize, line: usize) -> NodeId ! OutOfMemoryError | InvalidNode ? &mut Allocator {
  let id = run tree.append(parent, styled(DisplayInside.TableCell))
  run tree.setMeasurement(id, word * 1000 + line)
  return id
}
effect fn spanning(tree: &mut Tree, parent: NodeId, word: usize, line: usize, columns: usize, rows: usize) -> NodeId ! OutOfMemoryError | InvalidNode ? &mut Allocator {
  let mut style = styled(DisplayInside.TableCell)
  style.columnSpan = columns
  style.rowSpan = rows
  let id = run tree.append(parent, move style)
  run tree.setMeasurement(id, word * 1000 + line)
  return id
}
effect fn expectBox(output: &LayoutTree, id: NodeId, x: f32, y: f32, width: f32, height: f32, message: string<'static>) ! InvalidNode | AssertionError<'static> {
  let actual = run output.sourceBounds(id)
  let close = abs(actual.x - x) < 0.01 && abs(actual.y - y) < 0.01 && abs(actual.width - width) < 0.01 && abs(actual.height - height) < 0.01
  run Testing.expect(close, message)
}
effect fn lay(tree: &Tree, output: &mut LayoutTree, width: f32) ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let mut host = WordHost {}
  run compute(&tree, &mut output, &mut host, OptionalSize.definite(width, 600.0))
}

// Two rows of two cells: columns take their widest cells, the table shrinks to fit,
// and space beyond the widest content goes to columns by their widths.
effect fn autoColumns() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let table = run tree.append(root, styled(DisplayInside.Table))
  let first = run tree.append(table, styled(DisplayInside.TableRow))
  let a = run cell(&mut tree, first, 20, 100)
  let b = run cell(&mut tree, first, 20, 50)
  let second = run tree.append(table, styled(DisplayInside.TableRow))
  let c = run cell(&mut tree, second, 30, 60)
  let d = run cell(&mut tree, second, 10, 40)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, table, 0.0, 0.0, 150.0, 40.0, "an auto table is as wide as its widest rows")
  run expectBox(&output, a, 0.0, 0.0, 100.0, 20.0, "the first column takes its widest cell")
  run expectBox(&output, b, 100.0, 0.0, 50.0, 20.0, "the second column follows")
  run expectBox(&output, c, 0.0, 20.0, 100.0, 20.0, "the second row shares the columns")
  run expectBox(&output, d, 100.0, 20.0, 50.0, 20.0, "and the second row's cells stretch to them")
  run expectBox(&output, second, 0.0, 20.0, 150.0, 20.0, "a row spans the table's columns")

  // Narrower than the widest content: columns sit between their minimums and maximums.
  run lay(&tree, &mut output, 100.0)
  run expectBox(&output, table, 0.0, 0.0, 100.0, 80.0, "a narrow table fills the space it has")
  run expectBox(&output, a, 0.0, 0.0, 65.0, 40.0, "columns share the space between minimum and maximum")
  run expectBox(&output, b, 65.0, 0.0, 35.0, 40.0, "and the row is as tall as its tallest cell")
  run expectBox(&output, d, 65.0, 40.0, 35.0, 40.0, "the second row starts below it")

  // A set width with spacing: extra space goes to the columns by their widths.
  let mut style = styled(DisplayInside.Table)
  style.width = SizeValue.px(300.0)
  style.borderSpacingX = 10.0
  style.borderSpacingY = 5.0
  run tree.setStyle(table, move style)
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, table, 0.0, 0.0, 300.0, 55.0, "spacing surrounds the rows")
  run expectBox(&output, a, 10.0, 5.0, 180.0, 20.0, "spacing comes before the first column")
  run expectBox(&output, b, 200.0, 5.0, 90.0, 20.0, "and between columns")
  run expectBox(&output, d, 200.0, 30.0, 90.0, 20.0, "and between rows")

  // A cell's content grows: the columns follow.
  run tree.setMeasurement(d, 10 * 1000 + 240)
  let mut plain = styled(DisplayInside.Table)
  plain.borderSpacingX = 10.0
  run tree.setStyle(table, move plain)
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, d, 120.0, 20.0, 240.0, 20.0, "a wider cell widens its column")
  run expectBox(&output, table, 0.0, 0.0, 370.0, 40.0, "and the table")
}

test effect fn tableAutoColumns() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run autoColumns() |> Effect.provideMut<Allocator>(&mut allocator)
}

// colspan and rowspan: a spanning cell spreads what its columns or rows lack, and
// later cells skip the slots it holds.
effect fn spans() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let table = run tree.append(root, styled(DisplayInside.Table))
  let body = run tree.append(table, styled(DisplayInside.TableRowGroup))
  let first = run tree.append(body, styled(DisplayInside.TableRow))
  let wide = run spanning(&mut tree, first, 0, 200, 2, 1)
  let tall = run spanning(&mut tree, first, 0, 50, 1, 2)
  let second = run tree.append(body, styled(DisplayInside.TableRow))
  let c = run cell(&mut tree, second, 0, 60)
  let d = run cell(&mut tree, second, 0, 60)
  let third = run tree.append(body, styled(DisplayInside.TableRow))
  let e = run spanning(&mut tree, third, 0, 10, 3, 1)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, wide, 0.0, 0.0, 200.0, 20.0, "a column span covers both columns")
  run expectBox(&output, c, 0.0, 20.0, 100.0, 20.0, "and spreads its width over them by their widths")
  run expectBox(&output, d, 100.0, 20.0, 100.0, 20.0, "evenly for even columns")
  run expectBox(&output, tall, 200.0, 0.0, 50.0, 40.0, "a row span covers both rows")
  run expectBox(&output, e, 0.0, 40.0, 250.0, 20.0, "a later full row takes every column")
  run expectBox(&output, body, 0.0, 0.0, 250.0, 60.0, "the row group holds its rows")
}

test effect fn tableSpans() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run spans() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The fixed layout reads only the first row's widths and splits the rest evenly.
effect fn fixedLayout() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let mut style = styled(DisplayInside.Table)
  style.width = SizeValue.px(400.0)
  style.tableLayout = TableLayout.Fixed
  let table = run tree.append(root, move style)
  let first = run tree.append(table, styled(DisplayInside.TableRow))
  let mut set = styled(DisplayInside.TableCell)
  set.width = SizeValue.px(100.0)
  let a = run tree.append(first, move set)
  let b = run cell(&mut tree, first, 0, 10)
  let c = run cell(&mut tree, first, 0, 900)
  let second = run tree.append(table, styled(DisplayInside.TableRow))
  let d = run cell(&mut tree, second, 0, 10)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, a, 0.0, 0.0, 100.0, 120.0, "a set width in the first row fixes its column")
  run expectBox(&output, b, 100.0, 0.0, 150.0, 120.0, "the other columns share what is left")
  run expectBox(&output, c, 250.0, 0.0, 150.0, 120.0, "whatever their content")
  run expectBox(&output, d, 0.0, 120.0, 100.0, 20.0, "later rows follow the first")
}

test effect fn tableFixedLayout() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fixedLayout() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Groups in order, captions, loose cells, collapsed borders and cell alignment.
effect fn partsAndBorders() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let table = run tree.append(root, styled(DisplayInside.Table))
  let footer = run tree.append(table, styled(DisplayInside.TableFooterGroup))
  let f = run cell(&mut tree, footer, 0, 40)
  let mut captionStyle = styled(DisplayInside.TableCaption)
  captionStyle.height = SizeValue.px(30.0)
  let caption = run tree.append(table, move captionStyle)
  let loose = run cell(&mut tree, table, 0, 40)
  let header = run tree.append(table, styled(DisplayInside.TableHeaderGroup))
  let h = run cell(&mut tree, header, 0, 40)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, caption, 0.0, 0.0, 40.0, 30.0, "a caption sits above the rows")
  run expectBox(&output, h, 0.0, 30.0, 40.0, 20.0, "the header group goes first")
  run expectBox(&output, loose, 0.0, 50.0, 40.0, 20.0, "a loose cell gets a row of its own")
  run expectBox(&output, f, 0.0, 70.0, 40.0, 20.0, "the footer group goes last")

  // Collapsed borders: neighbouring cells share their borders, and the outer ones the table's.
  let mut collapsed = styled(DisplayInside.Table)
  collapsed.borderCollapse = BorderCollapse.Collapse
  collapsed.border = Edges.all(Dimension.px(1.0))
  collapsed.padding = Edges.all(Dimension.px(9.0))
  let grid = run tree.append(root, move collapsed)
  let row = run tree.append(grid, styled(DisplayInside.TableRow))
  let mut left = styled(DisplayInside.TableCell)
  left.border = Edges.all(Dimension.px(1.0))
  left.width = SizeValue.px(20.0)
  left.height = SizeValue.px(60.0)
  let l = run tree.append(row, move left)
  let mut right = styled(DisplayInside.TableCell)
  right.border = Edges.all(Dimension.px(1.0))
  right.width = SizeValue.px(20.0)
  right.verticalAlign.kind = VerticalAlignKind.Middle
  let r = run tree.append(row, move right)
  let mut inner = Style.make()
  inner.height = SizeValue.px(20.0)
  let content = run tree.append(r, move inner)
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, l, 0.5, 90.5, 21.0, 61.0, "an outer cell keeps half the border it shares with the table")
  run expectBox(&output, r, 21.5, 90.5, 21.0, 61.0, "and half the one it shares with its neighbour")
  run expectBox(&output, grid, 0.0, 90.0, 43.0, 62.0, "a collapsed table has no padding")
  run expectBox(&output, content, 22.0, 111.0, 20.0, 20.0, "vertical-align: middle centres a cell's content")
}

test effect fn tablePartsAndBorders() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run partsAndBorders() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn percentCell(tree: &mut Tree, parent: NodeId, word: usize, percent: f32) -> NodeId ! OutOfMemoryError | InvalidNode ? &mut Allocator {
  let mut style = styled(DisplayInside.TableCell)
  style.width = SizeValue.pct(percent)
  let id = run tree.append(parent, move style)
  run tree.setMeasurement(id, word * 1000 + word)
  return id
}
fn sizedTable(width: f32, spacing: f32) -> Style {
  let mut style = styled(DisplayInside.Table)
  if width > 0.0 { style.width = SizeValue.px(width) }
  style.borderSpacingX = spacing
  style.borderSpacingY = spacing
  return move style
}

// Percentage widths, as Chromium lays them out: a percentage column gets its share
// of the grid, widening an auto table so the other columns keep their widths.
effect fn percentages() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let auto = run tree.append(root, sizedTable(0.0, 0.0))
  let row = run tree.append(auto, styled(DisplayInside.TableRow))
  let a = run percentCell(&mut tree, row, 30, 0.25)
  let b = run cell(&mut tree, row, 100, 100)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, auto, 0.0, 0.0, 133.333, 20.0, "an auto table widens so its percentage columns get their share")
  run expectBox(&output, a, 0.0, 0.0, 33.333, 20.0, "a 25% column takes a quarter")
  run expectBox(&output, b, 33.333, 0.0, 100.0, 20.0, "and the auto column its maximum")
  run tree.setStyle(auto, sizedTable(400.0, 0.0))
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, a, 0.0, 0.0, 100.0, 20.0, "a percentage of a set width")
  run expectBox(&output, b, 100.0, 0.0, 300.0, 20.0, "leaves the rest to auto columns")
  run tree.remove(auto)

  // Percentages resolve against the width inside the spacing.
  let spaced = run tree.append(root, sizedTable(400.0, 4.0))
  let row2 = run tree.append(spaced, styled(DisplayInside.TableRow))
  let c = run percentCell(&mut tree, row2, 30, 0.25)
  let d = run percentCell(&mut tree, row2, 10, 0.5)
  let e = run cell(&mut tree, row2, 20, 20)
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, c, 4.0, 4.0, 96.0, 20.0, "spacing is not part of the percentage basis")
  run expectBox(&output, d, 104.0, 4.0, 192.0, 20.0, "half of the grid")
  run expectBox(&output, e, 300.0, 4.0, 96.0, 20.0, "and the rest")
  run tree.remove(spaced)

  // More than 100%: the later percentage is cut, and too little room shares it out.
  let over = run tree.append(root, sizedTable(0.0, 0.0))
  let row3 = run tree.append(over, styled(DisplayInside.TableRow))
  let f = run percentCell(&mut tree, row3, 30, 0.5)
  let g = run percentCell(&mut tree, row3, 10, 0.7)
  let h = run cell(&mut tree, row3, 20, 20)
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, over, 0.0, 0.0, 400.0, 20.0, "percentages of 100% leave an auto table all the room")
  run expectBox(&output, f, 0.0, 0.0, 190.5556, 20.0, "percentage columns grow from their minimums toward their shares")
  run expectBox(&output, g, 190.5556, 0.0, 189.4444, 20.0, "a percentage past 100% is cut to what is left")
  run expectBox(&output, h, 380.0, 0.0, 20.0, 20.0, "an auto column keeps its minimum")
  run tree.remove(over)

  // A spanning cell's percentage spreads over its columns; a percentage never goes below the minimum.
  let spans = run tree.append(root, sizedTable(0.0, 0.0))
  let top = run tree.append(spans, styled(DisplayInside.TableRow))
  let mut wide = styled(DisplayInside.TableCell)
  wide.width = SizeValue.pct(0.6)
  wide.columnSpan = 2
  let i = run tree.append(top, move wide)
  run tree.setMeasurement(i, 30 * 1000 + 30)
  let j = run cell(&mut tree, top, 40, 40)
  let bottom = run tree.append(spans, styled(DisplayInside.TableRow))
  let k = run cell(&mut tree, bottom, 10, 10)
  let l = run cell(&mut tree, bottom, 10, 10)
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, i, 0.0, 0.0, 60.0, 20.0, "a spanning 60% cell")
  run expectBox(&output, j, 60.0, 0.0, 40.0, 20.0, "beside a column of 40")
  run expectBox(&output, k, 0.0, 20.0, 30.0, 20.0, "shares its percentage over its columns")
  run expectBox(&output, l, 30.0, 20.0, 30.0, 20.0, "by their maximums")
  run tree.remove(spans)

  let floor = run tree.append(root, sizedTable(400.0, 0.0))
  let row4 = run tree.append(floor, styled(DisplayInside.TableRow))
  let mut padded = styled(DisplayInside.TableCell)
  padded.width = SizeValue.pct(0.1)
  padded.padding.left = Dimension.px(10.0)
  padded.padding.right = Dimension.px(10.0)
  let m = run tree.append(row4, move padded)
  run tree.setMeasurement(m, 100 * 1000 + 100)
  let mut set = styled(DisplayInside.TableCell)
  set.width = SizeValue.px(100.0)
  let n = run tree.append(row4, move set)
  let o = run cell(&mut tree, row4, 0, 0)
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, m, 0.0, 0.0, 120.0, 20.0, "a percentage below the content's minimum takes the minimum")
  run expectBox(&output, n, 120.0, 0.0, 100.0, 20.0, "a length column keeps its width")
  run expectBox(&output, o, 220.0, 0.0, 180.0, 20.0, "and an auto column takes the rest")
  run tree.remove(floor)

  // The fixed layout: a column's percentage of the table, a spanning cell's split evenly.
  let mut fixedStyle = sizedTable(300.0, 0.0)
  fixedStyle.tableLayout = TableLayout.Fixed
  let fixed = run tree.append(root, move fixedStyle)
  let mut columnStyle = styled(DisplayInside.TableColumn)
  columnStyle.width = SizeValue.pct(0.2)
  drop run tree.append(fixed, move columnStyle)
  let row5 = run tree.append(fixed, styled(DisplayInside.TableRow))
  let p = run cell(&mut tree, row5, 30, 30)
  let mut fifty = styled(DisplayInside.TableCell)
  fifty.width = SizeValue.px(50.0)
  let q = run tree.append(row5, move fifty)
  let r = run cell(&mut tree, row5, 20, 20)
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, p, 0.0, 0.0, 60.0, 20.0, "a 20% column of a fixed table")
  run expectBox(&output, q, 60.0, 0.0, 50.0, 20.0, "a length cell")
  run expectBox(&output, r, 110.0, 0.0, 190.0, 20.0, "and the rest")
  run tree.remove(fixed)

  let mut halfStyle = sizedTable(200.0, 0.0)
  halfStyle.tableLayout = TableLayout.Fixed
  let half = run tree.append(root, move halfStyle)
  let row6 = run tree.append(half, styled(DisplayInside.TableRow))
  let mut spanStyle = styled(DisplayInside.TableCell)
  spanStyle.width = SizeValue.pct(0.5)
  spanStyle.columnSpan = 2
  let s = run tree.append(row6, move spanStyle)
  drop run cell(&mut tree, row6, 10, 10)
  let row7 = run tree.append(half, styled(DisplayInside.TableRow))
  let t = run cell(&mut tree, row7, 10, 10)
  let u = run cell(&mut tree, row7, 10, 10)
  let v = run cell(&mut tree, row7, 10, 10)
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, s, 0.0, 0.0, 100.0, 20.0, "a spanning 50% cell in a fixed table")
  run expectBox(&output, t, 0.0, 20.0, 50.0, 20.0, "splits over its columns")
  run expectBox(&output, u, 50.0, 20.0, 50.0, 20.0, "evenly")
  run expectBox(&output, v, 100.0, 20.0, 100.0, 20.0, "and the free column takes the rest")
}

test effect fn tablePercentages() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run percentages() |> Effect.provideMut<Allocator>(&mut allocator)
}

// `visibility: collapse` rows and columns take no room and one spacing less, and
// their cells still size the columns; a collapsed column narrows the table.
effect fn collapsedTracks() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let table = run tree.append(root, sizedTable(0.0, 4.0))
  let first = run tree.append(table, styled(DisplayInside.TableRow))
  let a = run cell(&mut tree, first, 30, 30)
  let b = run cell(&mut tree, first, 40, 40)
  let mut hidden = styled(DisplayInside.TableRow)
  hidden.visibility = Visibility.Collapse
  let second = run tree.append(table, move hidden)
  let c = run cell(&mut tree, second, 80, 80)
  let third = run tree.append(table, styled(DisplayInside.TableRow))
  let d = run cell(&mut tree, third, 10, 10)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, a, 4.0, 4.0, 80.0, 20.0, "a collapsed row's cells still size the columns")
  run expectBox(&output, b, 88.0, 4.0, 40.0, 20.0, "the next column follows")
  run expectBox(&output, second, 4.0, 24.0, 124.0, 0.0, "a collapsed row has no height and no spacing before it")
  run expectBox(&output, c, 4.0, 24.0, 80.0, 0.0, "nor do its cells")
  run expectBox(&output, d, 4.0, 28.0, 80.0, 20.0, "the next row follows one spacing on")
  run expectBox(&output, table, 0.0, 0.0, 132.0, 52.0, "the table loses the row and a spacing")
  run tree.remove(table)
  output = LayoutTree.make()

  let columns = run tree.append(root, sizedTable(0.0, 4.0))
  drop run tree.append(columns, styled(DisplayInside.TableColumn))
  let mut gone = styled(DisplayInside.TableColumn)
  gone.visibility = Visibility.Collapse
  let col = run tree.append(columns, move gone)
  drop run tree.append(columns, styled(DisplayInside.TableColumn))
  let row = run tree.append(columns, styled(DisplayInside.TableRow))
  let e = run cell(&mut tree, row, 30, 30)
  let f = run cell(&mut tree, row, 40, 40)
  let g = run cell(&mut tree, row, 40, 40)
  let next = run tree.append(columns, styled(DisplayInside.TableRow))
  let mut span = styled(DisplayInside.TableCell)
  span.columnSpan = 2
  let h = run tree.append(next, move span)
  run tree.setMeasurement(h, 100 * 1000 + 100)
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, e, 4.0, 4.0, 41.1429, 20.0, "columns are sized before one collapses")
  run expectBox(&output, f, 45.1429, 4.0, 0.0, 20.0, "a collapsed column has no width")
  run expectBox(&output, col, 45.1429, 4.0, 0.0, 84.0, "and no spacing before it")
  run expectBox(&output, g, 49.1429, 4.0, 40.0, 20.0, "the next column follows one spacing on")
  run expectBox(&output, h, 4.0, 28.0, 41.1429, 60.0, "a spanning cell loses the collapsed column")
  run expectBox(&output, columns, 0.0, 0.0, 93.1429, 92.0, "and the table its width")
}

test effect fn tableCollapsedTracks() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run collapsedTracks() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn bordered(inside: DisplayInside, width: f32) -> Style {
  let mut style = styled(inside)
  style.border = Edges.all(Dimension.px(width))
  return move style
}

// Collapsed borders resolve per grid line (CSS 2 §17.6.2.1): the widest wins, a hidden
// one suppresses all, and each cell and the table get half of the winning widths.
effect fn borderConflicts() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let mut tableStyle = bordered(DisplayInside.Table, 4.0)
  tableStyle.borderCollapse = BorderCollapse.Collapse
  let table = run tree.append(root, move tableStyle)
  let first = run tree.append(table, styled(DisplayInside.TableRow))
  let mut thin = bordered(DisplayInside.TableCell, 2.0)
  thin.width = SizeValue.px(50.0)
  thin.height = SizeValue.px(20.0)
  let a = run tree.append(first, move thin)
  let mut thick = bordered(DisplayInside.TableCell, 10.0)
  thick.width = SizeValue.px(50.0)
  thick.height = SizeValue.px(20.0)
  let b = run tree.append(first, move thick)
  let second = run tree.append(table, styled(DisplayInside.TableRow))
  let c = run tree.append(second, bordered(DisplayInside.TableCell, 1.0))
  run tree.setMeasurement(c, 0)
  let d = run tree.append(second, bordered(DisplayInside.TableCell, 3.0))
  run tree.setMeasurement(d, 0)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, table, 0.0, 0.0, 124.0, 64.0, "the table holds half its widest outer borders")
  run expectBox(&output, a, 2.0, 5.0, 57.0, 30.0, "a thin cell gives way to the table and to its thick neighbour")
  run expectBox(&output, b, 59.0, 5.0, 60.0, 30.0, "a thick cell keeps half of its own borders")
  run expectBox(&output, c, 2.0, 35.0, 57.0, 27.0, "a thinner cell below takes the wider borders above and outside it")
  run expectBox(&output, d, 59.0, 35.0, 60.0, 27.0, "and so does its neighbour")
  run tree.remove(table)

  let mut hiddenStyle = bordered(DisplayInside.Table, 5.0)
  hiddenStyle.borderCollapse = BorderCollapse.Collapse
  hiddenStyle.borderHidden = 15
  let hiddenTable = run tree.append(root, move hiddenStyle)
  let row = run tree.append(hiddenTable, styled(DisplayInside.TableRow))
  let e = run tree.append(row, bordered(DisplayInside.TableCell, 3.0))
  run tree.setMeasurement(e, 10 * 1000 + 10)
  let mut right = styled(DisplayInside.TableCell)
  right.border.left = Dimension.px(7.0)
  right.border.right = Dimension.px(2.0)
  right.borderHidden = 8
  let f = run tree.append(row, move right)
  run tree.setMeasurement(f, 10 * 1000 + 10)
  run lay(&tree, &mut output, 400.0)
  run expectBox(&output, hiddenTable, 0.0, 0.0, 20.0, 20.0, "a hidden table border hides every outer border")
  run expectBox(&output, e, 0.0, 0.0, 10.0, 20.0, "and a hidden cell side its neighbour's")
  run expectBox(&output, f, 10.0, 0.0, 10.0, 20.0, "so the cells have no borders")
}

test effect fn tableBorderConflicts() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run borderConflicts() |> Effect.provideMut<Allocator>(&mut allocator)
}

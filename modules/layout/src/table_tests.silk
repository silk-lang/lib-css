import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.num.usize
import silk.num.f32
import silk.testing.testing { Testing, AssertionError }
import fragmentation { FragmentationError }
import style { Style, Edges, Dimension, SizeValue, Display, DisplayOutside, DisplayInside, TableLayout, BorderCollapse, VerticalAlignKind }
import geometry { Measure, MeasureRequest, Measured, BaselineSet, NaturalDimensions, ScrollbarRequest, ScrollbarMetrics, FontRequest, FontMetrics, Size, Rect, OptionalSize, AvailableKind, max, abs }
import text { TextMeasure, TextError, TextContext, TextBreak, TextAnalysis, TextShapeRequest, TextRun }
import tree { Tree, LayoutTree, NodeId, InvalidNode }
import engine { compute }

// Measured cells stand in for text: key `min * 1000 + max` is a run whose words are
// `min` wide and whose whole line is `max` wide, wrapping into 20px lines.
struct WordHost {}
impl Measure for WordHost {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    drop provider
    drop request
    return FontMetrics.zero()
  }
  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    drop provider
    drop request
    return ScrollbarMetrics.zero()
  }
  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    drop provider
    drop key
    return NaturalDimensions.none()
  }
  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    drop provider
    let word = usize.toF32(key / 1000)
    let line = usize.toF32(key % 1000)
    let mut width = line
    if request.width.kind == AvailableKind.MinContent { width = word }
    if request.width.kind == AvailableKind.Definite { width = max(word, request.width.value) }
    if request.known.widthDefinite { width = request.known.width }
    let mut lines: f32 = 1.0
    if width > 0.0 && line > width { lines = f32.ceil(line / width) }
    let mut height = 20.0 * lines
    let content = height
    if request.known.heightDefinite { height = request.known.height }
    return Measured { size: Size { width: width, height: height }, scrollableOverflow: Rect { x: 0.0, y: 0.0, width: width, height: content }, contentBlockSize: content, firstBaselines: BaselineSet.uniform(15.0), lastBaselines: BaselineSet.uniform(15.0), hasBaseline: true, hasLineBoxes: true }
  }
}
impl TextMeasure for WordHost {
  fn beginTextLayout(provider: &mut Self) { drop provider }
  effect fn analyze(provider: &mut Self, context: TextContext<'_, '_>, output: &mut List<TextBreak>) -> TextAnalysis ! OutOfMemoryError | TextError ? &mut Allocator {
    drop provider
    drop output
    drop context
    fail TextError { source: usize.MAX, message: "table fixture has no text" }
  }
  effect fn shape(provider: &mut Self, request: TextShapeRequest<'_, '_>, output: &mut List<TextRun>) ! OutOfMemoryError | TextError ? &mut Allocator {
    drop provider
    drop output
    drop request
    fail TextError { source: usize.MAX, message: "table fixture has no text" }
  }
}

fn styled(inside: DisplayInside) -> Style {
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: inside }
  return move style
}
effect fn cell(tree: &mut Tree, parent: NodeId, word: usize, line: usize) -> NodeId ! OutOfMemoryError | InvalidNode ? &mut Allocator {
  let id = run tree.append(parent, styled(DisplayInside.TableCell))
  run tree.setMeasurement(id, word * 1000 + line)
  return id
}
effect fn spanning(tree: &mut Tree, parent: NodeId, word: usize, line: usize, columns: usize, rows: usize) -> NodeId ! OutOfMemoryError | InvalidNode ? &mut Allocator {
  let mut style = styled(DisplayInside.TableCell)
  style.columnSpan = columns
  style.rowSpan = rows
  let id = run tree.append(parent, move style)
  run tree.setMeasurement(id, word * 1000 + line)
  return id
}
effect fn expectBox(output: &LayoutTree, id: NodeId, x: f32, y: f32, width: f32, height: f32, message: string<'static>) ! InvalidNode | AssertionError<'static> {
  let actual = run output.sourceBounds(id)
  let close = abs(actual.x - x) < 0.01 && abs(actual.y - y) < 0.01 && abs(actual.width - width) < 0.01 && abs(actual.height - height) < 0.01
  run Testing.expect(close, message)
}
effect fn lay(tree: &Tree, output: &mut LayoutTree, width: f32) ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let mut host = WordHost {}
  run compute(&tree, &mut output, &mut host, OptionalSize.definite(width, 600.0))
}

// Two rows of two cells: columns take their widest cells, the table shrinks to fit,
// and space beyond the widest content goes to columns by their widths.
effect fn autoColumns() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let table = run tree.append(root, styled(DisplayInside.Table))
  let first = run tree.append(table, styled(DisplayInside.TableRow))
  let a = run cell(&mut tree, first, 20, 100)
  let b = run cell(&mut tree, first, 20, 50)
  let second = run tree.append(table, styled(DisplayInside.TableRow))
  let c = run cell(&mut tree, second, 30, 60)
  let d = run cell(&mut tree, second, 10, 40)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, table, 0.0, 0.0, 150.0, 40.0, "an auto table is as wide as its widest rows")
  run expectBox(&output, a, 0.0, 0.0, 100.0, 20.0, "the first column takes its widest cell")
  run expectBox(&output, b, 100.0, 0.0, 50.0, 20.0, "the second column follows")
  run expectBox(&output, c, 0.0, 20.0, 100.0, 20.0, "the second row shares the columns")
  run expectBox(&output, d, 100.0, 20.0, 50.0, 20.0, "and the second row's cells stretch to them")
  run expectBox(&output, second, 0.0, 20.0, 150.0, 20.0, "a row spans the table's columns")

  // Narrower than the widest content: columns sit between their minimums and maximums.
  run lay(&tree, &mut output, 100.0)
  run expectBox(&output, table, 0.0, 0.0, 100.0, 80.0, "a narrow table fills the space it has")
  run expectBox(&output, a, 0.0, 0.0, 65.0, 40.0, "columns share the space between minimum and maximum")
  run expectBox(&output, b, 65.0, 0.0, 35.0, 40.0, "and the row is as tall as its tallest cell")
  run expectBox(&output, d, 65.0, 40.0, 35.0, 40.0, "the second row starts below it")

  // A set width with spacing: extra space goes to the columns by their widths.
  let mut style = styled(DisplayInside.Table)
  style.width = SizeValue.px(300.0)
  style.borderSpacingX = 10.0
  style.borderSpacingY = 5.0
  run tree.setStyle(table, move style)
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, table, 0.0, 0.0, 300.0, 55.0, "spacing surrounds the rows")
  run expectBox(&output, a, 10.0, 5.0, 180.0, 20.0, "spacing comes before the first column")
  run expectBox(&output, b, 200.0, 5.0, 90.0, 20.0, "and between columns")
  run expectBox(&output, d, 200.0, 30.0, 90.0, 20.0, "and between rows")

  // A cell's content grows: the columns follow.
  run tree.setMeasurement(d, 10 * 1000 + 240)
  let mut plain = styled(DisplayInside.Table)
  plain.borderSpacingX = 10.0
  run tree.setStyle(table, move plain)
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, d, 120.0, 20.0, 240.0, 20.0, "a wider cell widens its column")
  run expectBox(&output, table, 0.0, 0.0, 370.0, 40.0, "and the table")
}

test effect fn tableAutoColumns() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run autoColumns() |> Effect.provideMut<Allocator>(&mut allocator)
}

// colspan and rowspan: a spanning cell spreads what its columns or rows lack, and
// later cells skip the slots it holds.
effect fn spans() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let table = run tree.append(root, styled(DisplayInside.Table))
  let body = run tree.append(table, styled(DisplayInside.TableRowGroup))
  let first = run tree.append(body, styled(DisplayInside.TableRow))
  let wide = run spanning(&mut tree, first, 0, 200, 2, 1)
  let tall = run spanning(&mut tree, first, 0, 50, 1, 2)
  let second = run tree.append(body, styled(DisplayInside.TableRow))
  let c = run cell(&mut tree, second, 0, 60)
  let d = run cell(&mut tree, second, 0, 60)
  let third = run tree.append(body, styled(DisplayInside.TableRow))
  let e = run spanning(&mut tree, third, 0, 10, 3, 1)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, wide, 0.0, 0.0, 200.0, 20.0, "a column span covers both columns")
  run expectBox(&output, c, 0.0, 20.0, 100.0, 20.0, "and spreads its width over them by their widths")
  run expectBox(&output, d, 100.0, 20.0, 100.0, 20.0, "evenly for even columns")
  run expectBox(&output, tall, 200.0, 0.0, 50.0, 40.0, "a row span covers both rows")
  run expectBox(&output, e, 0.0, 40.0, 250.0, 20.0, "a later full row takes every column")
  run expectBox(&output, body, 0.0, 0.0, 250.0, 60.0, "the row group holds its rows")
}

test effect fn tableSpans() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run spans() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The fixed layout reads only the first row's widths and splits the rest evenly.
effect fn fixedLayout() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let mut style = styled(DisplayInside.Table)
  style.width = SizeValue.px(400.0)
  style.tableLayout = TableLayout.Fixed
  let table = run tree.append(root, move style)
  let first = run tree.append(table, styled(DisplayInside.TableRow))
  let mut set = styled(DisplayInside.TableCell)
  set.width = SizeValue.px(100.0)
  let a = run tree.append(first, move set)
  let b = run cell(&mut tree, first, 0, 10)
  let c = run cell(&mut tree, first, 0, 900)
  let second = run tree.append(table, styled(DisplayInside.TableRow))
  let d = run cell(&mut tree, second, 0, 10)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, a, 0.0, 0.0, 100.0, 120.0, "a set width in the first row fixes its column")
  run expectBox(&output, b, 100.0, 0.0, 150.0, 120.0, "the other columns share what is left")
  run expectBox(&output, c, 250.0, 0.0, 150.0, 120.0, "whatever their content")
  run expectBox(&output, d, 0.0, 120.0, 100.0, 20.0, "later rows follow the first")
}

test effect fn tableFixedLayout() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fixedLayout() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Groups in order, captions, loose cells, collapsed borders and cell alignment.
effect fn partsAndBorders() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let table = run tree.append(root, styled(DisplayInside.Table))
  let footer = run tree.append(table, styled(DisplayInside.TableFooterGroup))
  let f = run cell(&mut tree, footer, 0, 40)
  let mut captionStyle = styled(DisplayInside.TableCaption)
  captionStyle.height = SizeValue.px(30.0)
  let caption = run tree.append(table, move captionStyle)
  let loose = run cell(&mut tree, table, 0, 40)
  let header = run tree.append(table, styled(DisplayInside.TableHeaderGroup))
  let h = run cell(&mut tree, header, 0, 40)
  let mut output = LayoutTree.make()
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, caption, 0.0, 0.0, 40.0, 30.0, "a caption sits above the rows")
  run expectBox(&output, h, 0.0, 30.0, 40.0, 20.0, "the header group goes first")
  run expectBox(&output, loose, 0.0, 50.0, 40.0, 20.0, "a loose cell gets a row of its own")
  run expectBox(&output, f, 0.0, 70.0, 40.0, 20.0, "the footer group goes last")

  // Collapsed borders: neighbouring cells share their borders, and the outer ones the table's.
  let mut collapsed = styled(DisplayInside.Table)
  collapsed.borderCollapse = BorderCollapse.Collapse
  collapsed.border = Edges.all(Dimension.px(1.0))
  collapsed.padding = Edges.all(Dimension.px(9.0))
  let grid = run tree.append(root, move collapsed)
  let row = run tree.append(grid, styled(DisplayInside.TableRow))
  let mut left = styled(DisplayInside.TableCell)
  left.border = Edges.all(Dimension.px(1.0))
  left.width = SizeValue.px(20.0)
  left.height = SizeValue.px(60.0)
  let l = run tree.append(row, move left)
  let mut right = styled(DisplayInside.TableCell)
  right.border = Edges.all(Dimension.px(1.0))
  right.width = SizeValue.px(20.0)
  right.verticalAlign.kind = VerticalAlignKind.Middle
  let r = run tree.append(row, move right)
  let mut inner = Style.make()
  inner.height = SizeValue.px(20.0)
  let content = run tree.append(r, move inner)
  run lay(&tree, &mut output, 500.0)
  run expectBox(&output, l, 0.0, 90.0, 22.0, 62.0, "an outer cell's border lies on the table's")
  run expectBox(&output, r, 21.0, 90.0, 22.0, 62.0, "a cell's border lies on its neighbour's")
  run expectBox(&output, grid, 0.0, 90.0, 43.0, 62.0, "a collapsed table has no padding")
  run expectBox(&output, content, 22.0, 111.0, 20.0, 20.0, "vertical-align: middle centres a cell's content")
}

test effect fn tablePartsAndBorders() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run partsAndBorders() |> Effect.provideMut<Allocator>(&mut allocator)
}

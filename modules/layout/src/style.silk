// The value types live in css-properties; they are re-exported here so `import style { ... }`
// keeps working inside css-layout and `layout.lib` keeps exporting them.
pub import properties.computed {
  DimensionKind,
  Dimension,
  Edges,
  DisplayOutside,
  DisplayInside,
  Display,
  BoxSizing,
  Direction,
  UnicodeBidi,
  WritingMode,
  TextOrientation,
  FlexDirection,
  FlexWrap,
  Align,
  OverflowAlignment,
  Overflow,
  ScrollbarWidth,
  ScrollbarGutter,
  Position,
  Float,
  Clear,
  Visibility,
  LineHeight,
  VerticalAlignKind,
  VerticalAlign,
  BaselineSource,
  TextAlign,
  TextJustify,
  TextWrap,
  WhiteSpaceCollapse,
  TabSize,
  TextIndent,
  BoxDecorationBreak,
  MarginBreak,
  BreakBetween,
  BreakInside,
}
import silk.core.ownership { Copy }
import silk.core.equal { Equal }
import silk.core.reflect { Reflect }

fn sameField<V: Equal>(left: &V, right: &V) -> bool { return left == right }

pub struct Style {
  pub display: Display,
  // Tree-managed handle, never a transferable template value. setStyle preserves
  // it; use Tree.setGrid to replace/reset owned grid data.
  pub grid: usize,
  pub width: Dimension, pub height: Dimension,
  pub minWidth: Dimension, pub minHeight: Dimension,
  pub maxWidth: Dimension, pub maxHeight: Dimension,
  pub margin: Edges, pub padding: Edges, pub border: Edges, pub inset: Edges,
  pub boxSizing: BoxSizing,
  pub direction: Direction, pub unicodeBidi: UnicodeBidi, pub writingMode: WritingMode, pub textOrientation: TextOrientation,
  pub fontKey: usize, pub lineHeight: LineHeight,
  pub verticalAlign: VerticalAlign, pub baselineSource: BaselineSource,
  pub textAlign: TextAlign, pub textAlignLast: TextAlign, pub textWrap: TextWrap,
  pub textJustify: TextJustify,
  pub textIndent: TextIndent,
  pub whiteSpaceCollapse: WhiteSpaceCollapse, pub tabSize: TabSize,
  pub boxDecorationBreak: BoxDecorationBreak,
  pub marginBreak: MarginBreak,
  pub breakBefore: BreakBetween, pub breakAfter: BreakBetween, pub breakInside: BreakInside,
  pub orphans: usize, pub widows: usize,
  pub flexDirection: FlexDirection, pub flexWrap: FlexWrap,
  pub flexGrow: f32, pub flexShrink: f32, pub flexBasis: Dimension,
  pub order: i32,
  pub justifyContent: Align, pub alignItems: Align, pub alignSelf: Align, pub alignContent: Align,
  pub justifySelf: Align, pub justifyItems: Align,
  pub justifyContentSafety: OverflowAlignment, pub alignContentSafety: OverflowAlignment,
  pub alignItemsSafety: OverflowAlignment, pub alignSelfSafety: OverflowAlignment,
  pub justifySelfSafety: OverflowAlignment, pub justifyItemsSafety: OverflowAlignment,
  pub rowGap: Dimension, pub columnGap: Dimension,
  pub overflowX: Overflow, pub overflowY: Overflow,
  pub scrollbarWidth: ScrollbarWidth, pub scrollbarGutter: ScrollbarGutter,
  pub position: Position, pub float: Float, pub clear: Clear,
  pub visibility: Visibility,
  pub aspectRatio: f32, pub aspectRatioAuto: bool, pub replaced: bool,
}
// Plain data: every field is a value or a tree-managed handle.
impl Copy for Style {}

// Every field takes part, by reflection, so a field added later cannot be left out.
impl Equal for Style {
  fn equals(left: &Style, right: &Style) -> bool {
    static for field in Reflect.fields<Style>() {
      if !sameField(Reflect.borrowField(left, field), Reflect.borrowField(right, field)) { return false }
    }
    return true
  }
}
impl Style {
  // Upright changes used bidi direction, never the computed inherited value.
  pub fn usedDirection(self: &Self) -> Direction {
    if self.textOrientation == TextOrientation.Upright
      && (self.writingMode == WritingMode.VerticalRl || self.writingMode == WritingMode.VerticalLr) {
      return Direction.Ltr
    }
    return self.direction
  }
  pub fn usesCentralBaseline(self: &Self) -> bool {
    return (self.writingMode == WritingMode.VerticalRl || self.writingMode == WritingMode.VerticalLr)
      && self.textOrientation != TextOrientation.Sideways
  }
  pub fn make() -> Style {
    return Style {
      display: Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow },
      grid: 0,
      width: Dimension.auto(), height: Dimension.auto(),
      minWidth: Dimension.auto(), minHeight: Dimension.auto(),
      maxWidth: Dimension.keyword(DimensionKind.None), maxHeight: Dimension.keyword(DimensionKind.None),
      margin: Edges.all(Dimension.px(0.0)), padding: Edges.all(Dimension.px(0.0)),
      border: Edges.all(Dimension.px(0.0)), inset: Edges.all(Dimension.auto()),
      boxSizing: BoxSizing.ContentBox, direction: Direction.Ltr, unicodeBidi: UnicodeBidi.Normal, writingMode: WritingMode.HorizontalTb,
      textOrientation: TextOrientation.Mixed,
      fontKey: 0, lineHeight: LineHeight.Normal,
      verticalAlign: VerticalAlign { kind: VerticalAlignKind.Baseline, shift: Dimension.px(0.0) }, baselineSource: BaselineSource.Auto,
      textAlign: TextAlign.Start, textAlignLast: TextAlign.Auto, textWrap: TextWrap.Wrap,
      textJustify: TextJustify.Auto,
      textIndent: TextIndent { value: Dimension.px(0.0), hanging: false, eachLine: false },
      whiteSpaceCollapse: WhiteSpaceCollapse.Collapse, tabSize: TabSize.Number { value: 8.0 },
      boxDecorationBreak: BoxDecorationBreak.Slice,
      marginBreak: MarginBreak.Auto,
      breakBefore: BreakBetween.Auto, breakAfter: BreakBetween.Auto, breakInside: BreakInside.Auto,
      orphans: 2, widows: 2,
      flexDirection: FlexDirection.Row, flexWrap: FlexWrap.NoWrap,
      flexGrow: 0.0, flexShrink: 1.0, flexBasis: Dimension.auto(), order: 0,
      justifyContent: Align.Normal, alignItems: Align.Normal, alignSelf: Align.Auto, alignContent: Align.Normal,
      justifySelf: Align.Auto, justifyItems: Align.Normal,
      justifyContentSafety: OverflowAlignment.Default, alignContentSafety: OverflowAlignment.Default,
      alignItemsSafety: OverflowAlignment.Default, alignSelfSafety: OverflowAlignment.Default,
      justifySelfSafety: OverflowAlignment.Default, justifyItemsSafety: OverflowAlignment.Default,
      rowGap: Dimension.keyword(DimensionKind.Normal), columnGap: Dimension.keyword(DimensionKind.Normal),
      overflowX: Overflow.Visible, overflowY: Overflow.Visible,
      scrollbarWidth: ScrollbarWidth.Auto, scrollbarGutter: ScrollbarGutter.Auto,
      position: Position.Static, float: Float.None, clear: Clear.None, visibility: Visibility.Visible,
      aspectRatio: 0.0, aspectRatioAuto: false, replaced: false,
    }
  }
}

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.text.string { String }
import geometry { Point }
import style { SizeContainment, Style, Display, DisplayOutside, DisplayInside, WritingMode, Direction, Align, Float, BreakBetween, Visibility, DimensionKind, Overflow, ColumnSpan, WhiteSpaceCollapse }
import tree { Measurement, NO_NODE }
import source { LayoutSource, laidText }
import context { outOfFlow, scrollable, overflowForAxis, containsAbsolute }
import grid_style { GridTemplate }
import silk.num.u32
import shapes { FloatShape }

// A Table lays out its row groups, rows, column groups, columns, cells and captions
// itself (table.silk); a TablePart (row group, row or column group) only places its
// children where the table put them.
pub enum BoxKind { Block, Flex, Grid, Inline, InlineFormatting, Text, Table, TablePart }
pub struct BoxNode {
  // Fields read on every visit come first so they share one cache line.
  pub anonymousStyle: usize,
  // styleOwner's index in styles, so style() needs no source lookup;
  // NO_NODE with anonymousStyle.
  pub styleIndex: usize,
  pub parent: usize, pub firstChild: usize, pub nextSibling: usize,
  pub kind: BoxKind, pub measurement: Measurement,
  pub firstForSource: bool, pub lastForSource: bool,
  pub anonymousBlock: bool, pub blockify: bool, pub independentRoot: bool,
  pub firstFormattedRun: bool,
  // Multi-column layout: a column set lays out its one column flow child
  // once per column (see multicol.silk).
  pub columnSet: bool, pub columnFlow: bool,
  pub needsFragmentGeometry: bool,
  pub fragmentMonolithic: bool,
  // Propagation can depend on a descendant's computed flex lines.
  pub beforeControl: bool, pub dynamicBefore: bool,
  pub afterControl: bool, pub dynamicAfter: bool,
  pub source: usize, pub styleOwner: usize,
  pub lastChild: usize,
  pub previousContinuation: usize, pub nextContinuation: usize,
  // Lifted in-flow blocks consumed between this inline piece and its successor.
  pub interruptionFirst: usize, pub interruptionLast: usize,
  pub measureKey: usize,
  pub scrollOffset: Point,
}
impl Copy for BoxNode {}

pub struct BoxTree<'a, S> {
  pub boxes: List<BoxNode>,
  pub anonymousStyles: List<Style>,
  // The source element each anonymous style inherits from, and whether it
  // styles text; see refreshAnonymous.
  pub anonymousOrigins: List<usize>, pub anonymousText: List<bool>,
  pub firstBySource: List<usize>, pub lastBySource: List<usize>,
  // The source the boxes are generated from (see source.silk), and its tables.
  pub source: &'a S,
  pub styles: &'a [Style],
  pub grids: &'a [GridTemplate],
  pub gridNames: &'a [String],
  // The tree's `shape-outside` areas, by `Style.shape` (see Tree.setShape).
  pub shapes: &'a [FloatShape],
  textStyles: List<usize>,
  // Whether any box is a column set (see columnChildren).
  pub columnSets: bool,
  // Construction of a column flow (see columnChildren): the multi-column
  // box whose spanners may sit at this depth, a spanner met below it, and
  // the source path a split resumes along, with the next entry to take.
  spanRoot: usize, spanHit: usize,
  resumePath: List<usize>, resumeDepth: usize, resumeAfter: usize,
  // Box ids no box holds, ascending, and anonymous style slots no box
  // holds, which a patch of the tree (see box_patch.silk) leaves and takes.
  pub freeBoxes: List<usize>, pub freeStyles: List<usize>,
  // While a patch constructs boxes: the ids its new boxes take before any
  // appended, ascending, and how many it took; and the text styles it made,
  // as style index and slot pairs (`textStyles` is empty then).
  pub slots: List<usize>, pub slotsTaken: usize,
  patchTexts: List<usize>,
}
impl<'tree, S: LayoutSource> BoxTree<'tree, S> {
  // A box tree built from these sources at an earlier revision, when no
  // change since could alter which boxes are generated.
  pub fn restore<'a>(source: &'a S, boxes: List<BoxNode>, anonymousStyles: List<Style>, anonymousOrigins: List<usize>, anonymousText: List<bool>, firstBySource: List<usize>, lastBySource: List<usize>, copyScrolls: bool) -> BoxTree<'a, S> {
    let mut result = BoxTree { boxes: move boxes, anonymousStyles: move anonymousStyles, anonymousOrigins: move anonymousOrigins, anonymousText: move anonymousText, firstBySource: move firstBySource, lastBySource: move lastBySource, source: source, styles: source.styles(), grids: source.grids(), gridNames: source.gridNames(), shapes: source.shapes(), textStyles: List<usize>.make(), columnSets: false, spanRoot: NO_NODE, spanHit: NO_NODE, resumePath: List<usize>.make(), resumeDepth: 0, resumeAfter: NO_NODE, freeBoxes: List<usize>.make(), freeStyles: List<usize>.make(), slots: List<usize>.make(), slotsTaken: 0, patchTexts: List<usize>.make() }
    if !copyScrolls { return move result }
    let values = result.boxes.asMutSlice()
    let mut index: usize = 0
    while index < values.length {
      let owner = values[index].source
      if owner != NO_NODE { values[index].scrollOffset = source.scrollOffset(owner) }
      index = index + 1
    }
    return move result
  }
  // Copies a source's scroll offset to its boxes.
  pub fn refreshScroll(self: &mut Self, source: usize) {
    if source >= self.firstBySource.length() { return }
    let offset = self.source.scrollOffset(source)
    let boxes = self.boxes.asMutSlice()
    let mut id = self.firstBySource.get(source)
    while id != NO_NODE {
      boxes[id].scrollOffset = offset
      id = boxes[id].nextContinuation
    }
  }
  // Recomputes an anonymous style after its origin's style changed.
  pub fn refreshAnonymous(self: &mut Self, slot: usize) {
    let origin = self.anonymousOrigins.get(slot)
    if origin == NO_NODE { return }
    let parent = &self.styles[self.source.styleIndex(origin)]
    let mut style = runStyle(parent)
    if self.anonymousText.get(slot) { style = textStyle(parent) }
    let styles = self.anonymousStyles.asMutSlice()
    styles[slot] = move style
  }
  @inlineAlways
  pub fn node(self: &Self, id: usize) -> &BoxNode { return &self.boxes.asSlice()[id] }
  @inlineAlways
  // The `shape-outside` area of box `id`, if it has one.
  pub fn shape(self: &Self, id: usize) -> Option<&FloatShape> {
    let handle = u32.toUsize(self.style(id).shape)
    if handle == 0 || handle >= self.shapes.length { return Option<&FloatShape>.None }
    return Option<&FloatShape>.some(&self.shapes[handle])
  }
  pub fn style(self: &Self, id: usize) -> &Style {
    let node = self.node(id)
    if node.anonymousStyle != NO_NODE { return &self.anonymousStyles.asSlice()[node.anonymousStyle] }
    return &self.styles[node.styleIndex]
  }

  // Column flows break with the fragmentation code, which reads what
  // prepareFragmentation resolves.
  pub fn prepareColumns(self: &mut Self) {
    if self.columnSets { self.prepareFragmentation(WritingMode.HorizontalTb) }
  }
  // Generated parents precede their children. Resolve continuation ancestry
  // and boundary dependencies once, not on each speculative fragment.
  pub fn prepareFragmentation(self: &mut Self, frameMode: WritingMode) {
    let mut index = self.boxes.length()
    while index > 0 {
      index = index - 1
      let node = self.boxes.get(index)
      let needed = index == 0 || node.needsFragmentGeometry || containsAbsolute(self.style(index))
      let style = self.style(index)
      // Break3 §4.1 suppresses internal break points and propagation through
      // monolithic content. Classification is stable across fragmentainers.
      let inlineLevel = style.display.outsideIs(DisplayOutside.Inline) && !node.blockify
      // Against the parent's mode, so a vertical column flow's own content
      // is not orthogonal to its columns.
      let mut reference = frameMode
      if node.parent != NO_NODE { reference = self.style(node.parent).writingMode }
      let orthogonal = node.kind != BoxKind.Flex && (style.writingMode == WritingMode.HorizontalTb) != (reference == WritingMode.HorizontalTb)
      let x = overflowForAxis(style, true)
      let y = overflowForAxis(style, false)
      let mut dimension = style.height
      let mut maximum = style.maxHeight
      let mut overflow = y
      if style.writingMode != WritingMode.HorizontalTb { dimension = style.width
        maximum = style.maxWidth
        overflow = x }
      let scrolling = x == Overflow.Auto || x == Overflow.Scroll || y == Overflow.Auto || y == Overflow.Scroll
      let clipped = overflow == Overflow.Hidden && dimension.kind != DimensionKind.Auto && maximum.kind == DimensionKind.None
      // A column set inside another fragmentation context (columns or pages) keeps
      // all its columns in one outer fragmentainer; it does not continue in the next.
      // A table breaks between rows (table.layoutFragment); its parts stay whole.
      let monolithic = node.columnSet || node.kind == BoxKind.TablePart || style.sizeContainment == SizeContainment.Size || style.layoutContainment || style.replaced || node.measurement != Measurement.None || inlineLevel || orthogonal || scrolling || clipped
      let applicable = !outOfFlow(style) && (node.kind == BoxKind.Block || node.kind == BoxKind.Flex || node.kind == BoxKind.Grid || node.kind == BoxKind.Table)
      let mut before = applicable && style.breakBefore != BreakBetween.Auto
      let mut dynamicBefore = false
      let ownAfter = applicable && style.breakAfter != BreakBetween.Auto
      let mut after = ownAfter
      let mut dynamicAfter = false
      if applicable && !monolithic && node.kind != BoxKind.Table {
        let mut child = node.firstChild
        let mut first = true
        while child != NO_NODE {
          let item = self.node(child)
          let childStyle = self.style(child)
          let eligible = !outOfFlow(childStyle) && (node.kind == BoxKind.Grid || node.kind == BoxKind.Flex && childStyle.visibility != Visibility.Collapse || node.kind == BoxKind.Block && childStyle.float == Float.None)
          if eligible {
            if node.kind == BoxKind.Flex || node.kind == BoxKind.Grid {
              before = before || item.beforeControl
              dynamicBefore = dynamicBefore || item.beforeControl
              after = after || item.afterControl
              dynamicAfter = dynamicAfter || item.afterControl
            } else {
              if first {
                before = before || item.beforeControl
                dynamicBefore = item.dynamicBefore
                first = false
              }
              after = ownAfter || item.afterControl
              dynamicAfter = item.dynamicAfter
            }
          }
          child = item.nextSibling
        }
      }
      let boxes = self.boxes.asMutSlice()
      boxes[index].needsFragmentGeometry = needed
      boxes[index].fragmentMonolithic = monolithic
      boxes[index].beforeControl = before
      boxes[index].dynamicBefore = dynamicBefore
      boxes[index].afterControl = after
      boxes[index].dynamicAfter = dynamicAfter
      if node.parent != NO_NODE && needed {
        boxes[node.parent].needsFragmentGeometry = true
      }
    }
  }

  effect fn append(self: &mut Self, node: BoxNode, parent: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
    let mut id = self.boxes.length()
    let mut value = move node
    value.parent = parent
    let source = value.source
    // A patch takes free ids first, in ascending order, so that a box still
    // follows its parent and every box made before it.
    if self.slotsTaken < self.slots.length() {
      id = self.slots.get(self.slotsTaken)
      self.slotsTaken = self.slotsTaken + 1
      let boxes = self.boxes.asMutSlice()
      boxes[id] = value
    } else {
      run self.boxes.append(move value)
    }
    if parent != NO_NODE {
      let last = self.node(parent).lastChild
      let boxes = self.boxes.asMutSlice()
      if last == NO_NODE { boxes[parent].firstChild = id } else { boxes[last].nextSibling = id }
      boxes[parent].lastChild = id
    }
    if source != NO_NODE {
      let previous = self.lastBySource.get(source)
      if previous == NO_NODE {
        self.firstBySource.set(source, id)
      } else {
        let boxes = self.boxes.asMutSlice()
        boxes[previous].nextContinuation = id
        boxes[previous].lastForSource = false
        boxes[id].previousContinuation = previous
        boxes[id].firstForSource = false
      }
      self.lastBySource.set(source, id)
    }
    return id
  }

  // Stores an anonymous style in a free slot or a new one.
  effect fn newStyle(self: &mut Self, style: Style, origin: usize, text: bool) -> usize ! OutOfMemoryError ? &mut Allocator {
    let free = self.freeStyles.length()
    if free != 0 {
      let slot = self.freeStyles.get(free - 1)
      self.freeStyles.truncate(free - 1)
      let styles = self.anonymousStyles.asMutSlice()
      styles[slot] = move style
      self.anonymousOrigins.set(slot, origin)
      self.anonymousText.set(slot, text)
      return slot
    }
    let slot = self.anonymousStyles.length()
    run self.anonymousStyles.append(move style)
    run self.anonymousOrigins.append(origin)
    run self.anonymousText.append(text)
    return slot
  }
  // The text style slot of element style `styleIndex` made by this
  // construction, or NO_NODE.
  fn textSlot(self: &Self, styleIndex: usize) -> usize {
    if styleIndex < self.textStyles.length() { return self.textStyles.get(styleIndex) }
    let mut at: usize = 0
    while at + 1 < self.patchTexts.length() {
      if self.patchTexts.get(at) == styleIndex { return self.patchTexts.get(at + 1) }
      at = at + 2
    }
    return NO_NODE
  }

  // Anonymous boxes inherit text properties, never element geometry or layout.
  effect fn ensureAnonymousStyle(self: &mut Self, flow: &mut Flow) -> usize ! OutOfMemoryError ? &mut Allocator {
    if flow.anonymousStyle == NO_NODE {
      let style = runStyle(self.style(flow.container))
      let origin = self.node(flow.container).styleOwner
      flow.anonymousStyle = run self.newStyle(move style, origin, false)
    }
    return flow.anonymousStyle
  }

  // Each flow container shares one immutable anonymous style between its runs.
  // CSS2 9.2.1.1: inherit from the enclosing box, not a split inline ancestor.
  effect fn ensureRun(self: &mut Self, flow: &mut Flow) -> usize ! OutOfMemoryError ? &mut Allocator {
    if flow.inlineRun != NO_NODE { return flow.inlineRun }
    let owner = self.node(flow.container).styleOwner
    drop run self.ensureAnonymousStyle(&mut flow)
    let mut node = anonymous(BoxKind.InlineFormatting, owner, flow.anonymousStyle)
    node.anonymousBlock = flow.hasBlock
    node.firstFormattedRun = !flow.hasBlock
    let id = run self.append(node, flow.container)
    flow.inlineRun = id
    return id
  }

  effect fn appendText(self: &mut Self, source: usize, parent: usize) ! OutOfMemoryError ? &mut Allocator {
    let styleIndex = self.source.styleIndex(source)
    let mut slot = self.textSlot(styleIndex)
    if slot == NO_NODE {
      let mut style = inherited(&self.styles[styleIndex])
      style.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
      let origin = self.source.parent(source)
      slot = run self.newStyle(move style, origin, true)
      if styleIndex < self.textStyles.length() { self.textStyles.set(styleIndex, slot) }
      else {
        run self.patchTexts.append(styleIndex)
        run self.patchTexts.append(slot)
      }
    }
    let mut node = anonymous(BoxKind.Text, source, slot)
    node.source = source
    node.firstForSource = true
    node.lastForSource = true
    drop run self.append(node, parent)
  }

  // Contents descendants stay in the same pending sequence. Delay generation
  // until the full sequence is known so whitespace-only flex items vanish.
  effect fn flushFlexText(self: &mut Self, flow: &mut Flow) ! OutOfMemoryError ? &mut Allocator {
    if flow.flexText.length() == 0 { return }
    if flow.flexTextVisible {
      let slot = run self.ensureAnonymousStyle(&mut flow)
      let owner = self.node(flow.container).styleOwner
      let mut item = anonymous(BoxKind.Block, owner, slot)
      item.anonymousBlock = true
      item.blockify = true
      item.independentRoot = true
      let itemId = run self.append(item, flow.container)
      let runId = run self.append(anonymous(BoxKind.InlineFormatting, owner, slot), itemId)
      let mut index: usize = 0
      while index < flow.flexText.length() {
        run self.appendText(flow.flexText.get(index), runId)
        index = index + 1
      }
    }
    flow.flexText.clear()
    flow.flexTextVisible = false
  }

  // The original generated ancestry is a persistent stack of inline scopes.
  // New runs have increasing arena IDs, so a source's latest piece is current
  // iff it was allocated after this run. Only interrupted scopes need walking.
  effect fn inlineParent(self: &mut Self, flow: &mut Flow, inline: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
    let runId = run self.ensureRun(&mut flow)
    if inline == NO_NODE { return runId }
    let source = self.node(inline).source
    let latest = self.lastBySource.get(source)
    if latest > runId { return latest }
    let oldParent = self.node(inline).parent
    let mut ancestor = NO_NODE
    if self.node(oldParent).kind == BoxKind.Inline { ancestor = oldParent }
    let parent = run self.inlineParent(&mut flow, ancestor)
    let mut piece = self.boxes.get(latest)
    piece.parent = NO_NODE
    piece.firstChild = NO_NODE
    piece.lastChild = NO_NODE
    piece.nextSibling = NO_NODE
    piece.previousContinuation = NO_NODE
    piece.nextContinuation = NO_NODE
    piece.firstForSource = false
    piece.lastForSource = true
    piece.interruptionFirst = NO_NODE
    piece.interruptionLast = NO_NODE
    return run self.append(piece, parent)
  }

  effect fn children(self: &mut Self, source: usize, flow: &mut Flow, inline: usize, parentWritingMode: WritingMode) ! OutOfMemoryError ? &mut Allocator {
    let mut child = self.source.firstChild(source)
    if self.resumeDepth < self.resumePath.length() && self.resumePath.get(self.resumeDepth) == source {
      // The continuation of a block a spanner split: go on after the spanner.
      self.resumeDepth = self.resumeDepth + 1
      if self.resumeDepth < self.resumePath.length() { child = self.resumePath.get(self.resumeDepth) } else { child = self.resumeAfter }
    }
    while child != NO_NODE {
      let next = self.source.nextSibling(child)
      if self.spanRoot != NO_NODE && inline == NO_NODE && self.spanner(child) {
        self.spanHit = child
        return
      }
      run self.construct(child, &mut flow, inline, parentWritingMode)
      if self.spanHit != NO_NODE { return }
      child = next
    }
  }

  effect fn construct(self: &mut Self, source: usize, flow: &mut Flow, inline: usize, parentWritingMode: WritingMode) ! OutOfMemoryError ? &mut Allocator {
    if self.source.isText(source) {
      if itemParent(self.node(flow.container).kind) {
        run flow.flexText.append(source)
        match laidText(self.source, source) {
          Option<string>.Some { value } => {
            if !documentWhitespace(value) { flow.flexTextVisible = true }
          }
          Option<string>.None => {}
        }
      } else {
        let parent = run self.inlineParent(&mut flow, inline)
        run self.appendText(source, parent)
      }
      return
    }
    let sourceStyle = &self.styles[self.source.styleIndex(source)]
    if sourceStyle.display.isNone() { return }
    if sourceStyle.display.isContents() {
      // Display 4 2.5 / Appendix B: replaced contents computes to none.
      if !sourceStyle.replaced {
        run self.children(source, &mut flow, inline, parentWritingMode)
      }
      return
    }

    run self.flushFlexText(&mut flow)
    let parentKind = self.node(flow.container).kind
    let flexChild = itemParent(parentKind)
    let style = &self.styles[self.source.styleIndex(source)]
    let positioned = outOfFlow(style)
    let floating = style.float != Float.None && !flexChild && !positioned
    let blockify = flexChild || positioned || floating
    let mut display = style.display
    // A table's own parts keep their display; anything else in a table is blockified,
    // as an anonymous cell would hold it.
    let mut tablePart = false
    if (parentKind == BoxKind.Table || parentKind == BoxKind.TablePart) && !positioned && !floating {
      let parentDisplay = self.style(flow.container).display
      tablePart = tablePartOf(&display, parentKind, &parentDisplay)
    }
    if blockify && !tablePart { display = display.blockified() }
    let inlineLevel = display.outsideIs(DisplayOutside.Inline)
    let differentWritingMode = style.writingMode != parentWritingMode
    let writingMode = style.writingMode
    let replaced = style.replaced
    let measured = self.source.measurement(source) != Measurement.None
    let mut kind = BoxKind.Block
    if !replaced {
      if display.insideIs(DisplayInside.Flex) { kind = BoxKind.Flex }
      if display.isGrid() { kind = BoxKind.Grid }
      if inlineLevel && display.insideIs(DisplayInside.Flow) && !differentWritingMode { kind = BoxKind.Inline }
      if display.insideIs(DisplayInside.Table) { kind = BoxKind.Table }
      if tablePart && !display.insideIs(DisplayInside.TableCell) && !display.insideIs(DisplayInside.TableCaption) && !display.insideIs(DisplayInside.TableColumn) { kind = BoxKind.TablePart }
    }
    // Writing Modes 4 3.2 compares against the nearest box-generating parent;
    // contents and generated wrappers do not substitute a source parent here.
    let multicol = kind == BoxKind.Block && !measured && style.multicol()
    let independent = kind != BoxKind.Inline && (multicol || style.sizeContainment != SizeContainment.None || style.layoutContainment || replaced || flexChild || positioned || floating || differentWritingMode || display.insideIs(DisplayInside.FlowRoot) || kind == BoxKind.Flex || kind == BoxKind.Grid || kind == BoxKind.Table || display.insideIs(DisplayInside.TableCell) || display.insideIs(DisplayInside.TableCaption) || style.alignContent != Align.Normal || scrollable(style.overflowX) || scrollable(style.overflowY) || source == 0)
    let node = BoxNode {
      source: source, styleOwner: source, anonymousStyle: NO_NODE, styleIndex: self.source.styleIndex(source), kind: kind,
      parent: NO_NODE, firstChild: NO_NODE, lastChild: NO_NODE, nextSibling: NO_NODE,
      previousContinuation: NO_NODE, nextContinuation: NO_NODE,
      firstForSource: true, lastForSource: true,
      interruptionFirst: NO_NODE, interruptionLast: NO_NODE,
      anonymousBlock: false, blockify: blockify, independentRoot: independent,
      firstFormattedRun: false,
      columnSet: false, columnFlow: false,
      needsFragmentGeometry: false,
      fragmentMonolithic: false,
      beforeControl: false, dynamicBefore: false,
      afterControl: false, dynamicAfter: false,
      measureKey: self.source.measureKey(source), measurement: self.source.measurement(source),
      scrollOffset: self.source.scrollOffset(source),
    }

    if kind == BoxKind.Inline {
      let parent = run self.inlineParent(&mut flow, inline)
      let id = run self.append(node, parent)
      let spanRoot = self.spanRoot
      self.spanRoot = NO_NODE
      if !measured { run self.children(source, &mut flow, id, writingMode) }
      self.spanRoot = spanRoot
      // Even a trailing block requires an empty closing continuation.
      drop run self.inlineParent(&mut flow, id)
      return
    }

    let mut parent = flow.container
    if positioned || floating {
      // A hypothetical inline-level positioned box needs an inline anchor
      // even before real content. It does not give the resulting line height.
      // Flex/grid static positions remain owned by their formatting context.
      if flow.inlineRun != NO_NODE || (floating && inline != NO_NODE)
        || (positioned && !flexChild && style.display.outsideIs(DisplayOutside.Inline)) {
        parent = run self.inlineParent(&mut flow, inline)
      }
    } else if inlineLevel {
      parent = run self.inlineParent(&mut flow, inline)
    } else if !flexChild {
      flow.hasBlock = true
      flow.inlineRun = NO_NODE
    }
    let id = run self.append(node, parent)
    if !positioned && !floating && !inlineLevel && !flexChild {
      let mut ancestor = inline
      while ancestor != NO_NODE {
        let piece = self.lastBySource.get(self.node(ancestor).source)
        let boxes = self.boxes.asMutSlice()
        if boxes[piece].interruptionFirst == NO_NODE { boxes[piece].interruptionFirst = id }
        boxes[piece].interruptionLast = id
        ancestor = self.node(ancestor).parent
        if self.node(ancestor).kind != BoxKind.Inline { ancestor = NO_NODE }
      }
    }
    // Replaced content is opaque even if the source API contains descendants.
    // Measured leaves retain their provider key; construction invents no text.
    // A column's children are not rendered (CSS 2 §17.2).
    // Spanners split only in-flow blocks of the column flow's own formatting
    // context (Multicol 1 §6.1).
    let spanRoot = self.spanRoot
    if independent || kind != BoxKind.Block || inlineLevel || inline != NO_NODE { self.spanRoot = NO_NODE }
    if multicol {
      run self.columnChildren(source, id, writingMode)
    } else if !replaced && !measured && !(tablePart && display.insideIs(DisplayInside.TableColumn)) {
      let mut nested = Flow.make(id)
      run self.children(source, &mut nested, NO_NODE, writingMode)
      run self.finishFlow(&mut nested)
    }
    self.spanRoot = spanRoot
  }

  // A multi-column container's children: runs of content in column sets,
  // each a column set box holding one column flow box, split at spanners
  // (`column-span: all` children), which stay the container's own children.
  // Collapsible whitespace between spanners makes no column set.
  // A spanner deeper in the flow splits the blocks around it: the part before
  // ends the set, the spanner follows it, and continuations of those blocks
  // carry what comes after into the next set.
  effect fn columnChildren(self: &mut Self, source: usize, id: usize, writingMode: WritingMode) ! OutOfMemoryError ? &mut Allocator {
    let collapsible = self.style(id).whiteSpaceCollapse == WhiteSpaceCollapse.Collapse
    let spanRoot = self.spanRoot
    let mut flow = Flow.make(NO_NODE)
    let mut child = self.source.firstChild(source)
    while child != NO_NODE {
      let next = self.source.nextSibling(child)
      if self.spanner(child) {
        if flow.container != NO_NODE {
          run self.finishFlow(&mut flow)
          flow = Flow.make(NO_NODE)
        }
        run self.spannerBox(child, id, writingMode)
      } else if flow.container != NO_NODE || !(collapsible && self.blankText(child)) {
        if flow.container == NO_NODE { flow = Flow.make(run self.columnSet(id)) }
        self.spanRoot = id
        run self.construct(child, &mut flow, NO_NODE, writingMode)
        while self.spanHit != NO_NODE {
          let hit = self.spanHit
          self.spanHit = NO_NODE
          run self.finishFlow(&mut flow)
          run self.spannerBox(hit, id, writingMode)
          self.resumePath.clear()
          let mut at = self.source.parent(hit)
          while true {
            run self.resumePath.append(at)
            if at == child { break }
            at = self.source.parent(at)
          }
          let path = self.resumePath.asMutSlice()
          let mut low: usize = 0
          let mut high = path.length
          while low + 1 < high {
            high = high - 1
            let value = path[low]
            path[low] = path[high]
            path[high] = value
            low = low + 1
          }
          self.resumeDepth = 0
          self.resumeAfter = self.source.nextSibling(hit)
          flow = Flow.make(run self.columnSet(id))
          self.spanRoot = id
          run self.construct(child, &mut flow, NO_NODE, writingMode)
        }
        self.resumePath.clear()
        self.resumeDepth = 0
      }
      child = next
    }
    if flow.container != NO_NODE { run self.finishFlow(&mut flow) }
    self.spanRoot = spanRoot
  }
  // A spanner is the multi-column container's own child and a formatting
  // context of its own.
  effect fn spannerBox(self: &mut Self, source: usize, container: usize, writingMode: WritingMode) ! OutOfMemoryError ? &mut Allocator {
    self.spanRoot = NO_NODE
    let mut outer = Flow.make(container)
    run self.construct(source, &mut outer, NO_NODE, writingMode)
    run self.finishFlow(&mut outer)
  }
  fn spanner(self: &Self, source: usize) -> bool {
    if self.source.isText(source) { return false }
    let style = &self.styles[self.source.styleIndex(source)]
    return style.multicolSpan == ColumnSpan.All && !style.display.isNone() && !style.display.isContents()
      && style.display.outsideIs(DisplayOutside.Block) && style.float == Float.None && !outOfFlow(style)
  }
  fn blankText(self: &Self, source: usize) -> bool {
    if !self.source.isText(source) { return false }
    return match laidText(self.source, source) {
      Option<string>.Some { value } => documentWhitespace(value)
      Option<string>.None => true
    }
  }
  // Appends a column set and its column flow to `container`; returns the flow.
  effect fn columnSet(self: &mut Self, container: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
    let owner = self.node(container).styleOwner
    let style = runStyle(self.style(container))
    let slot = run self.newStyle(move style, owner, false)
    self.columnSets = true
    let mut set = anonymous(BoxKind.Block, owner, slot)
    set.columnSet = true
    set.independentRoot = true
    let setId = run self.append(set, container)
    let mut flow = anonymous(BoxKind.Block, owner, slot)
    flow.columnFlow = true
    flow.independentRoot = true
    return run self.append(flow, setId)
  }

  // Generates the children of box `root`, a block, flex or grid box of one
  // source in one piece, again from its source's children, as construct
  // does: `root` keeps its id, and its new boxes take `slots` first. A child
  // whose box is in `kept` (ascending) keeps that box and its subtree as
  // they are; only the children of flex and grid boxes, which are
  // independent items, may be kept.
  pub effect fn reconstruct(self: &mut Self, root: usize, kept: &[usize]) ! OutOfMemoryError ? &mut Allocator {
    let source = self.node(root).source
    let writingMode = self.style(root).writingMode
    let boxes = self.boxes.asMutSlice()
    boxes[root].firstChild = NO_NODE
    boxes[root].lastChild = NO_NODE
    let mut flow = Flow.make(root)
    let mut child = self.source.firstChild(source)
    while child != NO_NODE {
      let next = self.source.nextSibling(child)
      let mut keep = NO_NODE
      if child < self.firstBySource.length() { keep = self.firstBySource.get(child) }
      if keep != NO_NODE && sortedContains(kept, keep) {
        run self.flushFlexText(&mut flow)
        let values = self.boxes.asMutSlice()
        values[keep].nextSibling = NO_NODE
        values[keep].parent = root
        let last = values[root].lastChild
        if last == NO_NODE { values[root].firstChild = keep } else { values[last].nextSibling = keep }
        values[root].lastChild = keep
      } else {
        run self.construct(child, &mut flow, NO_NODE, writingMode)
      }
      child = next
    }
    run self.finishFlow(&mut flow)
  }

  effect fn finishFlow(self: &mut Self, flow: &mut Flow) ! OutOfMemoryError ? &mut Allocator {
    run self.flushFlexText(&mut flow)
    if !flow.hasBlock { return }
    let mut child = self.node(flow.container).firstChild
    while child != NO_NODE {
      let next = self.node(child).nextSibling
      if self.node(child).kind == BoxKind.InlineFormatting {
        let boxes = self.boxes.asMutSlice()
        boxes[child].anonymousBlock = true
      }
      child = next
    }
  }
}

struct Flow {
  container: usize, inlineRun: usize, anonymousStyle: usize, hasBlock: bool,
  flexText: List<usize>, flexTextVisible: bool,
}
impl Flow {
  fn make(container: usize) -> Flow {
    return Flow { container: container, inlineRun: NO_NODE, anonymousStyle: NO_NODE, hasBlock: false, flexText: List<usize>.make(), flexTextVisible: false }
  }
}

// Whether ascending `values` holds `value`.
pub fn sortedContains(values: &[usize], value: usize) -> bool {
  let at = lowerBound(values, value)
  return at < values.length && values[at] == value
}
// The first index of ascending `values` whose value is at least `value`.
pub fn lowerBound(values: &[usize], value: usize) -> usize {
  let mut low: usize = 0
  let mut high = values.length
  while low < high {
    let middle = low + (high - low) / 2
    if values[middle] < value { low = middle + 1 } else { high = middle }
  }
  return low
}

fn textStyle(parent: &Style) -> Style {
  let mut style = inherited(parent)
  style.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
  return move style
}

// The style of the inline formatting runs of block container `parent`: the inherited text
// properties, and the container's line-clamp and text-overflow, which act on its lines.
fn runStyle(parent: &Style) -> Style {
  let mut style = inherited(parent)
  style.maxLines = parent.maxLines
  style.blockEllipsis = parent.blockEllipsis
  let mut inlineOverflow = parent.overflowX
  if parent.writingMode != WritingMode.HorizontalTb { inlineOverflow = parent.overflowY }
  style.textOverflowEllipsis = parent.textOverflowEllipsis && inlineOverflow != Overflow.Visible
  style.textBoxTrim = parent.textBoxTrim
  // Column sets read these from the same style (see columnSet).
  style.columnCount = parent.columnCount
  style.columnWidth = parent.columnWidth
  style.columnGap = parent.columnGap
  style.bounds = parent.bounds
  style.columnFill = parent.columnFill
  return move style
}

fn inherited(parent: &Style) -> Style {
  let mut style = Style.make()
  style.direction = parent.direction
  style.writingMode = parent.writingMode
  style.textOrientation = parent.textOrientation
  style.visibility = parent.visibility
  style.fontKey = parent.fontKey
  style.lineHeight = parent.lineHeight
  style.orphans = parent.orphans
  style.widows = parent.widows
  style.textAlign = parent.textAlign
  style.textAlignLast = parent.textAlignLast
  style.textJustify = parent.textJustify
  style.textIndent = parent.textIndent
  style.textBoxEdge = parent.textBoxEdge
  style.emphasis = parent.emphasis
  style.textWrap = parent.textWrap
  style.textWrapStyle = parent.textWrapStyle
  style.whiteSpaceCollapse = parent.whiteSpaceCollapse
  style.tabSize = parent.tabSize
  return move style
}

fn documentWhitespace(value: string) -> bool {
  let bytes = String.utf8Bytes(value)
  let mut index: usize = 0
  while index < bytes.length {
    let byte = bytes[index]
    if byte != 9 && byte != 10 && byte != 13 && byte != 32 { return false }
    index = index + 1
  }
  return true
}

// Whether a container's children are its items: blockified, independent, with
// text between them wrapped in anonymous blocks.
pub fn itemParent(kind: BoxKind) -> bool {
  return kind == BoxKind.Flex || kind == BoxKind.Grid || kind == BoxKind.Table || kind == BoxKind.TablePart
}
// Whether a box of `display` is a part its table lays out: captions, column groups,
// columns and row groups in a table, rows in a table or row group, columns in a
// column group, and cells in a table, row group or row.
fn tablePartOf(display: &Display, parentKind: BoxKind, parent: &Display) -> bool {
  if parentKind == BoxKind.Table {
    return display.isTablePart()
  }
  if parentKind != BoxKind.TablePart { return false }
  if parent.insideIs(DisplayInside.TableColumnGroup) { return display.insideIs(DisplayInside.TableColumn) }
  if parent.insideIs(DisplayInside.TableRow) { return display.insideIs(DisplayInside.TableCell) }
  return display.insideIs(DisplayInside.TableRow) || display.insideIs(DisplayInside.TableCell)
}
pub fn anonymous(kind: BoxKind, owner: usize, slot: usize) -> BoxNode {
  return BoxNode {
    source: NO_NODE, styleOwner: owner, anonymousStyle: slot, styleIndex: NO_NODE, kind: kind,
    parent: NO_NODE, firstChild: NO_NODE, lastChild: NO_NODE, nextSibling: NO_NODE,
    previousContinuation: NO_NODE, nextContinuation: NO_NODE,
    firstForSource: false, lastForSource: false,
    interruptionFirst: NO_NODE, interruptionLast: NO_NODE,
    anonymousBlock: false, blockify: false, independentRoot: false,
    firstFormattedRun: kind == BoxKind.InlineFormatting,
    columnSet: false, columnFlow: false,
    needsFragmentGeometry: false,
    fragmentMonolithic: false,
    beforeControl: false, dynamicBefore: false,
    afterControl: false, dynamicAfter: false,
    measureKey: NO_NODE, measurement: Measurement.None,
    scrollOffset: Point { x: 0.0, y: 0.0 },
  }
}

pub effect fn build<'a, S: LayoutSource>(source: &'a S, writingMode: WritingMode, direction: Direction) -> BoxTree<'a, S> ! OutOfMemoryError ? &mut Allocator {
  let styles = source.styles()
  let sources = source.nodeCount()
  let mut result = BoxTree {
    boxes: List<BoxNode>.make(), anonymousStyles: List<Style>.make(),
    anonymousOrigins: List<usize>.make(), anonymousText: List<bool>.make(),
    firstBySource: List<usize>.make(), lastBySource: List<usize>.make(), source: source,
    styles: styles, grids: source.grids(), gridNames: source.gridNames(), shapes: source.shapes(), textStyles: List<usize>.make(), columnSets: false,
    spanRoot: NO_NODE, spanHit: NO_NODE, resumePath: List<usize>.make(), resumeDepth: 0, resumeAfter: NO_NODE,
    freeBoxes: List<usize>.make(), freeStyles: List<usize>.make(), slots: List<usize>.make(), slotsTaken: 0, patchTexts: List<usize>.make(),
  }
  run result.boxes.reserveExact(sources + 1)
  run result.firstBySource.reserveExact(sources)
  run result.lastBySource.reserveExact(sources)
  let mut index: usize = 0
  while index < sources {
    run result.firstBySource.append(NO_NODE)
    run result.lastBySource.append(NO_NODE)
    index = index + 1
  }
  run result.textStyles.reserveExact(styles.length)
  index = 0
  while index < styles.length {
    run result.textStyles.append(NO_NODE)
    index = index + 1
  }
  // Source zero is an embeddable subtree, not an HTML root element. The
  // synthetic viewport owns the host's initial flow-root boundary.
  let mut viewportStyle = Style.make()
  viewportStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.FlowRoot }
  viewportStyle.writingMode = writingMode
  viewportStyle.direction = direction
  run result.anonymousStyles.append(move viewportStyle)
  run result.anonymousOrigins.append(NO_NODE)
  run result.anonymousText.append(false)
  let mut viewport = anonymous(BoxKind.Block, NO_NODE, 0)
  viewport.independentRoot = true
  let viewportId = run result.append(viewport, NO_NODE)
  let mut flow = Flow.make(viewportId)
  if sources != 0 { run result.construct(0, &mut flow, NO_NODE, writingMode) }
  run result.finishFlow(&mut flow)
  return move result
}

// CSS 2 §17 table layout. The table box sizes its columns and rows from its cells and
// lays out its parts; row groups, rows and column groups (TablePart boxes) place their
// children where the table put them. A table is laid out in a horizontal writing mode.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import source { LayoutSource }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.num.usize
import silk.num.u32
import silk.num.u64
import silk.num.f32
import geometry { Measure, Layout, Size, Point, Rect, OptionalSize, AvailableSpace, AvailableKind, ResolvedEdges, max, min, clamp }
import style { Style, Dimension, BoxSizing, DisplayInside, DimensionKind, TableLayout, BorderCollapse, CaptionSide, Visibility, WritingMode }
import tree { NO_NODE }
import box_tree { BoxTree, BoxKind }
import context { Input, ResolvedBox, childrenInput, outOfFlow, resolve, packCellBorders, cellBorders, CELL_BORDERS, UNBOUNDED }
import engine { layoutNodeInPlace, probeNode }
import layout_pass { LayoutPass }
import text { TextMeasure, TextError }
import fragmentation { FragmentationError, FlowCursor, BoundaryProbe, Fragmentainer, FragmentInput }
import breaks { BreakBoundary, FragmentainerKind, FractionalProgress }
import silk.core.option { Option }

// `fixed` is a specified width and `percent` a specified percentage (a fraction),
// each negative when none; a percentage outranks a width.
struct Column { min: f32, max: f32, fixed: f32, percent: f32, width: f32, x: f32, collapsed: bool }
impl Copy for Column {}
// `box` is NO_NODE for the anonymous row around loose cells, whose `parent` then
// holds them; `section` indexes the row's group.
struct Row { box: usize, parent: usize, section: usize, specified: f32, height: f32, y: f32, collapsed: bool }
impl Copy for Row {}
// `rows` 0 asks for every row to the end of the group, until the group closes.
// `percent` is its percentage width, negative when none; `plan` its packed collapsed
// borders (context.packCellBorders), 0 when the table's borders are separate.
struct Cell { box: usize, row: usize, column: usize, rows: usize, columns: usize, min: f32, max: f32, height: f32, percent: f32, plan: u64 }
impl Copy for Cell {}
// `box` is NO_NODE for the anonymous group around rows outside any group.
struct Section { box: usize, first: usize, end: usize }
impl Copy for Section {}
struct ColumnBox { box: usize, parent: usize, first: usize, span: usize }
impl Copy for ColumnBox {}

struct Plan {
  columns: List<Column>, rows: List<Row>, cells: List<Cell>, sections: List<Section>,
  columnBoxes: List<ColumnBox>, captions: List<usize>,
  // Per column, the row before which a cell spanning down into it holds it.
  busy: List<usize>,
  columnCount: usize, nextColumn: usize, cursor: usize,
  openSection: bool, openRow: bool,
}
impl Plan {
  fn make() -> Plan {
    return Plan { columns: List<Column>.make(), rows: List<Row>.make(), cells: List<Cell>.make(), sections: List<Section>.make(), columnBoxes: List<ColumnBox>.make(), captions: List<usize>.make(), busy: List<usize>.make(), columnCount: 0, nextColumn: 0, cursor: 0, openSection: false, openRow: false }
  }
}

fn display<S: LayoutSource>(nodes: &BoxTree<'_, S>, id: usize, inside: DisplayInside) -> bool { return nodes.style(id).display.insideIs(inside) }
fn part<S: LayoutSource>(nodes: &BoxTree<'_, S>, id: usize) -> bool { return nodes.node(id).kind == BoxKind.TablePart }
fn rowGroup<S: LayoutSource>(nodes: &BoxTree<'_, S>, id: usize) -> bool {
  return part(nodes, id) && (display(nodes, id, DisplayInside.TableRowGroup) || display(nodes, id, DisplayInside.TableHeaderGroup) || display(nodes, id, DisplayInside.TableFooterGroup))
}
fn inFlow<S: LayoutSource>(nodes: &BoxTree<'_, S>, id: usize) -> bool { return !outOfFlow(nodes.style(id)) }
fn length(value: f32) -> f32 { return max(0.0, value) }

// CSS 2 §17.2.1: rows and cells outside a group or row get anonymous ones, which
// here are only rows of the plan, never boxes.
effect fn collect<S: LayoutSource>(nodes: &BoxTree<'_, S>, id: usize, plan: &mut Plan) ! OutOfMemoryError ? &mut Allocator {
  // §17.2: the first header group goes first and the first footer group last.
  let mut header = NO_NODE
  let mut footer = NO_NODE
  let mut child = nodes.node(id).firstChild
  while child != NO_NODE {
    if inFlow(nodes, child) && part(nodes, child) {
      if header == NO_NODE && display(nodes, child, DisplayInside.TableHeaderGroup) { header = child }
      if footer == NO_NODE && display(nodes, child, DisplayInside.TableFooterGroup) { footer = child }
    }
    child = nodes.node(child).nextSibling
  }
  if header != NO_NODE { run addSection(nodes, &mut plan, header) }
  child = nodes.node(id).firstChild
  while child != NO_NODE {
    if inFlow(nodes, child) && child != header && child != footer {
      if display(nodes, child, DisplayInside.TableCaption) {
        closeSection(&mut plan)
        run plan.captions.append(child)
      } else if part(nodes, child) && display(nodes, child, DisplayInside.TableColumnGroup) {
        run addColumnGroup(nodes, &mut plan, child)
      } else if display(nodes, child, DisplayInside.TableColumn) {
        run addColumn(nodes, &mut plan, child, id)
      } else if rowGroup(nodes, child) {
        run addSection(nodes, &mut plan, child)
      } else if part(nodes, child) && display(nodes, child, DisplayInside.TableRow) {
        run openSection(&mut plan)
        run addRow(nodes, &mut plan, child, id)
      } else {
        run openSection(&mut plan)
        run addLooseCell(nodes, &mut plan, child, id)
      }
    }
    child = nodes.node(child).nextSibling
  }
  closeSection(&mut plan)
  if footer != NO_NODE { run addSection(nodes, &mut plan, footer) }
  if plan.nextColumn > plan.columnCount { plan.columnCount = plan.nextColumn }
  let mut index: usize = 0
  while index < plan.columnCount {
    run plan.columns.append(Column { min: 0.0, max: 0.0, fixed: -1.0, percent: -1.0, width: 0.0, x: 0.0, collapsed: false })
    index = index + 1
  }
  // §17.5.5: `visibility: collapse` on a column or its group removes the column.
  index = 0
  while index < plan.columnBoxes.length() {
    let entry = plan.columnBoxes.get(index)
    if nodes.style(entry.box).visibility == Visibility.Collapse {
      let mut column = entry.first
      while column < entry.first + entry.span && column < plan.columnCount {
        let columns = plan.columns.asMutSlice()
        columns[column].collapsed = true
        column = column + 1
      }
    }
    index = index + 1
  }
}

effect fn openSection(plan: &mut Plan) ! OutOfMemoryError ? &mut Allocator {
  if plan.openSection { return }
  run plan.sections.append(Section { box: NO_NODE, first: plan.rows.length(), end: plan.rows.length() })
  plan.busy.clear()
  plan.openSection = true
  plan.openRow = false
}

// Ends the group being filled: cells spanning past its last row stop there.
fn closeSection(plan: &mut Plan) {
  if !plan.openSection { return }
  plan.openSection = false
  plan.openRow = false
  let last = plan.sections.length() - 1
  let end = plan.rows.length()
  let sections = plan.sections.asMutSlice()
  sections[last].end = end
  let cells = plan.cells.asMutSlice()
  let mut index = cells.length
  while index > 0 {
    index = index - 1
    if cells[index].row < plan.sections.asSlice()[last].first { break }
    if cells[index].rows == 0 || cells[index].row + cells[index].rows > end { cells[index].rows = end - cells[index].row }
  }
}

effect fn addSection<S: LayoutSource>(nodes: &BoxTree<'_, S>, plan: &mut Plan, section: usize) ! OutOfMemoryError ? &mut Allocator {
  closeSection(&mut plan)
  run plan.sections.append(Section { box: section, first: plan.rows.length(), end: plan.rows.length() })
  plan.busy.clear()
  plan.openSection = true
  plan.openRow = false
  let mut child = nodes.node(section).firstChild
  while child != NO_NODE {
    if inFlow(nodes, child) {
      if part(nodes, child) && display(nodes, child, DisplayInside.TableRow) { run addRow(nodes, &mut plan, child, section) }
      else { run addLooseCell(nodes, &mut plan, child, section) }
    }
    child = nodes.node(child).nextSibling
  }
  closeSection(&mut plan)
}

effect fn startRow<S: LayoutSource>(nodes: &BoxTree<'_, S>, plan: &mut Plan, row: usize, parent: usize) ! OutOfMemoryError ? &mut Allocator {
  let mut specified: f32 = 0.0
  if row != NO_NODE && nodes.style(row).height.kind == DimensionKind.Length { specified = length(nodes.style(row).height.value) }
  let section = plan.sections.length() - 1
  let group = plan.sections.get(section).box
  // §17.5.5: a collapsed row or row group takes no space.
  let collapsed = (row != NO_NODE && nodes.style(row).visibility == Visibility.Collapse) || (group != NO_NODE && nodes.style(group).visibility == Visibility.Collapse)
  run plan.rows.append(Row { box: row, parent: parent, section: section, specified: specified, height: 0.0, y: 0.0, collapsed: collapsed })
  plan.cursor = 0
}

effect fn addRow<S: LayoutSource>(nodes: &BoxTree<'_, S>, plan: &mut Plan, row: usize, parent: usize) ! OutOfMemoryError ? &mut Allocator {
  plan.openRow = false
  run startRow(nodes, &mut plan, row, parent)
  let mut child = nodes.node(row).firstChild
  while child != NO_NODE {
    if inFlow(nodes, child) { run addCell(nodes, &mut plan, child) }
    child = nodes.node(child).nextSibling
  }
}

effect fn addLooseCell<S: LayoutSource>(nodes: &BoxTree<'_, S>, plan: &mut Plan, cell: usize, parent: usize) ! OutOfMemoryError ? &mut Allocator {
  if !plan.openRow {
    run startRow(nodes, &mut plan, NO_NODE, parent)
    plan.openRow = true
  }
  run addCell(nodes, &mut plan, cell)
}

// HTML's table forming algorithm: a cell takes the first column of its row that no
// cell from a row above still spans into.
effect fn addCell<S: LayoutSource>(nodes: &BoxTree<'_, S>, plan: &mut Plan, cell: usize) ! OutOfMemoryError ? &mut Allocator {
  let row = plan.rows.length() - 1
  let style = nodes.style(cell)
  let columns = max(1.0, usize.toF32(style.columnSpan))
  let span = f32.toUsize(min(columns, 1000.0))
  let mut column = plan.cursor
  while column < plan.busy.length() && plan.busy.get(column) > row { column = column + 1 }
  let mut reach = usize.MAX
  if style.rowSpan != 0 { reach = row + style.rowSpan }
  let mut index = column
  while index < column + span {
    while plan.busy.length() <= index { run plan.busy.append(0) }
    let busy = plan.busy.asMutSlice()
    busy[index] = reach
    index = index + 1
  }
  run plan.cells.append(Cell { box: cell, row: row, column: column, rows: style.rowSpan, columns: span, min: 0.0, max: 0.0, height: 0.0, percent: percentOf(style), plan: 0 })
  plan.cursor = column + span
  if plan.cursor > plan.columnCount { plan.columnCount = plan.cursor }
}

effect fn addColumnGroup<S: LayoutSource>(nodes: &BoxTree<'_, S>, plan: &mut Plan, group: usize) ! OutOfMemoryError ? &mut Allocator {
  let first = plan.nextColumn
  let mut child = nodes.node(group).firstChild
  let mut any = false
  while child != NO_NODE {
    if inFlow(nodes, child) && display(nodes, child, DisplayInside.TableColumn) {
      run addColumn(nodes, &mut plan, child, group)
      any = true
    }
    child = nodes.node(child).nextSibling
  }
  if !any { plan.nextColumn = plan.nextColumn + larger(1, nodes.style(group).columnSpan) }
  run plan.columnBoxes.append(ColumnBox { box: group, parent: NO_NODE, first: first, span: plan.nextColumn - first })
}

effect fn addColumn<S: LayoutSource>(nodes: &BoxTree<'_, S>, plan: &mut Plan, column: usize, parent: usize) ! OutOfMemoryError ? &mut Allocator {
  let span = larger(1, nodes.style(column).columnSpan)
  run plan.columnBoxes.append(ColumnBox { box: column, parent: parent, first: plan.nextColumn, span: span })
  plan.nextColumn = plan.nextColumn + span
}

fn percentOf(style: &Style) -> f32 {
  if style.width.kind == DimensionKind.Percent { return max(0.0, style.width.percent) }
  return -1.0
}

fn larger(a: usize, b: usize) -> usize {
  if a > b { return a }
  return b
}

// The geometry the table works in: spacing, and the edges its grid sits inside.
struct Frame { spacingX: f32, spacingY: f32, left: f32, right: f32, top: f32, bottom: f32, collapse: bool }
impl Copy for Frame {}

fn frameOf(style: &Style, box: &ResolvedBox) -> Frame {
  // §17.6.2: collapsing borders have no spacing, and the table no padding; its
  // borders are set from the resolved ones (collapseBorders).
  if style.borderCollapse == BorderCollapse.Collapse {
    return Frame { spacingX: 0.0, spacingY: 0.0, left: box.border.left / 2.0, right: box.border.right / 2.0, top: box.border.top / 2.0, bottom: box.border.bottom / 2.0, collapse: true }
  }
  return Frame { spacingX: length(style.borderSpacingX), spacingY: length(style.borderSpacingY), left: box.inset.left, right: box.inset.right, top: box.inset.top, bottom: box.inset.bottom, collapse: false }
}

// A collapsing border side: its width, or HIDDEN when its style is `hidden`.
const HIDDEN: f32 = -1.0
const TOP: u8 = 1
const RIGHT: u8 = 2
const BOTTOM: u8 = 4
const LEFT: u8 = 8
fn side(style: &Style, bit: u8) -> f32 {
  if style.borderHidden & bit != 0 { return HIDDEN }
  if bit == TOP { return edge(style.border.top) }
  if bit == RIGHT { return edge(style.border.right) }
  if bit == BOTTOM { return edge(style.border.bottom) }
  return edge(style.border.left)
}
fn sideOf<S: LayoutSource>(nodes: &BoxTree<'_, S>, id: usize, bit: u8) -> f32 {
  if id == NO_NODE { return 0.0 }
  return side(nodes.style(id), bit)
}
// §17.6.2.1: a hidden border suppresses every other, else the widest wins.
fn join(a: f32, b: f32) -> f32 {
  if a < 0.0 || b < 0.0 { return HIDDEN }
  return max(a, b)
}

// The resolved border widths of every grid line segment (§17.6.2.1): `vertical`
// holds rows x (columns + 1) segments, `horizontal` (rows + 1) x columns. Each cell
// gets half of the widest segment along each of its sides, and the table half of
// the widest along each of its edges.
effect fn collapseBorders<S: LayoutSource>(nodes: &BoxTree<'_, S>, id: usize, plan: &mut Plan, frame: &mut Frame) ! OutOfMemoryError ? &mut Allocator {
  let columns = plan.columns.length()
  let rows = plan.rows.length()
  if columns == 0 || rows == 0 { return }
  let mut occupied = List<usize>.make()
  run occupied.appendRepeated(NO_NODE, rows * columns)
  let mut index: usize = 0
  while index < plan.cells.length() {
    let cell = plan.cells.get(index)
    let mut row = cell.row
    while row < cell.row + larger(1, cell.rows) && row < rows {
      let mut column = cell.column
      while column < cell.column + cell.columns && column < columns {
        occupied.set(row * columns + column, index)
        column = column + 1
      }
      row = row + 1
    }
    index = index + 1
  }
  // Column and column group borders, per vertical line and per column at the table's top and bottom.
  let mut lines = List<f32>.make()
  run lines.appendRepeated(0.0, columns + 1)
  let mut tops = List<f32>.make()
  run tops.appendRepeated(0.0, columns)
  let mut bottoms = List<f32>.make()
  run bottoms.appendRepeated(0.0, columns)
  index = 0
  while index < plan.columnBoxes.length() {
    let entry = plan.columnBoxes.get(index)
    if entry.first < columns && entry.span > 0 {
      let end = f32.toUsize(min(usize.toF32(entry.first + entry.span), usize.toF32(columns)))
      let start = join(lines.get(entry.first), sideOf(nodes, entry.box, LEFT))
      lines.set(entry.first, start)
      let finish = join(lines.get(end), sideOf(nodes, entry.box, RIGHT))
      lines.set(end, finish)
      let mut column = entry.first
      while column < end {
        let top = join(tops.get(column), sideOf(nodes, entry.box, TOP))
        tops.set(column, top)
        let bottom = join(bottoms.get(column), sideOf(nodes, entry.box, BOTTOM))
        bottoms.set(column, bottom)
        column = column + 1
      }
    }
    index = index + 1
  }
  let mut vertical = List<f32>.make()
  run vertical.appendRepeated(0.0, rows * (columns + 1))
  let mut row: usize = 0
  while row < rows {
    let entry = plan.rows.get(row)
    let group = plan.sections.get(entry.section).box
    let mut line: usize = 0
    while line <= columns {
      let mut before = NO_NODE
      let mut after = NO_NODE
      if line > 0 { before = occupied.get(row * columns + line - 1) }
      if line < columns { after = occupied.get(row * columns + line) }
      if before == NO_NODE || before != after {
        let mut width = lines.get(line)
        if before != NO_NODE { width = join(width, sideOf(nodes, plan.cells.get(before).box, RIGHT)) }
        if after != NO_NODE { width = join(width, sideOf(nodes, plan.cells.get(after).box, LEFT)) }
        if line == 0 { width = join(join(join(width, sideOf(nodes, entry.box, LEFT)), sideOf(nodes, group, LEFT)), sideOf(nodes, id, LEFT)) }
        if line == columns { width = join(join(join(width, sideOf(nodes, entry.box, RIGHT)), sideOf(nodes, group, RIGHT)), sideOf(nodes, id, RIGHT)) }
        vertical.set(row * (columns + 1) + line, max(0.0, width))
      }
      line = line + 1
    }
    row = row + 1
  }
  let mut horizontal = List<f32>.make()
  run horizontal.appendRepeated(0.0, (rows + 1) * columns)
  let mut line: usize = 0
  while line <= rows {
    let mut column: usize = 0
    while column < columns {
      let mut above = NO_NODE
      let mut below = NO_NODE
      if line > 0 { above = occupied.get((line - 1) * columns + column) }
      if line < rows { below = occupied.get(line * columns + column) }
      if above == NO_NODE || above != below {
        let mut width: f32 = 0.0
        if above != NO_NODE { width = join(width, sideOf(nodes, plan.cells.get(above).box, BOTTOM)) }
        if below != NO_NODE { width = join(width, sideOf(nodes, plan.cells.get(below).box, TOP)) }
        if line > 0 {
          let entry = plan.rows.get(line - 1)
          let section = plan.sections.get(entry.section)
          width = join(width, sideOf(nodes, entry.box, BOTTOM))
          if section.end == line { width = join(width, sideOf(nodes, section.box, BOTTOM)) }
        }
        if line < rows {
          let entry = plan.rows.get(line)
          let section = plan.sections.get(entry.section)
          width = join(width, sideOf(nodes, entry.box, TOP))
          if section.first == line { width = join(width, sideOf(nodes, section.box, TOP)) }
        }
        if line == 0 { width = join(join(width, tops.get(column)), sideOf(nodes, id, TOP)) }
        if line == rows { width = join(join(width, bottoms.get(column)), sideOf(nodes, id, BOTTOM)) }
        horizontal.set(line * columns + column, max(0.0, width))
      }
      column = column + 1
    }
    line = line + 1
  }
  let mut outer = ResolvedEdges.zero()
  row = 0
  while row < rows {
    outer.left = max(outer.left, vertical.get(row * (columns + 1)))
    outer.right = max(outer.right, vertical.get(row * (columns + 1) + columns))
    row = row + 1
  }
  let mut column: usize = 0
  while column < columns {
    outer.top = max(outer.top, horizontal.get(column))
    outer.bottom = max(outer.bottom, horizontal.get(rows * columns + column))
    column = column + 1
  }
  frame.left = outer.left / 2.0
  frame.right = outer.right / 2.0
  frame.top = outer.top / 2.0
  frame.bottom = outer.bottom / 2.0
  index = 0
  while index < plan.cells.length() {
    let cell = plan.cells.get(index)
    let last = f32.toUsize(min(usize.toF32(cell.row + larger(1, cell.rows)), usize.toF32(rows)))
    let end = f32.toUsize(min(usize.toF32(cell.column + cell.columns), usize.toF32(columns)))
    let mut border = ResolvedEdges.zero()
    row = cell.row
    while row < last {
      border.left = max(border.left, vertical.get(row * (columns + 1) + cell.column))
      border.right = max(border.right, vertical.get(row * (columns + 1) + end))
      row = row + 1
    }
    column = cell.column
    while column < end {
      border.top = max(border.top, horizontal.get(cell.row * columns + column))
      border.bottom = max(border.bottom, horizontal.get(last * columns + column))
      column = column + 1
    }
    let cells = plan.cells.asMutSlice()
    cells[index].plan = packCellBorders(ResolvedEdges { top: border.top / 2.0, right: border.right / 2.0, bottom: border.bottom / 2.0, left: border.left / 2.0 })
    index = index + 1
  }
}

// A length width as a border-box width, with the cell's collapsed borders when
// `plan` has them; zero for any other width.
fn specifiedWidth(style: &Style, plan: u64) -> f32 {
  if style.width.kind != DimensionKind.Length { return 0.0 }
  let mut width = length(style.width.value)
  if style.boxSizing == BoxSizing.ContentBox {
    let mut border = edge(style.border.left) + edge(style.border.right)
    if plan >= CELL_BORDERS { border = cellBorders(plan).horizontal() }
    width = width + edge(style.padding.left) + edge(style.padding.right) + border
  }
  return width
}
fn edge(value: Dimension) -> f32 { return length(resolve(value, 0.0, false, 0.0)) }

fn widthProbe(base: &Input, minimum: bool, plan: u64) -> Input {
  let mut probe = base.*
  probe.performLayout = false
  probe.baselines = false
  probe.fullSize = false
  probe.intrinsicWidth = true
  probe.known = OptionalSize.none()
  probe.availableWidth = AvailableSpace.maxContent()
  if minimum { probe.availableWidth = AvailableSpace.minContent() }
  probe.tablePlan = plan
  return probe
}

fn sized(base: &Input, width: f32, height: f32, heightKnown: bool, performLayout: bool, plan: u64) -> Input {
  let mut request = base.*
  request.performLayout = performLayout
  request.baselines = performLayout
  request.known = OptionalSize { width: width, height: height, widthDefinite: true, heightDefinite: heightKnown }
  request.availableWidth = AvailableSpace.definite(width)
  request.availableHeight = AvailableSpace.maxContent()
  if heightKnown { request.availableHeight = AvailableSpace.definite(height) }
  request.tablePlan = plan
  return request
}

// Whether the fixed layout reads a cell: a first-row cell with a length or percentage width.
fn fixedCell<S: LayoutSource>(nodes: &BoxTree<'_, S>, cell: &Cell) -> bool {
  return cell.row == 0 && (nodes.style(cell.box).width.kind == DimensionKind.Length || cell.percent >= 0.0)
}

// Column minimum and maximum widths from the cells (§17.5.2.2) or, in the fixed
// layout, specified widths from the columns and the first row (§17.5.2.1).
// Percentages are kept apart, as browsers do, and resolved against the grid width.
effect fn columnWidths<'pass, 'source, M: Measure + TextMeasure, S: LayoutSource>(nodes: &BoxTree<'source, S>, output: &mut LayoutPass<'pass, 'source>, measurer: &mut M, plan: &mut Plan, base: &Input, frame: &Frame, fixed: bool) ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let count = plan.columns.length()
  let mut index: usize = 0
  while index < plan.columnBoxes.length() {
    let entry = plan.columnBoxes.get(index)
    let style = nodes.style(entry.box)
    let percent = percentOf(style)
    if display(nodes, entry.box, DisplayInside.TableColumn) && (style.width.kind == DimensionKind.Length || percent >= 0.0) {
      let mut column = entry.first
      while column < entry.first + entry.span && column < count {
        let columns = plan.columns.asMutSlice()
        if percent >= 0.0 { columns[column].percent = max(columns[column].percent, percent) }
        else {
          columns[column].fixed = max(columns[column].fixed, length(style.width.value))
          columns[column].min = max(columns[column].min, columns[column].fixed)
          columns[column].max = max(columns[column].max, columns[column].fixed)
        }
        column = column + 1
      }
    }
    index = index + 1
  }
  index = 0
  while index < plan.cells.length() {
    let cell = plan.cells.get(index)
    let lengthWidth = nodes.style(cell.box).width.kind == DimensionKind.Length
    if !fixed || fixedCell(nodes, &cell) {
      // A probe sizes the content; a set width is the cell's own (§17.5.2.2).
      let specified = specifiedWidth(nodes.style(cell.box), cell.plan)
      let mut low: f32 = 0.0
      let mut high = specified
      if !fixed {
        run probeNode(nodes, &mut output, &mut measurer, cell.box, &widthProbe(base, true, cell.plan))
        low = max(output.boxes[cell.box].size.width, specified)
        if !lengthWidth {
          run probeNode(nodes, &mut output, &mut measurer, cell.box, &widthProbe(base, false, cell.plan))
          high = output.boxes[cell.box].size.width
        }
      }
      high = max(low, high)
      let cells = plan.cells.asMutSlice()
      cells[index].min = low
      cells[index].max = high
      if cell.columns == 1 {
        let columns = plan.columns.asMutSlice()
        if fixed {
          if cell.percent >= 0.0 {
            if columns[cell.column].fixed < 0.0 && columns[cell.column].percent < 0.0 { columns[cell.column].percent = cell.percent }
          } else if columns[cell.column].fixed < 0.0 && columns[cell.column].percent < 0.0 { columns[cell.column].fixed = high }
        } else {
          columns[cell.column].min = max(columns[cell.column].min, low)
          columns[cell.column].max = max(columns[cell.column].max, high)
          if cell.percent >= 0.0 { columns[cell.column].percent = max(columns[cell.column].percent, cell.percent) }
          else if lengthWidth { columns[cell.column].fixed = max(columns[cell.column].fixed, high) }
        }
      }
    }
    index = index + 1
  }
  // Spanning cells spread what their columns lack over them, narrowest spans first.
  let mut span: usize = 2
  let mut widest: usize = 1
  index = 0
  while index < plan.cells.length() {
    widest = larger(widest, plan.cells.get(index).columns)
    index = index + 1
  }
  while span <= widest {
    index = 0
    while index < plan.cells.length() {
      let cell = plan.cells.get(index)
      if cell.columns == span && (!fixed || fixedCell(nodes, &cell)) {
        let end = min(usize.toF32(cell.column + span), usize.toF32(count))
        let last = f32.toUsize(end)
        let gaps = frame.spacingX * usize.toF32(span - 1)
        if fixed {
          // The fixed layout splits a spanning cell's width over its columns without one.
          let mut free: usize = 0
          let mut taken: f32 = 0.0
          let mut takenPercent: f32 = 0.0
          let mut column = cell.column
          while column < last {
            let entry = plan.columns.get(column)
            if entry.percent >= 0.0 { takenPercent = takenPercent + entry.percent }
            else if entry.fixed >= 0.0 { taken = taken + entry.fixed }
            else { free = free + 1 }
            column = column + 1
          }
          if free > 0 {
            let share = max(0.0, cell.max - gaps - taken) / usize.toF32(free)
            let percentShare = max(0.0, cell.percent - takenPercent) / usize.toF32(free)
            column = cell.column
            while column < last {
              let columns = plan.columns.asMutSlice()
              if columns[column].fixed < 0.0 && columns[column].percent < 0.0 {
                if cell.percent >= 0.0 { columns[column].percent = percentShare }
                else { columns[column].fixed = share }
              }
              column = column + 1
            }
          }
        } else {
          spread(plan.columns.asMutSlice(), cell.column, last, cell.min - gaps, true)
          spread(plan.columns.asMutSlice(), cell.column, last, cell.max - gaps, false)
          if cell.percent >= 0.0 { spreadPercent(plan.columns.asMutSlice(), cell.column, last, cell.percent) }
        }
      }
      index = index + 1
    }
    span = span + 1
  }
  // Percentages past 100% are cut, in column order.
  let mut total: f32 = 0.0
  index = 0
  while index < count {
    let columns = plan.columns.asMutSlice()
    if columns[index].percent >= 0.0 {
      columns[index].percent = min(columns[index].percent, max(0.0, 1.0 - total))
      total = total + columns[index].percent
    }
    index = index + 1
  }
}

// Grows columns [first, end) so their minimums (or maximums) reach `needed`, in
// proportion to their maximums, evenly when those are all zero.
fn spread(columns: &mut [Column], first: usize, end: usize, needed: f32, minimum: bool) {
  let mut have: f32 = 0.0
  let mut weight: f32 = 0.0
  let mut column = first
  while column < end {
    if minimum { have = have + columns[column].min }
    else { have = have + columns[column].max }
    weight = weight + columns[column].max
    column = column + 1
  }
  let lack = needed - have
  if lack <= 0.0 || end <= first { return }
  column = first
  while column < end {
    let mut share = lack / usize.toF32(end - first)
    if weight > 0.0 { share = lack * columns[column].max / weight }
    if minimum {
      columns[column].min = columns[column].min + share
      columns[column].max = max(columns[column].max, columns[column].min)
    } else { columns[column].max = columns[column].max + share }
    column = column + 1
  }
}

// A spanning cell's percentage: what its percentage columns lack goes to the others,
// by their maximums, evenly when those are all zero.
fn spreadPercent(columns: &mut [Column], first: usize, end: usize, percent: f32) {
  let mut have: f32 = 0.0
  let mut weight: f32 = 0.0
  let mut free: usize = 0
  let mut column = first
  while column < end {
    if columns[column].percent >= 0.0 { have = have + columns[column].percent }
    else {
      weight = weight + columns[column].max
      free = free + 1
    }
    column = column + 1
  }
  let lack = percent - have
  if lack <= 0.0 || free == 0 { return }
  column = first
  while column < end {
    if columns[column].percent < 0.0 {
      if weight > 0.0 { columns[column].percent = lack * columns[column].max / weight }
      else { columns[column].percent = lack / usize.toF32(free) }
    }
    column = column + 1
  }
}

// The widest a table needs its columns to be: their maximums, widened so each
// percentage column gets its share and the other columns the rest. Percentages
// that leave nothing for other content make the table as wide as it may be.
const WIDEST: f32 = 1000000.0
fn gridMaximum(columns: &[Column]) -> f32 {
  let mut high: f32 = 0.0
  let mut percent: f32 = 0.0
  let mut rest: f32 = 0.0
  let mut ratio: f32 = 0.0
  let mut index: usize = 0
  while index < columns.length {
    high = high + columns[index].max
    if columns[index].percent >= 0.0 {
      percent = percent + columns[index].percent
      if columns[index].percent > 0.0 { ratio = max(ratio, columns[index].max / columns[index].percent) }
    } else { rest = rest + columns[index].max }
    index = index + 1
  }
  if percent <= 0.0 { return high }
  high = max(high, ratio)
  if percent < 1.0 { return max(high, rest / (1.0 - percent)) }
  if rest > 0.0 { return max(high, WIDEST) }
  return high
}

fn spacing(frame: &Frame, count: usize) -> f32 {
  if count == 0 { return 0.0 }
  return frame.spacingX * usize.toF32(count + 1)
}

// What a column is given at each of the automatic layout's guesses: percentage
// columns take their share first, then columns with a width grow to their
// maximums, then the rest.
fn percentWidth(column: &Column, available: f32) -> f32 { return max(column.min, column.percent * available) }
fn guess(column: &Column, available: f32, stage: usize) -> f32 {
  if stage == 0 { return column.min }
  if column.percent >= 0.0 { return percentWidth(column, available) }
  if stage == 1 { return column.min }
  if column.fixed >= 0.0 || stage == 3 { return column.max }
  return column.min
}

// Gives the columns `available` width: between the two guesses it falls between,
// in proportion to what each column gains from one to the next, and beyond the
// maximums to columns without a set width, then those with a length, then by
// percentage.
fn distribute(columns: &mut [Column], available: f32, fixed: bool) {
  if columns.length == 0 { return }
  let mut index: usize = 0
  if fixed {
    let mut taken: f32 = 0.0
    let mut free: usize = 0
    while index < columns.length {
      if columns[index].percent >= 0.0 { taken = taken + columns[index].percent * available }
      else if columns[index].fixed >= 0.0 { taken = taken + columns[index].fixed }
      else { free = free + 1 }
      index = index + 1
    }
    let rest = available - taken
    index = 0
    while index < columns.length {
      let mut set = columns[index].fixed
      if columns[index].percent >= 0.0 { set = columns[index].percent * available }
      if set >= 0.0 { columns[index].width = set }
      else { columns[index].width = max(0.0, rest / usize.toF32(free)) }
      if free == 0 && rest > 0.0 {
        if taken > 0.0 { columns[index].width = set + rest * set / taken }
        else { columns[index].width = rest / usize.toF32(columns.length) }
      }
      index = index + 1
    }
    return
  }
  let mut sums: [f32; 4] = [0.0, 0.0, 0.0, 0.0]
  let mut stage: usize = 0
  while stage < 4 {
    index = 0
    while index < columns.length {
      sums[stage] = sums[stage] + guess(&columns[index], available, stage)
      index = index + 1
    }
    stage = stage + 1
  }
  if available <= sums[0] {
    index = 0
    while index < columns.length {
      columns[index].width = columns[index].min
      index = index + 1
    }
    return
  }
  stage = 1
  while stage < 4 {
    if available <= sums[stage] {
      let span = sums[stage] - sums[stage - 1]
      index = 0
      while index < columns.length {
        let low = guess(&columns[index], available, stage - 1)
        let high = guess(&columns[index], available, stage)
        columns[index].width = low
        if span > 0.0 { columns[index].width = low + (high - low) * (available - sums[stage - 1]) / span }
        index = index + 1
      }
      return
    }
    stage = stage + 1
  }
  let extra = available - sums[3]
  let mut autoWeight: f32 = 0.0
  let mut autoCount: usize = 0
  let mut fixedWeight: f32 = 0.0
  let mut fixedCount: usize = 0
  let mut percentWeight: f32 = 0.0
  index = 0
  while index < columns.length {
    let column = columns[index]
    columns[index].width = guess(&column, available, 3)
    if column.percent >= 0.0 { percentWeight = percentWeight + column.percent }
    else if column.fixed >= 0.0 {
      fixedWeight = fixedWeight + column.max
      fixedCount = fixedCount + 1
    } else {
      autoWeight = autoWeight + column.max
      autoCount = autoCount + 1
    }
    index = index + 1
  }
  let total = columns.length
  index = 0
  while index < total {
    let column = &mut columns[index]
    if autoCount > 0 {
      if column.percent < 0.0 && column.fixed < 0.0 {
        if autoWeight > 0.0 { column.width = column.width + extra * column.max / autoWeight }
        else { column.width = column.width + extra / usize.toF32(autoCount) }
      }
    } else if fixedCount > 0 {
      if column.percent < 0.0 {
        if fixedWeight > 0.0 { column.width = column.width + extra * column.max / fixedWeight }
        else { column.width = column.width + extra / usize.toF32(fixedCount) }
      }
    } else if percentWeight > 0.0 { column.width = column.width + extra * column.percent / percentWeight }
    else { column.width = column.width + extra / usize.toF32(total) }
    index = index + 1
  }
}

// Summed rather than subtracted from the columns' offsets, so a one-column cell is
// exactly its column's width.
fn spanned(plan: &Plan, frame: &Frame, cell: &Cell) -> f32 {
  let end = cell.column + cell.columns
  let columns = plan.columns.asSlice()
  if end > columns.length || cell.columns == 0 { return 0.0 }
  let mut width: f32 = 0.0
  let mut shown: usize = 0
  let mut column = cell.column
  while column < end {
    if !columns[column].collapsed {
      width = width + columns[column].width
      shown = shown + 1
    }
    column = column + 1
  }
  if shown > 1 { width = width + frame.spacingX * usize.toF32(shown - 1) }
  return width
}

fn hidden(plan: &Plan, cell: &Cell) -> bool {
  let mut column = cell.column
  while column < cell.column + cell.columns && column < plan.columns.length() {
    if !plan.columns.get(column).collapsed { return false }
    column = column + 1
  }
  return true
}

fn rowsSpanned(plan: &Plan, cell: &Cell) -> f32 {
  let rows = plan.rows.asSlice()
  let last = cell.row + larger(1, cell.rows) - 1
  return rows[last].y + rows[last].height - rows[cell.row].y
}

const OFFSET: u64 = 14695981039346656037
const PRIME: u64 = 1099511628211
fn mix(hash: u64, value: f32) -> u64 { return u64.wrappingMultiply(u64.bitXor(hash, u32.toU64(f32.toBits(value))), PRIME) }

fn setSlot(output: &mut LayoutPass<'_, '_>, id: usize, rect: Rect) {
  let slots = output.tableSlots.asMutSlice()
  slots[id] = rect
}

effect fn reserveSlots(output: &mut LayoutPass<'_, '_>, count: usize) ! OutOfMemoryError ? &mut Allocator {
  while output.tableSlots.length() < count { run output.tableSlots.append(Rect.zero()) }
  while output.tablePlans.length() < count { run output.tablePlans.append(0) }
}

fn relative(rect: Rect, origin: Rect) -> Rect { return Rect { x: rect.x - origin.x, y: rect.y - origin.y, width: rect.width, height: rect.height } }

pub effect fn layoutTable<'pass, 'source, M: Measure + TextMeasure, S: LayoutSource>(nodes: &BoxTree<'source, S>, output: &mut LayoutPass<'pass, 'source>, measurer: &mut M, id: usize, input: &Input, box: &ResolvedBox) -> Layout ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let style = nodes.style(id)
  let mut plan = Plan.make()
  run collect(nodes, id, &mut plan)
  let mut frame = frameOf(style, box)
  if frame.collapse { run collapseBorders(nodes, id, &mut plan, &mut frame) }
  let mut base = childrenInput(input, style, box, OptionalSize.none())
  base.fragmentation.active = false
  let fixed = style.tableLayout == TableLayout.Fixed && style.width.kind != DimensionKind.Auto
  run columnWidths(nodes, &mut output, &mut measurer, &mut plan, &base, &frame, fixed)
  let count = plan.columns.length()
  let rowCount = plan.rows.length()
  let insetWidth = frame.left + frame.right
  let gaps = spacing(&frame, count)
  let mut low: f32 = 0.0
  let mut high: f32 = 0.0
  let mut index: usize = 0
  while index < count {
    let column = plan.columns.get(index)
    if fixed {
      low = low + max(0.0, column.fixed)
      high = high + max(0.0, column.fixed)
    } else { low = low + column.min }
    index = index + 1
  }
  if !fixed { high = gridMaximum(plan.columns.asSlice()) }
  let mut tableMin = low + gaps + insetWidth
  let mut tableMax = max(tableMin, high + gaps + insetWidth)
  // §17.4: the table is at least as wide as its captions need. As in browsers, captions
  // sit outside the table's borders and padding, across its whole width.
  index = 0
  while index < plan.captions.length() {
    let caption = plan.captions.get(index)
    run probeNode(nodes, &mut output, &mut measurer, caption, &widthProbe(&base, true, 0))
    tableMin = max(tableMin, output.boxes[caption].size.width)
    tableMax = max(tableMax, tableMin)
    index = index + 1
  }
  let mut width = tableMax
  if box.size.widthDefinite { width = box.size.width }
  else if input.intrinsicWidth && input.availableWidth.kind == AvailableKind.MinContent { width = tableMin }
  else if !input.intrinsicWidth && input.availableWidth.kind == AvailableKind.Definite { width = clamp(input.availableWidth.value - box.margin.horizontal(), tableMin, tableMax) }
  if !box.size.widthDefinite { width = clamp(width, box.min.width, box.max.width) }
  width = max(width, tableMin)
  distribute(plan.columns.asMutSlice(), width - insetWidth - gaps, fixed)
  // §17.5.5: collapsed columns give back their width and one spacing.
  let mut x = frame.left + frame.spacingX
  index = 0
  while index < count {
    let columns = plan.columns.asMutSlice()
    if columns[index].collapsed {
      width = width - columns[index].width - frame.spacingX
      columns[index].width = 0.0
      columns[index].x = x - frame.spacingX
    } else {
      columns[index].x = x
      x = x + columns[index].width + frame.spacingX
    }
    index = index + 1
  }

  let mut result = Layout.zero()
  if input.intrinsicWidth && !input.fullSize {
    result.size = Size { width: width, height: box.inset.vertical() }
    return result
  }
  // Rows are as tall as their cells, and cells spanning rows spread what they lack.
  index = 0
  while index < rowCount {
    let rows = plan.rows.asMutSlice()
    rows[index].height = rows[index].specified
    index = index + 1
  }
  index = 0
  while index < plan.cells.length() {
    let cell = plan.cells.get(index)
    let cellWidth = spanned(&plan, &frame, &cell)
    run probeNode(nodes, &mut output, &mut measurer, cell.box, &sized(&base, cellWidth, 0.0, false, false, cell.plan))
    let height = max(0.0, output.boxes[cell.box].size.height)
    // A cell wholly in collapsed columns does not size its rows.
    let counts = !hidden(&plan, &cell)
    let cells = plan.cells.asMutSlice()
    cells[index].height = height
    if !counts { cells[index].height = 0.0 }
    else if cell.rows <= 1 {
      let rows = plan.rows.asMutSlice()
      rows[cell.row].height = max(rows[cell.row].height, height)
    }
    index = index + 1
  }
  index = 0
  while index < plan.cells.length() {
    let cell = plan.cells.get(index)
    if cell.rows > 1 {
      let mut have = frame.spacingY * usize.toF32(cell.rows - 1)
      let mut open: usize = 0
      let mut row = cell.row
      while row < cell.row + cell.rows {
        have = have + plan.rows.get(row).height
        if !plan.rows.get(row).collapsed { open = open + 1 }
        row = row + 1
      }
      if cell.height > have && open > 0 {
        let share = (cell.height - have) / usize.toF32(open)
        row = cell.row
        while row < cell.row + cell.rows {
          let rows = plan.rows.asMutSlice()
          if !rows[row].collapsed { rows[row].height = rows[row].height + share }
          row = row + 1
        }
      }
    }
    index = index + 1
  }
  let mut visibleRows: usize = 0
  index = 0
  while index < rowCount {
    let rows = plan.rows.asMutSlice()
    if rows[index].collapsed { rows[index].height = 0.0 }
    else { visibleRows = visibleRows + 1 }
    index = index + 1
  }
  let captionWidth = width
  let mut above: f32 = 0.0
  let mut below: f32 = 0.0
  index = 0
  while index < plan.captions.length() {
    let caption = plan.captions.get(index)
    run probeNode(nodes, &mut output, &mut measurer, caption, &sized(&base, captionWidth, 0.0, false, false, 0))
    if nodes.style(caption).captionSide == CaptionSide.Bottom { below = below + output.boxes[caption].size.height }
    else { above = above + output.boxes[caption].size.height }
    index = index + 1
  }
  let mut rowsHeight: f32 = 0.0
  index = 0
  while index < rowCount {
    rowsHeight = rowsHeight + plan.rows.get(index).height
    index = index + 1
  }
  let mut grid: f32 = 0.0
  if rowCount > 0 { grid = rowsHeight + frame.spacingY * usize.toF32(visibleRows + 1) }
  let natural = frame.top + frame.bottom + above + grid + below
  let mut height = clamp(natural, box.min.height, box.max.height)
  if box.size.heightDefinite { height = box.size.height }
  height = max(height, natural)
  // §17.5.3: a taller table makes its rows taller.
  if height > natural && visibleRows > 0 {
    let share = (height - natural) / usize.toF32(visibleRows)
    index = 0
    while index < rowCount {
      let rows = plan.rows.asMutSlice()
      if !rows[index].collapsed { rows[index].height = rows[index].height + share }
      index = index + 1
    }
  }
  let gridTop = above + frame.top
  let mut y = gridTop + frame.spacingY
  index = 0
  while index < rowCount {
    let rows = plan.rows.asMutSlice()
    if rows[index].collapsed { rows[index].y = y - frame.spacingY }
    else {
      rows[index].y = y
      y = y + rows[index].height + frame.spacingY
    }
    index = index + 1
  }
  if input.performLayout && input.fragmentation.active && output.frame != NO_NODE {
    return run layoutFragment(nodes, &mut output, &mut measurer, id, input, box, &mut plan, &frame, &base, width, above, below)
  }
  result.size = Size { width: width, height: height }
  if !input.performLayout { return result }
  let shown = List<bool>.make()
  run assignSlots(nodes, &mut output, id, &plan, &frame, &shown, &List<u8>.make(), &List<f32>.make(), gridTop + frame.spacingY, true, gridTop + grid + frame.bottom, true, width)
  run placeChildren(nodes, &mut output, &mut measurer, id, &base, input.performLayout, NO_NODE)
  return result
}

// The rows from `first` to `end` as they take block space: each shown row and the
// spacing after it.
fn rowsExtent(plan: &Plan, frame: &Frame, first: usize, end: usize) -> f32 {
  let mut size: f32 = 0.0
  let mut row = first
  while row < end {
    let value = plan.rows.get(row)
    if !value.collapsed { size = size + value.height + frame.spacingY }
    row = row + 1
  }
  return size
}

// Whether a forced break comes before `row`: break-after of the row (or the group it
// ends) before it, or break-before of the row (or the group it opens).
fn forcedBefore<S: LayoutSource>(nodes: &BoxTree<'_, S>, plan: &Plan, row: usize, input: &Input) -> bool {
  let mut boundary = BreakBoundary.none()
  let kind = input.fragmentation.kind
  let recto = input.fragmentation.rectoOnRight
  if row > 0 {
    let previous = plan.rows.get(row - 1)
    let section = plan.sections.get(previous.section)
    if section.end == row && section.box != NO_NODE { boundary.merge(BreakBoundary.make(nodes.style(section.box).breakAfter, kind, recto)) }
    if previous.box != NO_NODE { boundary.merge(BreakBoundary.make(nodes.style(previous.box).breakAfter, kind, recto)) }
  }
  let current = plan.rows.get(row)
  let section = plan.sections.get(current.section)
  if section.first == row && section.box != NO_NODE { boundary.merge(BreakBoundary.make(nodes.style(section.box).breakBefore, kind, recto)) }
  if current.box != NO_NODE { boundary.merge(BreakBoundary.make(nodes.style(current.box).breakBefore, kind, recto)) }
  return boundary.forced.active(input.fragmentation.activeKinds()).kinds.any()
}

// Moves the rows from `first` to `end` to `y`, marking them shown, and returns
// where the next row goes.
effect fn showRows(plan: &mut Plan, frame: &Frame, shown: &mut List<bool>, first: usize, end: usize, y: f32) -> f32 ! OutOfMemoryError ? &mut Allocator {
  let mut at = y
  let mut row = first
  while row < end {
    let rows = plan.rows.asMutSlice()
    let values = shown.asMutSlice()
    values[row] = true
    if rows[row].collapsed { rows[row].y = at - frame.spacingY }
    else {
      rows[row].y = at
      at = at + rows[row].height + frame.spacingY
    }
    row = row + 1
  }
  return at
}

// CSS Tables 3 §6.1: a table breaks between its rows, keeping a row whole unless it is
// freely fragmentable: joined to the next by a row-spanning cell, or at least half the
// fragmentainer's height or width. Such a row, or any row when none fits, takes the
// rest of the fragmentainer, and its cells break inside and go on in the next one.
// The header and footer groups repeat on every page when they take at most a quarter
// of it, as in Chromium. The cursor is the next body row and how much of it was placed.
effect fn layoutFragment<'pass, 'source, M: Measure + TextMeasure, S: LayoutSource>(nodes: &BoxTree<'source, S>, output: &mut LayoutPass<'pass, 'source>, measurer: &mut M, id: usize, input: &Input, box: &ResolvedBox, plan: &mut Plan, frame: &Frame, base: &Input, width: f32, above: f32, below: f32) -> Layout ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let mut state = output.resumes.get(id)
  let mut result = Layout.zero()
  if input.fragmentation.boundaryProbe != BoundaryProbe.None {
    state.normalContentComplete = true
    state.descendantsComplete = true
    run output.resumes.set(id, state)
    return result
  }
  let rowCount = plan.rows.length()
  let sections = plan.sections.length()
  let mut header = NO_NODE
  let mut headEnd: usize = 0
  let mut footer = NO_NODE
  let mut footStart = rowCount
  if sections > 0 {
    let first = plan.sections.get(0)
    if first.box != NO_NODE && display(nodes, first.box, DisplayInside.TableHeaderGroup) {
      header = first.box
      headEnd = first.end
    }
    let last = plan.sections.get(sections - 1)
    if (sections > 1 || header == NO_NODE) && last.box != NO_NODE && display(nodes, last.box, DisplayInside.TableFooterGroup) {
      footer = last.box
      footStart = last.first
    }
  }
  let mut extent = UNBOUNDED
  let mut inline = UNBOUNDED
  match output.frames.get(output.frame) {
    Option<Fragmentainer>.Some { value } => {
      extent = value.blockExtent
      inline = value.rect.width
      if output.frames.writingMode != WritingMode.HorizontalTb { inline = value.rect.height }
    }
    Option<Fragmentainer>.None => {}
  }
  let headerSize = rowsExtent(&plan, &frame, 0, headEnd)
  let footerSize = rowsExtent(&plan, &frame, footStart, rowCount)
  // Chromium repeats them on pages only, not in columns.
  let pages = input.fragmentation.kind == FragmentainerKind.Page
  let repeatHeader = pages && header != NO_NODE && headerSize <= extent / 4.0
  let repeatFooter = pages && footer != NO_NODE && footerSize <= extent / 4.0
  let started = state.started
  let mut start = headEnd
  let mut startConsumed: f32 = 0.0
  match &state.cursor {
    FlowCursor.Grid { row, progress, gap, columnRepeat, rowRepeat, consumed, boundaryHandled } => {
      drop progress
      drop gap
      drop columnRepeat
      drop rowRepeat
      drop boundaryHandled
      if started {
        start = row
        startConsumed = consumed
      }
    }
    _ => {}
  }
  // Rows change height below; cells keep their whole heights.
  let mut heights = List<f32>.make()
  let mut index: usize = 0
  while index < rowCount {
    run heights.append(plan.rows.get(index).height)
    index = index + 1
  }
  // reach[row]: the end of the rows the cells starting at or before `row` span.
  let mut reach = List<usize>.make()
  run reach.appendRepeated(0, rowCount)
  let mut full = List<f32>.make()
  index = 0
  while index < plan.cells.length() {
    let cell = plan.cells.get(index)
    let end = cellEnd(&cell)
    let values = reach.asMutSlice()
    values[cell.row] = larger(values[cell.row], end)
    run full.append(max(0.0, rowsExtent(&plan, &frame, cell.row, end) - frame.spacingY))
    index = index + 1
  }
  index = 1
  while index < rowCount {
    let values = reach.asMutSlice()
    values[index] = larger(values[index], values[index - 1])
    index = index + 1
  }
  let room = input.fragmentation.limit - input.fragmentation.offset
  let mut reserve: f32 = 0.0
  if repeatFooter { reserve = footerSize }
  // Where the last row's block space ends: border-spacing still follows it.
  let limit = room - reserve - frame.spacingY
  let mut shown = List<bool>.make()
  run shown.appendRepeated(false, rowCount)
  let mut grown: f32 = 0.0
  let mut attempt: usize = 0
  while true {
    index = 0
    while index < rowCount {
      let rows = plan.rows.asMutSlice()
      rows[index].height = heights.get(index)
      let values = shown.asMutSlice()
      values[index] = false
      index = index + 1
    }
    let mut y = frame.top
    // Cells going on from a split row have no top border to make room for.
    if startConsumed > 0.0 && frame.collapse && !state.cloneStart { y = 0.0 }
    if !started { y = y + above }
    let gridTop = y
    y = y + frame.spacingY
    if header != NO_NODE && (!started || repeatHeader) { y = run showRows(&mut plan, &frame, &mut shown, 0, headEnd, y) }
    let bodyStart = y
    let mut next = start
    let mut consumed: f32 = 0.0
    let mut placed = false
    let mut rest: f32 = 0.0
    if startConsumed > 0.0 {
      // The row split in the previous fragment goes on with what is left of it.
      rest = max(heights.get(next) - startConsumed, grown)
      if y + rest <= limit || limit <= y {
        setHeight(&mut plan, next, rest)
        y = run showRows(&mut plan, &frame, &mut shown, next, next + 1, y)
        next = next + 1
        placed = true
      } else {
        setHeight(&mut plan, next, limit - y)
        consumed = startConsumed + limit - y
        y = run showRows(&mut plan, &frame, &mut shown, next, next + 1, y)
      }
    }
    while consumed == 0.0 && next < footStart {
      let mut end = next + 1
      if next > 0 { end = larger(end, reach.get(next - 1)) }
      while end < footStart && reach.get(end - 1) > end { end = reach.get(end - 1) }
      if end > footStart { end = footStart }
      if next > start && forcedBefore(nodes, &plan, next, input) { break }
      let size = rowsExtent(&plan, &frame, next, end)
      if y + size + reserve <= room {
        y = run showRows(&mut plan, &frame, &mut shown, next, end, y)
        next = end
        placed = true
        continue
      }
      let height = heights.get(next)
      let free = end > next + 1 || (next > 0 && reach.get(next - 1) > next) || height > extent / 2.0 || height > inline / 2.0
      if !free && placed { break }
      if !placed && !started && input.fragmentation.canBreakBefore && (!free || limit <= y) {
        // The table starts in the next fragmentainer.
        state.blocked = true
        run output.resumes.set(id, state)
        return result
      }
      let mut row = next
      while row < end && y + heights.get(row) <= limit {
        y = run showRows(&mut plan, &frame, &mut shown, row, row + 1, y)
        row = row + 1
      }
      if limit > y {
        setHeight(&mut plan, row, limit - y)
        consumed = limit - y
        y = run showRows(&mut plan, &frame, &mut shown, row, row + 1, y)
        next = row
      } else if row > next {
        // The break falls between rows a spanning cell joins.
        next = row
      } else if !placed {
        // Nothing fits: the rows overflow whole.
        y = run showRows(&mut plan, &frame, &mut shown, next, end, y)
        next = end
      }
      break
    }
    let complete = next >= footStart && consumed == 0.0
    if footer != NO_NODE && (complete || repeatFooter) { y = run showRows(&mut plan, &frame, &mut shown, footStart, rowCount, y) }
    let checkpoint = output.checkpoint()
    run placeFragment(nodes, &mut output, &mut measurer, id, input, &mut plan, &frame, &base, &mut shown, &full, started, start, startConsumed, next, consumed, headEnd, bodyStart, limit, gridTop, y, complete, width, repeatHeader, header, footer, repeatFooter)
    // A cell going on in this fragment may need more than its row has left.
    let mut needed: f32 = 0.0
    if attempt == 0 && startConsumed > 0.0 {
      index = 0
      while index < plan.cells.length() {
        let cell = plan.cells.get(index)
        if cell.row <= start && cellEnd(&cell) == start + 1 {
          let fragment = output.publication(cell.box)
          if fragment != NO_NODE { needed = max(needed, output.fragments.values.asSlice()[fragment].size.height) }
        }
        index = index + 1
      }
    }
    if needed > rest + 0.01 {
      output.restoreCheckpoint(checkpoint)
      grown = needed
      attempt = attempt + 1
      continue
    }
    output.closeCheckpoint(checkpoint)
    let mut bottom = y
    if complete { bottom = y + below }
    state.cursor = FlowCursor.Grid { row: next, progress: FractionalProgress.make(), gap: FractionalProgress.make(), columnRepeat: 0, rowRepeat: 0, consumed: consumed, boundaryHandled: false }
    state.normalContentComplete = complete
    state.descendantsComplete = complete
    state.cloneStart = repeatHeader
    run output.resumes.set(id, state)
    // The current box's top inset is in `bottom`; FragmentBox.finish adds the bottom one.
    result.size = Size { width: width, height: max(bottom, box.inset.top) + box.inset.bottom }
    return result
  }
  return result
}

fn setHeight(plan: &mut Plan, row: usize, height: f32) {
  let rows = plan.rows.asMutSlice()
  rows[row].height = height
}

fn cellEnd(cell: &Cell) -> usize { return cell.row + larger(1, cell.rows) }

// Lays out the parts a fragment holds. A cell that began in an earlier fragment or goes
// on in a later one breaks inside: it gets its whole height and the fragmentainer's
// limit, and its fragment here is stretched to the rows it covers.
effect fn placeFragment<'pass, 'source, M: Measure + TextMeasure, S: LayoutSource>(nodes: &BoxTree<'source, S>, output: &mut LayoutPass<'pass, 'source>, measurer: &mut M, id: usize, input: &Input, plan: &mut Plan, frame: &Frame, base: &Input, shown: &mut List<bool>, full: &List<f32>, started: bool, start: usize, startConsumed: f32, next: usize, consumed: f32, headEnd: usize, bodyStart: f32, limit: f32, gridTop: f32, y: f32, complete: bool, width: f32, repeatHeader: bool, header: usize, footer: usize, repeatFooter: bool) ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let mut began = start
  if startConsumed > 0.0 { began = start + 1 }
  let mut goes = next
  if consumed > 0.0 { goes = next + 1 }
  let mut cut = List<u8>.make()
  let mut index: usize = 0
  while index < plan.cells.length() {
    let cell = plan.cells.get(index)
    let end = cellEnd(&cell)
    let before = started && cell.row < began && end > start
    let after = cell.row < goes && end > next && (before || cell.row >= start)
    let mut flag: u8 = 0
    if before || after { flag = CUT }
    if before && output.resumes.get(cell.box).contentComplete { flag = GONE }
    // A row of earlier fragments is carried, empty, for the cells going on from it.
    if cell.row >= headEnd && cell.row < start && flag != CUT { flag = GONE }
    if flag == CUT && cell.row < start {
      let mut row = cell.row
      while row < start {
        if !shown.get(row) {
          let values = shown.asMutSlice()
          values[row] = true
          let rows = plan.rows.asMutSlice()
          rows[row].y = bodyStart
          rows[row].height = 0.0
        }
        row = row + 1
      }
    }
    run cut.append(flag)
    index = index + 1
  }
  run assignSlots(nodes, &mut output, id, &plan, &frame, &shown, &cut, &full, gridTop + frame.spacingY, !started, y, complete, width)
  while output.tableSplits.length() < nodes.boxes.length() { run output.tableSplits.append(FragmentInput.continuous()) }
  index = 0
  while index < plan.cells.length() {
    let cell = plan.cells.get(index)
    if cut.get(index) == CUT {
      let mut split = input.fragmentation
      split.active = true
      split.offset = input.fragmentation.offset + plan.rows.get(cell.row).y
      split.limit = input.fragmentation.offset + limit
      split.canBreakBefore = false
      split.avoidInside = false
      split.forcedStart = false
      split.contextStart = false
      split.marginStart = false
      split.marginEnd = false
      split.marginEndChosen = false
      split.sourceAdjacent = false
      split.sourceBoundary = BreakBoundary.none()
      split.allocatedAutoExtent = true
      split.boundaryProbe = BoundaryProbe.None
      let splits = output.tableSplits.asMutSlice()
      splits[cell.box] = split
    }
    index = index + 1
  }
  let mut repeated = NO_NODE
  if started && header != NO_NODE && repeatHeader { repeated = header }
  run placeChildren(nodes, &mut output, &mut measurer, id, &base, true, repeated)
  index = 0
  while index < plan.cells.length() {
    let cell = plan.cells.get(index)
    if cut.get(index) == CUT {
      let splits = output.tableSplits.asMutSlice()
      splits[cell.box].active = false
      let top = plan.rows.get(cell.row).y
      let mut bottom = top
      let mut row = cell.row
      while row < cellEnd(&cell) {
        if shown.get(row) { bottom = max(bottom, plan.rows.get(row).y + plan.rows.get(row).height) }
        row = row + 1
      }
      run stretch(&mut output, cell.box, bottom - top)
    }
    index = index + 1
  }
  if !complete && footer != NO_NODE && repeatFooter { markRepeated(&mut output, footer) }
}

const CUT: u8 = 1
const GONE: u8 = 2

// Grows the fragment this frame published for a split cell to the rows it covers.
effect fn stretch(output: &mut LayoutPass<'_, '_>, id: usize, height: f32) ! OutOfMemoryError ? &mut Allocator {
  let first = output.publication(id)
  if first == NO_NODE { return }
  let grow = height - output.fragments.values.asSlice()[first].size.height
  if grow <= 0.0 { return }
  run output.fragments.edit(first)
  let values = output.fragments.values.asMutSlice()
  values[first].size.height = values[first].size.height + grow
  values[first].contentRect.height = values[first].contentRect.height + grow
  values[first].paddingRect.height = values[first].paddingRect.height + grow
  values[first].layoutBounds.height = values[first].layoutBounds.height + grow
}

// Marks the fragment this frame published for `id` and what it holds as repeated.
fn markRepeated(output: &mut LayoutPass<'_, '_>, id: usize) {
  let first = output.publication(id)
  if first == NO_NODE { return }
  let values = output.fragments.values.asMutSlice()
  let mut index = first
  while index < values.length {
    if index != first && values[index].parent < first { break }
    values[index].repeated = true
    index = index + 1
  }
}

// Gives every in-flow part of the table its slot. In a fragment `shown` says which rows
// it holds (empty: all of them); a part it does not hold gets a slot of negative width,
// which placeChildren skips. Columns span from `rowsTop` to the last row held. Top captions go only in the first fragment, bottom ones at
// `captionBottom` only in the last.
effect fn assignSlots<S: LayoutSource>(nodes: &BoxTree<'_, S>, output: &mut LayoutPass<'_, '_>, id: usize, plan: &Plan, frame: &Frame, shown: &List<bool>, cut: &List<u8>, full: &List<f32>, rowsTop: f32, first: bool, captionBottom: f32, last: bool, captionWidth: f32) ! OutOfMemoryError ? &mut Allocator {
  let count = plan.columns.length()
  let rowCount = plan.rows.length()
  let all = shown.length() == 0
  run reserveSlots(&mut output, nodes.boxes.length())
  let mut gridLeft = frame.left + frame.spacingX
  let mut gridRight = gridLeft
  if count > 0 { gridRight = plan.columns.get(count - 1).x + plan.columns.get(count - 1).width }
  let mut rowsBottom = rowsTop
  if all && rowCount > 0 { rowsBottom = plan.rows.get(rowCount - 1).y + plan.rows.get(rowCount - 1).height }
  let mut index: usize = 0
  while !all && index < rowCount {
    if shown.get(index) { rowsBottom = max(rowsBottom, plan.rows.get(index).y + plan.rows.get(index).height) }
    index = index + 1
  }
  let hide = Rect { x: 0.0, y: 0.0, width: -1.0, height: 0.0 }
  let mut sectionRects = List<Rect>.make()
  index = 0
  while index < plan.sections.length() {
    let section = plan.sections.get(index)
    let mut rect = Rect { x: gridLeft, y: rowsTop, width: gridRight - gridLeft, height: 0.0 }
    let mut held = all || first
    if all && section.first < section.end {
      rect.y = plan.rows.get(section.first).y
      rect.height = plan.rows.get(section.end - 1).y + plan.rows.get(section.end - 1).height - rect.y
    } else if section.first < section.end {
      held = false
      let mut top = UNBOUNDED
      let mut bottom: f32 = 0.0
      let mut row = section.first
      while row < section.end {
        if all || shown.get(row) {
          held = true
          top = min(top, plan.rows.get(row).y)
          bottom = max(bottom, plan.rows.get(row).y + plan.rows.get(row).height)
        }
        row = row + 1
      }
      if held { rect.y = top
        rect.height = bottom - top }
    } else if section.first < rowCount { rect.y = plan.rows.get(section.first).y }
    if !held { rect = hide }
    run sectionRects.append(rect)
    if section.box != NO_NODE { setSlot(&mut output, section.box, rect) }
    index = index + 1
  }
  let zero = Rect.zero()
  let mut rowRects = List<Rect>.make()
  index = 0
  while index < rowCount {
    let row = plan.rows.get(index)
    let mut rect = Rect { x: gridLeft, y: row.y, width: gridRight - gridLeft, height: row.height }
    if !all && !shown.get(index) { rect = hide }
    run rowRects.append(rect)
    if row.box != NO_NODE {
      let mut origin = zero
      if row.parent != id { origin = sectionRects.get(row.section) }
      if rect.width < 0.0 { setSlot(&mut output, row.box, hide) }
      else { setSlot(&mut output, row.box, relative(rect, origin)) }
    }
    index = index + 1
  }
  index = 0
  while index < plan.cells.length() {
    let cell = plan.cells.get(index)
    let mut flag: u8 = 0
    if index < cut.length() { flag = cut.get(index) }
    if (all || shown.get(cell.row)) && flag != GONE {
      let mut rect = Rect { x: frame.left, y: rowsTop, width: 0.0, height: 0.0 }
      if cell.column < count { rect.x = plan.columns.get(cell.column).x }
      rect.y = plan.rows.get(cell.row).y
      rect.width = spanned(&plan, &frame, &cell)
      // A cell breaking inside keeps its whole height (see placeFragment).
      if flag == CUT { rect.height = full.get(index) } else { rect.height = rowsSpanned(&plan, &cell) }
      let row = plan.rows.get(cell.row)
      let mut origin = zero
      if row.box != NO_NODE { origin = rowRects.get(cell.row) }
      else if row.parent != id { origin = sectionRects.get(row.section) }
      setSlot(&mut output, cell.box, relative(rect, origin))
    } else { setSlot(&mut output, cell.box, hide) }
    let plans = output.tablePlans.asMutSlice()
    plans[cell.box] = cell.plan
    index = index + 1
  }
  // Column groups first: their columns sit inside them.
  let mut pass: usize = 0
  while pass < 2 {
    index = 0
    while index < plan.columnBoxes.length() {
      let entry = plan.columnBoxes.get(index)
      if (entry.parent == NO_NODE) == (pass == 0) {
        let mut rect = Rect { x: gridLeft, y: rowsTop, width: 0.0, height: rowsBottom - rowsTop }
        if entry.first < count && entry.span > 0 {
          let end = f32.toUsize(min(usize.toF32(entry.first + entry.span), usize.toF32(count))) - 1
          rect.x = plan.columns.get(entry.first).x
          rect.width = plan.columns.get(end).x + plan.columns.get(end).width - rect.x
        }
        let mut origin = zero
        if entry.parent != id && entry.parent != NO_NODE { origin = output.tableSlots.get(entry.parent) }
        setSlot(&mut output, entry.box, relative(rect, origin))
      }
      index = index + 1
    }
    pass = pass + 1
  }
  let mut captionTop: f32 = 0.0
  let mut bottom = captionBottom
  index = 0
  while index < plan.captions.length() {
    let caption = plan.captions.get(index)
    let height = output.boxes[caption].size.height
    let mut rect = Rect { x: 0.0, y: captionTop, width: captionWidth, height: height }
    if nodes.style(caption).captionSide == CaptionSide.Bottom {
      rect.y = bottom
      bottom = bottom + height
      if !last { rect = hide }
    } else {
      captionTop = captionTop + height
      if !first { rect = hide }
    }
    setSlot(&mut output, caption, rect)
    index = index + 1
  }
  // A part is kept only while what it places is placed where it was.
  index = 0
  while index < plan.sections.length() {
    let section = plan.sections.get(index).box
    if section != NO_NODE { run digest(nodes, &mut output, section) }
    index = index + 1
  }
  index = 0
  while index < rowCount {
    let row = plan.rows.get(index).box
    if row != NO_NODE { run digest(nodes, &mut output, row) }
    index = index + 1
  }
  index = 0
  while index < plan.columnBoxes.length() {
    let entry = plan.columnBoxes.get(index)
    if part(nodes, entry.box) { run digest(nodes, &mut output, entry.box) }
    index = index + 1
  }
}

effect fn digest<S: LayoutSource>(nodes: &BoxTree<'_, S>, output: &mut LayoutPass<'_, '_>, id: usize) ! OutOfMemoryError ? &mut Allocator {
  let mut hash = OFFSET
  let mut child = nodes.node(id).firstChild
  while child != NO_NODE {
    if inFlow(nodes, child) {
      let slot = output.tableSlots.get(child)
      hash = mix(mix(mix(mix(hash, slot.x), slot.y), slot.width), slot.height)
      hash = u64.wrappingMultiply(u64.bitXor(hash, output.tablePlans.get(child)), PRIME)
    }
    child = nodes.node(child).nextSibling
  }
  // Clear of CELL_BORDERS, which marks a cell's borders instead.
  let plans = output.tablePlans.asMutSlice()
  plans[id] = u64.bitAnd(hash, CELL_BORDERS - 1)
}

// `repeated` is a part laid out again in a later fragment, whose fragments say so.
effect fn placeChildren<'pass, 'source, M: Measure + TextMeasure, S: LayoutSource>(nodes: &BoxTree<'source, S>, output: &mut LayoutPass<'pass, 'source>, measurer: &mut M, id: usize, base: &Input, performLayout: bool, repeated: usize) ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let mut child = nodes.node(id).firstChild
  while child != NO_NODE {
    if inFlow(nodes, child) {
      let mut slot = Rect.zero()
      let mut plan: u64 = 0
      if child < output.tableSlots.length() {
        slot = output.tableSlots.get(child)
        plan = output.tablePlans.get(child)
      }
      // A part a fragment does not hold (see assignSlots).
      if slot.width >= 0.0 {
        let mut request = sized(base, slot.width, slot.height, true, performLayout, plan)
        if child < output.tableSplits.length() && output.tableSplits.get(child).active { request.fragmentation = output.tableSplits.get(child) }
        run layoutNodeInPlace(nodes, &mut output, &mut measurer, child, &request)
        run output.place(child, Point { x: slot.x, y: slot.y }, ResolvedEdges.zero(), false, performLayout)
        if child == repeated { markRepeated(&mut output, child) }
      }
    }
    child = nodes.node(child).nextSibling
  }
}

// A row group, row or column group, sized by its table: it places its children
// where the table put them.
pub effect fn layoutTablePart<'pass, 'source, M: Measure + TextMeasure, S: LayoutSource>(nodes: &BoxTree<'source, S>, output: &mut LayoutPass<'pass, 'source>, measurer: &mut M, id: usize, input: &Input, box: &ResolvedBox) -> Layout ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let mut result = Layout.zero()
  result.size = Size { width: box.size.width, height: box.size.height }
  if !box.size.widthDefinite { result.size.width = box.inset.horizontal() }
  if !box.size.heightDefinite { result.size.height = box.inset.vertical() }
  if !input.performLayout { return result }
  let mut base = childrenInput(input, nodes.style(id), box, OptionalSize.none())
  base.fragmentation.active = false
  run placeChildren(nodes, &mut output, &mut measurer, id, &base, true, NO_NODE)
  return result
}

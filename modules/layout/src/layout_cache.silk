const ABSENT: usize = usize.MAX
const REQUEST_NONE: u32 = u32.MAX
const REQUEST_OWN: u32 = 2147483648
const SLOT_MASK: u32 = 2147483647
// Reuse levels of a subtree's kept layout; see Incremental.markSubtrees.
pub const REUSE_NONE: u8 = 0
pub const REUSE_INDEPENDENT: u8 = 1
pub const REUSE_IN_FLOW: u8 = 2
pub const REUSE_LEVEL: u8 = 3
// A box's own share of the facts above, from its style and its parent's
// writing mode, plus whether it reads no viewport limits.
pub const FACT_FREE: u8 = 8
// An absolute box whose layout and place in its containing block read none
// of that block's size (see Incremental.insetAnchored).
pub const FACT_ANCHORED: u8 = 16

// A run of absolute siblings that positioning kept one by one (see
// Positioned.keepAnchored) and can keep at once while none of them is
// cleared: consecutive visits `firstVisit` on, boxes `first` to `last`,
// whose fragment ranges are adjacent in [start, end), the last one's
// starting at `lastStart`. `delta` is where their containing block's padding
// box started from its fragment, and left to bottom the union of their
// border boxes there. `clock` is the clear clock up to which no box of the
// run was cleared, `visits` the revision of the visits it indexes.
pub struct PositionedRun {
  pub cb: usize, pub firstVisit: usize, pub count: usize, pub first: usize, pub last: usize,
  pub start: usize, pub end: usize, pub lastStart: usize,
  pub delta: Point, pub left: f32, pub top: f32, pub right: f32, pub bottom: f32,
  pub clock: usize, pub visits: usize,
}
impl Copy for PositionedRun {}

// Per-box facts drawn from styles, kept across computes of the same boxes
// and refreshed only where a style changed; see Incremental.markSubtrees.
// visits: the boxes positioning must visit, in source preorder; see
// Positioned.positionVisits. styled: the boxes taking each tree node's
// style; see Incremental.indexStyleSources. parents: each box's parent.
// `marks[id] == mark` marks a box in the current remark (see
// Incremental.remarkSubtrees).
pub struct BoxFacts { pub own: List<u8>, pub reusable: List<u8>, pub viewportFree: List<bool>, pub keyShapes: List<u16>, pub itemFlags: List<u8>, pub visits: List<usize>, pub styledOffsets: List<usize>, pub styledBoxes: List<usize>, pub parents: List<usize>, pub marks: List<usize>, pub mark: usize, pub visitsRevision: usize,
  // The boxes whose overflow is auto on an axis, ascending, which are all that
  // selectScrollbars can give a scrollbar; of `scrollersFor` boxes. Made with
  // `visits`: a change of overflow generates boxes again.
  pub scrollers: List<usize>, pub scrollersFor: usize }
impl BoxFacts {
  pub effect fn census(self: &Self, out: &mut Census) ! OutOfMemoryError ? &mut Allocator {
    let u = Intrinsic.layoutOf<usize>().bytes
    run out.bytes("css.facts(per-box flags and indexes)",
      self.own.length() + self.reusable.length() + self.viewportFree.length() + self.keyShapes.length() * 2 + self.itemFlags.length()
        + (self.visits.length() + self.styledOffsets.length() + self.styledBoxes.length() + self.parents.length() + self.marks.length() + self.scrollers.length()) * u,
      self.own.capacity() + self.reusable.capacity() + self.viewportFree.capacity() + self.keyShapes.capacity() * 2 + self.itemFlags.capacity()
        + (self.visits.capacity() + self.styledOffsets.capacity() + self.styledBoxes.capacity() + self.parents.capacity() + self.marks.capacity() + self.scrollers.capacity()) * u)
    run out.unit("css.facts.positioning-visits", self.visits.length())
    run out.unit("css.facts.auto-scrollers", self.scrollers.length())
  }
  pub fn make() -> BoxFacts { return BoxFacts { own: List<u8>.make(), reusable: List<u8>.make(), viewportFree: List<bool>.make(), keyShapes: List<u16>.make(), itemFlags: List<u8>.make(), visits: List<usize>.make(), styledOffsets: List<usize>.make(), styledBoxes: List<usize>.make(), parents: List<usize>.make(), marks: List<usize>.make(), mark: 0, visitsRevision: 0, scrollers: List<usize>.make(), scrollersFor: usize.MAX } }
  pub fn covers(self: &Self, count: usize) -> bool {
    return self.own.length() == count && self.reusable.length() == count && self.viewportFree.length() == count && self.keyShapes.length() == count && self.itemFlags.length() == count && self.parents.length() == count
  }
}
// What placing a stored box and positioning write of its layout.
pub struct Placement { pub location: Point, pub usedMargin: ResolvedEdges, pub scrollableOverflow: Rect, pub hasClearance: bool, pub horizontalScrollbar: bool, pub verticalScrollbar: bool }
impl Copy for Placement {}
impl Placement {
  pub fn of(layout: &Layout) -> Placement {
    return Placement { location: layout.location, usedMargin: layout.usedMargin, scrollableOverflow: layout.scrollableOverflow, hasClearance: layout.hasClearance, horizontalScrollbar: layout.horizontalScrollbar, verticalScrollbar: layout.verticalScrollbar }
  }
  pub fn restore(self: &Self, layout: &mut Layout) {
    layout.location = self.location
    layout.usedMargin = self.usedMargin
    layout.scrollableOverflow = self.scrollableOverflow
    layout.hasClearance = self.hasClearance
    layout.horizontalScrollbar = self.horizontalScrollbar
    layout.verticalScrollbar = self.verticalScrollbar
  }
}
// Box layouts rewritten during a compute that keeps the previous compute's
// box layouts in place: `stamps[id] == generation` marks a box rewritten in
// this compute, whose previous layout is `saved[slots[id]]`, or, when
// `partial[id] == generation`, the box's layout with the placement
// `placed[slots[id]]`: a box only placed so far keeps the rest in place.
// In any compute,
// a box whose `written` entry is `generation` had its layout written, one
// whose `relaid` entry is had its subtree laid out again, and one whose
// `below` entry is has a descendant with either.
// What a compute did to a box, as the generation it last did each in.
// Generations and the slot are u32s: 24 bytes a box.
pub struct BoxMark { pub stamp: u32, pub slot: u32, pub partial: u32, pub written: u32, pub relaid: u32, pub below: u32 }
impl Copy for BoxMark {}
// The marks of a box sit together, so the checks a reuse makes of one box
// read one cache line.
pub struct BoxWrites { pub generation: u32, pub marks: List<BoxMark>, pub saved: LayoutStore, pub placed: List<Placement> }
impl BoxWrites {
  pub effect fn census(self: &Self, out: &mut Census) ! OutOfMemoryError ? &mut Allocator {
    run out.held("css.writes.marks", self.marks.length(), self.marks.capacity(), Intrinsic.layoutOf<BoxMark>().bytes)
    run out.bytes("css.writes.saved(Layout)", self.saved.usedBytes(), self.saved.storageBytes())
    run out.held("css.writes.placed", self.placed.length(), self.placed.capacity(), Intrinsic.layoutOf<Placement>().bytes)
  }
  pub fn make() -> BoxWrites { return BoxWrites { generation: 0, marks: List<BoxMark>.make(), saved: LayoutStore.make(), placed: List<Placement>.make() } }
  // Starts a compute over `count` boxes.
  pub effect fn begin(self: &mut Self, count: usize) ! OutOfMemoryError ? &mut Allocator {
    self.generation = self.generation + 1
    self.saved.clear()
    self.placed.clear()
    if self.marks.length() != count {
      self.marks.clear()
      run self.marks.appendRepeated(BoxMark { stamp: 0, slot: 0, partial: 0, written: 0, relaid: 0, below: 0 }, count)
    }
  }
  // Marks of box `id` set to this compute.
  @inlineAlways
  pub fn markBelow(self: &mut Self, id: usize) {
    let generation = self.generation
    let marks = self.marks.asMutSlice()
    marks[id].below = generation
  }
  @inlineAlways
  pub fn markRelaid(self: &mut Self, id: usize) {
    let generation = self.generation
    let marks = self.marks.asMutSlice()
    marks[id].relaid = generation
  }
  @inlineAlways
  pub fn markWritten(self: &mut Self, id: usize) {
    let generation = self.generation
    let marks = self.marks.asMutSlice()
    marks[id].written = generation
  }
  // Box `id` was saved whole, as the last of `saved`.
  @inlineAlways
  pub fn markSaved(self: &mut Self, id: usize) {
    let generation = self.generation
    let slot = usize.toU32(self.saved.length() - 1)
    let marks = self.marks.asMutSlice()
    marks[id].stamp = generation
    marks[id].partial = 0
    marks[id].slot = slot
  }
  // Box `id` was saved by placement, as the last of `placed`.
  @inlineAlways
  pub fn markPlaced(self: &mut Self, id: usize) {
    let generation = self.generation
    let slot = usize.toU32(self.placed.length() - 1)
    let marks = self.marks.asMutSlice()
    marks[id].stamp = generation
    marks[id].partial = generation
    marks[id].slot = slot
  }
}

pub enum CacheKind { IndependentBox, IntrinsicContents, ContainerAllocation }
pub struct CachedProbe { pub input: Input, pub layout: Layout }
impl Copy for CachedProbe {}
pub const AGES_NONE: u8 = 0
pub const AGES_RECENT: u8 = 1
pub const AGES_OLDER: u8 = 2
// `generation` is the last compute that created or hit the entry. Its
// request and layout are at the same index of `inputs` and `layouts`, which
// appendSlice fills straight from the caller's values: building one large
// entry first would copy both through the stack.
// `next` and `generation` are u32s (LINK_NONE for no next entry), so an entry
// is 12 bytes.
// `pinned` marks the entry whose request a final result shares (see
// FinalResult.request): it is neither overwritten nor dropped as stale.
struct Entry { kind: CacheKind, pinned: bool, next: u32, generation: u32 }
impl Copy for Entry {}

// The last full layout of a reusable box: its request, and the contiguous
// fragment range [start, end) it emitted, whose first fragment is the box's
// own. Ranges are kept per compute; results are written in place, since
// carrying a copied subtree forward only moves its ranges.
// The layout itself stays in the kept boxes. Only the fields that the
// box's placement and positioning write after it was stored are recorded
// (see Layout.withFinal).
// `beside` marks an in-flow box recorded beside its BFC's floats (see
// LayoutPass.recordFinal), the others independent formatting contexts.
// The request is where the box's recorded request is: REQUEST_NONE, a
// cache entry of the box whose request differs only in `flags` and the
// origin (most finals were probed under the same sizes first), or, with
// REQUEST_OWN, a slot of LayoutCache.finalInputs.
pub struct FinalResult {
  request: u32, flags: u32, originX: f32, originY: f32,
  pub location: Point, pub usedMargin: ResolvedEdges, pub scrollableOverflow: Rect,
  pub hasClearance: bool, pub horizontalScrollbar: bool, pub verticalScrollbar: bool,
  pub beside: bool,
}
impl Copy for FinalResult {}
impl FinalResult {
  fn none() -> FinalResult {
    return FinalResult { request: REQUEST_NONE, flags: 0, originX: 0.0, originY: 0.0, location: Point { x: 0.0, y: 0.0 }, usedMargin: ResolvedEdges.zero(), scrollableOverflow: Rect.zero(), hasClearance: false, horizontalScrollbar: false, verticalScrollbar: false, beside: false }
  }
  // The recorded layout, from the box's kept final layout.
  pub fn layout(self: &Self, kept: &Layout) -> Layout {
    let mut layout = kept.*
    layout.location = self.location
    layout.usedMargin = self.usedMargin
    layout.scrollableOverflow = self.scrollableOverflow
    layout.hasClearance = self.hasClearance
    layout.horizontalScrollbar = self.horizontalScrollbar
    layout.verticalScrollbar = self.verticalScrollbar
    return layout
  }
}
// `floats` and `floatCount` locate the float exclusions the box was laid out
// beside, relative to its content origin, in the cache's float list.
pub struct FinalRange { pub valid: bool, pub start: usize, pub end: usize, pub floats: usize, pub floatCount: usize }
impl Copy for FinalRange {}
impl FinalRange {
  pub fn none() -> FinalRange { return FinalRange { valid: false, start: 0, end: 0, floats: 0, floatCount: 0 } }
}

// A box's range of this compute and, once `stamp` is this compute, the
// previous compute's range it replaced.
// Both are kept as StoredRanges and the stamp as a u32 (STAMP_NONE for
// none), 36 bytes for the 88 of two FinalRanges and a usize.
struct BoxRanges { range: StoredRange, kept: StoredRange, stamp: u32 }
impl Copy for BoxRanges {}
impl BoxRanges {
  fn none() -> BoxRanges { return BoxRanges { range: NO_RANGE, kept: NO_RANGE, stamp: STAMP_NONE } }
}
// A FinalRange in u32s; the top bit of `floatCount` says it is valid.
struct StoredRange { start: u32, end: u32, floats: u32, floatCount: u32 }
impl Copy for StoredRange {}
const VALID_RANGE: u32 = 2147483648
const NO_RANGE: StoredRange = StoredRange { start: 0, end: 0, floats: 0, floatCount: 0 }
const STAMP_NONE: u32 = u32.MAX
impl StoredRange {
  @inlineAlways
  fn of(range: FinalRange) -> StoredRange {
    if !range.valid { return NO_RANGE }
    return StoredRange { start: usize.toU32(range.start), end: usize.toU32(range.end), floats: usize.toU32(range.floats), floatCount: usize.toU32(range.floatCount) | VALID_RANGE }
  }
  @inlineAlways
  fn valid(self: &Self) -> bool { return self.floatCount & VALID_RANGE != 0 }
  @inlineAlways
  fn load(self: &Self) -> FinalRange {
    if !self.valid() { return FinalRange.none() }
    return FinalRange { valid: true, start: u32.toUsize(self.start), end: u32.toUsize(self.end), floats: u32.toUsize(self.floats), floatCount: u32.toUsize(self.floatCount & (VALID_RANGE - 1)) }
  }
}
// An entry index as a `next` link, and back.
const LINK_NONE: u32 = u32.MAX
@inlineAlways
fn link(index: usize) -> u32 {
  if index == ABSENT { return LINK_NONE }
  return usize.toU32(index)
}
@inlineAlways
fn follow(next: u32) -> usize {
  if next == LINK_NONE { return ABSENT }
  return u32.toUsize(next)
}
// The cache's generation as a range stamp or entry generation.
@inlineAlways
fn stamp(generation: usize) -> u32 { return usize.toU32(generation) }

fn sameOptional(a: &OptionalSize, b: &OptionalSize) -> bool {
  return a.widthDefinite == b.widthDefinite && a.heightDefinite == b.heightDefinite && (!a.widthDefinite || a.width == b.width) && (!a.heightDefinite || a.height == b.height)
}
fn sameAvailable(a: &AvailableSpace, b: &AvailableSpace) -> bool {
  return a.kind == b.kind && (a.kind != AvailableKind.Definite || a.value == b.value)
}
@inlineAlways
fn bit(value: bool) -> u32 {
  if value { return 1 }
  return 0
}
@inlineAlways
fn sameInput(a: &Input, b: &Input) -> bool {
  // Mostly hits, which compare every field: no early exits, so the byte
  // flags compare together.
  let flags = bit((a.blockRoot != b.blockRoot)) | bit((a.blockify != b.blockify)) | bit((a.atomicInline != b.atomicInline)) | bit((a.intrinsicWidth != b.intrinsicWidth)) | bit((a.intrinsicHeight != b.intrinsicHeight)) | bit((a.shrinkToFit != b.shrinkToFit)) | bit((a.indefiniteWidth != b.indefiniteWidth)) | bit((a.indefiniteHeight != b.indefiniteHeight)) | bit((a.parentWritingMode != b.parentWritingMode)) | bit((a.parentTextOrientation != b.parentTextOrientation)) | bit((a.parentJustifyItems != b.parentJustifyItems)) | bit((a.parentJustifyItemsSafety != b.parentJustifyItemsSafety)) | bit((b.baselines && !a.baselines)) | bit((b.fullSize && !a.fullSize))
  let sizes = bit((a.gridContext != b.gridContext)) | bit((a.tablePlan != b.tablePlan)) | bit((a.minimum.width != b.minimum.width)) | bit((a.minimum.height != b.minimum.height)) | bit((a.parentMaxSize.width != b.parentMaxSize.width)) | bit((a.parentMaxSize.height != b.parentMaxSize.height)) | bit((a.scrollportSize.width != b.scrollportSize.width)) | bit((a.scrollportSize.height != b.scrollportSize.height))
  if (flags | sizes) != 0 { return false }
  return sameAvailable(&a.availableWidth, &b.availableWidth) && sameAvailable(&a.availableHeight, &b.availableHeight) && sameOptional(&a.known, &b.known) && sameOptional(&a.parent, &b.parent) && sameOptional(&a.initialContainingBlock, &b.initialContainingBlock)
}
// sameInput of a stored request and `input`, packed as `packed`.
@inlineAlways
fn sameAgainst(stored: &StoredInput, rares: &RarePool, input: &Input, packed: &StoredInput) -> bool {
  return sameStored(stored, rares.gridContext(stored.rare), rares.tablePlan(stored.rare), packed, input.gridContext, input.tablePlan)
}
// Whether `sized`, a width-intrinsic probe's request whose result came out
// `width` wide, answers `input`, the same request with that width known (see
// Measure): every field but how the width was chosen matches. The intrinsic
// probe ignored the minimum width, so the known width must satisfy it.
fn sameInputAtWidth(sized: &Input, input: &Input, width: f32) -> bool {
  if !sized.intrinsicWidth || sized.known.widthDefinite || input.intrinsicWidth || !input.known.widthDefinite || input.known.width != width || input.minimum.width > width { return false }
  if sized.gridContext != input.gridContext || sized.tablePlan != input.tablePlan || !sameAvailable(&sized.availableHeight, &input.availableHeight) || sized.known.heightDefinite != input.known.heightDefinite || (input.known.heightDefinite && sized.known.height != input.known.height) { return false }
  if sized.minimum.height != input.minimum.height || sized.parentMaxSize.width != input.parentMaxSize.width || sized.parentMaxSize.height != input.parentMaxSize.height || sized.scrollportSize.width != input.scrollportSize.width || sized.scrollportSize.height != input.scrollportSize.height { return false }
  return sameOptional(&sized.parent, &input.parent) && sameOptional(&sized.initialContainingBlock, &input.initialContainingBlock) && sized.blockRoot == input.blockRoot && sized.blockify == input.blockify && sized.atomicInline == input.atomicInline && sized.intrinsicHeight == input.intrinsicHeight && sized.shrinkToFit == input.shrinkToFit && sized.indefiniteHeight == input.indefiniteHeight && sized.parentWritingMode == input.parentWritingMode && sized.parentTextOrientation == input.parentTextOrientation && sized.parentJustifyItems == input.parentJustifyItems && sized.parentJustifyItemsSafety == input.parentJustifyItemsSafety && (sized.baselines || !input.baselines)
}

// Size-only results of independent formatting contexts, keyed by generated
// box and the exact Input that produced them. Full layout always visits
// descendants; shared BFC participants never bypass their exclusion and
// clearance side effects. LayoutTree keeps the cache between computes, and
// compute clears the boxes whose sources changed, their subtrees and their
// ancestors, because an ancestor's size can depend on any descendant.
fn shiftedRange(range: FinalRange, shift: Shift) -> FinalRange {
  if !range.valid || range.end <= shift.start { return range }
  let mut result = range
  result.start = shift.apply(range.start)
  result.end = shift.apply(range.end)
  return result
}

// What a block's last final pass gave and placed its in-flow children by:
// their shared request, the available inline size, the block's logical
// inset and inline size, and its direction. A child's request, resolved
// margins, width and inline offset follow from these and its own style, so
// when they stand a child whose final range was kept since has them as
// before.
pub struct BlockBase { pub base: StoredInput, pub available: AvailableSpace, pub inset: ResolvedEdges, pub width: f32, pub rtl: bool, pub valid: bool }
impl Copy for BlockBase {}
// How a block's children's shared request compares with its last final
// pass's (see noteBlockBase).
pub const BASE_CHANGED: u8 = 0
// Only in what the block's own block size sets, which a child reads only
// through percentages of it or the viewport limits (see normalizeKey).
pub const BASE_BLOCK_SIZE: u8 = 1
pub const BASE_SAME: u8 = 2
// Not compared yet.
pub const BASE_UNKNOWN: u8 = 3

// A block's children's shared request, but for the available space each
// child gets its own of (see prepareChildInto).
fn childRequest(base: &Input) -> Input {
  let mut result = base.*
  result.availableWidth = AvailableSpace.maxContent()
  result.availableHeight = AvailableSpace.maxContent()
  return result
}
// The parts of a children's request the block's own block size sets.
fn withoutBlockSize(input: &Input) -> Input {
  let mut result = input.*
  if result.parentWritingMode == WritingMode.HorizontalTb {
    result.parent.height = 0.0
    result.parent.heightDefinite = false
    result.parentMaxSize.height = 0.0
    result.scrollportSize.height = 0.0
  } else {
    result.parent.width = 0.0
    result.parent.widthDefinite = false
    result.parentMaxSize.width = 0.0
    result.scrollportSize.width = 0.0
  }
  return result
}
// What a compute asked of the size-probe cache, for a benchmark (see
// LayoutCache.census). `byWidth` counts the probes computed by how the
// request constrained the box's width: known, max-content, min-content, or
// definite available space; `byHeight` likewise. `perBox` counts the boxes
// with 0, 1, 2, 3 and 4 or more computed probes, `askedPerBox` those the
// cache was asked about that often (0, 1, 2, 3 to 4, 5 to 8, more).
// `repeated` counts computed probes whose request another computed probe of
// the same box already had.
pub struct ProbeCensus {
  pub asked: usize, pub computed: usize, pub repeated: usize,
  // Probes whose size an earlier probe of the box already gave, and those by
  // the width class of the earlier probe (rows) and of the later one.
  pub sameAnswer: usize, pub sameAnswerBy: [usize; 16],
  pub mostAsked: usize, pub mostComputed: usize,
  pub byWidth: [usize; 4], pub byHeight: [usize; 4], pub perBox: [usize; 5], pub askedPerBox: [usize; 6],
}
impl Copy for ProbeCensus {}
fn constraintClass(known: bool, available: &AvailableSpace) -> usize {
  if known { return 0 }
  if available.kind == AvailableKind.MaxContent { return 1 }
  if available.kind == AvailableKind.MinContent { return 2 }
  return 3
}
pub struct LayoutCache {
  // Lookups per box, counted when `counting` (see census).
  pub counting: bool, asked: List<u32>,
  heads: List<usize>,
  entries: List<Entry>, inputs: List<StoredInput>, layouts: LayoutStore,
  // The rare parts of the stored requests of entries, results and block
  // bases (see StoredInput).
  entryRares: RarePool, resultRares: RarePool, baseRares: RarePool,
  // Recorded final requests no cache entry shares (REQUEST_OWN), and the
  // first free one, the free ones chained through their flags.
  finalInputs: List<StoredInput>, freeFinal: u32,
  // The storage compact last moved entries out of, kept so that neither list
  // grows again in a steady state.
  spare: List<Entry>, spareInputs: List<StoredInput>, spareLayouts: LayoutStore,
  // Entries no longer reachable from a head; compacted when they dominate.
  dead: usize,
  // The current compute, and how many entries the previous one used.
  generation: usize, touched: usize, previouslyTouched: usize,
  // Whether the current compute began with nothing cached or recorded, as
  // after clear: none of its lookups can hit.
  pub emptyAtStart: bool,
  // Final layout ranges, written in place: each box's range of this compute
  // once it is laid out, copied or kept, and of the previous one, whose
  // fragments are in the LayoutTree's snapshot or kept in place, until then.
  // A box laid out again loses its range until it records one. The first
  // write in a compute saves the previous range, stamped with `generation`,
  // as the kept range keptRange reads; it is dropped once this compute
  // records the box, which replaces the result.
  results: List<FinalResult>,
  ranges: List<BoxRanges>,
  // The runs the last positioning kept or found, in visit order, and the
  // list the next one fills.
  pub runs: List<PositionedRun>, pub spareRuns: List<PositionedRun>,
  // When each box's results were last cleared, by `clock`, which counts
  // clears; `clearedAll` when all were (see clearedAt).
  cleared: List<usize>, clock: usize, clearedAll: usize,
  // The last boxes cleared and the clocks they were cleared at, a ring of
  // CLEAR_LOG: it holds every clear after `clearLogFrom` (see clearedSince).
  clearLog: [usize; 16], clearLogClocks: [usize; 16], clearLogCount: usize, clearLogNext: usize, clearLogFrom: usize,
  // What undoRotate needs: the touched count before the last rotation,
  // whether it compacted floats, and how many ranges this compute stamped
  // and has not adopted (see adoptRange).
  rotatedTouched: usize, rotatedFloats: bool, stamped: usize,
  // Whether this compute records no ranges or results (see skipFinals), and
  // whether the ranges were reset since one last did.
  skipping: bool, rangesReset: bool,
  // Float lists of ranges, appended to; `floatsCompacted` is the length
  // after the last compaction.
  floats: List<FloatBox>, floatsCompacted: usize,
  // Each box's prepared paragraph from the compute that last laid it out.
  texts: List<List<KeptText>>,
  // Flex items as prepared before; see FlexMemos.
  pub flexMemos: FlexMemos,
  // Final content-relative tracks and names survive reuse without sizing scratch.
  pub gridGeometry: GridGeometryStore,
  pub gridMemos: GridMemos,
  // Immutable inherited-axis descriptors outlive every retained Input.
  pub subgrids: SubgridPool,
  // Each block's BlockBase slot, or ABSENT; see noteBlockBase.
  blockSlots: List<usize>, blockBases: List<BlockBase>,
  // Each box's plain content width (see engine.plainWidth), PLAIN_UNKNOWN
  // until asked for, or PLAIN_NEVER; dropped where the box's entries are.
  pub plainWidths: List<f32>,
  // Each inline formatting box's PlainLine slot, or ABSENT.
  plainSlots: List<usize>, plainLines: List<PlainLine>,
  // The stamp of the last compute that kept paragraphs.
  textStamp: usize,
}
pub const PLAIN_UNKNOWN: f32 = -1.0
pub const PLAIN_NEVER: f32 = -2.0
const CLEAR_LOG: usize = 16

impl LayoutCache {
  // What the cache holds, for the bench census.
  pub effect fn heldCensus(self: &Self, out: &mut Census) ! OutOfMemoryError ? &mut Allocator {
    let u = Intrinsic.layoutOf<usize>().bytes
    let input = Intrinsic.layoutOf<StoredInput>().bytes
    run out.held("css.cache.heads", self.heads.length(), self.heads.capacity(), u)
    run out.held("css.cache.entries", self.entries.length(), self.entries.capacity(), Intrinsic.layoutOf<Entry>().bytes)
    run out.held("css.cache.inputs", self.inputs.length(), self.inputs.capacity(), input)
    run out.bytes("css.cache.rare-inputs", self.entryRares.storageBytes() + self.resultRares.storageBytes() + self.baseRares.storageBytes(), self.entryRares.storageBytes() + self.resultRares.storageBytes() + self.baseRares.storageBytes())
    run out.held("css.cache.final-inputs", self.finalInputs.length(), self.finalInputs.capacity(), input)
    run out.bytes("css.cache.layouts", self.layouts.usedBytes(), self.layouts.storageBytes())
    run out.unit("css.cache.dead-entries", self.dead)
    run out.held("css.cache.spare-entries", self.spare.length(), self.spare.capacity(), Intrinsic.layoutOf<Entry>().bytes)
    run out.held("css.cache.spare-inputs", self.spareInputs.length(), self.spareInputs.capacity(), input)
    run out.bytes("css.cache.spare-layouts", self.spareLayouts.usedBytes(), self.spareLayouts.storageBytes())
    run out.held("css.cache.final-results", self.results.length(), self.results.capacity(), Intrinsic.layoutOf<FinalResult>().bytes)
    run out.held("css.cache.final-ranges", self.ranges.length(), self.ranges.capacity(), Intrinsic.layoutOf<BoxRanges>().bytes)
    let mut valid: usize = 0
    let mut at: usize = 0
    while at < self.ranges.length() {
      if self.ranges.asSlice()[at].range.valid() { valid = valid + 1 }
      at = at + 1
    }
    run out.unit("css.cache.final-ranges.valid", valid)
    run out.held("css.cache.positioned-runs", self.runs.length() + self.spareRuns.length(), self.runs.capacity() + self.spareRuns.capacity(), Intrinsic.layoutOf<PositionedRun>().bytes)
    run out.held("css.cache.cleared", self.cleared.length(), self.cleared.capacity(), u)
    run out.held("css.cache.floats", self.floats.length(), self.floats.capacity(), Intrinsic.layoutOf<FloatBox>().bytes)
    run out.held("css.cache.block-slots", self.blockSlots.length(), self.blockSlots.capacity(), u)
    run out.held("css.cache.block-bases", self.blockBases.length(), self.blockBases.capacity(), Intrinsic.layoutOf<BlockBase>().bytes)
    run out.held("css.cache.plain-widths", self.plainWidths.length(), self.plainWidths.capacity(), 4)
    run out.held("css.cache.plain-slots", self.plainSlots.length(), self.plainSlots.capacity(), u)
    run out.held("css.cache.plain-lines", self.plainLines.length(), self.plainLines.capacity(), Intrinsic.layoutOf<PlainLine>().bytes)
    let mut plainUsed: usize = 0
    let mut plainRoom: usize = 0
    at = 0
    while at < self.plainLines.length() {
      let line = &self.plainLines.asSlice()[at]
      plainUsed = plainUsed + line.items.length() * Intrinsic.layoutOf<Item>().bytes + line.texts.length() * Intrinsic.layoutOf<TextLeaf>().bytes
      plainRoom = plainRoom + line.items.capacity() * Intrinsic.layoutOf<Item>().bytes + line.texts.capacity() * Intrinsic.layoutOf<TextLeaf>().bytes
      at = at + 1
    }
    run out.bytes("css.cache.plain-lines.heap", plainUsed, plainRoom)
    // Prepared paragraphs kept between computes.
    run out.held("css.cache.texts(per-box list header)", self.texts.length(), self.texts.capacity(), Intrinsic.layoutOf<List<KeptText>>().bytes)
    let mut kept: usize = 0
    let mut keptRoom: usize = 0
    let mut stale: usize = 0
    let mut coreUsed: usize = 0
    let mut coreRoom: usize = 0
    let mut fittedLines: usize = 0
    let mut memoItems: usize = 0
    let mut offered: usize = 0
    at = 0
    while at < self.texts.length() {
      let held = self.texts.asSlice()[at].asSlice()
      keptRoom = keptRoom + self.texts.asSlice()[at].capacity()
      let mut k: usize = 0
      while k < held.length {
        kept = kept + 1
        if held[k].stale { stale = stale + 1 }
        let core = held[k].core.get()
        let memo = &core[0].memo
        let item = Intrinsic.layoutOf<Item>().bytes
        let leaf = Intrinsic.layoutOf<TextLeaf>().bytes
        coreUsed = coreUsed + core[0].offered.length() * Intrinsic.layoutOf<TextBreak>().bytes + core[0].barriers.length() + core[0].origins.length() * u
          + core[0].analysis.levels.length() * Intrinsic.layoutOf<TextLevel>().bytes + core[0].analysis.paragraphs.length() * Intrinsic.layoutOf<TextParagraph>().bytes
          + memo.items.length() * item + memo.scopes.length() * Intrinsic.layoutOf<Scope>().bytes + memo.prefix.length() * 4
          + memo.widths.length() * 4 + (memo.counts.length() + memo.ends.length() + memo.heads.length()) * u
          + memo.fonts.length() * Intrinsic.layoutOf<TextFont>().bytes + memo.segments.length() * Intrinsic.layoutOf<Segment>().bytes
          + memo.fitted.lines.length() * Intrinsic.layoutOf<LineBox>().bytes + memo.fitted.items.length() * item + memo.fitted.texts.length() * leaf
        coreRoom = coreRoom + core[0].offered.capacity() * Intrinsic.layoutOf<TextBreak>().bytes + core[0].barriers.capacity() + core[0].origins.capacity() * u
          + core[0].analysis.levels.capacity() * Intrinsic.layoutOf<TextLevel>().bytes + core[0].analysis.paragraphs.capacity() * Intrinsic.layoutOf<TextParagraph>().bytes
          + memo.items.capacity() * item + memo.scopes.capacity() * Intrinsic.layoutOf<Scope>().bytes + memo.prefix.capacity() * 4
          + memo.widths.capacity() * 4 + (memo.counts.capacity() + memo.ends.capacity() + memo.heads.capacity()) * u
          + memo.fonts.capacity() * Intrinsic.layoutOf<TextFont>().bytes + memo.segments.capacity() * Intrinsic.layoutOf<Segment>().bytes
          + memo.fitted.lines.capacity() * Intrinsic.layoutOf<LineBox>().bytes + memo.fitted.items.capacity() * item + memo.fitted.texts.capacity() * leaf
        fittedLines = fittedLines + memo.fitted.lines.length()
        memoItems = memoItems + memo.items.length()
        offered = offered + core[0].offered.length()
        k = k + 1
      }
      at = at + 1
    }
    run out.held("css.cache.kept-paragraphs(KeptText)", kept, keptRoom, Intrinsic.layoutOf<KeptText>().bytes)
    run out.held("css.cache.kept-paragraphs.core(PreparedCore)", kept, kept, Intrinsic.layoutOf<PreparedCore>().bytes)
    run out.bytes("css.cache.kept-paragraphs.core-heap", coreUsed, coreRoom)
    run out.unit("css.cache.kept-paragraphs.stale", stale)
    run out.unit("css.cache.kept-paragraphs.fitted-lines", fittedLines)
    run out.unit("css.cache.kept-paragraphs.memo-items", memoItems)
    run out.unit("css.cache.kept-paragraphs.offered-breaks", offered)
    run self.flexMemos.census(&mut out)
    run self.gridGeometry.census(&mut out)
    run self.gridMemos.census(&mut out)
    run self.subgrids.census(&mut out)
  }
  pub fn make() -> LayoutCache {
    return LayoutCache { textStamp: 0, counting: false, asked: List<u32>.make(), heads: List<usize>.make(), entries: List<Entry>.make(), inputs: List<StoredInput>.make(), layouts: LayoutStore.make(), entryRares: RarePool.make(), resultRares: RarePool.make(), baseRares: RarePool.make(), finalInputs: List<StoredInput>.make(), freeFinal: REQUEST_NONE, spare: List<Entry>.make(), spareInputs: List<StoredInput>.make(), spareLayouts: LayoutStore.make(), dead: 0, emptyAtStart: true, generation: 0, touched: 0, previouslyTouched: 0, results: List<FinalResult>.make(), ranges: List<BoxRanges>.make(), cleared: List<usize>.make(), clock: 0, clearedAll: 0, clearLog: [0; 16], clearLogClocks: [0; 16], clearLogCount: 0, clearLogNext: 0, clearLogFrom: 0, runs: List<PositionedRun>.make(), spareRuns: List<PositionedRun>.make(), rotatedTouched: 0, rotatedFloats: false, stamped: 0, skipping: false, rangesReset: false, floats: List<FloatBox>.make(), floatsCompacted: 0, texts: List<List<KeptText>>.make(), flexMemos: FlexMemos.make(), gridGeometry: GridGeometryStore.make(), gridMemos: GridMemos.make(), subgrids: SubgridPool.make(), blockSlots: List<usize>.make(), blockBases: List<BlockBase>.make(), plainWidths: List<f32>.make(), plainSlots: List<usize>.make(), plainLines: List<PlainLine>.make() }
  }
  pub fn length(self: &Self) -> usize { return self.entries.length() - self.dead }
  pub fn clear(self: &mut Self) {
    self.clearMeasured()
    self.gridMemos.clear()
  }
  // clear, but grids keep their placement for a compute of the same boxes
  // (see GridMemos.keepPlacement).
  pub fn clearMeasured(self: &mut Self) {
    self.clock = self.clock + 1
    self.clearedAll = self.clock
    self.forgetClears()
    self.runs.clear()
    self.flexMemos.clear()
    self.gridGeometry.clear()
    self.gridMemos.keepPlacement()
    self.subgrids.clear()
    self.heads.clear()
    self.entries.clear()
    self.inputs.clear()
    self.entryRares.clear()
    // No result can share a cleared entry.
    self.forgetRequests()
    self.layouts.clear()
    self.dead = 0
    self.touched = 0
    // Results stay allocated and written: one is read only through a valid
    // range, and ranges are cleared, so reserveBoxes need not refill them.
    self.ranges.clear()
    self.rotatedFloats = true
    self.floats.clear()
    self.floatsCompacted = 0
    self.texts.clear()
    self.emptyAtStart = true
    self.blockSlots.clear()
    self.blockBases.clear()
    self.baseRares.clear()
    self.plainWidths.clear()
    self.plainSlots.clear()
    self.plainLines.clear()
  }
  // Starts a compute: the previous compute's final layouts become reusable.
  pub effect fn rotateFinals(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    self.emptyAtStart = self.entries.length() == 0 && self.ranges.length() == 0
    self.flexMemos.rotate()
    self.gridGeometry.commit()
    if self.subgrids.beginCollection() {
      let mut at: usize = 0
      while at < self.inputs.length() {
        self.subgrids.mark(self.entryRares.gridContext(self.inputs.asSlice()[at].rare))
        at = at + 1
      }
      at = 0
      while at < self.ranges.length() {
        let ranges = &self.ranges.asSlice()[at]
        if ranges.range.valid() || ranges.kept.valid() {
          let grid = self.requestGrid(at)
          self.subgrids.mark(grid)
        }
        at = at + 1
      }
      self.gridMemos.markContexts(&mut self.subgrids)
      self.gridGeometry.markContexts(&mut self.subgrids)
      self.subgrids.finishCollection()
    }
    self.generation = self.generation + 1
    self.rotatedTouched = self.previouslyTouched
    self.previouslyTouched = self.touched
    self.touched = 0
    self.stamped = 0
    self.rotatedFloats = self.floats.length() > 1024 && self.floats.length() > 4 * self.floatsCompacted
    if self.rotatedFloats { run self.compactFloats() }
  }
  // Takes back the last rotateFinals when this compute changed nothing but
  // what it adopted (see adoptRange): the previous compute stays the last
  // one, its ranges kept as they were. Returns whether it could.
  pub fn undoRotate(self: &mut Self) -> bool {
    if self.stamped != 0 || self.rotatedFloats || self.generation == 0 { return false }
    self.generation = self.generation - 1
    self.touched = self.previouslyTouched + self.touched
    self.previouslyTouched = self.rotatedTouched
    return true
  }
  // Rebuilds the float list with only the lists of valid ranges.
  effect fn compactFloats(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    let mut floats = List<FloatBox>.make()
    let ranges = self.ranges.asMutSlice()
    let mut id: usize = 0
    while id < ranges.length {
      let range = ranges[id].range.load()
      if range.valid && range.floatCount != 0 {
        let first = floats.length()
        run floats.appendSlice(Slice.view(self.floats.asSlice(), range.floats, range.floatCount))
        ranges[id].range.floats = usize.toU32(first)
      }
      id = id + 1
    }
    self.floats = move floats
    self.floatsCompacted = self.floats.length()
  }
  // The previous compute's range for a box and the result it holds.
  pub fn keptRange(self: &Self, id: usize) -> FinalRange {
    if id >= self.ranges.length() { return FinalRange.none() }
    let ranges = &self.ranges.asSlice()[id]
    if ranges.stamp == stamp(self.generation) { return ranges.kept.load() }
    return ranges.range.load()
  }
  pub fn result(self: &Self, id: usize) -> &FinalResult { return &self.results.asSlice()[id] }
  // Saves a box's previous range before its first write in this compute.
  @inlineAlways
  effect fn writeRange(self: &mut Self, id: usize, range: FinalRange) ! OutOfMemoryError ? &mut Allocator {
    if id >= self.ranges.length() { run self.growRanges(id) }
    let generation = stamp(self.generation)
    let ranges = self.ranges.asMutSlice()
    if ranges[id].stamp != generation {
      ranges[id].kept = ranges[id].range
      ranges[id].stamp = generation
      self.stamped = self.stamped + 1
    }
    ranges[id].range = StoredRange.of(range)
  }
  effect fn growRanges(self: &mut Self, id: usize) ! OutOfMemoryError ? &mut Allocator {
    let missing = id + 1 - self.ranges.length()
    run self.ranges.appendRepeated(BoxRanges.none(), missing)
  }
  // Sizes the per-box records for a compute of `count` boxes up front, so a
  // fresh compute does not grow them a box at a time. A box added here has
  // no range, of this compute or a previous one.
  pub effect fn reserveBoxes(self: &mut Self, count: usize) ! OutOfMemoryError ? &mut Allocator {
    if self.counting {
      self.asked.clear()
      run self.asked.appendRepeated(0, count)
    }
    let results = self.results.length()
    if results < count { run self.results.appendRepeated(FinalResult.none(), count - results) }
    // A box the list did not reach may have been cleared unrecorded.
    let cleared = self.cleared.length()
    let clock = self.clock
    if cleared < count {
      run self.cleared.appendRepeated(clock, count - cleared)
      self.forgetClears()
    }
    if self.ranges.length() < count {
      let length = self.ranges.length()
      let added = count - length
      let fresh = BoxRanges { range: NO_RANGE, kept: NO_RANGE, stamp: stamp(self.generation) }
      run self.ranges.appendRepeated(fresh, added)
      self.stamped = self.stamped + added
    }
  }
  // Makes this compute record no ranges or results, which only a later
  // compute could reuse, when `skip`; the previous ones' are dropped, so no
  // later compute reads a range this one overwrote. Call it before
  // reserveBoxes.
  pub fn skipFinals(self: &mut Self, skip: bool) {
    self.skipping = skip
    if !skip {
      self.rangesReset = false
      return
    }
    if self.rangesReset { return }
    self.ranges.clear()
    self.rangesReset = true
  }
  @inlineAlways
  pub fn recording(self: &Self) -> bool { return !self.skipping }
  // A box is being laid out again: it has no range of this compute until it
  // records one.
  pub effect fn beginLayout(self: &mut Self, id: usize) ! OutOfMemoryError ? &mut Allocator {
    if self.skipping || id >= self.ranges.length() { return }
    let ranges = &self.ranges.asSlice()[id]
    if ranges.stamp == stamp(self.generation) && !ranges.range.valid() { return }
    run self.writeRange(id, FinalRange.none())
  }
  // A box of a subtree kept in place has its previous range again.
  pub fn keepRange(self: &mut Self, id: usize) {
    if id >= self.ranges.length() { return }
    let generation = stamp(self.generation)
    let ranges = self.ranges.asMutSlice()
    if ranges[id].stamp == generation { ranges[id].range = ranges[id].kept }
  }
  // Moves the previous compute's ranges along with its fragments (see
  // FragmentArena.shiftPrevious); a range across the shift's start grows or
  // shrinks with it.
  pub fn shiftRanges(self: &mut Self, shift: Shift) {
    let generation = stamp(self.generation)
    let ranges = self.ranges.asMutSlice()
    let mut id: usize = 0
    while id < ranges.length {
      if ranges[id].stamp == generation { ranges[id].kept = StoredRange.of(shiftedRange(ranges[id].kept.load(), shift)) }
      else { ranges[id].range = StoredRange.of(shiftedRange(ranges[id].range.load(), shift)) }
      id = id + 1
    }
  }
  pub effect fn recordFinal(self: &mut Self, id: usize, input: &Input, layout: &Layout, start: usize, end: usize, floats: &[FloatBox], beside: bool) ! OutOfMemoryError ? &mut Allocator {
    if self.skipping { return }
    if floats.length != 0 || id >= self.results.length() || id >= self.ranges.length() {
      run self.recordFinalGrowing(id, input, layout, start, end, floats, beside)
      return
    }
    // writeRange of a range without floats, in lists sized for the box.
    let generation = stamp(self.generation)
    let ranges = self.ranges.asMutSlice()
    if ranges[id].stamp != generation {
      ranges[id].stamp = generation
      self.stamped = self.stamped + 1
    }
    ranges[id].range = StoredRange { start: usize.toU32(start), end: usize.toU32(end), floats: usize.toU32(self.floats.length()), floatCount: VALID_RANGE }
    ranges[id].kept = NO_RANGE
    run self.writeResult(id, input, layout, beside)
  }
  effect fn recordFinalGrowing(self: &mut Self, id: usize, input: &Input, layout: &Layout, start: usize, end: usize, floats: &[FloatBox], beside: bool) ! OutOfMemoryError ? &mut Allocator {
    if id >= self.results.length() {
      let missing = id + 1 - self.results.length()
      run self.results.reserve(missing)
      while self.results.length() <= id { run self.results.append(FinalResult.none()) }
    }
    let first = self.floats.length()
    if floats.length != 0 { run self.floats.appendSlice(floats) }
    run self.writeRange(id, FinalRange { valid: true, start: start, end: end, floats: first, floatCount: floats.length })
    let ranges = self.ranges.asMutSlice()
    ranges[id].kept = NO_RANGE
    run self.writeResult(id, input, layout, beside)
  }
  @inlineAlways
  effect fn writeResult(self: &mut Self, id: usize, input: &Input, layout: &Layout, beside: bool) ! OutOfMemoryError ? &mut Allocator {
    run self.keepRequest(id, input)
    let results = self.results.asMutSlice()
    results[id].location = layout.location
    results[id].usedMargin = layout.usedMargin
    results[id].scrollableOverflow = layout.scrollableOverflow
    results[id].hasClearance = layout.hasClearance
    results[id].horizontalScrollbar = layout.horizontalScrollbar
    results[id].verticalScrollbar = layout.verticalScrollbar
    results[id].beside = beside
  }
  // Moves a kept range, unchanged in content, to where a copy put it.
  @inlineAlways
  pub effect fn carryFinal(self: &mut Self, id: usize, kept: FinalRange, start: usize, end: usize) ! OutOfMemoryError ? &mut Allocator {
    run self.writeRange(id, FinalRange { valid: true, start: start, end: end, floats: kept.floats, floatCount: kept.floatCount })
  }
  // Whether a kept range was laid out beside these floats.
  pub fn sameFloats(self: &Self, kept: FinalRange, floats: &[FloatBox]) -> bool {
    if kept.floatCount != floats.length { return false }
    let recorded = self.floats.asSlice()
    let mut index: usize = 0
    while index < floats.length {
      let a = &recorded[kept.floats + index]
      let b = &floats[index]
      if a.side != b.side || a.left != b.left || a.right != b.right || a.top != b.top || a.bottom != b.bottom || a.shape != b.shape { return false }
      index = index + 1
    }
    return true
  }
  pub fn clearBox(self: &mut Self, id: usize) {
    self.gridMemos.dropBox(id)
    self.clearResults(id)
  }
  // Forgets every result of the boxes `ids` held, as remap does of boxes
  // with no match: a patch of the box tree (box_patch.silk) gave those ids
  // to other boxes or to none.
  pub effect fn forgetBoxes(self: &mut Self, ids: &[usize]) ! OutOfMemoryError ? &mut Allocator {
    if ids.length != 0 { self.subgrids.resetOwners() }
    let mut at: usize = 0
    while at < ids.length {
      let id = ids[at]
      self.clearBox(id)
      if id < self.results.length() {
        self.releaseRequest(id)
        let results = self.results.asMutSlice()
        results[id] = FinalResult.none()
      }
      if id < self.blockSlots.length() && self.blockSlots.get(id) != ABSENT {
        let bases = self.blockBases.asMutSlice()
        bases[self.blockSlots.get(id)].valid = false
      }
      at = at + 1
    }
    self.rotatedFloats = true
  }
  // clearBox for a grid whose items and their styles stand, only something
  // inside them changed: its placement memo stays (see GridMemos).
  pub fn clearPlaced(self: &mut Self, id: usize) { self.clearResults(id) }
  fn clearResults(self: &mut Self, id: usize) {
    // Its entries go below, unlinked but in place: a result that shares one
    // still reads it, until compact gives that result a slot of its own.
    self.clock = self.clock + 1
    if id < self.cleared.length() { self.cleared.set(id, self.clock) }
    // A full ring drops its oldest clear, after which it holds every one.
    let at = self.clearLogNext
    if self.clearLogCount == CLEAR_LOG { self.clearLogFrom = self.clearLogClocks[at] }
    else { self.clearLogCount = self.clearLogCount + 1 }
    self.clearLog[at] = id
    self.clearLogClocks[at] = self.clock
    self.clearLogNext = (at + 1) % CLEAR_LOG
    self.flexMemos.dropBox(id)
    self.gridGeometry.dropBox(id)
    if id < self.plainWidths.length() { self.plainWidths.set(id, PLAIN_UNKNOWN) }
    if id < self.plainSlots.length() && self.plainSlots.get(id) != ABSENT {
      let lines = self.plainLines.asMutSlice()
      lines[self.plainSlots.get(id)].valid = false
    }
    // The paragraph is prepared again, into the lists the old one leaves.
    if id < self.texts.length() && self.texts.asSlice()[id].length() != 0 {
      let kept = self.texts.asMutSlice()[id].asMutSlice()
      kept[0].stale = true
    }
    if id < self.ranges.length() {
      let ranges = self.ranges.asMutSlice()
      ranges[id].range = NO_RANGE
      ranges[id].kept = NO_RANGE
    }
    if id >= self.heads.length() { return }
    let mut index = self.heads.get(id)
    while index != ABSENT {
      self.dead = self.dead + 1
      index = follow(self.entries.get(index).next)
    }
    self.heads.set(id, ABSENT)
  }
  pub fn sameRequest(a: &Input, b: &Input) -> bool { return sameInput(a, b) }
  // Whether box `id`'s recorded final request is `input` (see sameInput).
  pub fn sameResultRequest(self: &Self, id: usize, input: &Input) -> bool {
    let stored = self.resultStored(id)
    return sameAgainst(&stored, &self.resultRares, input, &StoredInput.pack(input, RARE_NONE))
  }
  // Box `id`'s recorded final request.
  pub fn resultInput(self: &Self, id: usize) -> Input { return self.resultRares.unpack(&self.resultStored(id)) }
  // Box `id`'s recorded request, stored; its rare parts are in resultRares.
  fn resultStored(self: &Self, id: usize) -> StoredInput {
    let result = &self.results.asSlice()[id]
    let request = result.request
    if request == REQUEST_NONE { return StoredInput.pack(&Input.make(OptionalSize.definite(0.0, 0.0)), RARE_NONE) }
    if request & REQUEST_OWN != 0 { return self.finalInputs.asSlice()[u32.toUsize(request & SLOT_MASK)] }
    return self.inputs.asSlice()[u32.toUsize(request)].withOwn(result.flags, result.originX, result.originY)
  }
  fn requestGrid(self: &Self, id: usize) -> usize {
    let request = self.results.asSlice()[id].request
    if request == REQUEST_NONE || request & REQUEST_OWN == 0 { return 0 }
    return self.resultRares.gridContext(self.finalInputs.asSlice()[u32.toUsize(request & SLOT_MASK)].rare)
  }
  // Records `input` as box `id`'s request: shared with a cache entry of the
  // box when one has its sizes, else in a slot of its own.
  effect fn keepRequest(self: &mut Self, id: usize, input: &Input) ! OutOfMemoryError ? &mut Allocator {
    self.releaseRequest(id)
    let packed = StoredInput.pack(input, RARE_NONE)
    if !RareInput.needed(input) && id < self.heads.length() {
      let mut index = self.heads.get(id)
      while index != ABSENT {
        let entry = self.entries.get(index)
        if !entry.pinned && StoredInput.sameSizes(&self.inputs.asSlice()[index], &packed) {
          let entries = self.entries.asMutSlice()
          entries[index].pinned = true
          let results = self.results.asMutSlice()
          results[id].request = usize.toU32(index)
          results[id].flags = packed.flags
          results[id].originX = packed.originXValue()
          results[id].originY = packed.originYValue()
          return
        }
        index = follow(entry.next)
      }
    }
    run self.keepOwnRequest(id, input)
  }
  // Records `input` as box `id`'s request in a slot of its own.
  effect fn keepOwnRequest(self: &mut Self, id: usize, input: &Input) ! OutOfMemoryError ? &mut Allocator {
    let mut slot = self.freeFinal
    let mut previous = RARE_NONE
    if slot != REQUEST_NONE {
      let free = self.finalInputs.asSlice()[u32.toUsize(slot)]
      self.freeFinal = free.flags
      previous = free.rare
    } else {
      slot = usize.toU32(self.finalInputs.length())
      if slot >= REQUEST_OWN { return Intrinsic.trap("LayoutCache: too many final requests") }
      run self.finalInputs.append(StoredInput.pack(input, RARE_NONE))
    }
    let rare = run self.resultRares.put(previous, input)
    self.finalInputs.set(u32.toUsize(slot), StoredInput.pack(input, rare))
    let results = self.results.asMutSlice()
    results[id].request = slot | REQUEST_OWN
  }
  // Box `id` no longer records a request: its shared entry is unpinned, its
  // own slot freed (keeping its rare slot for the next owner to reuse).
  fn releaseRequest(self: &mut Self, id: usize) {
    let request = self.results.asSlice()[id].request
    if request == REQUEST_NONE { return }
    if request & REQUEST_OWN != 0 {
      let slot = request & SLOT_MASK
      let inputs = self.finalInputs.asMutSlice()
      inputs[u32.toUsize(slot)].flags = self.freeFinal
      self.freeFinal = slot
    } else {
      let entries = self.entries.asMutSlice()
      entries[u32.toUsize(request)].pinned = false
    }
    let results = self.results.asMutSlice()
    results[id].request = REQUEST_NONE
  }
  // Every result records no request.
  fn forgetRequests(self: &mut Self) {
    let results = self.results.asMutSlice()
    let mut id: usize = 0
    while id < results.length {
      results[id].request = REQUEST_NONE
      id = id + 1
    }
    self.finalInputs.clear()
    self.freeFinal = REQUEST_NONE
    self.resultRares.clear()
  }
  // Like sameRequest, but neither side may read more of the result.
  pub fn sameBase(a: &Input, b: &Input) -> bool {
    return sameInput(a, b) && a.baselines == b.baselines && a.fullSize == b.fullSize
  }
  // Starts a final pass of block `id`, which forgets its BlockBase until
  // noteBlockBase records the pass's own, and returns whether the last final
  // pass recorded one, which compareBlockBase still reads.
  // Whether block `id` has a noted BlockBase, leaving it noted.
  pub fn hasBlockBase(self: &Self, id: usize) -> bool {
    if id >= self.blockSlots.length() { return false }
    let slot = self.blockSlots.get(id)
    return slot != ABSENT && self.blockBases.asSlice()[slot].valid
  }
  pub fn takeBlockBase(self: &mut Self, id: usize) -> bool {
    if id >= self.blockSlots.length() { return false }
    let slot = self.blockSlots.get(id)
    if slot == ABSENT { return false }
    let bases = self.blockBases.asMutSlice()
    let valid = bases[slot].valid
    bases[slot].valid = false
    return valid
  }
  // How what block `id`'s final pass gives its children compares with what
  // its last one gave them (BASE_*), after takeBlockBase found it.
  pub fn compareBlockBase(self: &Self, id: usize, base: &Input, available: AvailableSpace, inset: ResolvedEdges, width: f32, rtl: bool) -> u8 {
    let previous = &self.blockBases.asSlice()[self.blockSlots.get(id)]
    if previous.rtl != rtl || previous.width != width || !sameAvailable(&previous.available, &available)
      || previous.inset.top != inset.top || previous.inset.right != inset.right || previous.inset.bottom != inset.bottom || previous.inset.left != inset.left { return BASE_CHANGED }
    let request = childRequest(base)
    if sameAgainst(&previous.base, &self.baseRares, &request, &StoredInput.pack(&request, RARE_NONE)) { return BASE_SAME }
    if sameInput(&withoutBlockSize(&self.baseRares.unpack(&previous.base)), &withoutBlockSize(&request)) { return BASE_BLOCK_SIZE }
    return BASE_CHANGED
  }
  // Records what block `id`'s final pass gave its children (see BlockBase).
  pub effect fn noteBlockBase(self: &mut Self, id: usize, base: &Input, available: AvailableSpace, inset: ResolvedEdges, width: f32, rtl: bool) ! OutOfMemoryError ? &mut Allocator {
    let have = self.blockSlots.length()
    if id >= have { run self.blockSlots.appendRepeated(ABSENT, id + 1 - have) }
    let request = childRequest(base)
    let slot = self.blockSlots.get(id)
    let mut previous = RARE_NONE
    if slot != ABSENT { previous = self.blockBases.asSlice()[slot].base.rare }
    let rare = run self.baseRares.put(previous, &request)
    let next = BlockBase { base: StoredInput.pack(&request, rare), available: available, inset: inset, width: width, rtl: rtl, valid: true }
    if slot == ABSENT {
      self.blockSlots.set(id, self.blockBases.length())
      run self.blockBases.append(next)
      return
    }
    let bases = self.blockBases.asMutSlice()
    bases[slot] = next
  }
  // The clear count now, and when a box's results were last cleared.
  pub fn clearClock(self: &Self) -> usize { return self.clock }
  // Whether the clear log holds every box cleared after `clock`, and so
  // every box whose clearedAt is later (see clearLogged).
  pub fn clearsLoggedSince(self: &Self, clock: usize) -> bool { return clock >= self.clearLogFrom }
  // The logged clears: box and clock of each, in no particular order.
  pub fn clearLogLength(self: &Self) -> usize { return self.clearLogCount }
  // Whether clearedAt records boxes below `count`, rather than taking them
  // as cleared now.
  pub fn clearsCover(self: &Self, count: usize) -> bool { return self.cleared.length() >= count }
  pub fn clearLogged(self: &Self, at: usize) -> usize { return self.clearLog[at] }
  pub fn clearLoggedAt(self: &Self, at: usize) -> usize { return self.clearLogClocks[at] }
  // Clears after which no log holds what was cleared: all boxes, or boxes
  // added with no clear recorded.
  fn forgetClears(self: &mut Self) {
    self.clearLogCount = 0
    self.clearLogNext = 0
    self.clearLogFrom = self.clock
  }
  pub fn clearedAt(self: &Self, id: usize) -> usize {
    if id >= self.cleared.length() { return self.clock }
    let at = self.cleared.get(id)
    if at < self.clearedAll { return self.clearedAll }
    return at
  }
  // The compute before this one, once rotateFinals started this one.
  pub fn previousGeneration(self: &Self) -> usize {
    if self.generation == 0 { return 0 }
    return self.generation - 1
  }
  // Whether the box has cached results, and whether all of them were made
  // or used since `generation`: AGES_NONE, AGES_RECENT or AGES_OLDER.
  pub fn entryAges(self: &Self, id: usize, generation: usize) -> u8 {
    if id >= self.heads.length() || self.heads.get(id) == ABSENT { return AGES_NONE }
    let entries = self.entries.asSlice()
    let mut index = self.heads.get(id)
    while index != ABSENT {
      if u32.toUsize(entries[index].generation) < generation { return AGES_OLDER }
      index = follow(entries[index].next)
    }
    return AGES_RECENT
  }
  // Appends recent size probes. Older probes may still be dependencies of a
  // retained final ancestor, so omitting them cannot justify an early cutoff.
  // Only recent independent probes and own intrinsic results are eligible.
  pub effect fn probesOf(self: &Self, id: usize, generation: usize, result: &mut List<CachedProbe>) -> bool ! OutOfMemoryError ? &mut Allocator {
    if id >= self.heads.length() { return true }
    let mut index = self.heads.get(id)
    while index != ABSENT {
      let entry = self.entries.get(index)
      if entry.kind == CacheKind.ContainerAllocation { return false }
      if entry.kind == CacheKind.IndependentBox {
        if u32.toUsize(entry.generation) < generation { return false }
        run result.append(CachedProbe { input: self.entryRares.unpack(&self.inputs.asSlice()[index]), layout: self.layouts.get(index) })
      }
      index = follow(entry.next)
    }
    return true
  }
  // The range a box recorded in this compute, if any.
  pub fn recordedRange(self: &Self, id: usize) -> FinalRange {
    if id >= self.ranges.length() || self.ranges.asSlice()[id].stamp != stamp(self.generation) { return FinalRange.none() }
    return self.ranges.asSlice()[id].range.load()
  }
  // Makes the range a box recorded in this compute, at fragments `shift`
  // earlier than where they now lie, its range of the previous compute.
  pub fn adoptRange(self: &mut Self, id: usize, shift: usize) {
    if id >= self.ranges.length() || self.ranges.asSlice()[id].stamp != stamp(self.generation) { return }
    let ranges = self.ranges.asMutSlice()
    if ranges[id].range.valid() {
      ranges[id].range.start = ranges[id].range.start + usize.toU32(shift)
      ranges[id].range.end = ranges[id].range.end + usize.toU32(shift)
    }
    ranges[id].stamp = STAMP_NONE
    self.stamped = self.stamped - 1
  }
  pub fn lookup(self: &mut Self, id: usize, input: &Input, kind: CacheKind) -> Option<Layout> {
    let index = self.find(id, input, kind)
    if index == ABSENT { return Option<Layout>.None }
    return Option<Layout>.Some { value: self.layouts.get(index) }
  }
  // The entry index of a cached result, or usize.MAX; read it with layoutAt.
  // The census of the last compute's probes over `count` boxes; lookups are
  // counted only for a compute that ran with `counting` set.
  pub fn census(self: &Self, count: usize) -> ProbeCensus {
    let mut result = ProbeCensus { asked: 0, computed: 0, repeated: 0, sameAnswer: 0, sameAnswerBy: [0; 16], mostAsked: 0, mostComputed: 0, byWidth: [0; 4], byHeight: [0; 4], perBox: [0; 5], askedPerBox: [0; 6] }
    let inputs = self.inputs.asSlice()
    let entries = self.entries.asSlice()
    let layouts = &self.layouts
    let mut id: usize = 0
    while id < count {
      let mut asked: usize = 0
      if id < self.asked.length() { asked = u32.toUsize(self.asked.get(id)) }
      result.asked = result.asked + asked
      if asked > result.mostAsked { result.mostAsked = asked }
      let mut bucket = asked
      if asked > 8 { bucket = 5 } else if asked > 4 { bucket = 4 } else if asked > 2 { bucket = 3 }
      result.askedPerBox[bucket] = result.askedPerBox[bucket] + 1
      let mut computed: usize = 0
      let mut index = ABSENT
      if id < self.heads.length() { index = self.heads.get(id) }
      while index != ABSENT {
        let unpacked = self.entryRares.unpack(&inputs[index])
        let input = &unpacked
        computed = computed + 1
        let width = constraintClass(input.known.widthDefinite, &input.availableWidth)
        let height = constraintClass(input.known.heightDefinite, &input.availableHeight)
        result.byWidth[width] = result.byWidth[width] + 1
        result.byHeight[height] = result.byHeight[height] + 1
        let mut other = follow(entries[index].next)
        while other != ABSENT {
          let otherInput = self.entryRares.unpack(&inputs[other])
          if entries[other].kind == entries[index].kind && (sameInput(&otherInput, input) || sameInput(input, &otherInput)) {
            result.repeated = result.repeated + 1
            break
          }
          other = follow(entries[other].next)
        }
        // The chain's head is its newest entry, so `other` was computed first.
        other = follow(entries[index].next)
        while other != ABSENT {
          let earlier = layouts.size(other)
          let later = layouts.size(index)
          if entries[other].kind == entries[index].kind && earlier.width == later.width && earlier.height == later.height {
            result.sameAnswer = result.sameAnswer + 1
            let earlierInput = self.entryRares.unpack(&inputs[other])
            let before = constraintClass(earlierInput.known.widthDefinite, &earlierInput.availableWidth)
            result.sameAnswerBy[before * 4 + width] = result.sameAnswerBy[before * 4 + width] + 1
            break
          }
          other = follow(entries[other].next)
        }
        index = follow(entries[index].next)
      }
      result.computed = result.computed + computed
      if computed > result.mostComputed { result.mostComputed = computed }
      if computed > 4 { computed = 4 }
      result.perBox[computed] = result.perBox[computed] + 1
      id = id + 1
    }
    return result
  }
  @inlineAlways
  fn count(self: &mut Self, id: usize) {
    if self.counting && id < self.asked.length() {
      let asked = self.asked.asMutSlice()
      asked[id] = asked[id] + 1
    }
  }
  pub fn find(self: &mut Self, id: usize, input: &Input, kind: CacheKind) -> usize {
    self.count(id)
    if id >= self.heads.length() { return ABSENT }
    let mut index = self.heads.get(id)
    if index == ABSENT { return ABSENT }
    let packed = StoredInput.pack(input, RARE_NONE)
    while index != ABSENT {
      let entries = self.entries.asSlice()
      let entry = &entries[index]
      if entry.kind == kind && sameAgainst(&self.inputs.asSlice()[index], &self.entryRares, input, &packed) {
        if entry.generation != stamp(self.generation) {
          let mutable = self.entries.asMutSlice()
          mutable[index].generation = stamp(self.generation)
          self.touched = self.touched + 1
        }
        return index
      }
      index = follow(entry.next)
    }
    return ABSENT
  }
  // find for a box's size probe at a definite width, answered by its
  // max-content probe under any parent size (see probeText); ABSENT if none.
  pub fn findWidest(self: &mut Self, id: usize, input: &Input) -> usize {
    self.count(id)
    if id >= self.heads.length() { return ABSENT }
    let mut index = self.heads.get(id)
    while index != ABSENT {
      let entry = self.entries.get(index)
      let stored = &self.inputs.asSlice()[index]
      if entry.kind == CacheKind.IndependentBox && stored.availableWidthKind() == AvailableKind.MaxContent {
        let mut request = input.*
        request.availableWidth = AvailableSpace.maxContent()
        request.parent = stored.parent()
        if sameAgainst(stored, &self.entryRares, &request, &StoredInput.pack(&request, RARE_NONE)) {
          if entry.generation != stamp(self.generation) {
            let mutable = self.entries.asMutSlice()
            mutable[index].generation = stamp(self.generation)
            self.touched = self.touched + 1
          }
          return index
        }
      }
      index = follow(entry.next)
    }
    return ABSENT
  }
  // find for a size probe of a measured leaf with a known width, answered by
  // a width-intrinsic probe of the box that came out that wide (see
  // sameInputAtWidth); ABSENT if there is none.
  pub fn findAtWidth(self: &mut Self, id: usize, input: &Input) -> usize {
    self.count(id)
    if id >= self.heads.length() { return ABSENT }
    let mut index = self.heads.get(id)
    while index != ABSENT {
      let entry = self.entries.get(index)
      let stored = &self.inputs.asSlice()[index]
      if entry.kind == CacheKind.IndependentBox && stored.intrinsicWidth() && !stored.knownWidthDefinite() && sameInputAtWidth(&self.entryRares.unpack(stored), input, self.layouts.size(index).width) {
        if entry.generation != stamp(self.generation) {
          let mutable = self.entries.asMutSlice()
          mutable[index].generation = stamp(self.generation)
          self.touched = self.touched + 1
        }
        return index
      }
      index = follow(entry.next)
    }
    return ABSENT
  }
  @inlineAlways
  pub fn layoutAt(self: &Self, index: usize) -> Layout { return self.layouts.get(index) }
  // The stored sizes and ratio of a cached result.
  @inlineAlways
  pub fn coreAt(self: &Self, index: usize) -> &LayoutCore { return self.layouts.core(index) }
  pub effect fn remember(self: &mut Self, id: usize, input: &Input, kind: CacheKind, layout: &Layout) ! OutOfMemoryError ? &mut Allocator {
    if id >= self.heads.length() {
      let missing = id + 1 - self.heads.length()
      run self.heads.reserve(missing)
      while self.heads.length() <= id { run self.heads.append(ABSENT) }
    }
    let previous = self.heads.get(id)
    // An entry neither this compute nor the previous one used is one compact
    // would drop: the new result takes its place, so a cache whose requests
    // all change (a drag-resize) stays the same size instead of growing
    // into fresh memory until it is compacted.
    if self.generation > 1 {
      let mut at = previous
      while at != ABSENT {
        let entry = self.entries.get(at)
        if u32.toUsize(entry.generation) + 1 < self.generation && !entry.pinned {
          self.entries.set(at, Entry { kind: kind, pinned: false, next: entry.next, generation: stamp(self.generation) })
          let rare = run self.entryRares.put(self.inputs.asSlice()[at].rare, input)
          let inputs = self.inputs.asMutSlice()
          inputs[at] = StoredInput.pack(input, rare)
          run self.layouts.set(at, layout)
          self.touched = self.touched + 1
          return
        }
        at = follow(entry.next)
      }
    }
    let index = self.entries.length()
    // A first layout's probes come roughly in box order (see headedFor).
    if index == self.entries.capacity() {
      let target = headedFor(index, id, self.results.length(), self.emptyAtStart)
      run self.entries.reserveExact(target - index)
      if self.inputs.capacity() < target { run self.inputs.reserveExact(target - index) }
      if self.layouts.capacity() < target { run self.layouts.reserveExact(target - index) }
    }
    let rare = run self.entryRares.put(RARE_NONE, input)
    run self.inputs.append(StoredInput.pack(input, rare))
    run self.layouts.append(layout)
    run self.entries.append(Entry { kind: kind, pinned: false, next: link(previous), generation: stamp(self.generation) })
    self.touched = self.touched + 1
    self.heads.set(id, index)
  }
  // Moves kept results to new box indices after box generation changed:
  // `toOld[new]` is the matching previous box or ABSENT, `toNew` the reverse.
  // Results of previous boxes with no match become unreachable.
  pub effect fn remap(self: &mut Self, toOld: &[usize], toNew: &[usize]) ! OutOfMemoryError ? &mut Allocator {
    self.clock = self.clock + 1
    self.clearedAll = self.clock
    self.forgetClears()
    self.runs.clear()
    self.flexMemos.clear()
    self.gridMemos.clear()
    self.blockSlots.clear()
    self.blockBases.clear()
    self.baseRares.clear()
    self.plainWidths.clear()
    // Stored Inputs retain their immutable identities; only owner-indexed
    // lookup buckets become invalid when generated box indices change.
    self.subgrids.resetOwners()
    run self.gridGeometry.remap(toOld, toNew)
    let mut old: usize = 0
    while old < self.heads.length() {
      if old >= toNew.length || toNew[old] == ABSENT {
        let mut index = self.heads.get(old)
        while index != ABSENT {
          self.dead = self.dead + 1
          index = follow(self.entries.get(index).next)
        }
      }
      old = old + 1
    }
    let mut heads = List<usize>.make()
    let mut kept = List<BoxRanges>.make()
    let mut results = List<FinalResult>.make()
    let mut resultRares = RarePool.make()
    let mut finalInputs = List<StoredInput>.make()
    run heads.reserveExact(toOld.length)
    run kept.reserveExact(toOld.length)
    run results.reserveExact(toOld.length)
    let mut id: usize = 0
    while id < toOld.length {
      let from = toOld[id]
      let mut head = ABSENT
      let mut range = FinalRange.none()
      if from != ABSENT && from < self.heads.length() { head = self.heads.get(from) }
      if from != ABSENT && from < self.ranges.length() { range = self.keptRange(from) }
      run heads.append(head)
      run kept.append(BoxRanges { range: StoredRange.of(range), kept: NO_RANGE, stamp: STAMP_NONE })
      if from != ABSENT && from < self.results.length() {
        let mut result = self.results.asSlice()[from]
        if result.request != REQUEST_NONE && result.request & REQUEST_OWN != 0 {
          let mut stored = self.finalInputs.asSlice()[u32.toUsize(result.request & SLOT_MASK)]
          if stored.rare != RARE_NONE { stored.rare = run resultRares.put(RARE_NONE, &self.resultRares.unpack(&stored)) }
          result.request = usize.toU32(finalInputs.length()) | REQUEST_OWN
          run finalInputs.append(stored)
        }
        run results.append(result)
      } else { run results.append(FinalResult.none()) }
      id = id + 1
    }
    self.heads = move heads
    self.ranges = move kept
    self.rotatedFloats = true
    self.results = move results
    self.resultRares = move resultRares
    self.finalInputs = move finalInputs
    self.freeFinal = REQUEST_NONE
    let mut texts = List<List<KeptText>>.make()
    run texts.reserveExact(toOld.length)
    id = 0
    while id < toOld.length {
      let from = toOld[id]
      let mut text = List<KeptText>.make()
      if from != ABSENT && from < self.texts.length() { text = Intrinsic.replace(self.texts.asMutSlice()[from], List<KeptText>.make()) }
      run texts.append(move text)
      id = id + 1
    }
    self.texts = move texts
    let mut slots = List<usize>.make()
    let mut lines = List<PlainLine>.make()
    if self.plainLines.length() != 0 {
      run slots.reserveExact(toOld.length)
      id = 0
      while id < toOld.length {
        let from = toOld[id]
        let mut slot = ABSENT
        if from != ABSENT && from < self.plainSlots.length() && self.plainSlots.get(from) != ABSENT {
          slot = lines.length()
          run lines.append(Intrinsic.replace(self.plainLines.asMutSlice()[self.plainSlots.get(from)], PlainLine.make()))
        }
        run slots.append(slot)
        id = id + 1
      }
    }
    self.plainSlots = move slots
    self.plainLines = move lines
  }
  // Box `id`'s PlainLine, taken out for the caller to fill or read and hand
  // back with keepPlain; an empty one when the box has none.
  pub fn takePlain(self: &mut Self, id: usize) -> PlainLine {
    if id >= self.plainSlots.length() || self.plainSlots.get(id) == ABSENT { return PlainLine.make() }
    return Intrinsic.replace(self.plainLines.asMutSlice()[self.plainSlots.get(id)], PlainLine.make())
  }
  pub effect fn keepPlain(self: &mut Self, id: usize, line: PlainLine) ! OutOfMemoryError ? &mut Allocator {
    let have = self.plainSlots.length()
    if id >= have { run self.plainSlots.appendRepeated(ABSENT, id + 1 - have) }
    let slot = self.plainSlots.get(id)
    if slot == ABSENT {
      self.plainSlots.set(id, self.plainLines.length())
      run self.plainLines.append(move line)
      return
    }
    self.plainLines.set(slot, move line)
  }
  // Counts the computes that kept paragraphs, for their stamps.
  pub fn nextTextStamp(self: &mut Self) -> usize {
    self.textStamp = self.textStamp + 1
    return self.textStamp
  }
  // Keeps at most `budget` prepared paragraphs: when more are kept, those an
  // earlier compute kept go, and if the compute stamped `stamp` alone kept
  // more, so do its own. The plain lines go with them. A prepared paragraph
  // is several kilobytes that only a later layout of the same text at
  // another width reads, so a long document keeps the ones laid out last.
  pub fn trimTexts(self: &mut Self, stamp: usize, budget: usize) {
    let mut kept: usize = 0
    let mut recent: usize = 0
    let mut id: usize = 0
    while id < self.texts.length() {
      let held = self.texts.asSlice()[id].asSlice()
      if held.length != 0 {
        kept = kept + 1
        if held[0].stamp == stamp { recent = recent + 1 }
      }
      id = id + 1
    }
    if kept <= budget { return }
    id = 0
    while id < self.texts.length() {
      let held = self.texts.asSlice()[id].asSlice()
      let goes = held.length != 0 && (recent > budget || held[0].stamp != stamp)
      drop held
      if goes { self.texts.asMutSlice()[id].clearAndFree() }
      id = id + 1
    }
    self.dropPlains()
  }
  // Drops every box's PlainLine and its storage: the next probe of each
  // shapes its line again.
  pub fn dropPlains(self: &mut Self) {
    self.plainSlots.clearAndFree()
    self.plainLines.clearAndFree()
  }
  pub fn takeText(self: &mut Self, id: usize) -> Option<KeptText> {
    if id >= self.texts.length() { return Option<KeptText>.None }
    return self.texts.asMutSlice()[id].pop()
  }
  pub effect fn keepText(self: &mut Self, id: usize, text: KeptText) ! OutOfMemoryError ? &mut Allocator {
    while self.texts.length() <= id { run self.texts.append(List<KeptText>.make()) }
    self.texts.asMutSlice()[id].clear()
    run self.texts.asMutSlice()[id].append(move text)
  }
  // Rebuilds the entry list without unreachable entries and, once entries the
  // previous compute did not use dominate (a drag-resize leaves one set per
  // size), without those either. Each box keeps its lookup order.
  pub effect fn compact(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    let live = self.entries.length() - self.dead
    let stale = live > 2 * self.previouslyTouched + 256
    let wasteful = self.layouts.unusedWords() > 4096 && self.layouts.unusedWords() * 2 > self.layouts.wordCount()
    if !stale && !wasteful && (self.dead < 256 || self.dead * 2 < self.entries.length()) { return }
    let mut oldest: usize = 0
    if stale && self.generation > 0 { oldest = self.generation - 1 }
    let mut kept = Intrinsic.replace(self.spare, List<Entry>.make())
    let mut keptInputs = Intrinsic.replace(self.spareInputs, List<StoredInput>.make())
    let mut keptLayouts = Intrinsic.replace(self.spareLayouts, LayoutStore.make())
    let mut keptRares = RarePool.make()
    kept.clear()
    keptInputs.clear()
    keptLayouts.clear()
    run kept.reserve(self.entries.length() - self.dead)
    run keptInputs.reserve(self.entries.length() - self.dead)
    run keptLayouts.reserve(self.entries.length() - self.dead)
    let mut chain = List<usize>.make()
    // Where each kept entry moved, for the results that share one.
    let mut moved = List<u32>.make()
    run moved.reserve(self.entries.length())
    while moved.length() < self.entries.length() { run moved.append(REQUEST_NONE) }
    let mut id: usize = 0
    while id < self.heads.length() {
      chain.clear()
      let mut index = self.heads.get(id)
      while index != ABSENT {
        let entry = self.entries.get(index)
        if u32.toUsize(entry.generation) >= oldest || entry.pinned { run chain.append(index) }
        index = follow(self.entries.get(index).next)
      }
      let mut next = ABSENT
      let mut at = chain.length()
      while at > 0 {
        at = at - 1
        let from = chain.get(at)
        let mut entry = self.entries.get(from)
        entry.next = link(next)
        next = kept.length()
        moved.set(from, usize.toU32(next))
        run kept.append(entry)
        let mut stored = self.inputs.asSlice()[from]
        if stored.rare != RARE_NONE { stored.rare = run keptRares.put(RARE_NONE, &self.entryRares.unpack(&stored)) }
        run keptInputs.append(stored)
        run keptLayouts.appendFrom(&self.layouts, from)
      }
      self.heads.set(id, next)
      id = id + 1
    }
    // A result follows its shared entry, or takes its own slot when the
    // entry is gone (its box's entries were forgotten).
    id = 0
    while id < self.results.length() {
      let request = self.results.asSlice()[id].request
      if request != REQUEST_NONE && request & REQUEST_OWN == 0 {
        let to = moved.get(u32.toUsize(request))
        if to != REQUEST_NONE {
          let results = self.results.asMutSlice()
          results[id].request = to
        } else {
          let input = self.resultInput(id)
          let results = self.results.asMutSlice()
          results[id].request = REQUEST_NONE
          run self.keepOwnRequest(id, &input)
        }
      }
      id = id + 1
    }
    self.spare = Intrinsic.replace(self.entries, move kept)
    self.spareInputs = Intrinsic.replace(self.inputs, move keptInputs)
    self.spareLayouts = Intrinsic.replace(self.layouts, move keptLayouts)
    self.entryRares = move keptRares
    self.spare.clear()
    self.spareInputs.clear()
    self.spareLayouts.clear()
    // A large spare would hold as much again as the cache for as long as the
    // tree lives; the next compaction of a cache that size allocates its own
    // (as Snapshot.releaseSpare does for the output).
    let bytes = self.spare.capacity() * Intrinsic.layoutOf<Entry>().bytes
      + self.spareInputs.capacity() * Intrinsic.layoutOf<StoredInput>().bytes
      + self.spareLayouts.storageBytes()
    if bytes > SPARE_KEPT_BYTES {
      self.spare.clearAndFree()
      self.spareInputs.clearAndFree()
      self.spareLayouts.clearAndFree()
    }
    self.dead = 0
  }
}

// Spare snapshot storage at most this large stays for the next compute.
const SPARE_KEPT_BYTES: usize = 64 * 1024

// The previous compute's output, which reused subtrees are copied from.
// Copies keep each fragment's and box's final scrollable overflow: inside a
// reused subtree positioning places everything as before, so propagating
// overflow again would only reach the same union. Positioning's other edits
// (visual offsets, world locations, out-of-flow fragments appended after the
// normal-flow ones) are reset or excluded when copying. Between computes
// `fragments` and `boxes` are spare storage for the next output.
pub struct Snapshot { pub fragments: FragmentArena, pub boxes: List<Layout> }
impl Snapshot {
  pub fn make() -> Snapshot { return Snapshot { fragments: FragmentArena.make(), boxes: List<Layout>.make() } }
  // Takes a finished compute's output, leaving the spare storage in its place.
  // Box layouts stay in place when the next compute keeps them.
  // Forgets the previous output, keeping the storage for the next one.
  pub fn clear(self: &mut Self) {
    self.fragments.clear()
    self.boxes.clear()
  }
  // Frees the spare storage once a compute is done with the previous output,
  // unless it is small: a large spare would double the arena's memory for
  // as long as the tree lives, where a fresh arena costs one allocation
  // (see FragmentArena.reserveLike).
  pub fn releaseSpare(self: &mut Self) {
    if self.fragments.storageBytes() + self.boxes.capacity() * Intrinsic.layoutOf<Layout>().bytes <= SPARE_KEPT_BYTES { return }
    drop Intrinsic.replace(self.fragments, FragmentArena.make())
    drop Intrinsic.replace(self.boxes, List<Layout>.make())
  }
  pub fn takeOutput(self: &mut Self, fragments: &mut FragmentArena, boxes: &mut List<Layout>, keepBoxes: bool) {
    if keepBoxes { return }
    let spareFragments = Intrinsic.replace(self.fragments, FragmentArena.make())
    self.fragments = Intrinsic.replace(fragments.*, move spareFragments)
    let spareBoxes = Intrinsic.replace(self.boxes, List<Layout>.make())
    self.boxes = Intrinsic.replace(boxes.*, move spareBoxes)
  }
  // Renumbers boxes as LayoutCache.remap does.
  pub effect fn remap(self: &mut Self, toOld: &[usize], toNew: &[usize]) ! OutOfMemoryError ? &mut Allocator {
    let mut boxes = List<Layout>.make()
    run boxes.reserveExact(toOld.length)
    let mut id: usize = 0
    while id < toOld.length {
      let from = toOld[id]
      if from != ABSENT && from < self.boxes.length() { run boxes.append(self.boxes.asSlice()[from]) }
      else { run boxes.append(Layout.zero()) }
      id = id + 1
    }
    self.boxes = move boxes
    run self.fragments.remapBoxes(toOld, toNew)
  }
}

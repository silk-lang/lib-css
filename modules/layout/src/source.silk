//! The source tree a compute lays out, as an interface its owner implements.
//!
//! css-layout reads the tree it lays out only through `LayoutSource`: its structure, the style
//! table and each node's index in it, text, measurement, scroll offsets, and grid and shape
//! data. The owner keeps the nodes in whatever form suits it and records each change in a
//! `Changes` it holds, which tells an incremental compute what changed since the last one.
//! `Tree` is the bundled implementation.
import properties.census { Census }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.text.string { String }
import style { Style, DisplayOutside, DisplayInside, Display, Dimension, SizeValue, DimensionKind, Edges, BoxSizing }
import geometry { Point }
import grid_style { GridTemplate }
import shapes { FloatShape }
import tree { Measurement, NO_NODE }

/// A tree css-layout lays out. Node ids are dense, below `nodeCount`, and node 0 is the root;
/// `NO_NODE` stands for no node in links. Every change to what these operations return is
/// recorded in `changes`, but for new content behind a measurement key, which `Changes.marked`
/// records.
pub interface LayoutSource {
  /// One more than the largest node id.
  fn nodeCount(self: &Self) -> usize
  /// Whether `node` is in use: freed ids may lie below `nodeCount`.
  fn exists(self: &Self, node: usize) -> bool
  fn parent(self: &Self, node: usize) -> usize
  fn firstChild(self: &Self, node: usize) -> usize
  fn nextSibling(self: &Self, node: usize) -> usize
  /// The style table. Nodes with the same index share one style, so the boxes generated from
  /// them share it too, with the anonymous and text styles made from it.
  fn styles<'a>(self: &'a Self) -> &'a [Style]
  /// The index of a node's style in `styles`; a text node's is its parent's. A restyle may
  /// give a node another index, as a source that interns its styles does: the index is read
  /// again for the boxes of every node `changes` lists as touched.
  fn styleIndex(self: &Self, node: usize) -> usize
  fn isText(self: &Self, node: usize) -> bool
  /// A text node's text, all of it (see `textStart`).
  fn text<'a>(self: &'a Self, node: usize) -> Option<string<'a>>
  /// The leading bytes of a text node another box lays out (a host's ::first-letter); offsets
  /// stay the text's.
  fn textStart(self: &Self, node: usize) -> usize
  fn measurement(self: &Self, node: usize) -> Measurement
  fn measureKey(self: &Self, node: usize) -> usize
  fn scrollOffset(self: &Self, node: usize) -> Point
  fn viewportScrollOffset(self: &Self) -> Point
  /// Whether sticky boxes stay at their normal position, for an embedder that applies scroll
  /// and sticky offsets itself while drawing.
  fn stickyDeferred(self: &Self) -> bool
  /// Whether any style has `wrap-flow` other than auto: only then does compute look for
  /// exclusions.
  fn exclusionStyles(self: &Self) -> bool
  /// The grid templates, by `Style.grid`; slot 0 is the initial template.
  fn grids<'a>(self: &'a Self) -> &'a [GridTemplate]
  fn gridNames<'a>(self: &'a Self) -> &'a [String]
  /// The `shape-outside` areas, by `Style.shape`; slot 0 is none.
  fn shapes<'a>(self: &'a Self) -> &'a [FloatShape]
  fn changes<'a>(self: &'a Self) -> &'a Changes
}

/// A node's text after its `textStart`: what its boxes lay out.
pub fn laidText<'a, S: LayoutSource>(source: &'a S, node: usize) -> Option<string<'a>> {
  return match source.text(node) {
    Option<string<'a>>.Some { value } => {
      let length = String.byteLength(value)
      let start = source.textStart(node)
      let from = if start < length { start } else { length }
      Option<string<'a>>.Some { value: String.slice(value, from, length - from) }
    }
    Option<string<'a>>.None => Option<string<'a>>.None
  }
}

/// How a style change reaches layout, as `classify` finds it.
pub struct StyleChange {
  /// Nothing changed.
  pub same: bool,
  /// The change reaches only what the box lays out inside itself.
  pub inner: bool,
  /// Padding or border changed, within `inner`.
  pub insets: bool,
  /// A property other than padding and border that a parent may read changed.
  pub beyond: bool,
  /// How boxes are generated changed.
  pub generates: bool,
}
impl Copy for StyleChange {}

/// Classifies a change of a node's style from `previous` to `next`. `flexParent` is whether
/// its parent is a flex container, and `gridParent` whether its nearest box-generating ancestor
/// (past `display: contents` ones) is a grid.
pub fn classify(previous: &Style, next: &Style, flexParent: bool, gridParent: bool) -> StyleChange {
  if previous == next { return StyleChange { same: true, inner: false, insets: false, beyond: false, generates: false } }
  let inner = innerChange(previous, next, flexParent, gridParent) || !flexParent && !gridParent && insetChange(previous, next)
  let insets = !sameEdges(&previous.padding, &next.padding) || !sameEdges(&previous.border, &next.border)
  return StyleChange { same: false, inner: inner, insets: insets, beyond: !sameOuter(previous, next), generates: !sameGeneration(previous, next) }
}

/// Classifies a change of `node`'s style to `next`, reading its parents' displays from
/// `source`, where it still has its previous style.
pub fn classifyIn<S: LayoutSource>(source: &S, node: usize, next: &Style) -> StyleChange {
  let styles = source.styles()
  let parent = source.parent(node)
  let mut flexParent = false
  let mut gridParent = false
  if parent != NO_NODE { flexParent = styles[source.styleIndex(parent)].display.insideIs(DisplayInside.Flex) }
  let mut generatedParent = parent
  while generatedParent != NO_NODE {
    let display = &styles[source.styleIndex(generatedParent)].display
    if !display.isContents() {
      gridParent = display.isGrid()
      break
    }
    generatedParent = source.parent(generatedParent)
  }
  return classify(&styles[source.styleIndex(node)], next, flexParent, gridParent)
}

fn sameDimension(a: Dimension, b: Dimension) -> bool { return a.kind == b.kind && a.value == b.value && a.percent == b.percent }
fn sameSize(a: SizeValue, b: SizeValue) -> bool { return a.kind == b.kind && a.value == b.value && a.percent == b.percent && a.bound == b.bound }
fn sameEdges(a: &Edges, b: &Edges) -> bool {
  return sameDimension(a.top, b.top) && sameDimension(a.right, b.right) && sameDimension(a.bottom, b.bottom) && sameDimension(a.left, b.left)
}
fn lengthEdges(a: &Edges) -> bool {
  return a.top.kind == DimensionKind.Length && a.right.kind == DimensionKind.Length && a.bottom.kind == DimensionKind.Length && a.left.kind == DimensionKind.Length
}
// Whether padding and border fit inside a fixed border-box size: changing
// them then moves nothing a parent computes for the box.
fn insetFits(style: &Style) -> bool {
  if !lengthEdges(&style.padding) || !lengthEdges(&style.border) { return false }
  let horizontal = style.padding.left.value + style.padding.right.value + style.border.left.value + style.border.right.value
  let vertical = style.padding.top.value + style.padding.bottom.value + style.border.top.value + style.border.bottom.value
  return horizontal <= style.width.value && vertical <= style.height.value
}
// Whether a style change reaches only what the box lays out inside itself:
// every property its parent reads is the same. Padding and border count as
// inside only on a border-box with fixed width and height they fit in, and,
// in flex, when it never shrinks. Grid contributions always read item insets.
fn innerChange(a: &Style, b: &Style, flexParent: bool, gridParent: bool) -> bool {
  if !sameOuter(a, b) { return false }
  if sameEdges(&a.padding, &b.padding) && sameEdges(&a.border, &b.border) { return true }
  if a.boxSizing != BoxSizing.BorderBox || a.width.kind != DimensionKind.Length || a.height.kind != DimensionKind.Length { return false }
  if gridParent || flexParent && a.flexShrink != 0.0 { return false }
  return insetFits(a) && insetFits(b)
}
// A change to padding or border alone, which a block parent reads only to
// place the box and its content's float origin (see the cutoff in engine.silk).
fn insetChange(a: &Style, b: &Style) -> bool {
  return sameOuter(a, b) && a.display.outsideIs(DisplayOutside.Block) && !a.replaced
}
// Every inline property but padding and border that a parent may read.
// Grid placement lives in the owned table and is compared by Tree.setGrid instead.
fn sameOuter(a: &Style, b: &Style) -> bool {
  if !sameGeneration(a, b) { return false }
  if !sameSize(a.width, b.width) || !sameSize(a.height, b.height) || !sameSize(a.minWidth, b.minWidth) || !sameSize(a.minHeight, b.minHeight)
    || !sameSize(a.maxWidth, b.maxWidth) || !sameSize(a.maxHeight, b.maxHeight) || !sameEdges(&a.margin, &b.margin) || !sameEdges(&a.inset, &b.inset) { return false }
  if a.boxSizing != b.boxSizing || a.direction != b.direction || a.unicodeBidi != b.unicodeBidi || a.textOrientation != b.textOrientation { return false }
  if a.verticalAlign.kind != b.verticalAlign.kind || !sameDimension(a.verticalAlign.shift, b.verticalAlign.shift) || a.baselineSource != b.baselineSource { return false }
  if a.boxDecorationBreak != b.boxDecorationBreak || a.marginBreak != b.marginBreak || a.breakBefore != b.breakBefore || a.breakAfter != b.breakAfter || a.breakInside != b.breakInside || a.orphans != b.orphans || a.widows != b.widows { return false }
  if a.flexGrow != b.flexGrow || a.flexShrink != b.flexShrink || !sameSize(a.flexBasis, b.flexBasis) || a.order != b.order { return false }
  if a.alignSelf != b.alignSelf || a.justifySelf != b.justifySelf || a.alignSelfSafety != b.alignSelfSafety || a.justifySelfSafety != b.justifySelfSafety { return false }
  if a.scrollbarWidth != b.scrollbarWidth || a.scrollbarGutter != b.scrollbarGutter || a.clear != b.clear || a.visibility != b.visibility { return false }
  if a.aspectRatio != b.aspectRatio || a.aspectRatioAuto != b.aspectRatioAuto { return false }
  if a.columnSpan != b.columnSpan || a.rowSpan != b.rowSpan { return false }
  return true
}

// The style properties box construction reads (see box_tree.silk); other
// properties reach generated boxes only through their styles.
fn sameGeneration(a: &Style, b: &Style) -> bool {
  if a.sizeContainment != b.sizeContainment || a.layoutContainment != b.layoutContainment { return false }
  if a.display.isNone() != b.display.isNone() || a.display.isContents() != b.display.isContents() { return false }
  if a.display.outsideIs(DisplayOutside.Block) != b.display.outsideIs(DisplayOutside.Block) || a.display.outsideIs(DisplayOutside.Inline) != b.display.outsideIs(DisplayOutside.Inline) { return false }
  if a.display.insideIs(DisplayInside.Flow) != b.display.insideIs(DisplayInside.Flow) || a.display.insideIs(DisplayInside.FlowRoot) != b.display.insideIs(DisplayInside.FlowRoot) || a.display.insideIs(DisplayInside.Flex) != b.display.insideIs(DisplayInside.Flex) { return false }
  if a.display.isGrid() != b.display.isGrid() || a.display.insideIs(DisplayInside.GridLanes) != b.display.insideIs(DisplayInside.GridLanes) { return false }
  if a.multicol() != b.multicol() || a.multicolSpan != b.multicolSpan { return false }
  if (tableDisplay(&a.display) || tableDisplay(&b.display)) && !(&a.display == &b.display) { return false }
  return a.replaced == b.replaced && a.position == b.position && a.float == b.float && a.writingMode == b.writingMode && a.alignContent == b.alignContent && a.overflowX == b.overflowX && a.overflowY == b.overflowY
}
fn tableDisplay(display: &Display) -> bool { return display.insideIs(DisplayInside.Table) || display.isTablePart() }

/// Whether text is all whitespace, which box construction drops between flex and grid items:
/// a text node becoming or ceasing to be blank changes its parent's generated boxes.
pub fn blank(value: string) -> bool {
  let bytes = String.utf8Bytes(value)
  let mut index: usize = 0
  while index < bytes.length {
    let byte = bytes[index]
    if byte != 9 && byte != 10 && byte != 13 && byte != 32 { return false }
    index = index + 1
  }
  return true
}

const CHANGE_LOG: usize = 256
const GENERATION_LOG: usize = 64
const SCROLL_LOG: usize = 64
const GRID_LOG: usize = 64

/// What changed in a source, and when: a revision that advances on every change, each node's
/// revisions, and logs of the latest changes. The source holds one and records each of its
/// changes with the operations below, which carry css-layout's rules for what a change reaches.
pub struct Changes {
  current: usize, structure: usize, generated: usize,
  // The revision of each node's last change of style, text or measurement.
  changed: List<usize>,
  // The revision of each node's last change its parent may see: any change
  // but one of style that `classify` finds inner.
  outer: List<usize>,
  // The revision of each node's last style change to padding or border that
  // `classify` found inner.
  insets: List<usize>,
  // The revision of each node's last change its parent may see besides one
  // of style to padding or border alone.
  placed: List<usize>,
  // The last CHANGE_LOG touches, oldest overwritten first: `logNodes[slot]`
  // was touched at revision `logRevisions[slot]`. `logLost` is the latest
  // revision overwritten.
  logNodes: List<usize>, logRevisions: List<usize>, logged: usize, logLost: usize,
  // The last GENERATION_LOG nodes whose children generate boxes anew: the
  // parent of an inserted or removed node, or of one whose style, text or
  // measurement changed how its boxes are generated. `genLost` is the latest
  // revision overwritten, or one whose change the log cannot name.
  genNodes: List<usize>, genRevisions: List<usize>, genLogged: usize, genLost: usize,
  // Scroll offset changes, which move fragments without a revision: the
  // count so far and the last SCROLL_LOG nodes changed.
  scrolls: usize, scrollNodes: List<usize>,
  // The last GRID_LOG nodes whose grid template was replaced, as the change
  // log keeps touches.
  gridNodes: List<usize>, gridRevisions: List<usize>, gridLogged: usize, gridLost: usize,
  // The number of `marked` calls so far.
  marks: usize,
}

impl Changes {
  // What the change record holds, for the bench census.
  pub effect fn census(self: &Self, out: &mut Census) ! OutOfMemoryError ? &mut Allocator {
    let u = Intrinsic.layoutOf<usize>().bytes
    run out.held("css.tree.per-node-revisions", self.changed.length() + self.outer.length() + self.insets.length() + self.placed.length(),
      self.changed.capacity() + self.outer.capacity() + self.insets.capacity() + self.placed.capacity(), u)
    run out.held("css.tree.change-log", self.logNodes.length() + self.logRevisions.length() + self.genNodes.length() + self.genRevisions.length() + self.scrollNodes.length() + self.gridNodes.length() + self.gridRevisions.length(),
      self.logNodes.capacity() + self.logRevisions.capacity() + self.genNodes.capacity() + self.genRevisions.capacity() + self.scrollNodes.capacity() + self.gridNodes.capacity() + self.gridRevisions.capacity(), u)
    run out.work("css.tree.revision", self.current)
    run out.work("css.tree.mark-dirty-calls", self.marks)
  }
  /// Changes of a source whose only node is its root, node 0.
  pub effect fn make() -> Changes ! OutOfMemoryError ? &mut Allocator {
    let mut changed = List<usize>.make()
    run changed.append(1)
    let mut outer = List<usize>.make()
    run outer.append(1)
    let mut insets = List<usize>.make()
    run insets.append(0)
    let mut placed = List<usize>.make()
    run placed.append(1)
    let mut logNodes = List<usize>.make()
    let mut logRevisions = List<usize>.make()
    run logNodes.appendRepeated(NO_NODE, CHANGE_LOG)
    run logRevisions.appendRepeated(0, CHANGE_LOG)
    let mut genNodes = List<usize>.make()
    let mut genRevisions = List<usize>.make()
    run genNodes.appendRepeated(NO_NODE, GENERATION_LOG)
    run genRevisions.appendRepeated(0, GENERATION_LOG)
    let mut scrollNodes = List<usize>.make()
    run scrollNodes.appendRepeated(NO_NODE, SCROLL_LOG)
    let mut gridNodes = List<usize>.make()
    let mut gridRevisions = List<usize>.make()
    run gridNodes.appendRepeated(NO_NODE, GRID_LOG)
    run gridRevisions.appendRepeated(0, GRID_LOG)
    return Changes {
      current: 1, structure: 1, generated: 1,
      changed: move changed, outer: move outer, insets: move insets, placed: move placed,
      logNodes: move logNodes, logRevisions: move logRevisions, logged: 0, logLost: 0,
      genNodes: move genNodes, genRevisions: move genRevisions, genLogged: 0, genLost: 0,
      scrolls: 0, scrollNodes: move scrollNodes,
      gridNodes: move gridNodes, gridRevisions: move gridRevisions, gridLogged: 0, gridLost: 0,
      marks: 0,
    }
  }

  // Reading.

  /// The current revision; it advances on every change.
  pub fn revision(self: &Self) -> usize { return self.current }
  /// The revision of the last node creation, insertion or removal.
  pub fn structureRevision(self: &Self) -> usize { return self.structure }
  /// The revision of the last change that can change generated boxes: a structural change, a
  /// measurement, a style change to how boxes are generated, or a text node becoming or ceasing
  /// to be blank.
  pub fn boxRevision(self: &Self) -> usize { return self.generated }
  /// The revision of the last change to this node's style, text or measurement.
  pub fn changedAt(self: &Self, node: usize) -> usize { return self.changed.get(node) }
  /// The revision of the last change to this node that its parent may see.
  pub fn outerChangedAt(self: &Self, node: usize) -> usize { return self.outer.get(node) }
  /// The revision of the last change to this node's padding or border its parent was allowed
  /// not to see; a block parent sees it all the same.
  pub fn insetsChangedAt(self: &Self, node: usize) -> usize { return self.insets.get(node) }
  /// The revision of the last change to this node that its parent may see, but for one of style
  /// to padding or border alone.
  pub fn placedChangedAt(self: &Self, node: usize) -> usize { return self.placed.get(node) }
  /// Whether this node's grid template, which is all of its own style a grid places its items
  /// by, may have been replaced after revision `since`.
  pub fn gridChangedSince(self: &Self, node: usize, since: usize) -> bool {
    if self.gridLost > since { return true }
    let mut back: usize = 0
    while back < self.gridLogged && back < GRID_LOG {
      let slot = (self.gridLogged - 1 - back) % GRID_LOG
      if self.gridRevisions.get(slot) <= since { return false }
      if self.gridNodes.get(slot) == node { return true }
      back = back + 1
    }
    return false
  }
  /// The number of scroll offset changes so far.
  pub fn scrollRevision(self: &Self) -> usize { return self.scrolls }
  /// The number of `marked` calls so far: revisions that changed no style, text or structure.
  pub fn markRevision(self: &Self) -> usize { return self.marks }

  /// Appends each node whose style, text or measurement changed after revision `since`, once,
  /// and returns true; or returns false, appending nothing, when the log no longer knows them
  /// all: nodes were created or moved since, or too many changes were made.
  pub effect fn changedNodes(self: &Self, since: usize, result: &mut List<usize>) -> bool ! OutOfMemoryError ? &mut Allocator {
    if self.structure > since || self.logLost > since { return false }
    let mut back: usize = 0
    while back < self.logged && back < CHANGE_LOG {
      let slot = (self.logged - 1 - back) % CHANGE_LOG
      let revision = self.logRevisions.get(slot)
      if revision <= since { return true }
      let node = self.logNodes.get(slot)
      // A node's latest touch stands for all of its touches.
      if self.changed.get(node) == revision { run result.append(node) }
      back = back + 1
    }
    return true
  }
  /// Like changedNodes, but also after structural changes: for a compute that finds the boxes
  /// of new nodes itself (see generationChanges).
  pub effect fn touchedNodes(self: &Self, since: usize, result: &mut List<usize>) -> bool ! OutOfMemoryError ? &mut Allocator {
    if self.logLost > since { return false }
    let mut back: usize = 0
    while back < self.logged && back < CHANGE_LOG {
      let slot = (self.logged - 1 - back) % CHANGE_LOG
      let revision = self.logRevisions.get(slot)
      if revision <= since { return true }
      let node = self.logNodes.get(slot)
      if node < self.changed.length() && self.changed.get(node) == revision { run result.append(node) }
      back = back + 1
    }
    return true
  }
  /// Appends, once each, the nodes whose children generate boxes anew after revision `since`,
  /// and returns true; or returns false, appending nothing, when the log no longer holds them
  /// all. Every change since that can change generated boxes is under one of them.
  pub effect fn generationChanges(self: &Self, since: usize, result: &mut List<usize>) -> bool ! OutOfMemoryError ? &mut Allocator {
    if self.genLost > since { return false }
    let mut back: usize = 0
    while back < self.genLogged && back < GENERATION_LOG {
      let slot = (self.genLogged - 1 - back) % GENERATION_LOG
      if self.genRevisions.get(slot) <= since { return true }
      let node = self.genNodes.get(slot)
      let mut seen = false
      let mut at: usize = 0
      while at < result.length() && !seen {
        seen = result.get(at) == node
        at = at + 1
      }
      if !seen { run result.append(node) }
      back = back + 1
    }
    return true
  }
  /// Appends each node whose scroll offset changed after `since` scroll changes and returns
  /// true, or returns false when there were too many.
  pub effect fn scrolledNodes(self: &Self, since: usize, result: &mut List<usize>) -> bool ! OutOfMemoryError ? &mut Allocator {
    if since > self.scrolls || self.scrolls - since > SCROLL_LOG { return false }
    let mut at = since
    while at < self.scrolls {
      run result.append(self.scrollNodes.get(at % SCROLL_LOG))
      at = at + 1
    }
    return true
  }

  // Recording. Each operation is one change of the source, made just before or after it.

  /// Makes room for `count` more node ids, so that `created` on them cannot fail.
  pub effect fn reserve(self: &mut Self, count: usize) ! OutOfMemoryError ? &mut Allocator {
    run self.changed.reserve(count)
    run self.outer.reserve(count)
    run self.insets.reserve(count)
    run self.placed.reserve(count)
  }
  /// A node was made at `node`, a freed id or the next new one, outside the tree.
  pub effect fn created(self: &mut Self, node: usize) ! OutOfMemoryError ? &mut Allocator {
    self.current = self.current + 1
    self.structure = self.current
    self.generated = self.current
    if node < self.changed.length() {
      self.changed.set(node, self.current)
      self.outer.set(node, self.current)
      self.insets.set(node, 0)
      self.placed.set(node, self.current)
      return
    }
    while self.changed.length() < node {
      run self.changed.append(0)
      run self.outer.append(0)
      run self.insets.append(0)
      run self.placed.append(0)
    }
    run self.changed.append(self.current)
    run self.outer.append(self.current)
    run self.insets.append(0)
    run self.placed.append(self.current)
  }
  /// `child` was inserted among `parent`'s children, or moved there.
  pub fn inserted(self: &mut Self, parent: usize, child: usize) {
    self.touchInner(parent)
    self.touch(child)
    self.structure = self.current
    self.generated = self.current
    self.generates(parent)
  }
  /// `node` was taken out of `parent`'s children, keeping its subtree.
  pub fn removed(self: &mut Self, node: usize, parent: usize) {
    self.unlinked(parent)
    self.touch(node)
    self.structure = self.current
    self.generated = self.current
  }
  /// A child of `parent` was unlinked from it (see `removed` and `destroying`).
  pub fn unlinked(self: &mut Self, parent: usize) {
    self.touchInner(parent)
    self.generates(parent)
  }
  /// A subtree outside the tree is about to be freed: call it before `freed`, instead of
  /// `unlinked` when the subtree had no parent.
  pub fn destroying(self: &mut Self) { self.current = self.current + 1 }
  /// `node` was freed. After the subtree's last, call `structureChanged`.
  pub fn freed(self: &mut Self, node: usize) {
    self.changed.set(node, self.current)
    self.outer.set(node, self.current)
    self.placed.set(node, self.current)
  }
  /// The structure changed at the current revision.
  pub fn structureChanged(self: &mut Self) {
    self.structure = self.current
    self.generated = self.current
  }
  /// `node`'s style changed as `change` says (see `classify`); `parent` is its parent or
  /// NO_NODE. A change that is `same` records nothing.
  pub fn styleChanged(self: &mut Self, node: usize, parent: usize, change: StyleChange) {
    if change.same { return }
    if change.inner { self.touchInner(node) }
    else if change.beyond { self.touch(node) }
    else {
      self.touchInner(node)
      self.outer.set(node, self.current)
    }
    if change.inner && change.insets { self.insets.set(node, self.current) }
    if change.generates {
      self.generated = self.current
      self.generatesAround(node, parent)
    }
  }
  /// A text node's text, or the part of it another box lays out, changed. `generates` is
  /// whether it became or ceased to be blank (see `blank`).
  pub fn textChanged(self: &mut Self, node: usize, parent: usize, generates: bool) {
    self.touch(node)
    if generates {
      self.generated = self.current
      self.generatesAround(node, parent)
    }
  }
  /// A leaf took a measurement key, or a different kind of measurement.
  pub fn measured(self: &mut Self, node: usize, parent: usize) {
    self.touch(node)
    self.generated = self.current
    self.generatesAround(node, parent)
  }
  /// A float's `shape-outside` area changed, which lines beside it wrap around.
  pub fn shapeChanged(self: &mut Self, node: usize) { self.touch(node) }
  /// A node's grid template changed: `replaced` whether the template itself differs, `outer`
  /// whether its parent sees it (its placement, or subgrid tracks, changed).
  pub fn gridChanged(self: &mut Self, node: usize, replaced: bool, outer: bool) {
    if outer { self.touch(node) } else { self.touchInner(node) }
    if !replaced { return }
    let slot = self.gridLogged % GRID_LOG
    if self.gridLogged >= GRID_LOG && self.gridRevisions.get(slot) > self.gridLost { self.gridLost = self.gridRevisions.get(slot) }
    self.gridNodes.set(slot, node)
    self.gridRevisions.set(slot, self.current)
    self.gridLogged = self.gridLogged + 1
  }
  /// A change only the node itself lays out differently for, such as a grid set to the initial
  /// template it already had.
  pub fn innerChanged(self: &mut Self, node: usize) { self.touchInner(node) }
  /// A scroll container's scroll offset changed.
  pub fn scrolled(self: &mut Self, node: usize) {
    self.scrollNodes.set(self.scrolls % SCROLL_LOG, node)
    self.scrolls = self.scrolls + 1
  }
  /// A change the other operations cannot name, such as new content behind a measurement key:
  /// layout results that depend on the node are recomputed by the next compute.
  pub fn marked(self: &mut Self, node: usize) {
    self.touch(node)
    self.generated = self.current
    self.generatesAll()
    self.marks = self.marks + 1
  }

  fn touch(self: &mut Self, node: usize) {
    self.touchInner(node)
    self.outer.set(node, self.current)
    self.placed.set(node, self.current)
  }
  fn touchInner(self: &mut Self, node: usize) {
    self.current = self.current + 1
    self.changed.set(node, self.current)
    let slot = self.logged % CHANGE_LOG
    if self.logged >= CHANGE_LOG { self.logLost = self.logRevisions.get(slot) }
    self.logNodes.set(slot, node)
    self.logRevisions.set(slot, self.current)
    self.logged = self.logged + 1
  }
  // Records that the children of `node` generate boxes anew.
  fn generates(self: &mut Self, node: usize) {
    if node == NO_NODE { return }
    let slot = self.genLogged % GENERATION_LOG
    if self.genLogged >= GENERATION_LOG && self.genRevisions.get(slot) > self.genLost { self.genLost = self.genRevisions.get(slot) }
    self.genNodes.set(slot, node)
    self.genRevisions.set(slot, self.current)
    self.genLogged = self.genLogged + 1
  }
  // Records that how `node` generates boxes changed: its parent's children
  // generate boxes anew.
  fn generatesAround(self: &mut Self, node: usize, parent: usize) {
    if parent != NO_NODE { self.generates(parent) }
    else if node == 0 { self.generatesAll() }
  }
  // Records a change to generated boxes the log cannot name.
  fn generatesAll(self: &mut Self) { self.genLost = self.current }
}

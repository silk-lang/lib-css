import properties.census { Census }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.num.u32
import geometry { Point, Size, Rect, ResolvedEdges, BaselineSet, sameSize, sameRect, sameEdges, sameBaselines, sameOverflow }
import tree { NO_NODE }

// Box: a box's border box. Inline: an inline box on a line. Text: runs of
// text of one text node, with the boxes of the lines they are on when those
// lines hold nothing else (see LineText). Line: a line box that holds more
// than text of its inline formatting box: an inline box, an atomic inline, a
// float or an anchor; or a phantom or fragmented line.
pub enum FragmentKind { Box, Inline, Text, Line }
pub struct FragmentId { pub index: usize }
impl Copy for FragmentId {}

pub enum TextFragmentKind { Glyphs, Tab, SegmentBreak }

// What a LineText is: a run of text, or one of the records that describe the
// line box the runs after it sit on.
pub const TEXT_RUN: u8 = 0
// A line box: `location` is where it is in the fragment's parent, `size` its size.
pub const TEXT_LINE: u8 = 1
// A line box an earlier text fragment began (several text nodes share the
// line): the same box again, for readers; `sourceStart` is how many records
// back that fragment's TEXT_LINE record is.
pub const TEXT_LINE_CONTINUED: u8 = 2
// Follows a TEXT_LINE whose runs reach outside it: `location` and `size` are
// the line's scrollable overflow, relative to the line box.
pub const TEXT_LINE_OVERFLOW: u8 = 3

// One record of a text fragment, 32 bytes: a run of text on a line (a word,
// a space, a tab, a preserved break), or a line box (see TEXT_LINE). A text
// fragment holds the runs of one text node that follow one another under one
// parent, in one font: `textCount` records from `textData`, which is why a
// paragraph of a thousand words costs a thousand of these and one Fragment.
//
// A run's `location` is relative to its line box when the fragment carries
// its lines (its first record is a TEXT_LINE: the lines of an inline
// formatting context that hold nothing but text have no fragments of their
// own), else to the fragment's parent, a line or an inline box. The font is
// the fragment's (`Fragment.fontKey`), as are the baselines.
pub struct LineText {
  pub location: Point, pub size: Size,
  pub sourceStart: u32, pub sourceEnd: u32,
  pub shapeKey: u32,
  pub bidiLevel: u8,
  pub kind: TextFragmentKind,
  pub part: u8,
}
impl Copy for LineText {}
impl LineText {
  pub fn make(location: Point, size: Size, sourceStart: usize, sourceEnd: usize, shapeKey: usize, bidiLevel: u8, kind: TextFragmentKind) -> LineText {
    return LineText { location: location, size: size, sourceStart: usize.toU32(sourceStart), sourceEnd: usize.toU32(sourceEnd), shapeKey: usize.toU32(shapeKey), bidiLevel: bidiLevel, kind: kind, part: TEXT_RUN }
  }
  pub fn box(location: Point, size: Size, part: u8, back: usize) -> LineText {
    return LineText { location: location, size: size, sourceStart: usize.toU32(back), sourceEnd: 0, shapeKey: 0, bidiLevel: 0, kind: TextFragmentKind.Glyphs, part: part }
  }
}

// Set in PlacedText.line when the line box has no fragment: the rest is the
// index of its TEXT_LINE record.
pub const LINE_RECORD: usize = usize.MAX / 2 + 1

// A run of text as placed, read through FragmentArena.textRuns: its box and
// its line box are relative to the initial containing block.
pub struct PlacedText {
  pub sourceStart: usize, pub sourceEnd: usize,
  pub shapeKey: usize, pub fontKey: usize, pub bidiLevel: u8, pub kind: TextFragmentKind,
  pub location: Point, pub size: Size,
  // The line box the run sits on (its own box when it is on none), and what
  // tells that line from every other of the output: the line's fragment, or
  // LINE_RECORD and its record. Equal for all the runs of a line, whichever
  // fragments hold them.
  pub lineLocation: Point, pub lineSize: Size, pub line: usize,
  // The run's record in FragmentArena.texts.
  pub record: usize,
}
impl Copy for PlacedText {}

// The runs of a text fragment in order (see FragmentArena.textRuns): `next`
// moves to the next one, which is then in `current`.
pub struct TextRuns<'a> {
  texts: &'a [LineText], at: usize, end: usize,
  // The fragment's parent, and what the runs' locations are relative to: the
  // parent, or the line box of the last line record passed.
  origin: Point, base: Point,
  lineLocation: Point, lineSize: Size, line: usize,
  pub current: PlacedText,
}
impl<'a> TextRuns<'a> {
  pub fn next(self: &mut Self) -> bool {
    while self.at < self.end {
      let index = self.at
      let record = &self.texts[index]
      self.at = index + 1
      if record.part == TEXT_RUN {
        let location = Point { x: self.base.x + record.location.x, y: self.base.y + record.location.y }
        if self.line == NO_NODE {
          // On no line: the run's own box stands for one.
          self.current.lineLocation = location
          self.current.lineSize = record.size
        } else {
          self.current.lineLocation = self.lineLocation
          self.current.lineSize = self.lineSize
        }
        self.current.line = self.line
        self.current.sourceStart = u32.toUsize(record.sourceStart)
        self.current.sourceEnd = u32.toUsize(record.sourceEnd)
        self.current.shapeKey = u32.toUsize(record.shapeKey)
        self.current.bidiLevel = record.bidiLevel
        self.current.kind = record.kind
        self.current.location = location
        self.current.size = record.size
        self.current.record = index
        return true
      }
      if record.part == TEXT_LINE || record.part == TEXT_LINE_CONTINUED {
        self.base = Point { x: self.origin.x + record.location.x, y: self.origin.y + record.location.y }
        self.lineLocation = self.base
        self.lineSize = record.size
        self.line = LINE_RECORD + index
        if record.part == TEXT_LINE_CONTINUED { self.line = LINE_RECORD + (index - u32.toUsize(record.sourceStart)) }
      }
    }
    return false
  }
}

// `value` as a one-element slice, for List.appendSlice: it copies straight
// from `value`, where List.append of a large value built in place copies it
// through the stack first.
@inlineAlways
pub fn one<T>(value: &T) -> &[T] {
  unsafe { return Pointer.borrowMany<T, T>(value, Pointer.assumeMany<T>(Pointer.fromRef<T>(value)), 1) }
}

pub struct Fragment {
  // What resolveLocations reads and writes for every fragment comes first,
  // in one cache line.
  pub parent: usize,
  // Normal physical geometry; rectangles are relative to the border origin.
  pub location: Point, pub visualOffset: Point,
  pub worldLocation: Point,
  pub kind: FragmentKind,
  // One-byte fields fill the word `kind` starts, where they would otherwise
  // pad it and the end of the struct: a long document holds hundreds of
  // thousands of fragments.
  pub first: bool, pub last: bool,
  pub hasFirstBaseline: bool, pub hasLastBaseline: bool,
  // Physical top=1, right=2, bottom=4, left=8.
  pub decorationEdges: u8,
  pub phantom: bool, pub repeated: bool,
  pub box: usize, pub source: usize,
  pub fragmentainer: usize,
  pub firstChild: usize, pub lastChild: usize,
  pub previousSibling: usize, pub nextSibling: usize,
  pub previousForBox: usize, pub nextForBox: usize,
  // A text fragment's records in FragmentArena.texts (see LineText): the
  // first, and how many; and the font its runs were shaped in.
  pub textData: usize,
  pub textCount: u32, pub fontKey: u32,
  pub size: Size,
  pub contentRect: Rect, pub paddingRect: Rect,
  pub layoutBounds: Rect, pub scrollableOverflow: Rect,
  // Logical block offsets in the owning box's writing mode.
  pub firstBaselines: BaselineSet, pub lastBaselines: BaselineSet,
  pub usedMargin: ResolvedEdges,
  pub overflowOnly: bool,
  // No backgrounds, borders, shadows, or own scrollable overflow. Inline
  // interruptions retain source/containing geometry; anonymous Line anchors
  // only retain ancestry and pass through descendant overflow.
  pub nonpainting: bool,
  // An ancestry/containing-block carrier, not a generated source rectangle.
  pub positioningShell: bool,
}
impl Copy for Fragment {}
impl Fragment {
  // Whether two fragments are the same in what their ancestors read: all
  // but their links, location, world location and content and padding rects.
  pub fn sameOutside(a: &Fragment, b: &Fragment, baselines: bool) -> bool {
    return Fragment.sameBesideOverflow(a, b, baselines) && sameOverflow(a.scrollableOverflow, b.scrollableOverflow, a.size)
  }
  pub fn sameBesideOverflow(a: &Fragment, b: &Fragment, baselines: bool) -> bool {
    return a.box == b.box && a.source == b.source && a.kind == b.kind && a.fragmentainer == b.fragmentainer
      && sameSize(a.size, b.size) && sameRect(a.layoutBounds, b.layoutBounds)
      && a.visualOffset.x == b.visualOffset.x && a.visualOffset.y == b.visualOffset.y
      && (!baselines || (sameBaselines(a.firstBaselines, b.firstBaselines) && sameBaselines(a.lastBaselines, b.lastBaselines)
        && a.hasFirstBaseline == b.hasFirstBaseline && a.hasLastBaseline == b.hasLastBaseline)) && sameEdges(a.usedMargin, b.usedMargin)
      && a.decorationEdges == b.decorationEdges && a.phantom == b.phantom && a.repeated == b.repeated && a.overflowOnly == b.overflowOnly
      && a.nonpainting == b.nonpainting && a.positioningShell == b.positioningShell && (a.textData == NO_NODE) == (b.textData == NO_NODE)
  }
  pub fn make(box: usize, source: usize, kind: FragmentKind) -> Fragment {
    return Fragment {
      box: box, source: source, kind: kind, fragmentainer: 0,
      parent: NO_NODE, firstChild: NO_NODE, lastChild: NO_NODE,
      previousSibling: NO_NODE, nextSibling: NO_NODE,
      previousForBox: NO_NODE, nextForBox: NO_NODE,
      location: Point { x: 0.0, y: 0.0 }, size: Size.zero(),
      contentRect: Rect.zero(), paddingRect: Rect.zero(),
      layoutBounds: Rect.zero(), scrollableOverflow: Rect.zero(),
      visualOffset: Point { x: 0.0, y: 0.0 },
      worldLocation: Point { x: 0.0, y: 0.0 },
      firstBaselines: BaselineSet.zero(), lastBaselines: BaselineSet.zero(),
      hasFirstBaseline: false, hasLastBaseline: false,
      usedMargin: ResolvedEdges.zero(), decorationEdges: 15,
      first: true, last: true, phantom: false, repeated: false, overflowOnly: false,
      nonpainting: false, positioningShell: false,
      textData: NO_NODE, textCount: 0, fontKey: 0,
    }
  }
}

// A range copied from the previous compute, whose fragments already hold
// their final scrollable overflow: overflow propagation skips from its last
// fragment to its first. `overflow` is the first fragment's final value.
// The layout that copied it stored the first fragment's normal-flow value.
// `kept` marks a range kept in place from the previous compute.
// `siblings` marks a kept range holding a run of siblings (see keepRun), none of
// which adds to its parent's overflow: propagation skips all of it.
// `from` is where the range started in the output the compute began from, or
// NO_NODE when it is not that output's fragments as they stood (see Carry).
pub struct SettledRange { pub start: usize, pub end: usize, pub overflow: Rect, pub kept: bool, pub siblings: bool, pub last: usize, pub adds: bool, pub from: usize }
impl Copy for SettledRange {}

// A run of fragments that stand as they did when resolveLocations ran the
// time before: `length` fragments from `to`, which were at `from` then. They
// have the same geometry, world locations, kinds, sources and texts, and the
// same children in the same order; only the indices of their tree and box
// links moved with them. A reader that keeps data per fragment moves it by
// these and works out the rest again (see FragmentArena.carried).
pub struct Carry { pub to: usize, pub from: usize, pub length: usize }
impl Copy for Carry {}

// Bytes of storage a FragmentArena holds, by part, used or spare (see
// FragmentArena.storage): `values` the fragments, `valuesUsed` the part of
// it in use, `texts` the text fragments' records, `byBox` the box chains, `marks`
// the per-fragment and per-text bookkeeping, `saved` and `tail` what an
// in-place compute keeps of the previous output, `settled` the settled ranges.
pub struct ArenaStorage { pub values: usize, pub valuesUsed: usize, pub texts: usize, pub byBox: usize, pub marks: usize, pub saved: usize, pub tail: usize, pub settled: usize }
impl Copy for ArenaStorage {}

// A move of the previous output (see FragmentArena.shiftPrevious): indices
// at or after `start` move `by` up or down.
pub struct Shift { pub start: usize, pub up: bool, pub by: usize }
impl Copy for Shift {}
impl Shift {
  fn between(from: usize, to: usize) -> Shift {
    if to >= from { return Shift { start: from, up: true, by: to - from } }
    return Shift { start: from, up: false, by: from - to }
  }
  pub fn apply(self: &Self, index: usize) -> usize {
    if index == NO_NODE || index < self.start { return index }
    if self.up { return index + self.by }
    return index - self.by
  }
}

// Whether a list's spare room is worth giving back: over a quarter of what
// it uses and over 64 KiB.
// The capacity a full list of `length` entries grows to, when the last box
// it holds entries of is `reached` of `boxes`. Layout visits boxes roughly
// in order, so once a sixteenth of them are in, what they took projects
// what the rest will take: the list grows to that and an eighth more, and
// at least by an eighth. Before that it doubles. A long first layout then
// asks for its storage a few times instead of once per doubling, and ends
// without spare room worth trimming (see trimSlack). Only a list filled
// from empty in box order projects (`ordered`), and never past four times
// its size.
pub fn headedFor(length: usize, reached: usize, boxes: usize, ordered: bool) -> usize {
  let mut doubled = length * 2
  if doubled < 64 { doubled = 64 }
  if !ordered || length < 1024 || reached == NO_NODE || reached >= boxes || (reached + 1) * 16 < boxes { return doubled }
  let projected = length * boxes / (reached + 1)
  let padded = projected + projected / 8
  let least = length + length / 8
  if padded < least { return least }
  if padded > length * 4 { return length * 4 }
  return padded
}
fn large(length: usize, capacity: usize, bytes: usize) -> bool {
  let spare = capacity - length
  return spare * 4 > length && spare * bytes > 64 * 1024
}

// Adds up a fragment's location as resolveLocations does, from the root down.
fn locate(values: &[Fragment], index: usize) -> Point {
  let x = values[index].location.x + values[index].visualOffset.x
  let y = values[index].location.y + values[index].visualOffset.y
  let parent = values[index].parent
  if parent == NO_NODE { return Point { x: x, y: y } }
  let above = locate(values, parent)
  return Point { x: x + above.x, y: y + above.y }
}

// Whether [start, end) meets one of the ranges in `spliced`, pairs of a
// start and an end.
fn splicedIn(spliced: &[usize], start: usize, end: usize) -> bool {
  let mut at: usize = 0
  while at + 1 < spliced.length {
    if spliced[at] < end && spliced[at + 1] > start { return true }
    at = at + 2
  }
  return false
}

// Previous fragments edited in a compute that resolveLocations tracks.
const EDITS_TRACKED: usize = 4096
// releaseSaved keeps saved lists shorter than this many slots for the next compute.
const RELEASE_SAVED: usize = 16384
// A fragment slot at or above this names a saved position, at the slot
// less this, instead of a saved fragment.
const PARTIAL_SLOT: usize = usize.MAX / 2 + 1

// Where a fragment is: its tree and box links, which appending and keeping
// fragments after it write, and the placement LayoutPass.place writes of a
// box fragment. An in-place compute saves just this when such a write is
// the fragment's first.
struct FragmentPosition {
  parent: usize, firstChild: usize, lastChild: usize,
  previousSibling: usize, nextSibling: usize,
  previousForBox: usize, nextForBox: usize,
  location: Point, layoutBounds: Rect, usedMargin: ResolvedEdges,
}
impl Copy for FragmentPosition {}
impl FragmentPosition {
  fn of(value: &Fragment) -> FragmentPosition {
    return FragmentPosition {
      parent: value.parent, firstChild: value.firstChild, lastChild: value.lastChild,
      previousSibling: value.previousSibling, nextSibling: value.nextSibling,
      previousForBox: value.previousForBox, nextForBox: value.nextForBox,
      location: value.location, layoutBounds: value.layoutBounds, usedMargin: value.usedMargin,
    }
  }
  fn restore(self: &Self, value: &mut Fragment) {
    value.parent = self.parent
    value.firstChild = self.firstChild
    value.lastChild = self.lastChild
    value.previousSibling = self.previousSibling
    value.nextSibling = self.nextSibling
    value.previousForBox = self.previousForBox
    value.nextForBox = self.nextForBox
    value.location = self.location
    value.layoutBounds = self.layoutBounds
    value.usedMargin = self.usedMargin
  }
}

// Times a compute may move the previous output (see shiftPrevious).
const SHIFTS: usize = 4

// Fragments appendRange checks, copies and relinks at a time.
const RANGE_CHUNK: usize = 64

// An arena of fragments in preorder, with each box's fragments chained.
//
// A compute of the same boxes as the previous one works in place (see
// beginInPlace): the arena still holds the previous output, `count` and
// `textCount` say how much of it this compute has written, and storage past
// them keeps the previous output until written. A previous range at the
// write position that nothing has overwritten is kept where it is instead
// of copied (keepRange). The first write over a previous fragment, text or
// box chain saves its previous value, stamped with `generation`, so the
// previous output stays readable (previous, previousText, previousFirst)
// for ranges that must be copied instead (copyPrevious).
pub struct FragmentArena {
  pub values: List<Fragment>,
  pub texts: List<LineText>,
  firstByBox: List<usize>, lastByBox: List<usize>,
  // Ascending and disjoint.
  pub settled: List<SettledRange>,
  // How many texts precede each fragment.
  textMarks: List<usize>,
  count: usize, textCount: usize,
  // Set from beginInPlace until close, after which writes append again and
  // the previous output past `closedAt` is in tailFragments and tailTexts.
  inPlace: bool, viewing: bool, closedAt: usize, closedTexts: usize,
  // Set when an edit lost part of the previous output: nothing more of it is reused.
  damaged: bool,
  previousCount: usize, previousTexts: usize,
  // Every index below these was written by this compute.
  written: usize, textsWritten: usize,
  generation: usize,
  fragmentStamps: List<usize>, fragmentSlots: List<usize>, savedFragments: List<Fragment>, savedPositions: List<FragmentPosition>,
  textStamps: List<usize>, textSlots: List<usize>, savedTexts: List<LineText>,
  // A box whose stamp is current has chains of this compute; the others
  // keep their previous chains, in kept ranges, or none (see first).
  boxStamps: List<usize>, boxSlots: List<usize>, savedFirst: List<usize>, savedLast: List<usize>,
  tailFragments: List<Fragment>, tailTexts: List<LineText>,
  // Whether positioning may have given fragments visual offsets, and the
  // normal-flow fragments it linked to fragments after the normal flow, in
  // this and the previous compute; kept ranges must not contain the latter.
  // `flowEnd` is where the normal flow ended (see endFlow).
  offsets: bool,
  // Whether every world location must be resolved again, else those of
  // fragments outside unmoved kept ranges; and the previous fragments
  // edited in this compute, at most EDITS_TRACKED of them.
  resolveAll: bool, edited: List<usize>,
  // The edits past EDITS_TRACKED: all of them lie in [editedLow, editedHigh),
  // which is empty when there were none. A compute writes over the previous
  // fragments of the boxes it lays out again in arena order, so the interval
  // holds little else.
  editedLow: usize, editedHigh: usize,
  // Whether world locations and text first/last flags await
  // resolveLocations (see deferLocations).
  stale: bool,
  afterFlow: bool, flowEnd: usize, flowTexts: usize,
  // Kept fragments whose next-sibling link may still name the fragment that
  // followed them in the previous output (see keepRange, closeSiblings).
  openSiblings: List<usize>,
  adopted: List<usize>, previousAdopted: List<usize>,
  // How many times this compute moved the previous output.
  shifts: usize,
  // Moves of the previous output refused because they would write over
  // fragments or texts of boxes not laid out yet (see shiftUnsafe),
  // over the arena's life: each makes the ranges after it copied instead.
  pub shiftsRefused: usize,
  // Whether this compute refused a move: then the previous output past the
  // flow cannot stand (see endFlow).
  refusedNow: bool,
  // Whether every fragment, kept and copied ones included, is a box fragment
  // of a box under the first one (see treeOverflow).
  pub plain: bool,
  // What the last resolveLocations found standing as it did at the one before
  // it, ascending by `to` and disjoint: every other fragment is new, changed,
  // moved, or lies in a range one of whose fragments is. Meaningless unless
  // `carriedKnown`: then nothing is known to stand (the first output, one
  // written afresh, visual offsets, too many edits).
  pub carried: List<Carry>, pub carriedKnown: bool,
  // Whether the settled ranges' `from` name the output the last
  // resolveLocations saw: until the next one. After it they stand in place.
  mapped: bool,
  // The moves of the previous output this compute made, in order.
  shiftLog: List<Shift>,
  // Ranges spliceFrom replaced since the last resolveLocations: start and
  // end of each.
  spliced: List<usize>,
  // Whether this output, written afresh, holds ranges copied from the
  // previous one (appendRange), and whether every such range came from an
  // output whose world locations were resolved and that had no visual
  // offsets, as this one has none: then a copied range whose first fragment
  // stands where it stood keeps its world locations, like one kept in place.
  copied: bool, copiesStand: bool,
  // How many fragments the last resolveLocations visited, and whether it had
  // to resolve every one, for diagnostics.
  pub resolved: usize, pub resolvedAll: bool,
  // Of the settled ranges it could not skip: how many because their first
  // fragment moved, and how many because a fragment inside was edited.
  pub resolvedMoved: usize, pub resolvedEdited: usize,
}
impl FragmentArena {
  // What the arena holds, for the bench census: the fragments, the text
  // records, and every per-fragment, per-text and per-box side list together.
  pub effect fn census(self: &Self, fragments: string<'static>, texts: string<'static>, side: string<'static>, out: &mut Census) ! OutOfMemoryError ? &mut Allocator {
    let f = Intrinsic.layoutOf<Fragment>().bytes
    let t = Intrinsic.layoutOf<LineText>().bytes
    run out.held(fragments, self.values.length(), self.values.capacity(), f)
    run out.held(texts, self.texts.length(), self.texts.capacity(), t)
    let s = self.storage()
    let used = (self.firstByBox.length() + self.lastByBox.length() + self.boxStamps.length() + self.boxSlots.length() + self.savedFirst.length() + self.savedLast.length()
      + self.textMarks.length() + self.fragmentStamps.length() + self.fragmentSlots.length() + self.textStamps.length() + self.textSlots.length()) * Intrinsic.layoutOf<usize>().bytes
      + self.savedFragments.length() * f + self.savedPositions.length() * Intrinsic.layoutOf<FragmentPosition>().bytes + self.savedTexts.length() * t
      + self.tailFragments.length() * f + self.tailTexts.length() * t + self.settled.length() * Intrinsic.layoutOf<SettledRange>().bytes
    run out.bytes(side, used, s.byBox + s.marks + s.saved + s.tail + s.settled)
  }
  pub fn make() -> FragmentArena {
    return FragmentArena {
      values: List<Fragment>.make(),
      texts: List<LineText>.make(),
      firstByBox: List<usize>.make(), lastByBox: List<usize>.make(),
      settled: List<SettledRange>.make(),
      textMarks: List<usize>.make(),
      count: 0, textCount: 0,
      inPlace: false, viewing: false, closedAt: 0, closedTexts: 0, damaged: false,
      previousCount: 0, previousTexts: 0,
      written: 0, textsWritten: 0,
      generation: 0,
      fragmentStamps: List<usize>.make(), fragmentSlots: List<usize>.make(), savedFragments: List<Fragment>.make(), savedPositions: List<FragmentPosition>.make(),
      textStamps: List<usize>.make(), textSlots: List<usize>.make(), savedTexts: List<LineText>.make(),
      boxStamps: List<usize>.make(), boxSlots: List<usize>.make(), savedFirst: List<usize>.make(), savedLast: List<usize>.make(),
      tailFragments: List<Fragment>.make(), tailTexts: List<LineText>.make(),
      offsets: false,
      resolveAll: true, edited: List<usize>.make(), editedLow: usize.MAX, editedHigh: 0,
      stale: false,
      afterFlow: false, flowEnd: 0, flowTexts: 0, openSiblings: List<usize>.make(), plain: true, resolved: 0, resolvedAll: false, resolvedMoved: 0, resolvedEdited: 0,
      carried: List<Carry>.make(), carriedKnown: false, mapped: false, shiftLog: List<Shift>.make(), spliced: List<usize>.make(),
      copied: false, copiesStand: true,
      adopted: List<usize>.make(), previousAdopted: List<usize>.make(),
      shifts: 0, shiftsRefused: 0, refusedNow: false,
    }
  }

  // Bytes of storage each part of the arena holds, used or spare.
  pub fn storage(self: &Self) -> ArenaStorage {
    let f = Intrinsic.layoutOf<Fragment>().bytes
    let t = Intrinsic.layoutOf<LineText>().bytes
    let u = Intrinsic.layoutOf<usize>().bytes
    return ArenaStorage {
      values: self.values.capacity() * f, valuesUsed: self.values.length() * f,
      texts: self.texts.capacity() * t,
      byBox: (self.firstByBox.capacity() + self.lastByBox.capacity() + self.boxStamps.capacity() + self.boxSlots.capacity() + self.savedFirst.capacity() + self.savedLast.capacity()) * u,
      marks: (self.textMarks.capacity() + self.fragmentStamps.capacity() + self.fragmentSlots.capacity() + self.textStamps.capacity() + self.textSlots.capacity()) * u,
      saved: self.savedFragments.capacity() * f + self.savedPositions.capacity() * Intrinsic.layoutOf<FragmentPosition>().bytes + self.savedTexts.capacity() * t,
      tail: self.tailFragments.capacity() * f + self.tailTexts.capacity() * t,
      settled: self.settled.capacity() * Intrinsic.layoutOf<SettledRange>().bytes,
    }
  }

  // All the storage the arena holds, in bytes.
  pub fn storageBytes(self: &Self) -> usize {
    let s = self.storage()
    return s.values + s.texts + s.byBox + s.marks + s.saved + s.tail + s.settled
  }
  // Reserves room for as many fragments and texts as `other` holds and an
  // eighth more, in one allocation each: a fresh arena then skips growing by
  // doubling, and a slightly larger output still fits.
  pub effect fn reserveLike(self: &mut Self, other: &FragmentArena) ! OutOfMemoryError ? &mut Allocator {
    let fragments = other.values.length() + other.values.length() / 8
    let haveFragments = self.values.length()
    if self.values.capacity() < fragments { run self.values.reserveExact(fragments - haveFragments) }
    let texts = other.texts.length() + other.texts.length() / 8
    let haveTexts = self.texts.length()
    if self.texts.capacity() < texts { run self.texts.reserveExact(texts - haveTexts) }
    let haveMarks = self.textMarks.length()
    if self.textMarks.capacity() < fragments { run self.textMarks.reserveExact(fragments - haveMarks) }
  }

  // Gives back the spare room growth by doubling left in the fragment and
  // text lists when it is large: up to as much again as they use. Shrinking
  // usually resizes in place.
  pub effect fn trimSlack(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    let f = Intrinsic.layoutOf<Fragment>().bytes
    if large(self.values.length(), self.values.capacity(), f) { run self.values.shrinkToFit() }
    if large(self.textMarks.length(), self.textMarks.capacity(), Intrinsic.layoutOf<usize>().bytes) { run self.textMarks.shrinkToFit() }
    if large(self.texts.length(), self.texts.capacity(), Intrinsic.layoutOf<LineText>().bytes) { run self.texts.shrinkToFit() }
  }

  // A full reset invalidates every fragment ID and checkpoint, retaining capacity.
  pub effect fn prepare(self: &mut Self, boxCount: usize) ! OutOfMemoryError ? &mut Allocator {
    self.clear()
    run self.firstByBox.reserveExact(boxCount)
    run self.lastByBox.reserveExact(boxCount)
    run self.firstByBox.appendRepeated(NO_NODE, boxCount)
    run self.lastByBox.appendRepeated(NO_NODE, boxCount)
  }

  // prepare for an arena of as many boxes whose box chains are all unset
  // (see unsetChains): only the rest needs resetting.
  pub effect fn prepareUnset(self: &mut Self, boxCount: usize) ! OutOfMemoryError ? &mut Allocator {
    if self.firstByBox.length() != boxCount {
      run self.prepare(boxCount)
      return
    }
    let first = Intrinsic.replace(self.firstByBox, List<usize>.make())
    let last = Intrinsic.replace(self.lastByBox, List<usize>.make())
    self.clear()
    self.firstByBox = move first
    self.lastByBox = move last
  }
  // Unsets a box's chains (see prepareUnset).
  pub fn unsetChains(self: &mut Self, box: usize) {
    self.firstByBox.set(box, NO_NODE)
    self.lastByBox.set(box, NO_NODE)
  }

  // Empties the arena, keeping its storage.
  pub fn clear(self: &mut Self) {
    self.values.clear()
    self.texts.clear()
    self.settled.clear()
    self.firstByBox.clear()
    self.lastByBox.clear()
    self.textMarks.clear()
    self.count = 0
    self.textCount = 0
    self.plain = true
    self.inPlace = false
    self.viewing = false
    self.previousCount = 0
    self.previousTexts = 0
    self.offsets = false
    self.resolveAll = true
    self.edited.clear()
    self.editedLow = usize.MAX
    self.editedHigh = 0
    self.afterFlow = false
    self.adopted.clear()
    self.previousAdopted.clear()
    self.mapped = true
    self.shiftLog.clear()
    self.spliced.clear()
    self.copied = false
    self.copiesStand = true
  }

  // Starts a compute of the same `boxCount` boxes in place over the
  // previous output, which must be complete.
  pub effect fn beginInPlace(self: &mut Self, boxCount: usize) ! OutOfMemoryError ? &mut Allocator {
    if self.firstByBox.length() != boxCount || self.count != self.values.length() || self.textCount != self.texts.length() {
      run self.prepare(boxCount)
      return
    }
    // The kept output stays plain if it was (see `plain`).
    // Positioning applies visual offsets afresh.
    if self.offsets {
      let values = self.values.asMutSlice()
      let mut at: usize = 0
      while at < values.length {
        values[at].visualOffset = Point { x: 0.0, y: 0.0 }
        at = at + 1
      }
      self.offsets = false
      self.resolveAll = true
    }
    // The edits of an unresolved compute are about to be forgotten.
    if self.stale { self.resolveAll = true }
    self.edited.clear()
    self.editedLow = usize.MAX
    self.editedHigh = 0
    self.afterFlow = false
    self.shifts = 0
    self.refusedNow = false
    let adopted = Intrinsic.replace(self.previousAdopted, List<usize>.make())
    self.previousAdopted = Intrinsic.replace(self.adopted, move adopted)
    self.adopted.clear()
    run self.previousAdopted.sort()
    self.mapped = true
    self.shiftLog.clear()
    self.spliced.clear()
    self.generation = self.generation + 1
    self.previousCount = self.values.length()
    self.previousTexts = self.texts.length()
    self.count = 0
    self.textCount = 0
    self.written = 0
    self.textsWritten = 0
    self.inPlace = true
    self.viewing = true
    self.damaged = false
    self.settled.clear()
    self.savedFragments.clear()
    self.savedPositions.clear()
    self.openSiblings.clear()
    self.savedTexts.clear()
    self.savedFirst.clear()
    self.savedLast.clear()
    self.tailFragments.clear()
    self.tailTexts.clear()
    if self.fragmentStamps.length() < self.previousCount {
      let missing = self.previousCount - self.fragmentStamps.length()
      run self.fragmentStamps.appendRepeated(0, missing)
      run self.fragmentSlots.appendRepeated(0, missing)
    }
    if self.textStamps.length() < self.previousTexts {
      let missing = self.previousTexts - self.textStamps.length()
      run self.textStamps.appendRepeated(0, missing)
      run self.textSlots.appendRepeated(0, missing)
    }
    if self.boxStamps.length() < boxCount {
      let missing = boxCount - self.boxStamps.length()
      run self.boxStamps.appendRepeated(0, missing)
      run self.boxSlots.appendRepeated(0, missing)
    }
  }

  // Ends the normal flow, and writing in place (see finishInPlace), unless
  // the flow ended where the previous one did: then positioning's fragments
  // may stand where they were too, and writing in place goes on. When the
  // flow ended elsewhere (it emitted more or fewer fragments), the previous
  // output after its flow is moved to the write position first, so that it
  // does: the caller moves the ranges it holds by the returned shift (see
  // shiftPrevious), which is 0 when nothing moved.
  pub effect fn endFlow(self: &mut Self) -> Shift ! OutOfMemoryError ? &mut Allocator {
    let none = Shift { start: 0, up: false, by: 0 }
    if self.afterFlow { return none }
    // Where the previous flow ended, after the moves this compute made.
    let mut previousEnd = self.flowEnd
    let log = self.shiftLog.asSlice()
    let mut at: usize = 0
    while at < log.length {
      if previousEnd >= log[at].start { previousEnd = log[at].apply(previousEnd) }
      at = at + 1
    }
    let mut shift = none
    let mut stands = false
    if self.inPlace && !self.damaged {
      let mut texts = self.previousTexts
      if previousEnd < self.previousCount { texts = self.textMarks.get(previousEnd) }
      stands = self.count == previousEnd && self.textCount == texts && !self.refusedNow
      if !stands && !self.refusedNow && previousEnd < self.previousCount {
        shift = run self.shiftPrevious(previousEnd)
        stands = shift.by != 0
      }
    }
    self.afterFlow = true
    self.flowEnd = self.count
    self.flowTexts = self.textCount
    if !self.inPlace || stands { return shift }
    run self.finishInPlace()
    return none
  }
  // Ends writing in place: later writes append, and the previous output
  // past the write position stays readable.
  pub effect fn finishInPlace(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    run self.closeSiblings()
    if !self.inPlace { return }
    self.inPlace = false
    self.closedAt = self.count
    self.closedTexts = self.textCount
    if self.count < self.values.length() {
      let length = self.values.length() - self.count
      run self.tailFragments.appendSlice(Slice.view(self.values.asSlice(), self.count, length))
    }
    if self.textCount < self.texts.length() {
      let length = self.texts.length() - self.textCount
      run self.tailTexts.appendSlice(Slice.view(self.texts.asSlice(), self.textCount, length))
    }
    self.values.truncate(self.count)
    self.texts.truncate(self.textCount)
    self.textMarks.truncate(self.count)
  }

  // Gives back what an in-place compute saved of the output before it, once
  // the compute is over: from then on the previous output is the current one.
  // A compute that rewrote most of a long document saved about as much as the
  // document's fragments (76 MB for 290,000), and held it until the next.
  pub fn releaseSaved(self: &mut Self) {
    if self.inPlace { return }
    let held = self.savedFragments.capacity() + self.tailFragments.capacity() + self.savedTexts.capacity() + self.tailTexts.capacity()
    if held < RELEASE_SAVED { return }
    self.savedFragments.clearAndFree()
    self.savedPositions.clearAndFree()
    self.savedTexts.clearAndFree()
    self.savedFirst.clearAndFree()
    self.savedLast.clearAndFree()
    self.tailFragments.clearAndFree()
    self.tailTexts.clearAndFree()
    // No stamp names a saved slot now, and nothing past the write position is kept.
    self.generation = self.generation + 1
    self.closedAt = usize.MAX
    self.closedTexts = usize.MAX
    self.previousCount = self.values.length()
    self.previousTexts = self.texts.length()
  }

  // Whether reused ranges come from this arena's previous output rather
  // than another arena.
  pub fn viewsPrevious(self: &Self) -> bool { return self.viewing }
  pub fn previousWhole(self: &Self) -> bool { return !self.damaged }
  pub fn previousLength(self: &Self) -> usize { return self.previousCount }

  // The previous compute's fragment at `index`, below previousLength.
  pub fn previous(self: &Self, index: usize) -> Fragment {
    if index < self.fragmentStamps.length() && self.fragmentStamps.get(index) == self.generation {
      let slot = self.fragmentSlots.get(index)
      if slot < PARTIAL_SLOT { return self.savedFragments.get(slot) }
      let mut value = self.values.get(index)
      self.savedPositions.asSlice()[slot - PARTIAL_SLOT].restore(&mut value)
      return value
    }
    if !self.inPlace && index >= self.closedAt { return self.tailFragments.get(index - self.closedAt) }
    return self.values.get(index)
  }
  fn previousText(self: &Self, index: usize) -> LineText {
    if index < self.textStamps.length() && self.textStamps.get(index) == self.generation { return self.savedTexts.get(self.textSlots.get(index)) }
    if !self.inPlace && index >= self.closedTexts { return self.tailTexts.get(index - self.closedTexts) }
    return self.texts.get(index)
  }
  // The previous compute's first fragment of a box.
  @inlineAlways
  pub fn previousFirst(self: &Self, box: usize) -> usize {
    if box < self.boxStamps.length() && self.boxStamps.get(box) == self.generation { return self.savedFirst.get(self.boxSlots.get(box)) }
    return self.firstByBox.get(box)
  }

  // Saves what a write over fragment `index` would lose of the previous output.
  // appendSlice copies the fragment straight across; append would stage it
  // through the stack first.
  effect fn saveFragment(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    if !self.inPlace || index >= self.previousCount { return }
    if self.fragmentStamps.get(index) == self.generation {
      if self.fragmentSlots.get(index) >= PARTIAL_SLOT { run self.savePlaced(index) }
      return
    }
    run self.savedFragments.appendSlice(one<Fragment>(&self.values.asSlice()[index]))
    run self.noteEdit(index)
    self.fragmentStamps.set(index, self.generation)
    self.fragmentSlots.set(index, self.savedFragments.length() - 1)
  }
  // A fragment saved by position is about to be written whole: saves its
  // whole previous value.
  effect fn savePlaced(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    run self.savedFragments.appendSlice(one<Fragment>(&self.values.asSlice()[index]))
    let last = self.savedFragments.length() - 1
    self.savedPositions.asSlice()[self.fragmentSlots.get(index) - PARTIAL_SLOT].restore(&mut self.savedFragments.asMutSlice()[last])
    self.fragmentSlots.set(index, last)
  }
  // saveFragment for a write of only the fragment's position.
  effect fn savePosition(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    if !self.inPlace || index >= self.previousCount || self.fragmentStamps.get(index) == self.generation { return }
    run self.savedPositions.append(FragmentPosition.of(&self.values.asSlice()[index]))
    run self.noteEdit(index)
    self.fragmentStamps.set(index, self.generation)
    self.fragmentSlots.set(index, self.savedPositions.length() - 1 + PARTIAL_SLOT)
  }
  effect fn saveText(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    if !self.inPlace || index >= self.previousTexts || self.textStamps.get(index) == self.generation { return }
    run self.savedTexts.appendSlice(one<LineText>(&self.texts.asSlice()[index]))
    self.textStamps.set(index, self.generation)
    self.textSlots.set(index, self.savedTexts.length() - 1)
  }
  // Notes an edit of fragment `index` that cannot save its previous value:
  // the previous output is no longer whole.
  fn editUnsaved(self: &mut Self, index: usize) {
    if !self.inPlace { return }
    if index < self.previousCount && self.fragmentStamps.get(index) != self.generation { self.damaged = true }
    if index + 1 > self.written { self.written = index + 1 }
  }
  // Prepares fragment `index` for an edit by the caller.
  @inlineAlways
  pub effect fn edit(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    // A fresh arena, writing over no previous output, saves and notes nothing.
    if self.inPlace || self.viewing { run self.editPrevious(index) }
  }
  // edit for a write of only a fragment's links or a box fragment's
  // placement (see FragmentPosition).
  @inlineAlways
  pub effect fn editPosition(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    // Most such writes are to fragments this compute already wrote.
    if self.inPlace && index < self.written && (index >= self.previousCount || self.fragmentStamps.asSlice()[index] == self.generation) { return }
    if self.inPlace || self.viewing { run self.editPositionPrevious(index) }
  }
  effect fn editPositionPrevious(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    run self.savePosition(index)
    if self.inPlace && index + 1 > self.written { self.written = index + 1 }
    else if self.viewing && !self.inPlace && index < self.previousCount { run self.noteEdit(index) }
  }
  effect fn editPrevious(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    run self.saveFragment(index)
    if self.inPlace && index + 1 > self.written { self.written = index + 1 }
    // Positioning edits after the flow, which saves nothing.
    else if self.viewing && !self.inPlace && index < self.previousCount { run self.noteEdit(index) }
  }
  @inlineAlways
  effect fn noteEdit(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    if self.resolveAll { return }
    if self.edited.length() == EDITS_TRACKED {
      if index < self.editedLow { self.editedLow = index }
      if index >= self.editedHigh { self.editedHigh = index + 1 }
      return
    }
    run self.edited.append(index)
  }
  // Gives a box chains of this compute, saving its previous ones, before
  // its fragment at `index` is linked to them: the previous ones if they are
  // in a kept range before it, else none.
  effect fn claimBox(self: &mut Self, box: usize, index: usize) ! OutOfMemoryError ? &mut Allocator {
    if !self.viewing || self.boxStamps.get(box) == self.generation { return }
    let first = self.firstByBox.get(box)
    let last = self.lastByBox.get(box)
    run self.savedFirst.append(first)
    run self.savedLast.append(last)
    self.boxStamps.set(box, self.generation)
    self.boxSlots.set(box, self.savedFirst.length() - 1)
    if first >= index || last >= index || self.current(box, first) == NO_NODE || self.current(box, last) == NO_NODE {
      self.firstByBox.set(box, NO_NODE)
      self.lastByBox.set(box, NO_NODE)
    }
  }
  // Gives a box of the kept range [start, end) back its previous chains if
  // this compute claimed it before keeping the range.
  pub fn keepBox(self: &mut Self, box: usize, start: usize, end: usize) {
    if !self.viewing || self.boxStamps.get(box) != self.generation { return }
    let slot = self.boxSlots.get(box)
    let first = self.savedFirst.get(slot)
    let last = self.savedLast.get(slot)
    if first == NO_NODE || first < start || first >= end || last < start || last >= end || self.values.asSlice()[first].box != box { return }
    self.firstByBox.set(box, first)
    self.lastByBox.set(box, last)
  }

  // The last box with a fragment among the latest written, or NO_NODE.
  fn reached(self: &Self) -> usize {
    let values = self.values.asSlice()
    let mut reached = NO_NODE
    let mut index = self.count
    let mut seen: usize = 0
    while index > 0 && seen < 64 {
      index = index - 1
      let box = values[index].box
      if box != NO_NODE && (reached == NO_NODE || box > reached) { reached = box }
      seen = seen + 1
    }
    return reached
  }
  // Room for one more fragment (see headedFor).
  @inlineAlways
  effect fn room(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    if self.values.length() == self.values.capacity() { run self.growValues() }
  }
  @inlineNever
  effect fn growValues(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    let length = self.values.length()
    let target = headedFor(length, self.reached(), self.firstByBox.length(), !self.inPlace && !self.viewing)
    run self.values.reserveExact(target - length)
    let marks = self.textMarks.length()
    if self.textMarks.capacity() < target { run self.textMarks.reserveExact(target - marks) }
  }
  // Room for one more text.
  @inlineAlways
  effect fn textRoom(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    if self.texts.length() == self.texts.capacity() { run self.growTexts() }
  }
  @inlineNever
  effect fn growTexts(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    let length = self.texts.length()
    let target = headedFor(length, self.reached(), self.firstByBox.length(), !self.inPlace && !self.viewing)
    run self.texts.reserveExact(target - length)
  }
  // Writes a fragment at the write position.
  effect fn put(self: &mut Self, value: Fragment) -> usize ! OutOfMemoryError ? &mut Allocator {
    let index = self.count
    run self.saveFragment(index)
    // Texts are in fragment order: a text fragment's is the next.
    let mut mark = self.textCount
    if value.textData != NO_NODE { mark = value.textData }
    if index < self.values.length() {
      self.values.set(index, value)
      self.textMarks.set(index, mark)
    } else {
      run self.room()
      run self.values.append(value)
      run self.textMarks.append(mark)
    }
    self.count = index + 1
    if self.inPlace && self.count > self.written { self.written = self.count }
    return index
  }
  // put of Fragment.make(box, source, kind), written in its slot.
  // appendBox in a fresh arena during normal flow: nothing to save, claim
  // or adopt.
  effect fn appendFresh(self: &mut Self, box: usize, source: usize, kind: FragmentKind, parent: usize, fragmentainer: usize, first: bool, last: bool) -> FragmentId ! OutOfMemoryError ? &mut Allocator {
    let index = self.count
    let mut previousSibling = NO_NODE
    let mut previousForBox = NO_NODE
    if parent != NO_NODE { previousSibling = self.values.asSlice()[parent].lastChild }
    if box != NO_NODE { previousForBox = self.lastByBox.get(box) }
    if index < self.values.length() {
      let values = self.values.asMutSlice()
      values[index] = Fragment.make(box, source, kind)
      self.textMarks.set(index, self.textCount)
    } else {
      run self.room()
      run self.values.append(Fragment.make(box, source, kind))
      run self.textMarks.append(self.textCount)
    }
    self.count = index + 1
    let values = self.values.asMutSlice()
    values[index].fragmentainer = fragmentainer
    values[index].parent = parent
    values[index].first = first
    values[index].last = last
    values[index].previousSibling = previousSibling
    values[index].previousForBox = previousForBox
    return self.linkAppended(index, parent, box, previousSibling, previousForBox)
  }
  effect fn putMade(self: &mut Self, box: usize, source: usize, kind: FragmentKind) -> usize ! OutOfMemoryError ? &mut Allocator {
    let index = self.count
    run self.saveFragment(index)
    if index < self.values.length() {
      let values = self.values.asMutSlice()
      values[index] = Fragment.make(box, source, kind)
      self.textMarks.set(index, self.textCount)
    } else {
      run self.room()
      run self.values.append(Fragment.make(box, source, kind))
      run self.textMarks.append(self.textCount)
    }
    self.count = index + 1
    if self.inPlace && self.count > self.written { self.written = self.count }
    return index
  }
  effect fn putText(self: &mut Self, value: LineText) -> usize ! OutOfMemoryError ? &mut Allocator {
    let index = self.textCount
    run self.saveText(index)
    if index < self.texts.length() { self.texts.set(index, value) }
    else {
      run self.textRoom()
      run self.texts.append(value)
    }
    self.textCount = index + 1
    if self.inPlace && self.textCount > self.textsWritten { self.textsWritten = self.textCount }
    return index
  }

  // The parent must already exist; box must be prepared or NO_NODE.
  // Arena-owned links replace incoming links. Geometry and content remain authored values.
  pub effect fn append(self: &mut Self, fragment: Fragment) -> FragmentId ! OutOfMemoryError ? &mut Allocator {
    self.plain = false
    let mut value = move fragment
    let parent = value.parent
    let box = value.box
    let next = self.count
    if box != NO_NODE { run self.claimBox(box, next) }
    if parent != NO_NODE { run self.editPosition(parent) }
    let mut previousSibling = NO_NODE
    let mut previousForBox = NO_NODE
    if parent != NO_NODE { previousSibling = self.values.asSlice()[parent].lastChild }
    if box != NO_NODE { previousForBox = self.lastByBox.get(box) }
    if previousSibling != NO_NODE { run self.editPosition(previousSibling) }
    if previousForBox != NO_NODE { run self.editPosition(previousForBox) }
    value.firstChild = NO_NODE
    value.lastChild = NO_NODE
    value.previousSibling = previousSibling
    value.nextSibling = NO_NODE
    value.previousForBox = previousForBox
    value.nextForBox = NO_NODE
    // Link only after allocation succeeds, leaving the arena unchanged on failure.
    run self.adopting(parent, previousForBox)
    let index = run self.put(move value)
    return self.linkAppended(index, parent, box, previousSibling, previousForBox)
  }
  // append for a new box fragment, built in its slot instead of moved there.
  pub effect fn appendBox(self: &mut Self, box: usize, source: usize, kind: FragmentKind, parent: usize, fragmentainer: usize, first: bool, last: bool) -> FragmentId ! OutOfMemoryError ? &mut Allocator {
    if kind != FragmentKind.Box || box == NO_NODE || (parent == NO_NODE && self.count != 0) { self.plain = false }
    if !self.inPlace && !self.viewing && !self.afterFlow { return run self.appendFresh(box, source, kind, parent, fragmentainer, first, last) }
    let next = self.count
    if box != NO_NODE { run self.claimBox(box, next) }
    if parent != NO_NODE { run self.editPosition(parent) }
    let mut previousSibling = NO_NODE
    let mut previousForBox = NO_NODE
    if parent != NO_NODE { previousSibling = self.values.asSlice()[parent].lastChild }
    if box != NO_NODE { previousForBox = self.lastByBox.get(box) }
    if previousSibling != NO_NODE { run self.editPosition(previousSibling) }
    if previousForBox != NO_NODE { run self.editPosition(previousForBox) }
    run self.adopting(parent, previousForBox)
    let index = run self.putMade(box, source, kind)
    let value = &mut self.values.asMutSlice()[index]
    value.fragmentainer = fragmentainer
    value.parent = parent
    value.first = first
    value.last = last
    value.previousSibling = previousSibling
    value.previousForBox = previousForBox
    return self.linkAppended(index, parent, box, previousSibling, previousForBox)
  }
  @inlineAlways
  fn linkAppended(self: &mut Self, index: usize, parent: usize, box: usize, previousSibling: usize, previousForBox: usize) -> FragmentId {
    let values = self.values.asMutSlice()
    if parent != NO_NODE {
      if previousSibling == NO_NODE { values[parent].firstChild = index }
      else { values[previousSibling].nextSibling = index }
      values[parent].lastChild = index
    }
    if box != NO_NODE {
      if previousForBox == NO_NODE { self.firstByBox.set(box, index) }
      else { values[previousForBox].nextForBox = index }
      self.lastByBox.set(box, index)
    }
    return FragmentId { index: index }
  }
  // Records normal-flow fragments that a fragment appended after the
  // normal flow links to.
  effect fn adopting(self: &mut Self, parent: usize, previousForBox: usize) ! OutOfMemoryError ? &mut Allocator {
    if !self.afterFlow { return }
    if parent != NO_NODE && parent < self.flowEnd { run self.adopted.append(parent) }
    if previousForBox != NO_NODE && previousForBox < self.flowEnd { run self.adopted.append(previousForBox) }
  }
  // Starts the normal flow over, after a rollback to the start.
  pub fn restartFlow(self: &mut Self) {
    self.afterFlow = false
    self.adopted.clear()
  }

  effect fn beginText(self: &mut Self, text: LineText) -> usize ! OutOfMemoryError ? &mut Allocator {
    // Reserve both arenas before publishing either half of the association.
    run self.room()
    run self.textRoom()
    run self.textMarks.reserve(1)
    return run self.putText(text)
  }

  // Appends a text fragment holding the one record `text`, shaped in font `fontKey`.
  pub effect fn appendText(self: &mut Self, fragment: Fragment, text: LineText, fontKey: usize) -> FragmentId ! OutOfMemoryError ? &mut Allocator {
    let mut value = fragment
    value.textData = run self.beginText(text)
    value.textCount = 1
    value.fontKey = usize.toU32(fontKey)
    return run self.append(value)
  }

  pub effect fn appendTextBox(self: &mut Self, box: usize, source: usize, parent: usize, fragmentainer: usize, text: LineText, fontKey: usize) -> FragmentId ! OutOfMemoryError ? &mut Allocator {
    let key = run self.beginText(text)
    let id = run self.appendBox(box, source, FragmentKind.Text, parent, fragmentainer, true, true)
    self.textMarks.set(id.index, key)
    let values = self.values.asMutSlice()
    values[id.index].textData = key
    values[id.index].textCount = 1
    values[id.index].fontKey = usize.toU32(fontKey)
    return id
  }

  // Whether text fragment `index` can take one more record (see extendText):
  // it is the last fragment written, by this compute, and its records the last.
  pub fn extendsText(self: &Self, index: usize) -> bool {
    if index == NO_NODE || index + 1 != self.count { return false }
    let value = &self.values.asSlice()[index]
    return value.kind == FragmentKind.Text && value.textData != NO_NODE && value.textData + u32.toUsize(value.textCount) == self.textCount
  }
  // Appends a record to text fragment `index` (see extendsText). Returns the record's index.
  pub effect fn extendText(self: &mut Self, index: usize, text: LineText) -> usize ! OutOfMemoryError ? &mut Allocator {
    run self.texts.reserve(1)
    let at = run self.putText(text)
    let values = self.values.asMutSlice()
    values[index].textCount = values[index].textCount + 1
    return at
  }
  // Whether text fragment `index` carries its line boxes (see LineText): its
  // first record is one.
  pub fn ownsLines(self: &Self, index: usize) -> bool {
    let value = &self.values.asSlice()[index]
    return value.kind == FragmentKind.Text && value.textData != NO_NODE && self.texts.asSlice()[value.textData].part != TEXT_RUN
  }
  // Moves the line boxes of text fragment `index` by `delta`, when it carries
  // them: its inline formatting box was placed.
  pub effect fn shiftLines(self: &mut Self, index: usize, delta: Point) ! OutOfMemoryError ? &mut Allocator {
    if !self.ownsLines(index) { return }
    run self.edit(index)
    let start = self.values.asSlice()[index].textData
    let end = start + u32.toUsize(self.values.asSlice()[index].textCount)
    let mut at = start
    while at < end {
      let part = self.texts.asSlice()[at].part
      if part == TEXT_LINE || part == TEXT_LINE_CONTINUED {
        run self.saveText(at)
        let texts = self.texts.asMutSlice()
        texts[at].location.x = texts[at].location.x + delta.x
        texts[at].location.y = texts[at].location.y + delta.y
      }
      at = at + 1
    }
  }
  // How many text records the fragments before `index` and fragment `index` hold.
  @inlineAlways
  fn textsThrough(self: &Self, index: usize) -> usize {
    let value = &self.values.asSlice()[index]
    if value.textData != NO_NODE { return value.textData + u32.toUsize(value.textCount) }
    return self.textMarks.get(index)
  }

  // No runs: a TextRuns to hold until there is a fragment to read.
  pub fn noTextRuns(self: &Self) -> TextRuns<'_> {
    let origin = Point { x: 0.0, y: 0.0 }
    return TextRuns {
      texts: self.texts.asSlice(), at: 0, end: 0, origin: origin, base: origin, lineLocation: origin, lineSize: Size.zero(), line: NO_NODE,
      current: PlacedText {
        sourceStart: 0, sourceEnd: 0, shapeKey: 0, fontKey: 0, bidiLevel: 0, kind: TextFragmentKind.Glyphs,
        location: origin, size: Size.zero(), lineLocation: origin, lineSize: Size.zero(), line: NO_NODE, record: NO_NODE,
      },
    }
  }
  // The runs of text fragment `index`, placed; none for any other fragment.
  // Read after resolveLocations, or with locations deferred (see worldLocation).
  pub fn textRuns(self: &Self, index: usize) -> TextRuns<'_> {
    let value = &self.values.asSlice()[index]
    let texts = self.texts.asSlice()
    let mut start: usize = 0
    let mut end: usize = 0
    if value.textData != NO_NODE {
      start = value.textData
      end = start + u32.toUsize(value.textCount)
    }
    let mut origin = Point { x: 0.0, y: 0.0 }
    if value.parent != NO_NODE { origin = self.worldLocation(value.parent) }
    let mut lineLocation = origin
    let mut lineSize = Size.zero()
    let mut line = NO_NODE
    if start < end && texts[start].part == TEXT_RUN {
      // The line box above, if the fragment is on one.
      let values = self.values.asSlice()
      let mut at = value.parent
      while at != NO_NODE && values[at].kind != FragmentKind.Line { at = values[at].parent }
      if at != NO_NODE {
        line = at
        lineLocation = self.worldLocation(at)
        lineSize = values[at].size
      }
    }
    return TextRuns {
      texts: texts, at: start, end: end, origin: origin, base: origin, lineLocation: lineLocation, lineSize: lineSize, line: line,
      current: PlacedText {
        sourceStart: 0, sourceEnd: 0, shapeKey: 0, fontKey: u32.toUsize(value.fontKey), bidiLevel: 0, kind: TextFragmentKind.Glyphs,
        location: origin, size: Size.zero(), lineLocation: origin, lineSize: Size.zero(), line: NO_NODE, record: NO_NODE,
      },
    }
  }

  pub fn checkpoint(self: &Self) -> usize { return self.count }
  pub fn textCheckpoint(self: &Self) -> usize { return self.textCount }

  // Undo appends in reverse order, including links held by surviving fragments.
  // This does not undo caller edits to geometry of fragments before the checkpoint.
  pub fn rollback(self: &mut Self, checkpoint: usize) {
    let mut index = self.count
    while index > checkpoint {
      index = index - 1
      let text = self.values.asSlice()[index].textData
      if text != NO_NODE { self.textCount = text }
      let parent = self.values.asSlice()[index].parent
      let previousSibling = self.values.asSlice()[index].previousSibling
      let box = self.values.asSlice()[index].box
      let previousForBox = self.values.asSlice()[index].previousForBox
      if parent != NO_NODE { self.editUnsaved(parent) }
      if previousSibling != NO_NODE { self.editUnsaved(previousSibling) }
      if previousForBox != NO_NODE { self.editUnsaved(previousForBox) }
      let values = self.values.asMutSlice()
      if parent != NO_NODE {
        values[parent].lastChild = previousSibling
        if previousSibling == NO_NODE { values[parent].firstChild = NO_NODE }
        else { values[previousSibling].nextSibling = NO_NODE }
      }
      if box != NO_NODE {
        self.lastByBox.set(box, previousForBox)
        if previousForBox == NO_NODE { self.firstByBox.set(box, NO_NODE) }
        else { values[previousForBox].nextForBox = NO_NODE }
      }
    }
    self.count = checkpoint
    if !self.inPlace {
      self.values.truncate(checkpoint)
      self.textMarks.truncate(checkpoint)
      self.texts.truncate(self.textCount)
    }
    let mut kept = self.settled.length()
    while kept > 0 && self.settled.get(kept - 1).end > checkpoint { kept = kept - 1 }
    self.settled.truncate(kept)
  }
  // After rollback(checkpoint): takes back the records extendText added,
  // since the checkpoint counted `texts` of them (see textCheckpoint), to the
  // text fragment the checkpoint left last. rollback undoes whole fragments;
  // a text fragment grows only while it is the last.
  pub fn rollbackTexts(self: &mut Self, texts: usize) {
    if self.textCount <= texts || self.count == 0 { return }
    let last = self.count - 1
    let values = self.values.asMutSlice()
    if values[last].textData == NO_NODE || values[last].textData >= texts { return }
    values[last].textCount = usize.toU32(texts - values[last].textData)
    self.textCount = texts
    if !self.inPlace { self.texts.truncate(texts) }
  }
  // Records that positioning may have given fragments visual offsets.
  pub fn offsetting(self: &mut Self) {
    self.offsets = true
    self.resolveAll = true
    self.copiesStand = false
  }
  // Leaves world locations and text first/last flags to the first
  // resolveLocations, so a compute whose output nobody reads in full skips
  // a walk over every fragment.
  pub fn deferLocations(self: &mut Self) { self.stale = true }
  // A fragment's final location relative to the initial containing block,
  // resolved or not.
  pub fn worldLocation(self: &Self, index: usize) -> Point {
    let values = self.values.asSlice()
    if !self.stale { return values[index].worldLocation }
    return locate(values, index)
  }
  // Parents precede children in the arena. Resolve final visual coordinates
  // once, rather than repeatedly walking ancestors for source-bound queries.
  // Readers of worldLocation, first or last call this first.
  pub fn resolveLocations(self: &mut Self) {
    self.stale = false
    // An output written afresh resolves every fragment but those of copied
    // ranges that stand (see `copiesStand`).
    let copies = self.copied && self.copiesStand
    let all = self.resolveAll && !copies
    self.resolveAll = false
    let mapped = self.mapped
    self.mapped = false
    self.resolvedAll = all
    // No compute wrote the output since the last resolveLocations: only
    // spliceFrom changed it, and resolved what it wrote. The rest stands.
    if !all && !mapped && self.carrySpliced() { return }
    self.carried.clear()
    let mut known = !all
    // Sort the few edits, in place.
    let edited = self.edited.asMutSlice()
    let mut at: usize = 1
    while at < edited.length {
      let value = edited[at]
      let mut to = at
      while to > 0 && edited[to - 1] > value {
        edited[to] = edited[to - 1]
        to = to - 1
      }
      edited[to] = value
      at = at + 1
    }
    let settled = self.settled.asSlice()
    let values = self.values.asMutSlice()
    let mut range: usize = 0
    let mut edit: usize = 0
    let mut index: usize = 0
    let mut visited: usize = 0
    let mut movedRanges: usize = 0
    let mut editedRanges: usize = 0
    while index < values.length {
      visited = visited + 1
      // Text ownership is finalized from accepted links. Speculative emission
      // must not clear a surviving earlier fragment's last flag. For a text
      // fragment that carries its lines, the links are its inline formatting
      // box's: first and last among that box's fragments.
      if values[index].kind == FragmentKind.Text && values[index].box != NO_NODE {
        values[index].first = values[index].previousForBox == NO_NODE
        values[index].last = values[index].nextForBox == NO_NODE
      }
      let parent = values[index].parent
      let mut x = values[index].location.x + values[index].visualOffset.x
      let mut y = values[index].location.y + values[index].visualOffset.y
      if parent != NO_NODE {
        x = x + values[parent].worldLocation.x
        y = y + values[parent].worldLocation.y
      }
      let moved = values[index].worldLocation.x != x || values[index].worldLocation.y != y
      values[index].worldLocation = Point { x: x, y: y }
      // A kept range whose root did not move and none of whose fragments
      // were edited keeps its world locations.
      if !all && !moved {
        while range < settled.length && settled[range].start < index { range = range + 1 }
        if range < settled.length && settled[range].start == index && (settled[range].kept || (copies && settled[range].from != NO_NODE)) {
          let end = settled[range].end
          while edit < edited.length && edited[edit] < index { edit = edit + 1 }
          // An edit of the range's first fragment leaves the rest as it was.
          // The layout that copies a range writes its first fragment again.
          let firstEdited = (edit < edited.length && edited[edit] == index) || !settled[range].kept
          while edit < edited.length && edited[edit] <= index { edit = edit + 1 }
          if (edit == edited.length || edited[edit] >= end) && !(self.editedLow < end && self.editedHigh > index) && !splicedIn(self.spliced.asSlice(), index, end) {
            let mut from = index
            if mapped { from = settled[range].from }
            if from != NO_NODE {
              let mut carry = Carry { to: index, from: from, length: end - index }
              if firstEdited { carry = Carry { to: index + 1, from: from + 1, length: end - index - 1 } }
              if carry.length != 0 && !self.carried.appendWithinCapacity(carry) { known = false }
            }
            index = end
            continue
          }
          editedRanges = editedRanges + 1
        }
      } else if !all {
        while range < settled.length && settled[range].start < index { range = range + 1 }
        if range < settled.length && settled[range].start == index { movedRanges = movedRanges + 1 }
      }
      index = index + 1
    }
    self.resolvedMoved = movedRanges
    self.resolvedEdited = editedRanges
    self.resolved = visited
    self.spliced.clear()
    self.carriedKnown = known
  }
  // Where a fragment of the previous output, now at `index` past the write
  // position, was when this compute began: every move of the previous
  // output so far moved it (see shiftPrevious).
  fn unshifted(self: &Self, index: usize) -> usize {
    let log = self.shiftLog.asSlice()
    let mut result = index
    let mut at = log.length
    while at > 0 {
      at = at - 1
      if log[at].up { result = result - log[at].by } else { result = result + log[at].by }
    }
    return result
  }
  // Makes room for resolveLocations to report every settled range and one more.
  effect fn reserveCarried(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    if self.carried.capacity() > self.settled.length() { return }
    self.carried.clear()
    run self.carried.reserve(self.settled.length() + 1)
  }
  // Makes room to record one more spliceFrom, and for resolveLocations to
  // report what stands around every one of them.
  pub effect fn reserveSplice(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    run self.spliced.reserve(2)
    self.carried.clear()
    run self.carried.reserve(self.spliced.length() / 2 + 2)
  }
  // resolveLocations for an output only spliceFrom changed: reports every
  // fragment outside the spliced ranges as standing where it stood. False,
  // with nothing reported, when there is no room for the report.
  fn carrySpliced(self: &mut Self) -> bool {
    let count = self.values.length()
    if self.carried.capacity() < self.spliced.length() / 2 + 1 { return false }
    // The few ranges, by where they start.
    let pairs = self.spliced.asMutSlice()
    let mut at: usize = 2
    while at + 1 < pairs.length {
      let start = pairs[at]
      let end = pairs[at + 1]
      let mut to = at
      while to > 0 && pairs[to - 2] > start {
        pairs[to] = pairs[to - 2]
        pairs[to + 1] = pairs[to - 1]
        to = to - 2
      }
      pairs[to] = start
      pairs[to + 1] = end
      at = at + 2
    }
    self.carried.clear()
    let mut visited: usize = 0
    let mut from: usize = 0
    at = 0
    while at + 1 < pairs.length {
      if pairs[at] > from { drop self.carried.appendWithinCapacity(Carry { to: from, from: from, length: pairs[at] - from }) }
      if pairs[at + 1] > from {
        let mut start = pairs[at]
        if start < from { start = from }
        visited = visited + (pairs[at + 1] - start)
        from = pairs[at + 1]
      }
      at = at + 2
    }
    if count > from { drop self.carried.appendWithinCapacity(Carry { to: from, from: from, length: count - from }) }
    self.resolved = visited
    self.spliced.clear()
    self.carriedKnown = true
    return true
  }


  // Moves the previous output from fragment `start` on, and its texts, to
  // the write position, so the previous ranges after a box that emitted more
  // or fewer fragments than before can be kept in place (canKeep) rather
  // than copied a fragment at a time. Previous indices at or after `start`
  // move by the returned shift; the caller moves those it holds (see
  // LayoutCache.shiftRanges). Returns a shift of 0 when it cannot.
  pub effect fn shiftPrevious(self: &mut Self, start: usize) -> Shift ! OutOfMemoryError ? &mut Allocator {
    let none = Shift { start: 0, up: false, by: 0 }
    if !self.inPlace || self.damaged || self.afterFlow || self.shifts == SHIFTS || start == self.count || start >= self.previousCount { return none }
    let total = self.previousCount
    // The first text of the moved fragments.
    let mut textStart = self.previousTexts
    let mut index = start
    while index < total && textStart == self.previousTexts {
      let data = self.previous(index).textData
      if data != NO_NODE { textStart = data }
      index = index + 1
    }
    if self.shiftUnsafe(start, textStart) {
      self.shiftsRefused = self.shiftsRefused + 1
      self.refusedNow = true
      return none
    }
    self.shifts = self.shifts + 1
    let shift = Shift.between(start, self.count)
    let textShift = Shift.between(textStart, self.textCount)
    let texts = self.previousTexts
    let movedTexts = texts - textStart
    let newTexts = textShift.apply(texts)
    if newTexts > self.texts.length() {
      let filler = self.previousText(textStart)
      let textsLength = self.texts.length()
      run self.texts.appendRepeated(filler, newTexts - textsLength)
    }
    if newTexts > self.textStamps.length() {
      let textStampsLength = self.textStamps.length()
      run self.textStamps.appendRepeated(0, newTexts - textStampsLength)
      let textSlotsLength = self.textSlots.length()
      run self.textSlots.appendRepeated(0, newTexts - textSlotsLength)
    }
    let generation = self.generation
    let mut step: usize = 0
    while step < movedTexts {
      let mut from = textStart + step
      if textShift.up { from = texts - 1 - step }
      let value = self.previousText(from)
      let to = textShift.apply(from)
      self.texts.set(to, value)
      self.textStamps.set(to, 0)
      step = step + 1
    }
    let moved = total - start
    let newTotal = shift.apply(total)
    if newTotal > self.values.length() {
      let filler = self.previous(start)
      let valuesLength = self.values.length()
      run self.values.appendRepeated(filler, newTotal - valuesLength)
      let textMarksLength = self.textMarks.length()
      run self.textMarks.appendRepeated(0, newTotal - textMarksLength)
    }
    if newTotal > self.fragmentStamps.length() {
      let fragmentStampsLength = self.fragmentStamps.length()
      run self.fragmentStamps.appendRepeated(0, newTotal - fragmentStampsLength)
      let fragmentSlotsLength = self.fragmentSlots.length()
      run self.fragmentSlots.appendRepeated(0, newTotal - fragmentSlotsLength)
    }
    // In place, field by field: a moved fragment is copied once.
    let values = self.values.asMutSlice()
    let saved = self.savedFragments.asSlice()
    let positions = self.savedPositions.asSlice()
    let stamps = self.fragmentStamps.asMutSlice()
    let slots = self.fragmentSlots.asSlice()
    step = 0
    while step < moved {
      let mut from = start + step
      if shift.up { from = total - 1 - step }
      let to = shift.apply(from)
      if stamps[from] == generation && slots[from] < PARTIAL_SLOT { values[to] = saved[slots[from]] }
      else {
        values[to] = values[from]
        if stamps[from] == generation { positions[slots[from] - PARTIAL_SLOT].restore(&mut values[to]) }
      }
      stamps[to] = 0
      let value = &mut values[to]
      value.parent = shift.apply(value.parent)
      value.firstChild = shift.apply(value.firstChild)
      value.lastChild = shift.apply(value.lastChild)
      value.previousSibling = shift.apply(value.previousSibling)
      value.nextSibling = shift.apply(value.nextSibling)
      value.previousForBox = shift.apply(value.previousForBox)
      value.nextForBox = shift.apply(value.nextForBox)
      value.textData = textShift.apply(value.textData)
      step = step + 1
    }
    // Text marks of the moved fragments, in order.
    let mut mark = self.textCount
    index = self.count
    while index < newTotal {
      self.textMarks.set(index, mark)
      if self.values.asSlice()[index].textData != NO_NODE { mark = mark + u32.toUsize(self.values.asSlice()[index].textCount) }
      index = index + 1
    }
    // Box chains that still name previous fragments.
    let mut box: usize = 0
    while box < self.firstByBox.length() {
      if self.boxStamps.get(box) == self.generation {
        let slot = self.boxSlots.get(box)
        let savedFirstValue = shift.apply(self.savedFirst.get(slot))
        self.savedFirst.set(slot, savedFirstValue)
        let savedLastValue = shift.apply(self.savedLast.get(slot))
        self.savedLast.set(slot, savedLastValue)
      } else {
        let firstByBoxValue = shift.apply(self.firstByBox.get(box))
        self.firstByBox.set(box, firstByBoxValue)
        let lastByBoxValue = shift.apply(self.lastByBox.get(box))
        self.lastByBox.set(box, lastByBoxValue)
      }
      box = box + 1
    }
    let adopted = self.previousAdopted.asMutSlice()
    index = 0
    while index < adopted.length {
      adopted[index] = shift.apply(adopted[index])
      index = index + 1
    }
    run self.shiftLog.append(shift)
    self.previousCount = newTotal
    self.previousTexts = newTexts
    if !shift.up { self.values.truncate(newTotal) }
    if !shift.up { self.textMarks.truncate(newTotal) }
    if !textShift.up { self.texts.truncate(newTexts) }
    // Past the write position lies only the previous output now.
    self.written = self.count
    self.textsWritten = self.textCount
    return shift
  }

  // Whether moving the previous output from fragment `start`, and its texts from
  // `textStart`, to the write position would lose what this compute still
  // needs (shiftPrevious then refuses, and the caller copies ranges instead):
  //
  // - Over previous fragments or texts of a box this compute has not laid
  //   out yet: fragments when the move is down, texts either way. Nothing saves what the move writes over, and the previous
  //   ranges in the span do not move with it, so such a box, kept or copied
  //   later (a structure change can put it after the moved ones), would read
  //   what the move left there. A box this compute laid out has claimed its
  //   chains (claimBox); a range kept in place lies before the write position.
  //   Fragments of boxes that are gone (NO_NODE after remapBoxes) count as not
  //   laid out: letting a move write over them fails the structure fuzz (5
  //   failures in 400 seeds), though which reader still needs them is not known.
  // - Up, past a range this compute kept in place: the move takes every
  //   fragment from `start` as previous output, and renumbers the box chains
  //   and links that name them, but the kept fragments are this compute's too
  //   and stay where they are, so their boxes would lose their chains.
  fn shiftUnsafe(self: &Self, start: usize, textStart: usize) -> bool {
    let settled = self.settled.asSlice()
    let mut at = settled.length
    while start < self.count && at > 0 {
      at = at - 1
      if settled[at].end <= start { at = 0 }
      else if settled[at].kept && settled[at].start < self.count { return true }
    }
    let generation = self.generation
    let stamps = self.boxStamps.asSlice()
    let mut index = self.count
    while index < start {
      let box = self.previous(index).box
      if box >= stamps.length || stamps[box] != generation { return true }
      index = index + 1
    }
    if textStart <= self.textCount { return false }
    // Texts in [textCount, textStart) belong to previous fragments before
    // `start` and before the write position (those between were checked
    // above): texts are in fragment order, so walk back until a fragment's
    // texts end before them.
    index = start
    if self.count < index { index = self.count }
    while index > 0 {
      index = index - 1
      let value = self.previous(index)
      if value.textData == NO_NODE { continue }
      if value.textData + u32.toUsize(value.textCount) <= self.textCount { return false }
      if value.box >= stamps.length || stamps[value.box] != generation { return true }
    }
    return false
  }

  // Whether the previous range [start, end) can stay where it is as the
  // next fragments: it starts at the write position, nothing of it or its
  // texts was overwritten, and nothing positioning appended links into it.
  @inlineAlways
  pub fn canKeep(self: &Self, start: usize, end: usize) -> bool {
    if !self.inPlace || self.damaged || start != self.count || start < self.written || end > self.previousCount || start >= end { return false }
    let firstText = self.textMarks.get(start)
    if firstText != self.textCount || firstText < self.textsWritten { return false }
    // The first adopted fragment at or after start.
    let adopted = self.previousAdopted.asSlice()
    let mut low: usize = 0
    let mut high = adopted.length
    while low < high {
      let middle = (low + high) / 2
      if adopted[middle] < start { low = middle + 1 } else { high = middle }
    }
    return low == adopted.length || adopted[low] >= end
  }
  // keepRange for the ranges of a run of siblings, adjacent in [start, end),
  // that followed the parent's last child as they stood: `lastStart` is the
  // first fragment of the last of them. False, with nothing kept, when they
  // no longer follow it.
  pub effect fn keepRun(self: &mut Self, start: usize, end: usize, lastStart: usize, parent: usize, adds: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
    let last = self.values.asSlice()[parent].lastChild
    let standing = self.values.asSlice()[start].parent == parent && self.values.asSlice()[start].previousSibling == last
      && (last == NO_NODE || self.values.asSlice()[last].nextSibling == start)
    if !standing { return false }
    run self.settled.reserve(1)
    run self.reserveCarried()
    let overflow = self.values.asSlice()[start].scrollableOverflow
    let texts = self.textsThrough(end - 1)
    self.count = end
    self.textCount = texts
    run self.editPosition(parent)
    let values = self.values.asMutSlice()
    if last == NO_NODE { values[parent].firstChild = start }
    values[parent].lastChild = lastStart
    let open = self.openSiblings.length()
    if open > 0 && self.openSiblings.get(open - 1) == last { self.openSiblings.truncate(open - 1) }
    if values[lastStart].nextSibling != NO_NODE { run self.openSiblings.append(lastStart) }
    let from = self.unshifted(start)
    run self.settled.append(SettledRange { start: start, end: end, overflow: overflow, kept: true, siblings: true, last: lastStart, adds: adds, from: from })
    return true
  }
  // Keeps the previous range [start, end) in place as the next fragments,
  // under `parent`, recorded as settled; see canKeep.
  @inlineAlways
  pub effect fn keepRange(self: &mut Self, start: usize, end: usize, parent: usize) ! OutOfMemoryError ? &mut Allocator {
    run self.settled.reserve(1)
    run self.reserveCarried()
    let overflow = self.values.asSlice()[start].scrollableOverflow
    let texts = self.textsThrough(end - 1)
    self.count = end
    self.textCount = texts
    // A range kept after the sibling it followed before keeps its own links:
    // only its parent's change, and its next-sibling link waits for the
    // next child, or closeSiblings.
    let last = if parent == NO_NODE { NO_NODE } else { self.values.asSlice()[parent].lastChild }
    let standing = parent != NO_NODE && self.values.asSlice()[start].parent == parent && self.values.asSlice()[start].previousSibling == last
      && (last == NO_NODE || self.values.asSlice()[last].nextSibling == start)
    if standing {
      run self.editPosition(parent)
      let values = self.values.asMutSlice()
      if last == NO_NODE { values[parent].firstChild = start }
      values[parent].lastChild = start
      // The sibling before, if it was open, is closed now.
      let open = self.openSiblings.length()
      if open > 0 && self.openSiblings.get(open - 1) == last { self.openSiblings.truncate(open - 1) }
      if values[start].nextSibling != NO_NODE { run self.openSiblings.append(start) }
    } else {
      run self.editPosition(start)
      let values = self.values.asMutSlice()
      values[start].parent = parent
      run self.linkParent(start)
    }
    let from = self.unshifted(start)
    run self.settled.append(SettledRange { start: start, end: end, overflow: overflow, kept: true, siblings: false, last: NO_NODE, adds: false, from: from })
  }
  // Ends the next-sibling links keepRange left open on fragments that stayed
  // their parent's last child.
  pub effect fn closeSiblings(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    let mut at: usize = 0
    while at < self.openSiblings.length() {
      let index = self.openSiblings.get(at)
      let parent = self.values.asSlice()[index].parent
      if index < self.count && parent != NO_NODE && self.values.asSlice()[index].nextSibling != NO_NODE && self.values.asSlice()[parent].lastChild == index {
        run self.editPosition(index)
        let values = self.values.asMutSlice()
        values[index].nextSibling = NO_NODE
      }
      at = at + 1
    }
    self.openSiblings.clear()
  }
  // Appends a copy of the previous range [start, end), as appendRange does
  // from another arena.
  pub effect fn copyPrevious(self: &mut Self, start: usize, end: usize, parent: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
    let base = self.count
    run self.settled.reserve(1)
    let mut index = start
    while index < end {
      let mut value = self.previous(index)
      if (index > start && (value.parent < start || value.parent >= index)) || (value.lastChild != NO_NODE && value.lastChild >= end) {
        self.rollback(base)
        return false
      }
      if value.textData != NO_NODE {
        let from = value.textData
        let records = u32.toUsize(value.textCount)
        value.textData = self.textCount
        let mut record: usize = 0
        while record < records {
          let text = self.previousText(from + record)
          drop run self.putText(text)
          record = record + 1
        }
      }
      value.visualOffset = Point { x: 0.0, y: 0.0 }
      value.worldLocation = Point { x: 0.0, y: 0.0 }
      let at = base + (index - start)
      if index == start { value.parent = parent }
      else {
        value.parent = base + (value.parent - start)
        if value.previousSibling != NO_NODE { value.previousSibling = base + (value.previousSibling - start) }
        if value.nextSibling != NO_NODE { value.nextSibling = base + (value.nextSibling - start) }
      }
      if value.firstChild != NO_NODE {
        value.firstChild = base + (value.firstChild - start)
        value.lastChild = base + (value.lastChild - start)
      }
      let put = run self.put(value)
      if index == start { run self.linkParent(at) }
      run self.linkBox(put)
      index = index + 1
    }
    let overflow = self.previous(start).scrollableOverflow
    let end = self.count
    run self.settled.append(SettledRange { start: base, end: end, overflow: overflow, kept: false, siblings: false, last: NO_NODE, adds: false, from: NO_NODE })
    return true
  }

  // Appends a copy of the source's fragments [start, end), whose parents all
  // lie inside the range except the first's, which becomes `parent`. Links
  // are rebuilt as append would; visual offsets and world locations reset.
  // The range is recorded as settled. Returns false, leaving the arena as it
  // was, when a link leaves the range: positioning appended a child after
  // the normal-flow fragments. Works in chunks small enough to stay cached
  // between checking, copying and relinking them. Not for in-place computes.
  pub effect fn appendRange(self: &mut Self, source: &FragmentArena, start: usize, end: usize, parent: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
    if !source.plain { self.plain = false }
    // Whether the copies keep the source's world locations (see `copiesStand`).
    let stands = !source.stale && !source.offsets
    self.copied = true
    if !stands { self.copiesStand = false }
    run self.reserveCarried()
    let base = self.values.length()
    let sourceValues = source.values.asSlice()
    let sourceTexts = source.texts.asSlice()
    run self.values.reserve(end - start)
    run self.textMarks.reserve(end - start)
    run self.settled.reserve(1)
    let mut chunk = start
    while chunk < end {
      let mut stop = chunk + RANGE_CHUNK
      if stop > end { stop = end }
      // Text records of a laid-out range are usually contiguous: copy them in
      // one piece and shift indices, else one by one.
      let mut texts: usize = 0
      let mut firstText = NO_NODE
      let mut lastText: usize = 0
      let mut ordered = true
      let mut index = chunk
      while index < stop {
        let from = &sourceValues[index]
        if (index > start && (from.parent < start || from.parent >= index)) || (from.lastChild != NO_NODE && from.lastChild >= end) {
          self.rollback(base)
          return false
        }
        let text = from.textData
        if text != NO_NODE {
          let records = u32.toUsize(from.textCount)
          if firstText == NO_NODE { firstText = text }
          else if text != lastText + 1 { ordered = false }
          lastText = text + records - 1
          texts = texts + records
        }
        index = index + 1
      }
      run self.texts.reserve(texts)
      let at0 = self.values.length()
      run self.values.appendSlice(Slice.view(sourceValues, chunk, stop - chunk))
      let textBase = self.texts.length()
      let bulk = texts != 0 && ordered
      if bulk { run self.texts.appendSlice(Slice.view(sourceTexts, firstText, texts)) }
      let mut at = at0
      let last = at0 + (stop - chunk)
      let mut seen: usize = 0
      while at < last {
        let values = self.values.asMutSlice()
        values[at].visualOffset = Point { x: 0.0, y: 0.0 }
        if !stands { values[at].worldLocation = Point { x: 0.0, y: 0.0 } }
        if values[at].textData != NO_NODE {
          let records = u32.toUsize(values[at].textCount)
          if bulk {
            run self.textMarks.append(textBase + seen)
            values[at].textData = textBase + (values[at].textData - firstText)
            seen = seen + records
          } else {
            let from = values[at].textData
            run self.textMarks.append(self.texts.length())
            values[at].textData = self.texts.length()
            run self.texts.appendSlice(Slice.view(sourceTexts, from, records))
          }
        } else if bulk { run self.textMarks.append(textBase + seen) }
        else { run self.textMarks.append(self.texts.length()) }
        let linked = self.values.asMutSlice()
        if at == base {
          linked[at].parent = parent
          if linked[at].firstChild != NO_NODE {
            linked[at].firstChild = base + (linked[at].firstChild - start)
            linked[at].lastChild = base + (linked[at].lastChild - start)
          }
          run self.linkParent(at)
        } else {
          // Every link but the root's own sibling links stays in the range.
          linked[at].parent = base + (linked[at].parent - start)
          if linked[at].firstChild != NO_NODE {
            linked[at].firstChild = base + (linked[at].firstChild - start)
            linked[at].lastChild = base + (linked[at].lastChild - start)
          }
          if linked[at].previousSibling != NO_NODE { linked[at].previousSibling = base + (linked[at].previousSibling - start) }
          if linked[at].nextSibling != NO_NODE { linked[at].nextSibling = base + (linked[at].nextSibling - start) }
        }
        run self.linkBox(at)
        at = at + 1
      }
      self.count = self.values.length()
      self.textCount = self.texts.length()
      chunk = stop
    }
    let mut from = NO_NODE
    if stands { from = start }
    run self.settled.append(SettledRange { start: base, end: base + (end - start), overflow: sourceValues[start].scrollableOverflow, kept: false, siblings: false, last: NO_NODE, adds: false, from: from })
    return true
  }
  // Links an appended range's first fragment after its parent's last child.
  @inlineAlways
  effect fn linkParent(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    let parent = self.values.asSlice()[index].parent
    let mut previousSibling = NO_NODE
    if parent != NO_NODE {
      run self.editPosition(parent)
      previousSibling = self.values.asSlice()[parent].lastChild
      if previousSibling != NO_NODE && self.values.asSlice()[previousSibling].nextSibling != index { run self.editPosition(previousSibling) }
    }
    let values = self.values.asMutSlice()
    values[index].previousSibling = previousSibling
    values[index].nextSibling = NO_NODE
    if parent != NO_NODE {
      if previousSibling == NO_NODE { values[parent].firstChild = index }
      else { values[previousSibling].nextSibling = index }
      values[parent].lastChild = index
    }
  }
  // Appends a fragment to its box's fragment list.
  effect fn linkBox(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    let box = self.values.asSlice()[index].box
    if box == NO_NODE {
      let values = self.values.asMutSlice()
      values[index].nextForBox = NO_NODE
      values[index].previousForBox = NO_NODE
      return
    }
    run self.claimBox(box, index)
    let previousForBox = self.lastByBox.get(box)
    if previousForBox != NO_NODE { run self.editPosition(previousForBox) }
    let values = self.values.asMutSlice()
    values[index].nextForBox = NO_NODE
    values[index].previousForBox = previousForBox
    if previousForBox == NO_NODE { self.firstByBox.set(box, index) }
    else { values[previousForBox].nextForBox = index }
    self.lastByBox.set(box, index)
  }

  // Renumbers the boxes fragments belong to: `toNew[old]` is a box's new
  // index or NO_NODE, `toOld[new]` the reverse.
  pub effect fn remapBoxes(self: &mut Self, toOld: &[usize], toNew: &[usize]) ! OutOfMemoryError ? &mut Allocator {
    let values = self.values.asMutSlice()
    let mut index: usize = 0
    while index < values.length {
      let box = values[index].box
      if box != NO_NODE {
        // Most boxes keep their number: those are read, not written.
        let mut to = NO_NODE
        if box < toNew.length { to = toNew[box] }
        if to != box { values[index].box = to }
      }
      index = index + 1
    }
    let mut first = List<usize>.make()
    let mut last = List<usize>.make()
    run first.reserveExact(toOld.length)
    run last.reserveExact(toOld.length)
    let mut id: usize = 0
    while id < toOld.length {
      let from = toOld[id]
      if from != NO_NODE && from < self.firstByBox.length() {
        run first.append(self.firstByBox.get(from))
        run last.append(self.lastByBox.get(from))
      } else {
        run first.append(NO_NODE)
        run last.append(NO_NODE)
      }
      id = id + 1
    }
    self.firstByBox = move first
    self.lastByBox = move last
  }

  // remapBoxes for a patch of the box tree that kept every box's id but
  // those of `ids`, whose fragments now belong to no box, over `count` boxes.
  pub effect fn forgetBoxes(self: &mut Self, ids: &[usize], count: usize) ! OutOfMemoryError ? &mut Allocator {
    let mut at: usize = 0
    while at < ids.length {
      let id = ids[at]
      at = at + 1
      if id >= self.firstByBox.length() { continue }
      let mut index = self.firstByBox.get(id)
      let values = self.values.asMutSlice()
      while index != NO_NODE && index < values.length && values[index].box == id {
        values[index].box = NO_NODE
        index = values[index].nextForBox
      }
      self.firstByBox.set(id, NO_NODE)
      self.lastByBox.set(id, NO_NODE)
    }
    if self.firstByBox.length() < count {
      let added = count - self.firstByBox.length()
      run self.firstByBox.appendRepeated(NO_NODE, added)
      run self.lastByBox.appendRepeated(NO_NODE, added)
    }
  }

  pub fn boxCount(self: &Self) -> usize { return self.firstByBox.length() }
  // Whether a whole output stands: between computes, so the next can work
  // in place over it (see beginInPlace).
  pub fn complete(self: &Self) -> bool {
    return !self.inPlace && self.values.length() != 0 && self.count == self.values.length() && self.textCount == self.texts.length()
  }
  // Whether a whole output stands, with no visual offsets: between computes.
  pub fn settledOutput(self: &Self) -> bool {
    return !self.inPlace && !self.offsets && self.count == self.values.length() && self.textCount == self.texts.length()
  }
  // How many texts the fragments before `index` hold.
  pub fn textsBefore(self: &Self, index: usize) -> usize {
    if index < self.textMarks.length() { return self.textMarks.get(index) }
    return self.texts.length()
  }
  // Replaces the output's fragments [start, end) with all of `source`'s, a
  // layout of the same subtree alone that emitted as many fragments and
  // texts. The first keeps its place among its siblings and its location;
  // world locations follow from it. Between computes only (settledOutput).
  pub fn spliceFrom(self: &mut Self, start: usize, end: usize, source: &FragmentArena) {
    // Parents' world locations may be out of date.
    if self.stale { self.resolveAll = true }
    // The replaced fragments no longer stand as resolveLocations last saw them.
    if !self.spliced.appendWithinCapacity(start) || !self.spliced.appendWithinCapacity(end) { self.resolveAll = true }
    let firstText = self.textsBefore(start)
    let values = self.values.asMutSlice()
    let from = source.values.asSlice()
    // The boxes of the old fragments lose their chains; the new ones set them.
    let mut index = start
    while index < end {
      let box = values[index].box
      if box != NO_NODE {
        self.firstByBox.set(box, NO_NODE)
        self.lastByBox.set(box, NO_NODE)
      }
      index = index + 1
    }
    let root = values[start]
    index = start
    while index < end {
      let mut value = from[index - start]
      if index == start {
        value.parent = root.parent
        value.previousSibling = root.previousSibling
        value.nextSibling = root.nextSibling
        value.location = root.location
      } else {
        value.parent = value.parent + start
        if value.previousSibling != NO_NODE { value.previousSibling = value.previousSibling + start }
        if value.nextSibling != NO_NODE { value.nextSibling = value.nextSibling + start }
      }
      if value.firstChild != NO_NODE {
        value.firstChild = value.firstChild + start
        value.lastChild = value.lastChild + start
      }
      if value.previousForBox != NO_NODE { value.previousForBox = value.previousForBox + start }
      if value.nextForBox != NO_NODE { value.nextForBox = value.nextForBox + start }
      if value.textData != NO_NODE { value.textData = value.textData + firstText }
      if value.kind == FragmentKind.Text && value.box != NO_NODE {
        value.first = value.previousForBox == NO_NODE
        value.last = value.nextForBox == NO_NODE
      }
      let mut x = value.location.x + value.visualOffset.x
      let mut y = value.location.y + value.visualOffset.y
      if value.parent != NO_NODE {
        x = x + values[value.parent].worldLocation.x
        y = y + values[value.parent].worldLocation.y
      }
      value.worldLocation = Point { x: x, y: y }
      if value.box != NO_NODE {
        if value.previousForBox == NO_NODE { self.firstByBox.set(value.box, index) }
        if value.nextForBox == NO_NODE { self.lastByBox.set(value.box, index) }
      }
      values[index] = value
      self.textMarks.set(index, firstText + source.textMarks.get(index - start))
      index = index + 1
    }
    let texts = self.texts.asMutSlice()
    let fromTexts = source.texts.asSlice()
    let mut text: usize = 0
    while text < fromTexts.length {
      texts[firstText + text] = fromTexts[text]
      text = text + 1
    }
  }
  // A box's first and last fragments of this compute so far, or NO_NODE.
  // The chains of a box this compute has not reached still name previous
  // fragments, which are not the box's unless kept.
  pub fn first(self: &Self, box: usize) -> usize { return self.current(box, self.firstByBox.get(box)) }
  pub fn last(self: &Self, box: usize) -> usize { return self.current(box, self.lastByBox.get(box)) }
  fn current(self: &Self, box: usize, index: usize) -> usize {
    if index == NO_NODE || index >= self.count || self.values.asSlice()[index].box != box { return NO_NODE }
    return index
  }
  pub fn get(self: &Self, id: FragmentId) -> &Fragment { return &self.values.asSlice()[id.index] }
}

pub const NO_NODE: usize = usize.MAX
pub struct NodeId { pub index: usize }
impl Copy for NodeId {}
pub struct BoxId { pub index: usize }
impl Copy for BoxId {}
pub struct InvalidBox { pub index: usize }
impl Copy for InvalidBox {}
impl Debug for InvalidBox {
  effect fn debug(self: &Self, formatter: &mut Formatter) ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "InvalidBox", &mut formatter)
  }
}
pub struct InvalidNode { pub index: usize }
impl Copy for InvalidNode {}
impl Debug for InvalidNode {
  effect fn debug(self: &Self, formatter: &mut Formatter) ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "InvalidNode", &mut formatter)
  }
}
pub enum Measurement { None, Content, Natural }
pub union SourceContent { Element, Text { pub value: String } }
pub struct Node {
  pub styleIndex: usize, pub content: SourceContent,
  pub parent: usize, pub firstChild: usize, pub lastChild: usize, pub nextSibling: usize, pub previousSibling: usize,
  pub measureKey: usize, pub measurement: Measurement,
  pub scrollOffset: Point,
  // Leading text bytes another box lays out (a host's ::first-letter); offsets stay the text's.
  pub textStart: usize,
}
impl Node {
  pub fn text<'a>(self: &'a Self) -> Option<string<'a>> {
    return match &self.content {
      SourceContent.Text { value } => Option<string<'a>>.Some { value: String.view(&value) }
      SourceContent.Element => Option<string<'a>>.None
    }
  }
  /// The text this node lays out: all of it after `textStart`.
  pub fn laidText<'a>(self: &'a Self) -> Option<string<'a>> {
    return match &self.content {
      SourceContent.Text { value } => {
        let full = String.view(&value)
        let length = String.byteLength(full)
        let start = if self.textStart < length { self.textStart } else { length }
        Option<string<'a>>.Some { value: String.slice(full, start, length - start) }
      }
      SourceContent.Element => Option<string<'a>>.None
    }
  }
  pub fn isText(self: &Self) -> bool {
    return match &self.content {
      SourceContent.Text { value: _ } => true
      SourceContent.Element => false
    }
  }
}
// A box whose early cutoff failed `failures` times in a row; it is not
// laid out alone again for the next `skip` computes.
pub struct CutoffMiss { pub box: usize, pub failures: usize, pub skip: usize }
impl Copy for CutoffMiss {}

// css-layout's own source tree (see source.silk). Every change made through
// Tree's methods is recorded in `changes`, so a LayoutTree can find what
// changed since it last computed. Code that edits `nodes`, `styles`, or owned
// grid data directly must call `markDirty`. Handles and interned name IDs
// remain local to this tree.
pub struct Tree {
  pub nodes: List<Node>, pub styles: List<Style>, pub viewportScrollOffset: Point,
  // Whether sticky boxes stay at their normal position, for an embedder that applies scroll
  // offsets and sticky offsets itself while drawing (so scrolling needs no layout).
  pub stickyDeferred: bool,
  // Slot zero is the default. Each nonzero slot belongs to one element and is
  // replaced in place; styles cannot transfer ownership by copying a handle.
  pub grids: List<GridTemplate>, pub gridNames: List<String>,
  pub changes: Changes,
  // Whether each slot of `nodes` holds a node; destroy frees a slot and
  // create takes the last freed one. Freed element style slots and grid
  // slots are reused the same way.
  live: List<bool>, freeNodes: List<usize>, freeStyles: List<usize>, freeGrids: List<usize>,
  // `shape-outside` areas, owned like `grids`: slot zero is none.
  pub shapes: List<FloatShape>, freeShapes: List<usize>,
  // Whether a style with `wrap-flow` other than auto was ever set: only then does
  // compute look for exclusions (see exclusions.silk).
  pub exclusionStyles: bool,
}
impl LayoutSource for Tree {
  @inlineAlways
  fn nodeCount(self: &Self) -> usize { return self.nodes.length() }
  @inlineAlways
  fn exists(self: &Self, node: usize) -> bool { return node < self.nodes.length() && self.live.get(node) }
  @inlineAlways
  fn parent(self: &Self, node: usize) -> usize { return self.nodes.asSlice()[node].parent }
  @inlineAlways
  fn firstChild(self: &Self, node: usize) -> usize { return self.nodes.asSlice()[node].firstChild }
  @inlineAlways
  fn nextSibling(self: &Self, node: usize) -> usize { return self.nodes.asSlice()[node].nextSibling }
  @inlineAlways
  fn styles<'a>(self: &'a Self) -> &'a [Style] { return self.styles.asSlice() }
  @inlineAlways
  fn styleIndex(self: &Self, node: usize) -> usize { return self.nodes.asSlice()[node].styleIndex }
  @inlineAlways
  fn isText(self: &Self, node: usize) -> bool { return self.nodes.asSlice()[node].isText() }
  fn text<'a>(self: &'a Self, node: usize) -> Option<string<'a>> { return self.nodes.asSlice()[node].text() }
  @inlineAlways
  fn textStart(self: &Self, node: usize) -> usize { return self.nodes.asSlice()[node].textStart }
  @inlineAlways
  fn measurement(self: &Self, node: usize) -> Measurement { return self.nodes.asSlice()[node].measurement }
  @inlineAlways
  fn measureKey(self: &Self, node: usize) -> usize { return self.nodes.asSlice()[node].measureKey }
  @inlineAlways
  fn scrollOffset(self: &Self, node: usize) -> Point { return self.nodes.asSlice()[node].scrollOffset }
  fn viewportScrollOffset(self: &Self) -> Point { return self.viewportScrollOffset }
  fn stickyDeferred(self: &Self) -> bool { return self.stickyDeferred }
  fn exclusionStyles(self: &Self) -> bool { return self.exclusionStyles }
  fn grids<'a>(self: &'a Self) -> &'a [GridTemplate] { return self.grids.asSlice() }
  fn gridNames<'a>(self: &'a Self) -> &'a [String] { return self.gridNames.asSlice() }
  fn shapes<'a>(self: &'a Self) -> &'a [FloatShape] { return self.shapes.asSlice() }
  @inlineAlways
  fn changes<'a>(self: &'a Self) -> &'a Changes { return &self.changes }
}
impl Tree {
  // What the tree holds, for the bench census (see properties.census).
  pub effect fn census(self: &Self, out: &mut Census) ! OutOfMemoryError ? &mut Allocator {
    let u = Intrinsic.layoutOf<usize>().bytes
    run out.held("css.tree.nodes", self.nodes.length(), self.nodes.capacity(), Intrinsic.layoutOf<Node>().bytes)
    let mut texts: usize = 0
    let mut textBytes: usize = 0
    let mut textRoom: usize = 0
    let mut liveNodes: usize = 0
    let mut at: usize = 0
    while at < self.nodes.length() {
      if self.live.asSlice()[at] { liveNodes = liveNodes + 1 }
      match &self.nodes.asSlice()[at].content {
        SourceContent.Text { value } => {
          texts = texts + 1
          textBytes = textBytes + String.utf8Bytes(String.view(&value)).length
          textRoom = textRoom + value.capacity()
        }
        SourceContent.Element => {}
      }
      at = at + 1
    }
    run out.unit("css.tree.live-nodes", liveNodes)
    run out.unit("css.tree.text-nodes", texts)
    run out.bytes("css.tree.nodes.text-bytes", textBytes, textRoom)
    run out.held("css.tree.styles", self.styles.length(), self.styles.capacity(), Intrinsic.layoutOf<Style>().bytes)
    run out.held("css.tree.grids", self.grids.length(), self.grids.capacity(), Intrinsic.layoutOf<GridTemplate>().bytes)
    run out.held("css.tree.grid-names", self.gridNames.length(), self.gridNames.capacity(), Intrinsic.layoutOf<String>().bytes)
    run out.held("css.tree.shapes", self.shapes.length(), self.shapes.capacity(), Intrinsic.layoutOf<FloatShape>().bytes)
    run self.changes.census(&mut out)
    run out.held("css.tree.live", self.live.length(), self.live.capacity(), 1)
    run out.held("css.tree.free-lists", self.freeNodes.length() + self.freeStyles.length() + self.freeGrids.length() + self.freeShapes.length(),
      self.freeNodes.capacity() + self.freeStyles.capacity() + self.freeGrids.capacity() + self.freeShapes.capacity(), u)
  }
  pub effect fn make(style: Style) -> Tree ! OutOfMemoryError ? &mut Allocator {
    let mut nodes = List<Node>.make()
    let mut styles = List<Style>.make()
    let mut value = move style
    value.grid = 0
    value.shape = 0
    let exclusionStyles = value.wrapFlow != WrapFlow.Auto
    let mut shapes = List<FloatShape>.make()
    run shapes.append(FloatShape.make())
    let mut grids = List<GridTemplate>.make()
    run grids.append(GridTemplate.make())
    let mut gridNames = List<String>.make()
    run gridNames.append(run String.copy(""))
    run nodes.reserve(1)
    run styles.reserve(1)
    run styles.append(move value)
    run nodes.append(Node { styleIndex: 0, content: SourceContent.Element, parent: NO_NODE, firstChild: NO_NODE, lastChild: NO_NODE, nextSibling: NO_NODE, previousSibling: NO_NODE, measureKey: 0, measurement: Measurement.None, scrollOffset: Point { x: 0.0, y: 0.0 }, textStart: 0 })
    let changes = run Changes.make()
    let mut live = List<bool>.make()
    run live.append(true)
    return Tree { nodes: move nodes, styles: move styles, grids: move grids, gridNames: move gridNames, viewportScrollOffset: Point { x: 0.0, y: 0.0 }, stickyDeferred: false, changes: move changes, live: move live, freeNodes: List<usize>.make(), freeStyles: List<usize>.make(), freeGrids: List<usize>.make(), shapes: move shapes, freeShapes: List<usize>.make(), exclusionStyles: exclusionStyles }
  }
  // The current revision; it advances on every change (see Changes).
  pub fn revision(self: &Self) -> usize { return self.changes.revision() }
  pub fn structureRevision(self: &Self) -> usize { return self.changes.structureRevision() }
  pub fn boxRevision(self: &Self) -> usize { return self.changes.boxRevision() }
  pub fn changedAt(self: &Self, id: usize) -> usize { return self.changes.changedAt(id) }
  pub fn outerChangedAt(self: &Self, id: usize) -> usize { return self.changes.outerChangedAt(id) }
  pub fn insetsChangedAt(self: &Self, id: usize) -> usize { return self.changes.insetsChangedAt(id) }
  pub fn placedChangedAt(self: &Self, id: usize) -> usize { return self.changes.placedChangedAt(id) }
  pub fn scrollRevision(self: &Self) -> usize { return self.changes.scrollRevision() }
  pub fn markRevision(self: &Self) -> usize { return self.changes.markRevision() }
  pub effect fn changedNodes(self: &Self, since: usize, result: &mut List<usize>) -> bool ! OutOfMemoryError ? &mut Allocator {
    return run self.changes.changedNodes(since, &mut result)
  }
  pub effect fn touchedNodes(self: &Self, since: usize, result: &mut List<usize>) -> bool ! OutOfMemoryError ? &mut Allocator {
    return run self.changes.touchedNodes(since, &mut result)
  }
  pub effect fn generationChanges(self: &Self, since: usize, result: &mut List<usize>) -> bool ! OutOfMemoryError ? &mut Allocator {
    return run self.changes.generationChanges(since, &mut result)
  }
  pub effect fn scrolledNodes(self: &Self, since: usize, result: &mut List<usize>) -> bool ! OutOfMemoryError ? &mut Allocator {
    return run self.changes.scrolledNodes(since, &mut result)
  }
  // Records a change the tree cannot see: a direct edit of `nodes` or
  // `styles`, or new content behind a node's measurement key. Layout results
  // that depend on the node are recomputed by the next compute.
  pub effect fn markDirty(self: &mut Self, id: NodeId) ! InvalidNode {
    if !self.contains(id) { fail InvalidNode { index: id.index } }
    self.changes.marked(id.index)
  }
  pub effect fn internGridName(self: &mut Self, name: string) -> usize ! GridError | OutOfMemoryError ? &mut Allocator {
    if !validGridName(name) { fail GridError {} }
    return run self.internName(name)
  }
  pub effect fn internGridAreaName(self: &mut Self, name: string) -> usize ! GridError | OutOfMemoryError ? &mut Allocator {
    if !validGridAreaName(name) { fail GridError {} }
    return run self.internName(name)
  }
  effect fn internName(self: &mut Self, name: string) -> usize ! OutOfMemoryError ? &mut Allocator {
    let mut index: usize = 1
    while index < self.gridNames.length() {
      if String.view(&self.gridNames.asSlice()[index]) == name { return index }
      index = index + 1
    }
    run self.gridNames.append(run String.copy(name))
    return index
  }
  // Empty lists mean the initial auto tracks/none template. Replacing a slot
  // drops all its old owned lists without growing the table on each restyle.
  pub effect fn setGrid(self: &mut Self, id: NodeId, template: GridTemplate) ! InvalidNode | GridError | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.nodes.asSlice()[id.index].isText() { fail InvalidNode { index: id.index } }
    if !template.valid(self.gridNames.length()) { fail GridError {} }
    let styleIndex = self.nodes.asSlice()[id.index].styleIndex
    let handle = self.styles.asSlice()[styleIndex].grid
    if handle == 0 && template.isInitial() {
      self.changes.innerChanged(id.index)
      return
    }
    let old = &self.grids.asSlice()[handle]
    // Subgrid metadata affects its parent's placement and descendant track
    // contributions even when the item's outer dimensions stay unchanged.
    let outer = !old.placement.same(&template.placement)
      || old.rows.subgrid || old.columns.subgrid
      || template.rows.subgrid || template.columns.subgrid
    let same = old.same(&template)
    // The grid the node already has leaves it clean, as an unchanged style does.
    if same && !outer { return }
    if handle == 0 && self.freeGrids.length() != 0 {
      let slot = self.freeGrids.get(self.freeGrids.length() - 1)
      let remaining = self.freeGrids.length() - 1
      self.freeGrids.truncate(remaining)
      let grids = self.grids.asMutSlice()
      grids[slot] = move template
      let styles = self.styles.asMutSlice()
      styles[styleIndex].grid = slot
    } else if handle == 0 {
      let slot = self.grids.length()
      run self.grids.append(move template)
      let styles = self.styles.asMutSlice()
      styles[styleIndex].grid = slot
    } else {
      let grids = self.grids.asMutSlice()
      grids[handle] = move template
    }
    self.changes.gridChanged(id.index, !same, outer)
  }
  // Replaces the `shape-outside` area of a float (CSS Shapes 1 §3.1). A float's
  // area is what lines beside it wrap around, so a change is one its parent sees.
  pub effect fn setShape(self: &mut Self, id: NodeId, shape: &FloatShape) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.nodes.asSlice()[id.index].isText() { fail InvalidNode { index: id.index } }
    let styleIndex = self.nodes.asSlice()[id.index].styleIndex
    let handle = u32.toUsize(self.styles.asSlice()[styleIndex].shape)
    if self.shapes.asSlice()[handle].same(shape) { return }
    let value = run shape.copy()
    if handle != 0 {
      let shapes = self.shapes.asMutSlice()
      shapes[handle] = move value
    } else if self.freeShapes.length() != 0 {
      let slot = self.freeShapes.get(self.freeShapes.length() - 1)
      let remaining = self.freeShapes.length() - 1
      self.freeShapes.truncate(remaining)
      let shapes = self.shapes.asMutSlice()
      shapes[slot] = move value
      let styles = self.styles.asMutSlice()
      styles[styleIndex].shape = usize.toU32(slot)
    } else {
      let slot = self.shapes.length()
      run self.shapes.append(move value)
      let styles = self.styles.asMutSlice()
      styles[styleIndex].shape = usize.toU32(slot)
    }
    self.changes.shapeChanged(id.index)
  }
  pub fn root(self: &Self) -> NodeId { return NodeId { index: 0 } }
  // Whether `id` names a node: one in range that destroy has not freed.
  pub fn contains(self: &Self, id: NodeId) -> bool {
    return id.index < self.nodes.length() && self.live.get(id.index)
  }
  // Whether `id` is the root or a node with a parent chain up to it.
  pub fn attached(self: &Self, id: NodeId) -> bool {
    if !self.contains(id) { return false }
    let nodes = self.nodes.asSlice()
    let mut at = id.index
    while nodes[at].parent != NO_NODE { at = nodes[at].parent }
    return at == 0
  }
  // Appends an element as the parent's last child.
  pub effect fn append(self: &mut Self, parent: NodeId, style: Style) -> NodeId ! OutOfMemoryError | InvalidNode ? &mut Allocator {
    if !self.canParent(parent) { fail InvalidNode { index: parent.index } }
    let id = run self.create(move style)
    run self.insertBefore(parent, id, Option<NodeId>.None)
    return id
  }
  // Appends a text node as the parent's last child.
  pub effect fn appendText(self: &mut Self, parent: NodeId, value: String) -> NodeId ! OutOfMemoryError | InvalidNode ? &mut Allocator {
    if !self.canParent(parent) { fail InvalidNode { index: parent.index } }
    let id = run self.createText(move value)
    run self.insertBefore(parent, id, Option<NodeId>.None)
    return id
  }
  fn canParent(self: &Self, parent: NodeId) -> bool {
    if !self.contains(parent) { return false }
    let node = &self.nodes.asSlice()[parent.index]
    return !node.isText() && node.measurement == Measurement.None
  }
  // Makes an element outside the tree, for insertBefore to attach. Its id is
  // the slot destroy freed last, if any.
  pub effect fn create(self: &mut Self, style: Style) -> NodeId ! OutOfMemoryError ? &mut Allocator {
    let mut value = move style
    value.grid = 0
    value.shape = 0
    if value.wrapFlow != WrapFlow.Auto { self.exclusionStyles = true }
    // Reserve every arena before publishing any entry.
    run self.reserveSlot()
    if self.freeStyles.length() == 0 { run self.styles.reserve(1) }
    let mut styleIndex = self.styles.length()
    if self.freeStyles.length() != 0 {
      styleIndex = self.freeStyles.get(self.freeStyles.length() - 1)
      let remaining = self.freeStyles.length() - 1
      self.freeStyles.truncate(remaining)
      let styles = self.styles.asMutSlice()
      styles[styleIndex] = move value
    } else {
      run self.styles.append(move value)
    }
    let index = run self.publish(Node { styleIndex: styleIndex, content: SourceContent.Element, parent: NO_NODE, firstChild: NO_NODE, lastChild: NO_NODE, nextSibling: NO_NODE, previousSibling: NO_NODE, measureKey: 0, measurement: Measurement.None, scrollOffset: Point { x: 0.0, y: 0.0 }, textStart: 0 })
    return NodeId { index: index }
  }
  // Makes a text node outside the tree. It takes its parent's style once
  // attached.
  pub effect fn createText(self: &mut Self, value: String) -> NodeId ! OutOfMemoryError ? &mut Allocator {
    run self.reserveSlot()
    let index = run self.publish(Node { styleIndex: 0, content: SourceContent.Text { value: move value }, parent: NO_NODE, firstChild: NO_NODE, lastChild: NO_NODE, nextSibling: NO_NODE, previousSibling: NO_NODE, measureKey: 0, measurement: Measurement.None, scrollOffset: Point { x: 0.0, y: 0.0 }, textStart: 0 })
    return NodeId { index: index }
  }
  effect fn reserveSlot(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    if self.freeNodes.length() != 0 { return }
    run self.nodes.reserve(1)
    run self.live.reserve(1)
    run self.changes.reserve(1)
  }
  // Stores a node in the last freed slot or a new one; reserveSlot made room.
  // A new node, even outside the tree, changes which nodes generated boxes
  // and kept per-source lists cover.
  effect fn publish(self: &mut Self, node: Node) -> usize ! OutOfMemoryError ? &mut Allocator {
    if self.freeNodes.length() != 0 {
      let index = self.freeNodes.get(self.freeNodes.length() - 1)
      let remaining = self.freeNodes.length() - 1
      self.freeNodes.truncate(remaining)
      let nodes = self.nodes.asMutSlice()
      nodes[index] = move node
      self.live.set(index, true)
      run self.changes.created(index)
      return index
    }
    let index = self.nodes.length()
    run self.nodes.append(move node)
    run self.live.append(true)
    run self.changes.created(index)
    return index
  }
  // Inserts `child` among `parent`'s children before `before`, or last
  // without it. A child already in a tree moves, as in the DOM: its subtree
  // keeps its nodes and their styles. The root cannot move, and a node
  // cannot go inside itself.
  pub effect fn insertBefore(self: &mut Self, parent: NodeId, child: NodeId, before: Option<NodeId>) ! InvalidNode {
    if !self.canParent(parent) { fail InvalidNode { index: parent.index } }
    if !self.contains(child) || child.index == 0 { fail InvalidNode { index: child.index } }
    let mut ancestor = parent.index
    while ancestor != NO_NODE {
      if ancestor == child.index { fail InvalidNode { index: child.index } }
      ancestor = self.nodes.asSlice()[ancestor].parent
    }
    let mut next = NO_NODE
    match before {
      Option<NodeId>.Some { value } => {
        if !self.contains(value) || self.nodes.asSlice()[value.index].parent != parent.index { fail InvalidNode { index: value.index } }
        next = value.index
      }
      Option<NodeId>.None => {}
    }
    if next == child.index { next = self.nodes.asSlice()[child.index].nextSibling }
    if self.nodes.asSlice()[child.index].parent != NO_NODE { self.unlink(child.index) }
    let styleIndex = self.nodes.asSlice()[parent.index].styleIndex
    let nodes = self.nodes.asMutSlice()
    let mut previous = nodes[parent.index].lastChild
    if next != NO_NODE { previous = nodes[next].previousSibling }
    nodes[child.index].parent = parent.index
    nodes[child.index].previousSibling = previous
    nodes[child.index].nextSibling = next
    if previous == NO_NODE { nodes[parent.index].firstChild = child.index } else { nodes[previous].nextSibling = child.index }
    if next == NO_NODE { nodes[parent.index].lastChild = child.index } else { nodes[next].previousSibling = child.index }
    if nodes[child.index].isText() { nodes[child.index].styleIndex = styleIndex }
    self.changes.inserted(parent.index, child.index)
  }
  // Takes a node and its subtree out of the tree, keeping them for a later
  // insertBefore. A node outside the tree stays as it is.
  pub effect fn remove(self: &mut Self, id: NodeId) ! InvalidNode {
    if !self.contains(id) || id.index == 0 { fail InvalidNode { index: id.index } }
    let parent = self.nodes.asSlice()[id.index].parent
    if parent == NO_NODE { return }
    self.detach(id.index)
    self.changes.removed(id.index, parent)
  }
  // Unlinks a node from its parent's children, recording the parent's change.
  fn unlink(self: &mut Self, id: usize) {
    let parent = self.nodes.asSlice()[id].parent
    self.detach(id)
    self.changes.unlinked(parent)
  }
  // Unlinks a node from its parent's children.
  fn detach(self: &mut Self, id: usize) {
    let nodes = self.nodes.asMutSlice()
    let parent = nodes[id].parent
    let previous = nodes[id].previousSibling
    let next = nodes[id].nextSibling
    if previous == NO_NODE { nodes[parent].firstChild = next } else { nodes[previous].nextSibling = next }
    if next == NO_NODE { nodes[parent].lastChild = previous } else { nodes[next].previousSibling = previous }
    nodes[id].parent = NO_NODE
    nodes[id].previousSibling = NO_NODE
    nodes[id].nextSibling = NO_NODE
  }
  // Removes a node and frees it and its subtree. Their ids, element style
  // slots and grid slots go to later creates, last freed first; nodes are
  // freed in tree order, so the next create takes the subtree's last node.
  pub effect fn destroy(self: &mut Self, id: NodeId) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || id.index == 0 { fail InvalidNode { index: id.index } }
    let mut count: usize = 0
    let mut elements: usize = 0
    let mut grids: usize = 0
    let mut at = id.index
    while at != NO_NODE {
      count = count + 1
      if !self.nodes.asSlice()[at].isText() {
        elements = elements + 1
        if self.styles.asSlice()[self.nodes.asSlice()[at].styleIndex].grid != 0 { grids = grids + 1 }
      }
      at = self.following(id.index, at)
    }
    run self.freeNodes.reserve(count)
    run self.freeStyles.reserve(elements)
    run self.freeGrids.reserve(grids)
    run self.freeShapes.reserve(elements)
    if self.nodes.asSlice()[id.index].parent != NO_NODE { self.unlink(id.index) }
    else { self.changes.destroying() }
    at = id.index
    while at != NO_NODE {
      let next = self.following(id.index, at)
      run self.freeNodes.append(at)
      self.live.set(at, false)
      self.changes.freed(at)
      if !self.nodes.asSlice()[at].isText() {
        let styleIndex = self.nodes.asSlice()[at].styleIndex
        let handle = self.styles.asSlice()[styleIndex].grid
        if handle != 0 {
          let templates = self.grids.asMutSlice()
          templates[handle] = GridTemplate.make()
          run self.freeGrids.append(handle)
        }
        let shape = u32.toUsize(self.styles.asSlice()[styleIndex].shape)
        if shape != 0 {
          let shapes = self.shapes.asMutSlice()
          shapes[shape] = FloatShape.make()
          run self.freeShapes.append(shape)
        }
        let styles = self.styles.asMutSlice()
        styles[styleIndex] = Style.make()
        run self.freeStyles.append(styleIndex)
      }
      let nodes = self.nodes.asMutSlice()
      nodes[at].content = SourceContent.Element
      at = next
    }
    // Freed slots keep their links until reused; following walks them above.
    self.changes.structureChanged()
  }
  // The node after `at` in tree order within `root`'s subtree, or NO_NODE.
  fn following(self: &Self, root: usize, at: usize) -> usize {
    let nodes = self.nodes.asSlice()
    if nodes[at].firstChild != NO_NODE { return nodes[at].firstChild }
    let mut node = at
    while node != root {
      if nodes[node].nextSibling != NO_NODE { return nodes[node].nextSibling }
      node = nodes[node].parent
    }
    return NO_NODE
  }
  // Replaces an element's own style. Text nodes share their parent's slot.
  pub effect fn setStyle(self: &mut Self, id: NodeId, style: Style) ! InvalidNode {
    if !self.contains(id) || self.nodes.asSlice()[id.index].isText() { fail InvalidNode { index: id.index } }
    let styleIndex = self.nodes.asSlice()[id.index].styleIndex
    let mut value = move style
    value.grid = self.styles.asSlice()[styleIndex].grid
    value.shape = self.styles.asSlice()[styleIndex].shape
    // Natural measurement implies a replaced element regardless of the new style.
    if self.nodes.asSlice()[id.index].measurement == Measurement.Natural { value.replaced = true }
    // An unchanged style leaves the node clean, so callers need no change detection of their own.
    let change = Source.classifyIn<Tree>(&self, id.index, &value)
    if change.same { return }
    if value.wrapFlow != WrapFlow.Auto { self.exclusionStyles = true }
    let parent = self.nodes.asSlice()[id.index].parent
    let styles = self.styles.asMutSlice()
    styles[styleIndex] = move value
    self.changes.styleChanged(id.index, parent, change)
  }
  pub effect fn setText(self: &mut Self, id: NodeId, value: String) ! InvalidNode {
    if !self.contains(id) || !self.nodes.asSlice()[id.index].isText() { fail InvalidNode { index: id.index } }
    let blank = Source.blank(String.view(&value))
    let mut wasBlank = false
    match self.nodes.asSlice()[id.index].text() {
      Option<string>.Some { value: previous } => { wasBlank = Source.blank(previous) }
      Option<string>.None => {}
    }
    let nodes = self.nodes.asMutSlice()
    nodes[id.index].content = SourceContent.Text { value: move value }
    nodes[id.index].textStart = 0
    let parent = nodes[id.index].parent
    self.changes.textChanged(id.index, parent, blank != wasBlank)
  }
  /// Leaves the first `start` bytes of text node `id` to another box: layout reads the rest,
  /// at the same offsets. A host's ::first-letter box lays out the letter it takes.
  pub effect fn setTextStart(self: &mut Self, id: NodeId, start: usize) ! InvalidNode {
    if !self.contains(id) || !self.nodes.asSlice()[id.index].isText() { fail InvalidNode { index: id.index } }
    if self.nodes.asSlice()[id.index].textStart == start { return }
    let wasBlank = match self.nodes.asSlice()[id.index].laidText() { Option<string>.Some { value } => Source.blank(value) Option<string>.None => true }
    let nodes = self.nodes.asMutSlice()
    nodes[id.index].textStart = start
    let blank = match self.nodes.asSlice()[id.index].laidText() { Option<string>.Some { value } => Source.blank(value) Option<string>.None => true }
    let parent = self.nodes.asSlice()[id.index].parent
    self.changes.textChanged(id.index, parent, blank != wasBlank)
  }
  pub effect fn setScrollOffset(self: &mut Self, id: NodeId, offset: Point) ! InvalidNode {
    if !self.contains(id) { fail InvalidNode { index: id.index } }
    let nodes = self.nodes.asMutSlice()
    if nodes[id.index].isText() { fail InvalidNode { index: id.index } }
    if nodes[id.index].scrollOffset.x == offset.x && nodes[id.index].scrollOffset.y == offset.y { return }
    nodes[id.index].scrollOffset = offset
    self.changes.scrolled(id.index)
  }
  pub effect fn setMeasurement(self: &mut Self, id: NodeId, key: usize) ! InvalidNode {
    if !self.contains(id) { fail InvalidNode { index: id.index } }
    let nodes = self.nodes.asMutSlice()
    if nodes[id.index].isText() || nodes[id.index].firstChild != NO_NODE { fail InvalidNode { index: id.index } }
    nodes[id.index].measureKey = key
    nodes[id.index].measurement = Measurement.Content
    let parent = nodes[id.index].parent
    self.changes.measured(id.index, parent)
  }
  pub effect fn setNaturalMeasurement(self: &mut Self, id: NodeId, key: usize) ! InvalidNode {
    if !self.contains(id) { fail InvalidNode { index: id.index } }
    let nodes = self.nodes.asMutSlice()
    if nodes[id.index].isText() || nodes[id.index].firstChild != NO_NODE { fail InvalidNode { index: id.index } }
    nodes[id.index].measureKey = key
    nodes[id.index].measurement = Measurement.Natural
    let styleIndex = nodes[id.index].styleIndex
    let parent = nodes[id.index].parent
    let styles = self.styles.asMutSlice()
    styles[styleIndex].replaced = true
    self.changes.measured(id.index, parent)
  }
}
// Work counters for the most recent compute, summed over its passes.
pub struct LayoutStats {
  pub passes: usize, pub fullLayouts: usize, pub sizeProbes: usize, pub cacheHits: usize,
  // Independent subtrees copied from the previous compute instead of laid out.
  pub reusedLayouts: usize,
  // For the bench census: inline formatting contexts laid out or probed by the
  // general path, those the one-line path answered, and line boxes emitted.
  pub inlineLayouts: usize, pub plainLines: usize, pub linesEmitted: usize,
}
impl Copy for LayoutStats {}
impl LayoutStats {
  pub fn zero() -> LayoutStats { return LayoutStats { passes: 0, fullLayouts: 0, sizeProbes: 0, cacheHits: 0, reusedLayouts: 0, inlineLayouts: 0, plainLines: 0, linesEmitted: 0 } }
}
pub struct LayoutTree {
  pub stats: LayoutStats,
  // Size results kept for the next compute of the same Tree. `keptRevision`
  // is the Tree revision they reflect; reuse is off until a compute
  // completes without auto scrollbars or fragmentation.
  pub cache: LayoutCache, pub snapshot: Snapshot, keptRevision: usize, keptReusable: bool,
  pub facts: BoxFacts, pub writes: BoxWrites,
  // The viewport, viewport scroll offset and Tree scroll revision of the
  // last compute.
  pub keptViewport: OptionalSize, pub keptScroll: Point, pub keptScrolls: usize, pub keptMarks: usize,
  // Settled visual offsets before scroll/sticky positioning, for scroll-only updates.
  pub normalOffsets: List<Point>, pub scrollReady: bool,
  // Whether every entry of `normalOffsets` is zero, so a compute that moves no fragment
  // only changes the list's length.
  pub normalOffsetsZero: bool,
  // Whether the last compute of the same boxes as the one before laid out
  // most of them again.
  pub relaidMost: bool,
  // Set to make every compute write its output afresh, copying what it
  // reuses from the previous one, instead of working in place over it: for
  // telling a fault of the in-place path from one of reuse itself.
  pub inPlaceOff: bool,
  // How the last compute ran, for diagnostics: 0 nothing changed, 1 every change laid out
  // alone and spliced in, 2 in place over the previous output, 3 the same boxes written
  // afresh, 4 other boxes, 5 patched boxes in place over the previous output.
  pub lastMode: u8,
  // Computes so far that patched the kept boxes (box_patch.silk), and that
  // tried and generated every box afresh instead.
  pub patches: usize, pub patchFallbacks: usize,
  // Whether a compute may patch the kept boxes; off, it matches boxes
  // generated afresh with them, as before patches, to compare the two.
  pub patching: bool,
  // How many computes in a row laid out most boxes again and copied none
  // (see compute).
  pub reuseIdle: usize,
  pub boxes: List<Layout>, pub boxNodes: List<BoxNode>,
  pub anonymousStyles: AnonymousStyles,
  pub firstBySource: List<usize>, pub lastBySource: List<usize>,
  pub keptColumnSets: bool,
  // Box ids no box holds (see BoxTree.freeBoxes).
  pub freeBoxes: List<usize>,
  pub fragments: FragmentArena,
  pub viewportOverflow: Rect,
  // Spare storage for laying out a changed subtree alone (see the early
  // cutoff in compute).
  pub scratchBoxes: ScratchBoxes, pub scratchFragments: FragmentArena,
  // Boxes whose early cutoff failed lately, tried again only after a few
  // computes (see the early cutoff in compute).
  pub cutoffMisses: List<CutoffMiss>,
  // Flex item and line lists, kept so nested containers don't allocate on
  // every compute.
  pub flexScratch: List<FlexScratch>,
  pub inlineScratch: List<InlineScratch>,
  pub blockScratch: List<BlockScratch>,
  // The exclusion areas the last compute ended with (see exclusions.silk).
  pub exclusions: List<ExclusionArea>,
  // Where each box's prepared paragraph is in a compute (LayoutPass.preparedSlots),
  // kept so that a compute does not allocate a slot a box, and the generation of
  // the last compute that had them.
  pub preparedSlots: List<PreparedSlot>, pub preparedGeneration: usize,
}
impl LayoutTree {
  // What the layout output and its caches hold, for the bench census.
  pub effect fn census(self: &Self, out: &mut Census) ! OutOfMemoryError ? &mut Allocator {
    let u = Intrinsic.layoutOf<usize>().bytes
    let layout = Intrinsic.layoutOf<Layout>().bytes
    run out.held("css.out.boxes(Layout)", self.boxes.length(), self.boxes.capacity(), layout)
    run out.held("css.out.box-nodes", self.boxNodes.length(), self.boxNodes.capacity(), Intrinsic.layoutOf<BoxNode>().bytes)
    run self.anonymousStyles.census(&mut out)
    run out.held("css.out.by-source", self.firstBySource.length() + self.lastBySource.length(), self.firstBySource.capacity() + self.lastBySource.capacity(), u)
    run out.held("css.out.normal-offsets", self.normalOffsets.length(), self.normalOffsets.capacity(), Intrinsic.layoutOf<Point>().bytes)
    run out.held("css.out.cutoff-misses", self.cutoffMisses.length(), self.cutoffMisses.capacity(), Intrinsic.layoutOf<CutoffMiss>().bytes)
    run out.held("css.out.scratch-lists", self.flexScratch.length() + self.inlineScratch.length() + self.blockScratch.length(),
      self.flexScratch.capacity() + self.inlineScratch.capacity() + self.blockScratch.capacity(), Intrinsic.layoutOf<FlexScratch>().bytes)
    run self.fragments.census("css.out.fragments", "css.out.fragment-texts", "css.out.fragment-side", &mut out)
    run self.snapshot.fragments.census("css.snapshot.fragments", "css.snapshot.fragment-texts", "css.snapshot.fragment-side", &mut out)
    run out.held("css.snapshot.boxes(Layout)", self.snapshot.boxes.length(), self.snapshot.boxes.capacity(), layout)
    run self.scratchFragments.census("css.scratch.fragments", "css.scratch.fragment-texts", "css.scratch.fragment-side", &mut out)
    run out.bytes("css.scratch.boxes", self.scratchBoxes.storageBytes(), self.scratchBoxes.storageBytes())
    run self.facts.census(&mut out)
    run self.writes.census(&mut out)
    run self.cache.heldCensus(&mut out)
    // Boxes by kind, and how the fragments divide.
    let mut kinds: [usize; 8] = [0; 8]
    let mut anonymous: usize = 0
    let mut at: usize = 0
    while at < self.boxNodes.length() {
      let box = &self.boxNodes.asSlice()[at]
      let slot: usize = match box.kind {
        BoxKind.Block => 0
        BoxKind.Flex => 1
        BoxKind.Grid => 2
        BoxKind.Inline => 3
        BoxKind.InlineFormatting => 4
        BoxKind.Text => 5
        BoxKind.Table => 6
        BoxKind.TablePart => 7
      }
      kinds[slot] = kinds[slot] + 1
      if box.anonymousStyle() != NO_NODE { anonymous = anonymous + 1 }
      at = at + 1
    }
    run out.unit("css.boxes", self.boxNodes.length())
    run out.unit("css.boxes.block", kinds[0])
    run out.unit("css.boxes.flex", kinds[1])
    run out.unit("css.boxes.grid", kinds[2])
    run out.unit("css.boxes.inline", kinds[3])
    run out.unit("css.boxes.inline-formatting", kinds[4])
    run out.unit("css.boxes.text", kinds[5])
    run out.unit("css.boxes.table", kinds[6] + kinds[7])
    run out.unit("css.boxes.anonymous", anonymous)
    run out.work("css.layout.passes", self.stats.passes)
    run out.work("css.layout.full-layouts", self.stats.fullLayouts)
    run out.work("css.layout.size-probes", self.stats.sizeProbes)
    run out.work("css.layout.cache-hits", self.stats.cacheHits)
    run out.work("css.layout.reused-layouts", self.stats.reusedLayouts)
    run out.work("css.layout.inline-layouts(last compute)", self.stats.inlineLayouts)
  }
  pub fn make() -> LayoutTree {
    return LayoutTree {
      stats: LayoutStats.zero(),
      cache: LayoutCache.make(), snapshot: Snapshot.make(), facts: BoxFacts.make(), writes: BoxWrites.make(), keptRevision: 0, keptReusable: false, normalOffsets: List<Point>.make(), normalOffsetsZero: true, scrollReady: false, keptViewport: OptionalSize.none(), keptScroll: Point { x: 0.0, y: 0.0 }, keptScrolls: 0, keptMarks: 0, relaidMost: false, inPlaceOff: false, lastMode: 0, patches: 0, patchFallbacks: 0, patching: true, reuseIdle: 0,
      boxes: List<Layout>.make(), boxNodes: List<BoxNode>.make(),
      anonymousStyles: AnonymousStyles.make(),
      firstBySource: List<usize>.make(), lastBySource: List<usize>.make(), keptColumnSets: false, freeBoxes: List<usize>.make(),
      fragments: FragmentArena.make(), viewportOverflow: Rect.zero(),
      scratchBoxes: ScratchBoxes.make(), scratchFragments: FragmentArena.make(), cutoffMisses: List<CutoffMiss>.make(), flexScratch: List<FlexScratch>.make(), inlineScratch: List<InlineScratch>.make(), blockScratch: List<BlockScratch>.make(), exclusions: List<ExclusionArea>.make(),
      preparedSlots: List<PreparedSlot>.make(), preparedGeneration: 0,
    }
  }
  pub effect fn prepare(self: &mut Self, count: usize) ! OutOfMemoryError ? &mut Allocator {
    run self.prepareBoxes(count, false)
  }
  // `keepBoxes` keeps the previous compute's box layouts and fragments, for
  // a compute of the same boxes that rewrites them copy-on-write (see
  // LayoutPass.touch and FragmentArena.beginInPlace).
  pub effect fn prepareBoxes(self: &mut Self, count: usize, keepBoxes: bool) ! OutOfMemoryError ? &mut Allocator {
    self.scrollReady = false
    self.viewportOverflow = Rect.zero()
    self.boxNodes.clear()
    self.anonymousStyles.clear()
    self.firstBySource.clear()
    self.lastBySource.clear()
    if keepBoxes { run self.fragments.beginInPlace(count) }
    else {
      run self.fragments.prepare(count)
      run self.fragments.reserveLike(&self.snapshot.fragments)
    }
    if keepBoxes && self.boxes.length() == count { return }
    self.boxes.clear()
    run self.boxes.reserveExact(count)
    run self.boxes.appendRepeated(Layout.zero(), count)
  }
  // Discards every kept result. Call it after replacing the measurement
  // provider, changing what it returns, or computing a different Tree.
  pub fn invalidate(self: &mut Self) {
    self.scrollReady = false
    self.keptReusable = false
    self.cache.clearMeasured()
    self.snapshot.clear()
  }
  pub fn treeRevision(self: &Self) -> usize { return self.keptRevision }
  pub fn reusable(self: &Self) -> bool { return self.keptReusable }
  // Turns reuse off until a compute completes, keeping what is kept.
  pub fn suspendReuse(self: &mut Self) { self.keptReusable = false }
  pub fn keep(self: &mut Self, revision: usize, reusable: bool) {
    self.keptRevision = revision
    self.keptReusable = reusable
    if !reusable {
      self.cache.clear()
      self.snapshot.clear()
    }
  }
  // Turns reuse off while a compute runs on the kept state in place: one that
  // fails part way leaves it partly written, which the next compute clears.
  pub fn holdUnsettled(self: &mut Self, revision: usize) {
    self.scrollReady = false
    self.keptRevision = revision
    self.keptReusable = false
  }
  pub fn adopt<'a, S: LayoutSource>(self: &mut Self, constructed: BoxTree<'a, S>) {
    self.boxNodes = move constructed.boxes
    self.anonymousStyles = move constructed.anonymous
    self.firstBySource = move constructed.firstBySource
    self.lastBySource = move constructed.lastBySource
    self.keptColumnSets = constructed.columnSets
    self.freeBoxes = move constructed.freeBoxes
  }
  pub effect fn getBox(self: &Self, id: BoxId) -> Layout ! InvalidBox {
    if id.index >= self.boxes.length() { fail InvalidBox { index: id.index } }
    return self.boxes.get(id.index)
  }
  pub effect fn firstBox(self: &Self, id: NodeId) -> Option<BoxId> ! InvalidNode {
    if id.index >= self.firstBySource.length() { fail InvalidNode { index: id.index } }
    let first = self.firstBySource.get(id.index)
    if first == NO_NODE { return Option<BoxId>.None }
    return Option<BoxId>.Some { value: BoxId { index: first } }
  }
  pub effect fn sourceRects<'a>(self: &'a Self, id: NodeId) -> SourceRects<'a> ! InvalidNode {
    if id.index >= self.firstBySource.length() { fail InvalidNode { index: id.index } }
    let box = self.firstBySource.get(id.index)
    let mut fragment = NO_NODE
    let mut lines = NO_NODE
    let mut text = false
    if box != NO_NODE {
      fragment = self.fragments.first(box)
      let boxes = self.boxNodes.asSlice()
      text = boxes[box].kind == BoxKind.Text
      if text {
        // Its runs on lines of text alone are in fragments of its inline
        // formatting box (see LineText).
        let mut above = boxes[box].parent()
        while above != NO_NODE && boxes[above].kind != BoxKind.InlineFormatting { above = boxes[above].parent() }
        if above != NO_NODE { lines = self.fragments.first(above) }
      }
    }
    return SourceRects {
      tree: self, source: id.index, box: box, fragment: fragment, text: text, lines: lines,
      runs: self.fragments.noTextRuns(), reading: false, parent: NO_NODE,
      held: Rect.zero(), holding: false, heldParent: NO_NODE, heldLine: NO_NODE, heldFont: 0, heldLevel: 0, heldGlyphs: false, heldLocation: Point { x: 0.0, y: 0.0 }, heldSize: Size.zero(),
    }
  }
  // CSSOM-style source bounds are a derived view, never a containing block
  // or replacement for the fragment tree. CSSOM View bounding-box steps 3–4
  // distinguish degenerate-only lists from a union containing positive area.
  pub effect fn sourceBounds(self: &Self, id: NodeId) -> Rect ! InvalidNode {
    let mut rects = run self.sourceRects(id)
    let mut result = Rect.zero()
    let mut firstRect = Rect.zero()
    let mut first = true
    let mut nonempty = false
    let mut hasArea = false
    while true {
      let rect = match move rects.next() {
        Option<Rect>.Some { value } => value
        Option<Rect>.None => { break }
      }
      if first { firstRect = rect
        first = false }
      if rect.width != 0.0 || rect.height != 0.0 {
        if nonempty { result = result.unionWith(rect) } else { result = rect }
        nonempty = true
      }
      if rect.width != 0.0 && rect.height != 0.0 { hasArea = true }
    }
    if !hasArea { return firstRect }
    return result
  }
}

// A source text rectangle is a font/bidi run on a line, not an individual
// shaping request or collapsed-space token. Keep paint fragments separate.
pub struct SourceRects<'a> {
  tree: &'a LayoutTree, source: usize, box: usize, fragment: usize,
  // For text: the next fragment of its inline formatting box that may hold
  // its runs on lines of text alone, the runs of the text fragment being
  // read (when `reading`) and that fragment's parent, and the rectangle
  // gathered so far with what the runs joined to it must share.
  text: bool, lines: usize,
  runs: TextRuns<'a>, reading: bool, parent: usize,
  held: Rect, holding: bool, heldParent: usize, heldLine: usize, heldFont: usize, heldLevel: u8, heldGlyphs: bool, heldLocation: Point, heldSize: Size,
}
impl<'a> SourceRects<'a> {
  pub fn next(self: &mut Self) -> Option<Rect> {
    if self.text { return self.nextText() }
    while self.box != NO_NODE {
      if self.fragment == NO_NODE {
        self.box = self.tree.boxNodes.asSlice()[self.box].nextContinuation()
        if self.box != NO_NODE { self.fragment = self.tree.fragments.first(self.box) }
        continue
      }
      let fragments = self.tree.fragments.values.asSlice()
      let firstIndex = self.fragment
      let first = &fragments[firstIndex]
      self.fragment = first.nextForBox
      if first.positioningShell || first.source != self.source || (first.kind != FragmentKind.Box && first.kind != FragmentKind.Inline) { continue }
      let origin = self.tree.fragments.worldLocation(firstIndex)
      return Option<Rect>.Some { value: Rect { x: origin.x, y: origin.y, width: first.size.width, height: first.size.height } }
    }
    return Option<Rect>.None
  }
  // The next text fragment of the source, in fragment order: of its own
  // boxes' fragments and of its inline formatting box's.
  fn nextTextFragment(self: &mut Self) -> usize {
    let fragments = self.tree.fragments.values.asSlice()
    while self.box != NO_NODE {
      if self.fragment == NO_NODE {
        self.box = self.tree.boxNodes.asSlice()[self.box].nextContinuation()
        if self.box != NO_NODE { self.fragment = self.tree.fragments.first(self.box) }
        continue
      }
      let candidate = &fragments[self.fragment]
      if candidate.positioningShell || candidate.source != self.source || candidate.kind != FragmentKind.Text {
        self.fragment = candidate.nextForBox
        continue
      }
      break
    }
    while self.lines != NO_NODE {
      let candidate = &fragments[self.lines]
      if candidate.kind == FragmentKind.Text && candidate.source == self.source && self.tree.fragments.ownsLines(self.lines) { break }
      self.lines = candidate.nextForBox
    }
    let mut own = NO_NODE
    if self.box != NO_NODE { own = self.fragment }
    if own != NO_NODE && (self.lines == NO_NODE || own < self.lines) {
      self.fragment = fragments[own].nextForBox
      return own
    }
    if self.lines != NO_NODE {
      let found = self.lines
      self.lines = fragments[found].nextForBox
      return found
    }
    return NO_NODE
  }
  fn nextText(self: &mut Self) -> Option<Rect> {
    while true {
      if !self.reading {
        let index = self.nextTextFragment()
        if index == NO_NODE {
          if self.holding {
            self.holding = false
            return Option<Rect>.Some { value: self.held }
          }
          return Option<Rect>.None
        }
        let tree = self.tree
        self.runs = tree.fragments.textRuns(index)
        self.parent = tree.fragments.values.asSlice()[index].parent
        self.reading = true
      }
      if !self.runs.next() {
        self.reading = false
        continue
      }
      let placed = self.runs.current
      let rect = Rect { x: placed.location.x, y: placed.location.y, width: placed.size.width, height: placed.size.height }
      let glyphs = placed.kind == TextFragmentKind.Glyphs
      if self.holding && self.heldGlyphs && glyphs && self.heldParent == self.parent && self.heldLine == placed.line
        && self.heldFont == placed.fontKey && self.heldLevel == placed.bidiLevel {
        let sameHorizontal = placed.location.y == self.heldLocation.y && placed.size.height == self.heldSize.height
        let sameVertical = placed.location.x == self.heldLocation.x && placed.size.width == self.heldSize.width
        if sameHorizontal || sameVertical {
          self.held = self.held.unionWith(rect)
          continue
        }
      }
      let done = self.held
      let had = self.holding
      self.held = rect
      self.holding = true
      self.heldParent = self.parent
      self.heldLine = placed.line
      self.heldFont = placed.fontKey
      self.heldLevel = placed.bidiLevel
      self.heldGlyphs = glyphs
      self.heldLocation = placed.location
      self.heldSize = placed.size
      if had { return Option<Rect>.Some { value: done } }
    }
    return Option<Rect>.None
  }
}

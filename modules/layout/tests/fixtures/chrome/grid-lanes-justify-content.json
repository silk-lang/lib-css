{
  "name": "grid-lanes-justify-content-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "grid-lanes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-3/#grid-lanes-layout-algorithm"
  ],
  "derivation": "justify-content distributes the free space between the lanes.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid-lanes",
          "width": 300,
          "gridTemplateColumns": [
            60,
            60
          ],
          "justifyContent": "space-between"
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 40
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 30
        }
      }
    ]
  }
}

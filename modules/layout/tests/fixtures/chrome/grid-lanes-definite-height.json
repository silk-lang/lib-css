{
  "name": "grid-lanes-definite-height-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "grid-lanes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-3/#grid-lanes-layout-algorithm"
  ],
  "derivation": "A definite block size does not stretch stacked items: each keeps its own height.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid-lanes",
          "width": 200,
          "height": 300,
          "gridTemplateColumns": [
            {
              "fr": 1
            },
            {
              "fr": 1
            }
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 40
        }
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {
          "height": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "minHeight": 15
        }
      }
    ]
  }
}

{
  "name": "grid-lanes-uneven-fr-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "grid-lanes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-3/#grid-lanes-layout-algorithm"
  ],
  "derivation": "Items sized by percent top padding in 1fr 2fr lanes.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid-lanes",
          "width": 300,
          "gridTemplateColumns": [
            {
              "fr": 1
            },
            {
              "fr": 2
            }
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "padding": {
            "top": {
              "percent": 1
            }
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "padding": {
            "top": {
              "percent": 1
            }
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "padding": {
            "top": {
              "percent": 0.3
            }
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "padding": {
            "top": {
              "percent": 1
            }
          }
        }
      }
    ]
  }
}

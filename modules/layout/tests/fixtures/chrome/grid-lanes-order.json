{
  "name": "grid-lanes-order-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "grid-lanes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-3/#grid-lanes-layout-algorithm"
  ],
  "derivation": "Items are placed in order-modified document order.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid-lanes",
          "width": 200,
          "gridTemplateColumns": [
            100,
            100
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 40,
          "order": 2
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 30,
          "order": -1
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 20
        }
      }
    ]
  }
}

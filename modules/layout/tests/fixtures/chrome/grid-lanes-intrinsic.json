{
  "name": "grid-lanes-intrinsic-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "grid-lanes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-3/#grid-lanes-layout-algorithm"
  ],
  "derivation": "Auto lanes are sized by auto-placed items as if each sat in every lane, so all three lanes take the widest item's width.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid-lanes",
          "width": 400,
          "gridTemplateColumns": [
            "auto",
            "auto",
            "auto"
          ],
          "justifyContent": "start"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 30,
          "height": 20
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 70,
          "height": 20
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 40,
          "height": 20
        }
      }
    ]
  }
}

{
  "name": "grid-lanes-span-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "grid-lanes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-3/#grid-lanes-layout-algorithm"
  ],
  "derivation": "A span-2 item takes the two adjacent lanes whose highest end is lowest, leaving a gap in the shorter one.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid-lanes",
          "width": 300,
          "gridTemplateColumns": [
            {
              "fr": 1
            },
            {
              "fr": 1
            },
            {
              "fr": 1
            }
          ],
          "columnGap": 0,
          "rowGap": 0
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 40
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 20,
          "gridColumnStart": {
            "span": 2
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 15
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 15
        }
      }
    ]
  }
}

{
  "name": "grid-lanes-inline-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "grid-lanes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-3/#grid-lanes-layout-algorithm"
  ],
  "derivation": "inline-grid-lanes shrinks to its lanes and grows to the tallest lane.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "inline-grid-lanes",
          "gridTemplateColumns": [
            60,
            40
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 40
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 20
        }
      }
    ]
  }
}

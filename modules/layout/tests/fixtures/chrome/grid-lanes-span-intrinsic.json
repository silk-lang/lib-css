{
  "name": "grid-lanes-span-intrinsic-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "grid-lanes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-3/#grid-lanes-layout-algorithm"
  ],
  "derivation": "An auto-placed span-2 item contributes to every pair of auto lanes it could take.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid-lanes",
          "width": 500,
          "gridTemplateColumns": [
            "auto",
            "auto",
            "auto"
          ],
          "justifyContent": "start"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 30,
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 10,
          "gridColumnStart": {
            "span": 2
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 30
        }
      }
    ]
  }
}

{
  "name": "grid-lanes-explicit-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "grid-lanes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-3/#grid-lanes-layout-algorithm"
  ],
  "derivation": "An item with a definite lane goes there at that lane's running position; auto items still go to the shortest lane.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid-lanes",
          "width": 300,
          "gridTemplateColumns": [
            100,
            100,
            100
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 40
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 10,
          "gridColumnStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 20
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 15,
          "gridColumnStart": 3
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 25
        }
      }
    ]
  }
}

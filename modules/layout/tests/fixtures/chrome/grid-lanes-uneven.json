{
  "name": "grid-lanes-uneven-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "grid-lanes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-3/#grid-lanes-layout-algorithm"
  ],
  "derivation": "Items as tall as a fraction of their width (percent top padding) in lanes of 60px and 120px: placement stacks each by its size in the lane it lands in.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid-lanes",
          "width": 190,
          "gridTemplateColumns": [
            60,
            120
          ],
          "columnGap": 10,
          "rowGap": 4
        }
      },
      {
        "parent": 0,
        "style": {
          "padding": {
            "top": {
              "percent": 1
            }
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "padding": {
            "top": {
              "percent": 0.5
            }
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "padding": {
            "top": {
              "percent": 1
            }
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "padding": {
            "top": {
              "percent": 2
            }
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "padding": {
            "top": {
              "percent": 1
            }
          }
        }
      }
    ]
  }
}

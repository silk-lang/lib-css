//! The property catalog lives in css-properties. css-style re-exports it under its old path,
//! limited to the properties it parses and computes today.
import css_properties.catalog as catalog
import silk.core.option { Option }
pub import css_properties.catalog {
  Property,
  index,
  name,
  inherited,
  initial,
  InitialKind,
  initialKind,
  canonical,
  longhandAt
}

/// How many properties css-style supports: the whole catalog. The SVG and text properties,
/// the first `TYPED`, have their own grammars; the box properties after them are read by
/// shape (see `box_values`).
pub const COUNT: usize = catalog.COUNT

/// How many properties, from the start of the catalog, have a grammar of their own.
pub const TYPED: usize = 172

/// The supported properties in catalog order.
pub fn all() -> [Property; COUNT] {
  return catalog.all()
}

/// Whether `property` is one of the box properties, whose values are read by shape.
pub fn boxProperty(property: Property) -> bool {
  return index(property) >= TYPED
}

pub fn lookup(name: &[u8]) -> Option<Property> {
  return catalog.lookup(name)
}

/// `lookup` among the properties with a grammar of their own. The descriptor contexts
/// (`@page`, `@font-face`) use it: their `margin` and `padding` descriptors are not the box
/// properties of the same names.
pub fn typedLookup(name: &[u8]) -> Option<Property> {
  if let Option<Property>.Some { value } = catalog.lookup(name) {
    if index(value) < TYPED {
      return Option<Property>.some(value)
    }
  }
  return Option<Property>.None
}

pub fn longhandCount(property: Property) -> usize {
  return catalog.longhandCount(property)
}

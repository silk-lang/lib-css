//! Selector matching borrows a host tree instead of duplicating its nodes.
import silk.core.option { Option }
import media_features { Environment }
import variables { ScopeId }
import silk.num.usize
import tokens { CssError, CssErrorKind }
import tokens
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub const NO_ELEMENT: usize = usize.MAX

/// A style target supplied by the host. Parts are not ordinary selector-tree children.
pub enum PseudoTarget { None, Before, After, Placeholder, Selection, Scrollbar, ScrollbarThumb, ScrollbarTrack, Marker }

/// Supported nonfunctional pseudo-elements. None means no matching host target.
pub fn pseudoTarget(name: &[u8]) -> PseudoTarget {
  if tokens.insensitive(name, b"before") { return PseudoTarget.Before }
  if tokens.insensitive(name, b"after") { return PseudoTarget.After }
  if tokens.insensitive(name, b"placeholder") { return PseudoTarget.Placeholder }
  if tokens.insensitive(name, b"selection") { return PseudoTarget.Selection }
  if tokens.insensitive(name, b"-webkit-scrollbar") { return PseudoTarget.Scrollbar }
  if tokens.insensitive(name, b"-webkit-scrollbar-thumb") { return PseudoTarget.ScrollbarThumb }
  if tokens.insensitive(name, b"-webkit-scrollbar-track") { return PseudoTarget.ScrollbarTrack }
  if tokens.insensitive(name, b"marker") { return PseudoTarget.Marker }
  return PseudoTarget.None
}

/// Host-reported selector states. Bits describe applicability as well as state:
/// disabled/enabled and required/optional are independent, not complements.
pub struct StateBits {
  pub bits: u32,
}

impl Copy for StateBits {}

impl StateBits {
  pub fn empty() -> StateBits {
    return StateBits { bits: 0 }
  }

  pub fn contains(self: &Self, mask: u32) -> bool {
    return (self.bits & mask) == mask
  }
}

pub const HOVER: u32 = 1
pub const ACTIVE: u32 = 2
pub const FOCUS: u32 = 4
pub const FOCUS_VISIBLE: u32 = 8
pub const FOCUS_WITHIN: u32 = 16
pub const DISABLED: u32 = 32
pub const ENABLED: u32 = 64
pub const CHECKED: u32 = 128
pub const INDETERMINATE: u32 = 256
pub const PLACEHOLDER_SHOWN: u32 = 512
pub const READ_ONLY: u32 = 1024
pub const READ_WRITE: u32 = 2048
pub const REQUIRED: u32 = 4096
pub const OPTIONAL: u32 = 8192
pub const OPEN: u32 = 16384
pub const POPOVER_OPEN: u32 = 32768
pub const DEFAULT: u32 = 65536
pub const IN_RANGE: u32 = 131072
pub const OUT_OF_RANGE: u32 = 262144

/// One attribute's namespace, local name and value, as ElementTree.attributeNamespace,
/// attributeName and attributeValue give them, fetched together.
pub struct AttributeText<'a> {
  pub namespace: &'a [u8],
  pub name: &'a [u8],
  pub value: &'a [u8],
}

impl<'a> Copy for AttributeText<'a> {}

/// Providers expose element-only links and an acyclic tree. NO_ELEMENT denotes an absent link.
/// Raw parents include shadow hosts. Child/sibling lists may mix tree scopes;
/// matching filters them with containingHost and never exposes a host's outer links.
/// Attribute names and namespaces are case-sensitive XML names; attribute values are decoded.
/// isEmpty follows pinned Selectors 4: comments/PIs and document whitespace do not prevent :empty.
/// language supplies the inherited document language, or empty when explicitly unknown.
/// isLink reports document-language link semantics, not whether a URL was fetched or visited.
pub interface ElementTree {
  /// Nearest eligible ancestor for all required query axes (width/height/inline/block
  /// bits 1/2/4/8), restricted by a case-sensitive name when nonempty. For a pseudo
  /// target the originating element is an ancestor too. Named-only queries use axes 0.
  /// Return querySize plus the selected container's font/writing metrics in initial;
  /// viewport metrics remain those of the host. Static hosts may expose no containers.
  fn container(self: &Self, node: usize, name: &[u8], axes: u32, pseudo: PseudoTarget) -> Option<Environment> {
    return Option<Environment>.None
  }

  /// The variable scope of the style container a `style()` container query asks: the
  /// nearest ancestor, or the nearest one with container name `name` when nonempty. Every
  /// element is a style container. Hosts without variable scopes return none.
  fn styleContainer(self: &Self, node: usize, name: &[u8], pseudo: PseudoTarget) -> Option<ScopeId> {
    return Option<ScopeId>.None
  }

  /// States applicable to this element, including host-computed focus-within.
  /// Static hosts have no interactive states unless they override this operation.
  fn state(self: &Self, node: usize) -> StateBits {
    return StateBits.empty()
  }

  fn parent(self: &Self, node: usize) -> usize

  /// Host of the node's own tree scope, or NO_ELEMENT in an ordinary tree.
  /// A host belongs to its enclosing scope, not the shadow tree that it hosts.
  /// This scope identity is stable across matching, including host-function arguments.
  fn containingHost(self: &Self, node: usize) -> usize

  fn firstChild(self: &Self, node: usize) -> usize

  fn nextSibling(self: &Self, node: usize) -> usize

  fn previousSibling(self: &Self, node: usize) -> usize

  fn localName(self: &Self, node: usize) -> &[u8]

  fn namespaceUri(self: &Self, node: usize) -> &[u8]

  fn attributeCount(self: &Self, node: usize) -> usize

  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8]

  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8]

  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8]

  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool

  /// attributeNamespace, attributeName and attributeValue of one attribute in one lookup.
  fn attribute<'a>(self: &'a Self, node: usize, attribute: usize) -> AttributeText<'a>

  fn language(self: &Self, node: usize) -> &[u8]

  fn isRoot(self: &Self, node: usize) -> bool

  fn isEmpty(self: &Self, node: usize) -> bool

  fn isLink(self: &Self, node: usize) -> bool
}

pub struct ContainerDependency {
  pub sheet: u32,
  pub condition: usize,
  pub matched: bool,
}
impl Copy for ContainerDependency {}

/// An element a match asked something that its own subtree can change without the element's
/// own identity or state changing: the host flags it and restyles it when that happens.
pub struct Watch {
  pub node: usize,
  pub bits: u32,
}
impl Copy for Watch {}

/// `:has()` was evaluated with this element as its anchor.
pub const WATCH_HAS: u32 = 1
/// One of those `:has()` arguments starts with `+` or `~`: it reads the anchor's later siblings.
pub const WATCH_HAS_SIBLINGS: u32 = 2
/// `:focus-within` was evaluated on this element.
pub const WATCH_FOCUS_WITHIN: u32 = 4

const WATCH_LIMIT: usize = 8

pub struct MatchContext {
  pub scope: usize,
  pub target: usize,
  pub pseudo: PseudoTarget,
  pub pseudoStates: StateBits,
  /// Host exposed as featureless in the current selector scope; absent in light context.
  pub shadowHost: usize,
  /// Shared across a document's matching work; exhaustion is CssError.MatchLimit, never false.
  pub remainingSteps: usize,
  pub containers: List<ContainerDependency>,
  /// What matching read since the caller last cleared it: `selectors.READS_*` bits for the
  /// element being matched and its siblings, the same bits shifted left by
  /// `selectors.READS_ABOVE` for its ancestors and theirs. Failed tests count.
  pub reads: u32,
  /// Whether the element under test is an ancestor of the one being matched.
  pub above: bool,
  watches: [Watch; 8],
  watchCount: usize,
  /// More elements were watched than `watched` holds: the host must assume any element was.
  pub watchOverflow: bool,
}

impl MatchContext {
  pub fn make(scope: usize, target: usize) -> MatchContext {
    return MatchContext {
      scope: scope,
      target: target,
      pseudo: PseudoTarget.None,
      pseudoStates: StateBits.empty(),
      shadowHost: NO_ELEMENT,
      remainingSteps: 64000000,
      containers: List<ContainerDependency>.make(),
      reads: 0,
      above: false,
      watches: [Watch { node: NO_ELEMENT, bits: 0 }; 8],
      watchCount: 0,
      watchOverflow: false,
    }
  }

  /// The elements watched since `clearWatches`, each once.
  pub fn watched(self: &Self) -> &[Watch] {
    return Slice.view<Watch>(&self.watches, 0, self.watchCount)
  }

  pub fn clearWatches(self: &mut Self) -> () {
    self.watchCount = 0
    self.watchOverflow = false
  }

  pub fn watch(self: &mut Self, node: usize, bits: u32) -> () {
    let mut i: usize = 0
    while i < self.watchCount {
      if self.watches[i].node == node {
        self.watches[i].bits = self.watches[i].bits | bits
        return ()
      }
      i = i + 1
    }
    if self.watchCount == WATCH_LIMIT {
      self.watchOverflow = true
      return ()
    }
    self.watches[self.watchCount] = Watch { node: node, bits: bits }
    self.watchCount = self.watchCount + 1
  }

  pub fn containerResult(self: &Self, sheet: u32, condition: usize) -> Option<bool> {
    let entries = self.containers.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      if entries[i].sheet == sheet && entries[i].condition == condition { return Option<bool>.some(entries[i].matched) }
      i = i + 1
    }
    return Option<bool>.None
  }

  pub effect fn recordContainer(self: &mut Self, sheet: u32, condition: usize, matched: bool)
    ! OutOfMemoryError ? &mut Allocator {
    run self.containers.append(ContainerDependency { sheet: sheet, condition: condition, matched: matched })
  }

  /// Charge bounded matching or candidate-discovery work before performing it.
  @inlineAlways
  pub effect fn spend(self: &mut Self, steps: usize) -> ()
    ! CssError {
    if steps > self.remainingSteps {
      fail CssError { kind: CssErrorKind.MatchLimit, offset: 0 }
    }
    self.remainingSteps = self.remainingSteps - steps
  }
}

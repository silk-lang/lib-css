//! CSS text to the written values of css-properties, for every property in the shared catalog.
//!
//! This is the generic route beside the per-property grammars: it reads a value by its shape
//! (keywords, numbers with units, colors, math functions, known functions, and lists split by
//! commas, slashes and spaces) and does not check it against the property's grammar. A value
//! with a part the shared model has no shape for, such as a string, a `url()`, `var()` or an
//! identifier that is neither a shared keyword nor a color, comes back whole as `Value.Text`.
import css_properties.catalog as catalog
import css_properties.catalog { Property }
import css_properties.keywords as keywords
import css_properties.keywords { Keyword }
import css_properties.values as values
import css_properties.values { Value, Declaration, Unit, MathOperator, Separator }
import css_properties.shorthands
import values as parsed_values
import values { Store, ValueId, Mode }
import colors
import colors { Color, Identity }
import cssom_declaration { StyleDeclaration }
import cssom_value_serialization
import computed { Engine, StyleId, ComputedValue }
import input { Input }
import lexer
import syntax
import tokens
import tokens { Kind, Limits, CssError, TokenBuffer, TokenRange }
import value_cursor { Cursor }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.collections.slice { Slice }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.text.string { String }

const COMMA: u8 = 0
const SLASH: u8 = 1
const PLUS_MINUS: u8 = 2
const TIMES_DIVIDE: u8 = 3

/// The written value `css` spells, such as `10px`, `calc(100% - 8px)` or `1px 2px / 50%`.
pub effect fn value(css: &[u8]) -> Value ! CssError | OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(css, &limits)
  let range = buffer.all()
  return run valueIn(&buffer, range.start, range.end)
}

/// Property-aware shaping preserves custom identifiers that happen to name colors.
pub effect fn propertyValue(property: Property, css: &[u8]) -> Value ! CssError | OutOfMemoryError ? &mut Allocator {
  let buffer = run lexer.tokenize(css, &Limits.make())
  let range = buffer.all()
  return run propertyValueIn(property, &buffer, range.start, range.end)
}
pub effect fn propertyValueIn(property: Property, buffer: &TokenBuffer, start: usize, end: usize) -> Value ! OutOfMemoryError ? &mut Allocator {
  if property != Property.ContainerName && property != Property.Container { return run valueIn(buffer, start, end) }
  let first = skipSpace(buffer, start, end)
  let last = trimEnd(buffer, first, end)
  if first + 1 == last {
    if let Kind.Ident { text } = buffer.tokens.asSlice()[first].kind {
      if let Option<Keyword>.Some { value: keyword } = keywords.lookup(buffer.text(text)) {
        if keyword == Keyword.Initial || keyword == Keyword.Inherit || keyword == Keyword.Unset || keyword == Keyword.Revert || keyword == Keyword.RevertLayer || keyword == Keyword.None {
          return values.keyword(keyword)
        }
      }
    }
  }
  return run values.text(sourceText(buffer, first, last))
}

/// `value` with CSS text read into shapes where it has them. Other values are copied.
pub effect fn resolve(written: &Value) -> Value ! CssError | OutOfMemoryError ? &mut Allocator {
  match &written.* {
    Value.Text { css } => {
      return run value(css.asSlice())
    }
    _ => {
      return run values.clone(written)
    }
  }
}

/// The declarations of a declaration block such as `width: 10px; color: red !important`.
/// As in CSS, a declaration that does not parse is dropped; so is one whose property is not
/// in the shared catalog, custom properties included.
pub effect fn declarations(css: &[u8]) -> List<Declaration>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(css, &limits)
  let parsed = run syntax.parseDeclarations(&buffer, buffer.all(), &limits)
  let items = parsed.asSlice()
  let mut out = List<Declaration>.make()
  let mut i: usize = 0
  while i < items.length {
    let item = items[i]
    match &catalog.lookup(buffer.text(item.name)) {
      Option<Property>.Some { value: property } => {
        if skipSpace(&buffer, item.value.start, item.value.end) < item.value.end {
          let shaped = run propertyValueIn(property, &buffer, item.value.start, item.value.end)
          run out.append(Declaration { property: property, value: move shaped, important: item.important })
        }
      }
      _ => {}
    }
    i = i + 1
  }
  return move out
}

/// The declarations of a CSSOM declaration block as shared declarations, in its order.
/// It holds what css-style's own grammars accepted, so only the properties css-style knows.
pub effect fn fromStyle(style: &StyleDeclaration) -> List<Declaration>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<Declaration>.make()
  let mut i: usize = 0
  while i < style.length() {
    let name = style.item(i)
    match &catalog.lookup(name) {
      Option<Property>.Some { value: property } => {
        let text = run style.getPropertyValue(name)
        if text.asSlice().length > 0 {
          let parsed = run propertyValue(property, text.asSlice())
          run out.append(
            Declaration {
              property: property,
              value: move parsed,
              important: style.getPropertyPriority(name).length > 0,
            },
          )
        }
      }
      _ => {}
    }
    i = i + 1
  }
  return move out
}

/// Project a written shorthand to one longhand. Box values use their typed
/// expansion; complex text/effect/animation values use the shared CSS grammars.
/// None means this declaration has no valid value for the requested longhand.
pub effect fn longhand(declaration: &Declaration, target: Property) -> Option<Value>
  ! CssError | OutOfMemoryError ? &mut Allocator {
  if declaration.property == target { return Option<Value>.some(run values.clone(&declaration.value)) }
  let mut at: usize = 0
  let count = catalog.longhandCount(declaration.property)
  while at < count && catalog.longhandAt(declaration.property, at) != target { at = at + 1 }
  if at == count { return Option<Value>.None }
  if declaration.property == Property.Container {
    if let Value.Keyword { value: word } = &declaration.value {
      if word == Keyword.Initial || word == Keyword.Inherit || word == Keyword.Unset || word == Keyword.Revert || word == Keyword.RevertLayer {
        return Option<Value>.some(run values.clone(&declaration.value))
      }
    }
    return run containerLonghand(&declaration.value, target)
  }
  if declaration.property == Property.Background {
    if let Value.Text { css } = &declaration.value {
      if let Option<Value>.Some { value: found } = move run backgroundWords(css.asSlice(), target) {
        return Option<Value>.some(move found)
      }
    }
  }
  let expanded = run shorthands.longhand(declaration.property, &declaration.value, target)
  if let Option<Value>.Some { value: found } = move expanded { return Option<Value>.some(move found) }
  let text = run values.cssText(&declaration.value)
  let buffer = run lexer.tokenize(text.asSlice(), &Limits.make())
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  if let Option<ValueId>.Some { value: parsed } = &(run parsed_values.parse(&mut store, declaration.property, &input, Mode.Css)) {
    let css = run cssom_value_serialization.value(&store, parsed, declaration.property, target)
    if css.length() != 0 { return Option<Value>.some(run value(css.asSlice())) }
  }
  return Option<Value>.None
}

fn wordByte(byte: u8) -> bool {
  return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)
    || byte == 45
    || byte == 95
    || byte >= 128
}

// What a `background` layer spelled that the shared model has no shape for.
struct LayerWords {
  /// Whether it has `local`.
  local: bool,
  /// Its `url()` image, empty without one.
  image: Bytes,
}

// The end of the comma-separated item of `text` that starts at `at`.
fn itemEnd(text: &[u8], at: usize) -> usize {
  let mut depth: usize = 0
  let mut quote: u8 = 0
  let mut i = at
  while i < text.length {
    let byte = text[i]
    if quote != 0 {
      if byte == 92 { i = i + 1 } else if byte == quote { quote = 0 }
    } else if byte == 34 || byte == 39 {
      quote = byte
    } else if byte == 40 {
      depth = depth + 1
    } else if byte == 41 {
      if depth > 0 { depth = depth - 1 }
    } else if depth == 0 && byte == 44 {
      return i
    }
    i = i + 1
  }
  return text.length
}

// Whether `word` names a gradient the shared model has no shape for: every one but
// `linear-gradient`.
fn unshapedGradient(word: &[u8]) -> bool {
  return tokens.insensitive(word, b"radial-gradient") || tokens.insensitive(word, b"conic-gradient")
    || tokens.insensitive(word, b"repeating-linear-gradient")
    || tokens.insensitive(word, b"repeating-radial-gradient")
    || tokens.insensitive(word, b"repeating-conic-gradient")
}

// A `background` value that spells a `url()` image, a gradient other than `linear-gradient`, `repeat-x`, `repeat-y` or `local`,
// which the shared model has no shape for: read with `none`, the two-value repeats and
// `scroll` in their places, then with the images and `local` put back in their layers of
// `background-image` and `background-attachment`. None when it has none of them.
effect fn backgroundWords(css: &[u8], target: Property) -> Option<Value>
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let mut plain = Bytes.make()
  let mut layers = List<LayerWords>.make()
  let mut current = LayerWords { local: false, image: Bytes.make() }
  let mut changed = false
  let mut i: usize = 0
  while i < css.length {
    let byte = css[i]
    if byte == 44 {
      run layers.append(Intrinsic.replace(current, LayerWords { local: false, image: Bytes.make() }))
    } else if byte == 34 || byte == 39 || byte == 40 {
      // A string or a block the shared model reads or refuses whole.
      let mut end = i + 1
      let mut depth: usize = if byte == 40 { 1 } else { 0 }
      let mut quote: u8 = if byte == 40 { 0 } else { byte }
      while end < css.length && (depth > 0 || quote != 0) {
        let inner = css[end]
        if quote != 0 {
          if inner == 92 { end = end + 1 } else if inner == quote { quote = 0 }
        } else if inner == 34 || inner == 39 {
          quote = inner
        } else if inner == 40 {
          depth = depth + 1
        } else if inner == 41 {
          depth = depth - 1
        }
        end = end + 1
      }
      if end > css.length { end = css.length }
      run Bytes.append(&mut plain, Slice.view(css, i, end - i))
      i = end
      continue
    } else if wordByte(byte) {
      let mut end = i
      while end < css.length && wordByte(css[end]) { end = end + 1 }
      let word = Slice.view(css, i, end - i)
      let called = end < css.length && css[end] == 40
      if called && (tokens.insensitive(word, b"url") || tokens.insensitive(word, b"image-set")
        || tokens.insensitive(word, b"-webkit-image-set") || unshapedGradient(word)) {
        if current.image.length() != 0 { return Option<Value>.None }
        let close = itemEnd(css, end)
        let mut stop = end + 1
        let mut quote: u8 = 0
        let mut depth: usize = 0
        while stop < close && (quote != 0 || depth > 0 || css[stop] != 41) {
          if quote != 0 {
            if css[stop] == 92 { stop = stop + 1 } else if css[stop] == quote { quote = 0 }
          } else if css[stop] == 34 || css[stop] == 39 {
            quote = css[stop]
          } else if css[stop] == 40 {
            depth = depth + 1
          } else if css[stop] == 41 {
            depth = depth - 1
          }
          stop = stop + 1
        }
        if stop >= css.length { return Option<Value>.None }
        current.image = run Bytes.copy(Slice.view(css, i, stop + 1 - i))
        // A gradient holds the image's place: `none` could also be written beside it.
        run Bytes.append(&mut plain, b"linear-gradient(red, red)")
        changed = true
        i = stop + 1
        continue
      }
      if !called && tokens.insensitive(word, b"repeat-x") {
        run Bytes.append(&mut plain, b"repeat no-repeat")
        changed = true
      } else if !called && tokens.insensitive(word, b"repeat-y") {
        run Bytes.append(&mut plain, b"no-repeat repeat")
        changed = true
      } else if !called && tokens.insensitive(word, b"local") {
        run Bytes.append(&mut plain, b"scroll")
        current.local = true
        changed = true
      } else {
        run Bytes.append(&mut plain, word)
      }
      i = end
      continue
    }
    run Bytes.append(&mut plain, Slice.view(css, i, 1))
    i = i + 1
  }
  if !changed { return Option<Value>.None }
  run layers.append(move current)
  let shaped = run value(plain.asSlice())
  let found = run shorthands.longhand(Property.Background, &shaped, target)
  let image = target == Property.BackgroundImage
  if !(image || target == Property.BackgroundAttachment) { return move found }
  let listed = match move found {
    Option<Value>.Some { value: listed } => move listed
    Option<Value>.None => { return Option<Value>.None }
  }
  // One item a layer, with what the layer spelled put back.
  let spelled = run values.cssText(&listed)
  let text = spelled.asSlice()
  let mut out = Bytes.make()
  let mut layer: usize = 0
  let mut at: usize = 0
  while at <= text.length {
    let end = itemEnd(text, at)
    if layer > 0 { run Bytes.append(&mut out, b", ") }
    let words = &layers.asSlice()[if layer < layers.length() { layer } else { layers.length() - 1 }]
    if image && words.image.length() != 0 {
      run Bytes.append(&mut out, words.image.asSlice())
    } else if !image && words.local {
      run Bytes.append(&mut out, b"local")
    } else {
      let mut from = at
      while from < end && text[from] == 32 { from = from + 1 }
      run Bytes.append(&mut out, Slice.view(text, from, end - from))
    }
    layer = layer + 1
    at = end + 1
  }
  return Option<Value>.some(run value(out.asSlice()))
}

effect fn containerLonghand(specified: &Value, target: Property) -> Option<Value> ! CssError | OutOfMemoryError ? &mut Allocator {
  let text = run values.cssText(specified)
  let buffer = run lexer.tokenize(text.asSlice(), &Limits.make())
  let range = buffer.all()
  let mut slash = range.end
  let mut names: usize = 0
  let mut none = false
  let mut i = range.start
  while i < range.end {
    match buffer.tokens.asSlice()[i].kind {
      Kind.Whitespace => {}
      Kind.Delim { scalar } => {
        if scalar != 47 || slash != range.end || names == 0 { return Option<Value>.None }
        slash = i
      }
      Kind.Ident { text: word } => {
        if slash == range.end {
          let name = buffer.text(word)
          if tokens.insensitive(name, b"and") || tokens.insensitive(name, b"or") || tokens.insensitive(name, b"not") || tokens.insensitive(name, b"default")
            || tokens.insensitive(name, b"initial") || tokens.insensitive(name, b"inherit") || tokens.insensitive(name, b"unset") || tokens.insensitive(name, b"revert") || tokens.insensitive(name, b"revert-layer") { return Option<Value>.None }
          none = none || tokens.insensitive(name, b"none")
          names = names + 1
        }
      }
      _ => { return Option<Value>.None }
    }
    i = i + 1
  }
  if names == 0 || none && names != 1 { return Option<Value>.None }
  let mut kind = Keyword.Normal
  if slash != range.end {
    let first = skipSpace(&buffer, slash + 1, range.end)
    if first >= range.end || skipSpace(&buffer, first + 1, range.end) != range.end { return Option<Value>.None }
    if let Kind.Ident { text: word } = buffer.tokens.asSlice()[first].kind {
      let name = buffer.text(word)
      if tokens.insensitive(name, b"size") { kind = Keyword.Size }
      else if tokens.insensitive(name, b"inline-size") { kind = Keyword.InlineSize }
      else if !tokens.insensitive(name, b"normal") { return Option<Value>.None }
    } else { return Option<Value>.None }
  }
  if target == Property.ContainerType { return Option<Value>.some(values.keyword(kind)) }
  return Option<Value>.some(run propertyValueIn(Property.ContainerName, &buffer, range.start, slash))
}

/// The computed value of `property` in a style the cascade built, as a written value ready
/// for `css_properties.convert`. None when the style has no value for the property, as for
/// a shorthand.
pub effect fn computedValue(engine: &Engine<'_>, style: StyleId, property: Property) -> Option<
  Value
>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let entry = match &engine.get(style, property) {
    Option<ComputedValue>.Some { value: found } => found
    _ => {
      return Option<Value>.None
    }
  }
  let css = run cssom_value_serialization.computedValue(
    &engine.values,
    entry.value,
    entry.sourceProperty,
    property,
  )
  if css.length() == 0 {
    return Option<Value>.None
  }
  return Option<Value>.some(run value(css.asSlice()))
}

fn isEnv(buffer: &TokenBuffer, at: usize) -> bool {
  return match &buffer.tokens.asSlice()[at].kind {
    Kind.Function { name } => tokens.insensitive(buffer.text(name), b"env")
    _ => false
  }
}

fn mentionsEnv(buffer: &TokenBuffer, start: usize, end: usize) -> bool {
  let mut at = start
  while at < end {
    if isEnv(buffer, at) { return true }
    at = at + 1
  }
  return false
}

// The environment variables a host defines. Silk UI has no safe area, title bar or keyboard
// insets to report yet, so each is 0px.
// https://drafts.csswg.org/css-env-1/#safe-area-insets
fn knownEnv(name: &[u8]) -> bool {
  let sides: [&[u8]; 4] = [b"top", b"right", b"bottom", b"left"]
  let prefixes: [&[u8]; 3] = [b"safe-area-inset-", b"safe-area-max-inset-", b"keyboard-inset-"]
  let mut p: usize = 0
  while p < prefixes.length {
    let prefix = prefixes[p]
    if name.length > prefix.length && tokens.insensitive(Slice.view<u8>(name, 0, prefix.length), prefix) {
      let rest = Slice.view<u8>(name, prefix.length, name.length - prefix.length)
      let mut i: usize = 0
      while i < sides.length {
        if tokens.insensitive(rest, sides[i]) { return true }
        i = i + 1
      }
      if p == 2 && (tokens.insensitive(rest, b"width") || tokens.insensitive(rest, b"height")) { return true }
    }
    p = p + 1
  }
  return tokens.insensitive(name, b"titlebar-area-x") || tokens.insensitive(name, b"titlebar-area-y")
    || tokens.insensitive(name, b"titlebar-area-width") || tokens.insensitive(name, b"titlebar-area-height")
}

/// Spells `start..end` with each `env()` replaced by its value, or by its fallback when the
/// name is not one the host defines. False when an unknown name has no fallback: the
/// declaration is then invalid at computed-value time.
/// https://drafts.csswg.org/css-env-1/#env-function
effect fn withEnv(buffer: &TokenBuffer, start: usize, end: usize, out: &mut Bytes) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let items = buffer.tokens.asSlice()
  let source = buffer.source()
  let mut at = start
  while at < end {
    if !isEnv(buffer, at) {
      let span = items[at].source
      if span.start <= span.end && span.end <= source.length {
        run out.append(Slice.view<u8>(source, span.start, span.end - span.start))
      }
      at = at + 1
      continue
    }
    let after = afterBlock(buffer, at, end)
    let close = if items[at].matching + 1 == after { after - 1 } else { after }
    let first = skipSpace(buffer, at + 1, close)
    let named = if first < close {
      match &items[first].kind {
        Kind.Ident { text } => knownEnv(buffer.text(text))
        _ => false
      }
    } else { false }
    let mut comma = first
    while comma < close {
      let separator = match &items[comma].kind {
        Kind.Comma => true
        _ => false
      }
      if separator { break }
      comma = comma + 1
    }
    if named {
      run out.append(b"0px")
    } else if comma < close {
      // A space keeps the fallback from fusing with what comes before it.
      run out.append(b" ")
      if !run withEnv(buffer, comma + 1, close, &mut out.*) { return false }
      run out.append(b" ")
    } else {
      return false
    }
    at = after
  }
  return true
}

effect fn noTokens(error: CssError) -> Option<TokenBuffer> {
  drop error
  return Option<TokenBuffer>.None
}

effect fn tokenized(css: &[u8]) -> Option<TokenBuffer> ! CssError | OutOfMemoryError ? &mut Allocator {
  return Option<TokenBuffer>.some(run lexer.tokenize(css, &Limits.make()))
}

/// The value in the tokens `start..end`: its shape, or the source text when it has none.
pub effect fn valueIn(buffer: &TokenBuffer, start: usize, end: usize) -> Value
  ! OutOfMemoryError
  ? &mut Allocator {
  if mentionsEnv(buffer, start, end) {
    let mut css = Bytes.make()
    if run withEnv(buffer, start, end, &mut css) {
      match move run Effect.catch<CssError>(tokenized(css.asSlice()), noTokens) {
        Option<TokenBuffer>.Some { value: spelled } => {
          let range = spelled.all()
          return run valueIn(&spelled, range.start, range.end)
        }
        _ => {}
      }
    }
  }
  let first = skipSpace(buffer, start, end)
  let last = trimEnd(buffer, first, end)
  let mut one = List<Value>.make()
  if first < last {
    let shaped = run list(buffer, first, last, COMMA, &mut one)
    if shaped && one.length() == 1 {
      return one.remove(0)
    }
  }
  return run values.text(sourceText(buffer, first, last))
}

fn sourceText(buffer: &TokenBuffer, start: usize, end: usize) -> &[u8] {
  if start >= end {
    return b""
  }
  let items = buffer.tokens.asSlice()
  let from = items[start].source.start
  let to = items[end - 1].source.end
  let source = buffer.source()
  if from > to || to > source.length {
    return b""
  }
  return Slice.view<u8>(source, from, to - from)
}

fn isSpace(kind: &Kind) -> bool {
  return match &kind.* {
    Kind.Whitespace => true
    _ => false
  }
}

fn skipSpace(buffer: &TokenBuffer, start: usize, end: usize) -> usize {
  let items = buffer.tokens.asSlice()
  let mut at = start
  while at < end && isSpace(&items[at].kind) {
    at = at + 1
  }
  return at
}

fn trimEnd(buffer: &TokenBuffer, start: usize, end: usize) -> usize {
  let items = buffer.tokens.asSlice()
  let mut at = end
  while at > start && isSpace(&items[at - 1].kind) {
    at = at - 1
  }
  return at
}

/// The token after the block or function opened at `at`, at most `end`.
fn afterBlock(buffer: &TokenBuffer, at: usize, end: usize) -> usize {
  let matching = buffer.tokens.asSlice()[at].matching
  if matching <= at || matching >= end {
    return end
  }
  return matching + 1
}

fn opens(kind: &Kind) -> bool {
  return match &kind.* {
    Kind.Function { .. } => true
    Kind.OpenParen => true
    Kind.OpenSquare => true
    Kind.OpenBrace => true
    _ => false
  }
}

fn separates(kind: &Kind, separator: u8) -> bool {
  return match &kind.* {
    Kind.Comma => separator == COMMA
    Kind.Delim { scalar } => (separator == SLASH && scalar == 47)
      || (separator == PLUS_MINUS && (scalar == 43 || scalar == 45))
      || (separator == TIMES_DIVIDE && (scalar == 42 || scalar == 47))
    _ => false
  }
}

/// The next `separator` in `start..end` outside any block, or `end`.
fn find(buffer: &TokenBuffer, start: usize, end: usize, separator: u8) -> usize {
  let items = buffer.tokens.asSlice()
  let mut at = start
  while at < end {
    if separates(&items[at].kind, separator) {
      return at
    }
    at = if opens(&items[at].kind) {
      afterBlock(buffer, at, end)
    } else {
      at + 1
    }
  }
  return end
}

/// Appends the one value of `start..end`, a list split by `separator` when it has several
/// parts. Commas bind loosest, then slashes, then spaces.
effect fn list(buffer: &TokenBuffer, start: usize, end: usize, separator: u8, out: &mut List<Value>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if find(buffer, start, end, separator) == end {
    if separator == COMMA {
      return run list(buffer, start, end, SLASH, &mut out.*)
    }
    return run words(buffer, start, end, &mut out.*)
  }
  let mut parts = List<Value>.make()
  let mut at = start
  while at <= end {
    let stop = find(buffer, at, end, separator)
    let ok = if separator == COMMA {
      run list(buffer, at, stop, SLASH, &mut parts)
    } else {
      run words(buffer, at, stop, &mut parts)
    }
    if !ok {
      return false
    }
    at = stop + 1
  }
  run out.append(
    Value.Sequence {
      separator: if separator == COMMA {
        Separator.Comma
      } else {
        Separator.Slash
      },
      values: move parts,
    },
  )
  return true
}

/// Appends the one value of the space-separated components in `start..end`.
effect fn words(buffer: &TokenBuffer, start: usize, end: usize, out: &mut List<Value>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let first = skipSpace(buffer, start, end)
  let last = trimEnd(buffer, first, end)
  if first >= last {
    return false
  }
  let single = if opens(&buffer.tokens.asSlice()[first].kind) {
    afterBlock(buffer, first, last) == last
  } else {
    first + 1 == last
  }
  if single {
    let next = run component(buffer, first, last, &mut out.*)
    return next == last
  }
  let mut parts = List<Value>.make()
  let mut at = first
  while at < last {
    let next = run component(buffer, at, last, &mut parts)
    if next == 0 {
      return false
    }
    at = skipSpace(buffer, next, last)
  }
  run out.append(Value.Sequence { separator: Separator.Space, values: move parts })
  return true
}

/// Appends the component at `at` and returns the token after it, or 0 when the shared model
/// has no shape for it.
effect fn component(buffer: &TokenBuffer, at: usize, end: usize, out: &mut List<Value>) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let token = buffer.tokens.asSlice()[at]
  match &token.kind {
    Kind.Ident { text } => {
      match &keywords.lookup(buffer.text(text)) {
        Option<Keyword>.Some { value: word } => {
          run out.append(Value.Keyword { value: word })
          return at + 1
        }
        _ => {}
      }
      if run color(buffer, at, at + 1, &mut out.*) {
        return at + 1
      }
      return 0
    }
    Kind.Hash { .. } => {
      if run color(buffer, at, at + 1, &mut out.*) {
        return at + 1
      }
      return 0
    }
    Kind.Number { value: amount, .. } => {
      run out.append(Value.Unit { value: f64.toF32(amount), unit: Unit.Number })
      return at + 1
    }
    Kind.Percentage { value: amount, .. } => {
      run out.append(Value.Unit { value: f64.toF32(amount), unit: Unit.Percent })
      return at + 1
    }
    Kind.Dimension { value: amount, unit, .. } => {
      match &values.unitLookup(buffer.text(unit)) {
        Option<Unit>.Some { value: known } => {
          run out.append(Value.Unit { value: f64.toF32(amount), unit: known })
          return at + 1
        }
        _ => {
          return 0
        }
      }
    }
    Kind.Function { name } => {
      let after = afterBlock(buffer, at, end)
      // The closing parenthesis, or the end of the input for a function left open.
      let close = if buffer.tokens.asSlice()[at].matching + 1 == after {
        after - 1
      } else {
        after
      }
      let spelled = buffer.text(name)
      let done = if tokens.insensitive(spelled, b"calc") {
        run calc(buffer, at + 1, close, &mut out.*)
      } else if tokens.insensitive(spelled, b"min") {
        run mathList(buffer, at + 1, close, MathOperator.Min, &mut out.*)
      } else if tokens.insensitive(spelled, b"max") {
        run mathList(buffer, at + 1, close, MathOperator.Max, &mut out.*)
      } else if tokens.insensitive(spelled, b"clamp") {
        run mathList(buffer, at + 1, close, MathOperator.Clamp, &mut out.*)
      } else if foldable(spelled) {
        run folded(buffer, spelled, at + 1, close, &mut out.*)
      } else if run color(buffer, at, after, &mut out.*) {
        true
      } else {
        run function(buffer, spelled, at + 1, close, &mut out.*)
      }
      if done {
        return after
      }
      return 0
    }
    _ => {
      return 0
    }
  }
}

/// Appends the absolute color spelled by exactly the tokens `start..end`.
effect fn color(buffer: &TokenBuffer, start: usize, end: usize, out: &mut List<Value>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let source = Input.Contiguous { buffer: buffer, range: TokenRange { start: start, end: end } }
  let mut cursor = Cursor.make(&source)
  let parsed = run colors.parse(&source, &mut cursor)
  match &parsed {
    Option<Color>.Some { value: found } => {
      if !cursor.done(&source) {
        return false
      }
      // `currentcolor` and system colors have no fixed channels to carry.
      match &found.identity {
        Identity.Absolute => {}
        _ => {
          return false
        }
      }
      let rgba = colors.toSrgb(found)
      run out.append(
        Value.Color {
          value: Rgba<f32> {
            r: f64.toF32(rgba.r),
            g: f64.toF32(rgba.g),
            b: f64.toF32(rgba.b),
            a: f64.toF32(rgba.a),
          },
        },
      )
      return true
    }
    _ => {
      return false
    }
  }
}

/// Appends `name(a, b, ...)` for a function the shared keywords name.
effect fn function(buffer: &TokenBuffer, name: &[u8], start: usize, end: usize, out: &mut List<Value>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if isGradient(name) && hasModernColor(buffer, start, end) {
    return false
  }
  match &keywords.lookup(name) {
    Option<Keyword>.Some { value: known } => {
      let mut arguments = List<Value>.make()
      let mut at = start
      while at <= end {
        let stop = find(buffer, at, end, COMMA)
        if !run list(buffer, at, stop, SLASH, &mut arguments) {
          return false
        }
        at = stop + 1
      }
      run out.append(Value.Function { name: known, values: move arguments })
      return true
    }
    _ => {
      return false
    }
  }
}

fn isGradient(name: &[u8]) -> bool {
  let suffix = b"-gradient"
  if name.length < suffix.length {
    return false
  }
  return tokens.insensitive(Slice.view<u8>(name, name.length - suffix.length, suffix.length), suffix)
}

/// Whether `start..end` spells a color other than a legacy sRGB one (`lab()`, `oklch()`,
/// `color()`, ...). A gradient with one keeps its tokens: folding the stops into sRGB `rgb()`
/// would lose the chroma a mix in another space starts from, and the Oklab default it picks.
fn hasModernColor(buffer: &TokenBuffer, start: usize, end: usize) -> bool {
  let items = buffer.tokens.asSlice()
  let mut at = start
  while at < end && at < items.length {
    match &items[at].kind {
      Kind.Function { name } => {
        let spelled = buffer.text(name)
        if tokens.insensitive(spelled, b"lab") || tokens.insensitive(spelled, b"lch")
          || tokens.insensitive(spelled, b"oklab")
          || tokens.insensitive(spelled, b"oklch")
          || tokens.insensitive(spelled, b"color")
          || tokens.insensitive(spelled, b"color-mix") {
          return true
        }
      }
      _ => {}
    }
    at = at + 1
  }
  return false
}

/// Appends `calc(...)` for the expression in `start..end`. A sum writes its own `calc()`, so
/// anything else is kept as a sum of one term.
effect fn calc(buffer: &TokenBuffer, start: usize, end: usize, out: &mut List<Value>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if find(buffer, start, end, PLUS_MINUS) < end || find(buffer, start, end, TIMES_DIVIDE) < end {
    return run sum(buffer, start, end, &mut out.*)
  }
  let mut term = List<Value>.make()
  if !run sum(buffer, start, end, &mut term) {
    return false
  }
  run out.append(Value.Math { operator: MathOperator.Sum, values: move term })
  return true
}

/// Appends `min()`, `max()` or `clamp()` with one expression per argument.
effect fn mathList(
  buffer: &TokenBuffer,
  start: usize,
  end: usize,
  operator: MathOperator,
  out: &mut List<Value>,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut arguments = List<Value>.make()
  let mut at = start
  while at <= end {
    let stop = find(buffer, at, end, COMMA)
    if !run sum(buffer, at, stop, &mut arguments) {
      return false
    }
    at = stop + 1
  }
  run out.append(Value.Math { operator: operator, values: move arguments })
  return true
}

// The math functions read here when their arguments are constants, as one number or
// dimension: the trigonometric, exponential, sign and stepped-value functions.
const FOLDABLE: [string<'static>; 17] = [
  "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "pow", "sqrt", "hypot", "log", "exp",
  "abs", "sign", "mod", "rem", "round",
]

fn foldable(name: &[u8]) -> bool {
  let mut i: usize = 0
  while i < FOLDABLE.length {
    if tokens.insensitive(name, String.utf8Bytes(FOLDABLE[i])) { return true }
    i = i + 1
  }
  return false
}

// A constant: a number, or an amount of one unit. Angles are in degrees.
struct Constant {
  value: f32,
  unit: Unit,
}

impl Copy for Constant {}

fn degrees(value: f32, unit: Unit) -> Option<f32> {
  return match unit {
    Unit.Deg => Option<f32>.some(value)
    Unit.Grad => Option<f32>.some(value * 0.9)
    Unit.Rad => Option<f32>.some(value * 57.29578)
    Unit.Turn => Option<f32>.some(value * 360.0)
    _ => Option<f32>.None
  }
}

// The constant `value` is, when it is one without knowing a font or a box.
fn constantOf(value: &Value) -> Option<Constant> {
  match &value.* {
    Value.Unit { value: amount, unit } => {
      if let Option<f32>.Some { value: turned } = degrees(amount, unit) {
        return Option<Constant>.some(Constant { value: turned, unit: Unit.Deg })
      }
      return Option<Constant>.some(Constant { value: amount, unit: unit })
    }
    Value.Math { operator, values: items } => {
      let list = items.asSlice()
      if list.length == 0 { return Option<Constant>.None }
      let first = match constantOf(&list[0]) {
        Option<Constant>.Some { value: found } => found
        Option<Constant>.None => { return Option<Constant>.None }
      }
      if operator == MathOperator.Negate {
        return Option<Constant>.some(Constant { value: 0.0 - first.value, unit: first.unit })
      }
      if operator == MathOperator.Invert {
        if first.unit != Unit.Number || first.value == 0.0 { return Option<Constant>.None }
        return Option<Constant>.some(Constant { value: 1.0 / first.value, unit: Unit.Number })
      }
      let mut total = first
      let mut i: usize = 1
      while i < list.length {
        let next = match constantOf(&list[i]) {
          Option<Constant>.Some { value: found } => found
          Option<Constant>.None => { return Option<Constant>.None }
        }
        if operator == MathOperator.Product {
          if total.unit != Unit.Number && next.unit != Unit.Number { return Option<Constant>.None }
          total = Constant { value: total.value * next.value, unit: if total.unit == Unit.Number { next.unit } else { total.unit } }
        } else {
          if next.unit != total.unit { return Option<Constant>.None }
          if operator == MathOperator.Sum {
            total.value = total.value + next.value
          } else if operator == MathOperator.Min {
            total.value = f32.min(total.value, next.value)
          } else if operator == MathOperator.Max {
            total.value = f32.max(total.value, next.value)
          } else {
            // clamp(low, value, high): the value held between the two.
            if list.length != 3 { return Option<Constant>.None }
            if i == 1 { total.value = f32.max(total.value, next.value) } else { total.value = f32.min(total.value, next.value) }
          }
        }
        i = i + 1
      }
      return Option<Constant>.some(total)
    }
    _ => {}
  }
  return Option<Constant>.None
}

// `value` to a multiple of `step`: 0 nearest, 1 up, 2 down, 3 toward zero.
fn stepped(value: f32, step: f32, strategy: u8) -> f32 {
  if step == 0.0 { return f32.NAN }
  let ratio = value / step
  let whole = if strategy == 1 {
    f32.ceil(ratio)
  } else if strategy == 2 {
    f32.floor(ratio)
  } else if strategy == 3 {
    f32.trunc(ratio)
  } else {
    f32.floor(ratio + 0.5)
  }
  return whole * step
}

/// Appends the value of the math function `name` over the arguments in `start..end`, when
/// they are constants: `sin(30deg)` is `0.5`, `pow(2, 3)` is `8` and `round(up, 13px, 4px)`
/// is `16px`. False for arguments that depend on a font or a box.
effect fn folded(buffer: &TokenBuffer, name: &[u8], start: usize, end: usize, out: &mut List<Value>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = start
  let mut strategy: u8 = 0
  if tokens.insensitive(name, b"round") {
    let first = skipSpace(buffer, start, end)
    if first < end {
      if let Kind.Ident { text } = buffer.tokens.asSlice()[first].kind {
        let word = buffer.text(text)
        let chosen: u8 = if tokens.insensitive(word, b"nearest") {
          0
        } else if tokens.insensitive(word, b"up") {
          1
        } else if tokens.insensitive(word, b"down") {
          2
        } else if tokens.insensitive(word, b"to-zero") {
          3
        } else {
          4
        }
        if chosen < 4 {
          let stop = find(buffer, start, end, COMMA)
          if stop == end || trimEnd(buffer, first, stop) != first + 1 { return false }
          strategy = chosen
          at = stop + 1
        }
      }
    }
  }
  let mut arguments = List<Constant>.make()
  while at <= end {
    let stop = find(buffer, at, end, COMMA)
    let mut shaped = List<Value>.make()
    if !run sum(buffer, at, stop, &mut shaped) { return false }
    match constantOf(&shaped.asSlice()[0]) {
      Option<Constant>.Some { value: found } => { run arguments.append(found) }
      Option<Constant>.None => { return false }
    }
    at = stop + 1
  }
  let list = arguments.asSlice()
  if list.length == 0 { return false }
  let a = list[0]
  let plain = a.unit == Unit.Number
  let mut result = Constant { value: 0.0, unit: Unit.Number }
  if tokens.insensitive(name, b"sin") || tokens.insensitive(name, b"cos") || tokens.insensitive(name, b"tan") {
    if list.length != 1 || !(plain || a.unit == Unit.Deg) { return false }
    let radians = if plain { a.value } else { a.value * 0.017453292 }
    result.value = if tokens.insensitive(name, b"sin") {
      f32.sin(radians)
    } else if tokens.insensitive(name, b"cos") {
      f32.cos(radians)
    } else {
      f32.tan(radians)
    }
  } else if tokens.insensitive(name, b"asin") || tokens.insensitive(name, b"acos") || tokens.insensitive(name, b"atan") {
    if list.length != 1 || !plain { return false }
    let radians = if tokens.insensitive(name, b"asin") {
      f32.asin(a.value)
    } else if tokens.insensitive(name, b"acos") {
      f32.acos(a.value)
    } else {
      f32.atan(a.value)
    }
    result = Constant { value: radians * 57.29578, unit: Unit.Deg }
  } else if tokens.insensitive(name, b"atan2") {
    if list.length != 2 || list[1].unit != a.unit { return false }
    result = Constant { value: f32.atan2(a.value, list[1].value) * 57.29578, unit: Unit.Deg }
  } else if tokens.insensitive(name, b"pow") {
    if list.length != 2 || !plain || list[1].unit != Unit.Number { return false }
    result.value = f32.pow(a.value, list[1].value)
  } else if tokens.insensitive(name, b"sqrt") || tokens.insensitive(name, b"exp") {
    if list.length != 1 || !plain { return false }
    result.value = if tokens.insensitive(name, b"sqrt") { f32.sqrt(a.value) } else { f32.exp(a.value) }
  } else if tokens.insensitive(name, b"log") {
    if list.length > 2 || !plain { return false }
    result.value = f32.log(a.value)
    if list.length == 2 {
      if list[1].unit != Unit.Number { return false }
      result.value = result.value / f32.log(list[1].value)
    }
  } else if tokens.insensitive(name, b"hypot") {
    let mut squares: f32 = 0.0
    let mut i: usize = 0
    while i < list.length {
      if list[i].unit != a.unit { return false }
      squares = squares + list[i].value * list[i].value
      i = i + 1
    }
    result = Constant { value: f32.sqrt(squares), unit: a.unit }
  } else if tokens.insensitive(name, b"abs") {
    if list.length != 1 { return false }
    result = Constant { value: f32.abs(a.value), unit: a.unit }
  } else if tokens.insensitive(name, b"sign") {
    if list.length != 1 { return false }
    result.value = if a.value > 0.0 { 1.0 } else if a.value < 0.0 { 0.0 - 1.0 } else { 0.0 }
  } else if tokens.insensitive(name, b"mod") || tokens.insensitive(name, b"rem") {
    if list.length != 2 || list[1].unit != a.unit || list[1].value == 0.0 { return false }
    let step = list[1].value
    let whole = if tokens.insensitive(name, b"mod") { f32.floor(a.value / step) } else { f32.trunc(a.value / step) }
    result = Constant { value: a.value - whole * step, unit: a.unit }
  } else {
    // round(strategy?, value, step?): the step is 1 for a number.
    if list.length > 2 || (list.length == 1 && !plain) { return false }
    if list.length == 2 && list[1].unit != a.unit { return false }
    let step: f32 = if list.length == 2 { list[1].value } else { 1.0 }
    result = Constant { value: stepped(a.value, step, strategy), unit: a.unit }
  }
  if result.value != result.value { return false }
  run out.append(Value.Unit { value: result.value, unit: result.unit })
  return true
}

/// Appends the sum in `start..end`. `a - b` is `a + (-b)`, as in Typed OM.
effect fn sum(buffer: &TokenBuffer, start: usize, end: usize, out: &mut List<Value>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if find(buffer, start, end, PLUS_MINUS) == end {
    return run product(buffer, start, end, &mut out.*)
  }
  let items = buffer.tokens.asSlice()
  let mut terms = List<Value>.make()
  let mut at = start
  let mut negate = false
  while at <= end {
    let stop = find(buffer, at, end, PLUS_MINUS)
    if negate {
      let mut term = List<Value>.make()
      if !run product(buffer, at, stop, &mut term) {
        return false
      }
      let plain = match &term.asSlice()[0] {
        Value.Unit { value: amount, unit } => {
          run terms.append(Value.Unit { value: 0.0 - amount, unit: unit })
          true
        }
        _ => false
      }
      if !plain {
        run terms.append(Value.Math { operator: MathOperator.Negate, values: move term })
      }
    } else if !run product(buffer, at, stop, &mut terms) {
      return false
    }
    if stop < end {
      negate = separates(&items[stop].kind, PLUS_MINUS) && isMinus(&items[stop].kind)
    }
    at = stop + 1
  }
  run out.append(Value.Math { operator: MathOperator.Sum, values: move terms })
  return true
}

fn isMinus(kind: &Kind) -> bool {
  return match &kind.* {
    Kind.Delim { scalar } => scalar == 45
    _ => false
  }
}

fn isDivide(kind: &Kind) -> bool {
  return match &kind.* {
    Kind.Delim { scalar } => scalar == 47
    _ => false
  }
}

/// Appends the product in `start..end`. `a / b` is `a * (1 / b)`, as in Typed OM.
effect fn product(buffer: &TokenBuffer, start: usize, end: usize, out: &mut List<Value>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if find(buffer, start, end, TIMES_DIVIDE) == end {
    return run operand(buffer, start, end, &mut out.*)
  }
  let items = buffer.tokens.asSlice()
  let mut factors = List<Value>.make()
  let mut at = start
  let mut invert = false
  while at <= end {
    let stop = find(buffer, at, end, TIMES_DIVIDE)
    if invert {
      let mut factor = List<Value>.make()
      if !run operand(buffer, at, stop, &mut factor) {
        return false
      }
      run factors.append(Value.Math { operator: MathOperator.Invert, values: move factor })
    } else if !run operand(buffer, at, stop, &mut factors) {
      return false
    }
    if stop < end {
      invert = isDivide(&items[stop].kind)
    }
    at = stop + 1
  }
  run out.append(Value.Math { operator: MathOperator.Product, values: move factors })
  return true
}

/// Appends one operand: a number, a parenthesized expression or a nested math function.
effect fn operand(buffer: &TokenBuffer, start: usize, end: usize, out: &mut List<Value>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let first = skipSpace(buffer, start, end)
  let last = trimEnd(buffer, first, end)
  if first >= last {
    return false
  }
  let token = buffer.tokens.asSlice()[first]
  match &token.kind {
    Kind.OpenParen => {
      let after = afterBlock(buffer, first, last)
      if after != last {
        return false
      }
      let close = if token.matching + 1 == after {
        after - 1
      } else {
        after
      }
      return run sum(buffer, first + 1, close, &mut out.*)
    }
    Kind.Function { name } => {
      let after = afterBlock(buffer, first, last)
      if after != last {
        return false
      }
      let spelled = buffer.text(name)
      if tokens.insensitive(spelled, b"calc") {
        let close = if token.matching + 1 == after {
          after - 1
        } else {
          after
        }
        return run sum(buffer, first + 1, close, &mut out.*)
      }
      if !tokens.insensitive(spelled, b"min") && !tokens.insensitive(spelled, b"max")
        && !tokens.insensitive(spelled, b"clamp")
        && !foldable(spelled) {
        return false
      }
      let next = run component(buffer, first, last, &mut out.*)
      return next == last
    }
    Kind.Number { .. } => {}
    Kind.Percentage { .. } => {}
    Kind.Dimension { .. } => {}
    // The numeric constants of a math function.
    Kind.Ident { text } => {
      if first + 1 != last {
        return false
      }
      let name = buffer.text(text)
      let constant: f32 = if tokens.insensitive(name, b"infinity") {
        f32.INFINITY
      } else if tokens.insensitive(name, b"-infinity") {
        0.0 - f32.INFINITY
      } else if tokens.insensitive(name, b"pi") {
        3.1415927
      } else if tokens.insensitive(name, b"e") {
        2.7182817
      } else {
        return false
      }
      run out.append(Value.Unit { value: constant, unit: Unit.Number })
      return true
    }
    _ => {
      return false
    }
  }
  if first + 1 != last {
    return false
  }
  let next = run component(buffer, first, last, &mut out.*)
  return next == last
}

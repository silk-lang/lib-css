//! Root-owned compiled sheets: adoption order, cross-sheet layers and indexed matching.
//! This module consumes compiled data and never calls the stylesheet compiler or lexer.
import sheet { Sheet, Declaration }
import sheet_conditions
import adopted_variables { Inputs }
import variables { ScopeId, RegistrationError }
import silk.core.option { Option }
import silk.mem.box { Box }
import layers { Layers, UNLAYERED }
import cascade { Priority }
import cascade
import element { ElementTree, MatchContext }
import resolver { ResolverError }
import tokens { BufferView, Limits, CssError }
import media_features { Environment }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize

pub enum AdoptionError { DuplicateId, UnknownId }
pub union Source {
  Sheet { pub sheet: usize, pub declaration: usize },
  Inline { pub declaration: usize },
}
impl Copy for Source {}
pub struct Candidate { pub source: Source, pub priority: Priority }
impl Copy for Candidate {}
pub struct MatchedRule { pub sheet: u32, pub rule: usize }
impl Copy for MatchedRule {}

pub struct AdoptedSheet {
  pub id: u32,
  pub sheet: Sheet,
  // Maps a local flattened rank to the root's flattened rank.
  layers: List<usize>,
}

pub struct StyleSheets {
  entries: List<AdoptedSheet>,
  layers: Layers,
  output: List<Candidate>,
  matched: List<MatchedRule>,
  variables: Option<Box<Inputs>>,
}

fn important(declaration: &Declaration) -> bool {
  return match &declaration.* {
    Declaration.Typed { important, .. } => important
    Declaration.Pending { important, .. } => important
    Declaration.Custom { important, .. } => important
    Declaration.ColorExpression { important, .. } => important
  }
}

impl StyleSheets {
  pub fn make() -> StyleSheets {
    return StyleSheets { entries: List<AdoptedSheet>.make(), layers: Layers.make(),
      output: List<Candidate>.make(), matched: List<MatchedRule>.make(), variables: Option<Box<Inputs>>.None }
  }
  pub fn length(self: &Self) -> usize { return self.entries.length() }
  pub fn sheets(self: &Self) -> &[AdoptedSheet] { return self.entries.asSlice() }
  pub fn candidates(self: &Self) -> &[Candidate] { return self.output.asSlice() }
  pub fn matches(self: &Self) -> &[MatchedRule] { return self.matched.asSlice() }
  pub fn index(self: &Self, id: u32) -> usize {
    let mut i: usize = 0
    while i < self.entries.length() {
      if self.entries.asSlice()[i].id == id { return i }
      i = i + 1
    }
    return usize.MAX
  }

  /// Adopts at the end. Duplicate ids are rejected rather than changing source order.
  pub effect fn adopt(self: &mut Self, id: u32, sheet: Sheet) -> ()
    ! AdoptionError | OutOfMemoryError ? &mut Allocator {
    if self.index(id) != usize.MAX { fail AdoptionError.DuplicateId }
    run self.entries.append(AdoptedSheet { id: id, sheet: move sheet, layers: List<usize>.make() })
    run self.rebuildLayers()
  }

  /// Replacement keeps its original adoption position.
  pub effect fn replace(self: &mut Self, id: u32, sheet: Sheet) -> ()
    ! AdoptionError | OutOfMemoryError ? &mut Allocator {
    let index = self.index(id)
    if index == usize.MAX { fail AdoptionError.UnknownId }
    let entries = self.entries.asMutSlice()
    entries[index].sheet = move sheet
    run self.rebuildLayers()
  }

  /// Removing an absent id is a no-op.
  pub effect fn remove(self: &mut Self, id: u32) -> bool ! OutOfMemoryError ? &mut Allocator {
    let index = self.index(id)
    if index == usize.MAX { return false }
    drop self.entries.remove(index)
    run self.rebuildLayers()
    return true
  }

  effect fn rebuildLayers(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    self.variables = Option<Box<Inputs>>.None
    self.layers = Layers.make()
    self.output.clear()
    self.matched.clear()
    let entries = self.entries.asMutSlice()
    let mut i: usize = 0
    while i < entries.length {
      let entry = &mut entries[i]
      entry.layers.clear()
      let mut identities = List<usize>.make()
      let mut at: usize = 0
      while at < entry.sheet.layers.length() {
        run entry.layers.append(0)
        let localParent = entry.sheet.layers.parent(at)
        let parent = if localParent == UNLAYERED { UNLAYERED } else { identities.asSlice()[localParent] }
        run identities.append(run self.layers.register(parent, entry.sheet.layers.name(at)))
        at = at + 1
      }
      at = 0
      while at < identities.length() {
        let map = entry.layers.asMutSlice()
        map[entry.sheet.layers.rank(at)] = identities.asSlice()[at]
        at = at + 1
      }
      i = i + 1
    }
    i = 0
    while i < entries.length {
      let ranks = entries[i].layers.asMutSlice()
      let mut at: usize = 0
      while at < ranks.length {
        ranks[at] = self.layers.rank(ranks[at])
        at = at + 1
      }
      i = i + 1
    }
  }

  /// Re-evaluates retained conditions; true only if rule or registration eligibility changed.
  pub effect fn environment(self: &mut Self, environment: &Environment, starting: bool, limits: &Limits) -> bool
    ! CssError | OutOfMemoryError ? &mut Allocator {
    let mut changed = false
    let entries = self.entries.asMutSlice()
    let mut i: usize = 0
    while i < entries.length {
      let flipped = run sheet_conditions.update(&mut entries[i].sheet, environment, starting, limits)
      changed = changed || flipped
      i = i + 1
    }
    if changed { self.variables = Option<Box<Inputs>>.None }
    return changed
  }

  /// Builds the matched element's variable scope. Scope ids belong to this adoption/environment epoch.
  pub effect fn variableScope(self: &mut Self, parent: Option<ScopeId>, limits: &Limits) -> ScopeId
    ! RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
    if self.variables.isNone() {
      self.variables = Option<Box<Inputs>>.some(run Box<Inputs>.make(run Inputs.make(self.entries.asSlice(), limits)))
    }
    match &mut self.variables {
      Option<Box<Inputs>>.Some { value } => { let inputs = value.getMut()
        return run inputs[0].scope(self.output.asSlice(), parent, limits) }
      Option<Box<Inputs>>.None => Intrinsic.trap("variable inputs were initialized")
    }
  }

  pub fn variableInputs(self: &Self) -> &[Inputs] {
    return match &self.variables {
      Option<Box<Inputs>>.Some { value } => value.get()
      Option<Box<Inputs>>.None => &[]
    }
  }

  /// Matches one element, adding active style-object declarations with their inline priorities.
  /// Output is in ascending cascade order. Importance belongs to each declaration, not its rule.
  /// A failed match exposes no stale or partial output.
  pub effect fn resolve<T: ElementTree>(self: &mut Self, tree: &T, node: usize,
    inline: &[Priority], context: &mut MatchContext) -> ()
    ! ResolverError | CssError | OutOfMemoryError ? &mut Allocator {
    self.output.clear()
    self.matched.clear()
    let mut candidates = List<Candidate>.make()
    let mut matched = List<MatchedRule>.make()
    let mut order: usize = 0
    let entries = self.entries.asMutSlice()
    let mut i: usize = 0
    while i < entries.length {
      let entry = &mut entries[i]
      run entry.sheet.resolver.resolve(BufferView.of(entry.sheet.buffers.asSlice()), tree, node, &[], &mut context)
      let found = entry.sheet.resolver.declarations()
      let mut at: usize = 0
      while at < found.length {
        let item = found[at]
        let mut priority = item.priority
        priority.important = important(&entry.sheet.declarations.asSlice()[item.declaration])
        priority.order = order + item.declaration
        if priority.layer != UNLAYERED { priority.layer = entry.layers.asSlice()[priority.layer] }
        run candidates.append(Candidate { source: Source.Sheet { sheet: i, declaration: item.declaration }, priority: priority })
        at = at + 1
      }
      let rules = entry.sheet.resolver.matches()
      at = 0
      while at < rules.length {
        run matched.append(MatchedRule { sheet: entry.id, rule: rules[at].rule })
        at = at + 1
      }
      order = order + entry.sheet.declarations.length()
      i = i + 1
    }
    run context.spend(inline.length)
    i = 0
    while i < inline.length {
      let mut priority = inline[i]
      priority.order = order + i
      run candidates.append(Candidate { source: Source.Inline { declaration: i }, priority: priority })
      i = i + 1
    }
    // Usually tens of candidates per element. Insertion sort preserves source order on ties.
    let items = candidates.asMutSlice()
    i = 1
    while i < items.length {
      let selected = items[i]
      let mut at = i
      while at > 0 && cascade.compare(items[at - 1].priority, selected.priority) > 0 {
        run context.spend(1)
        items[at] = items[at - 1]
        at = at - 1
      }
      items[at] = selected
      i = i + 1
    }
    self.output = move candidates
    self.matched = move matched
  }
}

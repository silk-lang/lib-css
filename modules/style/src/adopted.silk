//! Root-owned compiled sheets: adoption order, cross-sheet layers and indexed matching.
//! This module consumes compiled data and never calls the stylesheet compiler or lexer.
import tokens { Token }
import silk.collections.bytes { Bytes }
import css_properties.census { Census }
import silk.num.u32
import sheet { Sheet, Declaration }
import sheet_conditions
import adopted_variables { Inputs, InlineCustom, VariableMasks }
import adopted_variables
import silk.num.u64
import variables { ScopeId, RegistrationError }
import silk.core.option { Option }
import silk.mem.box { Box }
import layers { Layers, UNLAYERED }
import cascade { Priority, Origin }
import cascade
import element { ElementTree, MatchContext, ContainerDependency, PseudoTarget }
import resolver { ResolverError }
import tokens { BufferView, Limits, CssError, Kind, equal }
import tokens
import media_features { Environment }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize

pub enum AdoptionError { DuplicateId, UnknownId, InvalidOrder }
pub union Source {
  Sheet { pub sheet: usize, pub declaration: usize },
  Inline { pub declaration: usize },
}
impl Copy for Source {}
pub struct Candidate { pub source: Source, pub priority: Priority }
impl Copy for Candidate {}
pub struct MatchedRule { pub sheet: u32, pub rule: usize }
impl Copy for MatchedRule {}

pub struct KeyframesRef { pub sheet: usize, pub rule: usize }
impl Copy for KeyframesRef {}

pub struct FontFaceRef { pub sheet: usize, pub rule: usize, pub priority: Priority }
impl Copy for FontFaceRef {}

pub struct AdoptedSheet {
  pub id: u32,
  pub sheet: Sheet,
  // Maps a local flattened rank to the root's flattened rank.
  layers: List<usize>,
}

pub struct StyleSheets {
  entries: List<AdoptedSheet>,
  layers: Layers,
  output: List<Candidate>,
  matched: List<MatchedRule>,
  selectedStates: u32,
  variables: Option<Box<Inputs>>,
  /// The last environment, which `if(media(...))` reads during substitution.
  current: Option<Environment>,
  /// Whether every sheet's conditions were evaluated for `current` (with `settledStarting`)
  /// and no sheet came or went since: a host asks every frame, and the answer only changes then.
  settled: bool,
  settledStarting: bool,
}

fn important(declaration: &Declaration) -> bool {
  return match &declaration.* {
    Declaration.Typed { important, .. } => important
    Declaration.Pending { important, .. } => important
    Declaration.Custom { important, .. } => important
    Declaration.ColorExpression { important, .. } => important
  }
}

impl StyleSheets {
  /// For the bench census: the conditions `environment` evaluates and the rules it then
  /// walks, each time it is called.
  pub fn censusConditions(self: &Self) -> usize {
    let mut total: usize = 0
    let mut i: usize = 0
    while i < self.entries.length() {
      total = total + self.entries.asSlice()[i].sheet.conditions.length()
      i = i + 1
    }
    return total
  }
  pub fn censusConditionRules(self: &Self) -> usize {
    let mut total: usize = 0
    let mut i: usize = 0
    while i < self.entries.length() {
      total = total + self.entries.asSlice()[i].sheet.ruleConditions.length()
      i = i + 1
    }
    return total
  }

  /// What the adopted sheets hold and the matching they did, for the bench census. Rows of
  /// several sheets carry the same names: the reader sums them.
  pub effect fn census(self: &Self, out: &mut Census) -> () ! OutOfMemoryError ? &mut Allocator {
    run out.unit("sheets", self.entries.length())
    let mut i: usize = 0
    while i < self.entries.length() {
      let sheet = &self.entries.asSlice()[i].sheet
      let mut data: usize = 0
      let mut dataRoom: usize = 0
      let mut tokens: usize = 0
      let mut tokenRoom: usize = 0
      let mut b: usize = 0
      while b < sheet.buffers.length() {
        let buffer = &sheet.buffers.asSlice()[b]
        data = data + Bytes.asSlice(&buffer.data).length
        dataRoom = dataRoom + Bytes.capacity(&buffer.data)
        tokens = tokens + buffer.tokens.length()
        tokenRoom = tokenRoom + buffer.tokens.capacity()
        b = b + 1
      }
      run out.unit("sheet.token-buffers", sheet.buffers.length())
      run out.bytes("sheet.source-text", data, dataRoom)
      run out.held("sheet.tokens", tokens, tokenRoom, Intrinsic.layoutOf<Token>().bytes)
      run out.held("sheet.declarations", sheet.declarations.length(), sheet.declarations.capacity(), Intrinsic.layoutOf<Declaration>().bytes)
      let mut typed: usize = 0
      let mut pending: usize = 0
      let mut custom: usize = 0
      let mut d: usize = 0
      while d < sheet.declarations.length() {
        match &sheet.declarations.asSlice()[d] {
          Declaration.Typed { .. } => { typed = typed + 1 }
          Declaration.Pending { .. } => { pending = pending + 1 }
          Declaration.Custom { .. } => { custom = custom + 1 }
          Declaration.ColorExpression { .. } => { pending = pending + 1 }
        }
        d = d + 1
      }
      run out.unit("sheet.declarations.typed", typed)
      run out.unit("sheet.declarations.pending(var or expression)", pending)
      run out.unit("sheet.declarations.custom-properties", custom)
      run out.held("sheet.conditions", sheet.conditions.length() + sheet.ruleConditions.length(), sheet.conditions.capacity() + sheet.ruleConditions.capacity(), 8)
      run out.unit("sheet.keyframes", sheet.keyframes.length())
      run out.unit("sheet.font-faces", sheet.fontFaces.length())
      run out.unit("sheet.registrations", sheet.registrations.length())
      run sheet.resolver.census(&mut out)
      i = i + 1
    }
    if let Option<Box<Inputs>>.Some { value } = &self.variables {
      run value.get()[0].census(&mut out)
    }
  }

  pub fn make() -> StyleSheets {
    return StyleSheets { entries: List<AdoptedSheet>.make(), layers: Layers.make(),
      output: List<Candidate>.make(), matched: List<MatchedRule>.make(), selectedStates: 0, variables: Option<Box<Inputs>>.None, current: Option<Environment>.None,
      settled: false, settledStarting: false }
  }
  pub fn length(self: &Self) -> usize { return self.entries.length() }
  pub fn sheets(self: &Self) -> &[AdoptedSheet] { return self.entries.asSlice() }
  pub fn candidates(self: &Self) -> &[Candidate] { return self.output.asSlice() }
  pub fn matches(self: &Self) -> &[MatchedRule] { return self.matched.asSlice() }
  pub fn stateDependencies(self: &Self) -> u32 { return self.selectedStates }
  pub effect fn containersChanged<T: ElementTree>(self: &Self, dependencies: &[ContainerDependency], tree: &T,
    node: usize, pseudo: PseudoTarget) -> bool ! CssError | OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    while i < dependencies.length {
      let dependency = dependencies[i]
      let index = self.index(dependency.sheet)
      if index == usize.MAX { return true }
      let sheet = &self.entries.asSlice()[index].sheet
      if dependency.condition >= sheet.conditions.length() { return true }
      let condition = sheet.conditions.asSlice()[dependency.condition]
      if (run sheet_conditions.containerMatches(sheet.buffers.asSlice(), condition, sheet.containerPrograms.asSlice(), tree, node, pseudo, self.variableInputs())) != dependency.matched { return true }
      i = i + 1
    }
    return false
  }
  pub fn canRetainScopes(self: &Self) -> bool {
    let inputs = self.variableInputs()
    return inputs.length != 0 && inputs[0].canRetainScopes()
  }
  pub fn index(self: &Self, id: u32) -> usize {
    let mut i: usize = 0
    while i < self.entries.length() {
      if self.entries.asSlice()[i].id == id { return i }
      i = i + 1
    }
    return usize.MAX
  }

  pub fn keyframes(self: &Self, name: &[u8]) -> Option<KeyframesRef> {
    let mut found = Option<KeyframesRef>.None
    let mut best = Priority.make(Origin.Author, 0)
    let mut order: usize = 0
    let mut sheet: usize = 0
    while sheet < self.entries.length() {
      let entry = &self.entries.asSlice()[sheet]
      let mut rule: usize = 0
      while rule < entry.sheet.keyframes.length() {
        let candidate = &entry.sheet.keyframes.asSlice()[rule]
        if candidate.enabled && equal(candidate.name.asSlice(), name) {
          let mut priority = Priority.make(Origin.Author, order)
          priority.layer = if candidate.layer == UNLAYERED { UNLAYERED } else { entry.layers.asSlice()[candidate.layer] }
          if found.isNone() || cascade.compare(priority, best) >= 0 {
            best = priority
            found = Option<KeyframesRef>.some(KeyframesRef { sheet: sheet, rule: rule })
          }
        }
        rule = rule + 1
        order = order + 1
      }
      sheet = sheet + 1
    }
    return found
  }

  pub effect fn fontFaces(self: &Self) -> List<FontFaceRef> ! OutOfMemoryError ? &mut Allocator {
    let mut result = List<FontFaceRef>.make()
    let mut order: usize = 0
    let mut sheet: usize = 0
    while sheet < self.entries.length() {
      let entry = &self.entries.asSlice()[sheet]
      let mut rule: usize = 0
      while rule < entry.sheet.fontFaces.length() {
        let candidate = &entry.sheet.fontFaces.asSlice()[rule]
        if candidate.enabled {
          let mut priority = Priority.make(Origin.Author, order)
          priority.layer = if candidate.layer == UNLAYERED { UNLAYERED } else { entry.layers.asSlice()[candidate.layer] }
          run result.append(FontFaceRef { sheet: sheet, rule: rule, priority: priority })
          let mut at = result.length() - 1
          while at > 0 && cascade.compare(result.get(at).priority, result.get(at - 1).priority) < 0 {
            let entries = result.asMutSlice()
            let previous = entries[at - 1]
            entries[at - 1] = entries[at]
            entries[at] = previous
            at = at - 1
          }
        }
        rule = rule + 1
        order = order + 1
      }
      sheet = sheet + 1
    }
    return move result
  }

  /// Adopts at the end. Duplicate ids are rejected rather than changing source order.
  pub effect fn adopt(self: &mut Self, id: u32, sheet: Sheet) -> ()
    ! AdoptionError | OutOfMemoryError ? &mut Allocator {
    if self.index(id) != usize.MAX { fail AdoptionError.DuplicateId }
    run self.entries.append(AdoptedSheet { id: id, sheet: move sheet, layers: List<usize>.make() })
    run self.rebuildLayers()
  }

  /// Replacement keeps its original adoption position.
  pub effect fn replace(self: &mut Self, id: u32, sheet: Sheet) -> ()
    ! AdoptionError | OutOfMemoryError ? &mut Allocator {
    let index = self.index(id)
    if index == usize.MAX { fail AdoptionError.UnknownId }
    let entries = self.entries.asMutSlice()
    entries[index].sheet = move sheet
    run self.rebuildLayers()
  }

  pub effect fn reorder(self: &mut Self, ids: &[u32]) -> ()
    ! AdoptionError | OutOfMemoryError ? &mut Allocator {
    if ids.length != self.entries.length() { fail AdoptionError.InvalidOrder }
    let mut i: usize = 0
    while i < ids.length {
      if self.index(ids[i]) == usize.MAX { fail AdoptionError.UnknownId }
      let mut before: usize = 0
      while before < i {
        if ids[before] == ids[i] { fail AdoptionError.DuplicateId }
        before = before + 1
      }
      i = i + 1
    }
    let mut ordered = List<AdoptedSheet>.make()
    run ordered.reserve(ids.length)
    i = 0
    while i < ids.length {
      let at = self.index(ids[i])
      run ordered.append(self.entries.remove(at))
      i = i + 1
    }
    self.entries = move ordered
    run self.rebuildLayers()
  }

  /// Removing an absent id is a no-op.
  pub effect fn remove(self: &mut Self, id: u32) -> bool ! OutOfMemoryError ? &mut Allocator {
    let index = self.index(id)
    if index == usize.MAX { return false }
    drop self.entries.remove(index)
    run self.rebuildLayers()
    return true
  }

  effect fn rebuildLayers(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    self.variables = Option<Box<Inputs>>.None
    self.settled = false
    self.layers = Layers.make()
    self.output.clear()
    self.matched.clear()
    self.selectedStates = 0
    let entries = self.entries.asMutSlice()
    let mut i: usize = 0
    while i < entries.length {
      let entry = &mut entries[i]
      entry.layers.clear()
      let mut identities = List<usize>.make()
      let mut at: usize = 0
      while at < entry.sheet.layers.length() {
        run entry.layers.append(0)
        let localParent = entry.sheet.layers.parent(at)
        let parent = if localParent == UNLAYERED { UNLAYERED } else { identities.asSlice()[localParent] }
        run identities.append(run self.layers.register(parent, entry.sheet.layers.name(at)))
        at = at + 1
      }
      at = 0
      while at < identities.length() {
        let map = entry.layers.asMutSlice()
        map[entry.sheet.layers.rank(at)] = identities.asSlice()[at]
        at = at + 1
      }
      i = i + 1
    }
    i = 0
    while i < entries.length {
      let ranks = entries[i].layers.asMutSlice()
      let mut at: usize = 0
      while at < ranks.length {
        ranks[at] = self.layers.rank(ranks[at])
        at = at + 1
      }
      i = i + 1
    }
  }

  /// Re-evaluates retained conditions; true only if rule or registration eligibility changed.
  pub effect fn environment(self: &mut Self, environment: &Environment, starting: bool, limits: &Limits) -> bool
    ! CssError | OutOfMemoryError ? &mut Allocator {
    if self.settled && self.settledStarting == starting {
      if let Option<Environment>.Some { value: last } = &self.current {
        if Environment.same(&last, environment) { return false }
      }
    }
    let mut changed = false
    let entries = self.entries.asMutSlice()
    let mut i: usize = 0
    while i < entries.length {
      let flipped = run sheet_conditions.update(&mut entries[i].sheet, environment, starting, limits)
      changed = changed || flipped
      i = i + 1
    }
    // A new environment can pick another if() branch: only sheets with `media()` care.
    let moved = match &self.current {
      Option<Environment>.Some { value: last } => !sameMedia(&last, environment)
      _ => true
    }
    self.current = Option<Environment>.some(environment.*)
    self.settled = true
    self.settledStarting = starting
    if moved && !changed && self.current.isSome() && mediaTests(self.entries.asSlice()) { changed = true }
    if changed { self.variables = Option<Box<Inputs>>.None }
    if let Option<Box<Inputs>>.Some { value } = &mut self.variables {
      let inputs = value.getMut()
      inputs[0].variables.environment = self.current
    }
    return changed
  }

  /// Builds the matched element's variable scope. Scope ids belong to this adoption/environment epoch.
  pub effect fn variableScope(self: &mut Self, parent: Option<ScopeId>, limits: &Limits) -> ScopeId
    ! RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
    return run self.variableScopeWith(parent, &[], limits)
  }

  pub effect fn variableScopeWith(self: &mut Self, parent: Option<ScopeId>, inline: &[InlineCustom<'_, '_>], limits: &Limits) -> ScopeId
    ! RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
    if self.variables.isNone() {
      let mut made = run Inputs.make(self.entries.asSlice(), limits)
      made.variables.environment = self.current
      self.variables = Option<Box<Inputs>>.some(run Box<Inputs>.make(move made))
    }
    match &mut self.variables {
      Option<Box<Inputs>>.Some { value } => { let inputs = value.getMut()
        return run inputs[0].scope(self.output.asSlice(), inline, parent, limits) }
      Option<Box<Inputs>>.None => Intrinsic.trap("variable inputs were initialized")
    }
  }

  /// The variable scope under `parent` of an element whose match held the custom-property
  /// candidates `customs` (`customCandidates`) and that has the inline custom properties
  /// `inline`. It reads nothing of the last match, so a caller that kept those of an earlier
  /// match can move the element under a changed parent scope without matching it again.
  pub effect fn variableScopeOf(self: &mut Self, parent: Option<ScopeId>, customs: &[Candidate], inline: &[InlineCustom<'_, '_>], limits: &Limits) -> ScopeId
    ! RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
    if self.variables.isNone() {
      let mut made = run Inputs.make(self.entries.asSlice(), limits)
      made.variables.environment = self.current
      self.variables = Option<Box<Inputs>>.some(run Box<Inputs>.make(move made))
    }
    match &mut self.variables {
      Option<Box<Inputs>>.Some { value } => { let inputs = value.getMut()
        return run inputs[0].scope(customs, inline, parent, limits) }
      Option<Box<Inputs>>.None => Intrinsic.trap("variable inputs were initialized")
    }
  }

  /// Appends the candidates of the last match that declare a custom property.
  pub effect fn customCandidates(self: &Self, out: &mut List<Candidate>) -> () ! OutOfMemoryError ? &mut Allocator {
    if let Option<Box<Inputs>>.Some { value } = &self.variables { run value.get()[0].customCandidates(self.output.asSlice(), &mut out) }
  }

  /// Which custom properties the last match and `inline` declare, and which their values
  /// mention. Every bit is set before the first scope is asked for.
  pub fn variableMasks(self: &Self, inline: &[InlineCustom<'_, '_>]) -> VariableMasks {
    return match &self.variables {
      Option<Box<Inputs>>.Some { value } => value.get()[0].sheetMasks(self.output.asSlice()).with(adopted_variables.inlineMasks(inline))
      Option<Box<Inputs>>.None => VariableMasks { reads: u64.MAX, declares: u64.MAX }
    }
  }

  /// The variable scope of an element that declares no custom property: what it inherits from
  /// `parent`. Unlike `variableScopeWith` it reads nothing of the last match, so a caller that
  /// knows an element's match declares none can move the element under a changed parent scope
  /// without matching it again.
  pub effect fn inheritedScope(self: &mut Self, parent: Option<ScopeId>, limits: &Limits) -> ScopeId
    ! RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
    if self.variables.isNone() {
      let mut made = run Inputs.make(self.entries.asSlice(), limits)
      made.variables.environment = self.current
      self.variables = Option<Box<Inputs>>.some(run Box<Inputs>.make(move made))
    }
    match &mut self.variables {
      Option<Box<Inputs>>.Some { value } => { let inputs = value.getMut()
        return run inputs[0].scope(&[], &[], parent, limits) }
      Option<Box<Inputs>>.None => Intrinsic.trap("variable inputs were initialized")
    }
  }

  pub fn resetScopes(self: &mut Self) -> () {
    if let Option<Box<Inputs>>.Some { value } = &mut self.variables {
      let inputs = value.getMut()
      inputs[0].resetScopes()
    }
  }

  pub fn variableInputs(self: &Self) -> &[Inputs] {
    return match &self.variables {
      Option<Box<Inputs>>.Some { value } => value.get()
      Option<Box<Inputs>>.None => &[]
    }
  }

  pub fn hasStarting(self: &Self) -> bool {
    let mut i: usize = 0
    while i < self.entries.length() {
      if self.entries.asSlice()[i].sheet.resolver.hasStarting() { return true }
      i = i + 1
    }
    return false
  }

  /// Matches one element, adding active style-object declarations with their inline priorities.
  /// Output is in ascending cascade order. Importance belongs to each declaration, not its rule.
  /// A failed match exposes no stale or partial output.
  pub effect fn resolve<T: ElementTree>(self: &mut Self, tree: &T, node: usize,
    inline: &[Priority], context: &mut MatchContext) -> ()
    ! ResolverError | CssError | OutOfMemoryError ? &mut Allocator {
    run self.resolveWith(tree, node, inline, &mut context, false)
  }

  pub effect fn resolveWith<T: ElementTree>(self: &mut Self, tree: &T, node: usize,
    inline: &[Priority], context: &mut MatchContext, starting: bool) -> ()
    ! ResolverError | CssError | OutOfMemoryError ? &mut Allocator {
    self.output.clear()
    self.matched.clear()
    self.selectedStates = 0
    context.containers.clear()
    context.clearWatches()
    let mut candidates = List<Candidate>.make()
    let mut matched = List<MatchedRule>.make()
    let mut states: u32 = 0
    let mut order: usize = 0
    let styles = match &self.variables {
      Option<Box<Inputs>>.Some { value } => value.get()
      Option<Box<Inputs>>.None => &[]
    }
    let entries = self.entries.asMutSlice()
    let mut i: usize = 0
    while i < entries.length {
      let entry = &mut entries[i]
      let filter = sheet_conditions.Filter { tree: tree, node: node, sheet: entry.id, buffers: entry.sheet.buffers.asSlice(),
        conditions: entry.sheet.conditions.asSlice(), programs: entry.sheet.containerPrograms.asSlice(), rules: entry.sheet.ruleConditions.asSlice(), styles: styles }
      run entry.sheet.resolver.resolveFiltered(BufferView.of(entry.sheet.buffers.asSlice()), tree, node, &[], &mut context, starting, &filter)
      states = u32.bitOr(states, entry.sheet.resolver.stateDependencies())
      let found = entry.sheet.resolver.declarations()
      let mut at: usize = 0
      while at < found.length {
        let item = found[at]
        let mut priority = item.priority
        priority.important = important(&entry.sheet.declarations.asSlice()[item.declaration])
        priority.order = order + item.declaration
        if priority.layer != UNLAYERED { priority.layer = entry.layers.asSlice()[priority.layer] }
        run candidates.append(Candidate { source: Source.Sheet { sheet: i, declaration: item.declaration }, priority: priority })
        at = at + 1
      }
      let rules = entry.sheet.resolver.matches()
      at = 0
      while at < rules.length {
        run matched.append(MatchedRule { sheet: entry.id, rule: rules[at].rule })
        at = at + 1
      }
      order = order + entry.sheet.declarations.length()
      i = i + 1
    }
    run context.spend(inline.length)
    i = 0
    while i < inline.length {
      let mut priority = inline[i]
      priority.order = order + i
      run candidates.append(Candidate { source: Source.Inline { declaration: i }, priority: priority })
      i = i + 1
    }
    // Usually tens of candidates per element. Insertion sort preserves source order on ties.
    let items = candidates.asMutSlice()
    i = 1
    while i < items.length {
      let selected = items[i]
      let mut at = i
      while at > 0 && cascade.compare(items[at - 1].priority, selected.priority) > 0 {
        run context.spend(1)
        items[at] = items[at - 1]
        at = at - 1
      }
      items[at] = selected
      i = i + 1
    }
    self.output = move candidates
    self.matched = move matched
    self.selectedStates = states
  }
}

fn sameMedia(a: &Environment, b: &Environment) -> bool {
  return a.initial.viewportWidth == b.initial.viewportWidth && a.initial.viewportHeight == b.initial.viewportHeight
    && a.deviceWidth == b.deviceWidth && a.deviceHeight == b.deviceHeight
    && a.resolutionDppx == b.resolutionDppx && a.mediaType == b.mediaType
    && a.colorScheme == b.colorScheme && a.reducedMotion == b.reducedMotion
    && a.forcedColors == b.forcedColors && a.hover == b.hover && a.anyHover == b.anyHover
    && a.pointer == b.pointer && a.colorGamut == b.colorGamut
}

/// Whether a sheet has a `media()` function, which only `if()` takes.
fn mediaTests(entries: &[AdoptedSheet]) -> bool {
  let mut i: usize = 0
  while i < entries.length {
    let buffers = entries[i].sheet.buffers.asSlice()
    let mut b: usize = 0
    while b < buffers.length {
      let list = buffers[b].tokens.asSlice()
      let mut t: usize = 0
      while t < list.length {
        if let Kind.Function { name } = list[t].kind {
          if tokens.insensitive(buffers[b].text(name), b"media") { return true }
        }
        t = t + 1
      }
      b = b + 1
    }
    i = i + 1
  }
  return false
}

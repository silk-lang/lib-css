//! CSS Color 4 contracts against pinned 43bfdad1d01d4ce47cbb350b5fdf058be5b63edc2f0416b6967de1d731ff7145.
import colors { Color, Space, Identity, SystemColor, Context }
import colors
import lexer
import input { Input }
import value_cursor { Cursor }
import tokens { Limits, CssError }
import svg_geometry.math
import silk.num.f64
import silk.text.string { String }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn parsed(data: &[u8]) -> Option<Color>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(data, &limits)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let result = run colors.parse(&source, &mut cursor)
  if !cursor.done(&source) {
    return Option<Color>.None
  }
  return result
}

effect fn sample(data: &[u8]) -> Color
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let result = run parsed(data)
  match &result {
    Option<Color>.Some { value } => {
      return value
    }
    _ => {
      run Testing.expect(false, "valid Color4 syntax")
      return Color.srgb(0.0, 0.0, 0.0, 0.0)
    }
  }
}

fn near(a: f64, b: f64) -> bool {
  return f64.abs(a - b) < 0.0015
}

effect fn rgb(data: &[u8], r: f64, g: f64, b: f64, a: f64) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let color = run sample(data)
  let actual = colors.toSrgb(color)
  run Testing.expect(
    near(actual.r, r) && near(actual.g, g) && near(actual.b, b) && near(actual.a, a),
    "Color4 conversion within half an 8-bit step",
  )
}

// https://www.w3.org/TR/css-color-4/#rgb-functions
// https://www.w3.org/TR/css-color-4/#hex-notation
// https://www.w3.org/TR/css-color-4/#named-colors
// https://www.w3.org/TR/css-color-4/#valdef-color-olivedrab
test effect fn rgbSyntaxHexAndNames() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rgb(b"RGB(100% 0 0 / 50%)", 1.0, 0.0, 0.0, 0.5)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"rgba(255, 0, 0)", 1.0, 0.0, 0.0, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"rgb(-20, 300, 127.5, 2)", 0.0, 1.0, 0.5, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"#0f08", 0.0, 1.0, 0.0, 8.0 / 15.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"#66339980", 0.4, 0.2, 0.6, 128.0 / 255.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"ReBeccAPurple", 0.4, 0.2, 0.6, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"olivedrab", 107.0 / 255.0, 142.0 / 255.0, 35.0 / 255.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"transparent", 0.0, 0.0, 0.0, 0.0) |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-color-4/#the-hsl-notation
// https://www.w3.org/TR/css-color-4/#hwb-normalization
// https://www.w3.org/TR/css-color-4/#ex-hwb-simple
test effect fn cylindricalSrgbAndAngleNormalization() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rgb(b"hsl(-240deg 100 50)", 0.0, 1.0, 0.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"hsla(.5turn, 100%, 50%, 25%)", 0.0, 1.0, 1.0, 0.25)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"hwb(150 20% 10%)", 0.2, 0.9, 0.55, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"hwb(45 40 80)", 1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-color-4/#missing
// https://www.w3.org/TR/css-color-4/#specifying-lab-lch
// https://www.w3.org/TR/css-color-4/#specifying-oklab-oklch
// https://www.w3.org/TR/css-color-4/#color-function
test effect fn spacesMissingAndReferenceRanges() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let lab = run sample(b"lab(120% -100% none / none)")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    lab.space == Space.Lab && lab.channels[0] == 100.0 && lab.channels[1] == -125.0
      && lab.missing == 12,
    "Lab normalization and missing b/alpha retained",
  )
  let lch = run sample(b"lch(50 -2 -90deg)") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    lch.channels[1] == 0.0 && lch.channels[2] == 270.0,
    "negative chroma clamped and hue normalized",
  )
  let ok = run sample(b"oklab(50% 100% -100%)") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    ok.channels[0] == 0.5 && ok.channels[1] == 0.4 && ok.channels[2] == -0.4,
    "Oklab percentage reference ranges",
  )
  let p3 = run sample(b"color(display-p3 1.2 -0.1 none)")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    p3.space == Space.DisplayP3 && p3.channels[0] == 1.2 && p3.channels[1] == -0.1
      && p3.missing == 4,
    "wide gamut channels are not prematurely clipped",
  )
  run rgb(b"rgb(none 128 none / none)", 0.0, 128.0 / 255.0, 0.0, 0.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-color-4/#color-conversion-code
// https://www.w3.org/TR/css-color-4/#predefined-rec2020
// https://www.w3.org/TR/css-color-4/#predefined-display-p3-linear
test effect fn conversionWhitePointsTransferCurvesAndLab() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rgb(b"color(xyz-d65 0.4123907993 0.2126390059 0.0193308187)", 1.0, 0.0, 0.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color(xyz-d50 .9642956764 1 .8251046025)", 1.0, 1.0, 1.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color(srgb-linear .2140411405 .2140411405 .2140411405)", 0.5, 0.5, 0.5, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color(display-p3-linear .2140411405 .2140411405 .2140411405)", 0.5, 0.5, 0.5, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color(display-p3 .5 .5 .5)", 0.5, 0.5, 0.5, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color(a98-rgb .496101 .496101 .496101)", 0.5, 0.5, 0.5, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color(prophoto-rgb .4243657 .4243657 .4243657)", 0.5, 0.5, 0.5, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color(rec2020 .526066 .526066 .526066)", 0.5, 0.5, 0.5, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"lab(54.29054 80.80492 69.89099)", 1.0, 0.0, 0.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"oklab(.62795536 .22486306 .12584630)", 1.0, 0.0, 0.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"oklch(.62795536 .25768331 29.233885)", 1.0, 0.0, 0.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-color-4/#pseudo-binsearch
// https://www.w3.org/TR/css-color-4/#color-difference-OK
test effect fn localMindeMappingIsNotChannelClipping() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let p3 = run sample(b"color(display-p3 1 0 0 / .3)")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mapped = colors.toSrgb(p3)
  run Testing.expect(
    mapped.r == 1.0 && mapped.g > 0.02 && mapped.g < 0.08 && mapped.b > 0.02 && mapped.b < 0.08
      && mapped.a == 0.3,
    "local MINDE reduces chroma rather than clipping P3 red to sRGB red",
  )
  run rgb(b"oklab(100% .4 -.4)", 1.0, 1.0, 1.0, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"lab(0 125 125)", 0.0, 0.0, 0.0, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-color-4/#css-system-colors
// https://www.w3.org/TR/css-color-4/#deprecated-system-colors
// https://www.w3.org/TR/css-color-4/#currentcolor-color
test effect fn hostContextResolvesIdentities() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let current = run sample(b"color(display-p3 .2 .4 .6)")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let host = Color.srgb(0.1, 0.2, 0.3, 1.0)
  let context = Context.make(current, [host; 19])
  let keyword = run sample(b"currentColor") |> Effect.provideMut<Allocator>(&mut allocator)
  let resolved = colors.compute(keyword, &context)
  run Testing.expect(
    resolved.space == Space.DisplayP3 && resolved.channels[1] == 0.4,
    "currentColor retains host space",
  )
  let deprecated = run sample(b"ThreeDDarkShadow") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match &deprecated.identity {
      Identity.System { color } => color == SystemColor.ButtonBorder
      _ => false
    },
    "deprecated keyword maps to normative system role",
  )
  run Testing.expect(
    colors.compute(deprecated, &context).channels[2] == 0.3,
    "system palette comes from host",
  )
}

// https://www.w3.org/TR/css-color-4/#rgb-functions
// https://www.w3.org/TR/css-color-4/#the-hsl-notation
// https://www.w3.org/TR/css-color-4/#color-function
// https://www.w3.org/TR/css-color-4/#ex-srgb-calc-specified
test effect fn mathAndStrictGrammar() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rgb(b"rgb(calc(64 * 2) 127 255)", 128.0 / 255.0, 127.0 / 255.0, 1.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"hsl(calc(.5turn + 60deg) calc(2 * 50%) 50%)", 0.0, 0.0, 1.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalid: [string; 17] = [
    "rgb(1, 2%, 3)",
    "rgb(none, 2, 3)",
    "rgb(1 2 3, .5)",
    "hsl(0, 100, 50)",
    "hwb(0, 0%, 0%)",
    "lab(50 1deg 2)",
    "lch(50 30 20%)",
    "color(lab 1 2 3)",
    "color(srgb 1, 0, 0)",
    "#12345",
    "rgb(1 2 3 /)",
    "rgb(1 2)",
    "rgb(1 2 3 4)",
    "rgb(1 2 3))",
    "olivedra",
    "rgb(calc(1px) 0 0)",
    "rgb(0 0 0 / calc(.2 + 20%))",
  ]
  let mut i: usize = 0
  while i < invalid.length {
    let result = run parsed(String.utf8Bytes(invalid[i]))
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      match &result {
        Option<Color>.None => true
        _ => false
      },
      "invalid color grammar rejected",
    )
    i = i + 1
  }
}

// https://www.w3.org/TR/css-color-4/#color-conversion-code
test effect fn portableTransferFunctionNumerics() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    f64.abs(math.pow(0.5, 2.4) - 0.18946457081379975) < 1e-13,
    "fractional transfer exponent",
  )
  run Testing.expect(
    f64.abs(math.pow(0.0031308, 1.0 / 2.4) - 0.09047384595515653) < 1e-12,
    "sRGB breakpoint exponent",
  )
  run Testing.expect(f64.abs(math.cbrt(-0.125) + 0.5) < 1e-14, "signed Oklab cube root")
}

// https://www.w3.org/TR/css-color-4/#resolving-sRGB-values
// https://www.w3.org/TR/css-color-4/#resolving-color-function-values
test effect fn nonfiniteMathAndUnboundedColorLimits() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rgb(b"rgb(calc(infinity) calc(-infinity) calc(NaN))", 1.0, 0.0, 0.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"hsl(calc(infinity) 100% 50%)", 1.0, 0.0, 0.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounded = run sample(b"color(srgb 1e308 -1e308 0)")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    bounded.channels[0] == 1000000.0 && bounded.channels[1] == -1000000.0,
    "documented implementation limit prevents transfer-curve overflow",
  )
}

// https://www.w3.org/TR/css-color-4/#rgb-functions
// https://www.w3.org/TR/css-syntax-3/#consume-a-function
test effect fn invalidParseDoesNotConsumeAndImplicitEofCloses() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(b" rgb(1, 2%, 3) red", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let result = run colors.parse(&source, &mut cursor)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    cursor.position == 0
      && match &result {
        Option<Color>.None => true
        _ => false
      },
    "invalid color leaves the caller cursor untouched",
  )
  run rgb(b"rgb(255 0 0", 1.0, 0.0, 0.0, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-color-4/#color-syntax-modern
test effect fn modernComponentsRequireWhitespace() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let adjacent = run parsed(b"rgb(1+2+3)") |> Effect.provideMut<Allocator>(&mut allocator)
  let comments = run parsed(b"rgb(1/**/2/**/3)") |> Effect.provideMut<Allocator>(&mut allocator)
  let adjacentFunctions = run parsed(b"rgb(calc(1)calc(2)calc(3))")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match &adjacent {
      Option<Color>.None => true
      _ => false
    },
    "separate signed number tokens still need component whitespace",
  )
  run Testing.expect(
    match &comments {
      Option<Color>.None => true
      _ => false
    },
    "comments do not create whitespace tokens",
  )
  run Testing.expect(
    match &adjacentFunctions {
      Option<Color>.None => true
      _ => false
    },
    "adjacent functions need component whitespace",
  )
}

import colors { ColorProgram }

test effect fn colorMixNormalizesWeightsPremultipliesAndPreservesColorSpace() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rgb(b"color-mix(in srgb, red, blue)", 0.5, 0.0, 0.5, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color-mix(in srgb, red 25%, blue)", 0.25, 0.0, 0.75, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color-mix(in srgb, 25% red, blue 25%)", 0.5, 0.0, 0.5, 0.5) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color-mix(in srgb, red 80%, blue 80%)", 0.5, 0.0, 0.5, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color-mix(in srgb, red, transparent)", 1.0, 0.0, 0.0, 0.5) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color-mix(in srgb, rgb(255 0 0 / 0.2), blue)", 1.0 / 6.0, 0.0, 5.0 / 6.0, 0.6) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color-mix(in srgb, red calc(20% + 5%), color-mix(in srgb, blue, white))", 0.625, 0.375, 0.75, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run rgb(b"color-mix(in srgb, red calc(-10%), blue)", 0.0, 0.0, 1.0, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  let lab = run sample(b"color-mix(in lab, lab(20 30 40), lab(60 10 20))") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(lab.space == Space.Lab && near(lab.channels[0], 40.0) && near(lab.channels[1], 20.0) && near(lab.channels[2], 30.0), "Lab interpolation keeps specified space without gamut clipping")
  let oklab = run sample(b"color-mix(in oklab, oklab(0.2 0.1 0.2), oklab(0.6 0.3 0))") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(oklab.space == Space.Oklab && near(oklab.channels[0], 0.4) && near(oklab.channels[1], 0.2) && near(oklab.channels[2], 0.1), "Oklab interpolates Cartesian channels")
}

test effect fn colorMixHueFixupMissingComponentsAndDeferredCurrentColor() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let short = run sample(b"color-mix(in oklch, oklch(0.5 0.2 350), oklch(0.5 0.2 10))") |> Effect.provideMut<Allocator>(&mut allocator)
  let long = run sample(b"color-mix(in oklch longer hue, oklch(0.5 0.2 350), oklch(0.5 0.2 10))") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(near(short.channels[2], 0.0) && near(long.channels[2], 180.0), "polar hue takes the selected arc")
  let missing = run sample(b"color-mix(in oklab, oklab(none 0.2 none), oklab(0.6 none none))") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(near(missing.channels[0], 0.6) && near(missing.channels[1], 0.2) && missing.missing & 4 != 0, "one missing component borrows its partner; two remain missing")
  let powerless = run sample(b"color-mix(in oklch, oklch(0.5 0 200), oklch(0.5 0.2 10))") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(near(powerless.channels[2], 285.0), "explicit powerless hue still interpolates when its space is unchanged")
  let converted = run sample(b"color-mix(in oklch, rgb(128 128 128), oklch(.5 .2 10))") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(near(converted.channels[2], 10.0), "conversion makes achromatic hue missing before interpolation")
  let buffer = run lexer.tokenize(b"color-mix(in srgb, color-mix(in srgb, currentcolor, white), transparent)", &Limits.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let parsed = run colors.parseProgram(&source, &mut cursor) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(cursor.done(&source), "color expression consumes the whole input")
  match &parsed {
    Option<ColorProgram>.Some { value } => {
      run Testing.expect(value.contextual(), "currentcolor stays a contextual leaf")
      let red = value.evaluate(&Context.make(Color.srgb(1.0, 0.0, 0.0, 1.0), [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]))
      let blue = value.evaluate(&Context.make(Color.srgb(0.0, 0.0, 1.0, 1.0), [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]))
      run Testing.expect(match &red { Option<Color>.Some { value: resolved } => near(resolved.channels[0], 1.0) && near(resolved.channels[2], 0.5) && near(resolved.alpha, 0.5) _ => false }, "same program resolves against red host color")
      run Testing.expect(match &blue { Option<Color>.Some { value: resolved } => near(resolved.channels[0], 0.5) && near(resolved.channels[2], 1.0) && near(resolved.alpha, 0.5) _ => false }, "same program resolves against blue host color")
    }
    _ => { run Testing.expect(false, "valid contextual color-mix program") }
  }
}

test effect fn invalidColorMixDoesNotConsumeInput() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let invalid = [
    b"color-mix(in srgb, red 0%, blue 0%)", b"color-mix(in srgb, red -1%, blue)",
    b"color-mix(in srgb, red 101%, blue)", b"color-mix(in srgb longer hue, red, blue)",
    b"color-mix(in unknown, red, blue)", b"color-mix(in srgb, red, blue, green)",
    b"color-mix(in srgb, red 25% 25%, blue)", b"color-mix(in srgb, red 25, blue)",
  ]
  let mut i: usize = 0
  while i < invalid.length {
    let buffer = run lexer.tokenize(invalid[i], &Limits.make()) |> Effect.provideMut<Allocator>(&mut allocator)
    let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
    let mut cursor = Cursor.make(&source)
    let parsed = run colors.parseProgram(&source, &mut cursor) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(!parsed.isSome() && cursor.position == 0, "invalid mix rolls back cursor")
    i = i + 1
  }
}

effect fn relativeColors() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  run rgb(b"rgb(from red r g b / 50%)", 1.0, 0.0, 0.0, 0.5)
  run rgb(b"rgb(from #336699 b g r)", 0.6, 0.4, 0.2, 1.0)
  run rgb(b"rgb(from red calc(r / 2) g calc(b + 51) / calc(alpha * 0.25))", 127.5 / 255.0, 0.0, 0.2, 0.25)
  run rgb(b"hsl(from red calc(h + 120) s l)", 0.0, 1.0, 0.0, 1.0)
  run rgb(b"oklch(from blue l c h / 0.5)", 0.0, 0.0, 1.0, 0.5)
  run rgb(b"color(from lime srgb r g b)", 0.0, 1.0, 0.0, 1.0)
  run rgb(b"rgb(from rgb(from red g r b) r g 255)", 0.0, 1.0, 1.0, 1.0)
  run Testing.expect((run parsed(b"rgb(from currentcolor r g b)")).isNone(), "an origin known only later has no value yet")
  run Testing.expect((run parsed(b"rgb(from red r g)")).isNone(), "a relative color still needs every channel")
  run Testing.expect((run parsed(b"rgb(from red x g b)")).isNone(), "rgb() has no x channel")
}

// https://www.w3.org/TR/css-color-5/#relative-colors
test effect fn relativeColorsReadTheirOriginsChannels() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run relativeColors() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// `data` as a program, evaluated with `current` as currentcolor and `system` as every system color.
effect fn later(data: &[u8], current: Color, system: Color) -> Option<Color>
  ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let buffer = run lexer.tokenize(data, &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let parsed = run colors.parseProgram(&source, &mut cursor)
  run Testing.expect(cursor.done(&source), "a relative color program takes the whole value")
  return match &parsed {
    Option<ColorProgram>.Some { value } => {
      run Testing.expect(value.contextual(), "its origin stays for later")
      let mut writer = Writer.make()
      run sheet_colors.encode(&value, &mut writer)
      let mut reader = Reader.make(writer.bytes.asSlice())
      let decoded = run Effect.result(sheet_colors.decode(&mut reader, &Limits.make()))
      match &decoded {
        Result<ColorProgram, DecodeError | OutOfMemoryError>.Success { value: back } => back.evaluate(&Context.make(current, [system; 19]))
        _ => Option<Color>.None
      }
    }
    _ => Option<Color>.None
  }
}

effect fn laterIs(data: &[u8], current: Color, system: Color, r: f64, g: f64, b: f64, a: f64, message: string<'static>) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let found = run later(data, current, system)
  run Testing.expect(match &found {
    Option<Color>.Some { value } => {
      let rgba = colors.toSrgb(value)
      near(rgba.r, r) && near(rgba.g, g) && near(rgba.b, b) && near(rgba.a, a)
    }
    _ => false
  }, message)
}

effect fn laterRelative() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let red = Color.srgb(1.0, 0.0, 0.0, 1.0)
  let blue = Color.srgb(0.0, 0.0, 1.0, 1.0)
  let white = Color.srgb(1.0, 1.0, 1.0, 1.0)
  run laterIs(b"rgb(from currentcolor r g b / 50%)", red, blue, 1.0, 0.0, 0.0, 0.5, "currentcolor's channels, with a constant alpha")
  run laterIs(b"rgb(from currentcolor r g b / 50%)", blue, red, 0.0, 0.0, 1.0, 0.5, "the same program follows another currentcolor")
  run laterIs(b"hsl(from currentcolor calc(h + 120) s l)", red, blue, 0.0, 1.0, 0.0, 1.0, "calc() over a channel")
  run laterIs(b"oklch(from canvastext l c h / calc(alpha / 4))", red, blue, 0.0, 0.0, 1.0, 0.25, "a system color origin")
  run laterIs(b"color(from currentcolor srgb calc(r / 2) g 0)", white, blue, 0.5, 1.0, 0.0, 1.0, "color() with a number channel")
  run laterIs(b"rgb(from color-mix(in srgb, currentcolor, white) r g calc((b + 255) / 2))", Color.srgb(0.0, 0.0, 0.0, 1.0), blue, 0.5, 0.5, 0.75, 1.0, "a color-mix() origin, and nested parentheses")
  run laterIs(b"hsl(from currentcolor h 50% l)", red, blue, 0.75, 0.25, 0.25, 1.0, "a percentage channel")
  let none = run later(b"rgb(from currentcolor none g b)", red, blue)
  run Testing.expect(match &none { Option<Color>.Some { value } => value.missing & 1 != 0 _ => false }, "none is a missing channel")
  run Testing.expect((run parsed(b"rgb(from currentcolor r g b)")).isNone(), "a plain color parse still has no value for it")
}

test effect fn relativeColorsFromLaterOriginsBecomePrograms() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run laterRelative() |> Effect.provideMut<Allocator>(&mut allocator)
}
import sheet_colors
import sheet_binary { Writer, Reader, DecodeError }
import silk.core.result { Result }

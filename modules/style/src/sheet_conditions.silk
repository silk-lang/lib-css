//! Evaluates retained stylesheet conditions once per host-environment change.
import sheet { Sheet, ConditionKind, NONE }
import media_features { Environment }
import media_queries
import input { Input }
import tokens { Limits, CssError }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Updates rule eligibility and returns whether any result changed. Container conditions stay
/// disabled until the host supplies container-query evaluation. Starting rules are enabled only
/// while computing a node's starting style.
pub effect fn update(sheet: &mut Sheet, environment: &Environment, starting: bool, limits: &Limits) -> bool
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let mut results = List<bool>.make()
  let mut i: usize = 0
  while i < sheet.conditions.length() {
    let condition = sheet.conditions.asSlice()[i]
    let parent = condition.parent == NONE || results.asSlice()[condition.parent]
    let matches = if !parent { false } else {
      match condition.kind {
        ConditionKind.Media => run media_queries.matches(
          &Input.Contiguous { buffer: &sheet.buffers.asSlice()[condition.buffer], range: condition.range }, environment, limits,
        )
        ConditionKind.Starting => starting
        ConditionKind.Container => false
      }
    }
    run results.append(matches)
    i = i + 1
  }
  let mut changed = false
  i = 0
  while i < sheet.ruleConditions.length() {
    let condition = sheet.ruleConditions.asSlice()[i]
    let enabled = condition == NONE || results.asSlice()[condition]
    if sheet.resolver.rules()[i].enabled != enabled { changed = true }
    sheet.resolver.setEnabled(i, enabled)
    i = i + 1
  }
  return changed
}

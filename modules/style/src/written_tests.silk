//! CSS text reads into css-properties' written values and writes back as CSSOM spells it.
import written
import cssom_declaration { StyleDeclaration }
import tokens { Limits, CssError }
import css_properties.convert as convert
import css_properties.convert { Context }
import css_properties.computed { Dimension, DimensionKind }
import css_properties.values as values
import css_properties.values { Value, Declaration }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

fn sameText(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn isText(value: &Value) -> bool {
  return match &value.* {
    Value.Text { .. } => true
    _ => false
  }
}

/// `css` reads into a shaped value that writes back as `expected`.
effect fn shaped(css: &[u8], expected: &[u8], message: string<'static>) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let value = run written.value(css)
  let text = run values.cssText(&value)
  run Testing.expect(!isText(&value) && sameText(text.asSlice(), expected), message)
}

/// `css` has no shape and travels as its own text.
effect fn unshaped(css: &[u8], expected: &[u8], message: string<'static>) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let value = run written.value(css)
  let text = run values.cssText(&value)
  run Testing.expect(isText(&value) && sameText(text.asSlice(), expected), message)
}

effect fn shapes() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  run shaped(b"auto", b"auto", "a keyword")
  run shaped(b" Inline-Flex ", b"inline-flex", "keywords ignore case and outer space")
  run shaped(b"12.5px", b"12.5px", "a length")
  run shaped(b"2EM", b"2em", "units ignore case")
  run shaped(b"50%", b"50%", "a percentage as written")
  run shaped(b"1.5", b"1.5", "a number")
  run shaped(b"-4px", b"-4px", "a negative length")
  run shaped(b"red", b"rgb(255, 0, 0)", "a named color")
  run shaped(b"#ff8000", b"rgb(255, 128, 0)", "a hex color")
  run shaped(b"rgb(0 0 0 / 25%)", b"rgba(0, 0, 0, 0.25)", "a color function")
  run shaped(b"transparent", b"transparent", "transparent stays a keyword")
  run shaped(b"currentColor", b"currentcolor", "currentcolor is a keyword")
  run shaped(b"1px 2px 3px 4px", b"1px 2px 3px 4px", "a space-separated list")
  run shaped(b"1px 2px / 50%", b"1px 2px / 50%", "a slash binds looser than spaces")
  run shaped(b"stable both-edges", b"stable both-edges", "a keyword pair")
  run shaped(b"0px 2px 4px 0px rgb(0 0 0 / 0.5) inset", b"0px 2px 4px 0px rgba(0, 0, 0, 0.5) inset", "a shadow")
  run shaped(b"1px 1px red, 2px 2px blue", b"1px 1px rgb(255, 0, 0), 2px 2px rgb(0, 0, 255)", "a comma list")
  run shaped(
    b"linear-gradient(45deg, red, rgba(0, 0, 0, 0.25))",
    b"linear-gradient(45deg, rgb(255, 0, 0), rgba(0, 0, 0, 0.25))",
    "a known function",
  )
  run shaped(b"blur(4px)", b"blur(4px)", "a filter function")
}

effect fn math() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  run shaped(b"calc(10px + 50%)", b"calc(10px + 50%)", "a sum")
  run shaped(b"calc(100% - 8px)", b"calc(100% - 8px)", "a difference negates its term")
  run shaped(b"calc(10px)", b"calc(10px)", "calc of one term stays calc")
  run shaped(b"calc(2 * 3px)", b"calc(2 * 3px)", "a product")
  run shaped(b"calc(100% / 3)", b"calc(100% * (1 / 3))", "a quotient multiplies by the inverse")
  run shaped(b"calc(1px + 2 * 3px)", b"calc(1px + (2 * 3px))", "a product binds tighter than a sum")
  run shaped(b"calc((1px + 2px) * 3)", b"calc((1px + 2px) * 3)", "parentheses group")
  run shaped(b"calc(1px - (2px + 3px))", b"calc(1px + (-1 * (2px + 3px)))", "a negated group")
  run shaped(b"min(10px, 5%)", b"min(10px, 5%)", "min")
  run shaped(b"clamp(1px, 2% + 3px, 4px)", b"clamp(1px, calc(2% + 3px), 4px)", "clamp takes expressions")
  run shaped(b"calc(1px + max(2px, 3%))", b"calc(1px + max(2px, 3%))", "a nested math function")
  run unshaped(b"calc(1px +)", b"calc(1px +)", "a missing operand has no shape")
  run unshaped(b"calc(1px 2px)", b"calc(1px 2px)", "two operands need an operator")
}

effect fn fallbacks() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  run unshaped(b"url(a.png)", b"url(a.png)", "a url")
  run unshaped(b"  \"Fira Sans\", serif ", b"\"Fira Sans\", serif", "a string, trimmed")
  run unshaped(b"var(--gap)", b"var(--gap)", "a variable reference")
  run unshaped(b"CanvasText", b"CanvasText", "a color without fixed channels")
  run unshaped(b"1px solid mystery", b"1px solid mystery", "one unknown part keeps the whole text")
  run unshaped(b"3furlong", b"3furlong", "an unknown unit")
  run unshaped(b"", b"", "nothing")
  let text = run values.text(b"calc(1px + 2px)")
  let resolved = run written.resolve(&text)
  run Testing.expect(!isText(&resolved), "resolving text gives it a shape")
  let kept = run written.resolve(&values.px(3.0))
  run Testing.expect(values.same(&kept, &values.px(3.0)), "resolving a shaped value copies it")
}

effect fn expectDeclaration(declaration: &Declaration, expected: &[u8], message: string<'static>) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  run values.writeDeclaration(&mut out, declaration)
  run Testing.expect(sameText(out.asSlice(), expected), message)
}

effect fn blocks() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let list = run written.declarations(
    b" width: 10px; ; COLOR: red !important; --gap: 4px; nonsense: 1; height; margin: 1px 2px ! IMPORTANT; background-image: url(\"a;b.png\"); flex-grow: 2",
  )
  let items = list.asSlice()
  run Testing.expect(items.length == 5, "unknown, custom and broken declarations are dropped")
  if items.length == 5 {
    run expectDeclaration(&items[0], b"width: 10px", "a declaration")
    run expectDeclaration(&items[1], b"color: rgb(255, 0, 0) !important", "property names ignore case")
    run expectDeclaration(&items[2], b"margin: 1px 2px !important", "important with inner space")
    run expectDeclaration(&items[3], b"background-image: url(\"a;b.png\")", "a semicolon inside a string")
    run expectDeclaration(&items[4], b"flex-grow: 2", "the last declaration needs no semicolon")
    let context = Context { fontSize: 16.0, rootFontSize: 16.0, viewportWidth: 800.0, viewportHeight: 600.0 }
    let width = convert.dimension(&items[0].value, &context)
    run Testing.expect(
      match &width {
        Option<Dimension>.Some { value } => value.kind == DimensionKind.Length && value.value == 10.0
        _ => false
      },
      "a parsed value converts to a computed one",
    )
  }
}

effect fn cssom() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let style = run StyleDeclaration.parse(b"opacity: 0.5; fill: #00f !important", &limits)
  let list = run written.fromStyle(&style)
  let items = list.asSlice()
  run Testing.expect(items.length == 2, "one shared declaration per CSSOM entry")
  if items.length == 2 {
    run expectDeclaration(&items[0], b"opacity: 0.5", "a CSSOM number")
    run expectDeclaration(&items[1], b"fill: rgb(0, 0, 255) !important", "a CSSOM color with priority")
  }
}

test effect fn valuesTakeTheirShapes() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shapes() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn mathFollowsTypedOm() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run math() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn unshapedValuesStayText() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fallbacks() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationBlocks() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run blocks() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssomDeclarations() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cssom() |> Effect.provideMut<Allocator>(&mut allocator)
}

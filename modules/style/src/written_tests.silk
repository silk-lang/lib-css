//! CSS text reads into css-properties' written values and writes back as CSSOM spells it.
import written
import cssom_declaration { StyleDeclaration }
import tokens { Limits, CssError }
import css_properties.convert as convert
import css_properties.convert { Context }
import css_properties.computed { Dimension, DimensionKind }
import css_properties.values as values
import css_properties.values { Value, Declaration }
import css_properties.keywords { Keyword }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

fn sameText(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn isText(value: &Value) -> bool {
  return match &value.* {
    Value.Text { .. } => true
    _ => false
  }
}

/// `css` reads into a shaped value that writes back as `expected`.
effect fn shaped(css: &[u8], expected: &[u8], message: string<'static>) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let value = run written.value(css)
  let text = run values.cssText(&value)
  run Testing.expect(!isText(&value) && sameText(text.asSlice(), expected), message)
}

/// `css` has no shape and travels as its own text.
effect fn unshaped(css: &[u8], expected: &[u8], message: string<'static>) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let value = run written.value(css)
  let text = run values.cssText(&value)
  run Testing.expect(isText(&value) && sameText(text.asSlice(), expected), message)
}

effect fn shapes() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  run shaped(b"auto", b"auto", "a keyword")
  run shaped(b" Inline-Flex ", b"inline-flex", "keywords ignore case and outer space")
  run shaped(b"12.5px", b"12.5px", "a length")
  run shaped(b"2EM", b"2em", "units ignore case")
  run shaped(b"50%", b"50%", "a percentage as written")
  run shaped(b"1.5", b"1.5", "a number")
  run shaped(b"-4px", b"-4px", "a negative length")
  run shaped(b"red", b"rgb(255, 0, 0)", "a named color")
  run shaped(b"#ff8000", b"rgb(255, 128, 0)", "a hex color")
  run shaped(b"rgb(0 0 0 / 25%)", b"rgba(0, 0, 0, 0.25)", "a color function")
  run shaped(b"transparent", b"transparent", "transparent stays a keyword")
  run shaped(b"currentColor", b"currentcolor", "currentcolor is a keyword")
  run shaped(b"1px 2px 3px 4px", b"1px 2px 3px 4px", "a space-separated list")
  run shaped(b"1px 2px / 50%", b"1px 2px / 50%", "a slash binds looser than spaces")
  run shaped(b"stable both-edges", b"stable both-edges", "a keyword pair")
  run shaped(b"0px 2px 4px 0px rgb(0 0 0 / 0.5) inset", b"0px 2px 4px 0px rgba(0, 0, 0, 0.5) inset", "a shadow")
  run shaped(b"1px 1px red, 2px 2px blue", b"1px 1px rgb(255, 0, 0), 2px 2px rgb(0, 0, 255)", "a comma list")
  run shaped(
    b"linear-gradient(45deg, red, rgba(0, 0, 0, 0.25))",
    b"linear-gradient(45deg, rgb(255, 0, 0), rgba(0, 0, 0, 0.25))",
    "a known function",
  )
  run shaped(b"blur(4px)", b"blur(4px)", "a filter function")
}

effect fn math() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  run shaped(b"calc(10px + 50%)", b"calc(10px + 50%)", "a sum")
  run shaped(b"calc(100% - 8px)", b"calc(100% - 8px)", "a difference negates its term")
  run shaped(b"calc(10px)", b"calc(10px)", "calc of one term stays calc")
  run shaped(b"calc(2 * 3px)", b"calc(2 * 3px)", "a product")
  run shaped(b"calc(100% / 3)", b"calc(100% * (1 / 3))", "a quotient multiplies by the inverse")
  run shaped(b"calc(1px + 2 * 3px)", b"calc(1px + (2 * 3px))", "a product binds tighter than a sum")
  run shaped(b"calc((1px + 2px) * 3)", b"calc((1px + 2px) * 3)", "parentheses group")
  run shaped(b"calc(1px - (2px + 3px))", b"calc(1px + (-1 * (2px + 3px)))", "a negated group")
  run shaped(b"calc(sin(30deg) * 100px)", b"calc(0.5 * 100px)", "a sine of a constant angle is a number")
  run shaped(b"pow(2, 3)", b"8", "a power")
  run shaped(b"calc(sqrt(16) * 1px + hypot(3px, 4px))", b"calc((4 * 1px) + 5px)", "a root and a hypotenuse")
  run shaped(b"round(up, 13px, 4px)", b"16px", "a value stepped up")
  run shaped(b"round(calc(10px + 3.4px), 1px)", b"13px", "a constant sum stepped to the nearest")
  run shaped(b"mod(-7px, 4px)", b"1px", "mod takes the sign of the step")
  run shaped(b"rem(-7px, 4px)", b"-3px", "rem takes the sign of the value")
  run shaped(b"abs(-3em)", b"3em", "an absolute value keeps its unit")
  run shaped(b"atan2(1px, 1px)", b"45deg", "an arc tangent is an angle")
  run unshaped(b"sin(1em)", b"sin(1em)", "a function of the wrong type stays text")
  run unshaped(b"round(1em, 1px)", b"round(1em, 1px)", "arguments that need a font stay text")
  run shaped(b"min(10px, 5%)", b"min(10px, 5%)", "min")
  run shaped(b"clamp(1px, 2% + 3px, 4px)", b"clamp(1px, calc(2% + 3px), 4px)", "clamp takes expressions")
  run shaped(b"calc(1px + max(2px, 3%))", b"calc(1px + max(2px, 3%))", "a nested math function")
  run unshaped(b"calc(1px +)", b"calc(1px +)", "a missing operand has no shape")
  run unshaped(b"calc(1px 2px)", b"calc(1px 2px)", "two operands need an operator")
}

effect fn fallbacks() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  run unshaped(b"url(a.png)", b"url(a.png)", "a url")
  run unshaped(b"  \"Fira Sans\", serif ", b"\"Fira Sans\", serif", "a string, trimmed")
  run unshaped(b"var(--gap)", b"var(--gap)", "a variable reference")
  run unshaped(b"CanvasText", b"CanvasText", "a color without fixed channels")
  run unshaped(b"1px solid mystery", b"1px solid mystery", "one unknown part keeps the whole text")
  run unshaped(b"3furlong", b"3furlong", "an unknown unit")
  run unshaped(b"", b"", "nothing")
  run shaped(b"env(safe-area-inset-top)", b"0px", "a safe area inset the host has none of")
  run shaped(b"env(safe-area-inset-left, 20px)", b"0px", "a known name takes the host's value, not the fallback")
  run shaped(b"env(--unknown, 12px)", b"12px", "an unknown name takes its fallback")
  run shaped(b"calc(8px + env(safe-area-inset-bottom))", b"calc(8px + 0px)", "env() inside math")
  run shaped(b"env(nope, env(also-nope, 1px 2px))", b"1px 2px", "a fallback can hold env()")
  run unshaped(b"env(nope)", b"env(nope)", "an unknown name without fallback has no value")
  let text = run values.text(b"calc(1px + 2px)")
  let resolved = run written.resolve(&text)
  run Testing.expect(!isText(&resolved), "resolving text gives it a shape")
  let kept = run written.resolve(&values.px(3.0))
  run Testing.expect(values.same(&kept, &values.px(3.0)), "resolving a shaped value copies it")
}

effect fn expectDeclaration(declaration: &Declaration, expected: &[u8], message: string<'static>) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  run values.writeDeclaration(&mut out, declaration)
  run Testing.expect(sameText(out.asSlice(), expected), message)
}

effect fn blocks() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let list = run written.declarations(
    b" width: 10px; ; COLOR: red !important; --gap: 4px; nonsense: 1; height; margin: 1px 2px ! IMPORTANT; background-image: url(\"a;b.png\"); flex-grow: 2",
  )
  let items = list.asSlice()
  run Testing.expect(items.length == 5, "unknown, custom and broken declarations are dropped")
  if items.length == 5 {
    run expectDeclaration(&items[0], b"width: 10px", "a declaration")
    run expectDeclaration(&items[1], b"color: rgb(255, 0, 0) !important", "property names ignore case")
    run expectDeclaration(&items[2], b"margin: 1px 2px !important", "important with inner space")
    run expectDeclaration(&items[3], b"background-image: url(\"a;b.png\")", "a semicolon inside a string")
    run expectDeclaration(&items[4], b"flex-grow: 2", "the last declaration needs no semicolon")
    let mut context = Context.make()
    context.viewportWidth = 800.0
    context.viewportHeight = 600.0
    let width = convert.dimension(&items[0].value, &context)
    run Testing.expect(
      match &width {
        Option<Dimension>.Some { value } => value.kind == DimensionKind.Length && value.value == 10.0
        _ => false
      },
      "a parsed value converts to a computed one",
    )
    let endless = run written.declarations(b"border-top-left-radius: calc(infinity * 1px); width: calc(-infinity * 1px + 50%)")
    let wide = endless.asSlice()
    run Testing.expect(wide.length == 2, "math constants parse")
    if wide.length == 2 {
      run Testing.expect(
        match &convert.length(&wide[0].value, &context) {
          Option<f32>.Some { value } => value == 33554432.0
          _ => false
        },
        "an infinite length is the largest length",
      )
      run Testing.expect(
        match &convert.dimension(&wide[1].value, &context) {
          Option<Dimension>.Some { value } => value.kind == DimensionKind.Calc && value.value == -33554432.0
          _ => false
        },
        "and stays finite beside a percentage",
      )
    }
  }
}

// The properties the catalog gained for apps (css-ui, css-logical, css-overflow, css-text,
// overscroll, scroll snap, lists, tables, multicol), and legacy names that alias others.
effect fn appProperties() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let list = run written.declarations(
    b"outline: 2px solid red; outline-offset: 2px; user-select: none; margin-inline: 4px 8px; inset-block-start: 0; line-clamp: 3; text-wrap: balance; overscroll-behavior: contain; scroll-behavior: smooth; scroll-padding-top: 8px; touch-action: pan-y pinch-zoom; accent-color: red; appearance: none; resize: vertical; contain: layout paint; will-change: transform; list-style: none; border-collapse: collapse; border-spacing: 2px; column-count: 2; word-wrap: break-word; -webkit-user-select: text; grid-gap: 4px",
  )
  let items = list.asSlice()
  run Testing.expect(items.length == 23, "every new property and alias is kept")
  if items.length == 23 {
    run expectDeclaration(&items[0], b"outline: 2px solid rgb(255, 0, 0)", "outline")
    run expectDeclaration(&items[2], b"user-select: none", "user-select")
    run expectDeclaration(&items[3], b"margin-inline: 4px 8px", "a logical shorthand")
    run expectDeclaration(&items[5], b"line-clamp: 3", "line-clamp")
    run expectDeclaration(&items[6], b"text-wrap: balance", "text-wrap")
    run expectDeclaration(&items[9], b"scroll-padding-top: 8px", "scroll-padding-top")
    run expectDeclaration(&items[10], b"touch-action: pan-y pinch-zoom", "touch-action keywords")
    run expectDeclaration(&items[13], b"resize: vertical", "resize")
    run expectDeclaration(&items[14], b"contain: layout paint", "contain keywords")
    run expectDeclaration(&items[19], b"column-count: 2", "column-count")
    run expectDeclaration(&items[20], b"overflow-wrap: break-word", "word-wrap is a legacy name for overflow-wrap")
    run expectDeclaration(&items[21], b"user-select: text", "-webkit-user-select aliases user-select")
    run expectDeclaration(&items[22], b"gap: 4px", "grid-gap aliases gap")
  }
}

effect fn cssom() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let style = run StyleDeclaration.parse(b"opacity: 0.5; fill: #00f !important", &limits)
  let list = run written.fromStyle(&style)
  let items = list.asSlice()
  run Testing.expect(items.length == 2, "one shared declaration per CSSOM entry")
  if items.length == 2 {
    run expectDeclaration(&items[0], b"opacity: 0.5", "a CSSOM number")
    run expectDeclaration(&items[1], b"fill: rgb(0, 0, 255) !important", "a CSSOM color with priority")
  }
}

test effect fn valuesTakeTheirShapes() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shapes() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn mathFollowsTypedOm() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run math() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn unshapedValuesStayText() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fallbacks() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationBlocks() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run blocks() |> Effect.provideMut<Allocator>(&mut allocator)
  run appProperties() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssomDeclarations() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cssom() |> Effect.provideMut<Allocator>(&mut allocator)
}

import css_properties.catalog { Property }

effect fn projection(source: Property, css: &[u8], target: Property, expected: &[u8]) -> bool
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let declaration = Declaration { property: source, value: run written.value(css), important: false }
  let result = run written.longhand(&declaration, target)
  if let Option<Value>.Some { value } = move result {
    let text = run values.cssText(&value)
    return sameText(text.asSlice(), expected)
  }
  return false
}

test effect fn complexShorthandProjectionSharesValueGrammars() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(run projection(Property.Margin, b"1px 2px", Property.MarginLeft, b"2px") |> Effect.provideMut<Allocator>(&mut allocator), "box shorthand typed projection")
  run Testing.expect(run projection(Property.WhiteSpace, b"pre-wrap", Property.WhiteSpaceCollapse, b"preserve") |> Effect.provideMut<Allocator>(&mut allocator), "white-space expands its computed components")
  run Testing.expect(run projection(Property.Font, b"italic 20px serif", Property.FontSize, b"20px") |> Effect.provideMut<Allocator>(&mut allocator), "font projects through the shared grammar")
  run Testing.expect(run projection(Property.Animation, b"fade 2s linear", Property.AnimationDuration, b"2s") |> Effect.provideMut<Allocator>(&mut allocator), "animation selects its longhand list")
  run Testing.expect(run projection(Property.Transition, b"opacity 1s linear, width 2s ease-in 100ms allow-discrete", Property.TransitionDuration, b"1s, 2s") |> Effect.provideMut<Allocator>(&mut allocator), "transition keeps each duration")
  run Testing.expect(run projection(Property.Transition, b"opacity 1s linear, width 2s ease-in 100ms allow-discrete", Property.TransitionProperty, b"opacity, width") |> Effect.provideMut<Allocator>(&mut allocator), "transition keeps its property list")
  run Testing.expect(run projection(Property.Transition, b"opacity 1s linear, width 2s ease-in 100ms allow-discrete", Property.TransitionBehavior, b"normal, allow-discrete") |> Effect.provideMut<Allocator>(&mut allocator), "transition behavior projects and resets")
  run Testing.expect(run projection(Property.All, b"unset", Property.Width, b"unset") |> Effect.provideMut<Allocator>(&mut allocator), "wide values project without parsing")
}

test effect fn containerShorthandProjectsTypedContainmentAndNames() ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let declarations = run written.declarations(b"container: outer card / size; container: ca\\72 d / inline-size; container: red") |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = [Keyword.Size, Keyword.InlineSize, Keyword.Normal]
  let mut i: usize = 0
  while i < expected.length {
    let projected = run written.longhand(&declarations.asSlice()[i], Property.ContainerType) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(match &projected { Option<Value>.Some { value: Value.Keyword { value } } => value == expected[i] _ => false }, "textual container shorthand types become typed keyword components")
    i = i + 1
  }
  let name = run written.longhand(&declarations.asSlice()[2], Property.ContainerName) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(match &name { Option<Value>.Some { value: Value.Text { css } } => sameText(css.asSlice(), b"red") _ => false }, "a container name that is also a color remains an identifier")
  let standalone = run written.declarations(b"container-name: currentcolor; container-name: red") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(match &standalone.asSlice()[0].value { Value.Text { css } => sameText(css.asSlice(), b"currentcolor") _ => false }, "standalone names do not become context-dependent colors")
}

effect fn dropped(source: Property, css: &[u8], target: Property) -> bool
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let declaration = Declaration { property: source, value: run written.value(css), important: false }
  return (run written.longhand(&declaration, target)).isNone()
}

effect fn backgroundBody() -> () ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let layered = b"linear-gradient(red, red) 0 0 / 10px 10px no-repeat, blue linear-gradient(blue, blue)"
  run Testing.expect(run projection(Property.Background, layered, Property.BackgroundSize, b"10px 10px, auto"), "one size a layer")
  run Testing.expect(run projection(Property.Background, layered, Property.BackgroundPosition, b"0 0, 0% 0%"), "one position a layer")
  run Testing.expect(run projection(Property.Background, layered, Property.BackgroundRepeat, b"no-repeat, repeat"), "one repeat a layer")
  run Testing.expect(run projection(Property.Background, layered, Property.BackgroundColor, b"rgb(0, 0, 255)"), "the color comes from the last layer")
  run Testing.expect(run projection(Property.Background, b"center / cover", Property.BackgroundSize, b"cover"), "a keyword size")
  run Testing.expect(run projection(Property.Background, b"left 5px top / 50% auto", Property.BackgroundPosition, b"left 5px top"), "the position before the size")
  run Testing.expect(run projection(Property.Background, b"left 5px top / 50% auto", Property.BackgroundSize, b"50% auto"), "a two-value size")
  let pictured = b"url(a.png) center / cover no-repeat, linear-gradient(red, blue), url(\"b,).png\") blue"
  run Testing.expect(run projection(Property.Background, pictured, Property.BackgroundImage, b"url(a.png), linear-gradient(rgb(255, 0, 0), rgb(0, 0, 255)), url(\"b,).png\")"), "url images stay in their layers")
  run Testing.expect(run projection(Property.Background, pictured, Property.BackgroundRepeat, b"no-repeat, repeat, repeat"), "the repeats beside url images")
  run Testing.expect(run projection(Property.Background, pictured, Property.BackgroundSize, b"cover, auto, auto"), "the sizes beside url images")
  run Testing.expect(run projection(Property.Background, pictured, Property.BackgroundColor, b"rgb(0, 0, 255)"), "the color beside a url image")
  run Testing.expect(run dropped(Property.Background, b"url(a.png) url(b.png)", Property.BackgroundImage), "one image a layer")
  let worded = b"url(a.png) repeat-x local, url(\"local, repeat-y.png\") repeat-y fixed, red REPEAT-X"
  run Testing.expect(run projection(Property.Background, worded, Property.BackgroundRepeat, b"repeat no-repeat, no-repeat repeat, repeat no-repeat"), "repeat-x and repeat-y are two-value repeats")
  run Testing.expect(run projection(Property.Background, worded, Property.BackgroundAttachment, b"local, fixed, scroll"), "local stays in its layer")
  run Testing.expect(run projection(Property.Background, worded, Property.BackgroundColor, b"rgb(255, 0, 0)"), "the other longhands read the rest")
  run Testing.expect(run dropped(Property.Background, b"red repeat-x repeat", Property.BackgroundRepeat), "repeat-x is a whole repeat")
  run Testing.expect(run dropped(Property.Background, b"red, blue", Property.BackgroundColor), "a color only in the last layer")
  run Testing.expect(run dropped(Property.Background, b"no-repeat / 10px", Property.BackgroundSize), "a size follows a position")
  run Testing.expect(run dropped(Property.Background, b"0 no-repeat 0", Property.BackgroundPosition), "a position is one run")
  let radial = b"radial-gradient(closest-side, #f00, transparent)"
  run Testing.expect(run projection(Property.Background, radial, Property.BackgroundImage, radial), "a radial gradient is the image")
  run Testing.expect(run projection(Property.Background, radial, Property.BackgroundColor, b"transparent"), "beside a radial gradient the color is initial")
  let cones = b"conic-gradient(from 90deg, rgb(255 0 0 / 50%), blue) center / 50% no-repeat, red"
  run Testing.expect(run projection(Property.Background, cones, Property.BackgroundImage, b"conic-gradient(from 90deg, rgb(255 0 0 / 50%), blue), none"), "a conic gradient with nested functions stays in its layer")
  run Testing.expect(run projection(Property.Background, cones, Property.BackgroundSize, b"50%, auto"), "the size beside a conic gradient")
  run Testing.expect(run projection(Property.Background, cones, Property.BackgroundColor, b"rgb(255, 0, 0)"), "the color after a conic gradient layer")
}

test effect fn backgroundShorthandTakesLayersAndSizes() -> () ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run backgroundBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

//! Immutable token inputs shared by a root's variable scopes across adopted sheets.
import css_properties.census { Census }
import adopted { AdoptedSheet, Candidate as MatchedCandidate, Source }
import sheet { Declaration as SheetDeclaration }
import cascade { Declaration, Candidate, Name, Target, Specified, Priority }
import cascade
import declaration_values
import variables { VariableStore, ScopeId, RegistrationError, nameBit }
import variables
import scope_cache { Cache }
import values { Wide, Mode }
import tokens { Buffers, TokenBuffer, TokenRange, Kind, Span, Limits, CssError, equal }
import input { Input, TokenRef }
import cssom_serialization
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.hash_map { HashMap }
import silk.collections.hash { Hash }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct InlineCustom<'name, 'tokens> {
  pub name: &'name [u8],
  pub tokens: &'tokens TokenBuffer,
  pub priority: Priority,
}

/// Which custom properties declarations declare and which their values mention, as sets of
/// name bits (`nameBit`): two masks that share no bit name no property in common. A value
/// mentions every dashed identifier in it, so `var()`, its fallbacks and `style()` tests all
/// count, and so may names that are not properties at all.
pub struct VariableMasks { pub reads: u64, pub declares: u64 }
impl Copy for VariableMasks {}

impl VariableMasks {
  pub fn none() -> VariableMasks { return VariableMasks { reads: 0, declares: 0 } }
  pub fn with(self: VariableMasks, other: VariableMasks) -> VariableMasks {
    return VariableMasks { reads: u64.bitOr(self.reads, other.reads), declares: u64.bitOr(self.declares, other.declares) }
  }
}

fn dashed(text: &[u8]) -> bool { return text.length > 2 && text[0] == 45 && text[1] == 45 }

/// The names the tokens of `range` mention.
pub fn mentioned(buffer: &TokenBuffer, range: TokenRange) -> u64 {
  let all = buffer.tokens.asSlice()
  let mut bits: u64 = 0
  let mut i = range.start
  while i < range.end && i < all.length {
    match &all[i].kind {
      Kind.Ident { text } => { if dashed(buffer.text(text)) { bits = u64.bitOr(bits, nameBit(buffer.text(text))) } }
      Kind.Function { name } => { if dashed(buffer.text(name)) { bits = u64.bitOr(bits, nameBit(buffer.text(name))) } }
      _ => {}
    }
    i = i + 1
  }
  return bits
}

/// The masks of the inline custom properties `inline`.
pub fn inlineMasks(inline: &[InlineCustom<'_, '_>]) -> VariableMasks {
  let mut masks = VariableMasks.none()
  let mut i: usize = 0
  while i < inline.length {
    if declaration_values.customName(inline[i].name) {
      masks.declares = u64.bitOr(masks.declares, nameBit(inline[i].name))
      masks.reads = u64.bitOr(masks.reads, mentioned(inline[i].tokens, inline[i].tokens.all()))
    }
    i = i + 1
  }
  return masks
}

struct InlineEntry { declaration: usize, next: usize }
impl Copy for InlineEntry {}

/// Distinct inline custom declarations one epoch retains; past it the host restyles from the root.
const INLINE_LIMIT: usize = 4096

pub struct Inputs {
  inline: List<InlineEntry>,
  inlineHeads: HashMap<u64, usize>,
  scopes: Cache,
  retained: bool,
  baseBuffers: usize,
  baseCatalog: usize,
  pub buffers: Buffers<'static>,
  pub catalog: List<Declaration>,
  /// The masks of each sheet declaration in `catalog`: the entries below `baseCatalog`.
  masks: List<VariableMasks>,
  offsets: List<usize>,
  pub variables: VariableStore,
  /// For the bench census: scopes asked for, and those built (the rest were found).
  pub scopeCalls: usize,
  pub scopeBuilds: usize,
  pub scopeCandidates: usize,
}

impl Inputs {
  pub effect fn census(self: &Self, out: &mut Census) -> () ! OutOfMemoryError ? &mut Allocator {
    run out.held("variables.catalog(declarations copied from the sheets)", self.catalog.length(), self.catalog.capacity(), Intrinsic.layoutOf<Declaration>().bytes)
    run out.held("variables.inline-entries", self.inline.length(), self.inline.capacity(), Intrinsic.layoutOf<InlineEntry>().bytes)
    run self.variables.census(&mut out)
    run out.work("variables.scope-requests", self.scopeCalls)
    run out.work("variables.scope-requests.candidates", self.scopeCandidates)
    run out.work("variables.scopes-built", self.scopeBuilds)
  }

  pub effect fn make(sheets: &[AdoptedSheet], limits: &Limits) -> Inputs
    ! RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
    let mut buffers = Buffers.make()
    let mut bufferOffsets = List<usize>.make()
    let mut offsets = List<usize>.make()
    let mut catalog = List<Declaration>.make()
    let mut names = TokenBuffer.make()
    let mut i: usize = 0
    while i < sheets.length {
      run bufferOffsets.append(buffers.length())
      let source = sheets[i].sheet.buffers.asSlice()
      let mut at: usize = 0
      while at < source.length {
        run buffers.append(run source[at].copy())
        at = at + 1
      }
      i = i + 1
    }
    let nameBuffer = buffers.length()
    i = 0
    while i < sheets.length {
      run offsets.append(catalog.length())
      let declarations = sheets[i].sheet.declarations.asSlice()
      let offset = bufferOffsets.asSlice()[i]
      let mut at: usize = 0
      while at < declarations.length {
        let declaration = match &declarations[at] {
          SheetDeclaration.Custom { name, buffer, range, important } => {
            let start = names.data.length()
            run names.data.append(name.asSlice())
            let key = Name { buffer: nameBuffer, span: Span { start: start, end: names.data.length() } }
            let source = Input.Contiguous { buffer: &sheets[i].sheet.buffers.asSlice()[buffer], range: range }
            let specified = match cascade.wide(&source) {
              Option<Wide>.Some { value } => Specified.Wide { keyword: value }
              Option<Wide>.None => Specified.Pending { range: range, mode: Mode.Css }
            }
            Declaration { target: Target.Custom { name: key }, specified: specified, buffer: offset + buffer, important: important }
          }
          SheetDeclaration.Pending { property, buffer, range, important } => Declaration {
            target: Target.Property { property: property }, specified: Specified.Pending { range: range, mode: Mode.Css },
            buffer: offset + buffer, important: important,
          }
          SheetDeclaration.Typed { property, important, .. } => Declaration {
            target: Target.Property { property: property }, specified: Specified.Wide { keyword: Wide.Initial }, buffer: 0, important: important,
          }
          SheetDeclaration.ColorExpression { property, important, .. } => Declaration {
            target: Target.Property { property: property }, specified: Specified.Wide { keyword: Wide.Initial }, buffer: 0, important: important,
          }
        }
        run catalog.append(declaration)
        at = at + 1
      }
      i = i + 1
    }
    run buffers.append(move names)
    let closing = run variables.appendClosingBuffer(&mut buffers)
    let mut variables = VariableStore.make(closing)
    i = 0
    while i < sheets.length {
      let registrations = sheets[i].sheet.registrations.asSlice()
      let mut at: usize = 0
      while at < registrations.length {
        if registrations[at].enabled {
          let mut definition = registrations[at].definition
          definition.name.buffer = definition.name.buffer + bufferOffsets.asSlice()[i]
          run variables.register(buffers.view(), definition, limits)
        }
        at = at + 1
      }
      i = i + 1
    }
    let baseBuffers = buffers.owned().length
    let baseCatalog = catalog.length()
    let mut masks = List<VariableMasks>.make()
    i = 0
    while i < catalog.length() {
      let item = catalog.asSlice()[i]
      let mut entry = VariableMasks.none()
      if let Specified.Pending { range, .. } = item.specified { entry.reads = mentioned(&buffers.one(item.buffer)[0], range) }
      if let Target.Custom { name } = item.target { entry.declares = nameBit(buffers.one(name.buffer)[0].text(name.span)) }
      run masks.append(entry)
      i = i + 1
    }
    return Inputs { inline: List<InlineEntry>.make(), inlineHeads: HashMap<u64, usize>.make(Hash.seed(1093)), scopes: Cache.make(), retained: true, baseBuffers: baseBuffers, baseCatalog: baseCatalog, masks: move masks, buffers: move buffers, catalog: move catalog, offsets: move offsets, variables: move variables, scopeCalls: 0, scopeBuilds: 0, scopeCandidates: 0 }
  }

  /// Repeating the same scope inputs cannot grow storage until this becomes false.
  pub fn canRetainScopes(self: &Self) -> bool { return self.retained && self.scopes.retainsAll() }

  /// What the sheet declarations of `matches` declare and mention between them.
  pub fn sheetMasks(self: &Self, matches: &[MatchedCandidate]) -> VariableMasks {
    let mut masks = VariableMasks.none()
    let mut i: usize = 0
    while i < matches.length {
      if let Source.Sheet { sheet, declaration } = matches[i].source {
        let index = self.offsets.asSlice()[sheet] + declaration
        if index < self.masks.length() { masks = masks.with(self.masks.asSlice()[index]) }
      }
      i = i + 1
    }
    return masks
  }

  /// The custom properties the entries of two scopes differ in (`VariableStore.differing`).
  pub fn differing(self: &Self, a: ScopeId, b: ScopeId) -> u64 { return self.variables.differing(self.buffers.view(), a, b) }

  /// Appends to `out` the candidates of `matches` that declare a custom property: with the
  /// element's inline custom properties, all that `scope` reads of a match.
  pub effect fn customCandidates(self: &Self, matches: &[MatchedCandidate], out: &mut List<MatchedCandidate>) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    while i < matches.length {
      if let Source.Sheet { sheet, declaration } = matches[i].source {
        if let Target.Custom { .. } = self.catalog.asSlice()[self.offsets.asSlice()[sheet] + declaration].target { run out.append(matches[i]) }
      }
      i = i + 1
    }
  }

  /// Builds only the custom-property part of the cascade; ordinary declarations do not add work.
  pub effect fn scope(self: &mut Self, matches: &[MatchedCandidate], inline: &[InlineCustom<'_, '_>], parent: Option<ScopeId>, limits: &Limits) -> ScopeId
    ! CssError | OutOfMemoryError ? &mut Allocator {
    let mut candidates = List<Candidate>.make()
    let mut i: usize = 0
    while i < matches.length {
      if let Source.Sheet { sheet, declaration } = matches[i].source {
        let index = self.offsets.asSlice()[sheet] + declaration
        if let Target.Custom { .. } = self.catalog.asSlice()[index].target {
          run candidates.append(Candidate { declaration: index, priority: matches[i].priority })
        }
      }
      i = i + 1
    }
    i = 0
    while i < inline.length {
      let item = &inline[i]
      if declaration_values.customName(item.name) {
        let mut priority = item.priority
        priority.inline = true
        let declaration = run self.inlineDeclaration(item.name, item.tokens, priority.important)
        run candidates.append(Candidate { declaration: declaration, priority: priority })
      }
      i = i + 1
    }
    self.scopeCalls = self.scopeCalls + 1
    self.scopeCandidates = self.scopeCandidates + candidates.length()
    if let Option<ScopeId>.Some { value } = self.scopes.find(parent, candidates.asSlice(), limits) { return value }
    self.scopeBuilds = self.scopeBuilds + 1
    let scope = run self.variables.build(self.buffers.view(), self.catalog.asSlice(), candidates.asSlice(), parent, limits)
    run self.scopes.insert(parent, move candidates, limits, scope)
    return scope
  }

  /// The catalog entry of an inline custom property, one for each distinct name, value and
  /// importance, so that equal inline inputs find the scope built for them before.
  effect fn inlineDeclaration(self: &mut Self, name: &[u8], tokens: &TokenBuffer, important: bool) -> usize
    ! OutOfMemoryError ? &mut Allocator {
    let value = tokens.data.asSlice()
    let mut hash = Hash.mix(&Hash.seed(1097), if important { 1 } else { 0 })
    let mut i: usize = 0
    while i < value.length {
      hash = Hash.combine(hash, u8.toU64(value[i]))
      i = i + 1
    }
    i = 0
    while i < name.length {
      hash = Hash.combine(hash, u8.toU64(name[i]))
      i = i + 1
    }
    let mut at = match self.inlineHeads.get(hash) { Option.Some { value: found } => found _ => usize.MAX }
    while at != usize.MAX {
      let entry = self.inline.asSlice()[at]
      let declaration = &self.catalog.asSlice()[entry.declaration]
      let stored = &self.buffers.one(declaration.buffer)[0]
      // The stored buffer is the value's data followed by the name.
      let data = stored.data.asSlice()
      if declaration.important == important && stored.sourceLength == tokens.sourceLength && data.length == value.length + name.length
        && equal(Slice.view<u8>(data, 0, value.length), value) && equal(Slice.view<u8>(data, value.length, name.length), name) {
        return entry.declaration
      }
      at = entry.next
    }
    if self.inline.length() >= INLINE_LIMIT { self.retained = false }
    let mut buffer = run tokens.copy()
    let range = buffer.all()
    let specified = match cascade.wide(&Input.Contiguous { buffer: &buffer, range: range }) {
      Option<Wide>.Some { value: keyword } => Specified.Wide { keyword: keyword }
      _ => Specified.Pending { range: range, mode: Mode.Css }
    }
    let start = buffer.data.length()
    run buffer.data.append(name)
    let key = Name { buffer: self.buffers.length(), span: Span { start: start, end: buffer.data.length() } }
    let declaration = self.catalog.length()
    run self.catalog.append(Declaration { target: Target.Custom { name: key }, specified: specified, buffer: key.buffer, important: important })
    run self.buffers.append(move buffer)
    let next = match self.inlineHeads.get(hash) { Option.Some { value: found } => found _ => usize.MAX }
    drop run self.inlineHeads.insert(hash, self.inline.length())
    run self.inline.append(InlineEntry { declaration: declaration, next: next })
    return declaration
  }

  pub fn resetScopes(self: &mut Self) -> () {
    self.scopes.reset()
    self.retained = true
    self.variables.resetScopes()
    self.buffers.truncateOwned(self.baseBuffers)
    self.catalog.truncate(self.baseCatalog)
    self.inline.clear()
    self.inlineHeads.clear()
  }

  /// A pending declaration after substitution. None is invalid at computed-value time.
  /// The receiver parses/caches the resulting value; no stylesheet syntax is reparsed.
  pub effect fn substitute(self: &Self, scope: ScopeId, sheet: usize, declaration: usize, limits: &Limits) -> Option<Bytes>
    ! CssError | OutOfMemoryError ? &mut Allocator {
    let item = self.catalog.asSlice()[self.offsets.asSlice()[sheet] + declaration]
    if let Specified.Pending { range, .. } = item.specified {
      let replaced = run self.variables.substitute(self.buffers.view(), scope, item.buffer, range, limits)
      if let Option<List<TokenRef>>.Some { value } = move replaced {
        let source = Input.Expanded { buffers: self.buffers.view(), references: value.asSlice() }
        return Option<Bytes>.some(run cssom_serialization.componentsInput(&source))
      }
    }
    return Option<Bytes>.None
  }
}

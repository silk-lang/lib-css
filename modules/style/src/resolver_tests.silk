import resolver { Resolver, Rule, ResolverError }
import cascade { Priority, Origin, Candidate, Declaration, Target, Specified }
import cascade
import properties { Property }
import values { Wide }
import element { ElementTree, MatchContext, StateBits, AttributeText, PseudoTarget, NO_ELEMENT, HOVER }
import selector_index { CandidateIndex }
import selectors { SelectorList }
import selectors
import lexer
import tokens { Limits, TokenRange, TokenBuffer, BufferView, CssError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.num.usize
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

pub struct Tree { pub hovered: bool }
impl ElementTree for Tree {
  fn state(self: &Self, node: usize) -> StateBits { return StateBits { bits: if self.hovered { HOVER } else { 0 } } }
  fn parent(self: &Self, node: usize) -> usize { return if node == 1 { 0 } else { NO_ELEMENT } }
  fn containingHost(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn firstChild(self: &Self, node: usize) -> usize { return if node == 0 { 1 } else { NO_ELEMENT } }
  fn nextSibling(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn previousSibling(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn localName(self: &Self, node: usize) -> &[u8] { return b"button" }
  fn namespaceUri(self: &Self, node: usize) -> &[u8] { return b"" }
  fn attributeCount(self: &Self, node: usize) -> usize { return 1 }
  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] { return b"class" }
  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] { return b"" }
  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] { return if node == 1 { b"a" } else if node == 2 { b"b" } else { b"button hot" } }
  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool { return false }
  fn attribute<'a>(self: &'a Self, node: usize, attribute: usize) -> AttributeText<'a> {
    return AttributeText { namespace: b"", name: b"class", value: if node == 1 { b"a" } else if node == 2 { b"b" } else { b"button hot" } }
  }
  fn language(self: &Self, node: usize) -> &[u8] { return b"" }
  fn isRoot(self: &Self, node: usize) -> bool { return true }
  fn isEmpty(self: &Self, node: usize) -> bool { return node != 0 }
  fn isLink(self: &Self, node: usize) -> bool { return false }
}

effect fn add(resolver: &mut Resolver, buffer: &TokenBuffer, index: usize, layer: usize) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let parsed = run selectors.parse(buffer, buffer.all(), &[], &Limits.make())
  match move parsed {
    Option<SelectorList>.Some { value } => {
      let mut priority = Priority.make(Origin.Author, index)
      priority.layer = layer
      run resolver.add(Rule {
        sheet: 42, index: index, selectors: move value, buffer: index,
        declarations: TokenRange { start: index, end: index + 1 }, priority: priority, enabled: true,
      }, buffer)
    }
    _ => run Testing.expect(false, "fixture selectors parse")
  }
}

fn winner(resolver: &Resolver, declarations: &[Declaration]) -> usize {
  return match &cascade.select(declarations, resolver.declarations(), Property.Color, 0) {
    Option<Candidate>.Some { value } => value.declaration
    _ => 99
  }
}

effect fn exercise() -> ()
  ! AssertionError<'static> | ResolverError | CssError | OutOfMemoryError ? &mut Allocator {
  let buffers = [
    run lexer.tokenize(b"button.button.hot", &Limits.make()),
    run lexer.tokenize(b".hot:hover", &Limits.make()),
  ]
  let mut resolver = Resolver.make()
  run add(&mut resolver, &buffers[0], 0, 0)
  run add(&mut resolver, &buffers[1], 1, 1)
  run resolver.finish()
  let catalog = [
    Declaration { target: Target.Property { property: Property.Color }, specified: Specified.Wide { keyword: Wide.Initial }, buffer: 0, important: false },
    Declaration { target: Target.Property { property: Property.Color }, specified: Specified.Wide { keyword: Wide.Inherit }, buffer: 1, important: false },
  ]
  let mut tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run resolver.resolve(BufferView.of(&buffers), &tree, 0, &[], &mut context)
  run Testing.expect(winner(&resolver, &catalog) == 0, "inactive state has no candidate")
  run Testing.expect(resolver.stateDependencies() == HOVER, "failed state tests remain invalidation dependencies")
  tree.hovered = true
  run resolver.resolve(BufferView.of(&buffers), &tree, 0, &[], &mut context)
  run Testing.expect(winner(&resolver, &catalog) == 1, "later layer wins despite lower specificity")
  run Testing.expect(resolver.matches().length == 2 && resolver.matches()[1].sheet == 42, "matched rule identity survives resolution")
  resolver.setEnabled(1, false)
  run resolver.resolve(BufferView.of(&buffers), &tree, 0, &[], &mut context)
  run Testing.expect(winner(&resolver, &catalog) == 0, "condition change needs no index rebuild")
  run Testing.expect(resolver.stateDependencies() == 0, "disabled rules do not cause state invalidation")
  let mut priority = Priority.make(Origin.Author, 2)
  priority.inline = true
  let inline = [Candidate { declaration: 1, priority: priority }]
  run resolver.resolve(BufferView.of(&buffers), &tree, 0, &inline, &mut context)
  run Testing.expect(winner(&resolver, &catalog) == 1, "inline candidates use the same cascade")
  context.remainingSteps = 0
  let failed = run Effect.result(resolver.resolve(BufferView.of(&buffers), &tree, 0, &[], &mut context))
  run Testing.expect(match &failed {
    Result<(), ResolverError | CssError | OutOfMemoryError>.Failure { .. } => true
    _ => false
  }, "exhausted match budget fails")
  run Testing.expect(resolver.declarations().length == 0 && resolver.matches().length == 0 && resolver.stateDependencies() == 0, "failure exposes no stale or partial style")
  context = MatchContext.make(0, NO_ELEMENT)
  run resolver.resolve(BufferView.of(&buffers), &tree, 0, &[], &mut context)
  run Testing.expect(winner(&resolver, &catalog) == 0, "resolution retries after exhaustion")
}

test effect fn indexedResolutionTracksStateConditionsAndInlineCascade() -> ()
  ! AssertionError<'static> | ResolverError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run exercise() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn holds(rules: &[usize], rule: usize) -> bool {
  let mut i: usize = 0
  while i < rules.length {
    if rules[i] == rule { return true }
    i = i + 1
  }
  return false
}

effect fn pseudoElements() -> ()
  ! AssertionError<'static> | ResolverError | CssError | OutOfMemoryError ? &mut Allocator {
  let buffers = [
    run lexer.tokenize(b"*, ::before", &Limits.make()),
    run lexer.tokenize(b":hover::before", &Limits.make()),
    run lexer.tokenize(b"::placeholder", &Limits.make()),
    run lexer.tokenize(b"button, ::file-selector-button", &Limits.make()),
    run lexer.tokenize(b".hot::after", &Limits.make()),
    run lexer.tokenize(b"::backdrop", &Limits.make()),
    run lexer.tokenize(b"input, ::placeholder", &Limits.make()),
  ]
  let mut resolver = Resolver.make()
  let mut index = CandidateIndex.make()
  let mut i: usize = 0
  while i < buffers.length {
    run add(&mut resolver, &buffers[i], i, 0)
    let parsed = run selectors.parse(&buffers[i], buffers[i].all(), &[], &Limits.make())
    if let Option<SelectorList>.Some { value } = &parsed { run index.add(&value, &buffers[i]) }
    i = i + 1
  }
  run resolver.finish()
  run index.finish()
  let mut tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run index.collect(&tree, 0, &mut context)
  let own = index.candidates()
  run Testing.expect(holds(own, 0) && holds(own, 3), "universal and type subjects stay candidates of the element")
  run Testing.expect(!holds(own, 4) && holds(index.reachedPseudo(), 4), "a keyed pseudo-element arm is set aside, not offered to the element")
  run Testing.expect(!holds(own, 1) && !holds(own, 2) && !holds(own, 5) && !holds(own, 6), "unkeyed pseudo-element arms and unsupported pseudo-elements are not candidates of the element")
  run resolver.resolve(BufferView.of(&buffers), &tree, 0, &[], &mut context)
  run Testing.expect(resolver.matches().length == 2 && resolver.matches()[0].rule == 0 && resolver.matches()[1].rule == 3, "the element matches what it matched as a candidate of every rule")
  run Testing.expect(resolver.stateDependencies() == HOVER, "a state that only changes a pseudo-element stays a dependency of the element")
  context.pseudo = PseudoTarget.Before
  run index.collect(&tree, 0, &mut context)
  let before = index.candidates()
  run Testing.expect(holds(before, 0) && holds(before, 1) && holds(before, 2) && holds(before, 6) && !holds(before, 5), "a pseudo-element is a candidate of the unkeyed pseudo-element rules")
  run Testing.expect(!holds(before, 3) && !holds(before, 4), "element arms and other pseudo-elements' keyed arms are not candidates of ::before")
  tree.hovered = true
  run resolver.resolve(BufferView.of(&buffers), &tree, 0, &[], &mut context)
  run Testing.expect(resolver.matches().length == 2 && resolver.matches()[1].rule == 1, "::before matches through its own arms")
  context.pseudo = PseudoTarget.Placeholder
  run resolver.resolve(BufferView.of(&buffers), &tree, 0, &[], &mut context)
  run Testing.expect(resolver.matches().length == 2 && resolver.matches()[0].rule == 2 && resolver.matches()[1].rule == 6, "::placeholder matches in a list with a type arm that does not")
  context.pseudo = PseudoTarget.After
  run resolver.resolve(BufferView.of(&buffers), &tree, 0, &[], &mut context)
  run Testing.expect(resolver.matches().length == 1 && resolver.matches()[0].rule == 4, "a keyed pseudo-element arm matches through its key")
}

test effect fn pseudoElementRulesAreCandidatesOnlyOfPseudoElements() -> ()
  ! AssertionError<'static> | ResolverError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pseudoElements() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn digits(out: &mut List<u8>, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run digits(&mut out, value / 10) }
  run out.append(usize.toU8(value % 10) + 48)
}

effect fn manyKeys() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  // Enough keyed rules that lookups search runs of the sorted entries.
  let mut buffers = List<TokenBuffer>.make()
  let mut i: usize = 0
  while i < 300 {
    let mut text = List<u8>.make()
    run text.appendSlice(b".k")
    run digits(&mut text, i)
    run text.appendSlice(b", #i")
    run digits(&mut text, i)
    run buffers.append(run lexer.tokenize(text.asSlice(), &Limits.make()))
    i = i + 1
  }
  run buffers.append(run lexer.tokenize(b".hot", &Limits.make()))
  run buffers.append(run lexer.tokenize(b".a, button", &Limits.make()))
  let mut index = CandidateIndex.make()
  i = 0
  while i < buffers.length() {
    let parsed = run selectors.parse(&buffers.asSlice()[i], buffers.asSlice()[i].all(), &[], &Limits.make())
    if let Option<SelectorList>.Some { value } = &parsed { run index.add(&value, &buffers.asSlice()[i]) }
    i = i + 1
  }
  run index.finish()
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run index.collect(&tree, 0, &mut context)
  let own = index.candidates()
  run Testing.expect(own.length == 2 && holds(own, 300) && holds(own, 301), "a class and a type each find their rule among many keys")
  run index.collect(&tree, 1, &mut context)
  let child = index.candidates()
  run Testing.expect(child.length == 1 && holds(child, 301), "another class finds only its rule")
}

test effect fn lookupsFindTheirRulesAmongManyKeys() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run manyKeys() |> Effect.provideMut<Allocator>(&mut allocator)
}

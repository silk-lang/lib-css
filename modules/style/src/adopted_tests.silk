import adopted { StyleSheets, AdoptionError, Source }
import compile { Options, CompileError }
import compile
import sheet { Sheet, Declaration }
import sheet_binary { DecodeError }
import resolver { ResolverError }
import resolver_tests { Tree }
import cascade { Priority, Origin }
import element { MatchContext, NO_ELEMENT }
import media_features { Environment }
import tokens { Limits, CssError }
import css_properties.catalog { Property }
import css_properties.values { Value }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn compiled(source: &[u8]) -> Sheet
  ! CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let sheet = run compile.compile(source, &Options.make())
  let bytes = run sheet.encode()
  return run Sheet.decode(bytes.asSlice(), &Limits.make())
}

fn winner(sheets: &StyleSheets, property: Property) -> u32 {
  let mut result: u32 = 0
  let items = sheets.candidates()
  let mut i: usize = 0
  while i < items.length {
    match items[i].source {
      Source.Inline { .. } => { result = 999 }
      Source.Sheet { sheet, declaration } => {
        let target = match &sheets.sheets()[sheet].sheet.declarations.asSlice()[declaration] {
          Declaration.Typed { property: found, .. } => found
          Declaration.Pending { property: found, .. } => found
          Declaration.ColorExpression { property: found, .. } => found
          _ => Property.Color
        }
        if target == property { result = sheets.sheets()[sheet].id }
      }
    }
    i = i + 1
  }
  return result
}

fn winningNumber(sheets: &StyleSheets, property: Property) -> f32 {
  let mut result: f32 = 0.0
  let items = sheets.candidates()
  let mut i: usize = 0
  while i < items.length {
    if let Source.Sheet { sheet, declaration } = items[i].source {
      if let Declaration.Typed { property: found, value, .. } = &sheets.sheets()[sheet].sheet.declarations.asSlice()[declaration] {
        if found == property {
          if let Value.Unit { value: number, .. } = &value { result = number }
        }
      }
    }
    i = i + 1
  }
  return result
}

effect fn layersBody() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(10, run compiled(b"@layer base, utilities; @layer base {.button {width:1px!important;height:1px}} @layer utilities {.button{width:2px!important;height:2px}}"))
  run sheets.adopt(20, run compiled(b"@layer utilities {.button{width:3px!important;height:3px}} @layer base {.button{width:4px!important;height:4px}}"))
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Width) == 20 && winner(&sheets, Property.Height) == 20, "cross-sheet layers merge by name, with important layer order reversed")
  run Testing.expect(winningNumber(&sheets, Property.Width) == 4.0 && winningNumber(&sheets, Property.Height) == 3.0, "the same named layers share precedence even when declared in different orders")
  let last = sheets.candidates()[sheets.candidates().length - 1]
  run Testing.expect(last.priority.important && last.priority.layer == 0, "the first important layer wins despite the second sheet's different local order")
  run sheets.adopt(30, run compiled(b".button{width:5px!important;height:5px}"))
  let mut inline = Priority.make(Origin.Author, 0)
  inline.inline = true
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[inline], &mut context)
  run Testing.expect(winner(&sheets, Property.Width) == 20 && winner(&sheets, Property.Height) == 999, "important sheet values beat normal inline values; inline beats normal unlayered rules")
  inline.important = true
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[inline], &mut context)
  run Testing.expect(winner(&sheets, Property.Width) == 999, "important inline declarations beat important stylesheet declarations")
  run Testing.expect(sheets.matches().length == 5 && sheets.matches()[4].sheet == 30, "matched rules retain adoption ids for the inspector")
  drop run sheets.remove(30)
  drop run sheets.remove(10)
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winningNumber(&sheets, Property.Width) == 3.0 && winningNumber(&sheets, Property.Height) == 4.0, "removing the first layer declaration rebuilds order from the surviving sheets")
}

test effect fn adoptedSheetsShareLayerOrderAndDeclarationImportance() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run layersBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn replacementBody() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(10, run compiled(b".button{height:1px}"))
  run sheets.adopt(20, run compiled(b".button{height:2px}"))
  run sheets.replace(10, run compiled(b".button{height:3px}"))
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Height) == 20, "replacement retains adoption order")
  let duplicate = run compiled(b".button{height:4px}")
  let rejected = run Effect.result(sheets.adopt(20, move duplicate))
  run Testing.expect(match &rejected {
    Result<(), AdoptionError | OutOfMemoryError>.Failure { .. } => true
    _ => false
  }, "duplicate adoption is rejected")
  run Testing.expect(sheets.length() == 2 && winner(&sheets, Property.Height) == 20, "rejected adoption preserves the registry and previous result")
  let badOrder = run Effect.result(sheets.reorder(&[20, 20]))
  run Testing.expect(match &badOrder { Result<(), AdoptionError | OutOfMemoryError>.Failure { .. } => true _ => false }, "duplicate ordering is rejected before mutating the sheets")
  run Testing.expect(sheets.sheets()[0].id == 10 && sheets.sheets()[1].id == 20, "invalid ordering preserves adoption order")
  run sheets.reorder(&[20, 10])
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Height) == 10, "reordering changes equal-specificity source order without recompiling")
  run Testing.expect(run sheets.remove(20), "an adopted sheet is removed")
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Height) == 10, "the remaining sheet supplies the style")
  run Testing.expect(!(run sheets.remove(20)), "removing an absent id is harmless")
  context.remainingSteps = 0
  let failed = run Effect.result(sheets.resolve(&tree, 0, &[], &mut context))
  run Testing.expect(match &failed {
    Result<(), ResolverError | CssError | OutOfMemoryError>.Failure { .. } => true _ => false
  }, "match-budget exhaustion is reported")
  run Testing.expect(sheets.candidates().length == 0 && sheets.matches().length == 0, "failed matching exposes no stale result")
}

test effect fn adoptionReplacementRemovalAndFailureKeepStableState() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run replacementBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn conditionsBody() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b".button{height:1px}"))
  run sheets.adopt(2, run compiled(b"@media (width >= 600px) {.button:hover{height:2px}}"))
  let tree = Tree { hovered: true }
  drop run sheets.environment(&Environment.headless(400.0, 300.0), false, &Limits.make())
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Height) == 1, "false media conditions suppress candidates")
  run Testing.expect(run sheets.environment(&Environment.headless(800.0, 300.0), false, &Limits.make()), "crossing a condition requests invalidation")
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Height) == 2, "the enabled state selector participates")
  run Testing.expect(!(run sheets.environment(&Environment.headless(900.0, 300.0), false, &Limits.make())), "a resize that preserves condition results does not request invalidation")
}

test effect fn adoptedMediaConditionsInvalidateOnlyWhenResultsFlip() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run conditionsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

import variables { ScopeId, RegistrationError }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import tokens { equal }

effect fn pendingValue(sheets: &StyleSheets, scope: ScopeId, property: Property) -> Option<Bytes>
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let candidates = sheets.candidates()
  let mut i = candidates.length
  while i > 0 {
    i = i - 1
    if let Source.Sheet { sheet, declaration } = candidates[i].source {
      if let Declaration.Pending { property: found, .. } = &sheets.sheets()[sheet].sheet.declarations.asSlice()[declaration] {
        if found == property {
          return run sheets.variableInputs()[0].substitute(scope, sheet, declaration, &Limits.make())
        }
      }
    }
  }
  return Option<Bytes>.None
}

fn valueIs(value: &Option<Bytes>, expected: &[u8]) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: bytes } => equal(bytes.asSlice(), expected)
    _ => false
  }
}

effect fn variablesBody() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b"@layer base, utilities; @layer base {.button{--gap:8px!important}} @layer utilities {.button{--gap:4px!important}}"))
  run sheets.adopt(2, run compiled(b"@property --size {syntax:'<length>';inherits:false;initial-value:3px} .button{--size:9px} .a{width:var(--gap);height:var(--size);margin-left:var(--missing)}"))
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let parent = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let child = run sheets.variableScope(Option<ScopeId>.some(parent), &Limits.make())
  let sibling = run sheets.variableScope(Option<ScopeId>.some(parent), &Limits.make())
  run Testing.expect(child.index == sibling.index && child.index != parent.index, "repeated registration-default scopes share without inheriting isolated values")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Width)), b"8px"), "inherited custom properties use cross-sheet important layer order")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Height)), b"3px"), "registered non-inherited values use relocated initial tokens in another sheet")
  run Testing.expect((run pendingValue(&sheets, child, Property.MarginLeft)).isNone(), "unresolved variables are invalid at computed-value time")
  run sheets.adopt(3, run compiled(b"@property --size {syntax:'<length>';inherits:false;initial-value:5px} @media (width >= 600px) {@property --size {syntax:'<length>';inherits:false;initial-value:7px}}"))
  drop run sheets.environment(&Environment.headless(400.0, 300.0), false, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let narrow = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, narrow, Property.Height)), b"5px"), "the last enabled registration across adopted sheets wins")
  drop run sheets.environment(&Environment.headless(800.0, 300.0), false, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let wide = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, wide, Property.Height)), b"7px"), "a registration condition flip rebuilds the variable inputs")
  sheets.resetScopes()
  let reset = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, reset, Property.Height)), b"7px"), "full restyles reclaim scopes without dropping registration defaults")
}

test effect fn adoptedVariablesInheritAcrossSheetsAndRefreshRegistrations() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run variablesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

import adopted_variables { InlineCustom }
import lexer

effect fn inlineVariablesBody() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b".button{--gap:8px!important;--height:12px} .a{width:var(--gap);height:var(--height)}"))
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let gap = run lexer.tokenize(b"24px", &Limits.make())
  let height = run lexer.tokenize(b"32px", &Limits.make())
  let priority = Priority.make(Origin.Author, 0)
  let inline = [InlineCustom<'_, '_> { name: b"--gap", tokens: &gap, priority: priority }, InlineCustom<'_, '_> { name: b"--height", tokens: &height, priority: priority }]
  let parent = run sheets.variableScopeWith(Option<ScopeId>.None, &inline, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let child = run sheets.variableScope(Option<ScopeId>.some(parent), &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Width)), b"8px"), "important sheet custom declarations beat normal inline values")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Height)), b"32px"), "inline custom properties inherit into sheet declarations")
  let before = sheets.variableInputs()[0].buffers.length()
  sheets.resetScopes()
  run Testing.expect(sheets.variableInputs()[0].buffers.length() + 2 == before, "full restyles release copied inline tokens")
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let mut important = priority
  important.important = true
  let parent2 = run sheets.variableScopeWith(Option<ScopeId>.None, &[InlineCustom<'_, '_> { name: b"--gap", tokens: &gap, priority: important }], &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let child2 = run sheets.variableScope(Option<ScopeId>.some(parent2), &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child2, Property.Width)), b"24px"), "important inline custom properties win")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child2, Property.Height)), b"12px"), "removed inline custom properties do not leak into a new restyle")
}

test effect fn adoptedInlineCustomPropertiesShareTheCascadeAndReclaimStorage() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inlineVariablesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sharedScopesBody() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b"@property --size{syntax:'<length>';inherits:false;initial-value:3px}.button{--gap:8px;--size:9px}.a{--local:11px}.b{--local:22px}.a,.b{width:var(--gap);height:var(--size);margin-left:var(--local)}"))
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let parent = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let child = run sheets.variableScope(Option<ScopeId>.some(parent), &Limits.make())
  run Testing.expect(child.index != parent.index, "non-inherited registration values require an isolated child scope")
  run Testing.expect(sheets.canRetainScopes(), "all scope inputs are cached before a partial restyle")
  let mut i: usize = 0
  while i < 5000 {
    let sibling = run sheets.variableScope(Option<ScopeId>.some(parent), &Limits.make())
    run Testing.expect(sibling.index == child.index, "identical siblings share a scope even with non-inherited registrations and own custom values")
    i = i + 1
  }
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Width)), b"8px")
    && valueIs(&(run pendingValue(&sheets, child, Property.Height)), b"3px")
    && valueIs(&(run pendingValue(&sheets, child, Property.MarginLeft)), b"11px"), "sharing preserves inherited, registered and own custom values")
  let descendant = run sheets.variableScope(Option<ScopeId>.some(child), &Limits.make())
  run Testing.expect(descendant.index != child.index, "different parents do not alias cached scopes")
  let mut limits = Limits.make()
  limits.maxTokens = 0
  let restricted = run Effect.result(sheets.variableScope(Option<ScopeId>.some(parent), &limits))
  run Testing.expect(match move restricted { Result.Failure { .. } => true _ => false }, "cached scopes cannot bypass a stricter computation budget")
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 2, &[], &mut context)
  let other = run sheets.variableScope(Option<ScopeId>.some(parent), &Limits.make())
  run Testing.expect(other.index != child.index && valueIs(&(run pendingValue(&sheets, other, Property.MarginLeft)), b"22px"), "different custom declarations receive different scopes")
  let gap = run lexer.tokenize(b"24px", &Limits.make())
  let priority = Priority.make(Origin.Author, 0)
  let inline = [InlineCustom<'_, '_> { name: b"--gap", tokens: &gap, priority: priority }]
  let custom = run sheets.variableScopeWith(Option<ScopeId>.some(parent), &inline, &Limits.make())
  let again = run lexer.tokenize(b"24px", &Limits.make())
  let repeated = run sheets.variableScopeWith(Option<ScopeId>.some(parent), &[InlineCustom<'_, '_> { name: b"--gap", tokens: &again, priority: priority }], &Limits.make())
  let wider = run lexer.tokenize(b"25px", &Limits.make())
  let changed = run sheets.variableScopeWith(Option<ScopeId>.some(parent), &[InlineCustom<'_, '_> { name: b"--gap", tokens: &wider, priority: priority }], &Limits.make())
  let renamed = run sheets.variableScopeWith(Option<ScopeId>.some(parent), &[InlineCustom<'_, '_> { name: b"--gab", tokens: &again, priority: priority }], &Limits.make())
  run Testing.expect(sheets.canRetainScopes() && repeated.index == custom.index && changed.index != custom.index && renamed.index != custom.index
    && valueIs(&(run pendingValue(&sheets, changed, Property.Width)), b"25px"), "equal inline custom properties share one retained scope; another value or name builds its own")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, custom, Property.Width)), b"24px"), "inline custom values do not reuse a sheet-only scope")
  sheets.resetScopes()
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let replacementParent = run sheets.variableScopeWith(Option<ScopeId>.None, &inline, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let replacementChild = run sheets.variableScope(Option<ScopeId>.some(replacementParent), &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, replacementChild, Property.Width)), b"24px")
    && valueIs(&(run pendingValue(&sheets, replacementChild, Property.Height)), b"3px"), "reset clears cached scope identities while retaining registration defaults")
}

test effect fn adoptedVariableScopesShareRepeatedInputsWithoutLeakingState() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sharedScopesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

import scope_cache { SCOPE_LIMIT }

effect fn scopeRetentionPressure() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b"@property --size{syntax:'<length>';inherits:false;initial-value:3px} .a{height:var(--size)}"))
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let mut parent = Option<ScopeId>.None
  let mut i: usize = 0
  while i < SCOPE_LIMIT + 12 {
    let next = run sheets.variableScope(parent, &Limits.make())
    run Testing.expect(valueIs(&(run pendingValue(&sheets, next, Property.Height)), b"3px"), "cache pressure does not change registration defaults")
    parent = Option<ScopeId>.some(next)
    i = i + 1
  }
  run Testing.expect(!sheets.canRetainScopes(), "uncached scopes tell the host to reset before another style pass")
  sheets.resetScopes()
  drop run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  run Testing.expect(sheets.canRetainScopes(), "a full reset restores bounded scope retention")
}

test effect fn adoptedScopeRetentionReportsCachePressure() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run scopeRetentionPressure() |> Effect.provideMut<Allocator>(&mut allocator)
}


effect fn startingBody() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b".button{height:10px}@media(width>600px){@starting-style{.button{height:2px}}}"))
  let tree = Tree { hovered: false }
  drop run sheets.environment(&Environment.headless(800.0, 300.0), false, &Limits.make())
  run Testing.expect(sheets.hasStarting(), "eligible starting rules are available without changing normal eligibility")
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolveWith(&tree, 0, &[], &mut context, true)
  run Testing.expect(winningNumber(&sheets, Property.Height) == 2.0, "the starting cascade includes normal and starting rules")
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winningNumber(&sheets, Property.Height) == 10.0, "resolving a starting style does not change the next normal style")
  let mut inline = Priority.make(Origin.Author, 0)
  inline.inline = true
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolveWith(&tree, 0, &[inline], &mut context, true)
  run Testing.expect(winner(&sheets, Property.Height) == 999, "inline declarations retain their priority in the starting cascade")
  drop run sheets.environment(&Environment.headless(400.0, 300.0), false, &Limits.make())
  run Testing.expect(!sheets.hasStarting(), "starting rules respect their enclosing media condition")
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolveWith(&tree, 0, &[], &mut context, true)
  run Testing.expect(winningNumber(&sheets, Property.Height) == 10.0, "a false media condition suppresses the starting declaration")
}

test effect fn startingCascadeDoesNotChangeNormalEligibility() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run startingBody() |> Effect.provideMut<Allocator>(&mut allocator)
}


effect fn keyframeNames() -> ()
  ! AssertionError<'static> | AdoptionError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b"@layer base,utilities; @layer utilities{@keyframes fade{to{opacity:.2}}}"))
  run sheets.adopt(2, run compiled(b"@layer base{@keyframes fade{to{opacity:.3}}} @media(width>600px){@keyframes fade{to{opacity:.4}}}"))
  drop run sheets.environment(&Environment.headless(400.0, 300.0), false, &Limits.make())
  run Testing.expect(match sheets.keyframes(b"fade") { Option.Some { value } => value.sheet == 0 _ => false }, "named keyframes use cross-sheet layer order")
  drop run sheets.environment(&Environment.headless(800.0, 300.0), false, &Limits.make())
  run Testing.expect(match sheets.keyframes(b"fade") { Option.Some { value } => value.sheet == 1 && value.rule == 1 _ => false }, "eligible unlayered definitions win")
  run sheets.adopt(3, run compiled(b"@keyframes fade{}"))
  run Testing.expect(match sheets.keyframes(b"fade") { Option.Some { value } => value.sheet == 2 _ => false }, "a later empty definition still replaces earlier definitions")
  run sheets.reorder(&[3,2,1])
  run Testing.expect(match sheets.keyframes(b"fade") { Option.Some { value } => value.sheet == 1 _ => false }, "adoption order breaks equal-layer ties")
  run Testing.expect(sheets.keyframes(b"Fade").isNone(), "keyframe names are case sensitive")
}

test effect fn namedKeyframesFollowLayersConditionsAndAdoptionOrder() -> ()
  ! AssertionError<'static> | AdoptionError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run keyframeNames() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn faceNames() ! AssertionError<'static> | AdoptionError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b"@layer low,high;@layer high{@font-face{font-family:Brand;src:url(high.ttf);font-weight:700}}"))
  run sheets.adopt(2, run compiled(b"@layer low{@font-face{font-family:Brand;src:url(low.ttf);font-weight:400}}@media(width>600px){@font-face{font-family:Brand;src:url(wide.ttf)}}"))
  drop run sheets.environment(&Environment.headless(400.0,300.0),false,&Limits.make())
  let small = run sheets.fontFaces()
  run Testing.expect(small.length() == 2 && small.get(0).sheet == 1 && small.get(1).sheet == 0, "all eligible font descriptors participate, ordered by cross-sheet layer priority")
  drop run sheets.environment(&Environment.headless(800.0,300.0),false,&Limits.make())
  let large = run sheets.fontFaces()
  run Testing.expect(large.length() == 3 && large.get(2).sheet == 1 && large.get(2).rule == 1, "unlayered faces follow layered faces when media matches")
  run sheets.adopt(3,run compiled(b"@font-face{font-family:Brand;src:url(last.ttf)}"))
  let adopted = run sheets.fontFaces()
  run Testing.expect(adopted.length() == 4 && adopted.get(3).sheet == 2, "later adoption breaks equal-layer ties")
  run sheets.reorder(&[3,2,1])
  let reordered = run sheets.fontFaces()
  run Testing.expect(reordered.length() == 4 && reordered.get(3).sheet == 1, "reordering changes face precedence without dropping descriptor variants")
}

test effect fn namedFontFacesFollowLayersConditionsAndAdoptionOrder() ! AssertionError<'static> | AdoptionError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run faceNames() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn ifBody() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b".button{--mode:dark} .a{width:if(style(--mode: dark): 10px; else: 20px);height:if(style(--mode: light): 1px; else: 2px);margin-left:if(media(width >= 600px): 5px; else: 6px);margin-top:if(supports(display: grid) and style(--mode): 7px; else: 8px);padding-left:if(not style(--mode): 1px; style((--mode: x) or (--mode: dark)): 3px);margin-right:if(else: var(--gap,4px));padding-top:if(style(--missing): 1px)}"))
  drop run sheets.environment(&Environment.headless(400.0, 300.0), false, &Limits.make())
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let parent = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let child = run sheets.variableScope(Option<ScopeId>.some(parent), &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Width)), b"10px"), "style() matches an inherited custom property")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Height)), b"2px"), "else is taken when no condition holds")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.MarginLeft)), b"6px"), "media() reads the environment")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.MarginTop)), b"7px"), "supports() and and")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.PaddingLeft)), b"3px"), "not, and or inside style()")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.MarginRight)), b"4px"), "var() in a branch")
  run Testing.expect(!valueIs(&(run pendingValue(&sheets, child, Property.PaddingTop)), b"1px"), "no branch: no value")
  let changed = run sheets.environment(&Environment.headless(800.0, 300.0), false, &Limits.make())
  run Testing.expect(changed, "a new environment restyles a sheet that tests media()")
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let parent2 = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let child2 = run sheets.variableScope(Option<ScopeId>.some(parent2), &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child2, Property.MarginLeft)), b"5px"), "media() follows the environment")
}

test effect fn adoptedIfPicksTheFirstBranchThatHolds() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run ifBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

import element { ElementTree, StateBits, AttributeText, PseudoTarget }

/// The fixture tree, with node 0 as the style container of node 1.
struct Styled { tree: Tree, scope: Option<ScopeId> }
impl ElementTree for Styled {
  fn state(self: &Self, node: usize) -> StateBits { return self.tree.state(node) }
  fn parent(self: &Self, node: usize) -> usize { return self.tree.parent(node) }
  fn containingHost(self: &Self, node: usize) -> usize { return self.tree.containingHost(node) }
  fn firstChild(self: &Self, node: usize) -> usize { return self.tree.firstChild(node) }
  fn nextSibling(self: &Self, node: usize) -> usize { return self.tree.nextSibling(node) }
  fn previousSibling(self: &Self, node: usize) -> usize { return self.tree.previousSibling(node) }
  fn localName(self: &Self, node: usize) -> &[u8] { return self.tree.localName(node) }
  fn namespaceUri(self: &Self, node: usize) -> &[u8] { return self.tree.namespaceUri(node) }
  fn attributeCount(self: &Self, node: usize) -> usize { return self.tree.attributeCount(node) }
  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] { return self.tree.attributeName(node, attribute) }
  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] { return self.tree.attributeNamespace(node, attribute) }
  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] { return self.tree.attributeValue(node, attribute) }
  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool { return self.tree.attributeIsId(node, attribute) }
  fn attribute<'a>(self: &'a Self, node: usize, attribute: usize) -> AttributeText<'a> { return self.tree.attribute(node, attribute) }
  fn language(self: &Self, node: usize) -> &[u8] { return self.tree.language(node) }
  fn isRoot(self: &Self, node: usize) -> bool { return self.tree.isRoot(node) }
  fn isEmpty(self: &Self, node: usize) -> bool { return self.tree.isEmpty(node) }
  fn isLink(self: &Self, node: usize) -> bool { return self.tree.isLink(node) }
  fn styleContainer(self: &Self, node: usize, name: &[u8], pseudo: PseudoTarget) -> Option<ScopeId> {
    return if node == 1 { self.scope } else { Option<ScopeId>.None }
  }
}

effect fn styleQueryBody() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b".button{--mode:dark;--n: 1} @container style(--mode: dark){.a{width:1px}} @container style(--mode: light){.a{height:1px}} @container style(--n: 1) and (not style(--other)){.a{margin-left:1px}} @container style(--mode){.a{margin-top:1px}}"))
  drop run sheets.environment(&Environment.headless(400.0, 300.0), false, &Limits.make())
  let mut tree = Styled { tree: Tree { hovered: false }, scope: Option<ScopeId>.None }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let parent = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  tree.scope = Option<ScopeId>.some(parent)
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  run Testing.expect(winningNumber(&sheets, Property.Width) == 1.0, "style(--mode: dark) matches the container's value")
  run Testing.expect(winner(&sheets, Property.Height) == 0, "style(--mode: light) does not")
  run Testing.expect(winningNumber(&sheets, Property.MarginLeft) == 1.0, "and, not, and spaces around a value")
  run Testing.expect(winningNumber(&sheets, Property.MarginTop) == 1.0, "a bare name matches a set property")
  tree.scope = Option<ScopeId>.None
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Width) == 0, "no container: no match")
}

test effect fn adoptedContainerStyleQueriesReadTheContainer() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run styleQueryBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

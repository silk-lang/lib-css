import adopted { StyleSheets, AdoptionError, Source }
import compile { Options, CompileError }
import compile
import sheet { Sheet, Declaration }
import sheet_binary { DecodeError }
import resolver { ResolverError }
import resolver_tests { Tree }
import cascade { Priority, Origin }
import element { MatchContext, NO_ELEMENT }
import media_features { Environment }
import tokens { Limits, CssError }
import css_properties.catalog { Property }
import css_properties.values { Value }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn compiled(source: &[u8]) -> Sheet
  ! CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let sheet = run compile.compile(source, &Options.make())
  let bytes = run sheet.encode()
  return run Sheet.decode(bytes.asSlice(), &Limits.make())
}

fn winner(sheets: &StyleSheets, property: Property) -> u32 {
  let mut result: u32 = 0
  let items = sheets.candidates()
  let mut i: usize = 0
  while i < items.length {
    match items[i].source {
      Source.Inline { .. } => { result = 999 }
      Source.Sheet { sheet, declaration } => {
        let target = match &sheets.sheets()[sheet].sheet.declarations.asSlice()[declaration] {
          Declaration.Typed { property: found, .. } => found
          Declaration.Pending { property: found, .. } => found
          Declaration.ColorExpression { property: found, .. } => found
          _ => Property.Color
        }
        if target == property { result = sheets.sheets()[sheet].id }
      }
    }
    i = i + 1
  }
  return result
}

fn winningNumber(sheets: &StyleSheets, property: Property) -> f32 {
  let mut result: f32 = 0.0
  let items = sheets.candidates()
  let mut i: usize = 0
  while i < items.length {
    if let Source.Sheet { sheet, declaration } = items[i].source {
      if let Declaration.Typed { property: found, value, .. } = &sheets.sheets()[sheet].sheet.declarations.asSlice()[declaration] {
        if found == property {
          if let Value.Unit { value: number, .. } = &value { result = number }
        }
      }
    }
    i = i + 1
  }
  return result
}

effect fn layersBody() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(10, run compiled(b"@layer base, utilities; @layer base {.button {width:1px!important;height:1px}} @layer utilities {.button{width:2px!important;height:2px}}"))
  run sheets.adopt(20, run compiled(b"@layer utilities {.button{width:3px!important;height:3px}} @layer base {.button{width:4px!important;height:4px}}"))
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Width) == 20 && winner(&sheets, Property.Height) == 20, "cross-sheet layers merge by name, with important layer order reversed")
  run Testing.expect(winningNumber(&sheets, Property.Width) == 4.0 && winningNumber(&sheets, Property.Height) == 3.0, "the same named layers share precedence even when declared in different orders")
  let last = sheets.candidates()[sheets.candidates().length - 1]
  run Testing.expect(last.priority.important && last.priority.layer == 0, "the first important layer wins despite the second sheet's different local order")
  run sheets.adopt(30, run compiled(b".button{width:5px!important;height:5px}"))
  let mut inline = Priority.make(Origin.Author, 0)
  inline.inline = true
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[inline], &mut context)
  run Testing.expect(winner(&sheets, Property.Width) == 20 && winner(&sheets, Property.Height) == 999, "important sheet values beat normal inline values; inline beats normal unlayered rules")
  inline.important = true
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[inline], &mut context)
  run Testing.expect(winner(&sheets, Property.Width) == 999, "important inline declarations beat important stylesheet declarations")
  run Testing.expect(sheets.matches().length == 5 && sheets.matches()[4].sheet == 30, "matched rules retain adoption ids for the inspector")
  drop run sheets.remove(30)
  drop run sheets.remove(10)
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winningNumber(&sheets, Property.Width) == 3.0 && winningNumber(&sheets, Property.Height) == 4.0, "removing the first layer declaration rebuilds order from the surviving sheets")
}

test effect fn adoptedSheetsShareLayerOrderAndDeclarationImportance() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run layersBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn replacementBody() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(10, run compiled(b".button{height:1px}"))
  run sheets.adopt(20, run compiled(b".button{height:2px}"))
  run sheets.replace(10, run compiled(b".button{height:3px}"))
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Height) == 20, "replacement retains adoption order")
  let duplicate = run compiled(b".button{height:4px}")
  let rejected = run Effect.result(sheets.adopt(20, move duplicate))
  run Testing.expect(match &rejected {
    Result<(), AdoptionError | OutOfMemoryError>.Failure { .. } => true
    _ => false
  }, "duplicate adoption is rejected")
  run Testing.expect(sheets.length() == 2 && winner(&sheets, Property.Height) == 20, "rejected adoption preserves the registry and previous result")
  let badOrder = run Effect.result(sheets.reorder(&[20, 20]))
  run Testing.expect(match &badOrder { Result<(), AdoptionError | OutOfMemoryError>.Failure { .. } => true _ => false }, "duplicate ordering is rejected before mutating the sheets")
  run Testing.expect(sheets.sheets()[0].id == 10 && sheets.sheets()[1].id == 20, "invalid ordering preserves adoption order")
  run sheets.reorder(&[20, 10])
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Height) == 10, "reordering changes equal-specificity source order without recompiling")
  run Testing.expect(run sheets.remove(20), "an adopted sheet is removed")
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Height) == 10, "the remaining sheet supplies the style")
  run Testing.expect(!(run sheets.remove(20)), "removing an absent id is harmless")
  context.remainingSteps = 0
  let failed = run Effect.result(sheets.resolve(&tree, 0, &[], &mut context))
  run Testing.expect(match &failed {
    Result<(), ResolverError | CssError | OutOfMemoryError>.Failure { .. } => true _ => false
  }, "match-budget exhaustion is reported")
  run Testing.expect(sheets.candidates().length == 0 && sheets.matches().length == 0, "failed matching exposes no stale result")
}

test effect fn adoptionReplacementRemovalAndFailureKeepStableState() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run replacementBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn conditionsBody() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b".button{height:1px}"))
  run sheets.adopt(2, run compiled(b"@media (width >= 600px) {.button:hover{height:2px}}"))
  let tree = Tree { hovered: true }
  drop run sheets.environment(&Environment.headless(400.0, 300.0), false, &Limits.make())
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Height) == 1, "false media conditions suppress candidates")
  run Testing.expect(run sheets.environment(&Environment.headless(800.0, 300.0), false, &Limits.make()), "crossing a condition requests invalidation")
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  run Testing.expect(winner(&sheets, Property.Height) == 2, "the enabled state selector participates")
  run Testing.expect(!(run sheets.environment(&Environment.headless(900.0, 300.0), false, &Limits.make())), "a resize that preserves condition results does not request invalidation")
}

test effect fn adoptedMediaConditionsInvalidateOnlyWhenResultsFlip() -> ()
  ! AssertionError<'static> | AdoptionError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run conditionsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

import variables { ScopeId, RegistrationError }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import tokens { equal }

effect fn pendingValue(sheets: &StyleSheets, scope: ScopeId, property: Property) -> Option<Bytes>
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let candidates = sheets.candidates()
  let mut i = candidates.length
  while i > 0 {
    i = i - 1
    if let Source.Sheet { sheet, declaration } = candidates[i].source {
      if let Declaration.Pending { property: found, .. } = &sheets.sheets()[sheet].sheet.declarations.asSlice()[declaration] {
        if found == property {
          return run sheets.variableInputs()[0].substitute(scope, sheet, declaration, &Limits.make())
        }
      }
    }
  }
  return Option<Bytes>.None
}

fn valueIs(value: &Option<Bytes>, expected: &[u8]) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: bytes } => equal(bytes.asSlice(), expected)
    _ => false
  }
}

effect fn variablesBody() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b"@layer base, utilities; @layer base {.button{--gap:8px!important}} @layer utilities {.button{--gap:4px!important}}"))
  run sheets.adopt(2, run compiled(b"@property --size {syntax:'<length>';inherits:false;initial-value:3px} .button{--size:9px} .a{width:var(--gap);height:var(--size);margin-left:var(--missing)}"))
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let parent = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let child = run sheets.variableScope(Option<ScopeId>.some(parent), &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Width)), b"8px"), "inherited custom properties use cross-sheet important layer order")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Height)), b"3px"), "registered non-inherited values use relocated initial tokens in another sheet")
  run Testing.expect((run pendingValue(&sheets, child, Property.MarginLeft)).isNone(), "unresolved variables are invalid at computed-value time")
  run sheets.adopt(3, run compiled(b"@property --size {syntax:'<length>';inherits:false;initial-value:5px} @media (width >= 600px) {@property --size {syntax:'<length>';inherits:false;initial-value:7px}}"))
  drop run sheets.environment(&Environment.headless(400.0, 300.0), false, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let narrow = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, narrow, Property.Height)), b"5px"), "the last enabled registration across adopted sheets wins")
  drop run sheets.environment(&Environment.headless(800.0, 300.0), false, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let wide = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, wide, Property.Height)), b"7px"), "a registration condition flip rebuilds the variable inputs")
  sheets.resetScopes()
  let reset = run sheets.variableScope(Option<ScopeId>.None, &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, reset, Property.Height)), b"7px"), "full restyles reclaim scopes without dropping registration defaults")
}

test effect fn adoptedVariablesInheritAcrossSheetsAndRefreshRegistrations() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run variablesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

import adopted_variables { InlineCustom }
import lexer

effect fn inlineVariablesBody() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheets = StyleSheets.make()
  run sheets.adopt(1, run compiled(b".button{--gap:8px!important;--height:12px} .a{width:var(--gap);height:var(--height)}"))
  let tree = Tree { hovered: false }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let gap = run lexer.tokenize(b"24px", &Limits.make())
  let height = run lexer.tokenize(b"32px", &Limits.make())
  let priority = Priority.make(Origin.Author, 0)
  let inline = [InlineCustom<'_, '_> { name: b"--gap", tokens: &gap, priority: priority }, InlineCustom<'_, '_> { name: b"--height", tokens: &height, priority: priority }]
  let parent = run sheets.variableScopeWith(Option<ScopeId>.None, &inline, &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let child = run sheets.variableScope(Option<ScopeId>.some(parent), &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Width)), b"8px"), "important sheet custom declarations beat normal inline values")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child, Property.Height)), b"32px"), "inline custom properties inherit into sheet declarations")
  let before = sheets.variableInputs()[0].buffers.length()
  sheets.resetScopes()
  run Testing.expect(sheets.variableInputs()[0].buffers.length() + 2 == before, "full restyles release copied inline tokens")
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 0, &[], &mut context)
  let mut important = priority
  important.important = true
  let parent2 = run sheets.variableScopeWith(Option<ScopeId>.None, &[InlineCustom<'_, '_> { name: b"--gap", tokens: &gap, priority: important }], &Limits.make())
  context = MatchContext.make(0, NO_ELEMENT)
  run sheets.resolve(&tree, 1, &[], &mut context)
  let child2 = run sheets.variableScope(Option<ScopeId>.some(parent2), &Limits.make())
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child2, Property.Width)), b"24px"), "important inline custom properties win")
  run Testing.expect(valueIs(&(run pendingValue(&sheets, child2, Property.Height)), b"12px"), "removed inline custom properties do not leak into a new restyle")
}

test effect fn adoptedInlineCustomPropertiesShareTheCascadeAndReclaimStorage() -> ()
  ! AssertionError<'static> | AdoptionError | RegistrationError | ResolverError | CompileError | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inlineVariablesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

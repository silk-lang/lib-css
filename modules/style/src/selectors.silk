//! Shared Selectors 4 grammar for host-tree matching and CSSOM validation.
//! Generated pseudo-elements match a separate host-supplied target. Nesting 1 is
//! validation-only: resolving & requires a parent selector and its specificity.
//! Pseudo suffix/argument grammar: https://drafts.csswg.org/selectors-4/#pseudo-elements
//! https://drafts.csswg.org/css-pseudo-4/ and https://drafts.csswg.org/css-shadow-1/
import sheet_binary { Writer as BinaryWriter, Reader as BinaryReader, DecodeError, DecodeReason }
import sheet_tokens
import silk.simd.u8x16
import silk.simd.mask16
import tokens { Span, TokenRange, TokenBuffer, Kind, Limits, CssError, CssErrorKind }
import tokens
import element
import element { ElementTree, MatchContext, PseudoTarget, NO_ELEMENT }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.num.usize
import silk.num.u8
import silk.num.u32
import silk.num.f64
import silk.num.i64

const NONE: usize = usize.MAX

pub struct NamespaceBinding {
  pub prefix: Span,
  pub uri: Span
}

impl Copy for NamespaceBinding {}

pub struct Specificity {
  pub ids: usize,
  pub classes: usize,
  pub types: usize
}

impl Copy for Specificity {}

pub fn compare(a: Specificity, b: Specificity) -> i32 {
  if a.ids != b.ids {
    return if a.ids > b.ids {
      1
    } else {
      -1
    }
  }
  if a.classes != b.classes {
    return if a.classes > b.classes {
      1
    } else {
      -1
    }
  }
  return if a.types == b.types {
    0
  } else if a.types > b.types {
    1
  } else {
    -1
  }
}

fn zero() -> Specificity {
  return Specificity { ids: 0, classes: 0, types: 0 }
}

fn add(a: Specificity, b: Specificity) -> Specificity {
  return Specificity {
    ids: a.ids + b.ids,
    classes: a.classes + b.classes,
    types: a.types + b.types,
  }
}

fn maximum(a: Specificity, b: Specificity) -> Specificity {
  return if compare(a, b) > 0 {
    a
  } else {
    b
  }
}

fn emptySpan() -> Span {
  return Span { start: 0, end: 0 }
}

// Namespace mode: Any does not impose a namespace, Exact includes the empty URI.
enum NamespaceMode {
  Any,
  Exact
}

struct Namespace {
  mode: NamespaceMode,
  uri: Span
}

impl Copy for Namespace {}

fn anyNamespace() -> Namespace {
  return Namespace { mode: NamespaceMode.Any, uri: emptySpan() }
}

fn noNamespace() -> Namespace {
  return Namespace { mode: NamespaceMode.Exact, uri: emptySpan() }
}

enum Combinator {
  None,
  Descendant,
  Child,
  Adjacent,
  Sibling
}

enum AttributeOp {
  Present,
  Equal,
  Word,
  Hyphen,
  Prefix,
  Suffix,
  Contains
}

enum Pseudo {
  Host,
  Root,
  Empty,
  Scope,
  Target,
  Link,
  Never,
  Hover,
  Active,
  Focus,
  FocusVisible,
  FocusWithin,
  Disabled,
  Enabled,
  Checked,
  Indeterminate,
  PlaceholderShown,
  ReadOnly,
  ReadWrite,
  Required,
  Optional,
  Open,
  PopoverOpen,
  FirstChild,
  LastChild,
  OnlyChild,
  FirstType,
  LastType,
  OnlyType,
  DirLtr,
  DirRtl,
  Default,
  InRange,
  OutOfRange
}

enum FunctionKind {
  Is,
  Not,
  Has,
  Host,
  HostContext
}

union Test {
  Id { text: Span },
  Class { text: Span },
  Attribute { namespace: Namespace, name: Span, value: Span, op: AttributeOp, insensitive: bool },
  State { pseudo: Pseudo },
  Element { target: PseudoTarget },
  ElementState { pseudo: Pseudo },
  Function { kind: FunctionKind, list: usize },
  Nth { a: f64, b: f64, reverse: bool, ofType: bool, list: usize },
  Language { range: TokenRange },
}

impl Copy for Test {}

struct Simple {
  test: Test,
  next: usize
}

impl Copy for Simple {}

struct Compound {
  target: PseudoTarget,
  namespace: Namespace,
  name: Span,
  named: bool,
  explicitType: bool,
  hostEligible: bool,
  first: usize,
  previous: usize,
  relation: Combinator,
}

impl Copy for Compound {}

struct Arm {
  tail: usize,
  next: usize,
  specificity: Specificity
}

impl Copy for Arm {}

pub struct SelectorList {
  simples: List<Simple>,
  compounds: List<Compound>,
  arms: List<Arm>,
  head: usize,
  maxDepth: usize,
  validationOnly: bool,
}

// Parsing context only. CSSOM validation must not expose a matching AST or pretend
// that an unresolved nesting selector has a context-independent specificity.
enum PseudoElement {
  None,
  Other,
  Generated,
  FirstLetter,
  TreeAbiding,
  ElementBacked,
  Slotted,
  SearchText,
}

/// A necessary subject condition, not a substitute for matching the complete selector.
pub enum SubjectKind {
  Any,
  Id,
  Class,
  LocalName,
  /// The arm names a pseudo-element no host has, so it matches nothing.
  Never
}

pub struct SubjectKey {
  pub kind: SubjectKind,
  pub text: Span,
  /// The pseudo-element the arm styles; the arm matches only when the context asks for it.
  pub target: PseudoTarget,
}

impl Copy for SubjectKey {}

pub struct SubjectKeys<'a> {
  selectors: &'a SelectorList,
  nextArm: usize,
}

pub enum DependencyKind { Class, Id, Attribute, State, Structure, Host }

/// A conservative invalidation key in a selector program. Names address its token buffer.
/// Sibling invalidation is bidirectional so :has(+ ...) also reaches the earlier subject.
/// When ancestors and descendants are both set, restyle subtrees of affected ancestors.
pub struct Dependency {
  pub kind: DependencyKind,
  pub name: Span,
  pub states: u32,
  pub descendants: bool,
  pub siblings: bool,
  pub ancestors: bool,
}
impl Copy for Dependency {}

/// `SelectorList.reads` bits: what a match can depend on besides the element's own name,
/// attributes and state and those of its ancestors.
/// `:first-child`, `:last-child` and `:only-child`.
pub const READS_EDGE: u32 = 1
/// `:empty`.
pub const READS_EMPTY: u32 = 2
/// `:nth-*()` and the `*-of-type` pseudo-classes: the element's index among its siblings.
pub const READS_INDEX: u32 = 4
/// `+` and `~`: which elements precede it.
pub const READS_SIBLINGS: u32 = 8
/// `:has()`.
pub const READS_DESCENDANTS: u32 = 16
/// How far `MatchContext.reads` shifts the bits of a test made on an ancestor.
pub const READS_ABOVE: u32 = 8

const PERIOD_LIMIT: usize = 64

/// What elements have to agree on, in numbers, before one's match holds for another whose
/// own name, attributes and state are the same. Every figure is an upper bound.
pub struct Sharing {
  /// How many elements before it the `+` and `~` steps of one selector can test.
  pub siblings: usize,
  /// Indexes this far apart pass the same `:nth-*()` tests once past `lead` and `tail`.
  /// Zero when there is no such distance: an `of` list, or a period over 64.
  pub period: usize,
  /// The highest index from the start that an index test tells from the ones after it.
  pub lead: usize,
  /// The same, counted from the end.
  pub tail: usize,
  /// Whether a test with a period counts from the end, so that the number of siblings matters.
  pub fromEnd: bool,
}

impl Copy for Sharing {}

fn gcd(a: usize, b: usize) -> usize {
  let mut x = a
  let mut y = b
  while y != 0 {
    let rest = x % y
    x = y
    y = rest
  }
  return x
}

impl Sharing {
  pub fn none() -> Sharing { return Sharing { siblings: 0, period: 1, lead: 0, tail: 0, fromEnd: false } }

  /// The bounds that hold for the selectors of both.
  pub fn with(self: Self, other: Sharing) -> Sharing {
    let mut period: usize = 0
    if self.period != 0 && other.period != 0 {
      period = self.period / gcd(self.period, other.period) * other.period
      if period > PERIOD_LIMIT { period = 0 }
    }
    return Sharing {
      siblings: if self.siblings > other.siblings { self.siblings } else { other.siblings },
      period: period,
      lead: if self.lead > other.lead { self.lead } else { other.lead },
      tail: if self.tail > other.tail { self.tail } else { other.tail },
      fromEnd: self.fromEnd || other.fromEnd,
    }
  }
}

fn magnitude(value: f64) -> usize {
  let positive = if value < 0.0 { 0.0 - value } else { value }
  // A step or offset this large is one no period or run of siblings reaches.
  return if positive > 1000000.0 { 1000000 } else { i64.toUsize(f64.toI64(positive)) }
}

impl SelectorList {
  /// The `READS_*` bits of every compound and nested selector, including failed logical arms.
  pub fn reads(self: &Self) -> u32 {
    let mut result: u32 = 0
    let mut i: usize = 0
    while i < self.compounds.length() {
      let relation = self.compounds.asSlice()[i].relation
      if relation == Combinator.Adjacent || relation == Combinator.Sibling { result = result | READS_SIBLINGS }
      i = i + 1
    }
    i = 0
    while i < self.simples.length() {
      match &self.simples.asSlice()[i].test {
        Test.Function { kind, .. } => { if kind == FunctionKind.Has { result = result | READS_DESCENDANTS } }
        Test.Nth { .. } => { result = result | READS_INDEX }
        Test.State { pseudo } => {
          if pseudo == Pseudo.Empty { result = result | READS_EMPTY }
          else if pseudo == Pseudo.FirstChild || pseudo == Pseudo.LastChild || pseudo == Pseudo.OnlyChild { result = result | READS_EDGE }
          else if pseudo == Pseudo.FirstType || pseudo == Pseudo.LastType || pseudo == Pseudo.OnlyType { result = result | READS_INDEX }
        }
        _ => {}
      }
      i = i + 1
    }
    return result
  }

  /// The `Sharing` bounds of every compound and nested selector of the list.
  pub fn sharing(self: &Self) -> Sharing {
    let mut result = Sharing.none()
    let mut i: usize = 0
    while i < self.compounds.length() {
      let relation = self.compounds.asSlice()[i].relation
      if relation == Combinator.Adjacent || relation == Combinator.Sibling { result.siblings = result.siblings + 1 }
      i = i + 1
    }
    i = 0
    while i < self.simples.length() {
      match &self.simples.asSlice()[i].test {
        Test.Nth { a, b, reverse, list, .. } => {
          let step = magnitude(a)
          let mut one = Sharing.none()
          if list != NONE || step > PERIOD_LIMIT { one.period = 0 }
          else if step != 0 {
            one.period = step
            one.fromEnd = reverse && step > 1
          }
          if reverse { one.tail = magnitude(b) } else { one.lead = magnitude(b) }
          result = result.with(one)
        }
        Test.State { pseudo } => {
          if pseudo == Pseudo.FirstType || pseudo == Pseudo.OnlyType { if result.lead == 0 { result.lead = 1 } }
          if pseudo == Pseudo.LastType || pseudo == Pseudo.OnlyType { if result.tail == 0 { result.tail = 1 } }
        }
        _ => {}
      }
      i = i + 1
    }
    return result
  }

  /// Builds invalidation keys once for this program, including failed logical arms.
  /// Relational rules deliberately use coarse reach; simple class rules stay local.
  pub effect fn dependencies(self: &Self) -> List<Dependency>
    ! OutOfMemoryError ? &mut Allocator {
    let mut descendants = false
    let mut siblings = false
    let mut ancestors = false
    let mut structural = false
    let mut i: usize = 0
    while i < self.compounds.length() {
      let relation = self.compounds.asSlice()[i].relation
      if relation == Combinator.Descendant || relation == Combinator.Child { descendants = true }
      if relation == Combinator.Adjacent || relation == Combinator.Sibling { siblings = true }
      if relation != Combinator.None { structural = true }
      i = i + 1
    }
    i = 0
    while i < self.simples.length() {
      if let Test.Function { kind, .. } = self.simples.asSlice()[i].test {
        if kind == FunctionKind.Has { ancestors = true
          structural = true }
      }
      if let Test.Nth { list, .. } = self.simples.asSlice()[i].test {
        if list != NONE { siblings = true }
      }
      i = i + 1
    }
    let mut out = List<Dependency>.make()
    i = 0
    while i < self.simples.length() {
      let mut name = emptySpan()
      let mut states: u32 = 0
      let mut keep = true
      let kind = match &self.simples.asSlice()[i].test {
        Test.Class { text } => { name = text
          DependencyKind.Class }
        Test.Id { text } => { name = text
          DependencyKind.Id }
        Test.Attribute { name: text, .. } => { name = text
          DependencyKind.Attribute }
        Test.State { pseudo } => {
          states = stateMask(pseudo)
          if states != 0 { DependencyKind.State }
          else if pseudo == Pseudo.Empty || pseudo == Pseudo.FirstChild || pseudo == Pseudo.LastChild
            || pseudo == Pseudo.OnlyChild || pseudo == Pseudo.FirstType || pseudo == Pseudo.LastType || pseudo == Pseudo.OnlyType {
            structural = true
            DependencyKind.Structure
          } else { keep = pseudo != Pseudo.Never
          DependencyKind.Host }
        }
        Test.ElementState { pseudo } => { states = stateMask(pseudo)
          DependencyKind.State }
        Test.Nth { .. } => { structural = true
          DependencyKind.Structure }
        Test.Language { .. } => { descendants = true
          DependencyKind.Host }
        _ => { keep = false
          DependencyKind.Host }
      }
      if keep {
        run out.append(Dependency { kind: kind, name: name, states: states,
          descendants: descendants, siblings: siblings, ancestors: ancestors })
      }
      i = i + 1
    }
    if structural {
      run out.append(Dependency { kind: DependencyKind.Structure, name: emptySpan(), states: 0,
        descendants: descendants, siblings: siblings, ancestors: ancestors })
    }
    return move out
  }

  pub effect fn copy(self: &Self) -> SelectorList
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut simples = run List<Simple>.makeWithCapacity(self.simples.length())
    run simples.appendSlice(self.simples.asSlice())
    let mut compounds = run List<Compound>.makeWithCapacity(self.compounds.length())
    run compounds.appendSlice(self.compounds.asSlice())
    let mut arms = run List<Arm>.makeWithCapacity(self.arms.length())
    run arms.appendSlice(self.arms.asSlice())
    return SelectorList {
      simples: move simples,
      compounds: move compounds,
      arms: move arms,
      head: self.head,
      maxDepth: self.maxDepth,
      validationOnly: self.validationOnly,
    }
  }

  /// One conservative key per top-level arm. Functional-only subjects remain unkeyed.
  pub fn subjectKeys<'a>(self: &'a Self) -> SubjectKeys<'a> {
    return SubjectKeys<'a> { selectors: self, nextArm: self.head }
  }

  pub fn hasPseudoElements(self: &Self) -> bool {
    let mut i: usize = 0
    while i < self.simples.length() {
      if let Test.Element { .. } = self.simples.asSlice()[i].test { return true }
      i = i + 1
    }
    return false
  }

  pub fn hasPseudoTarget(self: &Self, target: PseudoTarget) -> bool {
    let mut i: usize = 0
    while i < self.simples.length() {
      if let Test.Element { target: found } = self.simples.asSlice()[i].test {
        if found == target { return true }
      }
      i = i + 1
    }
    return false
  }

  pub fn hasPseudoStates(self: &Self) -> bool {
    let mut i: usize = 0
    while i < self.simples.length() {
      if let Test.ElementState { .. } = self.simples.asSlice()[i].test { return true }
      i = i + 1
    }
    return false
  }
}

fn localArms(ast: &SelectorList, first: usize, depth: usize) -> bool {
  if depth > 4 {
    return false
  }
  let mut arm = first
  while arm != NONE {
    let entry = &ast.arms.asSlice()[arm]
    if !localCompound(ast, entry.tail, depth) {
      return false
    }
    arm = entry.next
  }
  return true
}

// Whether a compound reads only the element itself: its namespace and name, attributes, ids,
// classes, :link, :empty, and :is() or :not() of such compounds. Matched against an element
// that is not the shadow host, such a compound gives the same result for every element the
// tree reports the same way, wherever it sits.
fn localCompound(ast: &SelectorList, index: usize, depth: usize) -> bool {
  let compound = &ast.compounds.asSlice()[index]
  if compound.previous != NONE || compound.relation != Combinator.None {
    return false
  }
  let mut simple = compound.first
  while simple != NONE {
    let entry = &ast.simples.asSlice()[simple]
    let local = match &entry.test {
      Test.Id { .. } => true
      Test.Class { .. } => true
      Test.Attribute { .. } => true
      Test.Element { .. } => true
      Test.State { pseudo } => pseudo == Pseudo.Link || pseudo == Pseudo.Empty
        || pseudo == Pseudo.Never
      Test.Function { kind, list } => (kind == FunctionKind.Is || kind == FunctionKind.Not)
        && localArms(ast, list, depth + 1)
      _ => false
    }
    if !local {
      return false
    }
    simple = entry.next
  }
  return true
}

impl<'a> SubjectKeys<'a> {
  pub fn next(self: &mut Self) -> Option<SubjectKey> {
    if self.nextArm == NONE {
      return Option<SubjectKey>.None
    }
    let arm = &self.selectors.arms.asSlice()[self.nextArm]
    let compound = &self.selectors.compounds.asSlice()[arm.tail]
    self.nextArm = arm.next
    let mut key = SubjectKey {
      kind: if compound.named {
        SubjectKind.LocalName
      } else {
        SubjectKind.Any
      },
      text: compound.name,
      target: compound.target,
    }
    let mut id = false
    let mut simple = compound.first
    while simple != NONE {
      let entry = &self.selectors.simples.asSlice()[simple]
      match &entry.test {
        Test.Id { text } => {
          if !id { key = SubjectKey { kind: SubjectKind.Id, text: text, target: compound.target } }
          id = true
        }
        Test.Class { text } => {
          if !id && key.kind != SubjectKind.Class {
            key = SubjectKey { kind: SubjectKind.Class, text: text, target: compound.target }
          }
        }
        Test.State { pseudo } => {
          if pseudo == Pseudo.Never {
            return Option<SubjectKey>.Some { value: SubjectKey { kind: SubjectKind.Never, text: compound.name, target: compound.target } }
          }
        }
        _ => {}
      }
      simple = entry.next
    }
    return Option<SubjectKey>.Some { value: key }
  }
}

struct Parsed {
  valid: bool,
  head: usize,
  specificity: Specificity
}

impl Copy for Parsed {}

fn rejected() -> Parsed {
  return Parsed { valid: false, head: NONE, specificity: zero() }
}

struct Name {
  valid: bool,
  next: usize,
  namespace: Namespace,
  text: Span,
  named: bool
}

impl Copy for Name {}

fn whitespace(buffer: &TokenBuffer, at: usize, end: usize) -> bool {
  return at < end
    && match &buffer.tokens.asSlice()[at].kind {
      Kind.Whitespace => true
      _ => false
    }
}

fn spaces(buffer: &TokenBuffer, at: usize, end: usize) -> usize {
  let mut result = at
  while whitespace(buffer, result, end) {
    result = result + 1
  }
  return result
}

fn delim(buffer: &TokenBuffer, at: usize, end: usize, scalar: u32) -> bool {
  return at < end
    && match &buffer.tokens.asSlice()[at].kind {
      Kind.Delim { scalar: found } => found == scalar
      _ => false
    }
}

fn ident(buffer: &TokenBuffer, at: usize, end: usize, word: &[u8]) -> bool {
  return at < end
    && match &buffer.tokens.asSlice()[at].kind {
      Kind.Ident { text } => tokens.insensitive(buffer.text(text), word)
      _ => false
    }
}

fn isComma(buffer: &TokenBuffer, at: usize) -> bool {
  return match &buffer.tokens.asSlice()[at].kind {
    Kind.Comma => true
    _ => false
  }
}

fn implicitEnd(buffer: &TokenBuffer, close: usize, end: usize) -> bool {
  return close == end && end < buffer.tokens.length()
    && match &buffer.tokens.asSlice()[end].kind {
      Kind.Eof => true
      _ => false
    }
}

fn defaultNamespace(bindings: &[NamespaceBinding]) -> Namespace {
  let mut i = bindings.length
  while i > 0 {
    i = i - 1
    if bindings[i].prefix.start == bindings[i].prefix.end {
      return Namespace { mode: NamespaceMode.Exact, uri: bindings[i].uri }
    }
  }
  return anyNamespace()
}

fn qualifiedName(
  buffer: &TokenBuffer,
  start: usize,
  end: usize,
  bindings: &[NamespaceBinding],
  attribute: bool,
) -> Name {
  let mut result = Name {
    valid: false,
    next: start,
    namespace: if attribute {
      noNamespace()
    } else {
      defaultNamespace(bindings)
    },
    text: emptySpan(),
    named: false,
  }
  if start >= end {
    return result
  }
  let mut at = start
  let mut prefix = emptySpan()
  let mut prefixIdent = false
  let mut firstName = false
  match &buffer.tokens.asSlice()[at].kind {
    Kind.Ident { text } => {
      prefix = text
      prefixIdent = true
      firstName = true
    }
    Kind.Delim { scalar } => {
      firstName = scalar == 42
    }
    _ => {}
  }
  let hasPrefix = firstName && delim(buffer, at + 1, end, 124) && !delim(buffer, at + 2, end, 61)
  if hasPrefix {
    result.namespace = anyNamespace()
    if prefixIdent {
      let mut i = bindings.length
      let mut found = false
      while i > 0 {
        i = i - 1
        if tokens.equal(buffer.text(bindings[i].prefix), buffer.text(prefix)) {
          result.namespace = Namespace { mode: NamespaceMode.Exact, uri: bindings[i].uri }
          found = true
          break
        }
      }
      if !found {
        return result
      }
    }
    at = at + 2
  } else if delim(buffer, at, end, 124) {
    result.namespace = noNamespace()
    at = at + 1
  }
  if at >= end {
    return result
  }
  match &buffer.tokens.asSlice()[at].kind {
    Kind.Ident { text } => {
      result.text = text
      result.named = true
    }
    Kind.Delim { scalar } => {
      if scalar != 42 || attribute {
        return result
      }
    }
    _ => {
      return result
    }
  }
  result.next = at + 1
  result.valid = true
  return result
}

effect fn appendSimple(ast: &mut SelectorList, compound: usize, test: Test) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let previous = ast.compounds.asSlice()[compound].first
  let index = ast.simples.length()
  run ast.simples.append(Simple { test: move test, next: previous })
  let mut compounds = ast.compounds.asMutSlice()
  compounds[compound].first = index
}

// Namespace bindings are stylesheet-local. Last binding for each prefix wins.
// Invalid grammar returns None; resource exhaustion is never swallowed by forgiving lists.
pub effect fn parse(
  buffer: &TokenBuffer,
  range: TokenRange,
  namespaces: &[NamespaceBinding],
  limits: &Limits,
) -> Option<SelectorList>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  return run parseWithMode(buffer, range, namespaces, limits, false, false)
}

// Nesting 1: & is legal outside nesting too; relative selector lists require a
// nested style rule. No specificity is returned without the parent selector.
pub effect fn validateCssom(
  buffer: &TokenBuffer,
  range: TokenRange,
  namespaces: &[NamespaceBinding],
  limits: &Limits,
  nested: bool,
) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let parsed = run parseWithMode(buffer, range, namespaces, limits, true, nested)
  return match &parsed {
    Option<SelectorList>.Some { .. } => true
    _ => false
  }
}

effect fn parseWithMode(
  buffer: &TokenBuffer,
  range: TokenRange,
  namespaces: &[NamespaceBinding],
  limits: &Limits,
  validationOnly: bool,
  nested: bool,
) -> Option<SelectorList>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  if range.start > range.end || range.end > buffer.tokens.length() {
    return Option<SelectorList>.None
  }
  if range.end - range.start > limits.maxTokens {
    fail CssError { kind: CssErrorKind.TokenLimit, offset: range.start }
  }
  let mut ast = SelectorList {
    simples: List<Simple>.make(),
    compounds: List<Compound>.make(),
    arms: List<Arm>.make(),
    head: NONE,
    maxDepth: limits.maxDepth,
    validationOnly: validationOnly,
  }
  let parsed = run parseList(
    &mut ast,
    buffer,
    range,
    namespaces,
    limits,
    0,
    false,
    nested,
    false,
    false,
    false,
    PseudoElement.None,
  )
  if !parsed.valid {
    return Option<SelectorList>.None
  }
  ast.head = parsed.head
  return Option<SelectorList>.Some { value: move ast }
}

effect fn parseList(
  ast: &mut SelectorList,
  buffer: &TokenBuffer,
  range: TokenRange,
  bindings: &[NamespaceBinding],
  limits: &Limits,
  depth: usize,
  forgiving: bool,
  relative: bool,
  insideHas: bool,
  subjectExempt: bool,
  compoundOnly: bool,
  suffix: PseudoElement,
) -> Parsed
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  if depth >= limits.maxDepth {
    fail CssError { kind: CssErrorKind.NestingLimit, offset: range.start }
  }
  let mut result = Parsed { valid: true, head: NONE, specificity: zero() }
  let mut at = range.start
  let mut start = at
  let mut last = NONE
  while at <= range.end {
    if at == range.end || isComma(buffer, at) {
      let parsed = run parseArm(
        &mut ast.*,
        buffer,
        TokenRange { start: start, end: at },
        bindings,
        limits,
        depth,
        relative,
        insideHas,
        subjectExempt,
        compoundOnly,
        suffix,
      )
      if !parsed.valid {
        if !forgiving {
          return rejected()
        }
      } else {
        if result.head == NONE {
          result.head = parsed.head
        } else {
          let mut arms = ast.arms.asMutSlice()
          arms[last].next = parsed.head
        }
        last = parsed.head
        result.specificity = maximum(result.specificity, parsed.specificity)
      }
      start = at + 1
    } else {
      let token = &buffer.tokens.asSlice()[at]
      match &token.kind {
        Kind.Function { .. } => {
          if token.matching > at && token.matching <= range.end {
            at = if token.matching == range.end {
              range.end - 1
            } else {
              token.matching
            }
          }
        }
        Kind.OpenSquare => {
          if token.matching > at && token.matching <= range.end {
            at = if token.matching == range.end {
              range.end - 1
            } else {
              token.matching
            }
          }
        }
        Kind.OpenParen => {
          if token.matching > at && token.matching <= range.end {
            at = if token.matching == range.end {
              range.end - 1
            } else {
              token.matching
            }
          }
        }
        Kind.OpenBrace => {
          if token.matching > at && token.matching <= range.end {
            at = if token.matching == range.end {
              range.end - 1
            } else {
              token.matching
            }
          }
        }
        _ => {}
      }
    }
    at = at + 1
  }
  return result
}

fn combinator(buffer: &TokenBuffer, at: usize, end: usize) -> Combinator {
  if delim(buffer, at, end, 62) {
    return Combinator.Child
  }
  if delim(buffer, at, end, 43) {
    return Combinator.Adjacent
  }
  if delim(buffer, at, end, 126) {
    return Combinator.Sibling
  }
  return Combinator.None
}

effect fn parseArm(
  ast: &mut SelectorList,
  buffer: &TokenBuffer,
  range: TokenRange,
  bindings: &[NamespaceBinding],
  limits: &Limits,
  depth: usize,
  relative: bool,
  insideHas: bool,
  subjectExempt: bool,
  compoundOnly: bool,
  suffix: PseudoElement,
) -> Parsed
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut at = spaces(buffer, range.start, range.end)
  let mut previous = NONE
  let mut relation = if relative {
    Combinator.Descendant
  } else {
    Combinator.None
  }
  let leading = combinator(buffer, at, range.end)
  if leading != Combinator.None {
    if !relative {
      return rejected()
    }
    relation = leading
    at = spaces(buffer, at + 1, range.end)
  }
  let mut specificity = zero()
  let mut count: usize = 0
  let mut pseudoElement = suffix
  while at < range.end {
    count = count + 1
    if depth + count >= limits.maxDepth {
      fail CssError { kind: CssErrorKind.NestingLimit, offset: at }
    }
    let name = qualifiedName(buffer, at, range.end, bindings, false)
    if suffix != PseudoElement.None && name.valid {
      return rejected()
    }
    let compound = ast.compounds.length()
    run ast.compounds.append(
      Compound {
        target: PseudoTarget.None,
        namespace: if name.valid {
          name.namespace
        } else {
          defaultNamespace(bindings)
        },
        name: name.text,
        named: name.named,
        explicitType: name.valid,
        hostEligible: false,
        first: NONE,
        previous: previous,
        relation: relation,
      },
    )
    let begin = at
    if name.valid {
      at = name.next
      if name.named {
        specificity.types = specificity.types + 1
      }
    }
    while at < range.end && !whitespace(buffer, at, range.end)
      && combinator(buffer, at, range.end) == Combinator.None {
      if pseudoElement != PseudoElement.None {
        match &buffer.tokens.asSlice()[at].kind {
          Kind.Colon => {}
          _ => {
            return rejected()
          }
        }
      }
      match &buffer.tokens.asSlice()[at].kind {
        Kind.Hash { text, identifier } => {
          if !identifier {
            return rejected()
          }
          run appendSimple(&mut ast.*, compound, Test.Id { text: text })
          specificity.ids = specificity.ids + 1
          at = at + 1
        }
        Kind.Delim { scalar } => {
          if scalar == 38 && ast.validationOnly {
            run appendSimple(&mut ast.*, compound, Test.State { pseudo: Pseudo.Never })
            at = at + 1
            continue
          }
          if scalar != 46 || at + 1 >= range.end {
            return rejected()
          }
          match &buffer.tokens.asSlice()[at + 1].kind {
            Kind.Ident { text } => {
              run appendSimple(&mut ast.*, compound, Test.Class { text: text })
            }
            _ => {
              return rejected()
            }
          }
          specificity.classes = specificity.classes + 1
          at = at + 2
        }
        Kind.OpenSquare => {
          let close = buffer.tokens.asSlice()[at].matching
          if close <= at || close > range.end
            || (close == range.end && !implicitEnd(buffer, close, range.end)) {
            return rejected()
          }
          if !run parseAttribute(
            &mut ast.*,
            compound,
            buffer,
            TokenRange { start: at + 1, end: close },
            bindings,
          ) {
            return rejected()
          }
          specificity.classes = specificity.classes + 1
          at = if close < range.end {
            close + 1
          } else {
            close
          }
        }
        Kind.Colon => {
          at = at + 1
          if at >= range.end {
            return rejected()
          }
          let doubled = match &buffer.tokens.asSlice()[at].kind {
            Kind.Colon => true
            _ => false
          }
          if doubled {
            at = at + 1
          }
          if at >= range.end {
            return rejected()
          }
          match &buffer.tokens.asSlice()[at].kind {
            Kind.Ident { text } => {
              let word = buffer.text(text)
              let generated = legacyPseudoElement(word)
              if doubled || generated {
                let kind = pseudoElementKind(word)
                if depth != 0 || insideHas || compoundOnly
                  || !allowedPseudoElement(pseudoElement, kind, word) {
                  return rejected()
                }
                pseudoElement = kind
                specificity.types = specificity.types + 1
                let target = element.pseudoTarget(word)
                if target != PseudoTarget.None {
                  let compounds = ast.compounds.asMutSlice()
                  compounds[compound].target = target
                  run appendSimple(&mut ast.*, compound, Test.Element { target: target })
                } else { run appendSimple(&mut ast.*, compound, Test.State { pseudo: Pseudo.Never }) }
              } else {
                if !allowedPseudoClass(pseudoElement, word, false) {
                  return rejected()
                }
                let state = pseudo(word)
                match &state {
                  Option<Pseudo>.Some { value } => {
                    if pseudoElement != PseudoElement.None { run appendSimple(&mut ast.*, compound, Test.ElementState { pseudo: value }) }
                    else { run appendSimple(&mut ast.*, compound, Test.State { pseudo: value }) }
                  }
                  _ => {
                    return rejected()
                  }
                }
                specificity.classes = specificity.classes + 1
              }
              at = at + 1
            }
            Kind.Function { name: functionName } => {
              if !doubled && !allowedPseudoClass(pseudoElement, buffer.text(functionName), true) {
                return rejected()
              }
              let close = buffer.tokens.asSlice()[at].matching
              if close <= at || close > range.end
                || (close == range.end && !implicitEnd(buffer, close, range.end)) {
                return rejected()
              }
              if doubled {
                let word = buffer.text(functionName)
                let kind = if tokens.insensitive(word, b"part") {
                  PseudoElement.ElementBacked
                } else if tokens.insensitive(word, b"slotted") {
                  PseudoElement.Slotted
                } else if tokens.insensitive(word, b"highlight") {
                  PseudoElement.Other
                } else {
                  PseudoElement.None
                }
                if depth != 0 || insideHas || compoundOnly
                  || !allowedPseudoElement(pseudoElement, kind, word) {
                  return rejected()
                }
                let functional = run parsePseudoElementFunction(
                  &mut ast.*,
                  buffer,
                  functionName,
                  TokenRange { start: at + 1, end: close },
                  bindings,
                  limits,
                  depth + count,
                )
                if !functional.valid {
                  return rejected()
                }
                specificity = add(specificity, functional.specificity)
                pseudoElement = kind
                run appendSimple(&mut ast.*, compound, Test.State { pseudo: Pseudo.Never })
              } else {
                let functional = run parseFunction(
                  &mut ast.*,
                  compound,
                  buffer,
                  functionName,
                  TokenRange { start: at + 1, end: close },
                  bindings,
                  limits,
                  depth + count,
                  insideHas,
                  compoundOnly,
                  pseudoElement,
                )
                if !functional.valid {
                  return rejected()
                }
                specificity = add(specificity, functional.specificity)
              }
              at = if close < range.end {
                close + 1
              } else {
                close
              }
            }
            _ => {
              return rejected()
            }
          }
        }
        _ => {
          return rejected()
        }
      }
    }
    if at == begin {
      return rejected()
    }
    let hostEligible = hostCompoundEligible(&ast.*, compound)
    let mut compounds = ast.compounds.asMutSlice()
    compounds[compound].hostEligible = hostEligible
    drop compounds
    previous = compound
    let next = spaces(buffer, at, range.end)
    if next == range.end {
      at = next
      break
    }
    if compoundOnly {
      return rejected()
    }
    if pseudoElement != PseudoElement.None {
      return rejected()
    }
    relation = combinator(buffer, next, range.end)
    if relation == Combinator.None {
      if next == at {
        return rejected()
      }
      relation = Combinator.Descendant
      at = next
    } else {
      at = spaces(buffer, next + 1, range.end)
    }
    if at == range.end {
      return rejected()
    }
  }
  if previous == NONE {
    return rejected()
  }
  if subjectExempt && !ast.compounds.asSlice()[previous].explicitType {
    let mut compounds = ast.compounds.asMutSlice()
    compounds[previous].namespace = anyNamespace()
  }
  let index = ast.arms.length()
  run ast.arms.append(Arm { tail: previous, next: NONE, specificity: specificity })
  return Parsed { valid: true, head: index, specificity: specificity }
}

// Selectors 4 #featureless-elements: eligibility is syntactic, not a match result.
// Cache it once so nested logical selectors do not rescan the AST on every node.
fn hostListEligible(ast: &SelectorList, list: usize) -> bool {
  let mut arm = list
  while arm != NONE {
    let entry = &ast.arms.asSlice()[arm]
    if ast.compounds.asSlice()[entry.tail].hostEligible {
      return true
    }
    arm = entry.next
  }
  return false
}

fn hostCompoundEligible(ast: &SelectorList, index: usize) -> bool {
  let compound = &ast.compounds.asSlice()[index]
  if compound.explicitType {
    return false
  }
  let mut other = false
  let mut simple = compound.first
  while simple != NONE {
    let entry = &ast.simples.asSlice()[simple]
    match &entry.test {
      Test.State { pseudo } => {
        if pseudo != Pseudo.Host {
          return false
        }
        other = true
      }
      Test.Function { kind, list } => {
        if kind != FunctionKind.Has {
          if kind != FunctionKind.Host && kind != FunctionKind.HostContext
            && !hostListEligible(ast, list) {
            return false
          }
          other = true
        }
      }
      _ => {
        return false
      }
    }
    simple = entry.next
  }
  return other
}

effect fn parseAttribute(
  ast: &mut SelectorList,
  compound: usize,
  buffer: &TokenBuffer,
  range: TokenRange,
  bindings: &[NamespaceBinding],
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let name = qualifiedName(
    buffer,
    spaces(buffer, range.start, range.end),
    range.end,
    bindings,
    true,
  )
  if !name.valid {
    return false
  }
  let mut at = spaces(buffer, name.next, range.end)
  let mut op = AttributeOp.Present
  let mut value = emptySpan()
  let mut insensitive = false
  if at < range.end {
    if delim(buffer, at, range.end, 61) {
      op = AttributeOp.Equal
      at = at + 1
    } else {
      if !delim(buffer, at + 1, range.end, 61) {
        return false
      }
      op = if delim(buffer, at, range.end, 126) {
        AttributeOp.Word
      } else if delim(buffer, at, range.end, 124) {
        AttributeOp.Hyphen
      } else if delim(buffer, at, range.end, 94) {
        AttributeOp.Prefix
      } else if delim(buffer, at, range.end, 36) {
        AttributeOp.Suffix
      } else if delim(buffer, at, range.end, 42) {
        AttributeOp.Contains
      } else {
        return false
      }
      at = at + 2
    }
    at = spaces(buffer, at, range.end)
    if at >= range.end {
      return false
    }
    match &buffer.tokens.asSlice()[at].kind {
      Kind.Ident { text } => {
        value = text
      }
      Kind.String { text } => {
        value = text
      }
      _ => {
        return false
      }
    }
    at = spaces(buffer, at + 1, range.end)
    if at < range.end {
      if ident(buffer, at, range.end, b"i") {
        insensitive = true
      } else if !ident(buffer, at, range.end, b"s") {
        return false
      }
      at = spaces(buffer, at + 1, range.end)
    }
  }
  if at != range.end {
    return false
  }
  run appendSimple(
    &mut ast.*,
    compound,
    Test.Attribute {
      namespace: name.namespace,
      name: name.text,
      value: value,
      op: op,
      insensitive: insensitive,
    },
  )
  return true
}

fn legacyPseudoElement(word: &[u8]) -> bool {
  return tokens.insensitive(word, b"before") || tokens.insensitive(word, b"after")
    || tokens.insensitive(word, b"first-line")
    || tokens.insensitive(word, b"first-letter")
}

fn pseudoElementKind(word: &[u8]) -> PseudoElement {
  if tokens.insensitive(word, b"before") || tokens.insensitive(word, b"after") {
    return PseudoElement.Generated
  }
  if tokens.insensitive(word, b"first-letter") {
    return PseudoElement.FirstLetter
  }
  if tokens.insensitive(word, b"marker") || tokens.insensitive(word, b"placeholder")
    || tokens.insensitive(word, b"backdrop")
    || tokens.insensitive(word, b"interest-button") {
    return PseudoElement.TreeAbiding
  }
  if tokens.insensitive(word, b"file-selector-button")
    || tokens.insensitive(word, b"details-content") {
    return PseudoElement.ElementBacked
  }
  if tokens.insensitive(word, b"-webkit-scrollbar")
    || tokens.insensitive(word, b"-webkit-scrollbar-thumb")
    || tokens.insensitive(word, b"-webkit-scrollbar-track")
    || tokens.insensitive(word, b"-webkit-scrollbar-track-piece")
    || tokens.insensitive(word, b"-webkit-scrollbar-button")
    || tokens.insensitive(word, b"-webkit-scrollbar-corner")
    || tokens.insensitive(word, b"-webkit-resizer") {
    return PseudoElement.TreeAbiding
  }
  if tokens.insensitive(word, b"search-text") {
    return PseudoElement.SearchText
  }
  if tokens.insensitive(word, b"first-line") || tokens.insensitive(word, b"selection")
    || tokens.insensitive(word, b"target-text")
    || tokens.insensitive(word, b"spelling-error")
    || tokens.insensitive(word, b"grammar-error")
    || tokens.insensitive(word, b"prefix")
    || tokens.insensitive(word, b"suffix") {
    return PseudoElement.Other
  }
  return PseudoElement.None
}

fn allowedPseudoElement(previous: PseudoElement, next: PseudoElement, word: &[u8]) -> bool {
  if next == PseudoElement.None {
    return false
  }
  if tokens.insensitive(word, b"prefix") || tokens.insensitive(word, b"suffix") {
    return previous == PseudoElement.FirstLetter
  }
  if previous == PseudoElement.None || previous == PseudoElement.ElementBacked {
    return true
  }
  if previous == PseudoElement.Generated {
    return tokens.insensitive(word, b"marker")
  }
  return previous == PseudoElement.Slotted
    && (next == PseudoElement.Generated || next == PseudoElement.TreeAbiding
      || next == PseudoElement.ElementBacked)
}

fn allowedPseudoClass(previous: PseudoElement, word: &[u8], functional: bool) -> bool {
  if previous == PseudoElement.None || previous == PseudoElement.ElementBacked {
    return true
  }
  if functional {
    return tokens.insensitive(word, b"is") || tokens.insensitive(word, b"where")
      || tokens.insensitive(word, b"not")
  }
  return tokens.insensitive(word, b"hover") || tokens.insensitive(word, b"active")
    || tokens.insensitive(word, b"focus")
    || tokens.insensitive(word, b"focus-visible")
    || tokens.insensitive(word, b"focus-within")
    || (previous == PseudoElement.SearchText && tokens.insensitive(word, b"current"))
}

fn customIdentifier(word: &[u8]) -> bool {
  return !tokens.insensitive(word, b"initial") && !tokens.insensitive(word, b"inherit")
    && !tokens.insensitive(word, b"unset")
    && !tokens.insensitive(word, b"revert")
    && !tokens.insensitive(word, b"revert-layer")
    && !tokens.insensitive(word, b"default")
}

effect fn parsePseudoElementFunction(
  ast: &mut SelectorList,
  buffer: &TokenBuffer,
  name: Span,
  range: TokenRange,
  bindings: &[NamespaceBinding],
  limits: &Limits,
  depth: usize,
) -> Parsed
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let word = buffer.text(name)
  let mut specificity = Specificity { ids: 0, classes: 0, types: 1 }
  if tokens.insensitive(word, b"slotted") {
    let parsed = run parseList(
      &mut ast.*,
      buffer,
      range,
      bindings,
      limits,
      depth,
      false,
      false,
      false,
      false,
      true,
      PseudoElement.None,
    )
    if !parsed.valid || parsed.head == NONE || ast.arms.asSlice()[parsed.head].next != NONE {
      return rejected()
    }
    specificity = add(specificity, parsed.specificity)
  } else if tokens.insensitive(word, b"part") {
    let mut at = spaces(buffer, range.start, range.end)
    if at == range.end {
      return rejected()
    }
    while at < range.end {
      match &buffer.tokens.asSlice()[at].kind {
        Kind.Ident { .. } => {}
        _ => {
          return rejected()
        }
      }
      let next = spaces(buffer, at + 1, range.end)
      if next < range.end && next == at + 1 {
        return rejected()
      }
      at = next
    }
  } else if tokens.insensitive(word, b"highlight") {
    let at = spaces(buffer, range.start, range.end)
    if at == range.end || spaces(buffer, at + 1, range.end) != range.end {
      return rejected()
    }
    match &buffer.tokens.asSlice()[at].kind {
      Kind.Ident { text } => {
        if !customIdentifier(buffer.text(text)) {
          return rejected()
        }
      }
      Kind.Delim { scalar } => {
        if scalar != 42 {
          return rejected()
        }
        specificity = zero()
      }
      _ => {
        return rejected()
      }
    }
  } else {
    return rejected()
  }
  return Parsed { valid: true, head: NONE, specificity: specificity }
}

fn pseudo(word: &[u8]) -> Option<Pseudo> {
  if tokens.insensitive(word, b"host") {
    return Option<Pseudo>.Some { value: Pseudo.Host }
  }
  if tokens.insensitive(word, b"root") {
    return Option<Pseudo>.Some { value: Pseudo.Root }
  }
  if tokens.insensitive(word, b"empty") {
    return Option<Pseudo>.Some { value: Pseudo.Empty }
  }
  if tokens.insensitive(word, b"scope") {
    return Option<Pseudo>.Some { value: Pseudo.Scope }
  }
  if tokens.insensitive(word, b"target") {
    return Option<Pseudo>.Some { value: Pseudo.Target }
  }
  if tokens.insensitive(word, b"link") || tokens.insensitive(word, b"any-link") {
    return Option<Pseudo>.Some { value: Pseudo.Link }
  }
  if tokens.insensitive(word, b"first-child") {
    return Option<Pseudo>.Some { value: Pseudo.FirstChild }
  }
  if tokens.insensitive(word, b"last-child") {
    return Option<Pseudo>.Some { value: Pseudo.LastChild }
  }
  if tokens.insensitive(word, b"only-child") {
    return Option<Pseudo>.Some { value: Pseudo.OnlyChild }
  }
  if tokens.insensitive(word, b"first-of-type") {
    return Option<Pseudo>.Some { value: Pseudo.FirstType }
  }
  if tokens.insensitive(word, b"last-of-type") {
    return Option<Pseudo>.Some { value: Pseudo.LastType }
  }
  if tokens.insensitive(word, b"only-of-type") {
    return Option<Pseudo>.Some { value: Pseudo.OnlyType }
  }
  if tokens.insensitive(word, b"hover") {
    return Option<Pseudo>.some(Pseudo.Hover)
  }
  if tokens.insensitive(word, b"active") {
    return Option<Pseudo>.some(Pseudo.Active)
  }
  if tokens.insensitive(word, b"focus") {
    return Option<Pseudo>.some(Pseudo.Focus)
  }
  if tokens.insensitive(word, b"focus-visible") {
    return Option<Pseudo>.some(Pseudo.FocusVisible)
  }
  if tokens.insensitive(word, b"focus-within") {
    return Option<Pseudo>.some(Pseudo.FocusWithin)
  }
  if tokens.insensitive(word, b"disabled") {
    return Option<Pseudo>.some(Pseudo.Disabled)
  }
  if tokens.insensitive(word, b"enabled") {
    return Option<Pseudo>.some(Pseudo.Enabled)
  }
  if tokens.insensitive(word, b"checked") {
    return Option<Pseudo>.some(Pseudo.Checked)
  }
  if tokens.insensitive(word, b"indeterminate") {
    return Option<Pseudo>.some(Pseudo.Indeterminate)
  }
  if tokens.insensitive(word, b"placeholder-shown") {
    return Option<Pseudo>.some(Pseudo.PlaceholderShown)
  }
  if tokens.insensitive(word, b"read-only") {
    return Option<Pseudo>.some(Pseudo.ReadOnly)
  }
  if tokens.insensitive(word, b"read-write") {
    return Option<Pseudo>.some(Pseudo.ReadWrite)
  }
  if tokens.insensitive(word, b"required") {
    return Option<Pseudo>.some(Pseudo.Required)
  }
  if tokens.insensitive(word, b"optional") {
    return Option<Pseudo>.some(Pseudo.Optional)
  }
  if tokens.insensitive(word, b"open") {
    return Option<Pseudo>.some(Pseudo.Open)
  }
  if tokens.insensitive(word, b"popover-open") {
    return Option<Pseudo>.some(Pseudo.PopoverOpen)
  }
  if tokens.insensitive(word, b"default") {
    return Option<Pseudo>.some(Pseudo.Default)
  }
  if tokens.insensitive(word, b"in-range") {
    return Option<Pseudo>.some(Pseudo.InRange)
  }
  if tokens.insensitive(word, b"out-of-range") {
    return Option<Pseudo>.some(Pseudo.OutOfRange)
  }
  if tokens.insensitive(word, b"visited")
    || tokens.insensitive(word, b"unchecked")
    || tokens.insensitive(word, b"valid")
    || tokens.insensitive(word, b"invalid")
    || tokens.insensitive(word, b"user-valid")
    || tokens.insensitive(word, b"user-invalid")
    || tokens.insensitive(word, b"autofill")
    || tokens.insensitive(word, b"-webkit-autofill")
    || tokens.insensitive(word, b"current") {
    return Option<Pseudo>.Some { value: Pseudo.Never }
  }
  return Option<Pseudo>.None
}

effect fn parseFunction(
  ast: &mut SelectorList,
  compound: usize,
  buffer: &TokenBuffer,
  name: Span,
  range: TokenRange,
  bindings: &[NamespaceBinding],
  limits: &Limits,
  depth: usize,
  insideHas: bool,
  compoundOnly: bool,
  suffix: PseudoElement,
) -> Parsed
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let word = buffer.text(name)
  let matches = tokens.insensitive(word, b"is")
  let zeroSpecificity = tokens.insensitive(word, b"where")
  let negation = tokens.insensitive(word, b"not")
  let has = tokens.insensitive(word, b"has")
  let host = tokens.insensitive(word, b"host")
  let hostContext = tokens.insensitive(word, b"host-context")
  if host || hostContext {
    let parsed = run parseList(
      &mut ast.*,
      buffer,
      range,
      bindings,
      limits,
      depth,
      false,
      false,
      insideHas,
      false,
      true,
      PseudoElement.None,
    )
    if !parsed.valid || parsed.head == NONE || ast.arms.asSlice()[parsed.head].next != NONE {
      return rejected()
    }
    run appendSimple(
      &mut ast.*,
      compound,
      Test.Function {
        kind: if host {
          FunctionKind.Host
        } else {
          FunctionKind.HostContext
        },
        list: parsed.head,
      },
    )
    return Parsed {
      valid: true,
      head: NONE,
      specificity: add(Specificity { ids: 0, classes: 1, types: 0 }, parsed.specificity),
    }
  }
  if matches || zeroSpecificity || negation || has {
    if has && insideHas {
      return rejected()
    }
    let parsed = run parseList(
      &mut ast.*,
      buffer,
      range,
      bindings,
      limits,
      depth,
      matches || zeroSpecificity,
      has,
      insideHas || has,
      !has,
      (compoundOnly && !has) || (suffix != PseudoElement.None && !has),
      if has {
        PseudoElement.None
      } else {
        suffix
      },
    )
    if !parsed.valid {
      return rejected()
    }
    run appendSimple(
      &mut ast.*,
      compound,
      Test.Function {
        kind: if has {
          FunctionKind.Has
        } else if negation {
          FunctionKind.Not
        } else {
          FunctionKind.Is
        },
        list: parsed.head,
      },
    )
    return Parsed {
      valid: true,
      head: NONE,
      specificity: if zeroSpecificity {
        zero()
      } else {
        parsed.specificity
      },
    }
  }
  if tokens.insensitive(word, b"dir") {
    let at = spaces(buffer, range.start, range.end)
    if (!ident(buffer, at, range.end, b"ltr") && !ident(buffer, at, range.end, b"rtl"))
      || spaces(buffer, at + 1, range.end) != range.end {
      return rejected()
    }
    let pseudo = if ident(buffer, at, range.end, b"rtl") { Pseudo.DirRtl } else { Pseudo.DirLtr }
    run appendSimple(&mut ast.*, compound, Test.State { pseudo: pseudo })
    return Parsed {
      valid: true,
      head: NONE,
      specificity: Specificity { ids: 0, classes: 1, types: 0 },
    }
  }
  if tokens.insensitive(word, b"lang") {
    let mut at = spaces(buffer, range.start, range.end)
    if at == range.end {
      return rejected()
    }
    while at < range.end {
      match &buffer.tokens.asSlice()[at].kind {
        Kind.Ident { .. } => {}
        Kind.String { .. } => {}
        _ => {
          return rejected()
        }
      }
      at = spaces(buffer, at + 1, range.end)
      if at == range.end {
        break
      }
      if !isComma(buffer, at) {
        return rejected()
      }
      at = spaces(buffer, at + 1, range.end)
      if at == range.end {
        return rejected()
      }
    }
    run appendSimple(&mut ast.*, compound, Test.Language { range: range })
    return Parsed {
      valid: true,
      head: NONE,
      specificity: Specificity { ids: 0, classes: 1, types: 0 },
    }
  }
  let child = tokens.insensitive(word, b"nth-child")
  let lastChild = tokens.insensitive(word, b"nth-last-child")
  let ofType = tokens.insensitive(word, b"nth-of-type")
  let lastType = tokens.insensitive(word, b"nth-last-of-type")
  if child || lastChild || ofType || lastType {
    let mut of = range.end
    let mut at = range.start
    while at < range.end {
      if ident(buffer, at, range.end, b"of") {
        of = at
        break
      }
      at = at + 1
    }
    let formula = nthFormula(buffer, TokenRange { start: range.start, end: of })
    if !formula.valid {
      return rejected()
    }
    let mut list = NONE
    let mut specificity = Specificity { ids: 0, classes: 1, types: 0 }
    if of < range.end {
      if ofType || lastType || of == range.start || !whitespace(buffer, of - 1, range.end)
        || !whitespace(buffer, of + 1, range.end) {
        return rejected()
      }
      let parsed = run parseList(
        &mut ast.*,
        buffer,
        TokenRange { start: of + 1, end: range.end },
        bindings,
        limits,
        depth,
        false,
        false,
        insideHas,
        false,
        false,
        PseudoElement.None,
      )
      if !parsed.valid {
        return rejected()
      }
      list = parsed.head
      specificity = add(specificity, parsed.specificity)
    }
    run appendSimple(
      &mut ast.*,
      compound,
      Test.Nth {
        a: formula.a,
        b: formula.b,
        reverse: lastChild || lastType,
        ofType: ofType || lastType,
        list: list,
      },
    )
    return Parsed { valid: true, head: NONE, specificity: specificity }
  }
  return rejected()
}

pub struct Formula {
  pub valid: bool,
  pub a: f64,
  pub b: f64
}

impl Copy for Formula {}

fn badFormula() -> Formula {
  return Formula { valid: false, a: 0.0, b: 0.0 }
}

fn clampInteger(value: f64) -> f64 {
  // CSS Syntax permits a supported integer range; keep exact arithmetic within that range.
  return if value > 2147483647.0 {
    2147483647.0
  } else if value < -2147483647.0 {
    -2147483647.0
  } else {
    value
  }
}

fn unsignedInteger(buffer: &TokenBuffer, at: usize, end: usize) -> Option<f64> {
  if at >= end {
    return Option<f64>.None
  }
  let token = &buffer.tokens.asSlice()[at]
  let text = buffer.text(token.source)
  if text.length == 0 || text[0] == 43 || text[0] == 45 {
    return Option<f64>.None
  }
  return match &token.kind {
    Kind.Number { value, integer } => if integer {
      Option<f64>.Some { value: clampInteger(value) }
    } else {
      Option<f64>.None
    }
    _ => Option<f64>.None
  }
}

pub fn nthFormula(buffer: &TokenBuffer, range: TokenRange) -> Formula {
  let mut at = spaces(buffer, range.start, range.end)
  let mut end = range.end
  while end > at && whitespace(buffer, end - 1, end) {
    end = end - 1
  }
  if at == end {
    return badFormula()
  }
  if ident(buffer, at, end, b"odd") || ident(buffer, at, end, b"even") {
    if at + 1 != end {
      return badFormula()
    }
    return Formula {
      valid: true,
      a: 2.0,
      b: if ident(buffer, at, end, b"odd") {
        1.0
      } else {
        0.0
      },
    }
  }
  let mut plus = false
  if delim(buffer, at, end, 43) {
    plus = true
    at = at + 1
  }
  if at == end {
    return badFormula()
  }
  let mut result = Formula { valid: true, a: 1.0, b: 0.0 }
  let mut unit = emptySpan()
  let mut dimension = false
  match &buffer.tokens.asSlice()[at].kind {
    Kind.Number { value, integer } => {
      if plus || !integer || at + 1 != end {
        return badFormula()
      }
      return Formula { valid: true, a: 0.0, b: clampInteger(value) }
    }
    Kind.Dimension { value, integer, unit: text } => {
      dimension = true
      if plus || !integer {
        return badFormula()
      }
      result.a = clampInteger(value)
      unit = text
    }
    Kind.Ident { text } => {
      unit = text
    }
    _ => {
      return badFormula()
    }
  }
  let letters = buffer.text(unit)
  let mut i: usize = 0
  if letters.length > 0 && letters[0] == 45 {
    if plus || dimension {
      return badFormula()
    }
    result.a = -1.0
    i = 1
  }
  if i >= letters.length || (letters[i] != 110 && letters[i] != 78) {
    return badFormula()
  }
  i = i + 1
  let mut negativeSuffix = false
  if i < letters.length {
    if letters[i] != 45 {
      return badFormula()
    }
    negativeSuffix = true
    i = i + 1
    if i < letters.length {
      let mut value: f64 = 0.0
      while i < letters.length {
        if letters[i] < 48 || letters[i] > 57 {
          return badFormula()
        }
        value = clampInteger(value * 10.0 + u8.toF64(letters[i] - 48))
        i = i + 1
      }
      if at + 1 != end {
        return badFormula()
      }
      result.b = -value
      return result
    }
  }
  at = spaces(buffer, at + 1, end)
  if at == end {
    return if negativeSuffix {
      badFormula()
    } else {
      result
    }
  }
  if negativeSuffix {
    match &unsignedInteger(buffer, at, end) {
      Option<f64>.Some { value } => {
        result.b = -value
      }
      _ => {
        return badFormula()
      }
    }
    if at + 1 != end {
      return badFormula()
    }
    return result
  }
  let negative = delim(buffer, at, end, 45)
  if negative || delim(buffer, at, end, 43) {
    at = spaces(buffer, at + 1, end)
    match &unsignedInteger(buffer, at, end) {
      Option<f64>.Some { value } => {
        result.b = if negative {
          -value
        } else {
          value
        }
      }
      _ => {
        return badFormula()
      }
    }
  } else {
    let token = &buffer.tokens.asSlice()[at]
    let spelling = buffer.text(token.source)
    if spelling.length == 0 || (spelling[0] != 43 && spelling[0] != 45) {
      return badFormula()
    }
    match &token.kind {
      Kind.Number { value, integer } => {
        if !integer {
          return badFormula()
        }
        result.b = clampInteger(value)
      }
      _ => {
        return badFormula()
      }
    }
  }
  if at + 1 != end {
    return badFormula()
  }
  return result
}

@inlineAlways
effect fn spend(context: &mut MatchContext) -> ()
  ! CssError {
  run context.spend(1)
}

@inlineAlways
effect fn depthLimit(ast: &SelectorList, depth: usize) -> ()
  ! CssError {
  if depth >= ast.maxDepth {
    fail CssError { kind: CssErrorKind.NestingLimit, offset: 0 }
  }
}

// Every arm is examined: the first match need not be the most specific match.
@inlineAlways
pub effect fn matchElement<T: ElementTree>(
  selectors: &SelectorList,
  buffer: &TokenBuffer,
  tree: &T,
  node: usize,
  context: &mut MatchContext,
) -> Option<Specificity>
  ! CssError {
  let mut result = Option<Specificity>.None
  let mut arm = selectors.head
  while arm != NONE {
    run spend(&mut context.*)
    let entry = &selectors.arms.asSlice()[arm]
    if subjectTarget(selectors, entry.tail) == context.pseudo
      && run matchComplex(selectors, buffer, tree, entry.tail, node, NONE, &mut context.*, 0) {
      let best = match &result {
        Option<Specificity>.Some { value } => maximum(value, entry.specificity)
        _ => entry.specificity
      }
      result = Option<Specificity>.Some { value: best }
    }
    arm = entry.next
  }
  return result
}

/// matchElement's result, and whether another element with the same source could get a
/// different one (see matchElementRecorded).
pub struct RecordedMatch {
  pub specificity: Option<Specificity>,
  pub positional: bool,
}

impl Copy for RecordedMatch {}

/// matchElement for an element that is not the shadow host, also telling whether the result
/// depends on the element's position. An arm whose compound reads only the element (see
/// localCompound) does not; nor does a positional arm whose subject's namespace or
/// type already rules this element out. Every other arm makes the result positional.
pub effect fn matchElementRecorded<T: ElementTree>(
  selectors: &SelectorList,
  buffer: &TokenBuffer,
  tree: &T,
  node: usize,
  context: &mut MatchContext,
) -> RecordedMatch
  ! CssError {
  let mut result = Option<Specificity>.None
  let mut positional = node == context.shadowHost
  let mut arm = selectors.head
  while arm != NONE {
    run spend(&mut context.*)
    let entry = &selectors.arms.asSlice()[arm]
    if !positional && !localCompound(selectors, entry.tail, 0) {
      let compound = &selectors.compounds.asSlice()[entry.tail]
      positional = (run namespaceMatches(
        buffer,
        compound.namespace,
        ElementTree.namespaceUri(tree, node),
        &mut context.*,
      ))
        && (!compound.named
          || run equalValue(
            buffer.text(compound.name),
            ElementTree.localName(tree, node),
            false,
            &mut context.*,
          ))
    }
    if subjectTarget(selectors, entry.tail) == context.pseudo
      && run matchComplex(selectors, buffer, tree, entry.tail, node, NONE, &mut context.*, 0) {
      let best = match &result {
        Option<Specificity>.Some { value } => maximum(value, entry.specificity)
        _ => entry.specificity
      }
      result = Option<Specificity>.Some { value: best }
    }
    arm = entry.next
  }
  return RecordedMatch { specificity: result, positional: positional }
}

@inlineAlways
fn note(context: &mut MatchContext, bit: u32) -> () {
  context.reads = context.reads | (if context.above { u32.shiftLeft(bit, READS_ABOVE) } else { bit })
}

fn subjectTarget(ast: &SelectorList, compound: usize) -> PseudoTarget {
  return ast.compounds.asSlice()[compound].target
}

effect fn matchesAny<T: ElementTree>(
  ast: &SelectorList,
  buffer: &TokenBuffer,
  tree: &T,
  list: usize,
  node: usize,
  anchor: usize,
  context: &mut MatchContext,
  depth: usize,
) -> bool
  ! CssError {
  run depthLimit(ast, depth)
  let mut arm = list
  while arm != NONE {
    run spend(&mut context.*)
    let entry = &ast.arms.asSlice()[arm]
    if run matchComplex(ast, buffer, tree, entry.tail, node, anchor, &mut context.*, depth) {
      return true
    }
    arm = entry.next
  }
  return false
}

@inlineAlways
effect fn namespaceMatches(
  buffer: &TokenBuffer,
  namespace: Namespace,
  actual: &[u8],
  context: &mut MatchContext,
) -> bool
  ! CssError {
  return namespace.mode == NamespaceMode.Any
    || run equalValue(buffer.text(namespace.uri), actual, false, &mut context.*)
}

effect fn sameType<T: ElementTree>(tree: &T, a: usize, b: usize, context: &mut MatchContext) -> bool
  ! CssError {
  return (run equalValue(
    ElementTree.localName(tree, a),
    ElementTree.localName(tree, b),
    false,
    &mut context.*,
  ))
    && (run equalValue(
      ElementTree.namespaceUri(tree, a),
      ElementTree.namespaceUri(tree, b),
      false,
      &mut context.*,
    ))
}

// Raw parent links include shadow boundaries. Ordinary traversal sees only the
// current scope and its featureless host, never the host's parent or siblings.
fn visible<T: ElementTree>(tree: &T, node: usize, host: usize) -> bool {
  return node != NO_ELEMENT && (node == host || ElementTree.containingHost(tree, node) == host)
}

fn scopedParent<T: ElementTree>(tree: &T, node: usize, host: usize) -> usize {
  if node == host {
    return NO_ELEMENT
  }
  let parent = ElementTree.parent(tree, node)
  return if visible(tree, parent, host) {
    parent
  } else {
    NO_ELEMENT
  }
}

// Providers may link light and shadow children under the same raw parent.
// Filter those lists by tree scope, charging skipped links as matching work.
effect fn scopedSibling<T: ElementTree>(
  tree: &T,
  node: usize,
  forward: bool,
  context: &mut MatchContext,
) -> usize
  ! CssError {
  if node == context.shadowHost {
    return NO_ELEMENT
  }
  let mut sibling = if forward {
    ElementTree.nextSibling(tree, node)
  } else {
    ElementTree.previousSibling(tree, node)
  }
  while sibling != NO_ELEMENT {
    run spend(&mut context.*)
    if sibling == context.shadowHost {
      return NO_ELEMENT
    }
    if ElementTree.containingHost(tree, sibling) == context.shadowHost {
      return sibling
    }
    sibling = if forward {
      ElementTree.nextSibling(tree, sibling)
    } else {
      ElementTree.previousSibling(tree, sibling)
    }
  }
  return NO_ELEMENT
}

effect fn scopedChild<T: ElementTree>(tree: &T, node: usize, context: &mut MatchContext) -> usize
  ! CssError {
  let child = ElementTree.firstChild(tree, node)
  if child == NO_ELEMENT || child == context.shadowHost {
    return NO_ELEMENT
  }
  run spend(&mut context.*)
  if ElementTree.containingHost(tree, child) == context.shadowHost {
    return child
  }
  return run scopedSibling(tree, child, true, &mut context.*)
}

effect fn matchComplex<T: ElementTree>(
  ast: &SelectorList,
  buffer: &TokenBuffer,
  tree: &T,
  index: usize,
  node: usize,
  anchor: usize,
  context: &mut MatchContext,
  depth: usize,
) -> bool
  ! CssError {
  run depthLimit(ast, depth)
  run spend(&mut context.*)
  if !visible(tree, node, context.shadowHost) {
    return false
  }
  let compound = &ast.compounds.asSlice()[index]
  if node == context.shadowHost {
    if !compound.hostEligible {
      return false
    }
  } else {
    if !run namespaceMatches(
      buffer,
      compound.namespace,
      ElementTree.namespaceUri(tree, node),
      &mut context.*,
    ) {
      return false
    }
    if compound.named
      && !run equalValue(
        buffer.text(compound.name),
        ElementTree.localName(tree, node),
        false,
        &mut context.*,
      ) {
      return false
    }
  }
  // Tests that are watched wait until the others pass, so that only elements the rest of the
  // compound selects are reported; `:has()` is also the costliest test.
  let mut watched = false
  let mut simple = compound.first
  while simple != NONE {
    run spend(&mut context.*)
    let entry = &ast.simples.asSlice()[simple]
    if watches(&entry.test) { watched = true }
    else if !run matchTest(ast, buffer, tree, &entry.test, node, &mut context.*, depth + 1) {
      return false
    }
    simple = entry.next
  }
  simple = if watched { compound.first } else { NONE }
  while simple != NONE {
    let entry = &ast.simples.asSlice()[simple]
    if watches(&entry.test) && !run matchTest(ast, buffer, tree, &entry.test, node, &mut context.*, depth + 1) {
      return false
    }
    simple = entry.next
  }
  if compound.previous == NONE {
    if compound.relation == Combinator.None {
      return true
    }
    return run anchored(tree, node, anchor, compound.relation, &mut context.*)
  }
  let siblings = compound.relation == Combinator.Adjacent || compound.relation == Combinator.Sibling
  let below = context.above
  if siblings { note(&mut context.*, READS_SIBLINGS) } else { context.above = true }
  let mut candidate = if siblings {
    run scopedSibling(tree, node, false, &mut context.*)
  } else {
    scopedParent(tree, node, context.shadowHost)
  }
  while candidate != NO_ELEMENT {
    run spend(&mut context.*)
    if run matchComplex(
      ast,
      buffer,
      tree,
      compound.previous,
      candidate,
      anchor,
      &mut context.*,
      depth + 1,
    ) {
      context.above = below
      return true
    }
    if compound.relation == Combinator.Child || compound.relation == Combinator.Adjacent {
      break
    }
    candidate = if siblings {
      run scopedSibling(tree, candidate, false, &mut context.*)
    } else {
      scopedParent(tree, candidate, context.shadowHost)
    }
  }
  context.above = below
  return false
}

effect fn anchored<T: ElementTree>(
  tree: &T,
  node: usize,
  anchor: usize,
  relation: Combinator,
  context: &mut MatchContext,
) -> bool
  ! CssError {
  if anchor == NO_ELEMENT {
    return false
  }
  let siblings = relation == Combinator.Adjacent || relation == Combinator.Sibling
  let mut candidate = if siblings {
    run scopedSibling(tree, node, false, &mut context.*)
  } else {
    scopedParent(tree, node, context.shadowHost)
  }
  while candidate != NO_ELEMENT {
    run spend(&mut context.*)
    if candidate == anchor {
      return true
    }
    if relation == Combinator.Child || relation == Combinator.Adjacent {
      return false
    }
    candidate = if siblings {
      run scopedSibling(tree, candidate, false, &mut context.*)
    } else {
      scopedParent(tree, candidate, context.shadowHost)
    }
  }
  return false
}

fn watches(test: &Test) -> bool {
  return match &test.* {
    Test.Function { kind, .. } => kind == FunctionKind.Has
    Test.State { pseudo } => pseudo == Pseudo.FocusWithin
    _ => false
  }
}

/// Whether an arm of the relative selector list `list` starts with `+` or `~`.
fn readsSiblings(ast: &SelectorList, list: usize) -> bool {
  let mut arm = list
  while arm != NONE {
    let entry = &ast.arms.asSlice()[arm]
    let mut compound = &ast.compounds.asSlice()[entry.tail]
    while compound.previous != NONE { compound = &ast.compounds.asSlice()[compound.previous] }
    if compound.relation == Combinator.Adjacent || compound.relation == Combinator.Sibling { return true }
    arm = entry.next
  }
  return false
}

// Relative selectors are evaluated right-to-left against candidates in the anchor's own
// subtree and, when an argument starts with `+` or `~` (`siblings`), in its following
// siblings' subtrees: no other argument can match there. Traversal is iterative and allocation-free.
// Testing the left edge against the anchor prevents unrelated descendants from matching.
effect fn hasRelative<T: ElementTree>(
  ast: &SelectorList,
  buffer: &TokenBuffer,
  tree: &T,
  list: usize,
  anchor: usize,
  siblings: bool,
  context: &mut MatchContext,
  depth: usize,
) -> bool
  ! CssError {
  let mut subtree = anchor
  while subtree != NO_ELEMENT {
    let mut candidate = subtree
    while candidate != NO_ELEMENT {
      run spend(&mut context.*)
      if candidate != anchor
        && run matchesAny(ast, buffer, tree, list, candidate, anchor, &mut context.*, depth) {
        return true
      }
      let child = run scopedChild(tree, candidate, &mut context.*)
      if child != NO_ELEMENT {
        candidate = child
      } else {
        let mut next = NO_ELEMENT
        while candidate != subtree {
          next = run scopedSibling(tree, candidate, true, &mut context.*)
          if next != NO_ELEMENT {
            break
          }
          run spend(&mut context.*)
          candidate = scopedParent(tree, candidate, context.shadowHost)
          if candidate == NO_ELEMENT {
            return false
          }
        }
        candidate = next
      }
    }
    if !siblings { return false }
    subtree = run scopedSibling(tree, subtree, true, &mut context.*)
  }
  return false
}

// Evaluate each host argument in that element's own tree scope. Only the small
// context record is local: the budget is returned even when matching raises.
// The caller's scope/target/host never change, including during error unwinding.
effect fn matchNormal<T: ElementTree>(
  ast: &SelectorList,
  buffer: &TokenBuffer,
  tree: &T,
  list: usize,
  node: usize,
  context: &mut MatchContext,
  depth: usize,
) -> bool
  ! CssError {
  let mut normal = MatchContext.make(context.scope, context.target)
  normal.shadowHost = ElementTree.containingHost(tree, node)
  normal.remainingSteps = context.remainingSteps
  let result = run Effect.result(
    matchesAny(ast, buffer, tree, list, node, NONE, &mut normal, depth),
  )
  context.remainingSteps = normal.remainingSteps
  context.reads = context.reads | normal.reads
  let nested = normal.watched()
  let mut at: usize = 0
  while at < nested.length {
    context.watch(nested[at].node, nested[at].bits)
    at = at + 1
  }
  if normal.watchOverflow { context.watchOverflow = true }
  match &result {
    Result<bool, CssError>.Success { value } => {
      return value
    }
    Result<bool, CssError>.Failure { error } => {
      fail CssError { kind: error.kind, offset: error.offset }
    }
  }
}

effect fn matchTest<T: ElementTree>(
  ast: &SelectorList,
  buffer: &TokenBuffer,
  tree: &T,
  test: &Test,
  node: usize,
  context: &mut MatchContext,
  depth: usize,
) -> bool
  ! CssError {
  match &test.* {
    Test.Id { text } => {
      let count = ElementTree.attributeCount(tree, node)
      let mut i: usize = 0
      while i < count {
        run spend(&mut context.*)
        if ElementTree.attributeIsId(tree, node, i)
          && (run equalValue(
            ElementTree.attributeValue(tree, node, i),
            buffer.text(text),
            false,
            &mut context.*,
          )) {
          return true
        }
        i = i + 1
      }
      return false
    }
    Test.Class { text } => {
      return run namedAttribute(
        buffer,
        tree,
        node,
        b"class",
        buffer.text(text),
        AttributeOp.Word,
        &mut context.*,
      )
    }
    Test.Attribute { namespace, name, value, op, insensitive } => {
      let count = ElementTree.attributeCount(tree, node)
      let mut i: usize = 0
      while i < count {
        run spend(&mut context.*)
        if (run namespaceMatches(
          buffer,
          namespace,
          ElementTree.attributeNamespace(tree, node, i),
          &mut context.*,
        ))
          && (run equalValue(
            buffer.text(name),
            ElementTree.attributeName(tree, node, i),
            false,
            &mut context.*,
          ))
          && (run attributeMatches(
            ElementTree.attributeValue(tree, node, i),
            buffer.text(value),
            op,
            insensitive,
            &mut context.*,
          )) {
          return true
        }
        i = i + 1
      }
      return false
    }
    Test.State { pseudo: state } => {
      return run matchState(tree, node, state, &mut context.*)
    }
    Test.Element { target } => { return target == context.pseudo }
    Test.ElementState { pseudo } => {
      let mask = stateMask(pseudo)
      return mask != 0 && context.pseudo != PseudoTarget.None && context.pseudoStates.contains(mask)
    }
    Test.Function { kind, list } => {
      if kind == FunctionKind.Host || kind == FunctionKind.HostContext {
        if context.shadowHost == NO_ELEMENT || node != context.shadowHost {
          return false
        }
        let mut candidate = node
        while candidate != NO_ELEMENT {
          run spend(&mut context.*)
          if run matchNormal(ast, buffer, tree, list, candidate, &mut context.*, depth) {
            return true
          }
          if kind == FunctionKind.Host {
            return false
          }
          candidate = ElementTree.parent(tree, candidate)
        }
        return false
      }
      if kind == FunctionKind.Has {
        note(&mut context.*, READS_DESCENDANTS)
        let siblings = readsSiblings(ast, list)
        context.watch(node, if siblings { element.WATCH_HAS | element.WATCH_HAS_SIBLINGS } else { element.WATCH_HAS })
        // The argument's own steps climb from a descendant: they are not about ancestors.
        let below = context.above
        let found = run hasRelative(ast, buffer, tree, list, node, siblings, &mut context.*, depth)
        context.above = below
        return found
      }
      let matched = run matchesAny(ast, buffer, tree, list, node, NONE, &mut context.*, depth)
      return if kind == FunctionKind.Not {
        !matched
      } else {
        matched
      }
    }
    Test.Nth { a, b, reverse, ofType, list } => {
      note(&mut context.*, READS_INDEX)
      if list != NONE
        && !run matchesAny(ast, buffer, tree, list, node, NONE, &mut context.*, depth) {
        return false
      }
      let mut count: usize = 1
      let mut candidate = if reverse {
        run scopedSibling(tree, node, true, &mut context.*)
      } else {
        run scopedSibling(tree, node, false, &mut context.*)
      }
      while candidate != NO_ELEMENT {
        run spend(&mut context.*)
        if (!ofType || run sameType(tree, node, candidate, &mut context.*))
          && (list == NONE
            || run matchesAny(ast, buffer, tree, list, candidate, NONE, &mut context.*, depth)) {
          count = count + 1
        }
        candidate = if reverse {
          run scopedSibling(tree, candidate, true, &mut context.*)
        } else {
          run scopedSibling(tree, candidate, false, &mut context.*)
        }
      }
      let difference = usize.toF64(count) - b
      if a == 0.0 {
        return difference == 0.0
      }
      let quotient = difference / a
      return quotient >= 0.0 && quotient == i64.toF64(f64.toI64(quotient))
    }
    Test.Language { range } => {
      let actual = ElementTree.language(tree, node)
      let mut at = range.start
      while at < range.end {
        run spend(&mut context.*)
        match &buffer.tokens.asSlice()[at].kind {
          Kind.Ident { text } => {
            if run languageMatches(actual, buffer.text(text), &mut context.*) {
              return true
            }
          }
          Kind.String { text } => {
            if run languageMatches(actual, buffer.text(text), &mut context.*) {
              return true
            }
          }
          _ => {}
        }
        at = at + 1
      }
      return false
    }
  }
}

effect fn namedAttribute<T: ElementTree>(
  buffer: &TokenBuffer,
  tree: &T,
  node: usize,
  name: &[u8],
  value: &[u8],
  op: AttributeOp,
  context: &mut MatchContext,
) -> bool
  ! CssError {
  let count = ElementTree.attributeCount(tree, node)
  let mut i: usize = 0
  while i < count {
    run spend(&mut context.*)
    let attribute = ElementTree.attribute(tree, node, i)
    if attribute.namespace.length == 0
      && (run equalValue(attribute.name, name, false, &mut context.*))
      && (run attributeMatches(attribute.value, value, op, false, &mut context.*)) {
      return true
    }
    i = i + 1
  }
  return false
}

fn asciiSpace(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 12
}

fn fold(byte: u8) -> u8 {
  return if byte >= 65 && byte <= 90 {
    byte + 32
  } else {
    byte
  }
}

effect fn equalValue(a: &[u8], b: &[u8], insensitive: bool, context: &mut MatchContext) -> bool
  ! CssError {
  if a.length != b.length {
    return false
  }

  // One charge for the bytes compared: the same steps, and the same limit,
  // as charging each byte before comparing it.
  let mut i: usize = 0
  if insensitive {
    while i < a.length && fold(a[i]) == fold(b[i]) {
      i = i + 1
    }
  } else {
    // Equal values of 16 to 32 bytes (namespace URIs) settle with two overlapping blocks.
    // Any difference falls through to find its position for the charge.
    if a.length >= 16 && a.length <= 32
      && mask16.all(u8x16.lanesEqual(u8x16.load(a, 0), u8x16.load(b, 0)))
      && mask16.all(u8x16.lanesEqual(u8x16.load(a, a.length - 16), u8x16.load(b, a.length - 16))) {
      run context.spend(a.length)
      return true
    }

    // Sixteen bytes at a time up to the first differing block (namespace URIs are long and
    // share their prefix), then bytewise to the first difference.
    while i + 16 <= a.length && mask16.all(u8x16.lanesEqual(u8x16.load(a, i), u8x16.load(b, i))) {
      i = i + 16
    }
    while i < a.length && a[i] == b[i] {
      i = i + 1
    }
  }
  if i < a.length {
    run context.spend(i + 1)
    return false
  }
  run context.spend(a.length)
  return true
}

effect fn attributeMatches(
  actual: &[u8],
  expected: &[u8],
  op: AttributeOp,
  insensitive: bool,
  context: &mut MatchContext,
) -> bool
  ! CssError {
  if op == AttributeOp.Present {
    return true
  }
  if op == AttributeOp.Equal {
    return run equalValue(actual, expected, insensitive, &mut context.*)
  }
  if op == AttributeOp.Hyphen {
    if run equalValue(actual, expected, insensitive, &mut context.*) {
      return true
    }
    return actual.length > expected.length && actual[expected.length] == 45
      && run equalValue(
        Slice.view<u8>(actual, 0, expected.length),
        expected,
        insensitive,
        &mut context.*,
      )
  }
  if expected.length == 0 || expected.length > actual.length {
    return false
  }
  if op == AttributeOp.Prefix {
    return run equalValue(
      Slice.view<u8>(actual, 0, expected.length),
      expected,
      insensitive,
      &mut context.*,
    )
  }
  if op == AttributeOp.Suffix {
    return run equalValue(
      Slice.view<u8>(actual, actual.length - expected.length, expected.length),
      expected,
      insensitive,
      &mut context.*,
    )
  }
  if op == AttributeOp.Word {
    let mut at: usize = 0
    while at < actual.length {
      run spend(&mut context.*)
      if asciiSpace(actual[at]) {
        at = at + 1
      } else {
        let start = at
        while at < actual.length && !asciiSpace(actual[at]) {
          run spend(&mut context.*)
          at = at + 1
        }
        if run equalValue(
          Slice.view<u8>(actual, start, at - start),
          expected,
          insensitive,
          &mut context.*,
        ) {
          return true
        }
      }
    }
    return false
  }
  let mut at: usize = 0
  while at <= actual.length - expected.length {
    run spend(&mut context.*)
    if run equalValue(
      Slice.view<u8>(actual, at, expected.length),
      expected,
      insensitive,
      &mut context.*,
    ) {
      return true
    }
    at = at + 1
  }
  return false
}

// HTML directionality from the nearest `dir` attribute; `auto` and unknown values defer to
// the parent, and the root default is left to right.
// https://html.spec.whatwg.org/multipage/dom.html#the-directionality
effect fn rightToLeft<T: ElementTree>(tree: &T, node: usize, context: &mut MatchContext) -> bool
  ! CssError {
  let mut at = node
  while at != NO_ELEMENT {
    run spend(&mut context.*)
    let count = ElementTree.attributeCount(tree, at)
    let mut i: usize = 0
    while i < count {
      let attribute = ElementTree.attribute(tree, at, i)
      if attribute.namespace.length == 0 && tokens.insensitive(attribute.name, b"dir") {
        if tokens.insensitive(attribute.value, b"rtl") { return true }
        if tokens.insensitive(attribute.value, b"ltr") { return false }
      }
      i = i + 1
    }
    at = ElementTree.parent(tree, at)
  }
  return false
}

fn stateMask(state: Pseudo) -> u32 {
  return match state {
    Pseudo.Hover => element.HOVER
    Pseudo.Active => element.ACTIVE
    Pseudo.Focus => element.FOCUS
    Pseudo.FocusVisible => element.FOCUS_VISIBLE
    Pseudo.FocusWithin => element.FOCUS_WITHIN
    Pseudo.Disabled => element.DISABLED
    Pseudo.Enabled => element.ENABLED
    Pseudo.Checked => element.CHECKED
    Pseudo.Indeterminate => element.INDETERMINATE
    Pseudo.PlaceholderShown => element.PLACEHOLDER_SHOWN
    Pseudo.ReadOnly => element.READ_ONLY
    Pseudo.ReadWrite => element.READ_WRITE
    Pseudo.Required => element.REQUIRED
    Pseudo.Optional => element.OPTIONAL
    Pseudo.Open => element.OPEN
    Pseudo.PopoverOpen => element.POPOVER_OPEN
    Pseudo.Default => element.DEFAULT
    Pseudo.InRange => element.IN_RANGE
    Pseudo.OutOfRange => element.OUT_OF_RANGE
    _ => 0
  }
}

effect fn matchState<T: ElementTree>(
  tree: &T,
  node: usize,
  state: Pseudo,
  context: &mut MatchContext,
) -> bool
  ! CssError {
  if state == Pseudo.Host {
    return context.shadowHost != NO_ELEMENT && node == context.shadowHost
  }
  if state == Pseudo.Root {
    return ElementTree.isRoot(tree, node)
  }
  if state == Pseudo.Empty {
    note(&mut context.*, READS_EMPTY)
    return ElementTree.isEmpty(tree, node)
  }
  if state == Pseudo.Scope {
    return node == context.scope
  }
  if state == Pseudo.Target {
    return node == context.target
  }
  if state == Pseudo.Link {
    return ElementTree.isLink(tree, node)
  }
  if state == Pseudo.Never {
    return false
  }
  if state == Pseudo.DirLtr || state == Pseudo.DirRtl {
    let rtl = run rightToLeft(tree, node, &mut context.*)
    return if state == Pseudo.DirRtl { rtl } else { !rtl }
  }
  let mask = stateMask(state)
  if mask != 0 {
    if state == Pseudo.FocusWithin { context.watch(node, element.WATCH_FOCUS_WITHIN) }
    return ElementTree.state(tree, node).contains(mask)
  }
  let typed = state == Pseudo.FirstType || state == Pseudo.LastType || state == Pseudo.OnlyType
  let first = state == Pseudo.FirstChild || state == Pseudo.OnlyChild || state == Pseudo.FirstType
    || state == Pseudo.OnlyType
  let last = state == Pseudo.LastChild || state == Pseudo.OnlyChild || state == Pseudo.LastType
    || state == Pseudo.OnlyType
  if first || last { note(&mut context.*, if typed { READS_INDEX } else { READS_EDGE }) }
  if first {
    let mut candidate = run scopedSibling(tree, node, false, &mut context.*)
    while candidate != NO_ELEMENT {
      run spend(&mut context.*)
      if !typed || run sameType(tree, node, candidate, &mut context.*) {
        return false
      }
      candidate = run scopedSibling(tree, candidate, false, &mut context.*)
    }
  }
  if last {
    let mut candidate = run scopedSibling(tree, node, true, &mut context.*)
    while candidate != NO_ELEMENT {
      run spend(&mut context.*)
      if !typed || run sameType(tree, node, candidate, &mut context.*) {
        return false
      }
      candidate = run scopedSibling(tree, candidate, true, &mut context.*)
    }
  }
  return true
}

effect fn subtagEnd(text: &[u8], at: usize, context: &mut MatchContext) -> usize
  ! CssError {
  let mut end = at
  while end < text.length && text[end] != 45 {
    run spend(&mut context.*)
    end = end + 1
  }
  return end
}

// RFC4647 extended filtering, required by Selectors4 #lang-pseudo.
effect fn languageMatches(language: &[u8], range: &[u8], context: &mut MatchContext) -> bool
  ! CssError {
  if range.length == 0 {
    return language.length == 0
  }
  if language.length == 0 {
    return false
  }
  let mut r: usize = 0
  let mut l: usize = 0
  let firstRange = run subtagEnd(range, 0, &mut context.*)
  let firstLanguage = run subtagEnd(language, 0, &mut context.*)
  if !(firstRange == 1 && range[0] == 42)
    && !run equalValue(
      Slice.view<u8>(range, 0, firstRange),
      Slice.view<u8>(language, 0, firstLanguage),
      true,
      &mut context.*,
    ) {
    return false
  }
  r = firstRange
  l = firstLanguage
  while r < range.length {
    run spend(&mut context.*)
    r = r + 1
    let end = run subtagEnd(range, r, &mut context.*)
    if end == r {
      return false
    }
    if end == r + 1 && range[r] == 42 {
      r = end
    } else {
      let mut found = false
      while l < language.length {
        run spend(&mut context.*)
        l = l + 1
        let languageEnd = run subtagEnd(language, l, &mut context.*)
        if run equalValue(
          Slice.view<u8>(range, r, end - r),
          Slice.view<u8>(language, l, languageEnd - l),
          true,
          &mut context.*,
        ) {
          l = languageEnd
          found = true
          break
        }
        if languageEnd - l == 1 {
          return false
        }
        l = languageEnd
      }
      if !found {
        return false
      }
      r = end
    }
  }
  return true
}

effect fn writeNamespaceMode(writer: &mut BinaryWriter, value: NamespaceMode) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writer.byte(match value {
    NamespaceMode.Any => 0
    NamespaceMode.Exact => 1
  })
}

effect fn readNamespaceMode(reader: &mut BinaryReader<'_>) -> NamespaceMode
  ! DecodeError {
  return match run reader.byte() {
    0 => NamespaceMode.Any
    1 => NamespaceMode.Exact
    _ => { fail DecodeError { reason: DecodeReason.Invalid, offset: reader.at } }
  }
}

effect fn writeCombinator(writer: &mut BinaryWriter, value: Combinator) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writer.byte(match value {
    Combinator.None => 0
    Combinator.Descendant => 1
    Combinator.Child => 2
    Combinator.Adjacent => 3
    Combinator.Sibling => 4
  })
}

effect fn readCombinator(reader: &mut BinaryReader<'_>) -> Combinator
  ! DecodeError {
  return match run reader.byte() {
    0 => Combinator.None
    1 => Combinator.Descendant
    2 => Combinator.Child
    3 => Combinator.Adjacent
    4 => Combinator.Sibling
    _ => { fail DecodeError { reason: DecodeReason.Invalid, offset: reader.at } }
  }
}

effect fn writeAttributeOp(writer: &mut BinaryWriter, value: AttributeOp) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writer.byte(match value {
    AttributeOp.Present => 0
    AttributeOp.Equal => 1
    AttributeOp.Word => 2
    AttributeOp.Hyphen => 3
    AttributeOp.Prefix => 4
    AttributeOp.Suffix => 5
    AttributeOp.Contains => 6
  })
}

effect fn readAttributeOp(reader: &mut BinaryReader<'_>) -> AttributeOp
  ! DecodeError {
  return match run reader.byte() {
    0 => AttributeOp.Present
    1 => AttributeOp.Equal
    2 => AttributeOp.Word
    3 => AttributeOp.Hyphen
    4 => AttributeOp.Prefix
    5 => AttributeOp.Suffix
    6 => AttributeOp.Contains
    _ => { fail DecodeError { reason: DecodeReason.Invalid, offset: reader.at } }
  }
}

effect fn writePseudo(writer: &mut BinaryWriter, value: Pseudo) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writer.byte(match value {
    Pseudo.Host => 0
    Pseudo.Root => 1
    Pseudo.Empty => 2
    Pseudo.Scope => 3
    Pseudo.Target => 4
    Pseudo.Link => 5
    Pseudo.Never => 6
    Pseudo.Hover => 7
    Pseudo.Active => 8
    Pseudo.Focus => 9
    Pseudo.FocusVisible => 10
    Pseudo.FocusWithin => 11
    Pseudo.Disabled => 12
    Pseudo.Enabled => 13
    Pseudo.Checked => 14
    Pseudo.Indeterminate => 15
    Pseudo.PlaceholderShown => 16
    Pseudo.ReadOnly => 17
    Pseudo.ReadWrite => 18
    Pseudo.Required => 19
    Pseudo.Optional => 20
    Pseudo.Open => 21
    Pseudo.PopoverOpen => 22
    Pseudo.FirstChild => 23
    Pseudo.LastChild => 24
    Pseudo.OnlyChild => 25
    Pseudo.FirstType => 26
    Pseudo.LastType => 27
    Pseudo.OnlyType => 28
    Pseudo.DirLtr => 29
    Pseudo.DirRtl => 30
    Pseudo.Default => 31
    Pseudo.InRange => 32
    Pseudo.OutOfRange => 33
  })
}

effect fn readPseudo(reader: &mut BinaryReader<'_>) -> Pseudo
  ! DecodeError {
  return match run reader.byte() {
    0 => Pseudo.Host
    1 => Pseudo.Root
    2 => Pseudo.Empty
    3 => Pseudo.Scope
    4 => Pseudo.Target
    5 => Pseudo.Link
    6 => Pseudo.Never
    7 => Pseudo.Hover
    8 => Pseudo.Active
    9 => Pseudo.Focus
    10 => Pseudo.FocusVisible
    11 => Pseudo.FocusWithin
    12 => Pseudo.Disabled
    13 => Pseudo.Enabled
    14 => Pseudo.Checked
    15 => Pseudo.Indeterminate
    16 => Pseudo.PlaceholderShown
    17 => Pseudo.ReadOnly
    18 => Pseudo.ReadWrite
    19 => Pseudo.Required
    20 => Pseudo.Optional
    21 => Pseudo.Open
    22 => Pseudo.PopoverOpen
    23 => Pseudo.FirstChild
    24 => Pseudo.LastChild
    25 => Pseudo.OnlyChild
    26 => Pseudo.FirstType
    27 => Pseudo.LastType
    28 => Pseudo.OnlyType
    29 => Pseudo.DirLtr
    30 => Pseudo.DirRtl
    31 => Pseudo.Default
    32 => Pseudo.InRange
    33 => Pseudo.OutOfRange
    _ => { fail DecodeError { reason: DecodeReason.Invalid, offset: reader.at } }
  }
}

effect fn writeFunctionKind(writer: &mut BinaryWriter, value: FunctionKind) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writer.byte(match value {
    FunctionKind.Is => 0
    FunctionKind.Not => 1
    FunctionKind.Has => 2
    FunctionKind.Host => 3
    FunctionKind.HostContext => 4
  })
}

effect fn readFunctionKind(reader: &mut BinaryReader<'_>) -> FunctionKind
  ! DecodeError {
  return match run reader.byte() {
    0 => FunctionKind.Is
    1 => FunctionKind.Not
    2 => FunctionKind.Has
    3 => FunctionKind.Host
    4 => FunctionKind.HostContext
    _ => { fail DecodeError { reason: DecodeReason.Invalid, offset: reader.at } }
  }
}

effect fn writeNamespace(writer: &mut BinaryWriter, buffer: &TokenBuffer, value: &Namespace) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writeNamespaceMode(&mut writer.*, value.mode)
  run writer.data(buffer.text(value.uri))
}

effect fn readNamespace(reader: &mut BinaryReader<'_>, buffer: &mut TokenBuffer) -> Namespace
  ! DecodeError | OutOfMemoryError ? &mut Allocator {
  return Namespace {
    mode: run readNamespaceMode(&mut reader.*),
    uri: run sheet_tokens.readText(&mut reader.*, &mut buffer.*),
  }
}

effect fn writeSpecificity(writer: &mut BinaryWriter, buffer: &TokenBuffer, value: &Specificity) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writer.index(value.ids)
  run writer.index(value.classes)
  run writer.index(value.types)
}

effect fn readSpecificity(reader: &mut BinaryReader<'_>, buffer: &mut TokenBuffer) -> Specificity
  ! DecodeError | OutOfMemoryError ? &mut Allocator {
  return Specificity {
    ids: run reader.index(),
    classes: run reader.index(),
    types: run reader.index(),
  }
}

effect fn writeTokenRange(writer: &mut BinaryWriter, buffer: &TokenBuffer, value: &TokenRange) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writer.index(value.start)
  run writer.index(value.end)
}

effect fn readTokenRange(reader: &mut BinaryReader<'_>, buffer: &mut TokenBuffer) -> TokenRange
  ! DecodeError | OutOfMemoryError ? &mut Allocator {
  return TokenRange {
    start: run reader.index(),
    end: run reader.index(),
  }
}

effect fn writeSimple(writer: &mut BinaryWriter, buffer: &TokenBuffer, value: &Simple) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writeTest(&mut writer.*, buffer, &value.test)
  run writer.index(value.next)
}

effect fn readSimple(reader: &mut BinaryReader<'_>, buffer: &mut TokenBuffer) -> Simple
  ! DecodeError | OutOfMemoryError ? &mut Allocator {
  return Simple {
    test: run readTest(&mut reader.*, &mut buffer.*),
    next: run reader.index(),
  }
}

effect fn writeCompound(writer: &mut BinaryWriter, buffer: &TokenBuffer, value: &Compound) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writeNamespace(&mut writer.*, buffer, &value.namespace)
  run writer.data(buffer.text(value.name))
  run writer.flag(value.named)
  run writer.flag(value.explicitType)
  run writer.flag(value.hostEligible)
  run writer.index(value.first)
  run writer.index(value.previous)
  run writeCombinator(&mut writer.*, value.relation)
}

effect fn readCompound(reader: &mut BinaryReader<'_>, buffer: &mut TokenBuffer, targets: &[PseudoTarget]) -> Compound
  ! DecodeError | OutOfMemoryError ? &mut Allocator {
  let mut result = Compound {
    target: PseudoTarget.None,
    namespace: run readNamespace(&mut reader.*, &mut buffer.*),
    name: run sheet_tokens.readText(&mut reader.*, &mut buffer.*),
    named: run reader.flag(),
    explicitType: run reader.flag(),
    hostEligible: run reader.flag(),
    first: run reader.index(),
    previous: run reader.index(),
    relation: run readCombinator(&mut reader.*),
  }
  if result.first != NONE {
    if result.first >= targets.length { run reader.invalid() }
    result.target = targets[result.first]
  }
  return result
}

effect fn writeArm(writer: &mut BinaryWriter, buffer: &TokenBuffer, value: &Arm) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run writer.index(value.tail)
  run writer.index(value.next)
  run writeSpecificity(&mut writer.*, buffer, &value.specificity)
}

effect fn readArm(reader: &mut BinaryReader<'_>, buffer: &mut TokenBuffer) -> Arm
  ! DecodeError | OutOfMemoryError ? &mut Allocator {
  return Arm {
    tail: run reader.index(),
    next: run reader.index(),
    specificity: run readSpecificity(&mut reader.*, &mut buffer.*),
  }
}

effect fn writeTest(writer: &mut BinaryWriter, buffer: &TokenBuffer, test: &Test) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  match &test.* {
    Test.Id { text } => {
      run writer.byte(0)
      run writer.data(buffer.text(text))
    }
    Test.Class { text } => {
      run writer.byte(1)
      run writer.data(buffer.text(text))
    }
    Test.Attribute { namespace, name, value, op, insensitive } => {
      run writer.byte(2)
      run writeNamespace(&mut writer.*, buffer, &namespace)
      run writer.data(buffer.text(name))
      run writer.data(buffer.text(value))
      run writeAttributeOp(&mut writer.*, op)
      run writer.flag(insensitive)
    }
    Test.State { pseudo } => {
      run writer.byte(3)
      run writePseudo(&mut writer.*, pseudo)
    }
    Test.Function { kind, list } => {
      run writer.byte(4)
      run writeFunctionKind(&mut writer.*, kind)
      run writer.index(list)
    }
    Test.Nth { a, b, reverse, ofType, list } => {
      run writer.byte(5)
      run writer.number(a)
      run writer.number(b)
      run writer.flag(reverse)
      run writer.flag(ofType)
      run writer.index(list)
    }
    Test.Language { range } => {
      run writer.byte(6)
      run writeTokenRange(&mut writer.*, buffer, &range)
    }
    Test.Element { target } => {
      run writer.byte(7)
      run writer.byte(match target { PseudoTarget.None => 0 PseudoTarget.Before => 1 PseudoTarget.After => 2
        PseudoTarget.Placeholder => 3 PseudoTarget.Selection => 4 PseudoTarget.Scrollbar => 5
        PseudoTarget.ScrollbarThumb => 6 PseudoTarget.ScrollbarTrack => 7 })
    }
    Test.ElementState { pseudo } => {
      run writer.byte(8)
      run writePseudo(&mut writer.*, pseudo)
    }
  }
}

effect fn readTest(reader: &mut BinaryReader<'_>, buffer: &mut TokenBuffer) -> Test
  ! DecodeError | OutOfMemoryError ? &mut Allocator {
  return match run reader.byte() {
    0 => Test.Id { text: run sheet_tokens.readText(&mut reader.*, &mut buffer.*) }
    1 => Test.Class { text: run sheet_tokens.readText(&mut reader.*, &mut buffer.*) }
    2 => Test.Attribute { namespace: run readNamespace(&mut reader.*, &mut buffer.*), name: run sheet_tokens.readText(&mut reader.*, &mut buffer.*), value: run sheet_tokens.readText(&mut reader.*, &mut buffer.*), op: run readAttributeOp(&mut reader.*), insensitive: run reader.flag() }
    3 => Test.State { pseudo: run readPseudo(&mut reader.*) }
    4 => Test.Function { kind: run readFunctionKind(&mut reader.*), list: run reader.index() }
    5 => Test.Nth { a: run reader.number(), b: run reader.number(), reverse: run reader.flag(), ofType: run reader.flag(), list: run reader.index() }
    6 => Test.Language { range: run readTokenRange(&mut reader.*, &mut buffer.*) }
    7 => Test.Element { target: match run reader.byte() {
      1 => PseudoTarget.Before
      2 => PseudoTarget.After
      3 => PseudoTarget.Placeholder
      4 => PseudoTarget.Selection
      5 => PseudoTarget.Scrollbar
      6 => PseudoTarget.ScrollbarThumb
      7 => PseudoTarget.ScrollbarTrack
      _ => { fail DecodeError { reason: DecodeReason.Invalid, offset: reader.at } }
    } }
    8 => Test.ElementState { pseudo: run readPseudo(&mut reader.*) }
    _ => { fail DecodeError { reason: DecodeReason.Invalid, offset: reader.at } }
  }
}

impl SelectorList {
  /// Writes a matcher program. The enclosing sheet supplies its version and catalog fingerprint.
  pub effect fn encodeProgram(self: &Self, buffer: &TokenBuffer, writer: &mut BinaryWriter) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    run writer.index(self.head)
    run writer.index(self.maxDepth)
    run writer.flag(self.validationOnly)
    run writer.index(self.simples.length())
    let mut simplesAt: usize = 0
    while simplesAt < self.simples.length() {
      run writeSimple(&mut writer.*, buffer, &self.simples.asSlice()[simplesAt])
      simplesAt = simplesAt + 1
    }
    run writer.index(self.compounds.length())
    let mut compoundsAt: usize = 0
    while compoundsAt < self.compounds.length() {
      run writeCompound(&mut writer.*, buffer, &self.compounds.asSlice()[compoundsAt])
      compoundsAt = compoundsAt + 1
    }
    run writer.index(self.arms.length())
    let mut armsAt: usize = 0
    while armsAt < self.arms.length() {
      run writeArm(&mut writer.*, buffer, &self.arms.asSlice()[armsAt])
      armsAt = armsAt + 1
    }
  }

  /// Reads a matcher program without invoking the tokenizer or selector parser.
  /// Decoded text is appended to buffer; language ranges address its existing token stream.
  pub effect fn decodeProgram(reader: &mut BinaryReader<'_>, buffer: &mut TokenBuffer, limits: &Limits) -> SelectorList
    ! DecodeError | OutOfMemoryError ? &mut Allocator {
    let head = run reader.index()
    let maxDepth = run reader.index()
    let validationOnly = run reader.flag()
    if maxDepth > limits.maxDepth || validationOnly { run reader.invalid() }
    let simplesCount = run reader.count(limits.maxTokens)
    let mut simples = List<Simple>.make()
    let mut targets = List<PseudoTarget>.make()
    let mut simplesAt: usize = 0
    while simplesAt < simplesCount {
      let simple = run readSimple(&mut reader.*, &mut buffer.*)
      if simple.next != NONE && simple.next >= simplesAt { run reader.invalid() }
      let target = match simple.test {
        Test.Element { target } => target
        _ => if simple.next == NONE { PseudoTarget.None } else { targets.asSlice()[simple.next] }
      }
      run targets.append(target)
      run simples.append(simple)
      simplesAt = simplesAt + 1
    }
    let compoundsCount = run reader.count(limits.maxTokens)
    let mut compounds = List<Compound>.make()
    let mut compoundsAt: usize = 0
    while compoundsAt < compoundsCount {
      run compounds.append(run readCompound(&mut reader.*, &mut buffer.*, targets.asSlice()))
      compoundsAt = compoundsAt + 1
    }
    let armsCount = run reader.count(limits.maxTokens)
    let mut arms = List<Arm>.make()
    let mut armsAt: usize = 0
    while armsAt < armsCount {
      run arms.append(run readArm(&mut reader.*, &mut buffer.*))
      armsAt = armsAt + 1
    }
    let result = SelectorList {
      simples: move simples, compounds: move compounds, arms: move arms,
      head: head, maxDepth: maxDepth, validationOnly: false,
    }
    if !result.validProgram(&buffer.*) { run reader.invalid() }
    return move result
  }

  fn validProgram(self: &Self, buffer: &TokenBuffer) -> bool {
    if self.head >= self.arms.length() { return false }
    let mut i: usize = 0
    while i < self.simples.length() {
      let simple = self.simples.asSlice()[i]
      if simple.next != NONE && simple.next >= i { return false }
      match &simple.test {
        Test.Function { list, .. } => {
          if list != NONE && list >= self.arms.length() { return false }
        }
        Test.Nth { list, .. } => {
          if list != NONE && list >= self.arms.length() { return false }
        }
        Test.Language { range } => {
          if range.start > range.end || range.end > buffer.all().end { return false }
        }
        _ => {}
      }
      i = i + 1
    }
    i = 0
    while i < self.compounds.length() {
      let compound = self.compounds.asSlice()[i]
      if compound.first != NONE && compound.first >= self.simples.length() { return false }
      if compound.previous != NONE && compound.previous >= i { return false }
      i = i + 1
    }
    i = 0
    while i < self.arms.length() {
      let arm = self.arms.asSlice()[i]
      if arm.tail >= self.compounds.length() { return false }
      if arm.next != NONE && (arm.next <= i || arm.next >= self.arms.length()) { return false }
      i = i + 1
    }
    return true
  }
}

//! Selector tests use the real tokenizer and parser and an element-only host tree.
import sheet_binary { Writer, Reader, DecodeError }
import sheet_tokens
import selectors { SelectorList, Specificity, NamespaceBinding, DependencyKind }
import selectors
import lexer
import tokens
import tokens { Limits, CssError, CssErrorKind, Span, TokenRange }
import element
import element { ElementTree, MatchContext, PseudoTarget, StateBits, NO_ELEMENT, AttributeText }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u32

// svg(0) > g(1) > rect(2), circle(3), rect(4); svg > foreign rect(5).
// The host reports whitespace-only content at 2, but non-whitespace text at 4.
// Both have no element children: :empty must use host semantics, not firstChild.
struct Tree { states: u32 }

impl ElementTree for Tree {
  fn state(self: &Self, node: usize) -> element.StateBits {
    return element.StateBits { bits: if node == 2 { self.states } else { 0 } }
  }

  fn containingHost(self: &Self, node: usize) -> usize {
    return NO_ELEMENT
  }

  fn parent(self: &Self, node: usize) -> usize {
    if node == 0 {
      return NO_ELEMENT
    }
    return if node == 1 || node == 5 {
      0
    } else {
      1
    }
  }

  fn firstChild(self: &Self, node: usize) -> usize {
    return if node == 0 {
      1
    } else if node == 1 {
      2
    } else {
      NO_ELEMENT
    }
  }

  fn nextSibling(self: &Self, node: usize) -> usize {
    return if node == 1 {
      5
    } else if node == 2 || node == 3 {
      node + 1
    } else {
      NO_ELEMENT
    }
  }

  fn previousSibling(self: &Self, node: usize) -> usize {
    return if node == 5 {
      1
    } else if node == 3 || node == 4 {
      node - 1
    } else {
      NO_ELEMENT
    }
  }

  fn localName(self: &Self, node: usize) -> &[u8] {
    return if node == 0 {
      b"svg"
    } else if node == 1 {
      b"g"
    } else if node == 3 {
      b"circle"
    } else {
      b"rect"
    }
  }

  fn namespaceUri(self: &Self, node: usize) -> &[u8] {
    return if node == 5 {
      b"urn:foreign"
    } else {
      b"urn:svg"
    }
  }

  fn attributeCount(self: &Self, node: usize) -> usize {
    return if node == 5 {
      4
    } else if node == 2 || node == 4 {
      3
    } else {
      0
    }
  }

  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] {
    return if attribute == 0 {
      b"id"
    } else if attribute == 1 {
      b"class"
    } else if attribute == 3 {
      b"key"
    } else {
      b"label"
    }
  }

  // The foreign vocabulary declares key as ID; its attribute named id is untyped.
  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool {
    return if node == 5 {
      attribute == 3
    } else {
      attribute == 0
    }
  }

  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] {
    return if attribute == 2 {
      b"urn:foreign"
    } else {
      b""
    }
  }

  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] {
    if attribute == 3 {
      return b"AliasCase"
    }
    if attribute == 0 {
      return if node == 2 {
        b"chosen"
      } else {
        b"other"
      }
    }
    return if attribute == 1 {
      b"hot selected"
    } else {
      b"AbC-def word"
    }
  }

  fn attribute<'a>(self: &'a Self, node: usize, attribute: usize) -> AttributeText<'a> {
    return AttributeText<'a> {
      namespace: ElementTree.attributeNamespace(self, node, attribute),
      name: ElementTree.attributeName(self, node, attribute),
      value: ElementTree.attributeValue(self, node, attribute),
    }
  }

  fn language(self: &Self, node: usize) -> &[u8] {
    return b"en-Latn-US"
  }

  fn isRoot(self: &Self, node: usize) -> bool {
    return node == 0
  }

  fn isEmpty(self: &Self, node: usize) -> bool {
    return node >= 2 && node != 4
  }

  fn isLink(self: &Self, node: usize) -> bool {
    return node == 4
  }
}

effect fn check(
  source: &[u8],
  node: usize,
  yes: bool,
  ids: usize,
  classes: usize,
  types: usize,
) -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run checkState(source, node, yes, ids, classes, types, 0)
}

effect fn checkState(
  source: &[u8],
  node: usize,
  yes: bool,
  ids: usize,
  classes: usize,
  types: usize,
  states: u32,
) -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run checkTarget(source, node, yes, ids, classes, types, states, PseudoTarget.None, 0)
}

effect fn checkTarget(source: &[u8], node: usize, yes: bool, ids: usize, classes: usize, types: usize,
  states: u32, target: PseudoTarget, pseudoStates: u32) -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree { states: states }
      let mut context = MatchContext.make(1, 2)
      context.pseudo = target
      context.pseudoStates = StateBits { bits: pseudoStates }
      let result = run selectors.matchElement(&value, &buffer, &tree, node, &mut context)
      run Testing.expect(
        match &result {
          Option<Specificity>.Some { value: specificity } => yes && specificity.ids == ids
            && specificity.classes == classes
            && specificity.types == types
          _ => !yes
        },
        "parsed selector match and specificity",
      )
      let mut writer = Writer.make()
      run sheet_tokens.encode(&buffer, &mut writer) |> Effect.provideMut<Allocator>(&mut allocator)
      run value.encodeProgram(&buffer, &mut writer) |> Effect.provideMut<Allocator>(&mut allocator)
      let mut reader = Reader.make(writer.bytes.asSlice())
      let mut decodedBuffer = run sheet_tokens.decode(&mut reader, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
      let decoded = run SelectorList.decodeProgram(&mut reader, &mut decodedBuffer, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
      run reader.finish()
      context = MatchContext.make(1, 2)
      context.pseudo = target
      context.pseudoStates = StateBits { bits: pseudoStates }
      let decodedResult = run selectors.matchElement(&decoded, &decodedBuffer, &tree, node, &mut context)
      run Testing.expect(
        match &decodedResult {
          Option<Specificity>.Some { value: specificity } => yes && specificity.ids == ids
            && specificity.classes == classes && specificity.types == types
          _ => !yes
        },
        "decoded selector preserves matching and specificity",
      )
      let recorded = run selectors.matchElementRecorded(&decoded, &decodedBuffer, &tree, node, &mut context)
      run Testing.expect(match &recorded.specificity {
        Option<Specificity>.Some { value: recordedValue } => yes && recordedValue.ids == ids && recordedValue.classes == classes && recordedValue.types == types
        _ => !yes
      }, "recorded matching preserves the target and specificity")
    }
    _ => {
      run Testing.expect(false, "selector must parse")
    }
  }
}

effect fn invalid(source: &[u8]) -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match &parsed {
      Option<SelectorList>.None => true
      _ => false
    },
    "invalid selector rejected",
  )
}

// https://www.w3.org/TR/selectors-4/#specificity-rules
// https://www.w3.org/TR/selectors-4/#matches
// https://www.w3.org/TR/selectors-4/#negation
test effect fn competingMatchingArmsAndFunctionalSpecificity() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run check(b"rect, #missing, .hot", 2, true, 0, 1, 0)
  run check(b"rect, #chosen, .hot", 2, true, 1, 0, 0)
  run check(b":is(rect, #missing)", 2, true, 1, 0, 0)
  run check(b".hot:where(#chosen#chosen, rect)", 2, true, 0, 1, 0)
  run check(b":not(circle, #missing)", 2, true, 1, 0, 0)
  run check(b":is(:unknown, rect)", 2, true, 0, 0, 1)
  run check(b":where(:unknown)", 2, false, 0, 0, 0)
  run check(b":is(#missing#missing, .hot)", 2, true, 2, 0, 0)
  run check(b":is(, :unknown, rect,)", 2, true, 0, 0, 1)
  run check(b":not(:is(circle, #other))", 2, true, 1, 0, 0)
  run check(b"r\\65 ct.\\68 ot#ch\\6f sen", 2, true, 1, 1, 1)
  run invalid(b"rect, :unknown")
  run invalid(b":not(rect, :unknown)")
}

// https://www.w3.org/TR/selectors-4/#relational
// https://www.w3.org/TR/selectors-4/#grammar
test effect fn combinatorsRelativeSelectorsAndHasBoundaries() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run check(b"svg g > rect + circle ~ rect", 4, true, 0, 0, 5)
  run check(b"svg >> rect", 4, true, 0, 0, 2)
  run check(b"g>>rect", 2, true, 0, 0, 2)
  run check(b"g:has(> rect + circle)", 1, true, 0, 0, 3)
  run check(b"rect:has(+ circle)", 2, true, 0, 0, 2)
  run check(b"rect:has(~ rect)", 2, true, 0, 0, 2)
  run check(b"g:has(> rect, #absent)", 1, true, 1, 0, 1)
  run check(b"svg:has(> g > rect:last-child)", 0, true, 0, 1, 3)
  run check(b"g:has(+ rect)", 1, true, 0, 0, 2)
  run check(b"rect:has(+ rect)", 2, false, 0, 0, 0)
  run check(b"g:has(> rect > circle)", 1, false, 0, 0, 0)
  run check(b"g:has(:scope > rect)", 1, false, 0, 0, 0)
  run invalid(b"g:has(:has(rect))")
  run invalid(b"g:has(rect, :unknown)")
  run invalid(b"g:has(::before)")
  run invalid(b"rect >")
  run invalid(b"rect >>")
  run invalid(b"svg > > rect")
  run invalid(b"svg >>> rect")
  run invalid(b"rect,,circle")
}

// https://www.w3.org/TR/selectors-4/#the-nth-child-pseudo
// https://www.w3.org/TR/selectors-4/#specificity-rules
test effect fn structuralAndFilteredNth() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run check(b"rect:nth-child(2n + 1)", 4, true, 0, 1, 1)
  run check(b"rect:nth-child(-n+2)", 4, false, 0, 0, 0)
  run check(b"rect:nth-child(2 of .hot, #missing)", 4, true, 1, 1, 1)
  run check(b"rect:nth-last-child(1 of .hot)", 4, true, 0, 2, 1)
  run check(b"rect:nth-of-type(even):last-of-type", 4, true, 0, 2, 1)
  run check(b"rect:first-child:first-of-type", 2, true, 0, 2, 1)
  run check(b"rect:only-child", 2, false, 0, 0, 0)
  run check(b"circle:only-of-type", 3, true, 0, 1, 1)
  run check(b":nth-child(+n- 1)", 2, true, 0, 1, 0)
  run check(b":nth-child(n-1)", 4, true, 0, 1, 0)
  run check(b":nth-child(0n+3)", 4, true, 0, 1, 0)
  run check(b":nth-child(-2n+5)", 4, true, 0, 1, 0)
  run check(b":nth-child(odd of .hot)", 3, false, 0, 0, 0)
  run invalid(b":nth-child(2-n)")
  run invalid(b":nth-child(n + -1)")
  run invalid(b":nth-child(2n 1)")
  run invalid(b":nth-child(2 n+1)")
  run invalid(b":nth-child(2 of :unknown)")
  run invalid(b":nth-of-type(2 of rect)")
}

// https://www.w3.org/TR/selectors-4/#attribute-case
// https://www.w3.org/TR/selectors-4/#lang-pseudo
// https://www.w3.org/TR/selectors-4/#empty-pseudo
test effect fn attributesAndStaticHostSemantics() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run check(b"[class~=selected][*|label^=abc i][*|label$=word][*|label*=def]", 2, true, 0, 4, 0)
  run check(b"[*|label^=abc s]", 2, false, 0, 0, 0)
  run check(b"[label]", 2, false, 0, 0, 0)
  run check(b"[*|label^='']", 2, false, 0, 0, 0)
  run check(b"[*|label|=AbC]", 2, true, 0, 1, 0)
  run check(b":lang(en):lang('en-*-US'):empty:target", 2, true, 0, 4, 0)
  run check(b":empty", 4, false, 0, 0, 0)
  run check(b":scope > :link", 4, true, 0, 2, 0)
  run check(b":root", 0, true, 0, 1, 0)
  run check(
    b":hover, :active, :focus, :visited, :enabled, :disabled, :checked, ::before",
    2,
    false,
    0,
    0,
    0,
  )
  run invalid(b"[class=hot unknown]")
}

// https://www.w3.org/TR/selectors-4/#id-selectors
test effect fn idSelectorsUseHostTypingAndCaseSensitiveRawValues() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run check(b"#AliasCase", 5, true, 1, 0, 0)
  run check(b"#Alias\\43 ase", 5, true, 1, 0, 0)
  run check(b"#aliascase", 5, false, 0, 0, 0)
  run check(b"#other", 5, false, 0, 0, 0)
  run check(b"[id=other][key=AliasCase]", 5, true, 0, 2, 0)
  run check(b"#chosen", 2, true, 1, 0, 0)
}

// https://www.w3.org/TR/selectors-4/#type-nmsp
// https://www.w3.org/TR/selectors-4/#matches
test effect fn namespaceBindingsAndImplicitSubjectNamespace() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()

  // Namespace text is tokenized into the same arena, outside the selector range.
  let buffer = run lexer.tokenize(b"urn:svg p urn:foreign; *|*:is(.hot), p|rect", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bindings = [
    NamespaceBinding { prefix: Span { start: 0, end: 0 }, uri: Span { start: 0, end: 7 } },
    NamespaceBinding { prefix: Span { start: 8, end: 9 }, uri: Span { start: 10, end: 21 } },
  ]
  let mut start: usize = 0
  while start < buffer.tokens.length() {
    if buffer.tokens.asSlice()[start].source.start >= 23 {
      break
    }
    start = start + 1
  }
  let parsed = run selectors.parse(
    &buffer,
    TokenRange { start: start, end: buffer.all().end },
    &bindings,
    &limits,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tree = Tree { states: 0 }
  let mut context = MatchContext.make(0, NO_ELEMENT)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let result = run selectors.matchElement(&value, &buffer, &tree, 5, &mut context)
      run Testing.expect(
        match &result {
          Option<Specificity>.Some { value: s } => s.classes == 1 && s.types == 0
          _ => false
        },
        "is subject ignores implicit default namespace; matching arm wins",
      )
    }
    _ => {
      run Testing.expect(false, "bound prefixes parse")
    }
  }
  run invalid(b"undeclared|rect")
  run check(b"|rect", 2, false, 0, 0, 0)
  run check(b"*|rect", 5, true, 0, 0, 1)
}

// https://www.w3.org/TR/selectors-4/#grammar
test effect fn matchingWorkIsSharedAndTyped() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(b"rect", &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree { states: 0 }
      let mut context = MatchContext.make(0, NO_ELEMENT)
      context.remainingSteps = 6
      let first = run selectors.matchElement(&value, &buffer, &tree, 2, &mut context)
      run Testing.expect(
        match &first {
          Option<Specificity>.Some { .. } => context.remainingSteps == 0
          _ => false
        },
        "successful matching consumes the shared work budget",
      )
      let result = run Effect.result(
        selectors.matchElement(&value, &buffer, &tree, 2, &mut context),
      )
      run Testing.expect(
        match &result {
          Result<Option<Specificity>, CssError>.Failure { error } => error.kind
            == CssErrorKind.MatchLimit
          _ => false
        },
        "budget exhaustion propagates rather than becoming a nonmatch",
      )
    }
    _ => {
      run Testing.expect(false, "selector parses")
    }
  }
}

effect fn namespaceCheck(source: &[u8], node: usize, yes: bool) -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let mut input = run Bytes.copy(b"urn:svg p urn:foreign; ")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Bytes.append(&mut input, source) |> Effect.provideMut<Allocator>(&mut allocator)
  let buffer = run lexer.tokenize(Bytes.asSlice(&input), &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bindings = [
    NamespaceBinding { prefix: Span { start: 0, end: 0 }, uri: Span { start: 0, end: 7 } },
    NamespaceBinding { prefix: Span { start: 8, end: 9 }, uri: Span { start: 10, end: 21 } },
  ]
  let mut start: usize = 0
  while start < buffer.tokens.length() && buffer.tokens.asSlice()[start].source.start < 23 {
    start = start + 1
  }
  let parsed = run selectors.parse(
    &buffer,
    TokenRange { start: start, end: buffer.all().end },
    &bindings,
    &limits,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree { states: 0 }
      let mut context = MatchContext.make(0, NO_ELEMENT)
      let result = run selectors.matchElement(&value, &buffer, &tree, node, &mut context)
      run Testing.expect(
        match &result {
          Option<Specificity>.Some { .. } => yes
          _ => !yes
        },
        "namespace-aware real parser match",
      )
    }
    _ => {
      run Testing.expect(false, "namespace selector parses")
    }
  }
}

// https://www.w3.org/TR/selectors-4/#type-nmsp
// https://www.w3.org/TR/selectors-4/#matches
// https://www.w3.org/TR/selectors-4/#the-nth-child-pseudo
test effect fn namespaceRestrictionsDoNotLeakIntoLogicalSubjects() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run namespaceCheck(b".hot", 5, false)
  run namespaceCheck(b"rect", 5, false)
  run namespaceCheck(b"p|rect", 5, true)
  run namespaceCheck(b"*|*:is(.hot)", 5, true)
  run namespaceCheck(b"*|*:is(*.hot)", 5, false)
  run namespaceCheck(b"*|*:not(.hot)", 5, false)
  run namespaceCheck(b"*|*:not(*.hot)", 5, true)
  run namespaceCheck(b"*|*:where(.hot)", 5, true)
  run namespaceCheck(b"[p|label]", 2, true)
  run namespaceCheck(b"[|label]", 2, false)
  run namespaceCheck(b"*|*:nth-child(1 of .hot)", 5, false)
  run namespaceCheck(b"*|*:nth-child(1 of *|*.hot)", 5, true)
}

// https://www.w3.org/TR/selectors-4/#grammar
// https://www.w3.org/TR/selectors-4/#typedef-forgiving-selector-list
test effect fn selectorDepthErrorsSurviveForgivingLists() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let normal = Limits.make()
  let buffer = run lexer.tokenize(b":is(:is(:is(rect)), rect)", &normal)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut limits = Limits.make()
  limits.maxDepth = 2
  let result = run Effect.result(
    selectors.parse(&buffer, buffer.all(), &[], &limits)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &result {
      Result<Option<SelectorList>, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.NestingLimit
        OutOfMemoryError _ => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "forgiving syntax must not hide nesting exhaustion",
  )
}

// https://www.w3.org/TR/css-syntax-3/#consume-function
// https://www.w3.org/TR/css-syntax-3/#consume-simple-block
test effect fn implicitComponentClosuresDoNotBecomeUnmatchedClosers() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run check(b":is(circle, rect", 2, true, 0, 0, 1)
  run check(b"[class~=hot", 2, true, 0, 1, 0)
  run check(b":not(:is(circle", 2, true, 0, 0, 1)
  run invalid(b"rect)")
  run invalid(b"[class=hot)]")
}


test effect fn hostStatesMatchThroughCombinatorsAndLogicalSelectors() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  let hoverFocus = element.HOVER | element.FOCUS | element.FOCUS_VISIBLE
  run checkState(b"rect:hover:focus-visible", 2, true, 0, 2, 1, hoverFocus)
  run checkState(b"rect:hover:focus-visible", 2, false, 0, 0, 0, element.HOVER)
  run checkState(b"g:has(> :focus) > rect:hover", 2, true, 0, 2, 2, hoverFocus)
  run checkState(b":hover + circle", 3, true, 0, 1, 1, hoverFocus)
  run checkState(b":where(:hover):not(:disabled)", 2, true, 0, 1, 0, hoverFocus)
  run checkState(b":enabled", 2, false, 0, 0, 0, 0)
  run checkState(b":optional", 2, false, 0, 0, 0, 0)
  run checkState(b":open:popover-open", 2, true, 0, 2, 0, element.OPEN | element.POPOVER_OPEN)
  run checkState(b":active", 2, true, 0, 1, 0, element.ACTIVE)
  run checkState(b":focus-within", 2, true, 0, 1, 0, element.FOCUS_WITHIN)
  run checkState(b":disabled", 2, true, 0, 1, 0, element.DISABLED)
  run checkState(b":enabled", 2, true, 0, 1, 0, element.ENABLED)
  run checkState(b":checked", 2, true, 0, 1, 0, element.CHECKED)
  run checkState(b":indeterminate", 2, true, 0, 1, 0, element.INDETERMINATE)
  run checkState(b":placeholder-shown", 2, true, 0, 1, 0, element.PLACEHOLDER_SHOWN)
  run checkState(b":read-only", 2, true, 0, 1, 0, element.READ_ONLY)
  run checkState(b":read-write", 2, true, 0, 1, 0, element.READ_WRITE)
  run checkState(b":required", 2, true, 0, 1, 0, element.REQUIRED)
  run checkState(b":optional", 2, true, 0, 1, 0, element.OPTIONAL)
}

effect fn watchOf(source: &[u8], node: usize, watched: usize) -> u32
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let tree = Tree { states: 0 }
  let mut context = MatchContext.make(1, 2)
  match &parsed {
    Option<SelectorList>.Some { value } => { drop run selectors.matchElement(&value, &buffer, &tree, node, &mut context) }
    _ => { run Testing.expect(false, "selector must parse") }
  }
  run Testing.expect(!context.watchOverflow, "a few watched elements fit")
  let entries = context.watched()
  let mut i: usize = 0
  while i < entries.length {
    if entries[i].node == watched { return entries[i].bits }
    i = i + 1
  }
  return 0
}

test effect fn matchingReportsHasAnchorsAndFocusWithinElements() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run Testing.expect((run watchOf(b"g:has(> rect)", 1, 1)) == element.WATCH_HAS, "the subject of :has() is its anchor")
  run Testing.expect((run watchOf(b"rect:has(+ circle)", 2, 2)) == (element.WATCH_HAS | element.WATCH_HAS_SIBLINGS), "a sibling argument reads past the anchor's subtree")
  run Testing.expect((run watchOf(b"g:has(> .absent) > circle", 3, 1)) == element.WATCH_HAS && (run watchOf(b"g:has(> .absent) > circle", 3, 3)) == 0, "a failed :has() on an ancestor is still watched there")
  run Testing.expect((run watchOf(b"rect:has(circle)", 3, 3)) == 0 && (run watchOf(b":has(circle).absent", 2, 2)) == 0 && (run watchOf(b":focus-within.absent", 2, 2)) == 0, "a compound whose other tests fail watches nothing, in any order")
  run Testing.expect((run watchOf(b"g:focus-within > rect", 2, 1)) == element.WATCH_FOCUS_WITHIN && (run watchOf(b"g:focus-within > rect", 2, 2)) == 0, ":focus-within is watched on the element it was asked of")
  run Testing.expect((run watchOf(b"g:has(:focus-within)", 1, 1)) == element.WATCH_HAS && (run watchOf(b"g:has(:focus-within)", 1, 2)) == element.WATCH_FOCUS_WITHIN, "states read inside :has() are watched on the candidates")
}

test effect fn invalidationKeysIncludeRelationalAndFailedLogicalArms() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(b".group:has(+ .peer[data-open]) .child:is(:hover,.other)", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut peer = false
  let mut attribute = false
  let mut state = false
  if let Option<SelectorList>.Some { value } = move parsed {
    let dependencies = run value.dependencies() |> Effect.provideMut<Allocator>(&mut allocator)
    let mut i: usize = 0
    while i < dependencies.length() {
      let dependency = dependencies.asSlice()[i]
      if dependency.kind == DependencyKind.Class && tokens.equal(buffer.text(dependency.name), b"peer") {
        peer = dependency.ancestors && dependency.siblings && dependency.descendants
      }
      if dependency.kind == DependencyKind.Attribute { attribute = true }
      if dependency.kind == DependencyKind.State { state = dependency.states == element.HOVER }
      i = i + 1
    }
  }
  run Testing.expect(peer && attribute && state, "relational dependencies include reverse siblings and ancestor subtrees")
  let localBuffer = run lexer.tokenize(b".hot:hover", &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let local = run selectors.parse(&localBuffer, localBuffer.all(), &[], &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<SelectorList>.Some { value } = move local {
    let dependencies = run value.dependencies() |> Effect.provideMut<Allocator>(&mut allocator)
    let mut i: usize = 0
    while i < dependencies.length() {
      let dependency = dependencies.asSlice()[i]
      run Testing.expect(!dependency.ancestors && !dependency.siblings && !dependency.descendants, "simple utility remains local")
      i = i + 1
    }
  } else { run Testing.expect(false, "local selector parses") }
}

test effect fn nthOfInvalidationReachesSiblingsForClassAndStateChanges() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let cases = [b":nth-child(2 of .eligible)", b":nth-last-child(odd of :hover)"]
  let mut index: usize = 0
  while index < cases.length {
    let buffer = run lexer.tokenize(cases[index], &Limits.make()) |> Effect.provideMut<Allocator>(&mut allocator)
    let parsed = run selectors.parse(&buffer, buffer.all(), &[], &Limits.make()) |> Effect.provideMut<Allocator>(&mut allocator)
    let mut found = false
    if let Option<SelectorList>.Some { value } = move parsed {
      let dependencies = run value.dependencies() |> Effect.provideMut<Allocator>(&mut allocator)
      let mut i: usize = 0
      while i < dependencies.length() {
        let dependency = dependencies.asSlice()[i]
        if dependency.kind == DependencyKind.Class || dependency.kind == DependencyKind.State {
          found = true
          run Testing.expect(dependency.siblings, "changing nth-of membership can restyle other siblings")
        }
        i = i + 1
      }
    }
    run Testing.expect(found, "nth-of filter dependencies are retained")
    index = index + 1
  }
}

test effect fn generatedPseudoTargetsKeepOriginSelectorsAndSpecificitySeparate() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run checkTarget(b"rect", 2, false, 0, 0, 0, 0, PseudoTarget.Before, 0)
  run checkTarget(b"rect::before", 2, false, 0, 0, 0, 0, PseudoTarget.None, 0)
  run checkTarget(b"rect::before", 2, true, 0, 0, 2, 0, PseudoTarget.Before, 0)
  run checkTarget(b"rect:before", 2, true, 0, 0, 2, 0, PseudoTarget.Before, 0)
  run checkTarget(b"rect::before", 2, false, 0, 0, 0, 0, PseudoTarget.After, 0)
  run checkTarget(b"rect::after", 2, true, 0, 0, 2, 0, PseudoTarget.After, 0)
  run checkTarget(b"#chosen, .hot::before", 2, true, 0, 1, 1, 0, PseudoTarget.Before, 0)
  run checkTarget(b"#chosen, .hot::before", 2, true, 1, 0, 0, 0, PseudoTarget.None, 0)
  run checkTarget(b":is(#chosen, .hot)::before", 2, true, 1, 0, 1, 0, PseudoTarget.Before, 0)
  run checkTarget(b"g > rect:nth-child(1 of .hot)::before", 2, true, 0, 2, 3, 0, PseudoTarget.Before, 0)
  run checkTarget(b"g:has(rect.hot) > rect::after", 2, true, 0, 1, 4, 0, PseudoTarget.After, 0)
  run checkTarget(b"rect:hover::before", 2, true, 0, 1, 2, element.HOVER, PseudoTarget.Before, 0)
  run checkTarget(b"rect::before:hover", 2, false, 0, 0, 0, element.HOVER, PseudoTarget.Before, 0)
  run checkTarget(b"rect::before:hover", 2, true, 0, 1, 2, 0, PseudoTarget.Before, element.HOVER)
  run checkTarget(b"rect:hover::before:not(:hover)", 2, true, 0, 2, 2, element.HOVER, PseudoTarget.Before, 0)
  run checkTarget(b"rect::before:is(:hover,:active)", 2, true, 0, 1, 2, 0, PseudoTarget.Before, element.ACTIVE)
  run checkTarget(b"rect::before::marker", 2, false, 0, 0, 0, 0, PseudoTarget.Before, 0)
  run invalid(b"rect::before > .hot")
  run invalid(b"rect:has(::after)")
}

test effect fn partPseudoTargetsMatchOnlyTheirOriginAndOwnTarget() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run checkTarget(b"rect::placeholder", 2, true, 0, 0, 2, 0, PseudoTarget.Placeholder, 0)
  run checkTarget(b"rect::placeholder", 2, false, 0, 0, 0, 0, PseudoTarget.None, 0)
  run checkTarget(b"rect::placeholder", 2, false, 0, 0, 0, 0, PseudoTarget.Selection, 0)
  run checkTarget(b"#chosen::selection", 2, true, 1, 0, 1, 0, PseudoTarget.Selection, 0)
  run checkTarget(b"g > .hot::selection", 2, true, 0, 1, 2, 0, PseudoTarget.Selection, 0)
  run checkTarget(b"rect::-webkit-scrollbar", 2, true, 0, 0, 2, 0, PseudoTarget.Scrollbar, 0)
  run checkTarget(b"rect:hover::-webkit-scrollbar-thumb", 2, true, 0, 1, 2, element.HOVER, PseudoTarget.ScrollbarThumb, 0)
  run checkTarget(b"rect:hover::-webkit-scrollbar-thumb", 2, false, 0, 0, 0, 0, PseudoTarget.ScrollbarThumb, 0)
  run checkTarget(b"rect::-webkit-scrollbar-thumb:hover", 2, false, 0, 0, 0, element.HOVER, PseudoTarget.ScrollbarThumb, 0)
  run checkTarget(b"rect::-webkit-scrollbar-thumb:hover", 2, true, 0, 1, 2, 0, PseudoTarget.ScrollbarThumb, element.HOVER)
  run checkTarget(b"rect::-WEBKIT-SCROLLBAR-TRACK", 2, true, 0, 0, 2, 0, PseudoTarget.ScrollbarTrack, 0)
  run checkTarget(b"rect::-webkit-scrollbar-track", 2, false, 0, 0, 0, 0, PseudoTarget.ScrollbarThumb, 0)
  run checkTarget(b"#chosen, .hot::selection", 2, true, 0, 1, 1, 0, PseudoTarget.Selection, 0)
  run checkTarget(b"#chosen, .hot::selection", 2, true, 1, 0, 0, 0, PseudoTarget.None, 0)
  run invalid(b"rect::placeholder > .hot")
  run invalid(b"rect:has(::selection)")
}

effect fn readsOf(text: &[u8]) -> u32
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(text, &limits)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
  return match &parsed { Option<SelectorList>.Some { value } => value.reads() _ => 4294967295 }
}

effect fn readsBody() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  run Testing.expect((run readsOf(b".a .b > .c:hover[data-x]:not(.d):is(.e, :root)")) == 0, "names, attributes, states and ancestors read nothing else")
  run Testing.expect((run readsOf(b":where(.stack > :not(:last-child))")) == selectors.READS_EDGE, "nested edge tests are seen")
  run Testing.expect((run readsOf(b".a:first-child, .b:only-child")) == selectors.READS_EDGE, "every selector of the list counts")
  run Testing.expect((run readsOf(b".a:empty")) == selectors.READS_EMPTY, "empty")
  run Testing.expect((run readsOf(b".a:nth-child(2n+1)")) == selectors.READS_INDEX && (run readsOf(b"li:last-of-type")) == selectors.READS_INDEX, "indexes and types")
  run Testing.expect((run readsOf(b".a + .b")) == selectors.READS_SIBLINGS && (run readsOf(b".a ~ .b .c")) == selectors.READS_SIBLINGS, "sibling combinators at any depth")
  run Testing.expect(((run readsOf(b".a:has(.b)")) & selectors.READS_DESCENDANTS) != 0, "has")
}

test effect fn selectorListsReportWhatTheyReadBeyondAncestors() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run readsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sharingOf(text: &[u8]) -> selectors.Sharing
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(text, &limits)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
  return match &parsed { Option<SelectorList>.Some { value } => value.sharing() _ => selectors.Sharing { siblings: 99, period: 99, lead: 99, tail: 99, fromEnd: true } }
}

fn bounds(found: selectors.Sharing, siblings: usize, period: usize, lead: usize, tail: usize, fromEnd: bool) -> bool {
  return found.siblings == siblings && found.period == period && found.lead == lead && found.tail == tail && found.fromEnd == fromEnd
}

effect fn sharingBody() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  run Testing.expect(bounds(run sharingOf(b".a .b > .c:first-child:has(.d)"), 0, 1, 0, 0, false), "no sibling step and no index test")
  run Testing.expect(bounds(run sharingOf(b".a + .b ~ .c, :is(.d + .e) .f"), 3, 1, 0, 0, false), "every sibling step of the list counts")
  run Testing.expect(bounds(run sharingOf(b".a:nth-child(odd)"), 0, 2, 1, 0, false), "odd repeats every two after the first")
  run Testing.expect(bounds(run sharingOf(b".a:nth-child(3)"), 0, 1, 3, 0, false), "one index is a lead with no period")
  run Testing.expect(bounds(run sharingOf(b".a:nth-child(-n+4)"), 0, 1, 4, 0, false), "the first four are a lead")
  run Testing.expect(bounds(run sharingOf(b"li:nth-child(2n), li:nth-of-type(3n+1)"), 0, 6, 1, 0, false), "periods multiply out")
  run Testing.expect(bounds(run sharingOf(b".a:nth-last-child(2)"), 0, 1, 0, 2, false), "an index from the end is a tail")
  run Testing.expect(bounds(run sharingOf(b".a:nth-last-child(2n)"), 0, 2, 0, 0, true), "a period from the end needs the count")
  run Testing.expect(bounds(run sharingOf(b"p:first-of-type, p:only-of-type"), 0, 1, 1, 1, false), "of-type edges are a lead and a tail of one")
  run Testing.expect((run sharingOf(b":nth-child(2 of .x)")).period == 0 && (run sharingOf(b":nth-child(100n)")).period == 0, "an of list or a long step has no period")
  let merged = (run sharingOf(b".a + .b:nth-child(3n)")).with(run sharingOf(b".c:nth-child(2n+5)"))
  run Testing.expect(bounds(merged, 1, 6, 5, 0, false), "sheets merge to the bounds of both")
}

test effect fn selectorListsBoundWhatSharingAMatchNeeds() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sharingBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn matchReads(text: &[u8], node: usize) -> u32
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(text, &limits)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree { states: 0 }
      let mut context = MatchContext.make(1, 2)
      drop run selectors.matchElement(&value, &buffer, &tree, node, &mut context)
      return if context.above { 4294967295 } else { context.reads }
    }
    _ => { return 4294967295 }
  }
}

// svg(0) > g(1) > rect(2), circle(3), rect(4); a foreign rect(5) follows g.
effect fn matchReadsBody() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError ? &mut Allocator {
  let above = selectors.READS_ABOVE
  run Testing.expect((run matchReads(b"svg > g circle:not(.x)", 3)) == 0, "names and ancestors read nothing else")
  run Testing.expect((run matchReads(b"rect + circle", 3)) == selectors.READS_SIBLINGS, "a sibling step that holds")
  run Testing.expect((run matchReads(b"circle ~ rect", 2)) == selectors.READS_SIBLINGS, "a sibling step with nothing before the element")
  run Testing.expect((run matchReads(b"rect + rect", 3)) == 0, "a compound that fails on the name never reaches its step")
  run Testing.expect((run matchReads(b"circle:nth-child(2)", 3)) == selectors.READS_INDEX && (run matchReads(b"circle:last-of-type", 3)) == selectors.READS_INDEX, "indexes and types")
  run Testing.expect((run matchReads(b"circle:last-child", 3)) == selectors.READS_EDGE && (run matchReads(b"circle:empty", 3)) == selectors.READS_EMPTY, "edges and emptiness")
  run Testing.expect((run matchReads(b"g:has(circle)", 1)) == selectors.READS_DESCENDANTS, "has on the element")
  run Testing.expect((run matchReads(b"g:first-child circle", 3)) == u32.shiftLeft(selectors.READS_EDGE, above), "an ancestor's edge")
  run Testing.expect((run matchReads(b"g:has(rect + circle) > circle", 3)) == u32.shiftLeft(selectors.READS_DESCENDANTS | selectors.READS_SIBLINGS, above), "an ancestor's has, and what its argument read")
  run Testing.expect((run matchReads(b"svg + g circle, rect ~ circle", 3)) == (selectors.READS_SIBLINGS | u32.shiftLeft(selectors.READS_SIBLINGS, above)), "every arm adds up, each at its level")
}

test effect fn matchingRecordsWhatItReadAndWhere() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run matchReadsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A chain 0 > 1 > 2 > 3: dir="rtl", dir="auto", dir="LTR", no dir.
struct DirTree {}

impl ElementTree for DirTree {
  fn parent(self: &Self, node: usize) -> usize { return if node == 0 { NO_ELEMENT } else { node - 1 } }
  fn containingHost(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn firstChild(self: &Self, node: usize) -> usize { return if node < 3 { node + 1 } else { NO_ELEMENT } }
  fn nextSibling(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn previousSibling(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn localName(self: &Self, node: usize) -> &[u8] { return b"div" }
  fn namespaceUri(self: &Self, node: usize) -> &[u8] { return b"" }
  fn attributeCount(self: &Self, node: usize) -> usize { return if node < 3 { 1 } else { 0 } }
  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] { return b"dir" }
  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] { return b"" }
  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] {
    return if node == 0 { b"rtl" } else if node == 1 { b"auto" } else { b"LTR" }
  }
  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool { return false }
  fn attribute<'a>(self: &'a Self, node: usize, attribute: usize) -> AttributeText<'a> {
    return AttributeText<'a> { namespace: b"", name: b"dir", value: self.attributeValue(node, attribute) }
  }
  fn language(self: &Self, node: usize) -> &[u8] { return b"" }
  fn isRoot(self: &Self, node: usize) -> bool { return node == 0 }
  fn isEmpty(self: &Self, node: usize) -> bool { return node == 3 }
  fn isLink(self: &Self, node: usize) -> bool { return false }
}

effect fn direction(source: &[u8], node: usize, expected: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = DirTree {}
      let mut context = MatchContext.make(0, NO_ELEMENT)
      let result = run selectors.matchElement(&value, &buffer, &tree, node, &mut context)
      run Testing.expect(result.isSome() == expected, ":dir() follows the nearest ltr or rtl dir attribute")
    }
    _ => { run Testing.expect(false, ":dir() parses") }
  }
}

// https://drafts.csswg.org/selectors/#the-dir-pseudo
test effect fn dirFollowsTheNearestDirAttribute() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run direction(b":dir(rtl)", 0, true)
  run direction(b":dir(rtl)", 1, true)
  run direction(b":dir(ltr)", 1, false)
  run direction(b":dir(ltr)", 2, true)
  run direction(b":dir(RTL)", 3, false)
  run direction(b":dir(ltr)", 3, true)
  run direction(b":dir(rtl) :dir(ltr)", 3, true)
}

test effect fn formStatesMatchTheirHostBits() -> ()
  ! AssertionError<'static> | DecodeError | CssError | OutOfMemoryError {
  run checkState(b":default", 2, true, 0, 1, 0, element.DEFAULT)
  run checkState(b":in-range", 2, true, 0, 1, 0, element.IN_RANGE)
  run checkState(b":out-of-range", 2, true, 0, 1, 0, element.OUT_OF_RANGE)
  run checkState(b":in-range", 2, false, 0, 0, 0, element.OUT_OF_RANGE)
}

// One element whose host answers class tests from its own interned names, which here differ
// from the `class` attribute text so that the test sees which answer matching used.
struct Interned {}

impl ElementTree for Interned {
  fn hasClass(self: &Self, node: usize, name: &[u8]) -> Option<bool> {
    return Option<bool>.some(tokens.equal(name, b"interned"))
  }
  fn containingHost(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn parent(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn firstChild(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn nextSibling(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn previousSibling(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn localName(self: &Self, node: usize) -> &[u8] { return b"div" }
  fn namespaceUri(self: &Self, node: usize) -> &[u8] { return b"" }
  fn attributeCount(self: &Self, node: usize) -> usize { return 1 }
  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] { return b"class" }
  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool { return false }
  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] { return b"" }
  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] { return b"written" }
  fn attribute<'a>(self: &'a Self, node: usize, attribute: usize) -> AttributeText<'a> {
    return AttributeText<'a> { namespace: b"", name: b"class", value: b"written" }
  }
  fn language(self: &Self, node: usize) -> &[u8] { return b"" }
  fn isRoot(self: &Self, node: usize) -> bool { return true }
  fn isEmpty(self: &Self, node: usize) -> bool { return true }
  fn isLink(self: &Self, node: usize) -> bool { return false }
}

effect fn matchesInterned(source: &[u8]) -> bool
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let mut context = MatchContext.make(0, 0)
      return (run selectors.matchElement(&value, &buffer, &Interned {}, 0, &mut context)).isSome()
    }
    _ => {
      run Testing.expect(false, "selector must parse")
      return false
    }
  }
}

// A host that interns class names answers class selectors itself; `[class~=]` still reads
// the attribute text.
test effect fn hostAnswersClassSelectorsFromInternedNames() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run Testing.expect(run matchesInterned(b".interned"), "the host's class answer matches")
  run Testing.expect(!(run matchesInterned(b".written")), "the attribute text is not scanned for a class")
  run Testing.expect(run matchesInterned(b"[class~=written]"), "attribute selectors still read the text")
  run Testing.expect(run matchesInterned(b":not(.written) .interned, .interned"), "logical arms ask the host too")
}

//! Sparse inherited custom-property scopes and bounded token-reference substitution.
import css_properties.census { Census }
import registration { Registration, Syntax }
import registration
import cascade { Name, Declaration, Candidate, Target, Specified, Origin, Priority, Rollback }
import cascade
import values { Wide }
import tokens {
  Token,
  TokenBuffer,
  TokenRange,
  Span,
  Kind,
  Limits,
  CssError,
  CssErrorKind,
  BufferView,
  Buffers
}
import tokens
import input { Input, TokenRef }
import declaration_values
import media_features { Environment, Truth }
import media_features
import media_queries
import supports
import values { Store as ValueStore }
import silk.collections.list { List }
import silk.collections.hash { Hash }
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct ScopeId {
  pub index: usize
}

impl Copy for ScopeId {}

/// A visible, substituted custom property. The range addresses `references()`.
pub struct ComputedVariable {
  pub name: Name,
  pub value: TokenRange,
}

impl Copy for ComputedVariable {}

struct Entry {
  name: Name,
  /// `nameKey` of the name: lookups compare it before the text.
  key: u64,
  value: Option<TokenRange>
}

impl Copy for Entry {}

struct Scope {
  parent: Option<ScopeId>,
  entries: TokenRange
}

impl Copy for Scope {}

pub enum RegistrationError { AlreadyBuilt, Invalid }

struct Registered {
  definition: Registration,
  key: u64,
  initial: Option<TokenRange>,
}
impl Copy for Registered {}

pub struct VariableStore {
  closingBuffer: usize,
  registrations: List<Registered>,
  isolated: bool,
  scopes: List<Scope>,
  entries: List<Entry>,
  refs: List<TokenRef>,
  /// What `if(media(...))` tests; without one, `media()` is false.
  pub environment: Option<Environment>,
}

struct Node {
  name: Name,
  buffer: usize,
  raw: TokenRange,
  value: Option<TokenRange>,
  resolved: bool,
  edges: TokenRange,
  visited: bool,
  number: usize,
  low: usize,
  stacked: bool,
  cyclic: bool,
  priority: Priority,
  rollback: Rollback,
}

impl Copy for Node {}

struct Work {
  nodes: List<Node>,
  edges: List<usize>,
  parent: Option<ScopeId>,
  retry: bool,
  resolvedScope: bool,
}

struct Budget {
  remaining: usize
}

impl Budget {
  effect fn spend(self: &mut Budget, amount: usize) -> ()
    ! CssError {
    if amount > self.remaining {
      fail CssError { kind: CssErrorKind.MatchLimit, offset: 0 }
    }
    self.remaining = self.remaining - amount
  }
}

/// The bit a custom property name takes in a set of names (`VariableStore.differing`,
/// `adopted_variables.VariableMasks`).
/// A hash of a custom property's name, equal for equal names.
fn nameKey(buffers: BufferView<'_>, name: Name) -> u64 {
  if name.buffer >= buffers.length() { return 0 }
  let text = buffers.one(name.buffer)[0].text(name.span)
  let mut hash = Hash.mix(&Hash.seed(1123), usize.toU64(text.length))
  let mut i: usize = 0
  while i < text.length {
    hash = Hash.combine(hash, u8.toU64(text[i]))
    i = i + 1
  }
  return hash
}

pub fn nameBit(name: &[u8]) -> u64 {
  let mut hash = Hash.mix(&Hash.seed(1103), usize.toU64(name.length))
  let mut i: usize = 0
  while i < name.length {
    hash = Hash.combine(hash, u8.toU64(name[i]))
    i = i + 1
  }
  return u64.shiftLeft(1, u64.bitAnd(u64.shiftRight(hash, 23), 63))
}

pub effect fn appendClosingBuffer(buffers: &mut Buffers<'_>) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut buffer = TokenBuffer.make()
  let empty = Span { start: 0, end: 0 }
  run buffer.tokens.append(Token { kind: Kind.CloseParen, source: empty, matching: 0 })
  run buffer.tokens.append(Token { kind: Kind.CloseSquare, source: empty, matching: 1 })
  run buffer.tokens.append(Token { kind: Kind.CloseBrace, source: empty, matching: 2 })
  run buffer.tokens.append(Token { kind: Kind.Eof, source: empty, matching: 3 })
  let index = buffers.length()
  run buffers.append(move buffer)
  return index
}

fn closing(kind: &Kind) -> Option<usize> {
  return match &kind.* {
    Kind.Function { .. } => Option<usize>.some(0)
    Kind.OpenParen => Option<usize>.some(0)
    Kind.OpenSquare => Option<usize>.some(1)
    Kind.OpenBrace => Option<usize>.some(2)
    _ => Option<usize>.None
  }
}

fn skip(buffer: &TokenBuffer, start: usize, end: usize) -> usize {
  let mut i = start
  while i < end {
    match &buffer.tokens.asSlice()[i].kind {
      Kind.Whitespace => {
        i = i + 1
      }
      _ => {
        return i
      }
    }
  }
  return i
}

fn variable(buffer: &TokenBuffer, index: usize) -> bool {
  return match &buffer.tokens.asSlice()[index].kind {
    Kind.Function { name } => tokens.insensitive(buffer.text(name), b"var")
    _ => false
  }
}

/// One entry of `VariableStore.reads`: where a looked-up value starts and ends in the store's
/// references, or `u64.MAX` for none.
fn variableRead(value: Option<TokenRange>) -> u64 {
  return match value {
    Option<TokenRange>.Some { value: found } => u64.bitOr(u64.shiftLeft(usize.toU64(found.start), 32), usize.toU64(found.end))
    Option<TokenRange>.None => u64.MAX
  }
}

fn variableName(buffer: &TokenBuffer, source: usize, index: usize, end: usize) -> Option<Name> {
  let first = skip(buffer, index + 1, end)
  if first >= end {
    return Option<Name>.None
  }
  return match &buffer.tokens.asSlice()[first].kind {
    Kind.Ident { text } => Option<Name>.some(Name { buffer: source, span: text })
    _ => Option<Name>.None
  }
}

fn local(work: &Work, buffers: BufferView<'_>, name: Name) -> Option<usize> {
  let mut i: usize = 0
  while i < work.nodes.length() {
    if cascade.sameName(buffers, name, work.nodes.asSlice()[i].name) {
      return Option<usize>.some(i)
    }
    i = i + 1
  }
  return Option<usize>.None
}

effect fn push(
  out: &mut List<TokenRef>,
  reference: TokenRef,
  limits: &Limits,
  budget: &mut Budget,
) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  run budget.spend(1)
  if out.length() >= limits.maxTokens {
    fail CssError { kind: CssErrorKind.TokenLimit, offset: out.length() }
  }
  if out.length() >= limits.maxStorageBytes / 16 {
    fail CssError { kind: CssErrorKind.StorageLimit, offset: out.length() }
  }
  run out.append(reference)
}

impl VariableStore {
  pub effect fn census(self: &Self, out: &mut Census) -> () ! OutOfMemoryError ? &mut Allocator {
    run out.held("variables.scopes", self.scopes.length(), self.scopes.capacity(), Intrinsic.layoutOf<Scope>().bytes)
    run out.held("variables.entries", self.entries.length(), self.entries.capacity(), Intrinsic.layoutOf<Entry>().bytes)
    run out.held("variables.token-refs", self.refs.length(), self.refs.capacity(), Intrinsic.layoutOf<TokenRef>().bytes)
  }

  pub fn make(closingBuffer: usize) -> VariableStore {
    return VariableStore {
      closingBuffer: closingBuffer,
      registrations: List<Registered>.make(),
      isolated: false,
      scopes: List<Scope>.make(),
      entries: List<Entry>.make(),
      refs: List<TokenRef>.make(),
      environment: Option<Environment>.None,
    }
  }

  /// Starts a full restyle, retaining registrations but invalidating every previous ScopeId.
  pub fn resetScopes(self: &mut Self) -> () {
    let mut keep: usize = 0
    let registrations = self.registrations.asSlice()
    let mut i: usize = 0
    while i < registrations.length {
      if let Option<TokenRange>.Some { value } = registrations[i].initial {
        if value.end > keep { keep = value.end }
      }
      i = i + 1
    }
    self.refs.truncate(keep)
    self.scopes.clear()
    self.entries.clear()
  }

  /// Adds or replaces a validated registration before the first scope is built.
  /// Registrations share the caller's immutable buffers, as ordinary declarations do.
  pub effect fn register(self: &mut Self, buffers: BufferView<'_>, definition: Registration, limits: &Limits) -> ()
    ! RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
    if self.scopes.length() != 0 { fail RegistrationError.AlreadyBuilt }
    if definition.name.buffer >= buffers.length()
      || !declaration_values.customName(buffers.one(definition.name.buffer)[0].text(definition.name.span)) {
      fail RegistrationError.Invalid
    }
    let mut initial = Option<TokenRange>.None
    if let Option<TokenRange>.Some { value: range } = definition.initial {
      let buffer = &buffers.one(definition.name.buffer)[0]
      if range.start > range.end || range.end > buffer.all().end { fail RegistrationError.Invalid }
      if !run registration.valid(definition.syntax, &Input.Contiguous { buffer: buffer, range: range }, true, limits) {
        fail RegistrationError.Invalid
      }
      let mut budget = Budget { remaining: limits.maxTokens }
      let start = self.refs.length()
      let mut i = range.start
      while i < range.end {
        run push(&mut self.refs, TokenRef { buffer: definition.name.buffer, token: i }, limits, &mut budget)
        i = i + 1
      }
      initial = Option<TokenRange>.some(TokenRange { start: start, end: self.refs.length() })
    } else if definition.syntax != Syntax.Universal { fail RegistrationError.Invalid }
    let item = Registered { definition: definition, key: nameKey(buffers, definition.name), initial: initial }
    let mut found = false
    let mut i: usize = 0
    while i < self.registrations.length() {
      if cascade.sameName(buffers, definition.name, self.registrations.asSlice()[i].definition.name) {
        let registrations = self.registrations.asMutSlice()
        registrations[i] = item
        found = true
        break
      }
      i = i + 1
    }
    if !found {
      if self.registrations.length() >= limits.maxDeclarations { fail CssError { kind: CssErrorKind.DeclarationLimit, offset: 0 } }
      run self.registrations.append(item)
    }
    self.isolated = false
    i = 0
    while i < self.registrations.length() {
      if !self.registrations.asSlice()[i].definition.inherits { self.isolated = true }
      i = i + 1
    }
  }

  fn registered(self: &Self, buffers: BufferView<'_>, name: Name) -> Option<Registered> {
    if self.registrations.length() == 0 { return Option<Registered>.None }
    let key = nameKey(buffers, name)
    let mut i: usize = 0
    while i < self.registrations.length() {
      let entry = self.registrations.asSlice()[i]
      if entry.key == key && cascade.sameName(buffers, name, entry.definition.name) { return Option<Registered>.some(entry) }
      i = i + 1
    }
    return Option<Registered>.None
  }

  fn registeredText(self: &Self, buffers: BufferView<'_>, name: &[u8]) -> Option<Registered> {
    let mut i: usize = 0
    while i < self.registrations.length() {
      let entry = self.registrations.asSlice()[i]
      if tokens.equal(buffers.one(entry.definition.name.buffer)[0].text(entry.definition.name.span), name) {
        return Option<Registered>.some(entry)
      }
      i = i + 1
    }
    return Option<Registered>.None
  }

  fn initial(self: &Self, buffers: BufferView<'_>, name: Name) -> Option<TokenRange> {
    return match &self.registered(buffers, name) {
      Option<Registered>.Some { value } => value.initial
      _ => Option<TokenRange>.None
    }
  }

  effect fn defaultValue(self: &Self, buffers: BufferView<'_>, parent: Option<ScopeId>, name: Name, budget: &mut Budget) -> Option<TokenRange>
    ! CssError {
    if let Option<Registered>.Some { value } = self.registered(buffers, name) {
      if !value.definition.inherits { return value.initial }
    }
    return run self.inherited(buffers, parent, name, &mut budget.*)
  }

  effect fn invalidValue(self: &Self, buffers: BufferView<'_>, parent: Option<ScopeId>, name: Name, budget: &mut Budget) -> Option<TokenRange>
    ! CssError {
    if self.registered(buffers, name).isSome() {
      return run self.defaultValue(buffers, parent, name, &mut budget.*)
    }
    return Option<TokenRange>.None
  }

  /// A container style query, tokens `start..end` of `query`: `style()` tests joined by
  /// `and`, `or` or `not`, against the custom properties visible in `scope`.
  pub fn styleQuery(self: &VariableStore, buffers: BufferView<'_>, scope: ScopeId, query: &TokenBuffer, start: usize, end: usize) -> bool {
    return self.queryCondition(buffers, scope, query, start, end, false, 0)
  }

  fn queryCondition(self: &VariableStore, buffers: BufferView<'_>, scope: ScopeId, q: &TokenBuffer, start: usize, end: usize, styled: bool, depth: usize) -> bool {
    if depth > 32 { return false }
    let mut i = skip(q, start, end)
    if i >= end { return false }
    let negate = ident(q, i, end, b"not")
    if negate { i = skip(q, i + 1, end) }
    if i >= end { return false }
    let mut result = self.queryTest(buffers, scope, q, i, end, styled, depth)
    i = nextTest(q, i, end)
    let mut joiner: u8 = 0
    while true {
      i = skip(q, i, end)
      if i >= end { break }
      let and = ident(q, i, end, b"and")
      let or = ident(q, i, end, b"or")
      if negate || (!and && !or) || (joiner == 1 && or) || (joiner == 2 && and) { return false }
      joiner = if and { 1 } else { 2 }
      i = skip(q, i + 1, end)
      if i >= end { return false }
      let next = self.queryTest(buffers, scope, q, i, end, styled, depth)
      result = if and { result && next } else { result || next }
      i = nextTest(q, i, end)
    }
    return if negate { !result } else { result }
  }

  fn queryTest(self: &VariableStore, buffers: BufferView<'_>, scope: ScopeId, q: &TokenBuffer, at: usize, end: usize, styled: bool, depth: usize) -> bool {
    let token = &q.tokens.asSlice()[at]
    let close = if token.matching < end { token.matching } else { end }
    let inner = skip(q, at + 1, close)
    let last = trimmed(q, inner, close)
    match &token.kind {
      Kind.OpenParen => {
        if styled && custom(q, inner, last) { return self.queryFeature(buffers, scope, q, inner, last) }
        return self.queryCondition(buffers, scope, q, inner, last, styled, depth + 1)
      }
      Kind.Function { name } => {
        if styled || !tokens.insensitive(q.text(name), b"style") { return false }
        if custom(q, inner, last) { return self.queryFeature(buffers, scope, q, inner, last) }
        return self.queryCondition(buffers, scope, q, inner, last, true, depth + 1)
      }
      _ => { return false }
    }
  }

  /// `--name` or `--name: value` against the value `scope` sees, names compared by text.
  fn queryFeature(self: &VariableStore, buffers: BufferView<'_>, scope: ScopeId, q: &TokenBuffer, start: usize, end: usize) -> bool {
    let wanted = match &q.tokens.asSlice()[start].kind {
      Kind.Ident { text } => q.text(text)
      _ => { return false }
    }
    let mut value = Option<TokenRange>.None
    let mut current = Option<ScopeId>.some(scope)
    let mut found = false
    while !found {
      match &current {
        Option<ScopeId>.Some { value: id } => {
          if id.index >= self.scopes.length() { break }
          let item = self.scopes.asSlice()[id.index]
          let mut i = item.entries.start
          while i < item.entries.end {
            let entry = self.entries.asSlice()[i]
            if entry.name.buffer < buffers.length() && same(buffers.one(entry.name.buffer)[0].text(entry.name.span), wanted) {
              value = entry.value
              found = true
              break
            }
            i = i + 1
          }
          current = item.parent
        }
        _ => { break }
      }
    }
    let resolved = match &value {
      Option<TokenRange>.Some { value: range } => range
      _ => { return false }
    }
    let colon = skip(q, start + 1, end)
    if colon >= end { return true }
    match &q.tokens.asSlice()[colon].kind {
      Kind.Colon => {}
      _ => { return false }
    }
    let mut e = skip(q, colon + 1, end)
    let mut r = resolved.start
    while true {
      while r < resolved.end && blank(buffers, self.refs.asSlice()[r]) { r = r + 1 }
      e = skip(q, e, end)
      if e >= end || r >= resolved.end { return e >= end && r >= resolved.end }
      let reference = self.refs.asSlice()[r]
      if !sameToken(q, e, &buffers.one(reference.buffer)[0], reference.token) { return false }
      e = e + 1
      r = r + 1
    }
    return false
  }

  /// A store with no scope yet, as make returns it, under its closing buffer.
  pub fn fresh(self: &VariableStore) -> Option<usize> {
    if self.registrations.length() == 0 && self.scopes.length() == 0 && self.entries.length() == 0 && self.refs.length() == 0 {
      return Option<usize>.some(self.closingBuffer)
    }
    return Option<usize>.None
  }

  /// The custom properties that the entries of scopes `a` and `b` give different values, or
  /// that only one of them has an entry for, as name bits (`nameBit`): the ones a descendant
  /// can tell the two scopes apart by, so a property registered not to inherit is left out.
  /// It compares what the two elements declare, substituted: what each inherits is the
  /// caller's to compare.
  pub fn differing(self: &VariableStore, buffers: BufferView<'_>, a: ScopeId, b: ScopeId) -> u64 {
    if a.index == b.index { return 0 }
    if a.index >= self.scopes.length() || b.index >= self.scopes.length() { return u64.MAX }
    let one = self.scopes.asSlice()[a.index].entries
    let two = self.scopes.asSlice()[b.index].entries
    let entries = self.entries.asSlice()
    let mut bits: u64 = 0
    let mut i = one.start
    while i < one.end {
      let mut found = false
      let mut j = two.start
      while j < two.end && !found {
        if entries[i].key == entries[j].key && cascade.sameName(buffers, entries[i].name, entries[j].name) {
          found = true
          if !self.sameValue(buffers, entries[i].value, entries[j].value) { bits = u64.bitOr(bits, self.inheritedBit(buffers, entries[i].name)) }
        }
        j = j + 1
      }
      if !found { bits = u64.bitOr(bits, self.inheritedBit(buffers, entries[i].name)) }
      i = i + 1
    }
    let mut j = two.start
    while j < two.end {
      let mut found = false
      i = one.start
      while i < one.end && !found {
        found = entries[i].key == entries[j].key && cascade.sameName(buffers, entries[i].name, entries[j].name)
        i = i + 1
      }
      if !found { bits = u64.bitOr(bits, self.inheritedBit(buffers, entries[j].name)) }
      j = j + 1
    }
    return bits
  }

  /// The name bit of a custom property that inherits, and no bit for one registered not to.
  fn inheritedBit(self: &VariableStore, buffers: BufferView<'_>, name: Name) -> u64 {
    if let Option<Registered>.Some { value } = self.registered(buffers, name) {
      if !value.definition.inherits { return 0 }
    }
    return nameBit(buffers.one(name.buffer)[0].text(name.span))
  }

  fn sameValue(self: &VariableStore, buffers: BufferView<'_>, a: Option<TokenRange>, b: Option<TokenRange>) -> bool {
    let first = match a { Option<TokenRange>.Some { value } => value _ => { return b.isNone() } }
    let second = match b { Option<TokenRange>.Some { value } => value _ => { return false } }
    if first.end - first.start != second.end - second.start || first.end > self.refs.length() || second.end > self.refs.length() { return false }
    let refs = self.refs.asSlice()
    let mut i: usize = 0
    while i < first.end - first.start {
      let x = refs[first.start + i]
      let y = refs[second.start + i]
      if x.buffer != y.buffer || x.token != y.token {
        if x.buffer >= buffers.length() || y.buffer >= buffers.length() { return false }
        if !(blank(buffers, x) && blank(buffers, y)) && !sameToken(&buffers.one(x.buffer)[0], x.token, &buffers.one(y.buffer)[0], y.token) { return false }
      }
      i = i + 1
    }
    return true
  }

  pub fn references(self: &VariableStore) -> &[TokenRef] {
    return self.refs.asSlice()
  }

  pub fn lookup(
    self: &VariableStore,
    buffers: BufferView<'_>,
    scope: ScopeId,
    name: Name,
  ) -> Option<TokenRange> {
    let registered = self.registered(buffers, name)
    let key = nameKey(buffers, name)
    let mut current = Option<ScopeId>.some(scope)
    while true {
      match &current {
        Option<ScopeId>.Some { value } => {
          if value.index >= self.scopes.length() {
            return Option<TokenRange>.None
          }
          let item = self.scopes.asSlice()[value.index]
          let mut i = item.entries.start
          while i < item.entries.end {
            let entry = self.entries.asSlice()[i]
            if entry.key == key && cascade.sameName(buffers, name, entry.name) {
              return entry.value
            }
            i = i + 1
          }
          if let Option<Registered>.Some { value: registration } = registered {
            if !registration.definition.inherits { return registration.initial }
          }
          current = item.parent
        }
        _ => {
          return match &registered {
            Option<Registered>.Some { value } => value.initial
            _ => Option<TokenRange>.None
          }
        }
      }
    }
  }

  /// Looks up a decoded CSSOM property name without allocating a temporary token buffer.
  pub fn lookupText(
    self: &VariableStore,
    buffers: BufferView<'_>,
    scope: ScopeId,
    name: &[u8],
  ) -> Option<TokenRange> {
    let registered = self.registeredText(buffers, name)
    let mut current = Option<ScopeId>.some(scope)
    while true {
      match &current {
        Option<ScopeId>.Some { value } => {
          if value.index >= self.scopes.length() {
            return Option<TokenRange>.None
          }
          let item = self.scopes.asSlice()[value.index]
          let mut i = item.entries.start
          while i < item.entries.end {
            let entry = self.entries.asSlice()[i]
            if entry.name.buffer < buffers.length()
              && tokens.equal(buffers.one(entry.name.buffer)[0].text(entry.name.span), name) {
              return entry.value
            }
            i = i + 1
          }
          if let Option<Registered>.Some { value: registration } = registered {
            if !registration.definition.inherits { return registration.initial }
          }
          current = item.parent
        }
        _ => {
          return match &registered {
            Option<Registered>.Some { value } => value.initial
            _ => Option<TokenRange>.None
          }
        }
      }
    }
  }

  /// Enumerates computed custom properties and registration defaults once, omitting guaranteed-invalid values.
  /// Invalid local declarations still shadow an ancestor's value of the same name.
  pub effect fn computedEntries(
    self: &VariableStore,
    buffers: BufferView<'_>,
    scope: ScopeId,
    limits: &Limits,
  ) -> List<ComputedVariable>
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut result = List<ComputedVariable>.make()
    let mut seen = List<Name>.make()
    let mut budget = Budget { remaining: limits.maxTokens }
    let mut current = Option<ScopeId>.some(scope)
    while true {
      match &current {
        Option<ScopeId>.Some { value } => {
          run budget.spend(1)
          if value.index >= self.scopes.length() {
            return move result
          }
          let item = self.scopes.asSlice()[value.index]
          let mut i = item.entries.start
          while i < item.entries.end {
            run budget.spend(1)
            let entry = self.entries.asSlice()[i]
            let mut duplicate = false
            let mut j: usize = 0
            while j < seen.length() {
              run budget.spend(1)
              if cascade.sameName(buffers, entry.name, seen.asSlice()[j]) {
                duplicate = true
                break
              }
              j = j + 1
            }
            if !duplicate {
              if seen.length() >= limits.maxDeclarations
                || seen.length() >= limits.maxStorageBytes / 64 {
                fail CssError { kind: CssErrorKind.StorageLimit, offset: i }
              }
              run seen.append(entry.name)
              match &self.lookup(buffers, scope, entry.name) {
                Option<TokenRange>.Some { value: range } => {
                  run result.append(ComputedVariable { name: entry.name, value: range })
                }
                _ => {}
              }
            }
            i = i + 1
          }
          current = item.parent
        }
        _ => { break }
      }
    }
    let mut i: usize = 0
    while i < self.registrations.length() {
      let name = self.registrations.asSlice()[i].definition.name
      let mut duplicate = false
      let mut j: usize = 0
      while j < seen.length() {
        run budget.spend(1)
        if cascade.sameName(buffers, name, seen.asSlice()[j]) {
          duplicate = true
          break
        }
        j = j + 1
      }
      if !duplicate {
        if result.length() >= limits.maxDeclarations || result.length() >= limits.maxStorageBytes / 64 {
          fail CssError { kind: CssErrorKind.StorageLimit, offset: i }
        }
        if let Option<TokenRange>.Some { value } = self.lookup(buffers, scope, name) {
          run result.append(ComputedVariable { name: name, value: value })
        }
      }
      i = i + 1
    }
    return move result
  }

  effect fn inherited(
    self: &VariableStore,
    buffers: BufferView<'_>,
    parent: Option<ScopeId>,
    name: Name,
    budget: &mut Budget,
  ) -> Option<TokenRange>
    ! CssError {
    let registered = self.registered(buffers, name)
    let key = nameKey(buffers, name)
    let mut current = parent
    while true {
      match &current {
        Option<ScopeId>.Some { value } => {
          run budget.spend(1)
          if value.index >= self.scopes.length() {
            return Option<TokenRange>.None
          }
          let item = self.scopes.asSlice()[value.index]
          let mut i = item.entries.start
          while i < item.entries.end {
            run budget.spend(1)
            let entry = self.entries.asSlice()[i]
            if entry.key == key && cascade.sameName(buffers, name, entry.name) {
              return entry.value
            }
            i = i + 1
          }
          if let Option<Registered>.Some { value: registration } = registered {
            if !registration.definition.inherits { return registration.initial }
          }
          current = item.parent
        }
        _ => {
          return match &registered {
            Option<Registered>.Some { value } => value.initial
            _ => Option<TokenRange>.None
          }
        }
      }
    }
  }

  pub effect fn build(
    self: &mut VariableStore,
    buffers: BufferView<'_>,
    catalog: &[Declaration],
    candidates: &[Candidate],
    parent: Option<ScopeId>,
    limits: &Limits,
  ) -> ScopeId
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut budget = Budget { remaining: limits.maxTokens }
    let mut work = Work {
      nodes: List<Node>.make(),
      edges: List<usize>.make(),
      parent: parent,
      retry: false,
      resolvedScope: false,
    }
    let mut i: usize = 0
    while i < candidates.length {
      run budget.spend(1)
      let candidate = candidates[i]
      if candidate.declaration < catalog.length {
        match &catalog[candidate.declaration].target {
          Target.Custom { name } => {
            run budget.spend(work.nodes.length())
            let existing = local(&work, buffers, name)
            let absent = match &existing {
              Option<usize>.None => true
              _ => false
            }
            if absent {
              if work.nodes.length() >= limits.maxDeclarations {
                fail CssError { kind: CssErrorKind.DeclarationLimit, offset: i }
              }
              let node = Node {
                name: name,
                buffer: 0,
                raw: TokenRange { start: 0, end: 0 },
                value: Option<TokenRange>.None,
                resolved: true,
                edges: TokenRange { start: 0, end: 0 },
                visited: false,
                number: 0,
                low: 0,
                stacked: false,
                cyclic: false,
                priority: Priority.make(Origin.Author, 0),
                rollback: Rollback.make(0),
              }
              if work.nodes.length() >= limits.maxStorageBytes / 256 {
                fail CssError { kind: CssErrorKind.StorageLimit, offset: i }
              }
              run work.nodes.append(node)
            }
          }
          _ => {}
        }
      }
      i = i + 1
    }
    if work.nodes.length() == 0 && !self.isolated {
      match &parent {
        Option<ScopeId>.Some { value } => {
          return value
        }
        _ => {}
      }
    }
    let referenceStart = self.refs.length()
    while true {
      work.retry = false
      work.edges.truncate(0)
      self.refs.truncate(referenceStart)
      i = 0
      while i < work.nodes.length() {
        let mut node = work.nodes.asSlice()[i]
        run budget.spend(candidates.length)
        let winner = cascade.selectCustomWith(buffers, catalog, candidates, node.name, &mut node.rollback)
        node.resolved = true
        node.value = Option<TokenRange>.None
        node.visited = false
        node.stacked = false
        node.cyclic = false
        let inheritedByDefault = match &self.registered(buffers, node.name) {
          Option<Registered>.Some { value } => value.definition.inherits
          _ => true
        }
        let mut inherit = inheritedByDefault
        let mut initial = !inherit
        match &winner {
          Option<Candidate>.Some { value } => {
            let declaration = &catalog[value.declaration]
            node.buffer = declaration.buffer
            node.priority = value.priority
            match &declaration.specified {
              Specified.Pending { range, .. } => {
                node.raw = range
                node.resolved = false
                inherit = false
                initial = false
              }
              Specified.Wide { keyword } => {
                inherit = keyword == Wide.Inherit || (keyword == Wide.Unset && inheritedByDefault)
                initial = !inherit
              }
              _ => {
                inherit = false
              }
            }
          }
          _ => {}
        }
        if inherit {
          node.value = run self.inherited(buffers, parent, node.name, &mut budget)
        } else if initial {
          node.value = self.initial(buffers, node.name)
        }
        let mut nodes = work.nodes.asMutSlice()
        nodes[i] = node
        i = i + 1
      }

      // Scan every var(), including unused fallbacks, before any value substitution.
      i = 0
      while i < work.nodes.length() {
        let node = work.nodes.asSlice()[i]
        let start = work.edges.length()
        if !node.resolved {
          if node.buffer >= buffers.length() || node.raw.start > node.raw.end
            || node.raw.end > buffers.one(node.buffer)[0].all().end {
            let mut nodes = work.nodes.asMutSlice()
            nodes[i].resolved = true
          } else {
            let buffer = &buffers.one(node.buffer)[0]
            let mut position = node.raw.start
            while position < node.raw.end {
              run budget.spend(1)
              if variable(buffer, position) {
                let name = variableName(buffer, node.buffer, position, node.raw.end)
                match &name {
                  Option<Name>.Some { value } => {
                    run budget.spend(work.nodes.length())
                    let target = local(&work, buffers, value)
                    match &target {
                      Option<usize>.Some { value: index } => {
                        if work.edges.length() >= limits.maxTokens
                          || work.edges.length() >= limits.maxStorageBytes / 8 {
                          fail CssError { kind: CssErrorKind.StorageLimit, offset: position }
                        }
                        run work.edges.append(index)
                      }
                      _ => {}
                    }
                  }
                  _ => {}
                }
              }
              position = position + 1
            }
          }
        }
        let edges = TokenRange { start: start, end: work.edges.length() }
        let mut nodes = work.nodes.asMutSlice()
        nodes[i].edges = edges
        i = i + 1
      }
      let mut stack = List<usize>.make()
      let mut sequence: usize = 0
      i = 0
      while i < work.nodes.length() {
        if !work.nodes.asSlice()[i].visited {
          run connect(&mut work, i, &mut stack, &mut sequence, 0, limits, &mut budget)
        }
        i = i + 1
      }
      i = 0
      while i < work.nodes.length() {
        run self.resolve(&mut work, buffers, i, 0, limits, &mut budget)
        if work.retry {
          break
        }
        i = i + 1
      }
      if !work.retry {
        break
      }
    }
    if self.scopes.length() >= limits.maxRules
      || self.entries.length() > limits.maxStorageBytes / 48
      || work.nodes.length() > limits.maxStorageBytes / 48 - self.entries.length() {
      fail CssError { kind: CssErrorKind.StorageLimit, offset: self.entries.length() }
    }
    let start = self.entries.length()
    i = 0
    while i < work.nodes.length() {
      let node = work.nodes.asSlice()[i]
      run self.entries.append(Entry { name: node.name, key: nameKey(buffers, node.name), value: node.value })
      i = i + 1
    }
    let id = ScopeId { index: self.scopes.length() }
    run self.scopes.append(
      Scope { parent: parent, entries: TokenRange { start: start, end: self.entries.length() } },
    )
    return id
  }

  effect fn resolve(
    self: &mut VariableStore,
    work: &mut Work,
    buffers: BufferView<'_>,
    index: usize,
    depth: usize,
    limits: &Limits,
    budget: &mut Budget,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    run budget.spend(1)
    let node = work.nodes.asSlice()[index]
    if node.resolved {
      return
    }
    if depth >= limits.maxDepth {
      fail CssError { kind: CssErrorKind.NestingLimit, offset: index }
    }
    if node.cyclic {
      let fallback = run self.invalidValue(buffers, work.parent, node.name, &mut budget.*)
      let mut nodes = work.nodes.asMutSlice()
      nodes[index].value = fallback
      nodes[index].resolved = true
      return
    }
    let mut i = node.edges.start
    while i < node.edges.end {
      let dependency = work.edges.asSlice()[i]
      run self.resolve(&mut work.*, buffers, dependency, depth + 1, limits, &mut budget.*)
      if work.retry {
        return
      }
      i = i + 1
    }
    let mut out = List<TokenRef>.make()
    let valid = run expand(
      &self.*,
      &work.*,
      buffers,
      node.buffer,
      node.raw,
      0,
      &mut out,
      limits,
      &mut budget.*,
    )
    if valid {
      let expanded = Input.Expanded { buffers: buffers, references: out.asSlice() }
      let keyword = cascade.wide(&expanded)
      match &keyword {
        Option<Wide>.Some { value } => {
          let mut rollback = node.rollback
          if rollback.apply(value, node.priority) {
            let mut nodes = work.nodes.asMutSlice()
            nodes[index].rollback = rollback
            work.retry = true
          } else {
            let fallback = if value == Wide.Initial { self.initial(buffers, node.name) }
              else if value == Wide.Inherit { run self.inherited(buffers, work.parent, node.name, &mut budget.*) }
              else { run self.defaultValue(buffers, work.parent, node.name, &mut budget.*) }
            let mut nodes = work.nodes.asMutSlice()
            nodes[index].value = fallback
          }
          let mut nodes = work.nodes.asMutSlice()
          nodes[index].resolved = true
          return
        }
        _ => {}
      }
      if let Option<Registered>.Some { value: registered } = self.registered(buffers, node.name) {
        if !run registration.valid(registered.definition.syntax, &expanded, false, limits) {
          let fallback = run self.invalidValue(buffers, work.parent, node.name, &mut budget.*)
          let nodes = work.nodes.asMutSlice()
          nodes[index].value = fallback
          nodes[index].resolved = true
          return
        }
      }
      if self.refs.length() > limits.maxStorageBytes / 16
        || out.length() > limits.maxStorageBytes / 16 - self.refs.length() {
        fail CssError { kind: CssErrorKind.StorageLimit, offset: index }
      }
      let start = self.refs.length()
      i = 0
      while i < out.length() {
        run self.refs.append(out.asSlice()[i])
        i = i + 1
      }
      let mut nodes = work.nodes.asMutSlice()
      nodes[index].value = Option<TokenRange>.some(
        TokenRange { start: start, end: self.refs.length() },
      )
    }
    if !valid {
      let fallback = run self.invalidValue(buffers, work.parent, node.name, &mut budget.*)
      let nodes = work.nodes.asMutSlice()
      nodes[index].value = fallback
    }
    let mut nodes = work.nodes.asMutSlice()
    nodes[index].resolved = true
  }

  /// Appends what substituting `range` of `buffer` in `scope` reads: for each `var()` in it,
  /// fallbacks included, the value its name has in the scope (`variableRead`). Two scopes that
  /// give the same list substitute the range the same way, while the environment holds.
  pub effect fn reads(
    self: &VariableStore,
    buffers: BufferView<'_>,
    scope: ScopeId,
    buffer: usize,
    range: TokenRange,
    out: &mut List<u64>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if buffer >= buffers.length() || range.start > range.end || range.end > buffers.one(buffer)[0].all().end {
      return ()
    }
    if scope.index >= self.scopes.length() {
      run out.append(u64.MAX - 1)
      return ()
    }
    let source = &buffers.one(buffer)[0]
    let mut position = range.start
    while position < range.end {
      if variable(source, position) {
        let matching = source.tokens.asSlice()[position].matching
        let end = if matching < range.end { matching } else { range.end }
        let value = match variableName(source, buffer, position, end) {
          Option<Name>.Some { value: name } => self.lookup(buffers, scope, name)
          Option<Name>.None => Option<TokenRange>.None
        }
        run out.append(variableRead(value))
      }
      position = position + 1
    }
  }

  pub effect fn substitute(
    self: &VariableStore,
    buffers: BufferView<'_>,
    scope: ScopeId,
    buffer: usize,
    range: TokenRange,
    limits: &Limits,
  ) -> Option<List<TokenRef>>
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if buffer >= buffers.length() || range.start > range.end
      || range.end > buffers.one(buffer)[0].all().end
      || scope.index >= self.scopes.length() {
      return Option<List<TokenRef>>.None
    }
    let input = Input.Contiguous { buffer: &buffers.one(buffer)[0], range: range }
    let validation = run declaration_values.validate(&input, limits)
    if !validation.valid {
      return Option<List<TokenRef>>.None
    }
    let work = Work {
      nodes: List<Node>.make(),
      edges: List<usize>.make(),
      parent: Option<ScopeId>.some(scope),
      resolvedScope: true,
      retry: false,
    }
    let mut budget = Budget { remaining: limits.maxTokens }
    let mut out = List<TokenRef>.make()
    let valid = run expand(self, &work, buffers, buffer, range, 0, &mut out, limits, &mut budget)
    if !valid {
      return Option<List<TokenRef>>.None
    }
    return Option<List<TokenRef>>.some(move out)
  }
}

// Tarjan SCCs retain completed DFS children on the component stack, so cross
// edges also invalidate every member of a cycle, not merely a back-edge path.
// https://www.w3.org/TR/css-variables-1/#cycles
effect fn connect(
  work: &mut Work,
  index: usize,
  stack: &mut List<usize>,
  sequence: &mut usize,
  depth: usize,
  limits: &Limits,
  budget: &mut Budget,
) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  run budget.spend(1)
  if depth >= limits.maxDepth {
    fail CssError { kind: CssErrorKind.NestingLimit, offset: index }
  }
  let mut initialNodes = work.nodes.asMutSlice()
  initialNodes[index].visited = true
  initialNodes[index].number = sequence.*
  initialNodes[index].low = sequence.*
  initialNodes[index].stacked = true
  drop initialNodes
  sequence.* = sequence.* + 1
  run stack.append(index)
  let edges = work.nodes.asSlice()[index].edges
  let mut edge = edges.start
  let mut selfEdge = false
  while edge < edges.end {
    run budget.spend(1)
    let target = work.edges.asSlice()[edge]
    if target == index {
      selfEdge = true
    }
    if !work.nodes.asSlice()[target].visited {
      run connect(
        &mut work.*,
        target,
        &mut stack.*,
        &mut sequence.*,
        depth + 1,
        limits,
        &mut budget.*,
      )
      let low = work.nodes.asSlice()[target].low
      if low < work.nodes.asSlice()[index].low {
        let mut nodes = work.nodes.asMutSlice()
        nodes[index].low = low
      }
    } else if work.nodes.asSlice()[target].stacked {
      let number = work.nodes.asSlice()[target].number
      if number < work.nodes.asSlice()[index].low {
        let mut nodes = work.nodes.asMutSlice()
        nodes[index].low = number
      }
    }
    edge = edge + 1
  }
  let node = work.nodes.asSlice()[index]
  if node.low == node.number {
    let mut start = stack.length()
    while start > 0 {
      start = start - 1
      if stack.asSlice()[start] == index {
        break
      }
    }
    let cyclic = selfEdge || stack.length() - start > 1
    let mut i = start
    while i < stack.length() {
      let member = stack.asSlice()[i]
      let mut nodes = work.nodes.asMutSlice()
      nodes[member].cyclic = cyclic
      nodes[member].stacked = false
      i = i + 1
    }
    stack.truncate(start)
  }
}

// Splice token references, never bytes. Every implicit block end is materialized
// before another sequence is appended, including implicit ends inside fallback.
effect fn expand(
  store: &VariableStore,
  work: &Work,
  buffers: BufferView<'_>,
  source: usize,
  range: TokenRange,
  depth: usize,
  out: &mut List<TokenRef>,
  limits: &Limits,
  budget: &mut Budget,
) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  if depth >= limits.maxDepth {
    fail CssError { kind: CssErrorKind.NestingLimit, offset: range.start }
  }
  if source >= buffers.length() || range.start > range.end
    || range.end > buffers.one(source)[0].all().end {
    return false
  }
  let buffer = &buffers.one(source)[0]
  let mut position = range.start
  while position < range.end {
    run budget.spend(1)
    let token = &buffer.tokens.asSlice()[position]
    let close = closing(&token.kind)
    match &close {
      Option<usize>.Some { value: closingIndex } => {
        let end = if token.matching < range.end {
          token.matching
        } else {
          range.end
        }
        if end <= position {
          return false
        }
        if ifFunction(buffer, position) {
          // CSS Values 5 if(): the value of the first branch whose condition holds, or nothing.
          let chosen = run branch(store, work, buffers, source, position + 1, end, limits, &mut budget.*)
          if let Option<TokenRange>.Some { value: picked } = chosen {
            let valid = run expand(store, work, buffers, source, picked, depth + 1, &mut out.*, limits, &mut budget.*)
            if !valid {
              return false
            }
          }
        } else if variable(buffer, position) {
          let named = variableName(buffer, source, position, end)
          let name = match &named {
            Option<Name>.Some { value } => value
            _ => {
              return false
            }
          }
          run budget.spend(work.nodes.length())
          let target = local(work, buffers, name)
          let value = match &target {
            Option<usize>.Some { value } => work.nodes.asSlice()[value].value
            _ => if work.resolvedScope { run store.inherited(buffers, work.parent, name, &mut budget.*) }
              else { run store.defaultValue(buffers, work.parent, name, &mut budget.*) }
          }
          match &value {
            Option<TokenRange>.Some { value: resolved } => {
              let mut i = resolved.start
              while i < resolved.end {
                run push(&mut out.*, store.refs.asSlice()[i], limits, &mut budget.*)
                i = i + 1
              }
            }
            _ => {
              let first = skip(buffer, position + 1, end)
              let comma = skip(buffer, first + 1, end)
              if comma >= end {
                return false
              }
              let isComma = match &buffer.tokens.asSlice()[comma].kind {
                Kind.Comma => true
                _ => false
              }
              if !isComma {
                return false
              }
              let valid = run expand(
                store,
                work,
                buffers,
                source,
                TokenRange { start: comma + 1, end: end },
                depth + 1,
                &mut out.*,
                limits,
                &mut budget.*,
              )
              if !valid {
                return false
              }
            }
          }
        } else {
          run push(&mut out.*, TokenRef { buffer: source, token: position }, limits, &mut budget.*)
          let valid = run expand(
            store,
            work,
            buffers,
            source,
            TokenRange { start: position + 1, end: end },
            depth + 1,
            &mut out.*,
            limits,
            &mut budget.*,
          )
          if !valid {
            return false
          }
          if end < range.end {
            run push(&mut out.*, TokenRef { buffer: source, token: end }, limits, &mut budget.*)
          } else {
            if store.closingBuffer >= buffers.length()
              || closingIndex >= buffers.one(store.closingBuffer)[0].tokens.length() {
              return false
            }
            run push(
              &mut out.*,
              TokenRef { buffer: store.closingBuffer, token: closingIndex },
              limits,
              &mut budget.*,
            )
          }
        }
        position = if end < range.end {
          end + 1
        } else {
          end
        }
      }
      _ => {
        run push(&mut out.*, TokenRef { buffer: source, token: position }, limits, &mut budget.*)
        position = position + 1
      }
    }
  }
  return true
}

fn ifFunction(buffer: &TokenBuffer, index: usize) -> bool {
  return match &buffer.tokens.asSlice()[index].kind {
    Kind.Function { name } => tokens.insensitive(buffer.text(name), b"if")
    _ => false
  }
}

fn ident(buffer: &TokenBuffer, index: usize, end: usize, word: &[u8]) -> bool {
  if index >= end {
    return false
  }
  return match &buffer.tokens.asSlice()[index].kind {
    Kind.Ident { text } => tokens.insensitive(buffer.text(text), word)
    _ => false
  }
}

/// The first token in `start..end` outside any block that is a `;` (`colon` false) or a `:`.
fn topLevel(buffer: &TokenBuffer, start: usize, end: usize, colon: bool) -> usize {
  let mut i = start
  while i < end {
    let token = &buffer.tokens.asSlice()[i]
    match &token.kind {
      Kind.Semicolon => {
        if !colon { return i }
      }
      Kind.Colon => {
        if colon { return i }
      }
      _ => {}
    }
    if closing(&token.kind).isSome() {
      i = if token.matching < end { token.matching + 1 } else { end }
    } else {
      i = i + 1
    }
  }
  return end
}

/// Trims whitespace off the end of `start..end`.
fn trimmed(buffer: &TokenBuffer, start: usize, end: usize) -> usize {
  let mut e = end
  while e > start {
    match &buffer.tokens.asSlice()[e - 1].kind {
      Kind.Whitespace => {
        e = e - 1
      }
      _ => {
        return e
      }
    }
  }
  return e
}

/// The value range of the first `if()` branch in `start..end` whose condition holds.
effect fn branch(
  store: &VariableStore,
  work: &Work,
  buffers: BufferView<'_>,
  source: usize,
  start: usize,
  end: usize,
  limits: &Limits,
  budget: &mut Budget,
) -> Option<TokenRange>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = &buffers.one(source)[0]
  let mut at = start
  while at < end {
    let stop = topLevel(buffer, at, end, false)
    let colon = topLevel(buffer, at, stop, true)
    if colon < stop {
      let first = skip(buffer, at, colon)
      let last = trimmed(buffer, first, colon)
      let holds = if ident(buffer, first, last, b"else") && first + 1 == last { true }
        else { run condition(store, work, buffers, source, first, last, false, limits, &mut budget.*) }
      if holds {
        let value = skip(buffer, colon + 1, stop)
        return Option<TokenRange>.some(TokenRange { start: value, end: trimmed(buffer, value, stop) })
      }
    }
    at = stop + 1
  }
  return Option<TokenRange>.None
}

/// `<if-condition>`: tests joined by `and` or `or`, or `not` one test. In `style()`
/// (`styled`), a parenthesized test may be a custom property feature.
effect fn condition(
  store: &VariableStore,
  work: &Work,
  buffers: BufferView<'_>,
  source: usize,
  start: usize,
  end: usize,
  styled: bool,
  limits: &Limits,
  budget: &mut Budget,
) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  run budget.spend(1)
  let buffer = &buffers.one(source)[0]
  let mut i = skip(buffer, start, end)
  if i >= end {
    return false
  }
  let negate = ident(buffer, i, end, b"not")
  if negate {
    i = skip(buffer, i + 1, end)
  }
  if i >= end {
    return false
  }
  let mut result = run test(store, work, buffers, source, i, end, styled, limits, &mut budget.*)
  i = nextTest(buffer, i, end)
  let mut joiner: u8 = 0
  while true {
    i = skip(buffer, i, end)
    if i >= end { break }
    let and = ident(buffer, i, end, b"and")
    let or = ident(buffer, i, end, b"or")
    if negate || (!and && !or) || (joiner == 1 && or) || (joiner == 2 && and) {
      return false
    }
    joiner = if and { 1 } else { 2 }
    i = skip(buffer, i + 1, end)
    if i >= end {
      return false
    }
    let next = run test(store, work, buffers, source, i, end, styled, limits, &mut budget.*)
    result = if and { result && next } else { result || next }
    i = nextTest(buffer, i, end)
  }
  return if negate { !result } else { result }
}

fn nextTest(buffer: &TokenBuffer, at: usize, end: usize) -> usize {
  let token = &buffer.tokens.asSlice()[at]
  if closing(&token.kind).isSome() {
    return if token.matching < end { token.matching + 1 } else { end }
  }
  return at + 1
}

/// One `supports()`, `media()` or `style()` test, or a parenthesized condition.
effect fn test(
  store: &VariableStore,
  work: &Work,
  buffers: BufferView<'_>,
  source: usize,
  at: usize,
  end: usize,
  styled: bool,
  limits: &Limits,
  budget: &mut Budget,
) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = &buffers.one(source)[0]
  let token = &buffer.tokens.asSlice()[at]
  let close = if token.matching < end { token.matching } else { end }
  let inner = skip(buffer, at + 1, close)
  let last = trimmed(buffer, inner, close)
  match &token.kind {
    Kind.OpenParen => {
      if styled && custom(buffer, inner, last) {
        return run feature(store, work, buffers, source, inner, last, &mut budget.*)
      }
      return run condition(store, work, buffers, source, inner, last, styled, limits, &mut budget.*)
    }
    Kind.Function { name } => {
      let spelled = buffer.text(name)
      if styled {
        return false
      }
      if tokens.insensitive(spelled, b"style") {
        if custom(buffer, inner, last) {
          return run feature(store, work, buffers, source, inner, last, &mut budget.*)
        }
        return run condition(store, work, buffers, source, inner, last, true, limits, &mut budget.*)
      }
      if tokens.insensitive(spelled, b"media") {
        return match &store.environment {
          Option<Environment>.Some { value: environment } => {
            // A bare feature, `media(width >= 600px)`, or a media query.
            let input = Input.Contiguous { buffer: buffer, range: TokenRange { start: inner, end: last } }
            let feature = run media_features.evaluate(&input, 0, input.length(), &environment)
            if feature == Truth.True { true } else if feature == Truth.False { false }
            else { run media_queries.matches(&input, &environment, limits) }
          }
          _ => false
        }
      }
      if tokens.insensitive(spelled, b"supports") {
        let input = Input.Contiguous { buffer: buffer, range: TokenRange { start: inner, end: last } }
        let mut values = ValueStore.make()
        let result = run supports.evaluateImport(&input, &mut values, limits)
        return result.valid && result.value
      }
      return false
    }
    _ => {
      return false
    }
  }
}

fn custom(buffer: &TokenBuffer, at: usize, end: usize) -> bool {
  if at >= end {
    return false
  }
  return match &buffer.tokens.asSlice()[at].kind {
    Kind.Ident { text } => declaration_values.customName(buffer.text(text))
    _ => false
  }
}

/// `--name` (the property has a value) or `--name: value` (its value is those tokens).
effect fn feature(
  store: &VariableStore,
  work: &Work,
  buffers: BufferView<'_>,
  source: usize,
  start: usize,
  end: usize,
  budget: &mut Budget,
) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = &buffers.one(source)[0]
  let name = match &buffer.tokens.asSlice()[start].kind {
    Kind.Ident { text } => Name { buffer: source, span: text }
    _ => { return false }
  }
  run budget.spend(work.nodes.length())
  let target = local(work, buffers, name)
  let value = match &target {
    Option<usize>.Some { value } => work.nodes.asSlice()[value].value
    _ => if work.resolvedScope { run store.inherited(buffers, work.parent, name, &mut budget.*) }
      else { run store.defaultValue(buffers, work.parent, name, &mut budget.*) }
  }
  let colon = skip(buffer, start + 1, end)
  let resolved = match &value {
    Option<TokenRange>.Some { value: found } => found
    _ => { return false }
  }
  if colon >= end {
    return true
  }
  match &buffer.tokens.asSlice()[colon].kind {
    Kind.Colon => {}
    _ => { return false }
  }
  // Compare the tokens, ignoring whitespace.
  let mut e = skip(buffer, colon + 1, end)
  let mut r = resolved.start
  while true {
    while r < resolved.end && blank(buffers, store.refs.asSlice()[r]) {
      r = r + 1
    }
    e = skip(buffer, e, end)
    if e >= end || r >= resolved.end {
      return e >= end && r >= resolved.end
    }
    let reference = store.refs.asSlice()[r]
    if !sameToken(buffer, e, &buffers.one(reference.buffer)[0], reference.token) {
      return false
    }
    e = e + 1
    r = r + 1
  }
  return false
}

fn blank(buffers: BufferView<'_>, reference: TokenRef) -> bool {
  if reference.buffer >= buffers.length() {
    return false
  }
  let buffer = &buffers.one(reference.buffer)[0]
  return match &buffer.tokens.asSlice()[reference.token].kind {
    Kind.Whitespace => true
    _ => false
  }
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// Whether two tokens spell the same component value.
fn sameToken(a: &TokenBuffer, i: usize, b: &TokenBuffer, j: usize) -> bool {
  let x = a.tokens.asSlice()[i].kind
  let y = b.tokens.asSlice()[j].kind
  return match x {
    Kind.Ident { text } => match y { Kind.Ident { text: other } => same(a.text(text), b.text(other)) _ => false }
    Kind.Function { name } => match y { Kind.Function { name: other } => same(a.text(name), b.text(other)) _ => false }
    Kind.String { text } => match y { Kind.String { text: other } => same(a.text(text), b.text(other)) _ => false }
    Kind.Hash { text, .. } => match y { Kind.Hash { text: other, .. } => same(a.text(text), b.text(other)) _ => false }
    Kind.Url { text } => match y { Kind.Url { text: other } => same(a.text(text), b.text(other)) _ => false }
    Kind.Number { value, .. } => match y { Kind.Number { value: other, .. } => value == other _ => false }
    Kind.Percentage { value, .. } => match y { Kind.Percentage { value: other, .. } => value == other _ => false }
    Kind.Dimension { value, unit, .. } => match y { Kind.Dimension { value: other, unit: otherUnit, .. } => value == other && tokens.insensitive(a.text(unit), b.text(otherUnit)) _ => false }
    Kind.Delim { scalar } => match y { Kind.Delim { scalar: other } => scalar == other _ => false }
    Kind.Colon => match y { Kind.Colon => true _ => false }
    Kind.Comma => match y { Kind.Comma => true _ => false }
    Kind.OpenParen => match y { Kind.OpenParen => true _ => false }
    Kind.CloseParen => match y { Kind.CloseParen => true _ => false }
    Kind.OpenSquare => match y { Kind.OpenSquare => true _ => false }
    Kind.CloseSquare => match y { Kind.CloseSquare => true _ => false }
    _ => false
  }
}
